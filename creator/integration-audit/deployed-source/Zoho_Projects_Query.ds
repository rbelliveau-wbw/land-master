Zoho_Projects_Query as "Zoho Projects Query"
{
	type =  schedule
		status = inactive
	start = "2025-08-05 10:20:41"
	time zone = "America/Chicago"
	on start
	{
		actions 
		{
		on load
		(
			auditRun = thisapp.workflowRunLog({"action":"start","workflow":"Zoho Projects Query","system":"Zoho Projects"});
							auditId = auditRun.get("id");
							auditReceived = 0;
							auditProcessed = 0;
							auditCreated = 0;
							auditUpdated = 0;
							auditUpdatedIds = List();
							auditSkipped = 0;
							auditMissingMapping = 0;
							auditNoBudget = 0;
							auditNoEligible = false;
							auditWriteAttempted = false;
							auditRowChanged = false;
							auditSourceKeys = Map();
							auditRecordKey = "";
							try 
							{
								// Query to ZOHO PROJECTS to get custom and hidden field data
								portalId = "700737166";
								orgId = "700732567";
								projId = "1496277000013961217";
								projHttp = invokeurl
								[
									url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projId
									type :GET
									detailed:true
									connection:"projects_view_only"
								];
								if(projHttp.get("responseCode") < 200 || projHttp.get("responseCode") >= 300)
								{
									throw "Zoho Projects HTTP " + projHttp.get("responseCode");
								}
								proj = projHttp.get("responseText");
								responseText = proj.toString();
								if(responseText.length() == 0)
								{
									throw "Zoho Projects returned an empty acknowledgement; verify the destination before retrying.";
								}
								if(responseText.left(1) == "{")
								{
									proj = responseText.toMap();
									apiFailureStatuses = {"error","failed","failure"};
									if(proj.get("error") != null || proj.get("errors") != null || apiFailureStatuses.contains(ifnull(proj.get("status"),"").toString().toLowerCase()))
									{
										throw "Zoho Projects returned an API error.";
									}
								}
								else if(responseText.left(1) != "[")
								{
									throw "Zoho Projects returned a non-JSON response.";
								}
								info proj;
								auditCounts = {"received":auditReceived,"processed":auditProcessed,"created":auditCreated,"updated":auditUpdated,"skipped":auditSkipped,"failed":0};
								auditFinalStatus = "Success";
								if(auditNoEligible)
								{
									auditFinalStatus = "Skipped";
								}
								thisapp.workflowRunLog({"action":"finish","id":auditId,"status":auditFinalStatus,"stage":"Completed","counts":auditCounts,"message":"Completed; exclusions and unchanged rows remain skipped.","details":"Missing external mappings: " + auditMissingMapping + "; no budget: " + auditNoBudget});
							}catch (auditError)
							{
								auditStatus = "Failed";
								if(auditWriteAttempted || auditCreated > 0 || auditUpdated > 0)
								{
									auditStatus = "Partial";
								}
								auditCounts = {"received":auditReceived,"processed":auditProcessed,"created":auditCreated,"updated":auditUpdated,"skipped":auditSkipped,"failed":1};
								thisapp.workflowRunLog({"action":"finish","id":auditId,"status":auditStatus,"counts":auditCounts,"message":auditError.toString(),"details":"Stopped after processing record " + auditProcessed + "; key=" + auditRecordKey + "; missing mappings=" + auditMissingMapping + "; no budget=" + auditNoBudget + ". Counts identify completed native write operations before failure; Creator may roll them back. Check records before retrying. No automatic replay."});
								throw auditError;
							}
		)
		}
	}
}
