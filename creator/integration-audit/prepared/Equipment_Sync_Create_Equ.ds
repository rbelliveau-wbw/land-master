Equipment_Sync_Create_Equ as "Equipment - Sync/Create Equipment from Analytics"
{
	type =  schedule
	start = "2025-12-17 12:10:04"
	frequency = daily
	time zone = "America/Chicago"
	on start
	{
		actions 
		{
		on load
		(
			auditRun = thisapp.workflowRunLog({"action":"start","workflow":"Equipment - Sync/Create Equipment from Analytics","system":"Zoho Analytics"});
			auditId = auditRun.get("id");
			auditReceived = 0;
			auditProcessed = 0;
			auditCreated = 0;
			auditUpdated = 0;
			auditUpdatedIds = List();
			auditSkipped = 0;
			auditMissingMapping = 0;
			auditNoBudget = 0;
			auditNoEligible = false;
			auditWriteAttempted = false;
			auditRowChanged = false;
			auditSourceKeys = Map();
			auditRecordKey = "";
			try
			{
			// ================================================
			// Script: Analytics → Budget_Import_Item Upsert
			// What it does:
			// - Exports selected columns from a Zoho Analytics view.
			// - Builds a list of Subdivision codes that have Budgets.
			// - For each exported row whose JobCode is in that list:
			//     • If a Budget_Import_Item exists (by Cost_Code_ID), update Cost + Updated_Date.
			//     • Else insert a new Budget_Import_Item with mapped fields.
			// Notes:
			// - Ensure TotalActualCost is numeric (normalize if needed).
			// - Requires valid Analytics connection (zoho_analytics_connection).
			// ================================================
			portalId = "700737166";
			orgId = "700732567";
			workspaceId = "2107789000000003001";
			viewId = "2107789000023926003";
			// === 2) Analytics request setup ===
			headers = Map();
			headers.put("ZANALYTICS-ORGID",orgId);
			config = Map();
			config.put("responseFormat","json");
			cols = List();
			cols.add("Current_MeterHours");
			cols.add("Name");
			cols.add("Description");
			cols.add("SerialNo");
			cols.add("Description");
			cols.add("EquipmentType");
			cols.add("Year");
			cols.add("PurchasePrice");
			cols.add("PurchaseYear");
			config.put("selectedColumns",cols);
			// === 3) Kick off the async export job ===
			rows = thisapp.analyticsExportRows(viewId,config,auditId,false);
			auditReceived = rows.size();

			// === 8) Loop through every analytics row and update each project ===
			//get all Subdiv codes that have a Budget
			for each  rec in rows
			{
			 auditProcessed = auditProcessed + 1;
			 auditRowChanged = false;

				equip = Equipment[Equipment_Code = rec.get("Name")];
			if(equip.count() > 1) { throw "Duplicate destination records: equip; source row=" + auditProcessed; }
				if(equip.count() == 1)
				{
					auditWriteAttempted = true;
					equip.Equipment_Code=rec.get("Name");
					auditWriteAttempted = true;
					equip.Equipment_Accounting_Code="E_" + rec.get("Name");
					auditWriteAttempted = true;
					equip.Current_Meter_Hours=rec.get("Current_MeterHours");
					auditWriteAttempted = true;
					equip.Description=rec.get("Description");
					auditWriteAttempted = true;
					equip.Serial_Number=rec.get("SerialNo");
					auditWriteAttempted = true;
					equip.Type1=rec.get("EquipmentType");
					auditWriteAttempted = true;
					equip.Year1=rec.get("Year");
					auditWriteAttempted = true;
					equip.Purchase_Price=rec.get("PurchasePrice");
					auditWriteAttempted = true;
					equip.Purchase_Date=rec.get("PurchaseYear");
	
			 auditDestination = equip.ID.toString();
			 if(!auditUpdatedIds.contains(auditDestination)) { auditUpdatedIds.add(auditDestination); auditUpdated = auditUpdated + 1; }
			 auditRowChanged = true;
			}
				if(equip.count() == 0)
				{
					equipIns = insert into Equipment
					[
						Added_User=zoho.loginuser
						Equipment_Code=rec.get("Name")
						Equipment_Accounting_Code="E_" + rec.get("Name")
						Current_Meter_Hours=rec.get("Current_MeterHours")
						Description=rec.get("Description")
						Serial_Number=rec.get("SerialNo")
						Type1=rec.get("EquipmentType")
						Year1=rec.get("Year")
						Purchase_Price=rec.get("PurchasePrice")
						Purchase_Date=rec.get("PurchaseYear")
					];
			 auditCreated = auditCreated + 1;
			 auditRowChanged = true;
				}

			 if(!auditRowChanged) { auditSkipped = auditSkipped + 1; }
			}
			 auditCounts = {"received":auditReceived,"processed":auditProcessed,"created":auditCreated,"updated":auditUpdated,"skipped":auditSkipped,"failed":0};
			 auditFinalStatus = "Success";
			 if(auditNoEligible) { auditFinalStatus = "Skipped"; }
			 thisapp.workflowRunLog({"action":"finish","id":auditId,"status":auditFinalStatus,"stage":"Completed","counts":auditCounts,"message":"Completed; exclusions and unchanged rows remain skipped.","details":"Missing external mappings: " + auditMissingMapping + "; no budget: " + auditNoBudget});
			}
			catch(auditError)
			{
			 auditStatus = "Failed";
			 if(auditWriteAttempted || auditCreated > 0 || auditUpdated > 0) { auditStatus = "Partial"; }
			 auditCounts = {"received":auditReceived,"processed":auditProcessed,"created":auditCreated,"updated":auditUpdated,"skipped":auditSkipped,"failed":1};
			 thisapp.workflowRunLog({"action":"finish","id":auditId,"status":auditStatus,"counts":auditCounts,"message":auditError.toString(),"details":"Stopped after processing record " + auditProcessed + "; key=" + auditRecordKey + "; missing mappings=" + auditMissingMapping + "; no budget=" + auditNoBudget + ". Counts identify completed native write operations before failure; Creator may roll them back. Check records before retrying. No automatic replay."});
			 throw auditError;
			}
		)
		}
	}
}
