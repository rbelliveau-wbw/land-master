// NEW form definition fragment. Install in Development; not a complete application export.
form Task_Schedule
{
Task_Schedule_Details
(
 type = section
 displayname = "Task Schedule Details"
 row = 1
 column = 0
 width = medium
)
Subdivision1
(
 type = picklist
 values = Subdivision.ID
 displayformat = [Subdivision_Name]
 row = 1
 column = 1
 width = medium
)
Stage_Key
(
 type = text
 row = 1
 column = 1
 width = medium
)
Start_Date
(
 type = date
 row = 1
 column = 1
 width = medium
)
End_Date
(
 type = date
 row = 1
 column = 1
 width = medium
)
must have Source_System
(
 type = text
 row = 1
 column = 1
 width = medium
)
must have Source_Record_ID
(
 type = text
 row = 1
 column = 1
 width = medium
)
must have unique Source_Key
(
 type = text
 row = 1
 column = 1
 width = medium
)
Source_Task_ID
(
 type = text
 row = 1
 column = 1
 width = medium
)
Source_Milestone_ID
(
 type = text
 row = 1
 column = 1
 width = medium
)
Task_Name
(
 type = text
 row = 1
 column = 1
 width = medium
)
Task_Code
(
 type = text
 row = 1
 column = 1
 width = medium
)
Source_Project_ID
(
 type = text
 row = 1
 column = 1
 width = medium
)
Task_Status
(
 type = text
 row = 1
 column = 1
 width = medium
)
Completion_Date
(
 type = date
 row = 1
 column = 1
 width = medium
)
Milestone_Task
(
 type = checkbox
 initial value = false
 row = 1
 column = 1
 width = medium
)
Source_Modified_At
(
 type = datetime
 row = 1
 column = 1
 width = medium
)
Synced_At
(
 type = datetime
 row = 1
 column = 1
 width = medium
)
Write_Enabled
(
 type = checkbox
 initial value = false
 row = 1
 column = 1
 width = medium
)
actions
{
on add
{
submit
(
 type = submit
 displayname = "Submit"
)
}
on edit
{
update
(
 type = submit
 displayname = "Update"
)
cancel
(
 type = cancel
 displayname = "Cancel"
)
}
}
}
