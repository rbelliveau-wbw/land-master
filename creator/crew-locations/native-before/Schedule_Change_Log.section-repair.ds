form Schedule_Change_Log
{
	must have unique Operation_ID
	(
    	type = text
	 	row = 1
	 	column = 1   
		width = medium
	)
	must have Operation_Type
	(
    	type = text
	 	row = 2
	 	column = 1   
		width = medium
	)
	must have Actor
	(
    	type = text
	 	row = 3
	 	column = 1   
		width = medium
	)
	Timestamp
	(
    	type = datetime
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
	 	row = 4
	 	column = 1   
		width = medium
	)
	must have Subdivision1
	(
		type = picklist	
		values  = Subdivision.ID
    	displayformat = [Subdivision_Name]
	 	row = 5
	 	column = 1   
		width = medium
	)
	Origin
	(
    	type = text
	 	row = 6
	 	column = 1   
		width = medium
	)
	Request_JSON
	(
    	type = textarea
		height = 13px
	 	row = 7
	 	column = 1   
		width = medium
	)
	Result_JSON
	(
    	type = textarea
		height = 13px
	 	row = 8
	 	column = 1   
		width = medium
	)
	State
	(
    	type = text
	 	row = 9
	 	column = 1   
		width = medium
	)
	Error
	(
    	type = textarea
		height = 13px
	 	row = 10
	 	column = 1   
		width = medium
	)
	Duration_Operation_ID
	(
    	type = text
	 	row = 11
	 	column = 1   
		width = medium
	)
	Reverses_Operation_ID
	(
    	type = text
	 	row = 12
	 	column = 1   
		width = medium
	)
	Inflight_Record_Key
	(
    	type = text
	 	row = 13
	 	column = 1   
		width = medium
	)
	Execution_Finished
	(
    	type = checkbox
		initial value = false
	 	row = 14
	 	column = 1   
		width = medium
	)
	
	actions
	{
		on add
		{
			submit
			(
   				type = submit
   				displayname = "Submit"
			)
		}
		on edit
		{
			update
			(
   				type = submit
   				displayname = "Update"
			)
			cancel
			(
   				type = cancel
   				displayname = "Cancel"
			)
		}
	}
}
