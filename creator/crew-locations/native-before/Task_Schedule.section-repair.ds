form Task_Schedule
{
	must have Subdivision1
	(
		type = picklist	
		values  = Subdivision.ID
    	displayformat = [Subdivision_Name]
	 	row = 1
	 	column = 1   
		width = medium
	)
	must have Stage_Key
	(
    	type = text
	 	row = 2
	 	column = 1   
		width = medium
	)
	Start_Date
	(
    	type = date
		alloweddays = 0,1,2,3,4,5,6
	 	row = 3
	 	column = 1   
		width = medium
	)
	End_Date
	(
    	type = date
		alloweddays = 0,1,2,3,4,5,6
	 	row = 4
	 	column = 1   
		width = medium
	)
	must have Source_System
	(
    	type = text
	 	row = 5
	 	column = 1   
		width = medium
	)
	must have Source_Record_ID
	(
    	type = text
	 	row = 6
	 	column = 1   
		width = medium
	)
	must have unique Source_Key
	(
    	type = text
	 	row = 7
	 	column = 1   
		width = medium
	)
	Source_Task_ID
	(
    	type = text
	 	row = 8
	 	column = 1   
		width = medium
	)
	Source_Milestone_ID
	(
    	type = text
	 	row = 9
	 	column = 1   
		width = medium
	)
	Source_Modified_At
	(
    	type = datetime
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
	 	row = 10
	 	column = 1   
		width = medium
	)
	Synced_At
	(
    	type = datetime
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
	 	row = 11
	 	column = 1   
		width = medium
	)
	Write_Enabled
	(
    	type = checkbox
		initial value = false
	 	row = 12
	 	column = 1   
		width = medium
	)
	
	actions
	{
		on add
		{
			submit
			(
   				type = submit
   				displayname = "Submit"
			)
		}
		on edit
		{
			update
			(
   				type = submit
   				displayname = "Update"
			)
			cancel
			(
   				type = cancel
   				displayname = "Cancel"
			)
		}
	}
}
