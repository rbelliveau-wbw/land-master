map crewSyncEmployees(bool dryRun)
{
	result = {"ok":false};
	auditId = "";
	created = 0; updated = 0; skipped = 0; received = 0; processed = 0; attempted = false;
	stage = "Starting"; recordKey = "";
	try
	{
		if(!dryRun)
		{
			audit = thisapp.workflowRunLog({"action":"start","workflow":"Daily Crew Employees","system":"Zoho Analytics / HeavyJob","stage":"Reading employee directory"});
			auditId = ifnull(audit.get("id"),"").toString();
			if(!auditId.matches("[0-9]+")) { throw "The employee audit start was not acknowledged. No employee changes were applied."; }
		}
		stage = "Reading employee directory";
		config = Map();
		config.put("selectedColumns",{"zzz_BUEmployeeID_Guid","EmployeeName","EmployeeCode","IsActive","IsDeleted"});
        rows = thisapp.analyticsExportRows("2107789000036057124",config,auditId,false);
		received = rows.size();
		stage = "Validating employee directory";
		if(auditId != "") { thisapp.workflowRunLog({"action":"update","id":auditId,"stage":stage,"counts":{"received":received,"processed":0}}); }
		seen = List(); normalized = List(); validFlags = {"true","false"};
		// Validate the entire export before changing any roster record. Absence is
		// never evidence of inactivity; only an explicit source flag changes it.
		exportColumns = rows.get(0).keys();
		for each field in {"zzz_BUEmployeeID_Guid","EmployeeName","EmployeeCode","IsActive","IsDeleted"} { if(!exportColumns.contains(field)) { throw "Employee export is missing column " + field + ". No employee changes were applied."; } }
		for each row in rows
		{
			key = ifnull(row.get("zzz_BUEmployeeID_Guid"),"").toString().trim().toUpperCase();
			name = ifnull(row.get("EmployeeName"),"").toString().trim();
			code = ifnull(row.get("EmployeeCode"),"").toString().trim();
			activeFlag = ifnull(row.get("IsActive"),"").toString().toLowerCase();
			deletedFlag = ifnull(row.get("IsDeleted"),"").toString().toLowerCase();
			if(!key.matches("[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}") || seen.contains(key) || !validFlags.contains(activeFlag) || !validFlags.contains(deletedFlag))
			{
				throw "Employee export contains an invalid/duplicate BU identity or missing activity flag. No roster changes were applied.";
			}
			active = activeFlag == "true" && deletedFlag == "false";
			// BU GUID is the key; an employee code is optional. Blank names never replace a saved name.
			seen.add(key); normalized.add({"key":key,"name":name,"code":code,"active":active});
		}
		stage = "Synchronizing employee roster";
		if(auditId != "") { thisapp.workflowRunLog({"action":"update","id":auditId,"stage":stage}); }
		for each employee in normalized
		{
			key = employee.get("key"); recordKey = key; processed = processed + 1;
			existing = Employees[BU_Employee_ID == key];
			if(existing.count() > 1) { throw "Duplicate native BU employee identity requires review."; }
			skipEmployee = false;
			if(existing.count() == 0)
			{
				if(employee.get("active") != true || employee.get("name") == "") { skipEmployee = true; }
			}
			if(skipEmployee) { skipped = skipped + 1; }
			else if(existing.count() == 0)
			{
				if(!dryRun)
				{
					attempted = true;
					newId = insert into Employees
					[
						Added_User=zoho.loginuser
						BU_Employee_ID=key
						EmployeeName=employee.get("name")
						Employee_Code=employee.get("code")
						IsActive=true
						Territory="N/A"
						Synced_At=zoho.currenttime
					];
				}
				created = created + 1;
			}
			else
			{
				if(!dryRun)
				{
					attempted = true;
					// Staffing belongs to LM: never overwrite Territory, Labor_Type or Crew.
					if(employee.get("name") != "") { existing.EmployeeName = employee.get("name"); }
					existing.Employee_Code = employee.get("code");
					existing.IsActive = employee.get("active");
					existing.Synced_At = zoho.currenttime;
				}
				updated = updated + 1;
			}
		}
		if(processed != received || created + updated + skipped != received) { throw "Employee source/destination operation counts did not reconcile."; }
		result = {"ok":true,"dryRun":dryRun,"received":received,"processed":processed,"created":created,"updated":updated,"skipped":skipped};
		if(auditId != "") { thisapp.workflowRunLog({"action":"finish","id":auditId,"status":"Success","stage":"Employee roster synchronized","counts":{"received":received,"processed":processed,"created":created,"updated":updated,"skipped":skipped,"failed":0},"details":"Counts reconciled: every source row was created, updated or intentionally skipped. Employee staffing and retained inactive records are preserved."}); }
	}
	catch(syncError)
	{
		auditStatus = "Failed"; if(attempted) { auditStatus = "Partial"; }
		if(auditId.matches("[0-9]+")) { thisapp.workflowRunLog({"action":"finish","id":auditId,"status":auditStatus,"stage":stage,"counts":{"received":received,"processed":processed,"created":created,"updated":updated,"skipped":skipped,"failed":1},"message":syncError.toString(),"details":"Stopped at source key " + recordKey + ". Counts identify completed native operations before failure; Creator may roll them back. Check records before retrying. No automatic replay."}); }
		throw syncError.toString();
	}
	return result;
}
