				{
					actions 
					{
						custom deluge script
						(
											for each  subdiv in input.Subdivisions
										{
											for each  year in input.Forecast_Year
											{
												fcYear = Forecast_Year[Subdivision1 == subdiv && Forecast_Year == year && Status == "Planning"];
												if(fcYear.count() != 0 && input.Status == "Planning")
												{
													alert "Planning Forecast for " + subdiv.Subdivision_Name + " for the year " + year + " already exists.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
