		page Forecast_Management
		{
			displayname = "Forecast Management"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='27%'\n   \t>\n\t<form \n\telementName='Form'\n\n\t\n\ttitle = 'Forecast Search'\n\t\n\tappLinkName = 'thisapp'\n\tlinkName = 'Forecast_Search'\n\theightType = 'auto'\n\turlType = 'none'\n\tzc_Header = 'false'\n/> \n</column><column\n   \t\t width='62%'\n   \t>\n\t<dsp id='html_snippet5' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet5()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div&gt; \t\n&lt;iframe name=&apos;frame13&apos; allowTransparency=&apos;false&apos;  style=&quot;box-sizing:border-box; width:100%; height:500px; border: 2px solid LightSkyBlue&quot; src=&apos;&lt;%=zoho.appuri%&gt;view-embed/All_Subdivisions?&apos;&gt;&lt;/iframe&gt;    \n &lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column><column\n   \t\t width='11%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Project'\n\t\ttarget = 'popup'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='Add Project'\n\t\ttype = 'rounded'\n\t\tbgColor = '#0072F4'\n\t\tcornerRadius = '45.5938px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Subdivision'\n\t\ttarget = 'popup'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='Add Subdivision'\n\t\ttype = 'rounded'\n\t\tbgColor = '#0072F4'\n\t\tcornerRadius = '45.5938px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Builder'\n\t\ttarget = 'popup'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='Add Builder'\n\t\ttype = 'rounded'\n\t\tbgColor = '#0072F4'\n\t\tcornerRadius = '45.5938px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet6' elementName='HTML Snippet 1'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet6()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n.parent-container {\n\tdisplay: flex;\n\twidth: 100%;\n\theight: calc(100vh - 120px);\n }\n.child-container {\n\tflex: 1;\n\tmargin: 10px;\n}\n&lt;/style&gt;\n&lt;div class=&quot;parent-container&quot;&gt;\n\t&lt;iframe name=&apos;frame14&apos; src=&apos;&lt;%=zoho.appuri%&gt;view-embed/All_Forecast_Years?&apos; frameborder=&quot;0&quot; allowfullscreen class=&quot;child-container&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Approvals_HTML_Page(int recordID, string status)
		{
			displayname = "Approvals HTML Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet7' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet7()\ncontent\n&lt;%{\n\tthisRecord = Contract_Approvals[ID = input.recordID.tolong()];\n\tthisContract = Contract[ID == thisRecord.Contract1];\n\t//parentContract = Contract [ Approvals1.contains(thisRecord) ];\n\tthisRecord.Status=input.status;\n\t//checks for still pending approvals in the previous sequence\n\tprevSequence = Contract_Approvals[Contract1 == thisRecord.Contract1 &amp;&amp; Status != &quot;Approved&quot; &amp;&amp; Approval_Sequence == thisRecord.Approval_Sequence].count();\n\tnextSequence = thisRecord.Approval_Sequence + 1;\n\tnextApproval = Contract_Approvals[Contract1 == thisRecord.Contract1 &amp;&amp; Status == &quot;Not Sent&quot; &amp;&amp; Approval_Sequence == nextSequence];\n\tif(input.status = &quot;Approved&quot;)\n\t{\n\t\t//get latest Contract Version by created date\n\t\tcontractFile = Contract_Version[Contract1 == thisContract].File_field1 sort by Date_field1 desc;\n\t\temailBody = &quot;&lt;a href=&apos;https://creatorapp.zohopublic.com/wbdevelopment/land-master/view-perma/Approvals_HTML_Page/4rmNhzWYQvp62uhC832KNqhvBkdfuCdHaTRuAkPzRZVemp6h2k4OGUgyyJrsAwM4DS53SHuuJpdy3Bk5DuKFbFqey0y4VyMMdZs3?recordID=&quot; + nextApproval.ID + &quot;&amp;status=Approved&apos;&gt;Approve&lt;/a&gt;&lt;br&gt;&lt;a href=&apos;https://creatorapp.zohopublic.com/wbdevelopment/land-master/Contract_Approvals/record-edit/All_Contract_Approvals/&quot; + nextApproval.ID + &quot;/56FD5tkOEUKxhpxFhOkgQrUbN8yQVks7WpPAUU6R300UDB4bp59fsE4RDETy3Sp4yTUaMzeVmfY3OkmXRWSh3O2uXKn4pSrnGeOT&apos;&gt;Reject&lt;/a&gt;&quot;;\n\t\t//for each  approval in nextApproval\n\t\t//{\n\t\t//checks for approval status of Not Send and sends if none in previous stage still waiting for approval\n\t\t//\tif(approval.Status == &quot;Not Sent&quot; &amp;&amp; prevSequence == 0)\n\t\t//\t{\n\t\t//\tsendmail\n\t\t//\t[\n\t\t//from :&quot;Contracts@wbdevelopment.com&quot;\n\t\t//to :approval.Approver\n\t\t//subject :thisContract.Builder.Builder_Name + &quot; contract for &quot; + thisContract.Subdivision1.Subdivision_Name + &quot; is awaiting your approval.&quot;\n\t\t//\tmessage :emailBody + &quot;&lt;p&gt;Subdivision: &quot; + thisContract.Subdivision1.Subdivision_Name + &quot;&lt;/p&gt;&quot; + &quot;&lt;p&gt;Buyer: &quot; + thisContract.Builder.Builder_Name + &quot;//&lt;/p&gt;&quot; + &quot;&lt;p&gt;Initiated by: &quot; + thisContract.Modified_User + &quot;&lt;/p&gt;&quot;\n\t\t//\tAttachments :file:contractFile\n\t\t//\t]\n\t\t//\tapproval.Status=&quot;Awaiting Approval&quot;;\n\t\t//\tapproval.Last_Reminder_Date=zoho.currentdate;\n\t\t//\tapproval.Next_Reminder_Date=approval.Last_Reminder_Date.addDay(approval.Reminder_Interval_Days);\n\t\t//\tthisContract.Current_Approver=approval.Approver;\n\t\t//\t}\n\t\t//\t}\n\t\t%&gt;\nContract approval updated successfully.\n&lt;%\n\t}\n\telse\n\t{\n\t\t//show iframe with Contract Approval with just Notes field, some info, and submit button\n\t\t%&gt;\nRecord Updated Successfully, status is &apos;Reject&apos;\n&lt;%\n\t}\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
