			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'rgba(0, 0, 0, 0)'\n\n    lineHeight = '27'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Lot_Code'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
