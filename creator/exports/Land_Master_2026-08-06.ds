			Set_HTML_Forecast_Manager as "Set HTML - Forecast Manager"
			{
				type =  form
				form = Forecast_Manager

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											html = "";
										html = html + "<style>";
										html = html + ".fm-blank-wrap{font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;padding:14px;border:1px solid #d9deea;border-radius:14px;}";
										html = html + ".fm-blank{background:#ffffff;border:1px dashed #c8d3e6;border-radius:16px;padding:42px 28px;text-align:center;box-shadow:0 8px 24px rgba(28,49,94,.06);}";
										html = html + ".fm-blank-title{font-size:22px;font-weight:700;color:#1f2a44;margin-bottom:8px;}";
										html = html + ".fm-blank-sub{font-size:14px;color:#667089;line-height:1.5;max-width:520px;margin:0 auto;}";
										html = html + ".fm-blank-badge{display:inline-block;margin-top:16px;padding:8px 12px;border-radius:999px;background:#eef4ff;border:1px solid #d7e5ff;color:#0d5bd7;font-size:12px;font-weight:700;}";
										html = html + "</style>";
										html = html + "<div class='fm-blank-wrap'>";
										html = html + "<div class='fm-blank'>";
										html = html + "<div class='fm-blank-title'>Run a Search</div>";
										html = html + "<div class='fm-blank-sub'>Choose a subdivision, builder, or year above, then click Search to load forecast details and takedown schedules.</div>";
										html = html + "</div>";
										input.plain1 = html;
						)
					}
				}

			}
			Cancel_Submit_Forecast_Ma as "Cancel Submit - Forecast Manager"
			{
				type =  form
				form = Forecast_Manager

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(1 == 1)
										{
											alert "Use TAB to navigate instead of pressing Enter.";
											cancel submit;
										}
						)
					}
				}

			}
			Lockdown_Fields_Contract_ as "Lockdown Fields - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Contract_Action;
										hide Contract1;
										hide Current_Action;
										hide Status;
										hide Start_Date;
										hide Due_Date;
										hide Complete_Date;
										hide Contract_Action;
										if(input.Complete == TRUE)
										{
											disable Complete;
										}
						)
					}
				}

			}
			Checked_Done_Actions_Cont as "Checked Done Actions - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on user input of Complete
				{
					actions 
					{
						custom deluge script
						(
											if(input.Complete_Date == null && input.Complete == TRUE)
										{
											input.Complete_Date = zoho.currentdate;
											input.Status = "Complete";
										}
						)
					}
				}

			}
			Success_Message_Contract_ as "Success Message - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on success
				{
					actions 
					{
						success message "Contract updated.";
					}
				}

			}
			Dev_Notes_Contract_Action as "Dev Notes - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Complete == TRUE && input.Dev_Notes == "")
										{
											alert "Please input Dev Notes and resubmit.";
											cancel submit;
										}
										if(input.Complete == TRUE && input.Dev_Mgr == null)
										{
											alert "Please input a Development Manager and resubmit.";
											cancel submit;
										}
						)
					}
				}

			}
			Load_HTML_CSS_Contract_Ac as "Load HTML/CSS - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											statusText = "Open";
										statusClass = "open";
										if(input.Complete == true || ifnull(input.Status,"") == "Complete")
										{
											statusText = "Complete";
											statusClass = "complete";
										}
										contractName = "—";
										if(input.Contract1 != null)
										{
											try 
											{
												contractName = ifnull(input.Contract1.Contract_Name,"—");
											}
											catch (e)
											{
												contractName = "—";
											}
										}
										actionText = ifnull(input.Contract_Action,"—");
										startDateText = "—";
										if(input.Start_Date != null)
										{
											startDateText = input.Start_Date.toString("MM/dd/yyyy");
										}
										dueDateText = "—";
										if(input.Due_Date != null)
										{
											dueDateText = input.Due_Date.toString("MM/dd/yyyy");
										}
										completeDateText = "—";
										if(input.Complete_Date != null)
										{
											completeDateText = input.Complete_Date.toString("MM/dd/yyyy");
										}
										completeHelper = "Sets action to complete and adds todays date.";
										if(input.Complete == true && completeDateText != "—")
										{
											completeHelper = "Completed on " + completeDateText + ".";
										}
										contractName = contractName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										actionText = actionText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										completeHelperCss = completeHelper.replaceAll("\\","\\\\").replaceAll("'","\\'");
										html = "";
										html = html + "<style>";
										html = html + ".zc-Action_Summary_HTML-group{margin-bottom:0!important;}";
										html = html + ".zc-Action_Summary_HTML-group>.form-label{display:none!important;}";
										html = html + ".zc-Action_Summary_HTML-group .form-field{width:100%!important;float:none!important;}";
										html = html + ".ca-wrap{padding:8px 0 0 0;font-family:Arial,Helvetica,sans-serif;}";
										html = html + ".ca-card{background:#fff;border:1px solid #dfe5ee;border-radius:12px 12px 0 0;overflow:hidden;box-shadow:0 2px 10px rgba(16,24,40,.04);border-bottom:0;}";
										html = html + ".ca-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:18px 20px;border-bottom:1px solid #edf1f6;background:#fbfcfe;}";
										html = html + ".ca-eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:4px;}";
										html = html + ".ca-contract{font-size:20px;font-weight:700;color:#1f2937;line-height:1.2;margin-bottom:4px;}";
										html = html + ".ca-sub{font-size:13px;color:#6b7280;}";
										html = html + ".ca-badge{display:inline-block;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap;}";
										html = html + ".ca-badge.open{background:#fff7e6;border:1px solid #f5d48a;color:#9a6700;}";
										html = html + ".ca-badge.complete{background:#ecfdf3;border:1px solid #b7ebc6;color:#18794e;}";
										html = html + ".ca-body{padding:20px;}";
										html = html + ".ca-label{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:8px;}";
										html = html + ".ca-box{border:1px solid #dfe5ee;border-radius:10px;background:#fff;padding:16px;margin-bottom:16px;}";
										html = html + ".ca-action{font-size:18px;font-weight:700;color:#1f2937;line-height:1.35;}";
										html = html + ".ca-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}";
										html = html + ".ca-date{border:1px solid #dfe5ee;border-radius:10px;background:#fafcff;padding:14px;}";
										html = html + ".ca-date-label{display:block;font-size:12px;color:#6b7280;margin-bottom:6px;}";
										html = html + ".ca-date-value{font-size:15px;font-weight:700;color:#1f2937;}";
										html = html + ".ca-note{padding:0 20px 18px 20px;font-size:12px;color:#6b7280;}";
										/* Dev Notes */
										html = html + ".zc-Dev_Notes-group{margin-top:-1px!important;margin-bottom:0!important;padding:18px 20px 14px 20px!important;background:#fff!important;border:1px solid #dfe5ee!important;border-top:0!important;border-bottom:0!important;border-radius:0!important;box-shadow:none!important;}";
										html = html + ".zc-Dev_Notes-group .zc-Dev_Notes-label{display:none!important;}";
										html = html + ".zc-Dev_Notes-group:before{content:'Dev Notes';display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:8px;}";
										html = html + ".zc-Dev_Notes-group .form-field{width:100%!important;float:none!important;}";
										html = html + ".zc-Dev_Notes-group textarea#zc-Dev_Notes{width:100%!important;min-height:140px!important;border:1px solid #cfd8e3!important;border-radius:10px!important;padding:12px!important;box-sizing:border-box!important;font-family:Arial,Helvetica,sans-serif!important;font-size:14px!important;line-height:1.45!important;resize:vertical!important;background:#fff!important;color:#1f2937!important;}";
										html = html + ".zc-Dev_Notes-group textarea#zc-Dev_Notes::placeholder{color:#98a2b3!important;}";
										/* Complete */
										html = html + ".zc-Complete-group{margin-top:-1px!important;margin-bottom:0!important;padding:14px 20px 18px 20px!important;background:#fff!important;border:1px solid #dfe5ee!important;border-top:0!important;border-bottom:0!important;border-radius:0!important;box-shadow:none!important;display:grid!important;grid-template-columns:18px 1fr!important;column-gap:12px!important;row-gap:0!important;align-items:start!important;}";
										html = html + ".zc-Complete-group .decision-box-field{grid-column:1!important;grid-row:1 / span 2!important;position:relative!important;width:18px!important;height:18px!important;margin:2px 0 0 0!important;float:none!important;}";
										html = html + ".zc-Complete-group input.customCheckbox,.zc-Complete-group input.zc_decisionbox{position:absolute!important;opacity:0!important;width:18px!important;height:18px!important;margin:0!important;cursor:pointer!important;}";
										html = html + ".zc-Complete-group .zc_decision_box_label{display:block!important;width:18px!important;height:18px!important;border:1px solid #cfd8e3!important;border-radius:4px!important;background:#fff!important;cursor:pointer!important;position:relative!important;margin:0!important;box-sizing:border-box!important;}";
										html = html + ".zc-Complete-group input.customCheckbox:checked + .zc_decision_box_label,.zc-Complete-group input.zc_decisionbox:checked + .zc_decision_box_label{background:#2d9cff!important;border-color:#2d9cff!important;}";
										html = html + ".zc-Complete-group input.customCheckbox:checked + .zc_decision_box_label:after,.zc-Complete-group input.zc_decisionbox:checked + .zc_decision_box_label:after{content:'';position:absolute;left:5px;top:1px;width:5px;height:10px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg);}";
										html = html + ".zc-Complete-group .decision-box-label{grid-column:2!important;grid-row:1!important;display:block!important;margin:0!important;padding:0!important;font-size:14px!important;font-weight:700!important;color:#1f2a37!important;line-height:1.3!important;}";
										html = html + ".zc-Complete-group .decision-box-label:after{content:'" + completeHelperCss + "';display:block;font-size:13px;font-weight:400;color:#6b7280;line-height:1.45;margin-top:4px;}";
										html = html + ".zc-Complete-group .decision-box-label .zc-lable-text{display:inline!important;}";
										/* Dev Mgr */
										html = html + ".zc-Dev_Mgr-group{margin-top:-1px!important;margin-bottom:0!important;padding:0 20px 18px 20px!important;background:#fff!important;border:1px solid #dfe5ee!important;border-top:0!important;border-radius:0 0 12px 12px!important;box-shadow:0 2px 10px rgba(16,24,40,.04)!important;}";
										html = html + ".zc-Dev_Mgr-group>.form-label,.zc-Dev_Mgr-group .zc-Dev_Mgr-label{display:none!important;}";
										html = html + ".zc-Dev_Mgr-group:before{content:'Dev Mgr';display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:8px;}";
										html = html + ".zc-Dev_Mgr-group .form-field{width:100%!important;float:none!important;margin:0!important;}";
										html = html + ".zc-Dev_Mgr-group select,.zc-Dev_Mgr-group input[type='text']{width:100%!important;min-height:42px!important;border:1px solid #cfd8e3!important;border-radius:10px!important;padding:0 12px!important;box-sizing:border-box!important;font-family:Arial,Helvetica,sans-serif!important;font-size:14px!important;line-height:40px!important;background:#fff!important;color:#1f2937!important;box-shadow:none!important;}";
										html = html + ".zc-Dev_Mgr-group .select2-container{width:100%!important;}";
										html = html + ".zc-Dev_Mgr-group .select2-container .select2-choice{height:42px!important;line-height:42px!important;border:1px solid #cfd8e3!important;border-radius:10px!important;background:#fff!important;box-shadow:none!important;padding-left:12px!important;color:#1f2937!important;}";
										html = html + ".zc-Dev_Mgr-group .select2-container .select2-choice .select2-arrow{border-left:0!important;background:transparent!important;}";
										html = html + ".zc-Dev_Mgr-group .select2-container-active .select2-choice,.zc-Dev_Mgr-group select:focus,.zc-Dev_Mgr-group input[type='text']:focus{border-color:#2d9cff!important;box-shadow:0 0 0 2px rgba(45,156,255,.10)!important;outline:none!important;}";
										html = html + "@media (max-width:700px){.ca-head{display:block;}.ca-badge{margin-top:12px;}.ca-grid{grid-template-columns:1fr;}}";
										html = html + "</style>";
										html = html + "<div class='ca-wrap'>";
										html = html + "<div class='ca-card'>";
										html = html + "<div class='ca-head'>";
										html = html + "<div>";
										html = html + "<div class='ca-eyebrow'>Contract</div>";
										html = html + "<div class='ca-contract'>" + contractName + "</div>";
										html = html + "<div class='ca-sub'>Contract Action</div>";
										html = html + "</div>";
										html = html + "<div class='ca-badge " + statusClass + "'>" + statusText + "</div>";
										html = html + "</div>";
										html = html + "<div class='ca-body'>";
										html = html + "<div class='ca-box'>";
										html = html + "<div class='ca-label'>Action</div>";
										html = html + "<div class='ca-action'>" + actionText + "</div>";
										html = html + "</div>";
										html = html + "<div class='ca-grid'>";
										html = html + "<div class='ca-date'>";
										html = html + "<span class='ca-date-label'>Start</span>";
										html = html + "<span class='ca-date-value'>" + startDateText + "</span>";
										html = html + "</div>";
										html = html + "<div class='ca-date'>";
										html = html + "<span class='ca-date-label'>Due</span>";
										html = html + "<span class='ca-date-value'>" + dueDateText + "</span>";
										html = html + "</div>";
										html = html + "<div class='ca-date'>";
										html = html + "<span class='ca-date-label'>Completed</span>";
										html = html + "<span class='ca-date-value'>" + completeDateText + "</span>";
										html = html + "</div>";
										html = html + "</div>";
										html = html + "</div>";
										html = html + "<div class='ca-note'>Add notes and mark complete below.</div>";
										html = html + "</div>";
										html = html + "</div>";
										input.Action_Summary_HTML = html;
						)
					}
				}

			}
