		form Takedown_Schedule
		{
			title 
    		{
				displayname = "Add Takedown Schedule"
    			on add = "Create Takedown Schedule"
   	 			on edit = "Edit Takedown Schedule"
			}
			success message = "Takedown Schedule Added Successfully"
			Takedown_Details
			(
				type = section
				displayname = "Takedown Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div style=\"border-bottom: 1px dashed black; background-color: rgb(244, 246, 249); text-align: center\"><b><span class=\"size\" style=\"font-size: 18px\">Overview </span> </b> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Builder1
			(
				type = picklist	
				displayname = "Builder"
				values  = Builder.ID
    			displayformat = [Builder_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subdivisions
			(
				type = list	
				values  = Subdivision.ID
    			displayformat = [Subdivision_Name]
				sortorder = ascending
				height = 60px
    			description
    			[
    				type = tooltip
    			 	message = "Only select multiple Subdivisions here if the Builder has a contract that spans multiple Subdivisions within the same Project."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Behind","Completed"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Initial_Closing_Date
			(
    			type = date
				displayname = "Initial Closing Date"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "This field will override the Takedown Start Date, otherwise the earliest Lot Sold Date will be used as the beginning of the schedule."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unlock_Hidden
			(
    			type = checkbox
				displayname = "Unlock Hidden"
				initial value = false
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain1
			(
    			type = plaintext
				value = "<div style=\"border-bottom: 1px dashed black; background-color: rgb(244, 246, 249); text-align: center\"><b><span class=\"size\" style=\"font-size: 18px\">Takedown Details </span> </b> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Lot_Obligation
			(
				type = number
				displayname = "Total Lot Obligation"
				maxchar = 3
	 			row = 1
	 			column = 2   
				width = medium
			)
			Initial_Takedown
			(
				type = number
				displayname = "Initial Takedown (Lots)"
