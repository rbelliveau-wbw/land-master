			Lockdown_Fields_Forecast_ as "Lockdown Fields - Forecast Manager"
			{
				type =  form
				form = Forecast_Manager

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Forecasts.Builder1;
										disable Forecasts.Subdivision1;
										disable Forecasts.WFY;
										disable WFY;
										disable Builders;
										hide Forecasts.JANID;
										hide Forecasts.FEBID;
										hide Forecasts.MARID;
										hide Forecasts.APRID;
										hide Forecasts.MAYID;
										hide Forecasts.JUNID;
										hide Forecasts.JULID;
										hide Forecasts.AUGID;
										hide Forecasts.SEPID;
										hide Forecasts.OCTID;
										hide Forecasts.NOVID;
										hide Forecasts.DECID;
						)
					}
				}

			}
			Button_Actions_Lot_Search as "Button Actions - Lot Search"
			{
