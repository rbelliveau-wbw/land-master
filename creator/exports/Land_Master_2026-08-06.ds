			Lock_Final_Budget as "Lock Final Budget"
			{
				type =  functions
				form = Add_Budget
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Lock_Final_Budget == FALSE)
										{
											for each  budgItem in Budget_Item[Budget == input.ID && Department == "Construction"]
											{
												if(budgItem.Unapproved_Final_Budget_Ttl > 0 && budgItem.Unapproved_Final_Budget_Ttl != NULL)
												{
													budgItem.Budget_Ttl=budgItem.Unapproved_Final_Budget_Ttl;
													budgItem.Unapproved_Final_Budget_Ttl=null;
												}
											}
											input.Lock_Final_Budget = TRUE;
											input.Lock_Final_Budget_Date = zoho.currentdate;
										}
					)
					}
				}
			}
