	 			row = 1
	 			column = 2   
				width = medium
			)
			Initial_Delay_Days
			(
				type = number
				displayname = "Initial Delay (Days)"
				maxchar = 3
	 			row = 1
	 			column = 2   
				width = medium
			)
			Continued_Takedown
			(
				type = number
				displayname = "Subsequent Takedown (Lots)"
				maxchar = 3
	 			row = 1
	 			column = 2   
				width = medium
			)
