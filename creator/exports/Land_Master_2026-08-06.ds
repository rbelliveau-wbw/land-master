			Pop_Sale_Installments_Pro1 as "Pop Sale Installments - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Land_Sale
				{
					actions 
					{
						custom deluge script
						(
											if(input.Land_Sale != null && input.Sale_Installments != null)
										{
											input.Land_Sale_Installments.clear();
											loop = thisapp.forLoop(1,input.Sale_Installments);
											installmentStart = 1;
											for each  el in loop
											{
												row = Add_Pro_Forma.Land_Sale_Installments();
												row.Installment=installmentStart;
												row.Month1=installmentStart;
												row.Percent1=100 / input.Sale_Installments;
												row.Cost=input.Land_Sale / input.Sale_Installments;
												row.Type1="Sale";
												row.Date1=input.Estimated_Purchase_Date.addMonth(installmentStart - 1);
												input.Land_Sale_Installments.insert(row);
												installmentStart = installmentStart + 1;
											}
										}
										if(input.Land_Sale == null || input.Sale_Installments == null)
										{
											input.Land_Sale_Installments.clear();
										}
						)
					}
				}

			}
			Populate_Additional_Costs as "Populate Additional Costs - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

