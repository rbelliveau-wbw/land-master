			Select_Tax_Rates_Template as "Select Tax Rates (Template) - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Tax_Rate_Template
				{
					actions 
					{
						custom deluge script
						(
											taxRates = Tax_Rate_Template[ID = input.Tax_Rate_Template].Tax_Rates.getAll();
										input.Tax_Rates = taxRates;
										if(input.Tax_Rate_Template == null)
										{
											taxRates = Tax_Rate[Taxing_Jurisdiction2 = input.Taxing_Jurisdiction2].ID.getAll();
											input.Tax_Rates = taxRates;
										}
						)
					}
				}

			}
			Mass_Update_Tax_Mass_Upda as "Mass Update Tax - Mass Update Tax"
			{
				type =  form
				form = Mass_Update_Tax

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										for each  parcel in input.Tax_Parcel_Year
										{
											for each  taxRate1 in input.Tax_Rates
											{
												totalTaxrate = totalTaxrate + taxRate1.Tax_Rate;
											}
											taxRates = input.Tax_Rates.toList();
											if(input.Status != null)
											{
												parcel.Appeal_Protest=input.Status;
											}
											if(taxRates.size() != 0)
											{
												parcel.Tax_Rates=input.Tax_Rates;
												parcel.Cumulative_Tax_Rate=totalTaxrate;
											}
											if(input.Appeal_Date != null)
											{
												parcel.Protest_Hearing_Date=input.Appeal_Date;
											}
											if(input.Appeal_Deadline != null)
											{
												parcel.Protest_Deadline=input.Appeal_Deadline;
											}
											if(input.FMV != null)
											{
												parcel.Notice_FMV=input.FMV;
											}
											if(input.Appraised_Value != null)
											{
												parcel.Appraised_Value=input.Appraised_Value;
											}
											if(input.Protest_Value != null)
											{
												parcel.Protest_Value=input.Protest_Value;
											}
											if(input.Arbitration_Value != null)
											{
												parcel.Arbitration_Value=input.Arbitration_Value;
											}
										}
										info taxRates;
										openUrl("#Script:page.parent.refresh ","parent window");
						)
					}
				}

			}
			Set_Subdiv_Blank_Mass_Cre as "Set Subdiv Blank - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Property1
				{
					actions 
					{
						custom deluge script
						(
											subdiv = input.Subdivision.size();
										property = input.Property1.size();
										if(property != 0 && subdiv != 0)
										{
											input.Subdivision = null;
										}
						)
					}
				}

			}
			Set_Property_Blank_Select as "Set Property Blank & Select Lots - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Subdivision
				{
					actions 
					{
						custom deluge script
						(
											subdiv = input.Subdivision.size();
										property = input.Property1.size();
										if(property != 0 && subdiv != 0)
										{
											input.Property1 = null;
										}
										lotsList = Lots[Subdivision == input.Subdivision && Close_Date == null].ID.getAll();
										input.Lots1 = lotsList;
										input.Total_Lots = lotsList.size();
						)
					}
				}

			}
			Mass_Create_Tax_Parcel_Ye1 as "Mass Create Tax Parcel Years - Property"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										subdiv = input.Subdivision.size();
										property = input.Property1.size();
										for each  taxRate1 in input.Tax_Rates
										{
											totalTaxrate = totalTaxrate + taxRate1.Tax_Rate;
										}
										if(property != 0)
										{
											for each  prop in Property[ID == input.Property1]
											{
												tpy = insert into Tax_Parcel_Year
												[
													Tax_Parcel_Year_Code=prop.Common_Name + "-" + input.Year1
													Property1=prop.ID
													Added_User=zoho.loginuser
													Tax_Year=input.Year1
													Taxing_Jurisdiction1=input.Taxing_Jurisdiction2
													Tax_Rates=input.Tax_Rates
													Cumulative_Tax_Rate=totalTaxrate
												];
											}
										}
						)
					}
				}

			}
			Send_Email_Form_Propertie1 as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Mass_Create_Tax
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : "Land Master : New entry added"
							message : "Hello,<br/><br/>A new entry added in 'Mass Create Tax' form of 'Land Master' application.<br/>"
							attachments : template : _default as inline
						)
					}
				}
			}
