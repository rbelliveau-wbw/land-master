			Lot_Search_Code_Search as "Lot Search - Code Search"
			{
				type =  form
				form = Lot_Search

				record event = on add or edit

				on user input of Code_Search
				{
					actions 
					{
						custom deluge script
						(
											lotCode = "";
										lotBuyer = "";
										lotStatus = "";
										lotCity = "";
										lotCounty = "";
										subdivName = "";
										basePrice = "";
										lotNo = "";
										block = "";
										monthName = "";
										monthNum = "";
										monthSearch = "";
										specDate = "";
										monthQuery = "";
										reportName = "All_Active_Lots_List_View?";
										if(input.Date_Select = "Entered Date" && input.Specific_Month.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											months = Map();
											months.put("January","01");
											months.put("February","02");
											months.put("March","03");
											months.put("April","04");
											months.put("May","05");
											months.put("June","06");
											months.put("July","07");
											months.put("August","08");
											months.put("September","09");
											months.put("October","10");
											months.put("November","11");
											months.put("December","12");
											monthSelection = input.Specific_Month;
											for each  month in monthSelection
											{
												monthSearch = monthSearch + months.get(month.toString()) + ",";
											}
											monthQuery = "&&Entered_Date_Text=[" + monthSearch + "]&Entered_Date_Text_op=24" + "&&Entered_Date_Text=" + specDate;
										}
										if(input.Date_Select = "Entered Date" && input.Specific_Date.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											monthQuery = "&&Entered_Date_Text=" + specDate;
										}
										if(input.Date_Select = "Purchase Date" && input.Specific_Month.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											months = Map();
											months.put("January","01");
											months.put("February","02");
											months.put("March","03");
											months.put("April","04");
											months.put("May","05");
											months.put("June","06");
											months.put("July","07");
											months.put("August","08");
											months.put("September","09");
											months.put("October","10");
											months.put("November","11");
											months.put("December","12");
											monthSelection = input.Specific_Month;
											for each  month in monthSelection
											{
												monthSearch = monthSearch + months.get(month.toString()) + ",";
											}
											monthQuery = "&&Purch_Date_Text=[" + monthSearch + "]&Purch_Date_Text_op=24" + "&&Purch_Date_Text=" + specDate;
										}
										if(input.Date_Select = "Purchase Date" && input.Specific_Date.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											monthQuery = "&&Purch_Date_Text=" + specDate;
										}
										if(input.Date_Select = "Close Date" && input.Specific_Month.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											months = Map();
											months.put("January","01");
											months.put("February","02");
											months.put("March","03");
											months.put("April","04");
											months.put("May","05");
											months.put("June","06");
											months.put("July","07");
											months.put("August","08");
											months.put("September","09");
											months.put("October","10");
											months.put("November","11");
											months.put("December","12");
											monthSelection = input.Specific_Month;
											for each  month in monthSelection
											{
												monthSearch = monthSearch + months.get(month.toString()) + ",";
											}
											monthQuery = "&&Close_Date_Text=[" + monthSearch + "]&Close_Date_Text_op=24" + "&&Close_Date_Text=" + specDate;
										}
										if(input.Date_Select = "Close Date" && input.Specific_Date.isEmpty() = false)
										{
											specDate = input.Specific_Date;
											monthQuery = "&&Close_Date_Text=" + specDate;
										}
										if(input.Code_Search != "")
										{
											//companyName = "Company1=" + input.Search_All + "&Company1_op=26";
											lotCode = "&Lot_Code=" + input.Code_Search + "&Lot_Code_op=26";
											//subdivName = "&Subdivision=" + input.Code_Search + "&Subdivision_op=26";
										}
										if(input.Buyer.isEmpty() = false)
										{
											lotBuyer = "&&Builder1=[" + Builder[ID == input.Buyer].Builder_Name.getAll() + "]";
										}
										if(input.Status.isEmpty() = false)
										{
											lotStatus = "&&Status=[" + input.Status + "]";
										}
										if(input.County.isEmpty() = false)
										{
											lotCounty = "&&County=[" + input.County + "]";
										}
										if(input.City.isEmpty() = false)
										{
											lotCity = "&&City=[" + input.City + "]";
										}
										if(input.Subdivision1.isEmpty() = false)
										{
											subdivName = "&&Subdivision=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
										}
										if(input.Base_Price.isEmpty() = false)
										{
											basePrice = "&&Base_Price=" + input.Base_Price;
										}
										if(input.Lot_No.isEmpty() = false)
										{
											lotNo = "&&Lot_Number=" + input.Lot_No;
										}
										if(input.Block.isEmpty() = false)
										{
											block = "&&Block=[" + input.Block + "]";
										}
										if(input.Spreadsheet_View = TRUE)
										{
											reportName = "All_Active_Lots?";
										}
										lotsUrl = zoho.appuri + "view-embed/" + reportName;
										queryUrl = lotsUrl + lotCode + lotBuyer + lotStatus + lotCity + lotCounty + subdivName + basePrice + lotNo + block + monthQuery;
										openUrl(queryUrl,"iframe","frame16");
										info queryUrl;
										info lotStatus;
						)
					}
				}

			}
