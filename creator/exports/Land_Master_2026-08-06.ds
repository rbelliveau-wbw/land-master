										// active: filled + sits “on” the baseline like a real selected tab
										x = x + ".zc-Addl_Costs_Tabs-group .form-field .tempContDiv .choice-table-row .choice-table-cell span .customRadio:checked ~ label.choice-label-text{" + "background:#f59e0b!important;" + "border-color:#f59e0b!important;" + "color:#ffffff!important;" + "transform:none!important;" + "position:relative!important;" + "top:7px!important;" + "}";
										// ===== ADDL COSTS TABS: remove the baseline line + tighten vertical gap =====
										x = x + ".zc-Addl_Costs_Tabs-group .form-field .tempContDiv{" + "border-bottom:0!important;" + "padding-bottom:0!important;" + "margin-bottom:6px!important;" + "}";
										// Tighten the overall field block spacing (gap above/below the pills)
										x = x + ".form-group.clearfix.zc-Addl_Costs_Tabs-group.zc-radio-field-group{" + "margin:6px 0 8px 0!important;" + "}";
										// Optional: remove extra right-padding space some layouts add in the field container
										x = x + ".zc-Addl_Costs_Tabs-group .form-field{padding:0!important;margin:0!important;}";
										x = x + "</style>";
										input.plain = x;
										input.Tabs = "General Information";
						)
