			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			Auto_Generated_Fields
			(
				type = section
				displayname = "Auto Generated Fields"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			unique Takedown_Schedule_Code
			(
    			type = text
				displayname = "Takedown Schedule Code"
    			description
    			[
    				type = tooltip
    			 	message = "Name will be autogenerated from other fields, no need to enter a value"
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Takedown_Start_Date
			(
    			type = date
				displayname = "Takedown Start Date"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "This field is auto-filled based on the earliest Close Date"
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Takedown_End_Date
			(
    			type = date
				displayname = "Takedown End Date"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "This field is calculated from the Takedown Start Date and Initial Delay + Continued Delay"
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Last_Takedown_Date
			(
    			type = date
				displayname = "Last Takedown Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Lots_Sold
			(
				type = number
				displayname = "Lots Sold"
				maxchar = 5
    			description
    			[
    				type = tooltip
    			 	message = "Lots Sold is calculated from the amount of lots sold that match the above builder/subdivision/phase criteria"
    			]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Lots_Expected
			(
				type = number
				displayname = "Lots Expected"
				maxchar = 3
    			description
    			[
    				type = tooltip
    			 	message = "Lots Expected is calculated from todays date in comparison to the Takedown Start Date and takedown delays"
    			]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Completion_Percent
			(
    			type = percentage
				displayname = "Completion Percent"
				maxchar = 5
				decimalplace = 0
	 			row = 3
	 			column = 2   
				width = medium
			)
			Last_Takedown_Amount
			(
				type = number
				displayname = "Last Takedown Amount"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Last_30_Day_Sales
			(
				type = number
				displayname = "Last 30 Day Sales"
	 			row = 3
	 			column = 3   
				width = medium
			)
			Last_90_Day_Sales
			(
				type = number
				displayname = "Last 90 Day Sales"
	 			row = 3
	 			column = 3   
				width = medium
			)
			Last_6_Month_Sales
			(
				type = number
				displayname = "Last 6 Month Sales"
	 			row = 3
	 			column = 3   
				width = medium
			)
			Last_12_Month_Sales
			(
				type = number
				displayname = "Last 12 Month Sales"
	 			row = 3
	 			column = 3   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		}
