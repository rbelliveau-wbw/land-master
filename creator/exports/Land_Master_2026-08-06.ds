		}
		form Company
		{
			title 
    		{
				displayname = "Add Company"
    			on add = "Create Company"
   	 			on edit = "Edit Company"
			}
			success message = "Company Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Company_Name
			(
    			type = text
				displayname = "Company Name"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Number
			(
				type = number
				displayname = "Account Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Facility_ID
			(
				type = number
				displayname = "Facility ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Proforma
			(
				type = list	
				values  = Add_Pro_Forma.ID
    			displayformat = [Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Property
			(
				type = grid
				values  = Property.ID
    			bidirectional = Company1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Contract
		{
			title 
    		{
				displayname = "Add Contract"
    			on add = "Create Contract"
   	 			on edit = "Edit Contract"
			}
			success message = "Contract Added Successfully"
			Contract_Info
			(
				type = section
				displayname = "Contract Info"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Contract_Type
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Lot","CCR","Master Services Agreement","Service Agreement","NSSA","DA","Amendment","Acquisition"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subdivision1
			(
				type = list	
				displayname = "Subdivision"
				values  = Subdivision[Status != "Forecast Placeholder" && Status != "Sold Out"].ID
    			displayformat = [Subdivision_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Builder
			(
				type = picklist	
				displayname = "Builder/Counterparty"
				values  = Builder.ID
    			displayformat = [Builder_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Earnest_Money_Per_Lot
			(
				displayname = "Earnest Money Per Lot"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = small
			)
			Number_of_Lots
			(
				type = number
				displayname = "Lot Total"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Initial_Takedown
			(
				type = number
				displayname = "Initial Take (Lots)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Initial_Takedown_Days
			(
				type = number
				displayname = "Initial Take (Days)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Subsequent_Takedown_Lots
			(
				type = number
				displayname = "Cont'd Take (Lots)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Subsequent_Takedown_Days
			(
				type = number
				displayname = "Cont'd Take (Days)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			must have unique Contract_Name
			(
    			type = text
				displayname = "Contract Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = 350px
			)
			must have Territory
			(
				type = picklist
				maxchar = 100
				values = {"Bryan/College Station","Corpus Christi","Dallas/Fort Worth","Fort Hood","Houston","North Austin","San Antonio","South Austin","Temple/Belton","Waco"}
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have WBW_Point_Person
			(
				type = list	
				displayname = "WBW Point Person"
				values = {"RO","Legal","RH","RB","AA","BR","DR","MW","MT","JS","PS","AD","TB","TM","BB","SH","DW","JH","JB","NP","EW","JL","TW","KC"}
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Lots1
			(
				type = list	
				displayname = "Lots"
				values  = Lots.ID
    			displayformat = [Lot_Code + " - " + Lot_Size + "Ft - " + Status]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = large
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"New","Approval Rejected","Feasibility","Awaiting WBW","Awaiting Counterparty","Awaiting Approvals","Approved","Complete"}
				initial value = "New"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Current_Approver
			(
    			type = text
				displayname = "Current Approver"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Current_Action
			(
    			type = textarea
				displayname = "Current Action"
				height = 100px
	 			row = 1
	 			column = 3   
				width = medium
			)
			Lot_Block_Description
			(
    			type = richtext
				displayname = "Lot/Block Description"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7},
					font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue", "EBGaramond", "RobotoCondensed", "ArchivoBlack", "Carlito", "Barlow", "Comfortaa", "Montserrat", "Nunito", "Poppins", "Quicksand", "Raleway", "Rubik", "SourceSansPro"}
				]
				private = true
	 			row = 1
	 			column = 3   
				width = medium
			)
			Archive
			(
    			type = checkbox
				initial value = false
				private = true
	 			row = 1
	 			column = 3   
				width = medium
			)
			Hide
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Takedown_Schedule1
			(
				type = picklist	
				displayname = "Takedown Schedule"
				values  = Takedown_Schedule.ID
    			bidirectional = Add_Contract_Contract_Name
    			displayformat = [Takedown_Schedule_Code]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Company_Entity
			(
				type = picklist	
				displayname = "Company/Entity"
				values  = Company.ID
    			displayformat = [Company_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Project
			(
				type = picklist	
				values  = Project.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			County
			(
				type = picklist
				maxchar = 100
				values = {"Bell","Bexar","Burleson","McLennan","Brazos","Falls","Williamson","Coryell","Guadalupe","Comal","Travis","Harris","Grayson","Collin","Tarrant","Johnson","Kaufman","Ellis","Denton","Hunt","Dallas","Cooke"}
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			City
			(
				type = picklist
				maxchar = 100
				values = {"Killeen","Houston","Granger","Caldwell","Austin","Temple","Waco","Bryan","Belton","Bruceville-Eddy","Copperas Cove","Seguin","Harker Heights","Taylor","New Braunfels","Jarrell","Nolanville","Robinson","Salado","San Antonio","Troy","Georgetown","Addison","Balch Springs","Carrollton","Cedar Hill","Cockrell Hill","Combine","Coppell","Dallas","DeSoto","Duncanville","Farmers Branch","Ferris","Garland","Glenn Heights","Grand Prairie","Grapevine","Highland Park","Hutchins","Irving","Lancaster","Lewisville","Mesquite","Ovilla","Richardson","Rowlett","Sachse","Seagoville","Sunnyvale","University Park","Wilmer","Wylie","League City","Pasadena","Pearland","Sugar Land","Conroe","Katy","Denton","Sherman","Westminster","Anna","Crandall","Midlothian","Celina","Van Alstyne","Greenville","Princeton","Corsicana","Waxahachie","Prosper","Cresson"}
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Completion_Date
			(
    			type = date
				displayname = "Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Totals
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			Earnest_Money
			(
				displayname = "Earnest Money"
				type = USD
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Total_Contract_Price
			(
				displayname = "Total Contract Price"
				type = USD
				format = commadotwestern
	 			row = 3
	 			column = 1   
				width = medium
			)
			Pricing
			(
				type = grid
				values  = Contract_Pricing.ID
    			bidirectional = Contract1
				auto width = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Contract_Actions
			(
				type = grid
				displayname = "Contract Actions"
				values  = Contract_Actions.ID
    			bidirectional = Contract1
				auto width = false
				sorttype = fieldbased
				sort by
				(
					Sort_Order ascending
				)
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 6
	 			column = 0   
				width = medium
			)
			plain5
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 6
	 			column = 1   
				width = medium
			)
			Approvals1
			(
				type = grid
				displayname = "Internal Approvals"
				values  = Contract_Approvals.ID
    			bidirectional = Contract1
				auto width = false
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section3
			(
				type = section
				displayname = "Section"
	 			row = 8
	 			column = 0   
				width = medium
			)
			plain3
			(
    			type = plaintext
				value = "<table style=\"width: 500%; font-size: 10pt; font-family: DejaVuSans, sans-serif; border-collapse: collapse; color: black; margin-bottom: 4px\"><tbody><tr><td style=\"width: 2000px; border-top: 2px dotted black; border-left: none; border-right: none; border-bottom: none\">&nbsp;<br /></td></tr></tbody></table><div><br /></div>"
	 			row = 8
