										}
						)
					}
				}

			}
			Calc_Dev_Budget_Ttl_Budge as "Calc Dev Budget Ttl - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit

				on user input of Budget_Items.Prelim_Budget_Ttl
				{
					actions 
					{
						custom deluge script
						(
											if(row.Prelim_Budget_Ttl > 0 && Reimbursements == TRUE)
										{
											row.Prelim_Budget_Ttl=row.Prelim_Budget_Ttl * -1;
										}
										devbudgetTotal = 0;
										for each  item in input.Budget_Items
										{
											if(item.Prelim_Budget_Ttl == null)
											{
												itemTtl = 0;
											}
											else
											{
												itemTtl = item.Prelim_Budget_Ttl;
											}
											devbudgetTotal = itemTtl + devbudgetTotal;
										}
										input.Prelim_Budget_Total = devbudgetTotal;
						)
					}
				}

			}
