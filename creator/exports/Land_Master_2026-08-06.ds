	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 10
	 			column = 0   
				width = medium
			)
			plain2
			(
    			type = plaintext
				value = "<table style=\"width: 500%; font-size: 10pt; font-family: DejaVuSans, sans-serif; border-collapse: collapse; color: black; margin-bottom: 4px\"><tbody><tr><td style=\"width: 2000px; border-top: 2px dotted black; border-left: none; border-right: none; border-bottom: none\"><br /></td></tr></tbody></table><div><br /></div>"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Contract_Versions
			(
				type = grid
				displayname = "Contract Versions"
				values  = Contract_Version.ID
    			bidirectional = Contract1
				auto width = false
	 			row = 11
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 12
	 			column = 0   
