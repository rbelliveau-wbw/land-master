			Hide_Tax_Fields_Takedown_ as "Hide Tax Fields - Takedown Template"
			{
				type =  form
				form = Takedown_Template

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Additional_Items.Total;
										hide Additional_Items.Builder_Takedown1;
										if(input.Tax_Method == "")
										{
											hide Percent_of_Appraisal;
											hide Tax_Per_Lot;
										}
										if(input.Tax_Method == "Flat")
										{
											hide Percent_of_Appraisal;
											show Tax_Per_Lot;
										}
										if(input.Tax_Method == "Percentage of Appraisal")
										{
											show Percent_of_Appraisal;
											hide Tax_Per_Lot;
										}
						)
					}
				}

			}
