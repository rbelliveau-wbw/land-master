										to11 = input.To_11.toString();
										from12 = input.From_12.toString();
										to12 = input.To_12.toString();
										datesUrl = "&&From_1=" + from1 + "&&To_1=" + to1 + "&&From_2=" + from2 + "&&To_2=" + to2 + "&&From_3=" + from3 + "&&To_3=" + to3 + "&&From_4=" + from4 + "&&To_4=" + to4 + "&&From_5=" + from5 + "&&To_5=" + to5 + "&&From_6=" + from6 + "&&To_6=" + to6 + "&&From_7=" + from7 + "&&To_7=" + to7 + "&&From_8=" + from8 + "&&To_8=" + to8 + "&&From_9=" + from9 + "&&To_9=" + to9 + "&&From_10=" + from10 + "&&To_10=" + to10 + "&&From_11=" + from11 + "&&To_11=" + to11 + "&&From_12=" + from12 + "&&To_12=" + to12;
										tdTemp = "#Form:Takedown_Template?Subdivision1=" + input.Subdivision1 + datesUrl + "&&Builder1=" + input.Builder1 + "&&Tax_Method=" + input.Tax_Method + "&&Tax_Per_Lot=" + taxPer + "&&Percent_of_Base=" + percentageBase + "&&Additional_Fee_Type=" + input.Additional_Fee_Type + "&&Additional_Fee=" + additionalFee + "&&Interest_Rate_1=" + interest1 + "&&Interest_Rate_2=" + interest2 + "&&Interest_Rate_3=" + interest3 + "&&Interest_Rate_4=" + interest4 + "&&Interest_Rate5=" + interest5 + "&&Interest_Rate_6=" + interest6 + "&&Interest_Rate_7=" + interest7 + "&&Interest_Rate_8=" + interest8 + "&&Interest_Rate_9=" + interest9 + "&&Interest_Rate_10=" + interest10 + "&&Interest_Rate_11=" + interest11 + "&&Interest_Rate_12=" + interest12;
										openUrl(tdTemp,"same window");
					)
					}
				}
			}
