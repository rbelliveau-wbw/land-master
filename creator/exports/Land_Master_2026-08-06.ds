										cols.add("H.Major Code");
										cols.add("H.Minor Code");
										cols.add("H.Total Budget Decimal");
										cols.add("J.JobCodeFinal");
										cols.add("H.JobCode");
										cols.add("H.CostCodeDescription");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/12");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each project ===
										//get all Subdiv codes that have a Budget
										budgCodes = Add_Budget[ID != 0].Subdivision_Code.getAll();
										for each  rec in rows
										{
											subdiv = External_System_Mapping[External_Code = rec.get("H.JobCode") && External_System == "HeavyJob"];
											if(budgCodes.contains(subdiv.Subdivision1.Subdivision_Code))
											{
												codeBuild = rec.get("H.JobCode") + "-B-" + rec.get("H.Minor Code");
												budgimpItem = Budget_Import_Item[Code = codeBuild && Data_Source == "HeavyJob Budget"];
												if(budgimpItem.count() == 1)
												{
													budgimpItem.Cost=rec.get("H.Total Budget Decimal").toLong();
													budgimpItem.Updated_Date=zoho.currentdate;
													budgimpItem.Data_Source="HeavyJob Budget";
												}
												if(budgimpItem.count() == 0)
												{
													impItem = insert into Budget_Import_Item
													[
														Data_Source="HeavyJob Budget"
														Cost=rec.get("H.Total Budget Decimal").toLong()
														Cost_Code_Description=rec.get("H.CostCodeDescription")
														Code=codeBuild
														Subdivision_Code=subdiv.Subdivision1.Subdivision_Code
														Major_Code=rec.get("H.Major Code")
														Minor_Code=rec.get("H.Minor Code")
														Added_User=zoho.loginuser
														Cost_Code_ID=rec.get("H.zzz_CostCodeID_Guid")
														Updated_Date=zoho.currentdate
													];
													//CREATE MILESTONE IN CREATOR
												}
											}
										}
					)
					}
				}
			}
			Equipment_Sync_Create_Equ as "Equipment - Sync/Create Equipment from Analytics"
			{
				type =  schedule
				start = "2025-12-17 12:10:04"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Budget_Import_Item Upsert
										// What it does:
										// - Exports selected columns from a Zoho Analytics view.
										// - Builds a list of Subdivision codes that have Budgets.
										// - For each exported row whose JobCode is in that list:
										//     • If a Budget_Import_Item exists (by Cost_Code_ID), update Cost + Updated_Date.
										//     • Else insert a new Budget_Import_Item with mapped fields.
										// Notes:
										// - Ensure TotalActualCost is numeric (normalize if needed).
										// - Requires valid Analytics connection (zoho_analytics_connection).
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000023926003";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("Current_MeterHours");
										cols.add("Name");
										cols.add("Description");
										cols.add("SerialNo");
										cols.add("Description");
										cols.add("EquipmentType");
										cols.add("Year");
										cols.add("PurchasePrice");
										cols.add("PurchaseYear");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each project ===
										//get all Subdiv codes that have a Budget
										for each  rec in rows
										{
											equip = Equipment[Equipment_Code = rec.get("Name")];
											if(equip.count() == 1)
											{
												equip.Equipment_Code=rec.get("Name");
												equip.Equipment_Accounting_Code="E_" + rec.get("Name");
												equip.Current_Meter_Hours=rec.get("Current_MeterHours");
												equip.Description=rec.get("Description");
												equip.Serial_Number=rec.get("SerialNo");
												equip.Type1=rec.get("EquipmentType");
												equip.Year1=rec.get("Year");
												equip.Purchase_Price=rec.get("PurchasePrice");
												equip.Purchase_Date=rec.get("PurchaseYear");
											}
											if(equip.count() == 0)
											{
												equipIns = insert into Equipment
												[
													Added_User=zoho.loginuser
													Equipment_Code=rec.get("Name")
													Equipment_Accounting_Code="E_" + rec.get("Name")
													Current_Meter_Hours=rec.get("Current_MeterHours")
													Description=rec.get("Description")
													Serial_Number=rec.get("SerialNo")
													Type1=rec.get("EquipmentType")
													Year1=rec.get("Year")
													Purchase_Price=rec.get("PurchasePrice")
													Purchase_Date=rec.get("PurchaseYear")
												];
											}
										}
					)
					}
				}
			}
			Update_Projects_Milestone1 as "Update Projects Milestones 2 - Zoho Projects"
			{
				type =  schedule
					status = inactive
				start = "2026-01-06 08:40:17"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						portalId = "700737166";
										orgId = "700732567";
										for each  ms in Milestones[Push_Update == true]
										{
											// === 4) Short delay to let the job initialize ===
											getUrl("https://postman-echo.com/delay/3");
											body = Map();
											body.put("end_date",ms.End_Date.toString("MM-dd-YYYY"));
											body.put("start_date",ms.Start_Date.toString("MM-dd-YYYY"));
											resp = invokeurl
											[
												url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + ms.Project_ID + "/milestones/" + ms.Milestone_ID
												type :POST
												parameters:body.toString()
												connection:"zoho_projects_connection"
											];
											info resp;
											if(resp.toString().contains(ms.Start_Date.toString("YYYY-MM-dd")) && resp.toString().contains(ms.End_Date.toString("YYYY-MM-dd")))
											{
												ms.Push_Update=false;
												info body;
												info resp;
											}
										}
					)
					}
				}
			}
			Set_Contracts_to_Archived as "Set Contracts to Archived - Contracts"
			{
				type =  schedule
				start = "2026-02-11 03:00:17"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//ARCHIVE CONTRACTS THAT HAVE COMPLETION DATE OF 14 OR MORE DAYS IN THE PAST
										cutoffDate = zoho.currentdate.addDay(-14);
										for each  contract in Contract[Archive != true && Completion_Date != null && Completion_Date <= cutoffDate]
										{
											contract.Archive=TRUE;
										}
					)
					}
				}
			}
