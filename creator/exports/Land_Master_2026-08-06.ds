			)
			plain1
			(
    			type = plaintext
				value = "<div><div><br /></div><table style=\"width: 500%; font-size: 10pt; font-family: DejaVuSans, sans-serif; border-collapse: collapse; color: black\"><tbody><tr><td style=\"width: 2000px; border-top: 2px dotted black; border-left: none; border-right: none; border-bottom: none\"><div><br /></div></td></tr></tbody></table><div><br /></div></div><div><br /></div>"
	 			row = 12
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
