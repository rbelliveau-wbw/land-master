			Mass_Create_Lots_V2_Mass_ as "Mass Create Lots V2 - Mass Create Lots"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											createdCount = 0;
										// Get subdivision details once
										subRec = Subdivision[ID == input.Subdivision];
										for each  row in input.Lot_Block
										{
											// Skip blank/incomplete rows
											if(row.Block != null && row.Lot_Start_Number != null && row.Lot_End_Number != null)
											{
												// set variables for this subform row
												lotNamer = row.Lot_Start_Number;
												blockNum = row.Block.toString();
												lots = row.Lot_End_Number - row.Lot_Start_Number + 1;
												counter = leftpad("1",lots).replaceAll(" ","1,").toList();
												// if a buyer is selected on this row, then create lots as Contracted
												lotStatus = "Open";
												if(row.Buyer != null)
												{
													lotStatus = "Contracted";
												}
												// pad block once per row
												blockNumPadded = blockNum;
												if(blockNumPadded.length() < 2)
												{
													blockNumPadded = leftpad(blockNumPadded,2).replaceAll(" ","0");
												}
												// create lots loop for this row
												for each index i in counter
												{
													lotName2 = lotNamer.toString();
													if(lotName2.length() < 2)
													{
														lotName2 = leftpad(lotName2,2).replaceAll(" ","0");
													}
													insert into Lots
													[
														Lot_Number=lotNamer
														Subdivision_Code=subRec.Subdivision_Code
														Lot_Code=subRec.Subdivision_Code + "-B" + blockNumPadded + "-L" + lotName2
														Added_User=zoho.loginuser
														Subdivision=input.Subdivision
														Block=row.Block
														Phase=subRec.Phase
														Base_Price=row.Base_Price
														Escalator=row.Escalator
														Escalator_Start_Date=row.Escalator_Start_Date
														City=subRec.City
														County=subRec.County
														Additional_Fees=row.Additional_Fees
														Builder1=row.Buyer
														Status=lotStatus
														Fee_Type=row.Fee_Type
														Earnest_Money=row.Earnest_Money
														Lot_Size=row.Lot_Size
													]
													lotNamer = lotNamer + 1;
													createdCount = createdCount + 1;
												}
											}
										}
										// info createdCount + " Lots Created";
						)
					}
				}

			}
			Button_Actions_Lot_Search as "Button Actions - Lot Search"
			{
				type =  form
				form = Lot_Search

				record event = on add

				on user input of Buttons
				{
					actions 
					{
						custom deluge script
						(
											if(Buttons == "Create Lots")
										{
											openUrl("#Form:Mass_Create_Lots","popup window","height=800,width=1500");
											input.Buttons = null;
										}
						)
					}
				}

			}
