		}
		form Company
		{
			title 
    		{
				displayname = "Add Company"
    			on add = "Create Company"
   	 			on edit = "Edit Company"
			}
			success message = "Company Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Company_Name
			(
    			type = text
				displayname = "Company Name"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			EIN
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Account_Number
			(
				type = number
				displayname = "Account Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Facility_ID
			(
				type = number
				displayname = "Facility ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Proforma
			(
				type = list	
				values  = Add_Pro_Forma.ID
    			displayformat = [Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Property
			(
				type = grid
				values  = Property.ID
    			bidirectional = Company1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Contract
		{
			title 
    		{
				displayname = "Add Contract"
    			on add = "Create Contract"
   	 			on edit = "Edit Contract"
			}
			success message = "Contract Added Successfully"
			Contract_Info
			(
				type = section
				displayname = "Contract Info"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Contract_Type
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Lot (Master)","Lot (Amendment)","Issue","CCR","Master Services Agreement","Service Agreement","NSSA","DA","Amendment","ACQ (PSA)","ACQ (LOI)","Commercial Sale","Internal","Offsite","Amenity","MUD Bid"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subdivision1
			(
				type = list	
				displayname = "Subdivision"
				values  = Subdivision[Status != "Forecast Placeholder" && Status != "Sold Out"].ID
    			displayformat = [Subdivision_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Builder
			(
				type = picklist	
				displayname = "Builder/Counterparty"
				values  = Builder.ID
    			displayformat = [Builder_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Earnest_Money_Per_Lot
			(
				displayname = "Earnest Money Per Lot"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = small
			)
			Number_of_Lots
			(
				type = number
				displayname = "Lot Total"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Initial_Takedown
			(
				type = number
				displayname = "Initial Closing (Lots)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Initial_Takedown_Days
			(
				type = number
				displayname = "Initial Closing (Days)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Second_Closing_Lots
			(
				type = number
				displayname = "Second Closing (Lots)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Second_Closing_Days
			(
				type = number
				displayname = "Second Closing (Days)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subsequent_Takedown_Lots
			(
				type = number
				displayname = "Subsequent Closings (Lots)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			Subsequent_Takedown_Days
			(
				type = number
				displayname = "Subsequent Closings (Days)"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = small
			)
			must have unique Contract_Name
			(
    			type = text
				displayname = "Contract Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = 350px
			)
			must have Territory
			(
				type = picklist
				maxchar = 100
				values = {"Bryan/College Station","Corpus Christi","Dallas/Fort Worth","Fort Hood","Houston","North Austin","San Antonio","South Austin","Temple/Belton","Waco"}
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Owner
			(
				type = list	
				values  = User_Access.ID
    			displayformat = [User]
				advanced field search = true
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			WBW_Point_Person
			(
				type = list	
				displayname = "WBW Point Person"
				values = {"RO","Legal","RH","RB","AA","BR","DR","MW","MT","JS","PS","AD","TB","TM","BB","SH","DW","JH","JB","NP","EW","JL","TW","KC"}
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Lots1
			(
				type = list	
				displayname = "Lots"
				values  = Lots.ID
    			displayformat = [Lot_Code + " - " + Lot_Size + "Ft - " + Status]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = large
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Proposed","New","Approval Rejected","Feasibility","Awaiting WBW","Awaiting Counterparty","Awaiting Approvals","Hold","Approved","Complete","Rejected","Awaiting Purchasing","Awaiting Development","Awaiting Other","Cancelled"}
				initial value = "New"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Current_Approver
			(
    			type = text
				displayname = "Current Approver"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Current_Action
			(
    			type = textarea
				displayname = "Current Action"
				height = 100px
	 			row = 1
	 			column = 3   
				width = medium
			)
			Lot_Block_Description
			(
    			type = richtext
				displayname = "Lot/Block Description"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7},
					font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue", "EBGaramond", "RobotoCondensed", "ArchivoBlack", "Carlito", "Barlow", "Comfortaa", "Montserrat", "Nunito", "Poppins", "Quicksand", "Raleway", "Rubik", "SourceSansPro"}
				]
				private = true
	 			row = 1
	 			column = 3   
				width = medium
			)
			Archive
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 3   
				width = medium
			)
