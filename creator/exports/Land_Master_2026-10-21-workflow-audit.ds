										disable Error_Response;
										disable Import_Status;
										disable Major_Code;
										disable Minor_Code;
										disable Subdivision_Code;
										disable Updated_Date;
										disable Data_Source;
						)
					}
				}

			}
			Reload_Parent_Page_Budget as "Reload Parent Page - Budget"
			{
				type =  form
				form = Add_Budget

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											success message input.Budget_Name + " successfully saved.";
										if(Budget_Type == "Pro Forma")
										{
											profMonths = Proforma_Months[Proforma == input.Pro_Forma].Date1 sort by Date1;
											smallYear = profMonths.getYear();
											openUrl(zoho.appuri + "#Page:Proforma_Management" + "?proformaId=" + input.Pro_Forma + "&startYear=" + smallYear + "&startMonth=" + "1" + "&tabChoice=pnl","same window");
										}
						)
					}
				}

			}
			Populate_Construction_Cur as "Populate Construction Curve - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Construction_Length
				{
					actions 
					{
						custom deluge script
						(
											input.Construction_Curve.clear();
										for each  constCurve in Construction_Curve[Template_Item == TRUE && Cost_Curve == input.Construction_Length]
										{
											row = Add_Pro_Forma.Construction_Curve();
											row.Month_Number=constCurve.Month_Number;
											row.Percent_Cost=constCurve.Percent_Cost;
											row.Pro_Forma=input.ID;
											input.Construction_Curve.insert(row);
										}
						)
					}
				}

			}
			Update_Add_l_Cost_Categor as "Update Add'l Cost Category Total - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  category in Budget_Category[Budget == input.Budget]
										{
											addlTotal = Budget_Item[Budget_Category == category].sum(Add_l_Cost);
											category.Add_l_Cost_Total=if(addlTotal != null,addlTotal,null);
										}
						)
					}
				}

			}
			Subform_Field_Validation_ as "Subform Field Validation - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Budget_Type == "Pro Forma")
										{
											for each  itemRow in input.Budget_Items
											{
												//if(itemRow.Add_l_Cost != null && itemRow.Start_Phase == null || itemRow.End_Phase == null)
												//{
												//	alert "Please enter start and end phase.";
												//	cancel submit;
												//}
												if(itemRow.Add_l_Cost == null && itemRow.Start_Phase != null || itemRow.End_Phase != null)
												{
													alert "Please enter all item costs where phases are designated.";
													cancel submit;
												}
												// Validate Add'l Cost line: must have EITHER complete phase range OR complete month range
												if(itemRow.Add_l_Cost != null && itemRow.Add_l_Cost != 0 && itemRow.Item_Name.contains("Impact Fees") == false)
												{
													// Adjust field names if yours differ
													hasPhaseStart = itemRow.Start_Phase != null;
													hasPhaseEnd = itemRow.End_Phase != null;
													hasMonthStart = itemRow.Start_Month != null;
													hasMonthEnd = itemRow.End_Month != null;
													phaseComplete = hasPhaseStart == true && hasPhaseEnd == true;
													monthComplete = hasMonthStart == true && hasMonthEnd == true;
													phasePartial = hasPhaseStart == true || hasPhaseEnd == true && phaseComplete == false;
													monthPartial = hasMonthStart == true || hasMonthEnd == true && monthComplete == false;
													// 1) No incomplete ranges
													if(phasePartial)
													{
														alert "Please enter Start and End Phase for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													if(monthPartial)
													{
														alert "Please enter Start and End Month for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													// 2) Not both, not neither
													if(phaseComplete && monthComplete)
													{
														alert "Please provide either phase range or month range for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													if(!phaseComplete && !monthComplete)
													{
														alert "Please provide a complete Phase range or a complete Month range to apply additional cost for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
												}
											}
										}
						)
					}
				}

			}
