				(
					width = 110px
				)
				County
				(
					width = 90px
				)
				Additional_Fees as "Addl Fees"
				(
					width = 110px
				)
				Block
				(
					width = 75px
				)
				WBW_Tax as "WBW Tax"
				(
					width = 95px
				)
				Builder_Tax as "Builder Tax"
				(
					width = 1121px
				)
				Total_Tax as "Total Tax"
				(
					width = 120px
				)
				Appraised_Value as "Appraised Value"
				(
					width = 125px
				)
				Fee_Type as "Type"
				(
					width = 90px
				)
