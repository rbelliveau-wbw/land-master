			Only_One_Settings_Record_ as "Only One Settings Record - Settings"
			{
				type =  form
				form = Settings

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Settings is a singleton. Two things break if a second record exists:
										//  1. Six DAILY schedules are anchored on this form (start = Next_Workflow_Run).
										//     Creator fires a form-anchored schedule once PER RECORD, so a second row
										//     runs all six twice a day - duplicate lot writes, forecast recalcs, emails.
										//  2. Settings[ID != 0] is read as a SINGLE record in 24 places across the app;
										//     with two rows that read silently picks one.
										//
										// This workflow MUST stay on record event = Created. On "Created or Edited" the
										// record already exists, the count would be 1, every Settings save would be
										// cancelled, and the form would be permanently unusable. The input.ID branch
										// below makes that mistake non-fatal: on an add input.ID is null, so it
										// degrades to the plain count.
										existingCount = Settings[ID != 0].count();
										if(input.ID != null)
										{
											existingCount = Settings[ID != input.ID].count();
										}
										if(existingCount > 0)
										{
											alert "Only one Settings record is allowed. A Settings record already exists - open Settings from the menu and edit that record instead of adding a new one.";
											cancel submit;
										}
						)
					}
				}

			}
			Create_External_Codes_Sub as "Create External Codes - Subdivision"
			{
				type =  form
				form = Subdivision

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											subCode = ifnull(input.Subdivision_Code,"");
										if(subCode != "")
										{
											// Great Plains: Y_, C_, D_, bare
											for each  prefix in {"Y_","C_","D_",""}
											{
												insert into External_System_Mapping
												[
													Subdivision1=input.ID
													External_System="Great Plains"
													External_Code=prefix + subCode
													Added_User=zoho.loginuser
												]
											}
											// HeavyJob: C_ only
											insert into External_System_Mapping
											[
												Subdivision1=input.ID
												External_System="HeavyJob"
												External_Code="C_" + subCode
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
			Validate_Comment_Log as "Validate Comment Log"
			{
				type =  form
				form = Comment_Log

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Comment_Log: Created or Edited -> Validations on form submission.
										// Runs for the widget's SDK addRecord/updateRecord writes, without skip_workflow.
										commentText = ifnull(input.Comment,"").trim();
										if(commentText == "" || commentText.length() > 60000)
										{
											alert "Enter a comment between 1 and 60000 characters.";
											cancel submit;
										}
										if(input.Project == null && input.Budget == null && input.Pro_Forma == null && input.Contract1 == null)
										{
											alert "Link the comment to a Project, Budget, Pro Forma, or Contract.";
											cancel submit;
										}
										existingComment = Comment_Log[ID == input.ID];
										// Construction submitters can discuss requests without gaining request editing.
										commentContractId = input.Contract1;
										if(existingComment.count() > 0)
										{
											commentContractId = existingComment.Contract1;
										}
										constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
										if(constructionBudgetingProfile)
										{
											scopedCommentParent = Contract[ID == commentContractId];
											if(commentContractId == null || scopedCommentParent.count() == 0 || ifnull(scopedCommentParent.Work_Module,"") != "Construction")
											{
												alert "This profile can only comment on Construction requests.";
												cancel submit;
											}
										}
										if(commentContractId != null)
										{
											commentContract = Contract[ID == commentContractId];
											if(commentContract.count() > 0 && ifnull(commentContract.Work_Module,"") == "Construction")
											{
												constructionAllowed = thisapp.hasConstructionPermission(zoho.loginuser,false);
												if(constructionAllowed != true)
												{
													alert "Construction request access is required to add or change comments.";
													cancel submit;
												}
											}
										}
										if(existingComment.count() > 0)
										{
											if(existingComment.Added_User != zoho.loginuser)
											{
												alert "Only the author can edit or delete this comment.";
												cancel submit;
											}
											if(existingComment.Added_Time.addHour(24) <= zoho.currenttime)
											{
												alert "Comments can only be edited or deleted within 24 hours of posting.";
												cancel submit;
											}
											if(existingComment.Deleted == true)
											{
												alert "A deleted comment cannot be changed.";
												cancel submit;
											}
											input.Project = existingComment.Project;
											input.Budget = existingComment.Budget;
											input.Pro_Forma = existingComment.Pro_Forma;
											input.Contract1 = existingComment.Contract1;
											input.User = existingComment.User;
											input.Author_Name = existingComment.Author_Name;
											input.Edited = existingComment.Edited;
											if(input.Deleted == true)
											{
												input.Comment = "Deleted by user";
											}
											else
											{
												input.Deleted = false;
												input.Comment = commentText;
												if(commentText != ifnull(existingComment.Comment,""))
												{
													input.Edited = true;
												}
											}
										}
										else
										{
											input.Comment = commentText;
											input.User = zoho.loginuser;
											input.Edited = false;
											input.Deleted = false;
											input.Author_Name = zoho.loginuser;
											authorAccess = User_Access[User == zoho.loginuser];
											if(authorAccess.count() > 0)
											{
												fullName = ifnull(authorAccess.Full_Name,"").trim();
												if(fullName != "")
												{
													input.Author_Name = fullName;
												}
											}
										}
						)
					}
				}

			}
			Validate_Takedown_Cadence as "Validate Takedown Cadence"
			{
				type =  form
				form = Takedown_Schedule

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// PROPOSED new native Takedown_Schedule on-validate action for create/edit.
										// Existing records with both Second Closing fields blank may retain their legacy
										// cadence only when every cadence, total, and anchor value remains unchanged.
										legacyUnchanged = false;
										if(input.ID != null && input.Second_Closing_Lots == null && input.Second_Closing_Days == null)
										{
											existingSchedule = Takedown_Schedule[ID == input.ID];
											if(existingSchedule.count() > 0 && existingSchedule.Second_Closing_Lots == null && existingSchedule.Second_Closing_Days == null)
											{
												legacyUnchanged = existingSchedule.Total_Lot_Obligation == input.Total_Lot_Obligation && existingSchedule.Initial_Takedown == input.Initial_Takedown && existingSchedule.Initial_Delay_Days == input.Initial_Delay_Days && existingSchedule.Continued_Takedown == input.Continued_Takedown && existingSchedule.Continued_Takedown_Delay_Days == input.Continued_Takedown_Delay_Days && existingSchedule.Initial_Closing_Date == input.Initial_Closing_Date && existingSchedule.Takedown_Start_Date == input.Takedown_Start_Date;
											}
										}
										if(!legacyUnchanged)
										{
											cadenceTerms = Map();
											cadenceTerms.put("Total_Lot_Obligation",input.Total_Lot_Obligation);
											cadenceTerms.put("Initial_Takedown",input.Initial_Takedown);
											cadenceTerms.put("Initial_Due_Offset_Days",input.Initial_Delay_Days);
											cadenceTerms.put("Second_Closing_Lots",input.Second_Closing_Lots);
											cadenceTerms.put("Second_Closing_Days",input.Second_Closing_Days);
											cadenceTerms.put("Continued_Takedown",input.Continued_Takedown);
											cadenceTerms.put("Continued_Takedown_Delay_Days",input.Continued_Takedown_Delay_Days);
											cadenceTerms.put("Elapsed_Days",0);
											cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
											if(cadence.get("ok") != true)
											{
												alert cadence.get("message");
												cancel submit;
											}
										}
						)
					}
				}

			}
			Recalculate_Takedown_Cade as "Recalculate Takedown Cadence On Save"
			{
				type =  form
				form = Takedown_Schedule

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// PROPOSED new native Takedown_Schedule on-success action for create/edit.
										// Recalculate populated Second Closing schedules from their own saved terms.
										// Contract edits never invoke this action or synchronize an existing schedule.
										// Legacy schedules with neither Second Closing field set receive no writes.
										savedSchedule = Takedown_Schedule[ID == input.ID];
										if(savedSchedule.count() > 0)
										{
											if(savedSchedule.Second_Closing_Lots != null || savedSchedule.Second_Closing_Days != null)
											{
												cadenceStart = ifnull(savedSchedule.Initial_Closing_Date,savedSchedule.Takedown_Start_Date);
												cadenceTerms = Map();
												cadenceTerms.put("Total_Lot_Obligation",savedSchedule.Total_Lot_Obligation);
												cadenceTerms.put("Initial_Takedown",savedSchedule.Initial_Takedown);
												cadenceTerms.put("Initial_Due_Offset_Days",savedSchedule.Initial_Delay_Days);
												cadenceTerms.put("Second_Closing_Lots",savedSchedule.Second_Closing_Lots);
												cadenceTerms.put("Second_Closing_Days",savedSchedule.Second_Closing_Days);
												cadenceTerms.put("Continued_Takedown",savedSchedule.Continued_Takedown);
												cadenceTerms.put("Continued_Takedown_Delay_Days",savedSchedule.Continued_Takedown_Delay_Days);
												cadenceTerms.put("Elapsed_Days",0);
												if(cadenceStart != null)
												{
													cadenceTerms.put("Elapsed_Days",daysBetween(cadenceStart,today));
												}
												cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
												if(cadence.get("ok") == true)
												{
													if(cadenceStart != null)
													{
														savedSchedule.Takedown_Start_Date=cadenceStart;
														savedSchedule.Takedown_End_Date=cadenceStart.addDay(cadence.get("endOffsetDays"));
														if(savedSchedule.Status != "Completed")
														{
															savedSchedule.Lots_Expected=cadence.get("lotsExpected");
														}
													}
													else
													{
														savedSchedule.Takedown_End_Date=null;
														if(savedSchedule.Status != "Completed")
														{
															savedSchedule.Lots_Expected=0;
														}
													}
													if(savedSchedule.Status == "Active" || savedSchedule.Status == "Behind")
													{
														lotsSold = ifnull(savedSchedule.Lots_Sold,0);
														if(lotsSold < ifnull(savedSchedule.Lots_Expected,0))
														{
															savedSchedule.Status="Behind";
														}
														if(lotsSold >= savedSchedule.Total_Lot_Obligation)
														{
															savedSchedule.Status="Completed";
															savedSchedule.Completion_Percent=100;
														}
														if(lotsSold < savedSchedule.Total_Lot_Obligation)
														{
															savedSchedule.Completion_Percent=lotsSold / savedSchedule.Total_Lot_Obligation * 100;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			Validate_Payment_Request_ as "Validate Payment Request Type"
			{
				type =  form
				form = Payment_Request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Install before removing static Required from Budget_Item and Accounting_Project_Code.
										// This is interactive form validation; managed Deluge inserts must enforce the same contract.
										if(input.Request_Type == "Check" || input.Request_Type == "Wire")
										{
											if(input.Budget_Item == null || input.Accounting_Project_Code == null)
											{
												alert "Budget Item and Accounting Project Code are required for Check and Wire.";
												cancel submit;
											}
										}
										else if(input.Request_Type == "Purchase Order")
										{
											alert "Create and edit Purchase Orders in Budget Manager.";
											cancel submit;
										}
						)
					}
				}

			}
