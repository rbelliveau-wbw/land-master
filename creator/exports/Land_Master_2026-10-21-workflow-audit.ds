					actions 
					{
						custom deluge script
						(
											// ======================================================
										// SINGLE MAIN LOOP (FIXED + OVERHEAD OUTPUTS)
										//
										// OPTIMIZED WITHOUT CHANGING EXISTING CALCULATION BEHAVIOR
										//
										// BEHAVIOR PRESERVED:
										//
										// - Interest calculation remains MONTH-LEVEL.
										// - Interest applies ONLY when the CURRENT MONTH'S
										//   Running_Cash_Flow BASE is negative.
										//
										// - Running Cash Flow BASE:
										//       prior month's MASTER Running_Cash_Flow
										//       + current month's BASE Cash Flow
										//
										// - Running Cash Flow WITH INTEREST:
										//       prior month's MASTER Running_Cash_Flow_with_Interest
										//       + current month's Cash_Flow_with_Interest
										//
										// - "Previous month" remains specifically:
										//       current Month1 - 1
										//
										//   It is NOT simply the previously encountered month.
										//   Missing months therefore continue to behave as 0.
										//
										// - Cash_Flow_with_Overhead remains:
										//       BASE Cash Flow - all monthly overhead
										//
										// - Overhead is NOT included in the interest calculation.
										//
										// - Profit Share remains:
										//       current month's Cash_Flow_with_Interest
										//       * Profit_Share rate
										//
										// - MASTER row receives all month-level totals.
										//
										// - NON-MASTER rows ALWAYS end with 0 for:
										//       Cash_Flow
										//       Cash_Flow_with_Overhead
										//       Cash_Flow_with_Interest
										//       Running_Cash_Flow
										//       Running_Cash_Flow_with_Interest
										//       Interest
										//       Profit_Share
										//       Engineering_Overhead
										//       Construction_Overhead
										//       Overhead_Cost
										//
										// - Multiple MASTER rows, if they accidentally exist, preserve
										//   the original next-month .sum() behavior.
										//
										// - Month1 == 0 / null preserves the existing sentinel behavior.
										//
										// OPTIMIZATION:
										//
										// OLD:
										//     Loop every record
										//         when month changes:
										//             query previous month's Running_Cash_Flow
										//             query previous month's Running_Cash_Flow_with_Interest
										//             query every row for current month
										//             loop those rows again
										//
										// NEW:
										//     PASS 1:
										//         Aggregate each month from the already-loaded records.
										//
										//     PASS 2:
										//         Calculate month-level running values sequentially
										//         using Maps instead of Creator queries.
										//
										//     PASS 3:
										//         Write final values to each already-loaded record.
										//
										// NO Creator query occurs inside any loop.
										// ======================================================
										// ======================================================
										// LOAD ALL PROFORMA MONTH RECORDS ONCE
										//
										// Preserve existing sort order exactly.
										// ======================================================
										monthRecs = Proforma_Months[Proforma == input.ID] sort by Month1;
										// ======================================================
										// RATES
										//
										// Preserve existing decimal conversion exactly.
										// ======================================================
										rate = ifnull(input.Interest,0).toDecimal() / 100;
										profitRate = ifnull(input.Profit_Share,0).toDecimal() / 100;
										// ======================================================
										// MONTH AGGREGATION MAPS
										// ======================================================
										//
										// monthOrder
										//     Unique non-zero Month1 values in the same order that
										//     monthRecs presents them.
										//
										// monthCashByMonth
										//     BASE Cash Flow total across ALL records in the month.
										//
										// monthEngOvrhdByMonth
										//     Engineering Overhead total BEFORE master/non-master
										//     normalization.
										//
										// monthConstOvrhdByMonth
										//     Construction Overhead total.
										//
										// monthAdminOvrhdByMonth
										//     Administrative / Sales Overhead total.
										//
										// masterCountByMonth
										//     Count of Master_Month rows.
										//
										//     This is important because the ORIGINAL code queried:
										//
										//         .sum(Running_Cash_Flow)
										//
										//     from the prior month's master rows.
										//
										//     If duplicate master rows exist, that sum would contain
										//     the running amount multiple times.
										//
										//     We preserve that behavior exactly.
										// ======================================================
										monthOrder = List();
										monthSeen = Map();
										monthCashByMonth = Map();
										monthEngOvrhdByMonth = Map();
										monthConstOvrhdByMonth = Map();
										monthAdminOvrhdByMonth = Map();
										masterCountByMonth = Map();
										// ======================================================
										// PASS 1
										//
										// AGGREGATE RAW MONTH VALUES.
										//
										// IMPORTANT:
										//
										// Do NOT zero non-master overhead fields yet.
										//
										// The existing implementation first reads each row's overhead
										// into the monthly totals and only THEN zeros the non-master
										// record.
										//
										// Therefore we aggregate everything first and normalize the
										// records later.
										// ======================================================
										for each  mnth in monthRecs
										{
											// --------------------------------------------------
											// Preserve existing Month1 numeric conversion.
											// --------------------------------------------------
											mnthNo = ifnull(mnth.Month1,0).toLong();
											// --------------------------------------------------
											// Month 0 is the existing "not started" sentinel.
											//
											// In the original algorithm a Month1 of 0/null is
											// never finalized as a normal month group.
											//
											// We therefore intentionally exclude it from the
											// month-level calculation maps.
											// --------------------------------------------------
											if(mnthNo != 0)
											{
												monthKey = mnthNo.toString();
												// ----------------------------------------------
												// Preserve month processing order.
												// ----------------------------------------------
												seenValue = monthSeen.get(monthKey);
												if(seenValue == null)
												{
													monthSeen.put(monthKey,true);
													monthOrder.add(monthKey);
												}
												// ==============================================
												// EXACT EXISTING BASE CASH FLOW FORMULA
												// ==============================================
												cashFlowRec = ifnull(mnth.Finished_Lot_Sales,0) - ifnull(mnth.Land_Cost,0) + ifnull(mnth.Land_Sale,0) - ifnull(mnth.Construction_Cost_Base,0) - ifnull(mnth.Construction_Cost_Addl,0) - ifnull(mnth.Entitlement_Engineering,0) - ifnull(mnth.Entitlement_Engineering_Addl,0) + ifnull(mnth.Reimbursements,0) + ifnull(mnth.Reimbursed_Fees,0) + ifnull(mnth.PID_MUD_Revenue,0);
												// ==============================================
												// BASE CASH FLOW MONTH TOTAL
												// ==============================================
												existingCash = ifnull(monthCashByMonth.get(monthKey),0);
												monthCashByMonth.put(monthKey,existingCash + cashFlowRec);
												// ==============================================
												// ENGINEERING OVERHEAD MONTH TOTAL
												// ==============================================
												recEngOvrhd = ifnull(mnth.Engineering_Overhead,0);
												existingEngOvrhd = ifnull(monthEngOvrhdByMonth.get(monthKey),0);
												monthEngOvrhdByMonth.put(monthKey,existingEngOvrhd + recEngOvrhd);
												// ==============================================
												// CONSTRUCTION OVERHEAD MONTH TOTAL
												// ==============================================
												recConstOvrhd = ifnull(mnth.Construction_Overhead,0);
												existingConstOvrhd = ifnull(monthConstOvrhdByMonth.get(monthKey),0);
												monthConstOvrhdByMonth.put(monthKey,existingConstOvrhd + recConstOvrhd);
												// ==============================================
												// ADMIN / SALES OVERHEAD MONTH TOTAL
												// ==============================================
												recAdminOvrhd = ifnull(mnth.Overhead_Cost,0);
												existingAdminOvrhd = ifnull(monthAdminOvrhdByMonth.get(monthKey),0);
												monthAdminOvrhdByMonth.put(monthKey,existingAdminOvrhd + recAdminOvrhd);
												// ==============================================
												// MASTER ROW COUNT
												//
												// Used later to reproduce the exact semantics of:
												//
												// Proforma_Months[
												//     ...
												//     && Master_Month == true
												// ].sum(Running_Cash_Flow)
												//
												// including duplicate-master behavior.
												// ==============================================
												if(ifnull(mnth.Master_Month,false) == true)
												{
													masterCount = ifnull(masterCountByMonth.get(monthKey),0);
													masterCountByMonth.put(monthKey,masterCount + 1);
												}
											}
										}
										// ======================================================
										// OUTPUT MAPS
										//
										// These hold the final month-level results that will later
										// be written to the Master_Month records.
										// ======================================================
										cashFlowOut = Map();
										cashFlowWithOvrhdOut = Map();
										engOvrhdOut = Map();
										constOvrhdOut = Map();
										adminOvrhdOut = Map();
										interestOut = Map();
										cashFlowWithIntOut = Map();
										profitShareOut = Map();
										runningBaseOut = Map();
										runningWithIntOut = Map();
										// ======================================================
										// SPECIAL MAPS USED TO REPRODUCE THE OLD PRIOR-MONTH
										// DATABASE .sum() QUERIES.
										//
										// The old code did:
										//
										//     previousMasterRows.sum(Running_Cash_Flow)
										//
										// If one master existed:
										//
										//     previous sum = running CF
										//
										// If TWO masters accidentally existed:
										//
										//     previous sum = running CF * 2
										//
										// If no master existed:
										//
										//     previous sum = 0
										//
										// These maps intentionally retain that behavior.
										// ======================================================
										runningBaseSumByMonth = Map();
										runningWithIntSumByMonth = Map();
										// ======================================================
										// PASS 2
										//
										// CALCULATE MONTH-LEVEL RUNNING CASH FLOW, INTEREST,
										// OVERHEAD, AND PROFIT SHARE.
										//
										// No database queries required.
										// ======================================================
										for each  monthKey in monthOrder
										{
											currentMonthNo = monthKey.toLong();
											// --------------------------------------------------
											// GET MONTH TOTALS
											// --------------------------------------------------
											monthCashSum_Base = ifnull(monthCashByMonth.get(monthKey),0);
											monthEngOvrhd = ifnull(monthEngOvrhdByMonth.get(monthKey),0);
											monthConstOvrhd = ifnull(monthConstOvrhdByMonth.get(monthKey),0);
											monthAdminOvrhd = ifnull(monthAdminOvrhdByMonth.get(monthKey),0);
											// --------------------------------------------------
											// EXACT EXISTING OVERHEAD TOTAL
											// --------------------------------------------------
											monthOvrhdTotal = monthEngOvrhd + monthConstOvrhd + monthAdminOvrhd;
											// ==================================================
											// PREVIOUS MONTH RUNNING VALUES
											//
											// Preserve:
											//
											//     currentMonthNo - 1
											//
											// rather than simply using the previous item in
											// monthOrder.
											//
											// Therefore if Month 10 exists but Month 9 does not,
											// previous running CF remains 0 just as the original
											// Creator query would return null -> 0.
											// ==================================================
											prevRunning_Base = 0;
											prevRunning_WithInt = 0;
											if(currentMonthNo != 1)
											{
												prevMonthNo = currentMonthNo - 1;
												prevMonthKey = prevMonthNo.toString();
												prevRunning_Base = ifnull(runningBaseSumByMonth.get(prevMonthKey),0);
												prevRunning_WithInt = ifnull(runningWithIntSumByMonth.get(prevMonthKey),0);
											}
											// ==================================================
											// RUNNING CASH FLOW — BASE
											//
											// EXACT EXISTING LOGIC
											// ==================================================
											runningCF_Base = monthCashSum_Base;
											if(currentMonthNo != 1)
											{
												runningCF_Base = prevRunning_Base + monthCashSum_Base;
											}
											// ==================================================
											// MONTH-LEVEL INTEREST
											//
											// EXACT EXISTING LOGIC:
											//
											// Interest applies only when CURRENT MONTH'S
											// running BASE cash flow is negative.
											//
											// Overhead is NOT part of this calculation.
											// ==================================================
											interestForMonth = 0;
											monthCash_WithInt = monthCashSum_Base;
											if(runningCF_Base < 0)
											{
												interestForMonth = abs(runningCF_Base * rate / 12);
												monthCash_WithInt = monthCashSum_Base - interestForMonth;
											}
											// ==================================================
											// RUNNING CASH FLOW — WITH INTEREST
											//
											// EXACT EXISTING LOGIC
											// ==================================================
											runningCF_WithInt = monthCash_WithInt;
											if(currentMonthNo != 1)
											{
												runningCF_WithInt = prevRunning_WithInt + monthCash_WithInt;
											}
											// ==================================================
											// MONTH CASH FLOW WITH OVERHEAD
											//
											// EXACT EXISTING LOGIC:
											//
											// This does NOT influence Running Cash Flow or
											// interest.
											// ==================================================
											monthCash_WithOvrhd = monthCashSum_Base - monthOvrhdTotal;
											// ==================================================
											// STORE FINAL MONTH OUTPUTS
											// ==================================================
											cashFlowOut.put(monthKey,monthCashSum_Base);
											cashFlowWithOvrhdOut.put(monthKey,monthCash_WithOvrhd);
											engOvrhdOut.put(monthKey,monthEngOvrhd);
											constOvrhdOut.put(monthKey,monthConstOvrhd);
											adminOvrhdOut.put(monthKey,monthAdminOvrhd);
											interestOut.put(monthKey,interestForMonth);
											cashFlowWithIntOut.put(monthKey,monthCash_WithInt);
											profitShareOut.put(monthKey,monthCash_WithInt * profitRate);
											runningBaseOut.put(monthKey,runningCF_Base);
											runningWithIntOut.put(monthKey,runningCF_WithInt);
											// ==================================================
											// REPRODUCE WHAT NEXT MONTH'S ORIGINAL .sum()
											// QUERY WOULD HAVE RETURNED.
											//
											// If one master exists:
											//     sum = runningCF
											//
											// If multiple masters exist:
											//     sum = runningCF * count
											//
											// If no master exists:
											//     sum = 0
											// ==================================================
											masterCount = ifnull(masterCountByMonth.get(monthKey),0);
											runningBaseSumByMonth.put(monthKey,runningCF_Base * masterCount);
											runningWithIntSumByMonth.put(monthKey,runningCF_WithInt * masterCount);
										}
										// ======================================================
										// PASS 3
										//
										// WRITE FINAL VALUES.
										//
										// Every record is touched only once.
										//
										// MASTER:
										//     receive month-level values.
										//
										// NON-MASTER:
										//     receive zeros exactly as before.
										// ======================================================
										for each  mnth in monthRecs
										{
											mnthNo = ifnull(mnth.Month1,0).toLong();
											isMaster = ifnull(mnth.Master_Month,false);
											// ==================================================
											// MASTER ROW
											// ==================================================
											if(isMaster == true)
											{
												// ----------------------------------------------
												// Preserve existing sentinel behavior.
												//
												// Month 0/null was never finalized by the old
												// currentMonthNo logic, so do not introduce new
												// writes to a Month 0 master row.
												// ----------------------------------------------
												if(mnthNo != 0)
												{
													monthKey = mnthNo.toString();
													// ------------------------------------------
													// MONTH TOTALS
													// ------------------------------------------
													mnth.Cash_Flow=ifnull(cashFlowOut.get(monthKey),0);
													mnth.Cash_Flow_with_Overhead=ifnull(cashFlowWithOvrhdOut.get(monthKey),0);
													// ------------------------------------------
													// OVERHEAD COLUMNS
													//
													// MASTER = SUM OF WHOLE MONTH
													// ------------------------------------------
													mnth.Engineering_Overhead=ifnull(engOvrhdOut.get(monthKey),0);
													mnth.Construction_Overhead=ifnull(constOvrhdOut.get(monthKey),0);
													mnth.Overhead_Cost=ifnull(adminOvrhdOut.get(monthKey),0);
													// ------------------------------------------
													// INTEREST
													// ------------------------------------------
													mnth.Interest=ifnull(interestOut.get(monthKey),0);
													// ------------------------------------------
													// CASH FLOW WITH INTEREST
													// ------------------------------------------
													mnth.Cash_Flow_with_Interest=ifnull(cashFlowWithIntOut.get(monthKey),0);
													// ------------------------------------------
													// PROFIT SHARE
													// ------------------------------------------
													mnth.Profit_Share=ifnull(profitShareOut.get(monthKey),0);
													// ------------------------------------------
													// RUNNING CASH FLOW — BASE
													// ------------------------------------------
													mnth.Running_Cash_Flow=ifnull(runningBaseOut.get(monthKey),0);
													// ------------------------------------------
													// RUNNING CASH FLOW — WITH INTEREST
													// ------------------------------------------
													mnth.Running_Cash_Flow_with_Interest=ifnull(runningWithIntOut.get(monthKey),0);
												}
											}
											// ==================================================
											// NON-MASTER ROW
											//
											// Preserve exact final zero state.
											// ==================================================
											else
											{
												mnth.Cash_Flow=0;
												mnth.Cash_Flow_with_Overhead=0;
												mnth.Cash_Flow_with_Interest=0;
												mnth.Running_Cash_Flow=0;
												mnth.Running_Cash_Flow_with_Interest=0;
												mnth.Engineering_Overhead=0;
												mnth.Construction_Overhead=0;
												mnth.Overhead_Cost=0;
												mnth.Interest=0;
												mnth.Profit_Share=0;
											}
										}
										info "Month-level cash flow + month-level overhead + month-level interest (master only) + running totals written. Non-master outputs forced to 0.";
						)
						custom deluge script
						(
											//FILL OUT RUNNING CASH FLOW + INTEREST + PROFIT SHARE
						)
					}
					actions 
					{
						custom deluge script
						(
											//TOTALS
										constCost = Proforma_Months[Proforma == input.ID].sum(Construction_Cost_Base);
										constCostaddl = Proforma_Months[Proforma == input.ID].sum(Construction_Cost_Addl);
										engCost = Proforma_Months[Proforma == input.ID].sum(Entitlement_Engineering);
										engCostaddl = Proforma_Months[Proforma == input.ID].sum(Entitlement_Engineering_Addl);
										reimbursements = Proforma_Months[Proforma == input.ID].sum(Reimbursements);
										cashFlow = Proforma_Months[Proforma == input.ID].sum(Cash_Flow);
										reimbFees = Proforma_Months[Proforma == input.ID].sum(Reimbursed_Fees);
										mudpidRev = Proforma_Months[Proforma == input.ID].sum(PID_MUD_Revenue);
										ovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Overhead_Cost);
										engovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Engineering_Overhead);
										constovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Construction_Overhead);
										interestTotal = Proforma_Months[Proforma == input.ID].sum(Interest);
										profitshareTotal = Proforma_Months[Proforma == input.ID].sum(Profit_Share);
										// WRITE TO FIELDS
										if(ifnull(input.Lot_Sales_Schedule_Version,0).toLong() == 2)
										{
											input.Gross_Sales = ifnull(Proforma_Months[Proforma == input.ID].sum(Finished_Lot_Sales),0);
										}
										else
										{
											input.Gross_Sales = input.Sale_Price_FF * input.Lots * input.Lot_Size_Ft;
										}
										input.Construction_Cost_Base = input.Const_Cost_FF * input.Total_Street_LF;
										input.Construction_Cost_Addl = constCostaddl;
										input.Entitlement_Cost = input.Engineering_Cost_Lot * input.Lots;
										input.Entitlement_Engineering_Addl = engCostaddl;
										input.Total_Expenses = ifnull(input.Construction_Cost_Base,0) + ifnull(input.Construction_Cost_Addl,0) + ifnull(input.Entitlement_Cost,0) + ifnull(input.Entitlement_Engineering_Addl,0) + ifnull(input.Land_Cost,0);
										input.Reimbursements = reimbursements;
										input.Reimbursed_Fees = reimbFees;
										input.MUD_Revenue = mudpidRev;
										//input.Net_Profit = cashFlow;
										input.Total_Income = ifNull(input.Gross_Sales,0) + ifNull(input.MUD_Revenue,0) + ifNull(input.Reimbursements,0) + ifNull(input.Reimbursed_Fees,0) + ifNull(input.Land_Sale,0);
										input.Net_Profit = input.Total_Income - input.Total_Expenses;
										input.Overhead_Total = ovrhdTotal;
										input.Engineering_Overhead_Total = engovrhdTotal;
										input.Construction_Overhead_Total = constovrhdTotal;
										input.Interest_Total = interestTotal;
										input.Profit_Share_Total = profitshareTotal;
						)
					}
				}

			}
