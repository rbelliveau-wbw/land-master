			Lockdown_Forecast_Month_F as "Lockdown Forecast Month Fields - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Overforecast_Warning = FALSE;
										for each  forecast in input.Forecast_Months
										{
											forecast.Edit=FALSE;
											hide Forecast_Months.Subdivision1;
											hide Forecast_Months.Builder1;
											hide Forecast_Months.Forecast_Start_Date;
											disable Forecast_Months.Scheduled_Lots;
											//hide Forecast_Months.Edit;
											disable Forecast_Months.Forecast_Month;
											disable Forecast_Months.Forecast_Year;
											disable Forecast_Months.Actual_Lots;
											disable Forecast_Months.Forecasted_Lots;
										}
										for each  fc in input.Previous_Year
										{
											fc.Edit=FALSE;
											hide Previous_Year.Subdivision1;
											hide Previous_Year.Builder1;
											hide Previous_Year.Forecast_Start_Date;
											disable Previous_Year.Scheduled_Lots;
											//hide Forecast_Months.Edit;
											disable Previous_Year.Forecast_Month;
											disable Previous_Year.Forecast_Year;
											disable Previous_Year.Actual_Lots;
											disable Previous_Year.Forecasted_Lots;
										}
										settings = Settings[ID != 0].Unlock_All_Forecasts.getAll();
										if(settings == TRUE)
										{
											enable Forecast_Months.Forecasted_Lots;
										}
						)
					}
				}

			}
