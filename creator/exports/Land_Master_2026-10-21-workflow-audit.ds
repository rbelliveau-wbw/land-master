                 			{
                 				instDate = r.get("Date1").toString().toDate("MM/dd/yyyy");
                 			}
                 			insert into Land_Installments
                 			[
                 				Installment=if(ifnull(r.get("Installment"),"") == "","0",r.get("Installment").toString()).toLong()
                 				Month1=if(ifnull(r.get("Month1"),"") == "","0",r.get("Month1").toString()).toLong()
                 				Percent1=if(ifnull(r.get("Percent1"),"") == "","0",r.get("Percent1").toString()).toDecimal()
                 				Cost=if(ifnull(r.get("Cost"),"") == "","0",r.get("Cost").toString()).toDecimal()
                 				Type1="Purchase"
                 				Date1=instDate
                 				Pro_Forma=pfKey
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 		for each  r in ifnull(data.get("saleInstallments"),List())
