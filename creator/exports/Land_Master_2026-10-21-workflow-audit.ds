		page Data_Insights
		{
			displayname = "Data Insights"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Forecast_Manager1
		{
			displayname = "Forecast Manager"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Construction(string constructionReportScope, string contractId, string loiReviewId, string tokenId, string workMode)
		{
			displayname = "Construction"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				input.workMode = "construction";
				input.constructionReportScope = "construction";
			}
		}
	}

