			Populate_Additional_Costs as "Populate Additional Costs - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											engconstItems = Proforma_Item[Template_Item == TRUE && Department == "Construction"] sort by Cost_Code;
										for each  item in engconstItems
										{
											row = Add_Pro_Forma.Additional_Costs_Construction();
											row.Item_Name=item.Item_Name;
											row.Department=item.Department;
											row.Category=item.Category;
											row.Dept_Code=item.Dept_Code;
											row.Cost_Code=item.Cost_Code;
											row.Template_Item=false;
											//row.Budget_Code="PF" + input.PF_Number.toString() + "-" + item.Cost_Code;
											row.Department=item.Department;
											input.Additional_Costs_Construction.insert(row);
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											devItems = Proforma_Item[Template_Item == TRUE && Department == "Development" || Department == "Engineering"] sort by Cost_Code;
										for each  item in devItems
										{
											row = Add_Pro_Forma.Additional_Costs_Development();
											row.Item_Name=item.Item_Name;
											row.Department=item.Department;
											row.Category=item.Category;
											row.Dept_Code=item.Dept_Code;
											row.Cost_Code=item.Cost_Code;
											row.Template_Item=false;
											//row.Budget_Code="PF" + input.PF_Number.toString() + "-" + item.Cost_Code;
											row.Department=item.Department;
											input.Additional_Costs_Development.insert(row);
										}
						)
					}
				}

			}
			Add_l_Const_Line_Validati as "Add'l Const Line Validation - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Additional_Costs_Construction.Add_l_Cost
				{
					actions 
					{
						custom deluge script
						(
											if(row.Add_l_Cost != null)
										{
											enable row.Start_Phase;
											enable row.End_Phase;
										}
										if(row.Add_l_Cost == null)
										{
											row.Start_Phase=null;
											row.End_Phase=null;
											disable row.Start_Phase;
											disable row.End_Phase;
										}
						)
					}
				}

			}
			Add_l_Dev_Line_Validation as "Add'l Dev Line Validation - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Additional_Costs_Development.Add_l_Cost
				{
					actions 
					{
						custom deluge script
						(
											if(row.Add_l_Cost != NULL && row.Category != "Reimbursements")
										{
											enable row.Cost_Application;
										}
										if(row.Add_l_Cost != NULL && row.Category == "Reimbursements" && row.Item_Name.contains("Impact Fees") == FALSE)
										{
											enable row.Start_Phase;
											enable row.End_Phase;
											show row.Start_Month;
											show row.End_Month;
											enable row.Start_Month;
											enable row.End_Month;
										}
						)
					}
				}

			}
			Cost_Application_Type_Val as "Cost Application Type Validation - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Additional_Costs_Development.Cost_Application
				{
					actions 
					{
						custom deluge script
						(
											if(row.Cost_Application == "Across Phases" || row.Cost_Application == "Engineering End" || row.Cost_Application == "Construction Start")
										{
											enable row.Start_Phase;
											enable row.End_Phase;
										}
										if(row.Cost_Application == "Specific Months")
										{
											enable row.Start_Month;
											enable row.End_Month;
										}
						)
					}
				}

			}
			Add_l_Items_Validation_Pr as "Add'l Items Validation - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  itemRow in input.Additional_Costs_Construction
										{
											//if(itemRow.Add_l_Cost != null && itemRow.Start_Phase == null || itemRow.End_Phase == null)
											//{
											//	alert "Please enter start and end phase.";
											//	cancel submit;
											//}
											if(itemRow.Add_l_Cost == null && itemRow.Start_Phase != null || itemRow.End_Phase != null)
											{
												alert "Please enter all item costs where phases are designated.";
												cancel submit;
											}
											// Validate Add'l Cost line: must have EITHER complete phase range OR complete month range
											if(itemRow.Add_l_Cost != null && itemRow.Add_l_Cost != 0 && itemRow.Item_Name.contains("Impact Fees") == false)
											{
												// Adjust field names if yours differ
												hasPhaseStart = itemRow.Start_Phase != null;
												hasPhaseEnd = itemRow.End_Phase != null;
												hasMonthStart = itemRow.Start_Month != null;
												hasMonthEnd = itemRow.End_Month != null;
												phaseComplete = hasPhaseStart == true && hasPhaseEnd == true;
												monthComplete = hasMonthStart == true && hasMonthEnd == true;
												phasePartial = hasPhaseStart == true || hasPhaseEnd == true && phaseComplete == false;
												monthPartial = hasMonthStart == true || hasMonthEnd == true && monthComplete == false;
												// 1) No incomplete ranges
												if(phasePartial)
												{
													alert "Please enter Start and End Phase for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												if(monthPartial)
												{
													alert "Please enter Start and End Month for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												// 2) Not both, not neither
												if(phaseComplete && monthComplete)
												{
													alert "Please provide either phase range or month range for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												if(!phaseComplete && !monthComplete)
												{
													alert "Please provide a complete Phase range or a complete Month range to apply additional cost for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
											}
										}
										for each  itemRow in input.Additional_Costs_Development
										{
											//if(itemRow.Add_l_Cost != null && itemRow.Start_Phase == null || itemRow.End_Phase == null)
											//{
											//	alert "Please enter start and end phase.";
											//	cancel submit;
											//}
											if(itemRow.Add_l_Cost != null && itemRow.Add_l_Cost != 0 && !(itemRow.Category == "Reimbursements" && itemRow.Item_Name.contains("Impact Fees")))
											{
												if(itemRow.Start_Phase == null || itemRow.End_Phase == null || itemRow.Cost_Application == null)
												{
													alert "Please enter Start Phase, End Phase, and Cost Application for: " + itemRow.Item_Name;
													cancel submit;
												}
											}
											if(itemRow.Add_l_Cost == null && itemRow.Start_Phase != null || itemRow.End_Phase != null)
											{
												alert "Please enter all item costs where phases are designated.";
												cancel submit;
											}
											// Validate Add'l Cost line: must have EITHER complete phase range OR complete month range
											if(itemRow.Add_l_Cost != null && itemRow.Add_l_Cost != 0 && itemRow.Item_Name.contains("Impact Fees") == false)
											{
												// Adjust field names if yours differ
												hasPhaseStart = itemRow.Start_Phase != null;
												hasPhaseEnd = itemRow.End_Phase != null;
												hasMonthStart = itemRow.Start_Month != null;
												hasMonthEnd = itemRow.End_Month != null;
												phaseComplete = hasPhaseStart == true && hasPhaseEnd == true;
												monthComplete = hasMonthStart == true && hasMonthEnd == true;
												phasePartial = hasPhaseStart == true || hasPhaseEnd == true && phaseComplete == false;
												monthPartial = hasMonthStart == true || hasMonthEnd == true && monthComplete == false;
												// 1) No incomplete ranges
												if(phasePartial)
												{
													alert "Please enter Start and End Phase for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												if(monthPartial)
												{
													alert "Please enter Start and End Month for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												// 2) Not both, not neither
												if(phaseComplete && monthComplete)
												{
													alert "Please provide either phase range or month range for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
												if(!phaseComplete && !monthComplete)
												{
													alert "Please provide a complete Phase range or a complete Month range to apply additional cost for " + itemRow.Item_Name + " line item.";
													cancel submit;
												}
											}
											// Impact Fees in Reimbursements: NO month/phase inputs allowed
											if(itemRow.Category == "Reimbursements" && itemRow.Item_Name.contains("Impact Fees") == true)
											{
												if(itemRow.Start_Phase != null || itemRow.End_Phase != null || itemRow.Start_Month != null || itemRow.End_Month != null)
												{
													alert "Impact Fees (Reimbursements) should not have Start/End Phase or Start/End Month values. Please clear them for: " + itemRow.Item_Name;
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
			Addl_Costs_Tabs_Switch_Pr as "Addl Costs Tabs Switch - Pro Forma"
