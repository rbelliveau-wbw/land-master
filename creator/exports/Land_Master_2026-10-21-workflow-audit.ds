										// active: filled + sits “on” the baseline like a real selected tab
										x = x + ".zc-Addl_Costs_Tabs-group .form-field .tempContDiv .choice-table-row .choice-table-cell span .customRadio:checked ~ label.choice-label-text{" + "background:#f59e0b!important;" + "border-color:#f59e0b!important;" + "color:#ffffff!important;" + "transform:none!important;" + "position:relative!important;" + "top:7px!important;" + "}";
										// ===== ADDL COSTS TABS: remove the baseline line + tighten vertical gap =====
