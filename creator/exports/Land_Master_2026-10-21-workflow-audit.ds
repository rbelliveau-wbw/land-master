						custom deluge script
						(
											// ============================================================
										// FILL OUT CONST COST + OVERHEAD ON MONTHS (Deluge-safe)
										//
										// OPTIMIZED WITHOUT CHANGING EXISTING CALCULATION BEHAVIOR
										//
										// EXISTING BEHAVIOR PRESERVED:
										//
										// - Est_Lots_per_Acre = Lots / Total_Acres
										// - Ft_St_per_Lot = Total_Street_LF / Lots
										//
										// - Construction additional costs include ALL Proforma_Item
										//   records meeting the existing criteria:
										//     Department == "Construction"
										//     Add_l_Cost != null
										//     Add_l_Cost != 0
										//     linked through Pro_Forma_Const OR Pro_Forma_Dev
										//
										// - Category is NOT filtered in this block.
										// - Cost_Application is NOT considered in this block.
										//
										// - Each qualifying additional cost is divided by:
										//     End_Phase - Start_Phase + 1
										//
										// - The resulting phase amount is then multiplied by the
										//   construction curve percentage for each construction month.
										//
										// - Construction_Length.toLong() is still evaluated for every
										//   applicable COST + PHASE combination even though costSpread
										//   is not subsequently used. This intentionally preserves the
										//   existing execution behavior.
										//
										// - Phase Total_Lots behavior is unchanged.
										//
										// - Construction curve ordering is unchanged:
										//     Construction_Curve sort by Month_Number
										//
										// - Month ordering is unchanged:
										//     Proforma_Months sort by Const_Phase, Date1
										//
										// - The curve index continues sequentially through the sorted
										//   month rows and resets to zero whenever idx >= curveSize.
										//
										// - If there is no construction curve:
										//     pct remains 0
										//     idx is incremented and immediately reset to 0
										//
										// - Construction_Cost_Base is rounded to 2 decimals.
										//
										// - Construction_Cost_Addl is NOT rounded.
										//
										// - Construction_Overhead is NOT rounded.
										//
										// - Construction_Overhead is only written when
										//   input.Construction_Overhead != null.
										//
										// OPTIMIZATION:
										//
										// OLD:
										//     for each construction month
										//         for each construction additional cost
										//
										// NEW:
										//     determine unique construction phases
										//     for each unique phase
										//         for each construction additional cost
										//
										//     then write all construction months once.
										//
										// This preserves the amount calculated for every month while
										// eliminating repeated cost-range evaluation for every month
										// belonging to the same construction phase.
										// ============================================================
										// ------------------------------------------------------------
										// EXISTING HEADER CALCULATIONS
										// ------------------------------------------------------------
										input.Est_Lots_per_Acre = input.Lots / input.Total_Acres;
										input.Ft_St_per_Lot = input.Total_Street_LF / input.Lots;
										// ------------------------------------------------------------
										// EXISTING CONSTRUCTION ADDITIONAL COST CRITERIA
										//
										// IMPORTANT:
										// Do not add Category or Cost_Application filters here.
										// The existing block does not use them.
										// ------------------------------------------------------------
										addlCosts = Proforma_Item[(Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Department == "Construction") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Department == "Construction")];
										// ------------------------------------------------------------
										// EXISTING BASE CONSTRUCTION COST PER LOT
										// ------------------------------------------------------------
										baseCost = ifnull(input.Ft_St_per_Lot,0) * ifnull(input.Const_Cost_FF,0);
										// ------------------------------------------------------------
										// EXISTING MONTH POPULATION + SORT ORDER
										//
										// Curve sequencing depends on this exact ordering.
										// ------------------------------------------------------------
										mnths = Proforma_Months[Proforma == input.ID && Const_Phase != null] sort by Const_Phase,Date1;
										// ============================================================
										// PRELOAD PHASE → TOTAL LOTS
										//
										// Preserve existing Map key behavior.
										//
										// Existing code:
										//     phaseLots.put(ph.Phase, ifnull(ph.Total_Lots,0));
										//
										// No filtering of null phase values has been added.
										// ============================================================
										phaseLots = Map();
										for each  ph in Proforma_Phase[Pro_Forma == input.ID]
										{
											phaseLots.put(ph.Phase,ifnull(ph.Total_Lots,0));
										}
										// ============================================================
										// PRELOAD CONSTRUCTION CURVE
										//
										// Preserve exact existing ordering and null handling.
										// ============================================================
										curvePercents = List();
										for each  c in Construction_Curve[Pro_Forma == input.ID] sort by Month_Number
										{
											curvePercents.add(ifnull(c.Percent_Cost,0));
										}
										curveSize = curvePercents.size().toLong();
										// ============================================================
										// BUILD UNIQUE LIST OF ACTUAL CONSTRUCTION PHASE VALUES
										//
										// Use phases directly from Proforma_Months rather than assuming
