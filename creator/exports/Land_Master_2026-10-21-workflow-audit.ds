			Finalize_Workflow_Run_Log as "Finalize Workflow Run Log"
			{
				type =  form
				form = Workflow_Run_Log

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Runs in the audit API transaction, independently of the importing script.
										runIdText = input.ID.toString();
										run = Workflow_Run_Log[ID == input.ID];
										status = input.Run_Status;
										if(status != "Running")
										{
											if(run.Finished_At == null)
											{
												run.Finished_At=zoho.currenttime;
											}
											run.Duration_Seconds=(run.Finished_At.toLong() - run.Started_At.toLong()) / 1000;
											failureStatuses = {"Failed","Partial","Timed Out"};
											if(failureStatuses.contains(status) && run.Failure_Notified != true)
											{
												try 
												{
													settings = Settings[ID != 0];
													if(settings.count() != 1)
													{
														throw "Failure email requires exactly one Settings record.";
													}
													recipientIds = settings.Workflow_Log_Failure_Recipients;
													recipients = List();
													missingEmails = List();
													if(recipientIds != null)
													{
														for each  person in User_Access[ID in recipientIds]
														{
															email = ifnull(person.Approver_Email,"").toString().trim();
															if(email == "")
															{
																missingEmails.add(person.Full_Name);
															}
															else if(!recipients.contains(email))
															{
																recipients.add(email);
															}
														}
													}
													if(recipients.size() == 0)
													{
														throw "No Workflow Log Failure Recipients with an email are configured in Settings.";
													}
													// Send only workflow identifiers/counts and a log link, never raw API bodies or credentials.
													sendmail
													[
														from :"Notifications@wbdevelopment.com"
														to :recipients
														subject :"Land Master workflow " + status + ": " + run.Workflow_Name
														message :"Workflow: " + run.Workflow_Name + "<br>System: " + run.External_System + "<br>Status: " + status + "<br>Stage: " + run.Stage + "<br>Run ID: " + runIdText + "<br>Received: " + run.Rows_Received + "; processed: " + run.Rows_Processed + "; skipped: " + run.Rows_Skipped + "; failed: " + run.Rows_Failed + "<br><br>Open Settings > Workflow Log for the full error and execution details."
													]
													run.Failure_Notified=true;
													run.Notification_Error="";
													if(missingEmails.size() > 0)
													{
														run.Notification_Error="Selected users without an email: " + missingEmails.toString();
													}
												}		catch (notificationError)
												{
													notificationMessage = notificationError.toString();
													if(notificationMessage.length() > 5000)
													{
														notificationMessage = notificationMessage.left(5000);
													}
													run.Notification_Error=notificationMessage;
													info "WORKFLOW FAILURE EMAIL FAILED: run " + runIdText + "; " + notificationError.toString();
												}
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Update_Sold_Counts_Takedo as "Update Sold Counts - Takedown Schedule"
			{
				type =  schedule
				start = "2023-01-27 06:00:09"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						status = "Sold";
										for each  takedown in Takedown_Schedule[ID != 0]
										{
											lotCount = 0;
											startDate = null;
											for each  subdiv in takedown.Subdivisions
											{
												// lots tied to this schedule (widget completions set Contract_Schedule),
												// plus untied lots for the same builder in this phase (native-form
												// completions and older data never got the link)
												lots = Lots[ID != 0 && Status == status && Purchase_Date != null && Subdivision == subdiv && Contract_Schedule == takedown.ID || (Contract_Schedule == null && Builder1 == takedown.Builder1)] sort by Purchase_Date;
												lotCount = lotCount + lots.count(ID);
												subStart = lots.minimum(Purchase_Date);
												if(subStart != null && startDate == null || subStart < startDate)
												{
													startDate = subStart;
												}
											}
											takedown.Lots_Sold=lotCount;
											if(takedown.Initial_Closing_Date != null)
											{
												takedown.Takedown_Start_Date=takedown.Initial_Closing_Date;
											}
											else if(startDate != null && takedown.Takedown_Start_Date == null || startDate < takedown.Takedown_Start_Date)
											{
												takedown.Takedown_Start_Date=startDate;
											}
										}
					)
					}
				}
			}
			Update_Takedown_Dates_Tak as "Update Takedown Dates - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-02 01:25:27"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// Replacement daily on-start action body for the existing native workflow.
										// Requires the PROPOSED Second_Closing_Lots / Second_Closing_Days fields and
										// Calculate_Takedown_Cadence function to be installed first.
										// Legacy records: preserve the exported end-date formula and missing-end gate.
										for each  takedown in Takedown_Schedule[Second_Closing_Lots == null && Second_Closing_Days == null && Takedown_Start_Date != null && Takedown_End_Date == null && Continued_Takedown != 0]
										{
											takedownLength = ceil((takedown.Total_Lot_Obligation - takedown.Initial_Takedown) / takedown.Continued_Takedown) * takedown.Continued_Takedown_Delay_Days + takedown.Initial_Delay_Days;
											tdStart = takedown.Takedown_Start_Date;
											takedown.Takedown_End_Date=tdStart.addDay(takedownLength);
										}
										// A populated Second Closing enters the new calculation. Partial or invalid
										// terms never fall back to legacy arithmetic or overwrite calculated fields.
										for each  takedown in Takedown_Schedule[Second_Closing_Lots != null || Second_Closing_Days != null]
										{
											cadenceStart = ifnull(takedown.Initial_Closing_Date,takedown.Takedown_Start_Date);
											cadenceTerms = Map();
											cadenceTerms.put("Total_Lot_Obligation",takedown.Total_Lot_Obligation);
											cadenceTerms.put("Initial_Takedown",takedown.Initial_Takedown);
											cadenceTerms.put("Initial_Due_Offset_Days",takedown.Initial_Delay_Days);
											cadenceTerms.put("Second_Closing_Lots",takedown.Second_Closing_Lots);
											cadenceTerms.put("Second_Closing_Days",takedown.Second_Closing_Days);
											cadenceTerms.put("Continued_Takedown",takedown.Continued_Takedown);
											cadenceTerms.put("Continued_Takedown_Delay_Days",takedown.Continued_Takedown_Delay_Days);
											cadenceTerms.put("Elapsed_Days",0);
											if(cadenceStart != null)
											{
												cadenceTerms.put("Elapsed_Days",daysBetween(cadenceStart,today));
											}
											cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
											if(cadence.get("ok") == true)
											{
												if(cadenceStart != null)
												{
													takedown.Takedown_Start_Date=cadenceStart;
													takedown.Takedown_End_Date=cadenceStart.addDay(cadence.get("endOffsetDays"));
												}
												else
												{
													takedown.Takedown_End_Date=null;
												}
											}
										}
					)
					}
				}
			}
			Update_Expected_Sold_Coun as "Update Expected Sold Count - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-01 06:30:13"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// Replacement on-start action body for the existing native daily workflow.
										// This body incorporates all three exported actions. Capture their originals;
										// install this in action 1 and neutralize the trailing action bodies so their
										// old arithmetic cannot overwrite new results. Requires both fields/helper first.
										// Legacy records preserve the exported arithmetic, including abs and strict >.
										for each  takedown in Takedown_Schedule[Second_Closing_Lots == null && Second_Closing_Days == null && Status != "Completed" && Takedown_Start_Date != NULL && Total_Lot_Obligation != NULL && Initial_Takedown != null && Continued_Takedown_Delay_Days != 0]
										{
											dayDifference = abs(daysBetween(takedown.Takedown_Start_Date,today));
											contdMultiple = floor((dayDifference - takedown.Initial_Delay_Days) / takedown.Continued_Takedown_Delay_Days);
											if(dayDifference <= takedown.Initial_Delay_Days)
											{
												takedown.Lots_Expected=0;
											}
											if(dayDifference > takedown.Initial_Delay_Days && addDay(takedown.Takedown_Start_Date,dayDifference) < takedown.Takedown_End_Date)
											{
												takedown.Lots_Expected=takedown.Initial_Takedown + contdMultiple * takedown.Continued_Takedown;
											}
											if(takedown.Takedown_End_Date <= today)
											{
												takedown.Lots_Expected=takedown.Total_Lot_Obligation;
											}
										}
										// New records calculate expected lots and the end date together so correctness
										// does not depend on the daily date workflow's execution order.
										for each  takedown in Takedown_Schedule[(Status != "Completed" && Second_Closing_Lots != null) || (Status != "Completed" && Second_Closing_Days != null)]
										{
											cadenceStart = ifnull(takedown.Initial_Closing_Date,takedown.Takedown_Start_Date);
											cadenceTerms = Map();
											cadenceTerms.put("Total_Lot_Obligation",takedown.Total_Lot_Obligation);
											cadenceTerms.put("Initial_Takedown",takedown.Initial_Takedown);
											cadenceTerms.put("Initial_Due_Offset_Days",takedown.Initial_Delay_Days);
											cadenceTerms.put("Second_Closing_Lots",takedown.Second_Closing_Lots);
											cadenceTerms.put("Second_Closing_Days",takedown.Second_Closing_Days);
											cadenceTerms.put("Continued_Takedown",takedown.Continued_Takedown);
											cadenceTerms.put("Continued_Takedown_Delay_Days",takedown.Continued_Takedown_Delay_Days);
											cadenceTerms.put("Elapsed_Days",0);
											if(cadenceStart != null)
											{
												cadenceTerms.put("Elapsed_Days",daysBetween(cadenceStart,today));
											}
											cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
											if(cadence.get("ok") == true)
											{
												if(cadenceStart != null)
												{
													takedown.Takedown_Start_Date=cadenceStart;
													takedown.Takedown_End_Date=cadenceStart.addDay(cadence.get("endOffsetDays"));
													takedown.Lots_Expected=cadence.get("lotsExpected");
												}
												else
												{
													takedown.Takedown_End_Date=null;
													takedown.Lots_Expected=0;
												}
											}
										}
										// Preserve the exported no-sales initialization for legacy terms. Valid new
										// terms initialize above; partial new terms must not receive fallback writes.
										for each  td in Takedown_Schedule[Second_Closing_Lots == null && Second_Closing_Days == null && Takedown_Start_Date == null && Lots_Expected == null && Total_Lot_Obligation != null]
										{
											td.Lots_Expected=0;
										}
										// Preserve the exported upfront-only special case exclusively for legacy terms.
										for each  td in Takedown_Schedule[Second_Closing_Lots == null && Second_Closing_Days == null && Status == "Active" && Takedown_Start_Date != null && Total_Lot_Obligation != null && Initial_Takedown != null && Initial_Delay_Days == 0 && Continued_Takedown == 0]
										{
											td.Lots_Expected=td.Initial_Takedown;
										}
					)
					}
					actions 
					{
					on load
					(
						// Expected-lot calculation is owned by the first action in this workflow.
										// Original action body is retained in the Second Closing migration backup.
										secondClosingCalculationOwnedByFirstAction = true;
					)
					}
					actions 
					{
					on load
					(
						// Expected-lot calculation is owned by the first action in this workflow.
										// Original action body is retained in the Second Closing migration backup.
										secondClosingCalculationOwnedByFirstAction = true;
					)
					}
				}
			}
			Update_Subdivision_Status as "Update Subdivision Status - Subdivision"
			{
				type =  schedule
				start = "2023-02-28 07:05:27"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through each Subdivision record and if Lots Sold >= Total Lots in Subdiv set Subdivision.Status to Sold Out
										for each  subdiv in Subdivision[Status = "Active" && Total_Lots != 0]
										{
											lotsSold = subdiv.Lots_Sold;
											totalLots = subdiv.Total_Lots;
											if(lotsSold >= totalLots)
											{
												subdiv.Status="Sold Out";
												//subdiv.Last_Sold_Date=zoho.currentdate;
											}
										}
					)
					}
				}
			}
			Update_Status_on_Takedown as "Update Status on Takedowns - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-28 07:00:20"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						for each  takedown in Takedown_Schedule[Status == "Active" || Status == "Behind"]
										{
											lotsSold = ifnull(takedown.Lots_Sold,0);
											lotsExpected = ifnull(takedown.Lots_Expected,0);
											obligation = ifnull(takedown.Total_Lot_Obligation,0);
											// same code rule as Complete_Lot_Contract and the Contract form workflow:
											// every phase code, sorted, joined with "+", then the builder
											codes = List();
											for each  subId in takedown.Subdivisions
											{
												sub = Subdivision[ID == subId];
												if(sub.ID != null)
												{
													codes.add(ifnull(sub.Subdivision_Code,"").toString());
												}
											}
											codes.sort();
											takedown.Takedown_Schedule_Code=codes.toString("+") + " - " + takedown.Builder1.Builder_Name;
											if(obligation > 0 && lotsSold >= obligation)
											{
												takedown.Status="Completed";
												takedown.Completion_Percent=100;
											}
											else
											{
												if(lotsSold < lotsExpected)
												{
													takedown.Status="Behind";
												}
												else
												{
													takedown.Status="Active";
												}
												if(obligation > 0)
												{
													takedown.Completion_Percent=lotsSold / obligation * 100;
												}
											}
										}
					)
					}
				}
			}
			Update_Sold_Total_Unforec as "Update Sold/Total/Unforecasted Lots - Subdivision"
			{
				type =  schedule
				start = "2023-02-28 12:12:53"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//this code goes through each Subdivsion on a daily basis and queries all Lots and writes the daily values to the following fields 
										//1. Subdivision.Lots_Sold
										//2. Subdivision.Total_Lots
										//3. Subdivision.Last_Sold_Date
										status = "Sold";
										for each  subdiv in Subdivision[Status != "Forecast Placeholder"]
										{
											lotsSold = Lots[ID != 0 && Phase == subdiv.Phase && Status == status && Subdivision == subdiv.ID && Model = FALSE];
											lotsPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model = FALSE];
											futureForecasted = Forecast[Subdivision1 == subdiv && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots);
											lotsLatestsold = Lots[ID != 0 && Phase == subdiv.Phase && Status == status && Subdivision == subdiv.ID && Model = FALSE].maximum(Close_Date);
											lotCount = lotsSold.count(ID);
											lotTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model = FALSE];
											lotsTotal2 = lotTotal.count(ID);
											subdiv.Lots_Sold=lotCount;
											subdiv.Total_Lots=lotsTotal2;
											subdiv.Last_Sold_Date=lotsLatestsold;
											subdiv.Unforecasted_Lots=lotTotal.count(ID) - lotsPurchased.count(ID) - futureForecasted;
										}
					)
					}
				}
			}
			Update_Lot_Count_Builder_ as "Update Lot Count - Builder Takedown"
			{
				type =  schedule
				start = "2023-08-08 05:28:57"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//Goes through every Builder Takedown every day and counts number of Lots and writes that value to Lot_Count
										for each  btd in Builder_Takedown[ID != 0]
										{
											lotCount = btd.Lots.size();
											btd.Lot_Count=lotCount;
										}
					)
					}
				}
			}
			Last_Takedown_Prev_Count_ as "Last Takedown & Prev Count Fields - TD Schedule"
			{
				type =  schedule
				start = "2024-01-04 05:55:21"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through all Takedown_Schedules daily and updates the following fields regarding previous 30, 90, 6 months, and 12 months Sold C ount
										//status = "Sold";
										for each  takedown in Takedown_Schedule[ID != 0]
										{
											thirtydayCount = 0;
											ninetydayCount = 0;
											sixmonthCount = 0;
											twelvemonthCount = 0;
											for each  subdiv in takedown.Subdivisions
											{
												latestbtdDate = Builder_Takedown[Subdivision1 = subdiv && Builder1 = takedown.Builder1 && Purchase_Date <= zoho.currentdate] sort by Purchase_Date;
												latestbtdLotcount = Builder_Takedown[Subdivision1 = subdiv && Builder1 = takedown.Builder1 && Purchase_Date = latestbtdDate.maximum(Purchase_Date)] sort by Purchase_Date;
												lotCount = latestbtdLotcount.maximum(Lot_Count);
												lastDate = latestbtdDate.maximum(Purchase_Date);
												takedown.Last_Takedown_Amount=lotCount;
												takedown.Last_Takedown_Date=lastDate;
												thirtydayQuery = Lots[Close_Date >= zoho.currentdate.subDay(30) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												ninetydayQuery = Lots[Close_Date >= zoho.currentdate.subDay(90) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												sixmonthQuery = Lots[Close_Date >= zoho.currentdate.subMonth(6) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												twelvemonthQuery = Lots[Close_Date >= zoho.currentdate.subMonth(12) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												thirtydayCount = thirtydayCount + thirtydayQuery;
												ninetydayCount = ninetydayCount + ninetydayQuery;
												sixmonthCount = sixmonthCount + sixmonthQuery;
												twelvemonthCount = twelvemonthCount + twelvemonthQuery;
											}
											takedown.Last_30_Day_Sales=thirtydayCount;
											takedown.Last_90_Day_Sales=ninetydayCount;
											takedown.Last_6_Month_Sales=sixmonthCount;
											takedown.Last_12_Month_Sales=twelvemonthCount;
										}
					)
					}
				}
			}
			Update_Contract_Schedule_ as "Update Contract Schedule - Lots"
			{
				type =  schedule
				start = "2024-07-25 13:02:13"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						for each  lot in Lots[Contract_Schedule == null && Status == "Open"]
										{
											contractSchedule = Takedown_Schedule[Subdivisions.contains(lot.Subdivision) && Builder1 == lot.Builder1].ID;
											lot.Contract_Schedule=contractSchedule;
										}
										for each  lot in Lots[Contract_Schedule == null && Status == "Scheduled"]
										{
											contractSchedule = Takedown_Schedule[Subdivisions.contains(lot.Subdivision) && Builder1 == lot.Builder1].ID;
											lot.Contract_Schedule=contractSchedule;
										}
					)
					}
					actions 
					{
					on load
					(
						for each  lot in Lots[Contract_Schedule == null && Status == "Contracted"]
										{
											contractSchedule = Takedown_Schedule[Subdivisions.contains(lot.Subdivision) && Builder1 == lot.Builder1].ID;
											lot.Contract_Schedule=contractSchedule;
										}
					)
					}
					actions 
					{
					on load
					(
						for each  lot in Lots[Contract_Schedule == null && Status == "Sold"]
										{
											contractSchedule = Takedown_Schedule[Subdivisions.contains(lot.Subdivision) && Builder1 == lot.Builder1].ID;
											lot.Contract_Schedule=contractSchedule;
										}
					)
					}
				}
			}
