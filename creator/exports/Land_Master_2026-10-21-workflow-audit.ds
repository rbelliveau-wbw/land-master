			Write_Purchase_Date_Build as "Write Purchase Date - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  lot in input.Lots
										{
											lot.Purchase_Date=input.Purchase_Date;
											if(input.Purchase_Date != null)
											{
												lot.Purch_Date_Text=input.Purchase_Date.toString();
											}
											else
											{
												lot.Purch_Date_Text=null;
											}
											if(lot.Close_Date != null)
											{
												lot.Status="Sold";
											}
											else if(input.Purchase_Date != null)
											{
												lot.Status="Scheduled";
											}
											else if(lot.Builder1 != null && lot.Builder1.Builder_Name != "Placeholder")
											{
												lot.Status="Contracted";
											}
											else
											{
												lot.Status="Open";
											}
										}
						)
					}
				}

			}
