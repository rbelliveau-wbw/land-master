		form Subdivision
		{
			title 
    		{
				displayname = "Add Subdivision"
    			on add = "Create Subdivision"
   	 			on edit = "Edit Subdivision"
			}
			success message = "Subdivision Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Project
			(
				type = picklist	
				values  = Project.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 170px
			)
			must have Phase
			(
				type = number
				maxchar = 3
	 			row = 1
	 			column = 1   
				width = small
			)
			Subphase
			(
    			type = text
				maxchar = 2
	 			row = 1
	 			column = 1   
				width = small
			)
			Generate_Forecasts
			(
    			type = checkbox
				displayname = "Generate Forecasts"
				initial value = false
    			description
    			[
    				type = tooltip
    			 	message = "Checking this box will generate 10 years of planning forecasts for this Subdivision, starting with the current year."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company1
			(
				type = picklist	
				displayname = "Development Company"
				values  = Company.ID
    			displayformat = [Company_Name + " - " + Account_Number]
				allow new entries
				[
					displayname = "Add Company"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 350px
			)
			Land_Company
			(
				type = picklist	
				displayname = "Land Company"
				values  = Company.ID
    			displayformat = [Facility_ID + " - " + Company_Name + " - " + Account_Number]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
