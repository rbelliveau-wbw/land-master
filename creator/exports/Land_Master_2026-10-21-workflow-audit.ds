                 		timelineLabels = {"ESTIMATED PURCHASE","ENGINEERING START / DELAY","ENGINEERING LENGTH","CONSTRUCTION START / DELAY","CONSTRUCTION LENGTH","ESTIMATED COMPLETION","LAND SALE INSTALLMENTS"};
                 		timelineValues = {purchaseLabel,engineeringStartLabel + " / " + thisapp.PF_Packet_Number(ifnull(pf.Engineering_Delay_Months,0).toString(),0) + " mo",thisapp.PF_Packet_Number(ifnull(pf.Engineering_Length_Months,"").toString(),0) + " mo",constructionStartLabel + " / " + thisapp.PF_Packet_Number(ifnull(pf.Construction_Delay_Months,0).toString(),0) + " mo",thisapp.PF_Packet_Number(ifnull(pf.Construction_Length,"").toString(),0) + " mo",completionLabel,firstSaleInstallmentLabel};
                 		for each index timelineIndex in timelineLabels
                 		{
                 			rowY = 220 - timelineIndex * 24;
                 			page = page + thisapp.PF_PDF_Text(40,rowY,10,"bold",muted,timelineLabels.get(timelineIndex));
                 			page = page + thisapp.PF_PDF_Text(206,rowY,10,"bold",ink,timelineValues.get(timelineIndex));
                 			page = page + thisapp.PF_PDF_Rect(40,rowY - 8,292,0.5,softLine,"",0);
                 		}
                 		initialTakeLabel = "Phase schedule incomplete";
                 		recurringTakeLabel = "Phase schedule incomplete";
                 		pdfPhases = Proforma_Phase[Pro_Forma == pf.ID] sort by Phase;
                 		pdfScheduleComplete = pdfPhases.count() > 0 && pdfPhases.count() == ifnull(pf.Phases,0).toLong();
                 		pdfPhaseNumber = 1;
                 		pdfAllocatedLots = 0;
                 		for each  pdfPhase in pdfPhases
                 		{
                 			if(ifnull(pdfPhase.Phase,0).toLong() != pdfPhaseNumber || pdfPhase.Total_Lots == null || pdfPhase.Initial_Take_Lots == null || pdfPhase.Initial_Delay_Months == null || ifnull(pdfPhase.Total_Lots,0).toLong() < 1 || ifnull(pdfPhase.Initial_Take_Lots,0).toLong() < 1 || ifnull(pdfPhase.Initial_Delay_Months,0).toLong() < 0 || ifnull(pdfPhase.Initial_Take_Lots,0).toLong() > ifnull(pdfPhase.Total_Lots,0).toLong())
                 			{
                 				pdfScheduleComplete = false;
                 			}
                 			else if(ifnull(pdfPhase.Total_Lots,0).toLong() > ifnull(pdfPhase.Initial_Take_Lots,0).toLong() && pdfPhase.First_Recurring_Delay_Months == null || pdfPhase.Lots_Per_Take == null || ifnull(pdfPhase.First_Recurring_Delay_Months,0).toLong() < 1 || ifnull(pdfPhase.Lots_Per_Take,0).toLong() < 1)
                 			{
                 				pdfScheduleComplete = false;
                 			}
                 			if(ifnull(pdfPhase.Take_Frequency,"").toString() != "Monthly" && ifnull(pdfPhase.Take_Frequency,"").toString() != "Quarterly")
                 			{
                 				pdfScheduleComplete = false;
                 			}
                 			pdfAllocatedLots = pdfAllocatedLots + ifnull(pdfPhase.Total_Lots,0).toLong();
                 			pdfPhaseNumber = pdfPhaseNumber + 1;
                 		}
                 		if(pdfAllocatedLots != ifnull(pf.Lots,0).toLong())
