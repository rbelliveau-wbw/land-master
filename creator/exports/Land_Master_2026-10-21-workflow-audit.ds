										x = x + ".form-group.clearfix.zc-Addl_Costs_Tabs-group.zc-radio-field-group{" + "margin:6px 0 8px 0!important;" + "}";
										// Optional: remove extra right-padding space some layouts add in the field container
										x = x + ".zc-Addl_Costs_Tabs-group .form-field{padding:0!important;margin:0!important;}";
										x = x + "</style>";
										input.plain = x;
										input.Tabs = "General Information";
						)
