			Construction_Contract_Act as "Construction Contract Actions Validation"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Candidate new Contract_Actions / on add or edit / on validate action.
										// Install after Work_Module and the two construction User Access fields exist.
										// Blank legacy module values are Legal; linked actions always inherit the parent.
										constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
										existingTask = Contract_Actions[ID == input.ID];
										taskMode = ifnull(input.Work_Module,"");
										if(taskMode == "")
										{
											taskMode = "Legal";
										}
										if(input.Contract1 != null)
										{
											taskParent = Contract[ID == input.Contract1];
											if(taskParent.count() == 0)
											{
												alert "The linked request is unavailable.";
												cancel submit;
											}
											taskMode = ifnull(taskParent.Work_Module,"");
											if(taskMode == "")
											{
												taskMode = "Legal";
											}
											input.Work_Module = taskMode;
											if(taskMode == "Construction")
											{
												input.Type_field = taskParent.Contract_Type;
												input.Template_Action = false;
											}
										}
										if(existingTask.count() > 0)
										{
											existingTaskMode = ifnull(existingTask.Work_Module,"");
											if(existingTask.Contract1 != null)
											{
												existingParent = Contract[ID == existingTask.Contract1];
												existingTaskMode = ifnull(existingParent.Work_Module,"");
											}
											if(existingTaskMode == "")
											{
												existingTaskMode = "Legal";
											}
											isConstructionTask = taskMode == "Construction" || existingTaskMode == "Construction";
											if(isConstructionTask)
											{
												if(taskMode != existingTaskMode || input.Contract1 != existingTask.Contract1)
												{
													alert "An existing task cannot be moved to another request or Work Module.";
													cancel submit;
												}
											}
										}
										constructionTaskTypes = {"Internal","Offsite","Amenity","MUD Bid"};
										if(taskMode == "Construction")
										{
											constructionAllowed = thisapp.hasConstructionPermission(zoho.loginuser,true);
											if(constructionAllowed != true)
											{
												alert "Edit All Construction Requests permission is required to change construction tasks or templates.";
												cancel submit;
											}
											if(input.Contract1 != null && ifnull(taskParent.Status,"") == "Complete")
											{
												alert "This construction request is complete and read-only.";
												cancel submit;
											}
											if(input.Type_field != null && !constructionTaskTypes.contains(input.Type_field))
											{
												alert "Choose a construction Budget Type.";
												cancel submit;
											}
										}
										else if(constructionBudgetingProfile)
										{
											alert "This profile can only change Construction actions and templates.";
											cancel submit;
										}
										else if(taskMode != "Legal" || constructionTaskTypes.contains(input.Type_field))
										{
											alert "Construction task types require Construction Work Module.";
											cancel submit;
										}
						)
					}
				}

			}
			Construction_Contract_App as "Construction Contract Approvals Validation"
			{
				type =  form
				form = Contract_Approvals

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Contract1 != null)
										{
											approvalParent = Contract[ID == input.Contract1];
											if(approvalParent.count() > 0 && ifnull(approvalParent.Work_Module,"") == "Construction")
											{
												alert "Construction requests do not use Legal contract approvals.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Construction_Attachment_V as "Construction Attachment Validation"
			{
				type =  form
				form = Attachment

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Candidate new Attachment / on add or edit / on validate action.
										// Construction submitters may add their files without editing request fields.
										storedAttachment = Attachment[ID == input.ID];
										attachmentParentId = input.Contract1;
										if(storedAttachment.count() > 0)
										{
											attachmentParentId = storedAttachment.Contract1;
										}
										constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
										if(constructionBudgetingProfile)
										{
											scopedAttachmentParent = Contract[ID == attachmentParentId];
											if(attachmentParentId == null || scopedAttachmentParent.count() == 0 || ifnull(scopedAttachmentParent.Work_Module,"") != "Construction")
											{
												alert "This profile can only attach files to Construction requests.";
												cancel submit;
											}
										}
										if(attachmentParentId != null)
										{
											attachmentParent = Contract[ID == attachmentParentId];
											if(attachmentParent.count() > 0 && ifnull(attachmentParent.Work_Module,"") == "Construction")
											{
												constructionAllowed = thisapp.hasConstructionPermission(zoho.loginuser,false);
												constructionEditAllowed = thisapp.hasConstructionPermission(zoho.loginuser,true);
												if(constructionAllowed != true)
												{
													alert "Construction request access is required to add attachments.";
													cancel submit;
												}
												if(ifnull(attachmentParent.Status,"") == "Complete")
												{
													alert "This construction request is complete and read-only.";
													cancel submit;
												}
												if(storedAttachment.count() > 0)
												{
													if(input.Contract1 != storedAttachment.Contract1)
													{
														alert "An attachment cannot be moved to another request.";
														cancel submit;
													}
													if(constructionEditAllowed != true && storedAttachment.Added_User != zoho.loginuser)
													{
														alert "You can only upload files to your own construction attachments.";
														cancel submit;
													}
												}
											}
										}
										// Do not let an existing Legal attachment be moved into Construction either.
										if(storedAttachment.count() > 0 && input.Contract1 != storedAttachment.Contract1 && input.Contract1 != null)
										{
											newAttachmentParent = Contract[ID == input.Contract1];
											if(newAttachmentParent.count() > 0 && ifnull(newAttachmentParent.Work_Module,"") == "Construction")
											{
												alert "An attachment cannot be moved to another request.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Validate_Property_Transfe as "Validate Property Transfer"
			{
				type =  form
				form = Property_Transfer

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Property transfers record history only. Ownership remains a manual edit.
										if(input.From_Company == input.To_Company)
										{
											alert "From Company and To Company must be different.";
											cancel submit;
										}
										if(input.Transfer_Scope == "Partial")
										{
											if(input.Amount_Unit == null || (input.Amount_Unit != "Percentage" && input.Amount_Unit != "Acres"))
											{
												alert "Choose Percentage or Acres for a partial transfer.";
												cancel submit;
											}
											if(input.Amount_Transferred == null || input.Amount_Transferred <= 0)
											{
												alert "Enter a positive partial transfer amount.";
												cancel submit;
											}
											if(input.Amount_Unit == "Percentage" && input.Amount_Transferred >= 100)
											{
												alert "A partial transfer must be less than 100%.";
												cancel submit;
											}
											if(input.Amount_Unit == "Acres" && input.Property != null)
											{
												propertyRow = Property[ID == input.Property];
												if(propertyRow.Acres != null && propertyRow.Acres > 0 && input.Amount_Transferred >= propertyRow.Acres)
												{
													alert "A partial transfer must be less than the property acreage.";
													cancel submit;
												}
											}
										}
										else
										{
											input.Amount_Unit = null;
											input.Amount_Transferred = null;
										}
						)
					}
				}

			}
			Validate_Budget_Request_A as "Validate Budget Request Attachment"
			{
				type =  form
				form = Attachment

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Attachment / Created or Edited / Validations on form submission.
										if(input.Payment_Request != null && input.Budget_Modification != null)
										{
											alert "Choose one associated request.";
											cancel submit;
										}
										requestBudget = null;
										if(input.Payment_Request != null)
										{
											requestParent = Payment_Request[ID == input.Payment_Request];
											if(requestParent.count() != 1)
											{
												alert "The associated request is unavailable.";
												cancel submit;
											}
											requestBudget = requestParent.Budget;
										}
										if(input.Budget_Modification != null)
										{
											modificationParent = Budget_Modification[ID == input.Budget_Modification];
											if(modificationParent.count() != 1)
											{
												alert "The associated modification is unavailable.";
												cancel submit;
											}
											requestBudget = modificationParent.Budget;
										}
										if(input.Payment_Request != null || input.Budget_Modification != null && requestBudget == null)
										{
											alert "The associated request needs a Budget before a file can be linked to it.";
											cancel submit;
										}
										if(requestBudget != null)
										{
											if(input.Budget == null)
											{
												input.Budget = requestBudget;
											}
											if(input.Budget != requestBudget)
											{
												alert "The attachment and request must belong to the same Budget.";
												cancel submit;
											}
										}
						)
					}
				}

			}
