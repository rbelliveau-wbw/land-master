                 			{
                 				loiRec.Approval_Token=ws.get("Approval_Token");
                 			}
                 			if(ws.get("Total_Acres") != null && ws.get("Total_Acres").toString() != "")
                 			{
                 				loiRec.Total_Acres=ws.get("Total_Acres").toDecimal();
                 			}
                 			if(ws.get("Amount_Per_Acre") != null && ws.get("Amount_Per_Acre").toString() != "")
                 			{
                 				loiRec.Amount_Per_Acre=ws.get("Amount_Per_Acre").toDecimal();
                 			}
                 			if(ws.get("Estimated_Price") != null && ws.get("Estimated_Price").toString() != "")
                 			{
                 				loiRec.Estimated_Price=ws.get("Estimated_Price").toDecimal();
                 			}
                 			if(ws.get("Earnest_Money") != null && ws.get("Earnest_Money").toString() != "")
                 			{
                 				loiRec.Earnest_Money=ws.get("Earnest_Money").toDecimal();
                 			}
                 			if(ws.get("Amount_Per_Extension") != null && ws.get("Amount_Per_Extension").toString() != "")
                 			{
                 				loiRec.Amount_Per_Extension=ws.get("Amount_Per_Extension").toDecimal();
                 			}
                 			if(ws.get("Earnest_Money_Due_Days") != null && ws.get("Earnest_Money_Due_Days").toString() != "")
                 			{
                 				loiRec.Earnest_Money_Due_Days=ws.get("Earnest_Money_Due_Days").toLong();
                 			}
                 			if(ws.get("Initial_Feasibility_Days") != null && ws.get("Initial_Feasibility_Days").toString() != "")
                 			{
                 				loiRec.Initial_Feasibility_Days=ws.get("Initial_Feasibility_Days").toLong();
                 			}
                 			if(ws.get("Extensions") != null && ws.get("Extensions").toString() != "")
                 			{
                 				loiRec.Extensions=ws.get("Extensions").toLong();
                 			}
                 			if(ws.get("Days_Per_Extension") != null && ws.get("Days_Per_Extension").toString() != "")
                 			{
                 				loiRec.Days_Per_Extension=ws.get("Days_Per_Extension").toLong();
                 			}
