										//             * input.Construction_Length.toLong();
										//
										//         addlCost =
										//             addlCost
										//             + cost.Add_l_Cost / numPhases;
										//     }
										//
										// Every month belonging to the same Const_Phase receives the
										// exact same pre-curve addlCost.
										//
										// Therefore calculate it once per actual construction phase.
										// ============================================================
										addlCostByPhase = Map();
										for each  constPhaseValue in constPhaseValues
										{
											phaseAddlCost = 0;
											for each  cost in addlCosts
											{
												if(cost.Start_Phase <= constPhaseValue && cost.End_Phase >= constPhaseValue)
												{
													// ------------------------------------------------
													// EXACT EXISTING PHASE DENOMINATOR
													// ------------------------------------------------
													numPhases = cost.End_Phase - cost.Start_Phase + 1;
													// ------------------------------------------------
													// INTENTIONALLY RETAINED
													//
													// The existing code calculates costSpread even
													// though it does not subsequently use the value.
													//
													// Keeping this evaluation preserves the current
													// Construction_Length.toLong() execution behavior.
													// ------------------------------------------------
													costSpread = numPhases * input.Construction_Length.toLong();
													// ------------------------------------------------
													// EXACT EXISTING ADDITIONAL COST FORMULA
													// ------------------------------------------------
													phaseAddlCost = phaseAddlCost + cost.Add_l_Cost / numPhases;
												}
											}
											// Use a text key for this new internal lookup map only.
											// The actual phase value itself is not altered.
											phaseKey = constPhaseValue.toString();
											addlCostByPhase.put(phaseKey,phaseAddlCost);
										}
										// ============================================================
										// APPLY COSTS TO CONSTRUCTION MONTHS
										//
										// Preserve the exact existing sorted month sequence and rolling
										// construction-curve index.
										// ============================================================
										idx = 0;
										for each  month in mnths
										{
											// --------------------------------------------------------
											// GET PRE-CALCULATED ADDITIONAL COST FOR THIS PHASE
											// --------------------------------------------------------
											phaseKey = month.Const_Phase.toString();
											addlCost = addlCostByPhase.get(phaseKey);
											if(addlCost == null)
											{
												addlCost = 0;
											}
											// --------------------------------------------------------
											// EXISTING PHASE LOT LOOKUP
											//
											// Preserve raw Const_Phase key because phaseLots was built
											// using raw ph.Phase keys in the existing implementation.
											// --------------------------------------------------------
											lots = ifnull(phaseLots.get(month.Const_Phase),0);
											// --------------------------------------------------------
											// EXISTING CURVE INDEX BEHAVIOR
											// --------------------------------------------------------
											pct = 0;
											if(curveSize > 0)
											{
												pct = ifnull(curvePercents.get(idx),0);
											}
											// info lots.toString()
											//     + " - "
											//     + baseCost.toString()
											//     + " - "
											//     + pct.toString();
											// --------------------------------------------------------
											// EXISTING BASE CONSTRUCTION COST
											//
											// Keep .round(2) exactly where it currently occurs.
											// --------------------------------------------------------
											month.Construction_Cost_Base=(lots * baseCost * pct / 100).round(2);
											// --------------------------------------------------------
											// EXISTING ADDITIONAL CONSTRUCTION COST
											//
											// IMPORTANT:
											// Do NOT round this value.
											// Existing code leaves full decimal precision.
											// --------------------------------------------------------
											month.Construction_Cost_Addl=addlCost * pct / 100;
											// --------------------------------------------------------
											// EXISTING CONSTRUCTION OVERHEAD
											//
											// IMPORTANT:
											// - Only write when Construction_Overhead != null.
											// - Do NOT round the result.
											//
											// Also preserve calculation from unrounded base components:
											//
											//     lots * baseCost * pct / 100
											//
											// NOT:
											//
											//     month.Construction_Cost_Base
											//
											// because Construction_Cost_Base has already been rounded.
											// Using the stored rounded field here would subtly change
											// existing Construction_Overhead values.
											// --------------------------------------------------------
											if(input.Construction_Overhead != null)
											{
												month.Construction_Overhead=(lots * baseCost * pct / 100 + addlCost * pct / 100) * input.Construction_Overhead / 100;
											}
											// --------------------------------------------------------
											// EXISTING CURVE INDEX ADVANCEMENT
											// --------------------------------------------------------
											idx = idx + 1;
											// --------------------------------------------------------
											// EXISTING CURVE RESET
											//
											// Leave this outside curveSize > 0.
											//
											// When curveSize == 0:
											//
											//     idx becomes 1
											//     1 >= 0
											//     idx returns to 0
											//
											// That matches existing behavior exactly.
											// --------------------------------------------------------
											if(idx >= curveSize)
											{
												idx = 0;
											}
										}
										info "Const cost successful";
						)
					}
					actions 
					{
						custom deluge script
						(
											// REIMBURSEMENTS (NON IMPACT FEES) USING COST_APPLICATION LOGIC
										reimbList = Proforma_Item[(Pro_Forma_Const == input.ID && Category == "Reimbursements" && Add_l_Cost != null && Add_l_Cost != 0) || (Pro_Forma_Dev == input.ID && Category == "Reimbursements" && Add_l_Cost != null && Add_l_Cost != 0)];
										mnths = Proforma_Months[(Proforma == input.ID && Eng_Phase != null) || (Proforma == input.ID && Const_Phase != null)] sort by Date1;
										phaseEngEnd = Map();
										phaseConstStart = Map();
										phaseConstEnd = Map();
										allPhases = Proforma_Phase[Pro_Forma == input.ID];
										for each  phz in allPhases
										{
											if(phz.Phase != null)
											{
												if(phz.Eng_End_Month != null)
												{
													phaseEngEnd.put(phz.Phase.toString(),phz.Eng_End_Month.toLong());
												}
												if(phz.Const_Start_Month != null)
												{
													phaseConstStart.put(phz.Phase.toString(),phz.Const_Start_Month.toLong());
												}
												if(phz.Const_End_Month != null)
												{
													phaseConstEnd.put(phz.Phase.toString(),phz.Const_End_Month.toLong());
												}
											}
										}
										hasSpecific = false;
										for each  chk in reimbList
										{
											if(chk.Cost_Application == "Specific Months" && chk.Item_Name.contains("Impact Fees") == false)
											{
												hasSpecific = true;
											}
										}
										if(reimbList.count() > 0)
										{
											for each  month in mnths
											{
												engPhaseNo = month.Eng_Phase;
												constPhaseNo = month.Const_Phase;
												reimbAddl = 0;
												for each  reimb in reimbList
												{
													if(reimb.Item_Name.contains("Impact Fees") == false)
													{
														/***********************
														 * ENGINEERING MONTH LOGIC
														 ***********************/
														if(engPhaseNo != null)
														{
															// ACROSS PHASES: spread across ALL ENG months in phases range
															if(reimb.Cost_Application == "Across Phases" && reimb.Start_Phase <= engPhaseNo && reimb.End_Phase >= engPhaseNo)
															{
																numPhases = reimb.End_Phase - reimb.Start_Phase + 1;
																costSpread = numPhases * input.Engineering_Length_Months.toLong();
																reimbAddl = reimbAddl + reimb.Add_l_Cost / costSpread;
															}
