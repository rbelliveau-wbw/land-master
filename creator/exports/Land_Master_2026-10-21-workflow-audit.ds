                 		page = page + thisapp.PF_PDF_Text(700,651,9,"bold",white,"DEVELOPMENT ADD'L COSTS");
                 		page = page + thisapp.PF_PDF_Text(924,651,10,"bold",white,thisapp.PF_Packet_Money(developmentAdditionalTotal.toString()));
                 		page = page + thisapp.PF_PDF_Rect(688,44,316,228,white,line,0.35);
