	  			workflow = Contract_Window
				show action in edit record menu = true
				)
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '17px'\n	paddingLeft = '17px'\n	paddingRight = '17px'\n	paddingBottom = '0px'\n\n		width = '100%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n	\n	color = '#10BE4B'\n	width = '40px'\n	height = '40px'\n	type = 'icon'\n	value = 'ui-1-calendar-grid-58'\n	size = '16px'\n	cornerRadius = '0px'\n	iconType = 'solid'\n/>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '20px'\n\n		width = '100%'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '10px'\n	marginBottom = '0px'\n	marginTop = '2px'\n	color = '#10BE4B'\n	size = '16px'\n	bold = 'true' \n	type = 'field'\n\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Contract_Name'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '15px'\n	color = '#132437'\n	size = '15px'\n	type = 'field'\n\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Number_of_Lots'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '6px'\n	color = '#132437'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n\n    lineHeight = '27'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Initial_Takedown'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '15px'\n	paddingLeft = '0px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n\n		width = '50%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<text \n\n	marginTop = '0px'\n	color = '#168868'\n	size = '15px'\n	type = 'field'\n\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Subsequent_Takedown_Lots'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '15px'\n	paddingLeft = '10px'\n	paddingRight = '0px'\n	paddingBottom = '0px'\n\n		width = '50%'\n		hAlign = 'right'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n		width = '100%'\n		hAlign = 'right'\n		vAlign = 'top'\n>\n	<text \n\n	marginTop = '0px'\n	color = '#168868'\n	size = '15px'\n	type = 'field'\n\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Subsequent_Takedown_Days'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
				template
	 			(
