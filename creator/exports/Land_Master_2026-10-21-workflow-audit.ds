										html = html + "<span class='ca-date-value'>" + completeDateText + "</span>";
										html = html + "</div>";
										html = html + "</div>";
										html = html + "</div>";
										html = html + "<div class='ca-note'>Add notes and mark complete below.</div>";
										html = html + "</div>";
										html = html + "</div>";
										input.Action_Summary_HTML = html;
						)
					}
				}

			}
