						custom deluge script
						(
											input.plain = "<div><style>.form-group.clearfix.zc-Buttons-group.zc-radio-field-group{width:auto!important;margin-left:0!important;margin-bottom:18px!important;}.zc-Buttons-label,.zc-Buttons-group>label.form-label,#zc-Buttons-arialabel{display:none!important;}[name=\"parentOf-Buttons\"]{width:auto!important;}.zc-Buttons-group .form-field .tempContDiv{border:none!important;padding:0!important;margin:0 0 18px 0!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row{display:inline-block!important;vertical-align:middle!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row div.choice-table-cell{display:block!important;text-align:center!important;width:100%!important;padding:0!important;margin:0!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row .customRadio+label{display:none!important;}[name=\"Buttons\"]{display:none!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row .choice-table-cell span label.choice-label-text{display:inline-flex!important;align-items:center!important;justify-content:center!important;text-align:center!important;min-width:108px!important;height:38px!important;white-space:nowrap!important;background:#0345ad!important;color:#ffffff!important;border:1px solid #2f67c7!important;border-radius:6px!important;padding:0 16px!important;margin:0!important;font-size:14px!important;font-weight:600!important;line-height:38px!important;letter-spacing:0!important;box-sizing:border-box!important;box-shadow:0 2px 6px rgba(0,0,0,0.14)!important;transition:all .2s ease!important;vertical-align:middle!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row .choice-table-cell span label.choice-label-text:hover{background:#023b92!important;border-color:#3f7ae0!important;box-shadow:0 4px 10px rgba(0,0,0,0.2)!important;cursor:pointer!important;transform:translateY(-1px)!important;}.zc-Buttons-group .form-field .tempContDiv .choice-table-row .choice-table-cell span .customRadio:checked ~ label.choice-label-text{background:#022f73!important;border-color:#022f73!important;color:#ffffff!important;box-shadow:0 3px 8px rgba(0,0,0,0.24)!important;transform:none!important;}input.zc-live-primary-btn,input.zc-live-secondary-btn,.zc-live-primary-btn,.zc-live-secondary-btn{display:none!important;}</style></div>";
						)
					}
				}

