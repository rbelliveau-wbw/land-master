										property = "";
										project = "";
										subdivision = "";
										lot = "";
										reportName1 = "All_Tax_Parcel_Years?";
										reportName2 = "All_Tax_Parcel_Year_Lines?";
										if(input.Code != "")
										{
											taxparcelCode = "&Tax_Parcel_Year_Code=" + input.Code + "&Tax_Parcel_Year_Code_op=26";
											taxparcelCode2 = "&Tax_Parcel_Year=" + input.Code + "&Tax_Parcel_Year_op=26";
										}
										if(input.Tax_Year != "")
										{
											taxYear = "&Tax_Year=" + input.Tax_Year;
										}
										if(input.Taxing_Jurisdiction2.isEmpty() = false)
										{
											taxJurisdiction1 = "&Taxing_Jurisdiction2=[" + Taxing_Jurisdiction[ID == input.Taxing_Jurisdiction2].Jurisdiction_Name.getAll() + "]";
											taxJurisdiction2 = "&Tax_Rate1=[" + Tax_Rate[Taxing_Jurisdiction2 == input.Taxing_Jurisdiction2].Tax_Rate_Name.getAll() + "]";
										}
										if(input.Tax_Rate1.isEmpty() = false)
										{
											taxJurisdiction1 = "&Tax_Rates=[" + Tax_Rate[ID == input.Tax_Rate1].Tax_Rate_Name.getAll() + "]";
											taxJurisdiction2 = "&Tax_Rate1=[" + Tax_Rate[ID == input.Tax_Rate1].Tax_Rate_Name.getAll() + "]";
										}
										if(input.Property1.isEmpty() = false)
										{
											property = "&Property1=[" + Property[ID == input.Property1].Common_Name.getAll() + "]";
										}
										if(input.Project1.isEmpty() = false)
										{
											project = "&Subdivision1=[" + Subdivision[Project == input.Project1].Subdivision_Name.getAll() + "]";
										}
										if(input.Status.isEmpty() = false)
										{
											status = "&Appeal_Status=[" + input.Status + "]";
										}
										if(input.Subdivision1.isEmpty() = false)
										{
											project = "&Subdivision1=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
										}
										if(input.Lot.isEmpty() = false)
										{
											lot = "&Lot=[" + Lots[ID == input.Lot].Lot_Code.getAll() + "]";
										}
										report1Url = zoho.appuri + "view-embed/" + reportName1;
										report2Url = zoho.appuri + "view-embed/" + reportName2;
										query1Url = report1Url + taxparcelCode + taxYear + taxJurisdiction1 + property + project + lot + status;
										query2Url = report2Url + taxparcelCode2 + taxYear + taxJurisdiction2 + property + project + lot + status;
										openUrl(query1Url,"iframe","frame16");
										openUrl(query2Url,"iframe","frame17");
						)
					}
				}

			}
