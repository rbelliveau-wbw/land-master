			Create_Approval_Rows_Pro_ as "Create Approval Rows - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Add this to Add_Pro_Forma -> On Success.
										// STRICT DUPLICATE GUARD:
										// - If this Pro Forma already has ANY Budget_Approvals rows, this does nothing.
										// - Only a Pro Forma with zero existing approval rows receives the four rows.
										// Replace the four email constants below with the production recipients.
										vpEmail = "VP_EMAIL@wbdevelopment.com";
										legalEmail = "legal@wbdevelopment.com";
										cfoEmail = "jking@wbdevelopment.com";
										cooEmail = "dreinke@wbdevelopment.com";
										ceoEmail = "bruce@wbdevelopment.com";
										existingRows = Budget_Approvals[Proforma == input.ID];
										if(existingRows.count() == 0)
										{
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="VP"
												Approver=vpEmail
												Sort_Order=1
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="Legal"
												Approver=legalEmail
												Sort_Order=2
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="CFO"
												Approver=cfoEmail
												Sort_Order=3
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="COO"
												Approver=cooEmail
												Sort_Order=4
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="CEO"
												Approver=ceoEmail
												Sort_Order=5
												Status="Not Sent"
												Type1="Pro Forma"
											]
										}
						)
					}
				}

			}
