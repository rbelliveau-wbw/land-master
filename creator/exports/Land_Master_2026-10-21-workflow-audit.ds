										// ============================================================
										constPhaseValues = List();
										for each  month in mnths
										{
											constPhaseValue = month.Const_Phase;
											if(constPhaseValues.contains(constPhaseValue) == false)
											{
												constPhaseValues.add(constPhaseValue);
											}
										}
										// ============================================================
										// PRE-CALCULATE ADDITIONAL COST BY CONSTRUCTION PHASE
										//
										// Existing formula:
										//
										//     if(
										//         cost.Start_Phase <= month.Const_Phase
										//         &&
										//         cost.End_Phase >= month.Const_Phase
										//     )
										//     {
										//         numPhases =
										//             cost.End_Phase
										//             - cost.Start_Phase
										//             + 1;
										//
										//         costSpread =
