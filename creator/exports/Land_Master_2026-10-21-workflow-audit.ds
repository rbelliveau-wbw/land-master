										x = x + ".zc-Buttons-group .form-field .tempContDiv .choice-table-row .choice-table-cell span .customRadio:checked ~ label.choice-label-text{background:#16a34a !important;border-color:#16a34a !important;box-shadow:0 14px 22px rgba(22,163,74,0.32) !important;transform:none !important;}";
