                 	// =======================================================
                 	// GLOBAL: Apply the DONE/Complete decision-box styling to ALL decision boxes
                 	// Put this VERY END of your <style> so it overrides everything.
                 	// =======================================================
                 	// 1) Center the decision box control everywhere it appears
                 	x = x + ".decision-box-field.form-field{display:flex!important;align-items:center!important;justify-content:center!important;float:none!important;margin:0!important;min-height:32px!important;position:relative!important;}";
