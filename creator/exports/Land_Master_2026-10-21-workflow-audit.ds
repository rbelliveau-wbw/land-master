                 					auditFailed = 0;
                 				}
                 				else if(auditDataWritten)
                 				{
                 					auditStatus = "Partial";
                 				}
                 				if(auditWarning != "")
                 				{
                 					auditStatus = "Partial";
                 					auditFailed = 1;
