    				type = tooltip
    			 	message = "Only select multiple Subdivisions here if the Builder has a contract that spans multiple Subdivisions within the same Project."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
