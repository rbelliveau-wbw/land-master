		page Lot_Management(search, search_results)
		{
			displayname = "Lot Management"
			Content="<zml    \t\t\n\t\t\n\t\t\tbgColor='#819BEC'\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='35%'\n   \t>\n\t<form \n\telementName='Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Lot_Search'\n\theightType = 'custom'\n\theightValue = '625'\n\turlType = 'none'\n\tzc_Header = 'false'\n/> \n</column><column\n   \t\t width='65%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet 2'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n\t\t.queue_embed_iframe\n\t\t{\n\t\t\twidth:100%;\n\t\t\theight:620px;\n\t\t\tborder:none;\n\t\t\tmargin:0;\n\t\t\tpadding:0;\n\t\t\tdisplay:block;\n\t\t\tbackground:transparent;\n\t\t}\n\t&lt;/style&gt;\n\n\t&lt;iframe\n\t\tclass=&quot;queue_embed_iframe&quot;\n\t\tname=&apos;queueFrame&apos;\n\t\tsrc=&quot;&lt;%=zoho.appuri%&gt;page-embed/Queue_Live_Embed&quot;&gt;\n\t&lt;/iframe&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div&gt; \t\n&lt;iframe name=&apos;frame16&apos; allowTransparency=&apos;false&apos;  style=&quot;box-sizing:border-box; width:100%; height:1000px; border: 2px solid LightSkyBlue&quot; src=&apos;&lt;%=zoho.appuri%&gt;view-embed/All_Active_Lots_List_View?&apos;&gt;&lt;/iframe&gt;    \n &lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
