			Field_Validations_Contrac as "Field Validations - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Contract / on add or edit / on validate. New construction inputs stay optional
										// in Creator; required input checks are confined to the construction widget.
										constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
										storedRequest = Contract[ID == input.ID];
										requestMode = ifnull(input.Work_Module,"");
										if(requestMode == "")
										{
											requestMode = "Legal";
										}
										if(requestMode != "Legal" && requestMode != "Construction")
										{
											alert "Choose Legal or Construction for Work Module.";
											cancel submit;
										}
										if(storedRequest.count() > 0)
										{
											storedMode = ifnull(storedRequest.Work_Module,"");
											if(storedMode == "")
											{
												storedMode = "Legal";
											}
											if(requestMode != storedMode)
											{
												alert "An existing request cannot be moved between Legal and Construction.";
												cancel submit;
											}
										}
										constructionTypes = {"Internal","Offsite","Amenity","MUD Bid"};
										if(requestMode == "Construction")
										{
											constructionEditor = thisapp.hasConstructionPermission(zoho.loginuser,true);
											constructionSubmitter = thisapp.hasConstructionPermission(zoho.loginuser,false);
											if(storedRequest.count() > 0)
											{
												if(constructionEditor != true)
												{
													alert "Edit All Construction Requests permission is required to change a submitted request.";
													cancel submit;
												}
												if(ifnull(storedRequest.Status,"") == "Complete")
												{
													alert "This construction request is complete and read-only.";
													cancel submit;
												}
											}
											else
											{
												if(constructionEditor != true && constructionSubmitter != true)
												{
													alert "Submit Construction Requests or Edit All Construction Requests permission is required.";
													cancel submit;
												}
												// Submit-only users cannot bypass the construction Review queue.
												input.Status = "Proposed";
												submittedActionCount = 0;
												for each  submittedAction in input.Contract_Actions
												{
													submittedActionCount = submittedActionCount + 1;
												}
												if(constructionEditor != true && submittedActionCount > 0)
												{
													alert "Construction task lists are added by the construction reviewer.";
													cancel submit;
												}
											}
											if(input.Contract_Type != null && !constructionTypes.contains(input.Contract_Type))
											{
												alert "Choose a construction Budget Type.";
												cancel submit;
											}
											if(input.Subdivision1 != null && input.Subdivision1.size() > 1)
											{
												alert "Choose one Subdivision for a construction request.";
												cancel submit;
											}
											// Derive request scope from the selected Subdivision, including API writes.
											for each  requestSubdivisionId in input.Subdivision1
											{
												requestSubdivision = Subdivision[ID == requestSubdivisionId];
												if(requestSubdivision.count() == 0)
												{
													alert "The selected Subdivision is unavailable.";
													cancel submit;
												}
												input.Project = requestSubdivision.Project;
												input.Company_Entity = requestSubdivision.Company1;
												input.County = requestSubdivision.County;
												input.City = requestSubdivision.City;
												input.Territory = requestSubdivision.Territory;
												requestProject = Project[ID == requestSubdivision.Project];
												if(input.Territory == null || input.Territory == "")
												{
													if(requestProject.count() > 0)
													{
														input.Territory = requestProject.Territory;
													}
												}
											}
											submittedApprovalCount = 0;
											for each  submittedApproval in input.Approvals1
											{
												submittedApprovalCount = submittedApprovalCount + 1;
											}
											if(submittedApprovalCount > 0)
											{
												alert "Construction requests do not use Legal contract approvals.";
												cancel submit;
											}
											// Linked actions inherit the parent's module and budget type.
											for each  constructionAction in input.Contract_Actions
											{
												constructionAction.Work_Module="Construction";
												constructionAction.Type_field=input.Contract_Type;
												constructionAction.Template_Action=false;
											}
										}
										else if(constructionBudgetingProfile)
										{
											alert "This profile can only create or edit Construction requests.";
											cancel submit;
										}
										else if(constructionTypes.contains(input.Contract_Type))
										{
											alert "Construction Budget Types require Construction Work Module.";
											cancel submit;
										}
										isLotRequest = input.Contract_Type == "Lot" || input.Contract_Type == "Lot (Master)" || input.Contract_Type == "Lot (Amendment)";
										if(isLotRequest)
										{
											if(input.Builder == null)
											{
												alert "Lot contracts must have a Builder / Counterparty selection.";
												cancel submit;
											}
										}
										if(input.Contract_Type == "Lot (Amendment)" && input.Subdivision1.size() == 0)
										{
											alert "Lot (Amendment) must have a Subdivision selection.";
											cancel submit;
										}
										if(input.Parent_Contract != null)
										{
											parentContract = Contract[ID == input.Parent_Contract];
											if(parentContract.count() == 0 || parentContract.ID == input.ID || parentContract.Parent_Contract != null)
											{
												alert "Choose a top-level Parent Contract. A contract cannot be its own parent.";
												cancel submit;
											}
											parentMode = ifnull(parentContract.Work_Module,"");
											if(parentMode == "")
											{
												parentMode = "Legal";
											}
											if(parentMode != requestMode)
											{
												alert "The parent request must be in the same Work Module.";
												cancel submit;
											}
											if(input.ID != null)
											{
												childContracts = Contract[Parent_Contract == input.ID];
												if(childContracts.count() > 0)
												{
													alert "A Master with child contracts cannot be assigned a parent.";
													cancel submit;
												}
											}
											if(input.Contract_Type == "Lot (Amendment)")
											{
												parentIsLotMaster = parentContract.Contract_Type == "Lot (Master)" || parentContract.Contract_Type == "Lot";
												if(parentIsLotMaster != true || parentContract.Builder != input.Builder || parentContract.Project != input.Project)
												{
													alert "The optional parent must be a Lot (Master) with the same Project and Builder / Counterparty.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
			Check_if_Exceed_Available as "Check if Exceed Available Lots - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											totalFclotcount = 0;
										availLots = Lots[Subdivision == input.Subdivision1 && Purchase_Date == null].count(Lot_Code);
										firstThismonth = zoho.currentdate.toStartOfMonth();
										for each  fc in input.Forecast_Months
										{
											if(fc.Forecasted_Lots != null && fc.Forecast_Start_Date >= firstThismonth)
											{
												fcLotcount = fc.Forecasted_Lots;
												totalFclotcount = totalFclotcount + fcLotcount;
											}
										}
										if(totalFclotcount > availLots)
										{
											alert "Forecasted lots for current and future months (" + totalFclotcount + ") currently exceed number of available lots (" + availLots + ") in " + input.Subdivision1.Subdivision_Name + ". \n  \n Press OK to proceed.";
										}
						)
					}
				}

			}
			Search_Type_Contracts_Mgm as "Search Type - Contracts Mgmt"
			{
				type =  form
				form = Contracts_Management_Search

				record event = on add or edit

				on user input of Type1
				{
					actions 
					{
						custom deluge script
						(
											lotBuyer = "";
										lotBuilder = "";
										contType = "";
										lotStatus = "";
										lotCity = "";
										lotCounty = "";
										subdivName = "";
										subdivName2 = "";
										subdivName3 = "";
										basePrice = "";
										lotNo = "";
										block = "";
										monthName = "";
										monthNum = "";
										monthSearch = "";
										specDate = "";
										monthQuery = "";
										reportName1 = "All_Contracts_v2?";
										reportName2 = "All_Contracts?";
										reportName3 = "All_Takedown_Schedules?";
										if(input.Builder1.isEmpty() = false)
										{
											lotBuyer = "&&Builder1=[" + Builder[ID == input.Builder1].Builder_Name.getAll() + "]";
											lotBuilder = "&&Builder=[" + Builder[ID == input.Builder1].Builder_Name.getAll() + "]";
											info lotBuilder;
										}
										if(input.Status.isEmpty() = false)
										{
											lotStatus = "&&Status=[" + input.Status + "]";
										}
										if(input.Block.isEmpty() = false)
										{
											block = "&&Block=[" + input.Block + "]";
										}
										if(input.Subdivision.isEmpty() = false)
										{
											subdivName = "&&Subdivision=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
											subdivName2 = "&&Subdivision1=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
											subdivName3 = "&&Subdivisions=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
										}
										if(input.Type1.isEmpty() = false)
										{
											contType = "&&Contract_Type=[" + input.Type1 + "]";
										}
										lotsUrl1 = zoho.appuri + "view-embed/" + reportName1;
										lotsUrl2 = zoho.appuri + "view-embed/" + reportName2;
										lotsUrl3 = zoho.appuri + "view-embed/" + reportName3;
										queryUrl1 = lotsUrl1 + contType + lotBuilder + subdivName2;
										queryUrl2 = lotsUrl2 + contType + lotBuilder + subdivName2;
										queryUrl3 = lotsUrl3 + lotBuyer + subdivName3;
										openUrl(queryUrl1,"iframe","frame16");
										openUrl(queryUrl2,"iframe","frame09");
										//openUrl(queryUrl3,"iframe","frame10");
						)
					}
				}

			}
			Lot_Contract_Required_Fie as "Lot Contract Required Fields - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											isLotContract = input.Contract_Type == "Lot" || input.Contract_Type == "Lot (Master)" || input.Contract_Type == "Lot (Amendment)";
										hasLotScope = input.Subdivision1.size() > 0 || input.Lots1.size() > 0;
										if(isLotContract && hasLotScope)
										{
											// Compare only lot terms so pricing, files and type edits preserve legacy terms.
											termsChanged = true;
											if(input.ID != null)
											{
												oldContract = Contract[ID == input.ID];
												if(oldContract.count() > 0)
												{
													termsChanged = oldContract.Number_of_Lots != input.Number_of_Lots || oldContract.Initial_Takedown != input.Initial_Takedown || oldContract.Initial_Takedown_Days != input.Initial_Takedown_Days || oldContract.Second_Closing_Lots != input.Second_Closing_Lots || oldContract.Second_Closing_Days != input.Second_Closing_Days || oldContract.Subsequent_Takedown_Lots != input.Subsequent_Takedown_Lots || oldContract.Subsequent_Takedown_Days != input.Subsequent_Takedown_Days;
												}
											}
											hasSecond = input.Second_Closing_Lots != null || input.Second_Closing_Days != null;
											if(termsChanged || hasSecond)
											{
												if(input.Second_Closing_Lots == null || input.Second_Closing_Lots <= 0 || input.Second_Closing_Days == null || input.Second_Closing_Days < 0)
												{
													alert "Enter positive whole Second Closing lots and Second Closing days of zero or more.";
													cancel submit;
												}
												cadenceTerms = Map();
												cadenceTerms.put("Total_Lot_Obligation",input.Number_of_Lots);
												cadenceTerms.put("Initial_Takedown",input.Initial_Takedown);
												cadenceTerms.put("Initial_Due_Offset_Days",input.Initial_Takedown_Days);
												cadenceTerms.put("Second_Closing_Lots",input.Second_Closing_Lots);
												cadenceTerms.put("Second_Closing_Days",input.Second_Closing_Days);
												cadenceTerms.put("Continued_Takedown",input.Subsequent_Takedown_Lots);
												cadenceTerms.put("Continued_Takedown_Delay_Days",input.Subsequent_Takedown_Days);
												cadenceTerms.put("Elapsed_Days",0);
												cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
												if(cadence.get("ok") != true)
												{
													alert cadence.get("message");
													cancel submit;
												}
											}
											recurringRequired = !hasSecond || ifnull(input.Number_of_Lots,0) > ifnull(input.Initial_Takedown,0) + ifnull(input.Second_Closing_Lots,0);
											if(hasSecond && recurringRequired)
											{
												if(ifnull(input.Subsequent_Takedown_Lots,0) <= 0 || ifnull(input.Subsequent_Takedown_Days,0) <= 0)
												{
													alert "Enter positive Subsequent Closing lots and days while lots remain.";
													cancel submit;
												}
											}
											if(input.Status == "Complete")
											{
												missingInitial = input.Number_of_Lots == null || input.Initial_Takedown == null || input.Initial_Takedown_Days == null;
												missingRecurring = false;
												if(recurringRequired)
												{
													missingRecurring = input.Subsequent_Takedown_Lots == null || input.Subsequent_Takedown_Days == null;
												}
												if(missingInitial || missingRecurring)
												{
													alert "Please add all Lot Closing details before moving to Complete.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
