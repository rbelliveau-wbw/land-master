				Contract1 as "Contract"
				Contract_Schedule as "Contract Schedule"
			)
			filters
			(
				Close_Date
			)
			group by
			(
				Subdivision ascending
			)
			sort by
			(
				Lot_Code ascending
			)
			custom actions
			(
				"Create Builder Takedown"
				(
	  			workflow = Create_Builder_Takedown_L
				show action in view header = true
				execute action for collection of records
				)
				"Mass Update"
				(
	  			workflow = Mass_Update_List_View1
				show action in view header = true
				execute action for collection of records
				)
				"Create Contract"
				(
	  			workflow = Create_Contract
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				condition = (Status != "Sold" && Lot_Size is not null)
				confirmation before execution
				(
					message for multiple records = "Create Contract with the selected ${record_count} Lots?\n\nNote - All Lots must have a Lot Size and cannot have Status of Sold."
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
			conditional formatting
			(
				"On Hold"
				{
				condition = (On_Hold == true)
				fields = [Lot_Code]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'rgba(0, 0, 0, 0)'\n\n    lineHeight = '27'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Lot_Code'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
