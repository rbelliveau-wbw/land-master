                 				Month1=if(ifnull(r.get("Month1"),"") == "","0",r.get("Month1").toString()).toLong()
                 				Percent1=if(ifnull(r.get("Percent1"),"") == "","0",r.get("Percent1").toString()).toDecimal()
                 				Cost=if(ifnull(r.get("Cost"),"") == "","0",r.get("Cost").toString()).toDecimal()
                 				Type1="PID/MUD"
                 				Date1=instDate
                 				Pro_Forma_PID_MUD=pfKey
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 		itemIds = List();
                 		for each  itemGrC in pf.Additional_Costs_Construction
                 		{
                 			if(itemGrC.Template_Item != true)
                 			{
                 				itemIds.add(itemGrC.ID.toLong());
                 			}
                 		}
                 		for each  itemGrD in pf.Additional_Costs_Development
                 		{
                 			if(itemGrD.Template_Item != true)
                 			{
                 				itemIds.add(itemGrD.ID.toLong());
                 			}
                 		}
                 		for each  iid in itemIds
                 		{
                 			delete from Proforma_Item[ID == iid];
                 		}
                 		for each  r in ifnull(data.get("items"),List())
                 		{
                 			dept = ifnull(r.get("Department"),"").toString();
                 			if(dept == "Construction")
                 			{
                 				insert into Proforma_Item
                 				[
                 					Item_Name=r.get("Item_Name")
                 					Category=r.get("Category")
                 					Department=r.get("Department")
                 					Cost_Code=r.get("Cost_Code")
                 					Dept_Code=r.get("Dept_Code")
                 					Unit=ifnull(r.get("Unit"),"")
                 					Per_Unit=if(ifnull(r.get("Per_Unit"),"") == "","0",r.get("Per_Unit").toString()).toDecimal()
                 					Add_l_Cost=if(ifnull(r.get("Add_l_Cost"),"") == "","0",r.get("Add_l_Cost").toString()).toDecimal()
                 					Cost_Application=r.get("Cost_Application")
                 					Start_Phase=if(ifnull(r.get("Start_Phase"),"") == "","0",r.get("Start_Phase").toString()).toLong()
                 					End_Phase=if(ifnull(r.get("End_Phase"),"") == "","0",r.get("End_Phase").toString()).toLong()
                 					Start_Month=if(ifnull(r.get("Start_Month"),"") == "","0",r.get("Start_Month").toString()).toLong()
                 					End_Month=if(ifnull(r.get("End_Month"),"") == "","0",r.get("End_Month").toString()).toLong()
                 					Specific_Months_List=ifnull(r.get("Specific_Months_List"),"")
