		}
		page Proforma_Approval_Response(string action1, string approvalId, string approvalNote, string submit1)
		{
			displayname = "Pro Forma Approval Response"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\t// =========================================================\n\t// PUBLIC PRO FORMA APPROVAL RESPONSE\n\t//\n\t// PAGE VARIABLES:\n\t// - approvalId\n\t// - action1\n\t// - approvalNote\n\t// - submit1\n\t// =========================================================\n\tpublishedPageUrl = &quot;https://creatorapp.zohopublic.com/wbdevelopment/land-master/page-perma/Proforma_Approval_Response/SKynkNA9rksmmQtUQYmxGddr0T8zzRkPET48ymuwzpZjjzGeygeb6pQTxqKZT4HwjrSWq1pFZCry2qsyeFZbpZ9v1RA1AUFrQYAE&quot;;\n\tapprovalIdText = &quot;&quot;;\n\taction1Text = &quot;&quot;;\n\tapprovalNoteText = &quot;&quot;;\n\tsubmit1Text = &quot;&quot;;\n\tif(input.approvalId != null)\n\t{\n\t\tapprovalIdText = input.approvalId.toString().trim();\n\t}\n\tif(input.action1 != null)\n\t{\n\t\taction1Text = input.action1.toString().trim();\n\t}\n\tif(input.approvalNote != null)\n\t{\n\t\tapprovalNoteText = input.approvalNote.toString().trim();\n\t}\n\tif(input.submit1 != null)\n\t{\n\t\tsubmit1Text = input.submit1.toString().trim();\n\t}\n\taction1Lower = action1Text.toLowerCase();\n\tpageState = &quot;invalid&quot;;\n\tsuccessMsg = &quot;&quot;;\n\terrorMsg = &quot;&quot;;\n\thasApproval = false;\n\thasProforma = false;\n\tapprovalIdLong = 0;\n\tproformaIdLong = 0;\n\tapprovalRole = &quot;&quot;;\n\tapproverEmail = &quot;&quot;;\n\tapprovalStatus = &quot;&quot;;\n\tapprovalSortOrder = 0;\n\tpfName = &quot;Pro Forma&quot;;\n\tpfStatus = &quot;&quot;;\n\tpfStage = &quot;&quot;;\n\tpfTerritory = &quot;&quot;;\n\tsellerValue = &quot;\u2014&quot;;\n\tbuyingEntityValue = &quot;\u2014&quot;;\n\tpropertyValue = &quot;\u2014&quot;;\n\tacresValue = &quot;\u2014&quot;;\n\tpricePerAcreValue = &quot;\u2014&quot;;\n\testimatedPriceValue = &quot;\u2014&quot;;\n\tearnestMoneyValue = &quot;\u2014&quot;;\n\tfeasibilityValue = &quot;\u2014&quot;;\n\tclosingValue = &quot;\u2014&quot;;\n\textensionsValue = &quot;\u2014&quot;;\n\tresponseDateValue = &quot;\u2014&quot;;\n\teffectiveDateValue = &quot;\u2014&quot;;\n\tbuyerBrokerValue = &quot;\u2014&quot;;\n\tsellerBrokerValue = &quot;\u2014&quot;;\n\tacquisitionEmailValue = &quot;\u2014&quot;;\n\tspecialProvisionsValue = &quot;&quot;;\n\tcontextNote = &quot;&quot;;\n\tcontextNoteLabel = &quot;&quot;;\n\tchainRows = List();\n\tif(approvalIdText != &quot;&quot;)\n\t{\n\t\ttry \n\t\t{\n\t\t\tapprovalIdLong = approvalIdText.toLong();\n\t\t\tapprovalRow = Budget_Approvals[ID == approvalIdLong];\n\t\t\tif(approvalRow.ID != null &amp;&amp; approvalRow.Proforma != null)\n\t\t\t{\n\t\t\t\thasApproval = true;\n\t\t\t\tproformaIdLong = approvalRow.Proforma.toString().toLong();\n\t\t\t\tpf = Add_Pro_Forma[ID == proformaIdLong];\n\t\t\t\tif(pf.ID != null)\n\t\t\t\t{\n\t\t\t\t\thasProforma = true;\n\t\t\t\t\t// =================================================\n\t\t\t\t\t// APPROVE IMMEDIATELY WHEN APPROVE LINK OPENS\n\t\t\t\t\t// =================================================\n\t\t\t\t\tif(action1Lower == &quot;approve&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tif(approvalRow.Status == &quot;Pending&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tapprovalResult = thisapp.Handle_Proforma_Approval_Action(proformaIdLong.toString(),approvalIdLong.toString(),&quot;Approved&quot;,&quot;&quot;);\n\t\t\t\t\t\t\tif(ifnull(approvalResult.get(&quot;success&quot;),false) == true)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tpageState = &quot;approved&quot;;\n\t\t\t\t\t\t\t\tsuccessMsg = ifnull(approvalResult.get(&quot;message&quot;),&quot;Your approval was recorded.&quot;).toString();\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tpageState = &quot;error&quot;;\n\t\t\t\t\t\t\t\terrorMsg = ifnull(approvalResult.get(&quot;message&quot;),&quot;The approval could not be processed.&quot;).toString();\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tpageState = &quot;completed&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t// =================================================\n\t\t\t\t\t// DENY PAGE / DENIAL SUBMISSION\n\t\t\t\t\t// =================================================\n\t\t\t\t\telse if(action1Lower == &quot;deny&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tif(approvalRow.Status != &quot;Pending&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tpageState = &quot;completed&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(submit1Text == &quot;true&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(approvalNoteText == &quot;&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tpageState = &quot;deny&quot;;\n\t\t\t\t\t\t\t\terrorMsg = &quot;Enter a note explaining what needs to be changed.&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tdenyResult = thisapp.Handle_Proforma_Approval_Action(proformaIdLong.toString(),approvalIdLong.toString(),&quot;Rejected&quot;,approvalNoteText);\n\t\t\t\t\t\t\t\tif(ifnull(denyResult.get(&quot;success&quot;),false) == true)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tpageState = &quot;denied&quot;;\n\t\t\t\t\t\t\t\t\tsuccessMsg = ifnull(denyResult.get(&quot;message&quot;),&quot;Your rejection was recorded.&quot;).toString();\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tpageState = &quot;deny&quot;;\n\t\t\t\t\t\t\t\t\terrorMsg = ifnull(denyResult.get(&quot;message&quot;),&quot;The rejection could not be processed.&quot;).toString();\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tpageState = &quot;deny&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tpageState = &quot;invalid&quot;;\n\t\t\t\t\t\terrorMsg = &quot;The approval action is missing or invalid.&quot;;\n\t\t\t\t\t}\n\t\t\t\t\t// =================================================\n\t\t\t\t\t// RELOAD CURRENT APPROVAL AND PRO FORMA\n\t\t\t\t\t// =================================================\n\t\t\t\t\tapprovalRow = Budget_Approvals[ID == approvalIdLong];\n\t\t\t\t\tpf = Add_Pro_Forma[ID == proformaIdLong];\n\t\t\t\t\tapprovalRole = ifnull(approvalRow.Title,&quot;Approver&quot;).toString();\n\t\t\t\t\tapproverEmail = ifnull(approvalRow.Approver,&quot;&quot;).toString();\n\t\t\t\t\tapprovalStatus = ifnull(approvalRow.Status,&quot;Not Sent&quot;).toString();\n\t\t\t\t\tapprovalSortOrder = ifnull(approvalRow.Sort_Order,0);\n\t\t\t\t\tpfName = ifnull(pf.Name,&quot;Pro Forma #&quot; + proformaIdLong.toString()).toString();\n\t\t\t\t\tpfStatus = ifnull(pf.Status,&quot;Draft&quot;).toString();\n\t\t\t\t\tpfStage = ifnull(pf.Probability,&quot;\u2014&quot;).toString();\n\t\t\t\t\tpfTerritory = ifnull(pf.Territory,&quot;\u2014&quot;).toString();\n\t\t\t\t\t// =================================================\n\t\t\t\t\t// LOAD SAVED LOI WORKSHEET / SELLERS / PROPERTIES\n\t\t\t\t\t// =================================================\n\t\t\t\t\tloiContext = thisapp.PF_Get_Proforma_LOI_Snapshot(proformaIdLong.toString());\n\t\t\t\t\tif(ifnull(loiContext.get(&quot;success&quot;),false) == true)\n\t\t\t\t\t{\n\t\t\t\t\t\tsellerValue = ifnull(loiContext.get(&quot;seller&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tbuyingEntityValue = ifnull(loiContext.get(&quot;buyingEntity&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tpropertyValue = ifnull(loiContext.get(&quot;property&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tacresValue = ifnull(loiContext.get(&quot;totalAcres&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tpricePerAcreValue = ifnull(loiContext.get(&quot;amountPerAcre&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\testimatedPriceValue = ifnull(loiContext.get(&quot;estimatedPrice&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tearnestMoneyValue = ifnull(loiContext.get(&quot;earnestMoney&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tfeasibilityValue = ifnull(loiContext.get(&quot;feasibility&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tclosingValue = ifnull(loiContext.get(&quot;closing&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\textensionsValue = ifnull(loiContext.get(&quot;extensions&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tresponseDateValue = ifnull(loiContext.get(&quot;responseDate&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\teffectiveDateValue = ifnull(loiContext.get(&quot;effectiveDate&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tbuyerBrokerValue = ifnull(loiContext.get(&quot;buyerBroker&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tsellerBrokerValue = ifnull(loiContext.get(&quot;sellerBroker&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tacquisitionEmailValue = ifnull(loiContext.get(&quot;acquisitionEmail&quot;),&quot;\u2014&quot;).toString();\n\t\t\t\t\t\tspecialProvisionsValue = ifnull(loiContext.get(&quot;specialProvisions&quot;),&quot;&quot;).toString();\n\t\t\t\t\t}\n\t\t\t\t\t// =================================================\n\t\t\t\t\t// PRIOR APPROVER OR RETURN NOTE\n\t\t\t\t\t// =================================================\n\t\t\t\t\tif(approvalSortOrder &gt; 1)\n\t\t\t\t\t{\n\t\t\t\t\t\tpriorOrder = approvalSortOrder - 1;\n\t\t\t\t\t\tpriorRow = Budget_Approvals[Proforma == proformaIdLong &amp;&amp; Sort_Order == priorOrder];\n\t\t\t\t\t\tif(priorRow.ID != null &amp;&amp; priorRow.Approval_Notes != null &amp;&amp; priorRow.Approval_Notes.toString().trim() != &quot;&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcontextNote = priorRow.Approval_Notes.toString();\n\t\t\t\t\t\t\tcontextNoteLabel = &quot;Previous note from &quot; + ifnull(priorRow.Title,&quot;approver&quot;).toString();\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\treturnedOrder = approvalSortOrder + 1;\n\t\t\t\t\treturnedRow = Budget_Approvals[Proforma == proformaIdLong &amp;&amp; Sort_Order == returnedOrder &amp;&amp; Status == &quot;Rejected&quot;];\n\t\t\t\t\tif(returnedRow.ID != null &amp;&amp; returnedRow.Approval_Notes != null &amp;&amp; returnedRow.Approval_Notes.toString().trim() != &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tcontextNote = returnedRow.Approval_Notes.toString();\n\t\t\t\t\t\tcontextNoteLabel = &quot;Returned by &quot; + ifnull(returnedRow.Title,&quot;approver&quot;).toString();\n\t\t\t\t\t}\n\t\t\t\t\tchainRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tpageState = &quot;invalid&quot;;\n\t\t\t\t\terrorMsg = &quot;The Pro Forma connected to this approval could not be found.&quot;;\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tpageState = &quot;invalid&quot;;\n\t\t\t\terrorMsg = &quot;This approval request could not be found.&quot;;\n\t\t\t}\n\t\t}\t\tcatch (pageError)\n\t\t{\n\t\t\tpageState = &quot;error&quot;;\n\t\t\terrorMsg = pageError.toString();\n\t\t}\n\t}\n\telse\n\t{\n\t\terrorMsg = &quot;The approval ID is missing from this link.&quot;;\n\t}\n\t// =========================================================\n\t// ESCAPE DISPLAY VALUES\n\t// =========================================================\n\tsafePfName = pfName;\n\tsafePfName = safePfName.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafePfName = safePfName.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafePfName = safePfName.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafePfStatus = pfStatus;\n\tsafePfStatus = safePfStatus.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafePfStatus = safePfStatus.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafePfStatus = safePfStatus.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafePfStage = pfStage;\n\tsafePfStage = safePfStage.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafePfStage = safePfStage.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafePfStage = safePfStage.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafePfTerritory = pfTerritory;\n\tsafePfTerritory = safePfTerritory.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafePfTerritory = safePfTerritory.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafePfTerritory = safePfTerritory.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeApprovalRole = approvalRole;\n\tsafeApprovalRole = safeApprovalRole.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeApprovalRole = safeApprovalRole.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeApprovalRole = safeApprovalRole.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeApproverEmail = approverEmail;\n\tsafeApproverEmail = safeApproverEmail.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeApproverEmail = safeApproverEmail.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeApproverEmail = safeApproverEmail.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeSellerValue = sellerValue;\n\tsafeSellerValue = safeSellerValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeSellerValue = safeSellerValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeSellerValue = safeSellerValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeBuyingEntityValue = buyingEntityValue;\n\tsafeBuyingEntityValue = safeBuyingEntityValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeBuyingEntityValue = safeBuyingEntityValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeBuyingEntityValue = safeBuyingEntityValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafePropertyValue = propertyValue;\n\tsafePropertyValue = safePropertyValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafePropertyValue = safePropertyValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafePropertyValue = safePropertyValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeExtensionsValue = extensionsValue;\n\tsafeExtensionsValue = safeExtensionsValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeExtensionsValue = safeExtensionsValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeExtensionsValue = safeExtensionsValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeBuyerBrokerValue = buyerBrokerValue;\n\tsafeBuyerBrokerValue = safeBuyerBrokerValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeBuyerBrokerValue = safeBuyerBrokerValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeBuyerBrokerValue = safeBuyerBrokerValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeSellerBrokerValue = sellerBrokerValue;\n\tsafeSellerBrokerValue = safeSellerBrokerValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeSellerBrokerValue = safeSellerBrokerValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeSellerBrokerValue = safeSellerBrokerValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeAcquisitionEmailValue = acquisitionEmailValue;\n\tsafeAcquisitionEmailValue = safeAcquisitionEmailValue.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeAcquisitionEmailValue = safeAcquisitionEmailValue.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeAcquisitionEmailValue = safeAcquisitionEmailValue.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeContextNote = contextNote;\n\tsafeContextNote = safeContextNote.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeContextNote = safeContextNote.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeContextNote = safeContextNote.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeContextNoteLabel = contextNoteLabel;\n\tsafeContextNoteLabel = safeContextNoteLabel.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeContextNoteLabel = safeContextNoteLabel.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeContextNoteLabel = safeContextNoteLabel.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeSpecialProvisions = specialProvisionsValue;\n\tsafeSpecialProvisions = safeSpecialProvisions.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeSpecialProvisions = safeSpecialProvisions.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeSpecialProvisions = safeSpecialProvisions.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeApprovalNote = approvalNoteText;\n\tsafeApprovalNote = safeApprovalNote.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeApprovalNote = safeApprovalNote.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeApprovalNote = safeApprovalNote.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeSuccessMsg = successMsg;\n\tsafeSuccessMsg = safeSuccessMsg.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeSuccessMsg = safeSuccessMsg.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeSuccessMsg = safeSuccessMsg.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tsafeErrorMsg = errorMsg;\n\tsafeErrorMsg = safeErrorMsg.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\tsafeErrorMsg = safeErrorMsg.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\tsafeErrorMsg = safeErrorMsg.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\tstatusClass = &quot;draft&quot;;\n\tif(pfStatus == &quot;Pending Approval&quot;)\n\t{\n\t\tstatusClass = &quot;pending&quot;;\n\t}\n\telse if(pfStatus == &quot;Approved&quot;)\n\t{\n\t\tstatusClass = &quot;approved&quot;;\n\t}\n\telse if(pfStatus == &quot;LOI in Progress&quot;)\n\t{\n\t\tstatusClass = &quot;loi&quot;;\n\t}\n\telse if(pfStatus == &quot;Closed&quot;)\n\t{\n\t\tstatusClass = &quot;closed&quot;;\n\t}\n\t%&gt;\n&lt;style&gt;\n.pfa-wrap,\n.pfa-wrap * {\n\tbox-sizing: border-box;\n}\n\n.pfa-wrap {\n\tmin-height: 100vh;\n\tpadding: 34px 20px 70px;\n\tbackground:\n\t\tradial-gradient(circle at top left, rgba(37,99,235,.09), transparent 35%),\n\t\t#edf3fa;\n\tcolor: #14213a;\n\tfont-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Arial, sans-serif;\n\tfont-size: 14px;\n\tline-height: 1.5;\n\t-webkit-font-smoothing: antialiased;\n}\n\n.pfa-page {\n\twidth: 100%;\n\tmax-width: 1000px;\n\tmargin: 0 auto;\n}\n\n.pfa-brandbar {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 16px;\n\tmargin-bottom: 18px;\n}\n\n.pfa-brand {\n\tfont-size: 11px;\n\tfont-weight: 800;\n\tletter-spacing: .15em;\n\ttext-transform: uppercase;\n\tcolor: #607799;\n}\n\n.pfa-esponse-label {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tgap: 7px;\n\tcolor: #607799;\n\tfont-size: 12px;\n\tfont-weight: 600;\n}\n\n.pfa-t {\n\twidth: 8px;\n\theight: 8px;\n\tborder-radius: 50%;\n\tbackground: #2563eb;\n\tbox-shadow: 0 0 0 4px rgba(37,99,235,.10);\n}\n\n.pfa-shell {\n\tbackground: #fff;\n\tborder: 1px solid #d8e2ef;\n\tborder-radius: 18px;\n\toverflow: hidden;\n\tbox-shadow: 0 18px 50px rgba(15,35,64,.10);\n}\n\n.pfa-hero {\n\tbackground:\n\t\tlinear-gradient(135deg, rgba(255,255,255,.04), rgba(255,255,255,0)),\n\t\t#102f55;\n\tcolor: #fff;\n\tpadding: 27px 30px 25px;\n\tborder-bottom: 4px solid #2563eb;\n}\n\n.pfa-hero-grid {\n\tdisplay: flex;\n\talign-items: flex-end;\n\tjustify-content: space-between;\n\tgap: 24px;\n}\n\n.pfa-kicker {\n\tfont-size: 11px;\n\tfont-weight: 700;\n\tletter-spacing: .14em;\n\ttext-transform: uppercase;\n\tcolor: rgba(255,255,255,.58);\n\tmargin-bottom: 7px;\n}\n\n.pfa-title {\n\tmargin: 0;\n\tfont-size: 27px;\n\tline-height: 1.2;\n\tfont-weight: 760;\n\tletter-spacing: -.025em;\n}\n\n.pfa-subtitle {\n\tmargin-top: 9px;\n\tcolor: #c9d8eb;\n\tfont-size: 13px;\n}\n\n.pfa-current {\n\tflex: 0 0 auto;\n\tmin-width: 150px;\n\tpadding: 11px 14px;\n\tbackground: rgba(255,255,255,.08);\n\tborder: 1px solid rgba(255,255,255,.13);\n\tborder-radius: 11px;\n}\n\n.pfa-current-label {\n\tfont-size: 9px;\n\tfont-weight: 800;\n\tcolor: #a9bfd8;\n\tletter-spacing: .09em;\n\ttext-transform: uppercase;\n}\n\n.pfa-current-value {\n\tmargin-top: 4px;\n\tfont-size: 16px;\n\tfont-weight: 750;\n}\n\n.pfa-hero-meta {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 9px;\n\tflex-wrap: wrap;\n\tmargin-top: 15px;\n}\n\n.pfa-pill {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tpadding: 5px 10px;\n\tborder-radius: 999px;\n\tfont-size: 11px;\n\tfont-weight: 750;\n}\n\n.pfa-pill.role {\n\tbackground: rgba(255,255,255,.13);\n\tborder: 1px solid rgba(255,255,255,.16);\n\tcolor: #fff;\n}\n\n.pfa-pill.status {\n\tbackground: #e2e8f0;\n\tcolor: #475569;\n}\n\n.pfa-pill.status.pending {\n\tbackground: #fef3c7;\n\tcolor: #92400e;\n}\n\n.pfa-pill.status.approved {\n\tbackground: #d1fae5;\n\tcolor: #047857;\n}\n\n.pfa-pill.status.loi {\n\tbackground: #ede9fe;\n\tcolor: #6d28d9;\n}\n\n.pfa-pill.status.closed {\n\tbackground: #334155;\n\tcolor: #fff;\n}\n\n.pfa-body {\n\tpadding: 26px 30px 32px;\n}\n\n.pfa-result {\n\tdisplay: flex;\n\tgap: 14px;\n\talign-items: flex-start;\n\tpadding: 17px 18px;\n\tmargin-bottom: 22px;\n\tborder-radius: 12px;\n}\n\n.pfa-result.success {\n\tbackground: #ecfdf5;\n\tborder: 1px solid #a7f3d0;\n\tcolor: #065f46;\n}\n\n.pfa-result.denied {\n\tbackground: #fff7ed;\n\tborder: 1px solid #fed7aa;\n\tcolor: #9a3412;\n}\n\n.pfa-result.error {\n\tbackground: #fef2f2;\n\tborder: 1px solid #fecaca;\n\tcolor: #991b1b;\n}\n\n.pfa-result.neutral {\n\tbackground: #f8fafc;\n\tborder: 1px solid #dbe4ef;\n\tcolor: #475569;\n}\n\n.pfa-result-icon {\n\twidth: 30px;\n\theight: 30px;\n\tflex: 0 0 30px;\n\tborder-radius: 50%;\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\tfont-size: 16px;\n\tfont-weight: 800;\n\tbackground: rgba(255,255,255,.65);\n}\n\n.pfa-result-title {\n\tfont-size: 15px;\n\tfont-weight: 750;\n\tmargin-bottom: 2px;\n}\n\n.pfa-result-copy {\n\tfont-size: 13px;\n\topacity: .92;\n}\n\n.pfa-section {\n\tmargin-top: 22px;\n}\n\n.pfa-section:first-child {\n\tmargin-top: 0;\n}\n\n.pfa-section-title {\n\tfont-size: 12px;\n\tfont-weight: 800;\n\tcolor: #17304f;\n\ttext-transform: uppercase;\n\tletter-spacing: .09em;\n\tmargin-bottom: 10px;\n}\n\n.pfa-chain {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(4,minmax(0,1fr));\n\tgap: 9px;\n}\n\n.pfa-step {\n\tpadding: 13px 12px;\n\tborder: 1px solid #dce5f0;\n\tbackground: #f8fafc;\n\tborder-radius: 10px;\n\tmin-width: 0;\n}\n\n.pfa-step.current {\n\tborder-color: #93c5fd;\n\tbackground: #eff6ff;\n\tbox-shadow: 0 0 0 3px rgba(59,130,246,.08);\n}\n\n.pfa-step-role {\n\tfont-size: 12px;\n\tfont-weight: 800;\n\tcolor: #17304f;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n}\n\n.pfa-step-status {\n\tmargin-top: 5px;\n\tfont-size: 10px;\n\tfont-weight: 750;\n\ttext-transform: uppercase;\n\tletter-spacing: .07em;\n\tcolor: #8191a7;\n}\n\n.pfa-step-status.approved {\n\tcolor: #047857;\n}\n\n.pfa-step-status.pending {\n\tcolor: #b45309;\n}\n\n.pfa-step-status.rejected {\n\tcolor: #b91c1c;\n}\n\n.pfa-two-col {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(2,minmax(0,1fr));\n\tgap: 14px;\n\talign-items: start;\n}\n\n.pfa-card {\n\tbackground: #f9fbfe;\n\tborder: 1px solid #dde6f1;\n\tborder-radius: 12px;\n\toverflow: hidden;\n}\n\n.pfa-card-title {\n\tpadding: 12px 15px;\n\tbackground: #eef4fb;\n\tfont-size: 11px;\n\tfont-weight: 800;\n\ttext-transform: uppercase;\n\tletter-spacing: .08em;\n\tcolor: #17304f;\n}\n\n.pfa-row {\n\tdisplay: grid;\n\tgrid-template-columns: minmax(120px,42%) minmax(0,58%);\n\tgap: 16px;\n\tpadding: 10px 15px;\n\tborder-top: 1px solid #e7edf5;\n}\n\n.pfa-label {\n\tcolor: #7b8da6;\n\tfont-size: 12px;\n}\n\n.pfa-value {\n\tcolor: #132743;\n\tfont-size: 12px;\n\tfont-weight: 700;\n\ttext-align: right;\n\tword-break: break-word;\n}\n\n.pfa-value.emphasis {\n\tcolor: #047857;\n\tfont-weight: 800;\n}\n\n.pfa-note {\n\tpadding: 15px 16px;\n\tbackground: #fff7ed;\n\tborder: 1px solid #fed7aa;\n\tborder-radius: 11px;\n\tcolor: #7c2d12;\n\twhite-space: pre-wrap;\n}\n\n.pfa-note-label {\n\tfont-size: 11px;\n\tfont-weight: 800;\n\ttext-transform: uppercase;\n\tletter-spacing: .09em;\n\tcolor: #9a3412;\n\tmargin-bottom: 6px;\n}\n\n.pfa-deny-box {\n\tmargin-top: 22px;\n\tpadding: 20px;\n\tbackground: #fffaf7;\n\tborder: 1px solid #fed7aa;\n\tborder-radius: 13px;\n}\n\n.pfa-deny-title {\n\tfont-size: 17px;\n\tfont-weight: 780;\n\tcolor: #7c2d12;\n\tmargin-bottom: 5px;\n}\n\n.pfa-deny-copy {\n\tcolor: #9a3412;\n\tfont-size: 13px;\n\tmargin-bottom: 14px;\n}\n\n.pfa-textarea {\n\twidth: 100%;\n\tmin-height: 130px;\n\tresize: vertical;\n\tborder: 1px solid #fdba74;\n\tborder-radius: 9px;\n\tbackground: #fff;\n\tcolor: #172033;\n\tfont: inherit;\n\tpadding: 12px 13px;\n\toutline: none;\n}\n\n.pfa-textarea:focus {\n\tborder-color: #ea580c;\n\tbox-shadow: 0 0 0 3px rgba(234,88,12,.10);\n}\n\n.pfa-actions {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tmargin-top: 13px;\n}\n\n.pfa-btn {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\tmin-height: 42px;\n\tpadding: 0 19px;\n\tborder: 0;\n\tborder-radius: 8px;\n\tfont-size: 12px;\n\tfont-weight: 800;\n\tletter-spacing: .055em;\n\ttext-transform: uppercase;\n\tcursor: pointer;\n\tfont-family: inherit;\n}\n\n.pfa-btn.deny {\n\tbackground: #b42318;\n\tcolor: #fff;\n}\n\n.pfa-btn.deny:hover {\n\tbackground: #912018;\n}\n\n.pfa-footer {\n\tpadding: 16px 30px 20px;\n\tborder-top: 1px solid #edf1f6;\n\tbackground: #fbfcfe;\n\tcolor: #8594a8;\n\tfont-size: 11px;\n\ttext-align: center;\n}\n\n@media(max-width:720px) {\n\t.pfa-wrap {\n\t\tpadding: 14px 10px 40px;\n\t}\n\n\t.pfa-hero,\n\t.pfa-body {\n\t\tpadding-left: 18px;\n\t\tpadding-right: 18px;\n\t}\n\n\t.pfa-hero-grid {\n\t\tdisplay: block;\n\t}\n\n\t.pfa-current {\n\t\tmargin-top: 16px;\n\t}\n\n\t.pfa-title {\n\t\tfont-size: 22px;\n\t}\n\n\t.pfa-chain,\n\t.pfa-two-col {\n\t\tgrid-template-columns: 1fr;\n\t}\n\n\t.pfa-row {\n\t\tgrid-template-columns: 1fr;\n\t\tgap: 3px;\n\t}\n\n\t.pfa-value {\n\t\ttext-align: left;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;pfa-wrap&quot;&gt;\n\t&lt;div class=&quot;pfa-page&quot;&gt;\n\n\t\t&lt;div class=&quot;pfa-brandbar&quot;&gt;\n\t\t\t&lt;div class=&quot;pfa-brand&quot;&gt;Land Master&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;pfa-esponse-label&quot;&gt;\n\t\t\t\t&lt;span class=&quot;pfa-t&quot;&gt;&lt;/span&gt;\n\t\t\t\tApproval Response\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;pfa-shell&quot;&gt;\n&lt;%\n\tif(hasApproval == true &amp;&amp; hasProforma == true)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;pfa-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;pfa-hero-grid&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-kicker&quot;&gt;Pro Forma Approval&lt;/div&gt;\n\t\t\t\t\t\t&lt;h1 class=&quot;pfa-title&quot;&gt;&lt;%=safePfName%&gt;&lt;/h1&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;pfa-subtitle&quot;&gt;\n\t\t\t\t\t\t\t&lt;%=safePfTerritory%&gt; &amp;middot; &lt;%=safePfStage%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;pfa-current&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-current-label&quot;&gt;Current Step&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-current-value&quot;&gt;&lt;%=safeApprovalRole%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;pfa-hero-meta&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;pfa-pill role&quot;&gt;&lt;%=safeApprovalRole%&gt; Review&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;pfa-pill status &lt;%=statusClass%&gt;&quot;&gt;&lt;%=safePfStatus%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;pfa-body&quot;&gt;\n&lt;%\n\t\tif(pageState == &quot;approved&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-result success&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-result-icon&quot;&gt;&amp;#10003;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-title&quot;&gt;Approval recorded&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-copy&quot;&gt;&lt;%=safeSuccessMsg%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(pageState == &quot;denied&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-result denied&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-result-icon&quot;&gt;&amp;#8634;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-title&quot;&gt;Pro Forma rejected&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-copy&quot;&gt;&lt;%=safeSuccessMsg%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(pageState == &quot;completed&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-result neutral&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-result-icon&quot;&gt;&amp;#10003;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-title&quot;&gt;Approval already processed&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-copy&quot;&gt;\n\t\t\t\t\t\t\tThis approval is currently\n\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=approvalStatus%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\tand no additional response is required.\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(pageState == &quot;error&quot; || errorMsg != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-result error&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-result-icon&quot;&gt;!&lt;/div&gt;\n\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-title&quot;&gt;Unable to process response&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-copy&quot;&gt;&lt;%=safeErrorMsg%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&quot;pfa-section&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-section-title&quot;&gt;Approval Route&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;pfa-chain&quot;&gt;\n&lt;%\n\t\tfor each  chainRow in chainRows\n\t\t{\n\t\t\tchainStatus = ifnull(chainRow.Status,&quot;Not Sent&quot;).toString();\n\t\t\tchainStatusClass = &quot;&quot;;\n\t\t\tif(chainStatus == &quot;Approved&quot;)\n\t\t\t{\n\t\t\t\tchainStatusClass = &quot;approved&quot;;\n\t\t\t}\n\t\t\telse if(chainStatus == &quot;Pending&quot;)\n\t\t\t{\n\t\t\t\tchainStatusClass = &quot;pending&quot;;\n\t\t\t}\n\t\t\telse if(chainStatus == &quot;Rejected&quot;)\n\t\t\t{\n\t\t\t\tchainStatusClass = &quot;rejected&quot;;\n\t\t\t}\n\t\t\tcurrentClass = &quot;&quot;;\n\t\t\tif(chainRow.ID == approvalIdLong)\n\t\t\t{\n\t\t\t\tcurrentClass = &quot;current&quot;;\n\t\t\t}\n\t\t\tchainRoleText = ifnull(chainRow.Title,&quot;Approver&quot;).toString();\n\t\t\tsafeChainRoleText = chainRoleText;\n\t\t\tsafeChainRoleText = safeChainRoleText.replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;);\n\t\t\tsafeChainRoleText = safeChainRoleText.replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;);\n\t\t\tsafeChainRoleText = safeChainRoleText.replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-step &lt;%=currentClass%&gt;&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-step-role&quot;&gt;&lt;%=safeChainRoleText%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-step-status &lt;%=chainStatusClass%&gt;&quot;&gt;&lt;%=chainStatus%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(contextNote != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-section&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-note&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-note-label&quot;&gt;&lt;%=safeContextNoteLabel%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;%=safeContextNote%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&quot;pfa-section&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-two-col&quot;&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;pfa-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-card-title&quot;&gt;Pro Forma Overview&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Territory&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safePfTerritory%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Stage&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safePfStage%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Status&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safePfStatus%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Approval Step&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeApprovalRole%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Approver&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeApproverEmail%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;pfa-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-card-title&quot;&gt;LOI Snapshot&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Seller&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeSellerValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Buying Entity&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeBuyingEntityValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Property&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safePropertyValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Total Acres&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=acresValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Price / Acre&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=pricePerAcreValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Estimated Purchase&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value emphasis&quot;&gt;&lt;%=estimatedPriceValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Earnest Money&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=earnestMoneyValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Feasibility / Closing&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;%=feasibilityValue%&gt; / &lt;%=closingValue%&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Extensions&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeExtensionsValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Response / Effective&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;%=responseDateValue%&gt; / &lt;%=effectiveDateValue%&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Buyer Broker&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeBuyerBrokerValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Seller Broker&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeSellerBrokerValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&quot;pfa-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-label&quot;&gt;Acquisition Email&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;pfa-value&quot;&gt;&lt;%=safeAcquisitionEmailValue%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(specialProvisionsValue != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-section&quot;&gt;\n\t\t\t\t\t&lt;div\n\t\t\t\t\t\tclass=&quot;pfa-note&quot;\n\t\t\t\t\t\tstyle=&quot;background:#f8fafc;border-color:#dce5f0;color:#334155;&quot;\n\t\t\t\t\t&gt;\n\t\t\t\t\t\t&lt;div\n\t\t\t\t\t\t\tclass=&quot;pfa-note-label&quot;\n\t\t\t\t\t\t\tstyle=&quot;color:#17304f;&quot;\n\t\t\t\t\t\t&gt;\n\t\t\t\t\t\t\tSpecial Provisions\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;%=safeSpecialProvisions%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(pageState == &quot;deny&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;pfa-deny-box&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-deny-title&quot;&gt;\n\t\t\t\t\t\tReject this Pro Forma?\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;pfa-deny-copy&quot;&gt;\n\t\t\t\t\t\tExplain what needs to be changed. Approvals restart from step 1 and the Pro Forma owners are notified; your note goes with both.\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;form method=&quot;get&quot; action=&quot;&lt;%=publishedPageUrl%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;input\n\t\t\t\t\t\t\ttype=&quot;hidden&quot;\n\t\t\t\t\t\t\tname=&quot;approvalId&quot;\n\t\t\t\t\t\t\tvalue=&quot;&lt;%=approvalIdLong%&gt;&quot;\n\t\t\t\t\t\t&gt;\n\n\t\t\t\t\t\t&lt;input\n\t\t\t\t\t\t\ttype=&quot;hidden&quot;\n\t\t\t\t\t\t\tname=&quot;action1&quot;\n\t\t\t\t\t\t\tvalue=&quot;Deny&quot;\n\t\t\t\t\t\t&gt;\n\n\t\t\t\t\t\t&lt;input\n\t\t\t\t\t\t\ttype=&quot;hidden&quot;\n\t\t\t\t\t\t\tname=&quot;submit1&quot;\n\t\t\t\t\t\t\tvalue=&quot;true&quot;\n\t\t\t\t\t\t&gt;\n\n\t\t\t\t\t\t&lt;textarea\n\t\t\t\t\t\t\tclass=&quot;pfa-textarea&quot;\n\t\t\t\t\t\t\tname=&quot;approvalNote&quot;\n\t\t\t\t\t\t\tplaceholder=&quot;Enter the reason for rejecting this Pro Forma...&quot;\n\t\t\t\t\t\t\trequired&gt;&lt;%=safeApprovalNote%&gt;&lt;/textarea&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;pfa-actions&quot;&gt;\n\t\t\t\t\t\t\t&lt;button\n\t\t\t\t\t\t\t\tclass=&quot;pfa-btn deny&quot;\n\t\t\t\t\t\t\t\ttype=&quot;submit&quot;\n\t\t\t\t\t\t\t&gt;\n\t\t\t\t\t\t\t\tSubmit Rejection\n\t\t\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/form&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;pfa-footer&quot;&gt;\n\t\t\t\tLand Master \u00B7 Pro Forma Approval Workflow\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;pfa-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;pfa-kicker&quot;&gt;Pro Forma Approval&lt;/div&gt;\n\t\t\t\t&lt;h1 class=&quot;pfa-title&quot;&gt;Approval link unavailable&lt;/h1&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;pfa-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;pfa-result error&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;pfa-result-icon&quot;&gt;!&lt;/div&gt;\n\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-title&quot;&gt;Unable to open approval&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pfa-result-copy&quot;&gt;&lt;%=safeErrorMsg%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;pfa-footer&quot;&gt;\n\t\t\t\tLand Master \u00B7 Pro Forma Approval Workflow\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Lots_Takedowns
		{
			displayname = "Lots & Takedowns"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Forms_Reports
		{
			displayname = "Forms & Reports"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet3' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet3()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div id=&quot;lm-nav&quot;&gt;\n&lt;style&gt;\n#lm-nav{--bg:#ffffff;--card:#ffffff;--border:#e3e6eb;--text:#1f2430;--muted:#6b7280;--brand:#2b6cff;--brand-ink:#fff;--edit:#5b667a;--chip:#eef1f6;--shadow:0 1px 2px rgba(16,24,40,.06),0 1px 3px rgba(16,24,40,.10);font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Roboto,Helvetica,Arial,sans-serif;color:var(--text);background:var(--bg);box-sizing:border-box;padding:16px;line-height:1.4;-webkit-font-smoothing:antialiased;max-width:1200px;margin:0 auto;}\n#lm-nav *,#lm-nav *::before,#lm-nav *::after{box-sizing:border-box;}\n@media (prefers-color-scheme:dark){#lm-nav{--bg:#12151c;--card:#1b2029;--border:#2a3140;--text:#e7eaf0;--muted:#98a2b3;--brand:#4d82ff;--edit:#8a93a6;--chip:#222836;--shadow:0 1px 2px rgba(0,0,0,.5);}}\n#lm-nav .lm-envradio{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;}\n#lm-nav h2.lm-title{font-size:19px;font-weight:700;margin:0;letter-spacing:-.01em;}\n#lm-nav .lm-sub{color:var(--muted);font-size:13px;margin:3px 0 0;}\n#lm-nav .lm-envlabel{display:inline-block;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 12px 0 0;vertical-align:middle;}\n#lm-nav .lm-seg-btn{display:inline-block;vertical-align:middle;margin-top:14px;padding:7px 16px;font-size:13px;font-weight:600;color:var(--muted);background:var(--chip);border:1px solid var(--border);cursor:pointer;user-select:none;transition:background .12s,color .12s,border-color .12s;}\n#lm-nav label.seg-dev{border-radius:8px 0 0 8px;}\n#lm-nav label.seg-prod{border-radius:0 8px 8px 0;border-left:0;}\n#lm-nav #lm-dev:checked + label.seg-dev,#lm-nav #lm-prod:checked + label.seg-prod{background:var(--brand);color:var(--brand-ink);border-color:var(--brand);}\n#lm-nav .lm-note{font-size:12px;color:var(--muted);margin:12px 0 0;padding-bottom:14px;border-bottom:1px solid var(--border);}\n#lm-nav .lm-note b{color:var(--text);}\n#lm-nav .lm-section{margin:16px 0 6px;}\n#lm-nav .lm-sec-head{display:flex;align-items:center;gap:8px;margin:4px 2px 10px;position:sticky;top:0;background:var(--bg);padding:6px 0;z-index:2;}\n#lm-nav .lm-sec-head h3{font-size:15px;font-weight:700;margin:0;}\n#lm-nav .lm-count{font-size:12px;color:var(--muted);background:var(--chip);border-radius:20px;padding:2px 9px;font-weight:600;}\n#lm-nav ul.lm-grid{list-style:none;margin:0;padding:0;display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));}\n#lm-nav .lm-row{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:9px 11px;box-shadow:var(--shadow);}\n#lm-nav .lm-row-main{min-width:0;display:flex;flex-direction:column;gap:1px;}\n#lm-nav .lm-name{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n#lm-nav .lm-link{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n#lm-nav .lm-actions{display:flex;gap:6px;flex:none;}\n#lm-nav .lm-btn{text-decoration:none;font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:7px;border:1px solid transparent;white-space:nowrap;transition:.12s;}\n#lm-nav .lm-open{background:var(--brand);color:var(--brand-ink);}\n#lm-nav .lm-open:hover{filter:brightness(1.08);}\n#lm-nav .lm-edit{background:transparent;color:var(--edit);border-color:var(--border);}\n#lm-nav .lm-edit:hover{background:var(--chip);color:var(--text);}\n#lm-nav .lm-open.prod{display:none;}\n#lm-nav #lm-prod:checked ~ .lm-section .lm-open.dev{display:none;}\n#lm-nav #lm-prod:checked ~ .lm-section .lm-open.prod{display:inline-block;}\n&lt;/style&gt;\n&lt;h2 class=&quot;lm-title&quot;&gt;Land Master &amp;mdash; Forms &amp;amp; Reports&lt;/h2&gt;\n&lt;p class=&quot;lm-sub&quot;&gt;57 forms &amp;middot; 70 reports &amp;middot; quick links to open or edit every component&lt;/p&gt;\n&lt;span class=&quot;lm-envlabel&quot;&gt;Environment&lt;/span&gt;&lt;input type=&quot;radio&quot; name=&quot;lmenv&quot; id=&quot;lm-dev&quot; class=&quot;lm-envradio&quot; checked&gt;&lt;label for=&quot;lm-dev&quot; class=&quot;lm-seg-btn seg-dev&quot;&gt;Development&lt;/label&gt;&lt;input type=&quot;radio&quot; name=&quot;lmenv&quot; id=&quot;lm-prod&quot; class=&quot;lm-envradio&quot;&gt;&lt;label for=&quot;lm-prod&quot; class=&quot;lm-seg-btn seg-prod&quot;&gt;Production&lt;/label&gt;&lt;p class=&quot;lm-note&quot;&gt;&lt;b&gt;Open&lt;/b&gt; uses the selected environment. &lt;b&gt;Edit&lt;/b&gt; always opens the builder (Development). Tip: press &lt;b&gt;Ctrl&lt;/b&gt;+&lt;b&gt;F&lt;/b&gt; (&amp;#8984;F on Mac) to find a specific item.&lt;/p&gt;\n&lt;div class=&quot;lm-section&quot;&gt;\n  &lt;div class=&quot;lm-sec-head&quot;&gt;&lt;h3&gt;Forms&lt;/h3&gt;&lt;span class=&quot;lm-count&quot;&gt;57&lt;/span&gt;&lt;/div&gt;\n  &lt;ul class=&quot;lm-grid&quot;&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Budget&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Add_Budget&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Add_Budget&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Add_Budget&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Add_Budget/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Builder&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Builder&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Builder&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Builder&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Builder/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Builder Takedown&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Builder_Takedown&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Builder_Takedown&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Builder_Takedown&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Builder_Takedown/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Company&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Company&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Company&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Company&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Company/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Contract&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Contract&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Contract&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Contract&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Contract/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Equipment&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Equipment&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Equipment&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Equipment&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Equipment/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Forecast&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Forecast&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Forecast&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Forecast&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Forecast/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Forecast Year&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Forecast_Year&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Forecast_Year&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Forecast_Year&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Forecast_Year/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Lots&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Lots&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Lots&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Lots&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Lots/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Pro Forma&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Add_Pro_Forma&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Add_Pro_Forma&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Add_Pro_Forma&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Add_Pro_Forma/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Project&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Project&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#Form:Project&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-open prod&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Project&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Open&lt;/a&gt;\n    &lt;a class=&quot;lm-btn lm-edit&quot; href=&quot;https://creator.zoho.com/appbuilder/wbdevelopment/land-master/formbuilder/Project/edit&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Edit&lt;/a&gt;\n  &lt;/div&gt;\n&lt;/li&gt;\n&lt;li class=&quot;lm-row&quot;&gt;\n  &lt;div class=&quot;lm-row-main&quot;&gt;&lt;span class=&quot;lm-name&quot;&gt;Add Property&lt;/span&gt;&lt;span class=&quot;lm-link&quot;&gt;Property&lt;/span&gt;&lt;/div&gt;\n  &lt;div class=&quot;lm-actions&quot;&gt;\n    &lt;a class=&quot;lm-btn lm-open dev&quot; href=&quot;https://creatorapp.zoho.com/wbdevelopment/environment/development/land-master/#F