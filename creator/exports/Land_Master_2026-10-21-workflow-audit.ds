		form Project
		{
			title 
    		{
				displayname = "Add Project"
    			on add = "Create Project"
   	 			on edit = "Edit Project"
			}
			success message = "Project Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Project_Name
			(
    			type = text
				displayname = "Project Name"
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Project_Code
			(
    			type = text
				displayname = "Project Code"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have City
			(
				type = picklist
				maxchar = 100
				values = {"Bartlett","Killeen","Houston","Caldwell","Bruceville-Eddy","Lorena","N","Temple","Waco","Bryan","Belton","Copperas Cove","Seguin","Harker Heights","Taylor","New Braunfels","Jarrell","Troy","Nolanville","Robinson","Pflugerville","Salado","San Antonio","Austin","Granger","Addison","Balch Springs","Carrollton","Cedar Hill","Cockrell Hill","Combine","Coppell","Dallas","DeSoto","Duncanville","Farmers Branch","Ferris","Garland","Glenn Heights","Grand Prairie","Grapevine","Highland Park","Hutchins","Irving","Lancaster","Lewisville","Mesquite","Ovilla","Richardson","Rowlett","Sachse","Seagoville","Sunnyvale","University Park","Wilmer","Wylie","League City","Pasadena","Pearland","Georgetown","Sugar Land","Conroe","Katy","Denton","Sherman","Westminster","Anna","Crandall","Midlothian","Celina","Van Alstyne","Greenville","Princeton","Corsicana","Waxahachie","Prosper","Cresson"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have County
			(
				type = picklist
				maxchar = 100
				values = {"Bell","Navarro","Bexar","Brazos","Burleson","Caldwell","Comal","Coryell","Guadalupe","Falls","McLennan","Williamson","Travis","Harris","Grayson","Collin","Tarrant","Johnson","Kaufman","Ellis","Denton","Hunt","Dallas","Cooke"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Territory
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3","Bryan/College Station","Corpus Christi","Dallas/Fort Worth","Fort Hood","Houston","North Austin","San Antonio","South Austin","Temple/Belton","Waco"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive","Forecast Placeholder"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Company1
			(
				type = picklist	
				displayname = "Company"
				values  = Company.ID
    			displayformat = [Company_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Properties
			(
				type = list	
				values  = Property.ID
    			bidirectional = Projects
    			displayformat = [Common_Name]
				height = 60px
	 			row = 1
	 			column = 3   
				width = medium
			)
			Proforma
			(
				type = picklist	
				values  = Add_Pro_Forma.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
