				 string recalcAllRevisedFinals()
                 {
                 	/********* RECALC REVISED FINAL — BATCH *********/
                 	// Nightly safety net: recompute Revised_Final for every Budget_Item that has
                 	// modifications, plus any item whose Revised_Final drifted from Budget_Ttl
                 	// with no modifications (e.g. Final changed after finalization).
                 	itemIds = List();
                 	modRows = Budget_Modification[ID != 0];
                 	for each  mr in modRows
                 	{
                 		if(mr.Budget_Item != null)
                 		{
                 			iid = mr.Budget_Item.ID;
                 			if(!itemIds.contains(iid))
                 			{
                 				itemIds.add(iid);
                 			}
                 		}
                 	}
                 	updated = 0;
                 	for each  iid2 in itemIds
                 	{
                 		result = thisapp.recalcItemRevisedFinal(iid2.toLong());
                 		updated = updated + 1;
                 	}
                 	// Items with a stale Revised_Final but no modifications: reset to Budget_Ttl.
                 	staleRows = Budget_Item[Revised_Final != null];
                 	for each  sr in staleRows
                 	{
                 		if(!itemIds.contains(sr.ID))
                 		{
                 			finVal = ifnull(sr.Budget_Ttl,0.0);
                 			if(ifnull(sr.Revised_Final,0.0) != finVal)
                 			{
                 				sr.Revised_Final=finVal;
                 				updated = updated + 1;
                 			}
                 		}
                 	}
                 	return "Recalculated Revised Final for " + updated + " items.";
                 }
				 string recalcBudgetModifiedTotals(int budgetId)
                 {
                 	/********* RECALC MODIFIED FINAL ROLLUPS *********/
                 	// Return Type: string
                 	// Modified Final = Final (Budget_Ttl) + sum of APPROVED modification amounts,
                 	// rolled up from items to Budget_Category.Modified_Final_Total and then to
                 	// Add_Budget.Modified_Final_Grand_Total.
                 	// Computed from the modification records directly rather than from
                 	// Budget_Item.Revised_Final so a blank/stale Revised_Final cannot skew it.
                 	// Called when a modification chain completes (see sendModificationEmail).
                 	vBudgetId = budgetId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	grandTotal = 0.0;
                 	catCount = 0;
                 	cats = Budget_Category[Budget == vBudgetId];
                 	for each  cat in cats
                 	{
                 		catTotal = 0.0;
                 		catItems = Budget_Item[Budget_Category == cat.ID];
                 		for each  it in catItems
                 		{
                 			itemTotal = ifnull(it.Budget_Ttl,0.0);
                 			modRows = Budget_Modification[Budget_Item == it.ID && Status == "Approved"];
                 			for each  mr in modRows
                 			{
                 				amt = ifnull(mr.Amount,0.0);
                 				if(ifnull(mr.Modification_Type,"") == "Decrease")
                 				{
                 					itemTotal = itemTotal - amt;
                 				}
                 				else
                 				{
                 					itemTotal = itemTotal + amt;
                 				}
                 			}
                 			catTotal = catTotal + itemTotal;
                 		}
                 		cat.Modified_Final_Total=catTotal;
                 		grandTotal = grandTotal + catTotal;
                 		catCount = catCount + 1;
                 	}
                 	budgetRec.Modified_Final_Grand_Total=grandTotal;
                 	return "Modified Final updated for budget " + vBudgetId + " (" + catCount + " categories, grand total " + grandTotal + ").";
                 }
				 string recalcItemRevisedFinal(int itemId)
                 {
                 	/********* RECALC REVISED FINAL — ONE ITEM *********/
                 	// Revised_Final = Budget_Ttl + sum of APPROVED Budget_Modification amounts
                 	// (Increase positive, Decrease negative). Called after modification
                 	// approval and from the nightly batch recalc.
                 	vItemId = itemId.toLong();
                 	if(vItemId == 0)
                 	{
                 		return "No Item ID provided.";
                 	}
                 	itemRec = Budget_Item[ID == vItemId];
                 	if(itemRec == null)
                 	{
                 		return "Budget Item not found.";
                 	}
                 	approvedSum = 0.0;
                 	modRows = Budget_Modification[Budget_Item == vItemId && Status == "Approved"];
                 	for each  mr in modRows
                 	{
                 		amt = ifnull(mr.Amount,0.0);
                 		if(ifnull(mr.Modification_Type,"") == "Decrease")
                 		{
                 			approvedSum = approvedSum - amt;
                 		}
                 		else
                 		{
                 			approvedSum = approvedSum + amt;
                 		}
                 	}
                 	itemRec.Revised_Final=ifnull(itemRec.Budget_Ttl,0.0) + approvedSum;
                 	return "Revised Final updated for item " + vItemId + ".";
                 }
				 string reportProformaWidgetError(string payload)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(payload == null || payload.toString().trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("error","No error-report payload was supplied.");
                 			return result.toString();
                 		}
                 		data = payload.toString().toMap();
                 		reportId = ifnull(data.get("reportId"),"").toString().trim();
                 		subjectText = ifnull(data.get("subject"),"[Pro Forma Widget Error]").toString().trim();
                 		bodyText = ifnull(data.get("body"),"").toString();
                 		if(subjectText == "")
                 		{
                 			subjectText = "[Pro Forma Widget Error]";
                 		}
                 		if(bodyText == "")
                 		{
                 			bodyText = "The widget submitted an empty error body.\n\nRaw payload:\n" + payload.toString();
                 		}
                 		sendmail
                 		[
                 			from :"Notifications@wbdevelopment.com"
                 			to :"rbelliveau@wbdevelopment.com"
                 			subject :subjectText
                 			message :bodyText
                 		]
                 		result.put("success",true);
                 		result.put("reportId",reportId);
                 		result.put("recipient","rbelliveau@wbdevelopment.com");
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("error",e.toString());
                 	}
                 	return result.toString();
                 }
				 map resolveApprovalRoute(map context)
                 {
                 	result = {"success":false,"contract":"approval-policy-v1"};
                 	try 
                 	{
                 		for each  identityField in {"submitterId"}
                 		{
                 			typedIdentity = Map();
                 			typedIdentity.put("value",context.get(identityField));
                 			if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 			{
                 				result.put("error","Submitter ID must be an exact string.");
                 				return result;
                 			}
                 		}
                 		workflows = {"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
                 		if(!workflows.contains(context.get("workflow")))
                 		{
                 			result.put("error","Workflow is invalid.");
                 			return result;
                 		}
                 		submitterText = ifnull(context.get("submitterId"),"").toString();
                 		amountText = thisapp.poCurrencyString(ifnull(context.get("amount"),"").toString());
                 		typedAmount = Map();
                 		typedAmount.put("value",context.get("amount"));
                 		if(context.get("workflow") == "Pro Forma" || context.get("workflow") == "Contract")
                 		{
                 			amountText = "0.00";
                 			typedAmount.put("value","0.00");
                 		}
                 		if(amountText == "" || !typedAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
                 		{
                 			result.put("error","Submitter identity and an exact amount are required.");
                 			return result;
                 		}
                 		territory = ifnull(context.get("territory"),"").toString();
                 		department = ifnull(context.get("department"),"").toString();
                 		amount = amountText.replaceAll("[.]","").toLong();
                 		policyId = 0;
                 		bestRank = -1;
                 		matched = 0;
                 		for each  policy in Approval_Policy[Workflow == context.get("workflow") && Status == "Published"]
                 		{
                 			valid = true;
                 			pTerritory = ifnull(policy.Territory_Key,"");
                 			pDepartment = ifnull(policy.Department_Key,"");
                 			if(pTerritory != "" && pTerritory != territory)
                 			{
                 				valid = false;
                 			}
                 			if(pDepartment != "" && pDepartment != department)
                 			{
                 				valid = false;
                 			}
                 			if(valid)
                 			{
                 				rank = 0;
                 				if(pTerritory != "")
                 				{
                 					rank = rank + 4;
                 				}
                 				if(pDepartment != "")
                 				{
                 					rank = rank + 2;
                 				}
                 				if(rank > bestRank)
                 				{
                 					bestRank = rank;
                 					policyId = policy.ID;
                 					matched = 1;
                 				}
                 				else if(rank == bestRank)
                 				{
                 					matched = matched + 1;
                 				}
                 			}
                 		}
                 		if(matched != 1)
                 		{
                 			result.put("error","Published policy is missing or ambiguous at the highest applicable scope.");
                 			return result;
                 		}
                 		policy = Approval_Policy[ID == policyId];
                 		if(policy.Enabled != true)
                 		{
                 			result.put("error","The applicable published policy is disabled. No broader fallback was used.");
                 			return result;
                 		}
                 		// Self-approval is always permitted for every shared workflow.
                 		effectiveSelfApproval = "Allow";
                 		steps = List();
                 		for each  rawPolicyStep in policy.Steps_JSON.toJSONList()
                 		{
                 			steps.add(rawPolicyStep.toString().toMap());
                 		}
                 		if(steps.size() == 0 || steps.size() > 30)
                 		{
                 			result.put("error","Published policy requires 1–30 ordered steps.");
                 			return result;
                 		}
                 		// Owner-configured PO testing uses one captured CFO identity without changing shared assignments.
                 		for each  configuredStep in steps
                 		{
                 			if(configuredStep.get("poTestCFO") != null)
                 			{
                 				testCFO = configuredStep.get("poTestCFO");
                 				if(policy.Workflow != "Purchase Order" || steps.size() != 1 || configuredStep.get("enabled") != true || configuredStep.get("condition") != "Always" || testCFO.get("allowSelfApproval") != true)
                 				{
                 					result.put("error","PO test CFO requires one enabled Always CFO step.");
                 					return result;
                 				}
                 				for each  testIdentityField in {"budgetId","userAccessId"}
                 				{
                 					typedTestIdentity = {"value":testCFO.get(testIdentityField)};
                 					if(!typedTestIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 					{
                 						result.put("error","PO test CFO identities must be exact ID strings.");
                 						return result;
                 					}
                 				}
                 				typedContextBudget = {"value":context.get("budgetId")};
                 				if(!typedContextBudget.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 				{
                 					result.put("error","PO test budget context must be an exact ID string.");
                 					return result;
                 				}
                 				typedTestEmail = {"value":testCFO.get("email")};
                 				testEmailIsString = typedTestEmail.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[^\"]+\"[ ]*[}][ ]*");
                 				testEmailValid = testEmailIsString && ifnull(testCFO.get("email"),"").toString().matches("[^\\s@,;<>\"]+@[^\\s@,;<>\"]+[.][^\\s@,;<>\"]+");
                 				typedTestAmount = {"value":testCFO.get("maxAmount")};
                 				testMaximum = thisapp.poCurrencyString(ifnull(testCFO.get("maxAmount"),"").toString());
                 				if(!typedTestAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || testMaximum == "" || testMaximum.replaceAll("[.]","").toLong() <= 0 || testMaximum.replaceAll("[.]","").toLong() > 5500 || testEmailValid != true)
                 				{
                 					result.put("error","PO test CFO needs a valid email and a positive maximum of at most $55.");
                 					return result;
                 				}
                 				if(context.get("budgetId") != testCFO.get("budgetId") || amount > testMaximum.replaceAll("[.]","").toLong() || context.get("hasBudgetModification") != false || context.get("hasBudgetOverrun") != false)
                 				{
                 					result.put("error","This PO is outside the configured test budget, amount or no-overrun scope.");
                 					return result;
                 				}
                 			}
                 		}
                 		route = List();
                 		excluded = List();
                 		stepKeys = List();
                 		expectedOrder = 0;
                 		cfoSteps = 0;
                 		for each  step in steps
                 		{
                 			expectedOrder = expectedOrder + 1;
                 			if(!ifnull(step.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || step.get("order") != expectedOrder || stepKeys.contains(step.get("key")))
                 			{
                 				result.put("error","Policy steps have duplicate keys or invalid sequential order.");
                 				return result;
                 			}
                 			typedRole = Map();
                 			typedRole.put("value",step.get("roleId"));
                 			if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 			{
                 				result.put("error","Step role ID must be a string.");
                 				return result;
                 			}
                 			stepKeys.add(step.get("key"));
                 			condition = step.get("condition");
                 			if(policy.Workflow == "Purchase Order")
                 			{
                 				poRole = Approval_Role[ID == step.get("roleId").toString().toLong()];
                 				if(poRole.ID == null)
                 				{
                 					result.put("error","PO approver role was not found.");
                 					return result;
                 				}
                 				if(poRole.Role_Name == "CFO")
                 				{
                 					cfoSteps = cfoSteps + 1;
                 					if(condition != "Always" || step.get("enabled") != true)
                 					{
                 						result.put("error","CFO must approve every purchase order.");
                 						return result;
                 					}
                 				}
                 				else
                 				{
                 					if(condition != "Budget modification attached")
                 					{
                 						result.put("error","Additional PO approvers are used only when the PO creates budget modifications.");
                 						return result;
                 					}
                 				}
                 			}
                 			if(policy.Workflow == "Pro Forma" || policy.Workflow == "Contract")
                 			{
                 				if(condition != "Always")
                 				{
                 					result.put("error","Pro Forma and Contract use straight approval chains without amount thresholds.");
                 					return result;
                 				}
                 			}
                 			applies = step.get("enabled") == true;
                 			reason = "Required step";
                 			if(step.get("enabled") != true && step.get("enabled") != false)
                 			{
                 				result.put("error","Step enabled state is not explicit.");
                 				return result;
                 			}
                 			if(condition == "Above" || condition == "At or above")
                 			{
                 				thresholdText = thisapp.poCurrencyString(ifnull(step.get("threshold"),"").toString());
                 				typedThreshold = Map();
                 				typedThreshold.put("value",step.get("threshold"));
                 				if(thresholdText == "" || !typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
                 				{
                 					result.put("error","Conditional threshold must be an exact currency string.");
                 					return result;
                 				}
                 				threshold = thresholdText.replaceAll("[.]","").toLong();
                 				if(condition == "Above" && amount <= threshold)
                 				{
                 					applies = false;
                 				}
                 				if(condition == "At or above" && amount < threshold)
                 				{
                 					applies = false;
                 				}
                 				reason = amountText + " is " + condition.toLowerCase() + " " + thresholdText;
                 			}
                 			else if(condition == "Budget modification attached")
                 			{
                 				if(policy.Workflow != "Purchase Order")
                 				{
                 					result.put("error","Linked budget modification conditions belong to Purchase Orders.");
                 					return result;
                 				}
                 				if(context.get("hasBudgetModification") != true && context.get("hasBudgetModification") != false)
                 				{
                 					result.put("error","Linked PO budget modification context is required.");
                 					return result;
                 				}
                 				if(context.get("hasBudgetModification") != true)
                 				{
                 					applies = false;
                 				}
                 				reason = "A budget modification is linked to this PO";
                 			}
                 			else if(condition != "Always")
                 			{
                 				result.put("error","Unsupported step condition.");
                 				return result;
                 			}
                 			if(applies != true)
                 			{
                 				excludedReason = condition + " threshold is not met";
                 				if(condition == "Budget modification attached")
                 				{
                 					excludedReason = "No budget modification is linked to this PO";
                 				}
                 				if(step.get("enabled") == false)
                 				{
                 					excludedReason = "Disabled";
                 				}
                 				excluded.add({"key":step.get("key"),"reason":excludedReason});
                 			}
                 			else
                 			{
                 				roleText = step.get("roleId").toString();
                 				role = Approval_Role[ID == roleText.toLong()];
                 				if(role.ID == null || role.Active != true)
                 				{
                 					result.put("error","Role is missing or inactive for step " + expectedOrder);
                 					return result;
                 				}
                 				assignmentId = 0;
                 				assignmentRank = -1;
                 				assignmentCount = 0;
                 				personId = 0;
                 				assignmentActive = false;
                 				personIds = List();
                 				territoryDevMgr = role.Role_Name == "Dev Mgr";
                 				territoryVP = role.Role_Name == "VP";
                 				poTestCFO = step.get("poTestCFO");
                 				testStep = poTestCFO != null;
                 				if(testStep)
                 				{
                 					if(role.Role_Name != "CFO")
                 					{
                 						result.put("error","PO test override must use the CFO role.");
                 						return result;
                 					}
                 					personId = poTestCFO.get("userAccessId").toLong();
                 					assignmentActive = true;
                 					reason = "PO test CFO";
                 				}
                 				else if(territoryDevMgr)
                 				{
                 					territoryRecord = Territory[Territory_Name == territory];
                 					if(territoryRecord.count() != 1)
                 					{
                 						result.put("error","The territory must identify one Territory record with Dev Mgr users.");
                 						return result;
                 					}
                 					for each  devMgrPerson in territoryRecord.Dev_Mgr
                 					{
                 						if(!personIds.contains(devMgrPerson.ID))
                 						{
                 							personIds.add(devMgrPerson.ID);
                 						}
                 					}
                 					if(personIds.size() == 0)
                 					{
                 						result.put("error","Configure at least one Dev Mgr on the Territory record.");
                 						return result;
                 					}
                 					assignmentActive = true;
                 				}
                 				else if(territoryVP)
                 				{
                 					territoryRecord = Territory[Territory_Name == territory];
                 					if(territoryRecord.count() != 1)
                 					{
                 						result.put("error","The territory must identify one Territory record with a VP.");
                 						return result;
                 					}
                 					vpIds = List();
                 					for each  vpPerson in territoryRecord.VP
                 					{
                 						if(!vpIds.contains(vpPerson.ID))
                 						{
                 							vpIds.add(vpPerson.ID);
                 						}
                 					}
                 					if(vpIds.size() != 1)
                 					{
                 						result.put("error","Configure exactly one VP on the Territory record.");
                 						return result;
                 					}
                 					personId = vpIds.get(0);
                 					assignmentActive = true;
                 				}
                 				else
                 				{
                 					for each  assignment in Approval_Role_Assignment[Role == role.ID]
                 					{
                 						aTerritory = ifnull(assignment.Territory_Key,"");
                 						aDepartment = ifnull(assignment.Department_Key,"");
                 						aValid = true;
                 						if(aTerritory != "" && aTerritory != territory)
                 						{
                 							aValid = false;
                 						}
                 						if(aDepartment != "" && aDepartment != department)
                 						{
                 							aValid = false;
                 						}
                 						if(aValid)
                 						{
                 							rank = 0;
                 							if(aTerritory != "")
                 							{
                 								rank = rank + 4;
                 							}
                 							if(aDepartment != "")
                 							{
                 								rank = rank + 2;
                 							}
                 							if(rank > assignmentRank)
                 							{
                 								assignmentRank = rank;
                 								assignmentId = assignment.ID;
                 								assignmentCount = 1;
                 							}
                 							else if(rank == assignmentRank)
                 							{
                 								assignmentCount = assignmentCount + 1;
                 							}
                 						}
                 					}
                 					if(assignmentCount != 1)
                 					{
                 						result.put("error","Assignment for " + role.Role_Name + " is missing or ambiguous at the highest applicable scope.");
                 						return result;
                 					}
                 					assignment = Approval_Role_Assignment[ID == assignmentId];
                 					personId = assignment.Person;
                 					assignmentActive = assignment.Active == true;
                 				}
                 				if(!territoryDevMgr)
                 				{
                 					personIds.add(personId);
                 				}
                 				for each  routePersonId in personIds
                 				{
                 					person = User_Access[ID == routePersonId];
                 					email = ifnull(person.Approver_Email,"").trim();
                 					if(testStep)
                 					{
                 						if(ifnull(person.User,"").toString().trim() == "")
                 						{
                 							result.put("error","PO test CFO login identity is unavailable.");
                 							return result;
                 						}
                 						email = poTestCFO.get("email").toString();
                 					}
                 					routingEnabled = person.Approval_Routing_Enabled == true;
                 					if(testStep)
                 					{
                 						routingEnabled = true;
                 					}
                 					if(assignmentActive != true || person.ID == null || routingEnabled != true || ifnull(person.User,"").toString().trim() == "" || !email.matches("[^ @]+@[^ @]+[.][^ @]+"))
                 					{
                 						result.put("error","Approver for " + role.Role_Name + " is inactive or has no valid Approver Email.");
                 						return result;
                 					}
                 					assignmentText = assignmentId.toString();
                 					if(territoryVP || territoryDevMgr || testStep)
                 					{
                 						assignmentText = "";
                 					}
                 					resolvedKey = step.get("key");
                 					if(territoryDevMgr && personIds.size() > 1)
                 					{
                 						resolvedKey = resolvedKey + "-" + person.ID.toString();
                 					}
                 					resolvedStep = {"order":route.size() + 1,"policyStepOrder":expectedOrder,"key":resolvedKey,"roleId":role.ID.toString(),"role":role.Role_Name,"assignmentId":assignmentText,"userAccessId":person.ID.toString(),"name":ifnull(person.Full_Name,""),"email":email,"reason":reason};
                 					if(testStep)
                 					{
                 						resolvedStep.put("poTestCFO",poTestCFO);
                 					}
                 					route.add(resolvedStep);
                 				}
                 			}
                 		}
                 		if(policy.Workflow == "Purchase Order" && cfoSteps != 1)
                 		{
                 			result.put("error","Exactly one CFO must approve every purchase order.");
                 			return result;
                 		}
                 		if(route.size() == 0)
                 		{
                 			result.put("error","No enabled applicable approval steps.");
                 			return result;
                 		}
                 		result.put("snapshot",{"policyId":policy.ID.toString(),"context":context,"route":route,"excluded":excluded,"selfApproval":effectiveSelfApproval});
                 		result.put("success",true);
                 	}	catch (e)
                 	{
                 		result.put("error","Approval configuration is invalid. Check scope, approvers and exact amounts.");
                 	}
                 	return result;
                 }
				 string Review_LOI_Request(string proformaId, string tokenId, string decision, string legalNote)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		if(ifnull(decision,"").trim().toUpperCase() == "CHECK_REJECT")
                 		{
                 			checkStatus = ifnull(pf.LOI_Legal_Status,"").trim();
                 			checkNote = ifnull(legalNote,"").trim();
                 			checkToken = ifnull(tokenId,"").trim();
                 			if(checkStatus == "Pending Approval" && checkToken == "" || checkToken != ifnull(pf.LOI_Approval_Token,"").trim())
                 			{
                 				result.put("success",false);
                 				result.put("message","The LOI approval token is invalid or expired.");
                 				return result.toString();
                 			}
                 			if(checkStatus == "Rejected" && checkNote == "" || checkNote != ifnull(pf.LOI_Legal_Note,"").trim())
                 			{
                 				result.put("success",false);
                 				result.put("message","The rejection note did not match this LOI.");
                 				return result.toString();
                 			}
                 			result.put("success",true);
                 			result.put("proformaId",pf.ID.toString());
                 			result.put("status",checkStatus);
                 			result.put("noteMatches",checkStatus == "Rejected" && checkNote == ifnull(pf.LOI_Legal_Note,"").trim());
                 			result.put("tokenCleared",ifnull(pf.LOI_Approval_Token,"").trim() == "");
                 			return result.toString();
                 		}
                 		if(ifnull(pf.LOI_Legal_Status,"") != "Pending Approval")
                 		{
                 			result.put("success",false);
                 			result.put("message","This LOI is no longer pending Legal approval.");
                 			result.put("status",ifnull(pf.LOI_Legal_Status,""));
                 			return result.toString();
                 		}
                 		if(tokenId == null || tokenId.trim() == "" || ifnull(pf.LOI_Approval_Token,"") != tokenId.trim())
                 		{
                 			result.put("success",false);
                 			result.put("message","The LOI approval token is invalid or expired.");
                 			return result.toString();
                 		}
                 		decisionValue = ifnull(decision,"").trim().toUpperCase();
                 		noteValue = ifnull(legalNote,"").trim();
                 		if(decisionValue == "REJECT")
                 		{
                 			if(noteValue == "")
                 			{
                 				result.put("success",false);
                 				result.put("message","Enter a Legal note before rejecting the LOI.");
                 				return result.toString();
                 			}
                 			pf.LOI_Legal_Status="Rejected";
                 			pf.LOI_Legal_Note=noteValue;
                 			pf.LOI_Approval_Token="";
                 			notificationSent = false;
                 			if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 			{
                 				sendmail
                 				[
                 					from :"Notifications@wbdevelopment.com"
                 					to :pf.Acquisition_Email
                 					subject :"LOI Rejected by Legal - " + ifnull(pf.Name,"Pro Forma")
                 					message :"Legal rejected the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b>.<br><br><b>Legal note:</b><br>" + noteValue
                 				]
                 				notificationSent = true;
                 			}
                 			result.put("success",true);
                 			result.put("decision","REJECT");
                 			result.put("message","LOI rejected and returned to the Pro Forma.");
                 			result.put("proformaId",pf.ID.toString());
                 			result.put("notificationSent",notificationSent);
                 			result.put("notificationAddress",ifnull(pf.Acquisition_Email,"").trim());
                 			return result.toString();
                 		}
                 		if(decisionValue != "APPROVE")
                 		{
                 			result.put("success",false);
                 			result.put("message","Decision must be APPROVE or REJECT.");
                 			return result.toString();
                 		}
                 		// Call the existing function that generates the Writer document,
                 		// creates/reuses the Acquisition Contract, and attaches Attachment.
                 		contractResultText = thisapp.Create_LOI_Contract(proformaId);
                 		contractResult = contractResultText.toMap();
                 		contractSuccess = contractResult.get("success");
                 		if(contractSuccess != true && contractSuccess.toString() != "true")
                 		{
                 			result.put("success",false);
                 			result.put("message",ifnull(contractResult.get("message"),"Create_LOI_Contract did not complete successfully."));
                 			result.put("contractResult",contractResult);
                 			return result.toString();
                 		}
                 		contractIdText = contractResult.get("contractId").toString();
                 		pf.LOI_Legal_Status="Approved";
                 		pf.LOI_Legal_Note=noteValue;
                 		pf.LOI_Approval_Token="";
                 		pf.LOI_Contract=contractIdText.toLong();
                 		if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :pf.Acquisition_Email
                 				subject :"LOI Approved by Legal - " + ifnull(pf.Name,"Pro Forma")
                 				message :"Legal approved the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b> and Contract <b>" + contractIdText + "</b> was created.<br><br><b>Legal note:</b><br>" + if(noteValue == "","No note entered.",noteValue)
                 			]
                 		}
                 		result.put("success",true);
                 		result.put("decision","APPROVE");
                 		result.put("message","LOI approved and Contract created.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("contractId",contractIdText);
                 		result.put("contractVersionId",contractResult.get("contractVersionId"));
                 		result.put("contractUrl",contractResult.get("contractUrl"));
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI review failed at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		return result.toString();
                 	}
                 	return "nice";
                 }
				 string sendApprovalEmail(int budgetId, int approvalId)
                 {
                 	/********* SEND ONE APPROVAL EMAIL *********/
                 	// Return Type: string
                 	// Sends the approval email for one specific Budget_Approvals row.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalId = approvalId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalId == 0)
                 	{
                 		return "No Approval ID provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	approvalRows = Budget_Approvals[ID == vApprovalId];
                 	if(approvalRows.count() == 0)
                 	{
                 		return "Approval row not found.";
                 	}
                 	approvalRec = null;
                 	for each  ar in approvalRows
                 	{
                 		approvalRec = ar;
                 	}
                 	approverEmail = ifnull(approvalRec.Approver,"").trim();
                 	approvalRole = ifnull(approvalRec.Title,"").trim();
                 	approvalType = ifnull(approvalRec.Type1,"").trim();
                 	if(approvalType == "Purchase Order")
                 	{
                 		return "Purchase Orders use the combined PO email. Open the PO to check or retry its notification.";
                 	}
                 	approvalSortOrder = ifnull(approvalRec.Sort_Order,0).toLong();
                 	if(approverEmail == "")
                 	{
                 		return "No approver email found for " + approvalType + " " + approvalRole + ".";
                 	}
                 	if(approvalRole == "")
                 	{
                 		return "No approval role found.";
                 	}
                 	if(approvalType == "")
                 	{
                 		return "No approval type found.";
                 	}
                 	// ============================================================
                 	// FIND THE APPROVAL NOTES THAT SHOULD APPEAR IN THIS EMAIL
                 	//
                 	// Forward approval:
                 	//     Pull notes from the immediately previous approved row.
                 	//
                 	// Rejection:
                 	//     Pull notes from the immediately next rejected row.
                 	// ============================================================
                 	previousApprovalRec = null;
                 	nextApprovalRec = null;
                 	previousSortOrder = -1;
                 	nextSortOrder = 999999;
                 	trackApprovalRows = Budget_Approvals[Budget == vBudgetId && Type1 == approvalType];
                 	for each  trackRow in trackApprovalRows
                 	{
                 		trackSortOrder = ifnull(trackRow.Sort_Order,0).toLong();
                 		if(trackSortOrder < approvalSortOrder && trackSortOrder > previousSortOrder)
                 		{
                 			previousApprovalRec = trackRow;
                 			previousSortOrder = trackSortOrder;
                 		}
                 		if(trackSortOrder > approvalSortOrder && trackSortOrder < nextSortOrder)
                 		{
                 			nextApprovalRec = trackRow;
                 			nextSortOrder = trackSortOrder;
                 		}
                 	}
                 	approvalNotes = "";
                 	notesSourceRole = "";
                 	notesHeading = "Approval Notes";
                 	notesContext = "";
                 	// Check rejection first because the email is being routed backward.
                 	if(nextApprovalRec != null && ifnull(nextApprovalRec.Status,"").trim() == "Rejected")
                 	{
                 		approvalNotes = ifnull(nextApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(nextApprovalRec.Title,"").trim();
                 		notesHeading = "Rejection Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the rejecting approver";
                 		}
                 	}
                 	else if(previousApprovalRec != null && ifnull(previousApprovalRec.Status,"").trim() == "Approved")
                 	{
                 		approvalNotes = ifnull(previousApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(previousApprovalRec.Title,"").trim();
                 		notesHeading = "Approval Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the previous approver";
                 		}
                 	}
                 	else
                 	{
                 		notesContext = "No previous approval response";
                 	}
                 	if(approvalNotes == "")
                 	{
                 		approvalNotes = "No notes were provided.";
                 	}
                 	// Basic HTML escaping for approval notes.
                 	approvalNotesSafe = approvalNotes;
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("&","&amp;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("<","&lt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll(">","&gt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\r\n","<br>");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\n","<br>");
                 	notesHeadingSafe = notesHeading;
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("&","&amp;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("<","&lt;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll(">","&gt;");
                 	notesContextSafe = notesContext;
                 	notesContextSafe = notesContextSafe.replaceAll("&","&amp;");
                 	notesContextSafe = notesContextSafe.replaceAll("<","&lt;");
                 	notesContextSafe = notesContextSafe.replaceAll(">","&gt;");
                 	// Internal app URL for the Budget Management page hosting the widget.
                 	widgetPageUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Budget_Management1";
                 	// Verified sender for all approval emails.
                 	fromAddress = "Notifications@wbdevelopment.com";
                 	// Build budget display info.
                 	budgetName = ifnull(budgetRec.Budget_Name,"Budget Review");
                 	projectName = ifnull(budgetRec.Project,"");
                 	phaseName = ifnull(budgetRec.Phase,"");
                 	subdivisionCode = ifnull(budgetRec.Subdivision_Code,"");
                 	subdivisionName = "";
                 	territoryText = "";
                 	if(budgetRec.Subdivision1 != null)
                 	{
                 		subdivisionName = ifnull(budgetRec.Subdivision1.Subdivision_Name,"");
                 		territoryText = ifnull(budgetRec.Subdivision1.Territory,"");
                 	}
                 	budgetLabel = budgetName;
                 	if(projectName != "" && phaseName != "")
                 	{
                 		budgetLabel = projectName + " - " + phaseName + " - " + budgetName;
                 	}
                 	else if(projectName != "")
                 	{
                 		budgetLabel = projectName + " - " + budgetName;
                 	}
                 	if(subdivisionName != "")
                 	{
                 		budgetLabel = subdivisionName + " - " + budgetName;
                 	}
                 	// Basic HTML escaping.
                 	budgetLabelSafe = budgetLabel;
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("&","&amp;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("<","&lt;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll(">","&gt;");
                 	subdivisionCodeSafe = subdivisionCode;
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("&","&amp;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("<","&lt;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll(">","&gt;");
                 	territorySafe = territoryText;
                 	territorySafe = territorySafe.replaceAll("&","&amp;");
                 	territorySafe = territorySafe.replaceAll("<","&lt;");
                 	territorySafe = territorySafe.replaceAll(">","&gt;");
                 	// Deep link to the widget page, opening directly to this budget.
                 	approvalUrl = widgetPageUrl + "?budgetId=" + vBudgetId;
                 	emailSubject = approvalType + " Budget Approval Needed - " + budgetLabel;
                 	emailBody = "";
                 	emailBody = emailBody + "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 	emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Approval Needed</h2>";
                 	emailBody = emailBody + "<p style='margin:0 0 16px 0;'>A <b>" + approvalType + "</b> budget approval is ready for your review as <b>" + approvalRole + "</b>.</p>";
                 	// Budget information card.
                 	emailBody = emailBody + "<div style='background:#f8fafc;border:1px solid #dbe4f0;border-radius:10px;padding:14px 16px;margin:0 0 14px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;color:#64748b;margin-bottom:4px;'>Budget</div>";
                 	emailBody = emailBody + "<div style='font-size:16px;font-weight:700;color:#0f2744;'>" + budgetLabelSafe + "</div>";
                 	if(subdivisionCodeSafe != "" || territorySafe != "")
                 	{
                 		emailBody = emailBody + "<div style='margin-top:10px;font-size:13px;color:#475569;'>";
                 		if(subdivisionCodeSafe != "")
                 		{
                 			emailBody = emailBody + "<b>Subdivision Code:</b> " + subdivisionCodeSafe;
                 		}
                 		if(subdivisionCodeSafe != "" && territorySafe != "")
                 		{
                 			emailBody = emailBody + " &nbsp; | &nbsp; ";
                 		}
                 		if(territorySafe != "")
                 		{
                 			emailBody = emailBody + "<b>Territory:</b> " + territorySafe;
                 		}
                 		emailBody = emailBody + "</div>";
                 	}
                 	emailBody = emailBody + "</div>";
                 	// Approval or rejection notes card.
                 	emailBody = emailBody + "<div style='background:#fffdf5;border:1px solid #e7d9a8;border-left:4px solid #c79a22;border-radius:10px;padding:14px 16px;margin:0 0 18px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;font-weight:700;color:#785b12;margin-bottom:2px;'>" + notesHeadingSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:12px;color:#8a6d22;margin-bottom:8px;'>" + notesContextSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:14px;color:#334155;white-space:normal;'>" + approvalNotesSafe + "</div>";
                 	emailBody = emailBody + "</div>";
                 	emailBody = emailBody + "<a href='" + approvalUrl + "' style='display:inline-block;background:#1e40af;color:#ffffff;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;'>Open Approval Page</a>";
                 	emailBody = emailBody + "<p style='margin:18px 0 0 0;font-size:12px;color:#64748b;'>If the button does not work, copy and paste this link into your browser:<br>";
                 	emailBody = emailBody + "<span style='word-break:break-all;color:#1e40af;'>" + approvalUrl + "</span></p>";
                 	emailBody = emailBody + "</div>";
                 	sendmail
                 	[
                 		from :fromAddress
                 		to :approverEmail
                 		subject :emailSubject
                 		message :emailBody
                 	]
                 	// Mark sent date after successful send.
                 	approvalRec.Sent_Date=zoho.currentdate;
                 	return "Email sent to " + approverEmail + " for " + approvalType + " " + approvalRole + ".";
                 }
				 string sendApprovalReminders()
                 {
                 	/********* PENDING APPROVAL REMINDERS *********/
                 	// Return Type: string
                 	// Runs daily from a schedule.
                 	//
                 	// Two passes:
                 	//   1. CONTRACT approvals - every Contract_Approvals row still Awaiting
                 	//      Approval whose own Next_Reminder_Date has arrived gets the styled
                 	//      approval email again (Send_Contract_Approval_Email in "Reminder"
                 	//      mode, which re-stamps Last/Next_Reminder_Date from the row's
                 	//      Reminder_Interval_Days). This pass runs EVERY day: the cadence lives
                 	//      on each row, not on Settings.
                 	//   2. BUDGET / PRO FORMA / MODIFICATION approvals - unchanged: does nothing
                 	//      until Settings.Next_Approval_Reminder_Date has arrived, then re-sends
                 	//      for every Budget_Approvals row still Pending and pushes the next date
                 	//      out by Settings.Approval_Reminder_Interval_Days (default 3).
                 	//
                 	// Every run that sends anything emails rbelliveau@wbdevelopment.com a recap
                 	// table (type, recipient, role, item). A day with nothing due stays silent.
                 	today = zoho.currentdate;
                 	tdStyle = "padding:6px 10px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#0f2744;";
                 	thStyle = "padding:7px 10px;text-align:left;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#5c7394;border-bottom:2px solid #cbd5e1;";
                 	/********* PASS 1: CONTRACT APPROVALS *********/
                 	contractCount = 0;
                 	contractFailed = 0;
                 	contractRows = "";
                 	dueContractApprovals = Contract_Approvals[Status == "Awaiting Approval" && Next_Reminder_Date <= today && Contract1 != null];
                 	for each  ca in dueContractApprovals
                 	{
                 		if(ifnull(ca.Contract1.Work_Module,"") != "Construction")
                 		{
                 			ctResp = thisapp.Send_Contract_Approval_Email(ca.Contract1.ID.toString(),ca.ID.toString(),"Reminder");
                 			if(ifnull(ctResp.get("success"),false) == true)
                 			{
                 				contractCount = contractCount + 1;
                 				itemLabel = ifnull(ca.Contract1.Contract_Name,"").trim();
                 				if(itemLabel == "")
                 				{
                 					itemLabel = "Contract " + ca.Contract1.ID;
                 				}
                 				contractRows = contractRows + "<tr><td style='" + tdStyle + "'>Contract</td><td style='" + tdStyle + "'>" + ifnull(ca.Approver,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ca.Type1,"") + "</td><td style='" + tdStyle + "'>" + itemLabel + "</td></tr>";
                 			}
                 			else
                 			{
                 				contractFailed = contractFailed + 1;
                 				contractRows = contractRows + "<tr><td style='" + tdStyle + "color:#b91c1c;'>Contract (failed)</td><td style='" + tdStyle + "'>" + ifnull(ca.Approver,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ca.Type1,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ctResp.get("message"),"") + "</td></tr>";
                 			}
                 		}
                 	}
                 	/********* PASS 2: BUDGET / PRO FORMA / MODIFICATION (Settings gate) *********/
                 	settingsRec = Settings[ID != 0];
                 	if(settingsRec == null)
                 	{
                 		return "No Settings record found.";
                 	}
                 	vInterval = ifnull(settingsRec.Approval_Reminder_Interval_Days,0).toLong();
                 	if(vInterval <= 0)
                 	{
                 		vInterval = 3;
                 	}
                 	vNext = settingsRec.Next_Approval_Reminder_Date;
                 	budgetDue = true;
                 	notDueNote = "";
                 	if(vNext == null)
                 	{
                 		// First run: arm the schedule without blasting reminders immediately.
                 		settingsRec.Next_Approval_Reminder_Date=today.addDay(vInterval);
                 		budgetDue = false;
                 		notDueNote = "Budget reminder date was empty; armed for " + today.addDay(vInterval).toString() + ".";
                 	}
                 	else if(vNext > today)
                 	{
                 		budgetDue = false;
                 		notDueNote = "Budget reminders not due yet. Next reminder " + vNext.toString() + ".";
                 	}
                 	budgetCount = 0;
                 	proformaCount = 0;
                 	modCount = 0;
                 	skipped = 0;
                 	recapRows = "";
                 	newNext = vNext;
                 	if(budgetDue)
                 	{
                 		pendingRows = Budget_Approvals[Status == "Pending"];
                 		for each  row in pendingRows
                 		{
                 			rowType = ifnull(row.Type1,"").trim();
                 			if(rowType == "Purchase Order")
                 			{
                 				continue;
                 			}
                 			approverEmail = ifnull(row.Approver,"").trim();
                 			approverRole = ifnull(row.Title,"").trim();
                 			sentThis = false;
                 			displayType = rowType;
                 			itemLabel = "";
                 			if(rowType == "Modification")
                 			{
                 				if(row.Budget_Modification != null)
                 				{
                 					modMsg = thisapp.sendModificationEmail(row.Budget_Modification.ID,"created");
                 					modCount = modCount + 1;
                 					sentThis = true;
                 					itemLabel = ifnull(row.Budget_Modification.Reference_Number,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Modification " + row.Budget_Modification.ID;
                 					}
                 					if(row.Budget != null)
                 					{
                 						itemLabel = itemLabel + " (" + ifnull(row.Budget.Budget_Name,"") + ")";
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			else if(rowType == "Pro Forma")
                 			{
                 				if(row.Proforma != null)
                 				{
                 					pfMsg = thisapp.Send_Proforma_Approval_Email(row.Proforma.ID.toString(),row.ID.toString());
                 					proformaCount = proformaCount + 1;
                 					sentThis = true;
                 					itemLabel = ifnull(row.Proforma.Name,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Pro Forma " + row.Proforma.ID;
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			else
                 			{
                 				if(row.Budget != null)
                 				{
                 					budgetMsg = thisapp.sendApprovalEmail(row.Budget.ID,row.ID);
                 					budgetCount = budgetCount + 1;
                 					sentThis = true;
                 					if(displayType == "")
                 					{
                 						displayType = "Budget";
                 					}
                 					itemLabel = ifnull(row.Budget.Budget_Name,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Budget " + row.Budget.ID;
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			if(sentThis)
                 			{
                 				recapRows = recapRows + "<tr><td style='" + tdStyle + "'>" + displayType + "</td><td style='" + tdStyle + "'>" + approverEmail + "</td><td style='" + tdStyle + "'>" + approverRole + "</td><td style='" + tdStyle + "'>" + itemLabel + "</td></tr>";
                 			}
                 		}
                 		newNext = today.addDay(vInterval);
                 		settingsRec.Next_Approval_Reminder_Date=newNext;
                 	}
                 	/********* RECAP *********/
                 	totalSent = budgetCount + proformaCount + modCount + contractCount;
                 	if(totalSent == 0 && contractFailed == 0)
                 	{
                 		if(budgetDue)
                 		{
                 			// Due day with nothing pending: say so, as before.
                 			recapBody = "<div style='font-family:Arial,Helvetica,sans-serif;'>";
                 			recapBody = recapBody + "<h3 style='margin:0 0 4px 0;color:#0b2345;'>Approval reminders " + today.toString() + "</h3>";
                 			recapBody = recapBody + "<p style='margin:0 0 14px 0;font-size:13px;color:#475569;'>No pending approvals needed reminders. Next budget reminder " + newNext.toString() + ".</p></div>";
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :"rbelliveau@wbdevelopment.com"
                 				subject :"Approval reminders: nothing to send"
                 				message :recapBody
                 			]
                 			return "OK: nothing to send. Next budget reminder " + newNext.toString() + ".";
                 		}
                 		return notDueNote + " No contract reminders were due.";
                 	}
                 	skippedNote = "";
                 	if(skipped > 0)
                 	{
                 		skippedNote = " " + skipped + " pending row(s) were skipped (missing linked record).";
                 	}
                 	if(contractFailed > 0)
                 	{
                 		skippedNote = skippedNote + " " + contractFailed + " contract reminder(s) failed to send.";
                 	}
                 	recapBody = "<div style='font-family:Arial,Helvetica,sans-serif;'>";
                 	recapBody = recapBody + "<h3 style='margin:0 0 4px 0;color:#0b2345;'>Approval reminders " + today.toString() + "</h3>";
                 	summaryLine = totalSent + " reminder(s) - contracts " + contractCount + ", budgets " + budgetCount + ", pro formas " + proformaCount + ", modifications " + modCount + "." + skippedNote;
                 	if(budgetDue)
                 	{
                 		summaryLine = summaryLine + " Next budget reminder " + newNext.toString() + ".";
                 	}
                 	else
                 	{
                 		summaryLine = summaryLine + " " + notDueNote;
                 	}
                 	recapBody = recapBody + "<p style='margin:0 0 14px 0;font-size:13px;color:#475569;'>" + summaryLine + "</p>";
                 	recapBody = recapBody + "<table style='border-collapse:collapse;width:100%;max-width:720px;'><tr><th style='" + thStyle + "'>Type</th><th style='" + thStyle + "'>Sent To</th><th style='" + thStyle + "'>Role / Step</th><th style='" + thStyle + "'>Item</th></tr>";
                 	recapBody = recapBody + contractRows + recapRows + "</table></div>";
                 	emailSubject = "Approval reminders sent: " + totalSent + " (contracts " + contractCount + ", budgets " + budgetCount + ", pro formas " + proformaCount + ", mods " + modCount + ")";
                 	sendmail
                 	[
                 		from :"Notifications@wbdevelopment.com"
                 		to :"rbelliveau@wbdevelopment.com"
                 		subject :emailSubject
                 		message :recapBody
                 	]
                 	return "OK: reminders sent - contracts=" + contractCount + ", budgets=" + budgetCount + ", proformas=" + proformaCount + ", modifications=" + modCount + ", skipped=" + skipped + ", contractFailed=" + contractFailed + ".";
                 }
				 string sendModificationEmail(int modificationId, string action)
                 {
                 	/********* BUDGET MODIFICATION EMAIL *********/
                 	// Return Type: string
                 	// Sends the email that accompanies a Budget Modification lifecycle event.
                 	// action: "created" | "approved" | "rejected"
                 	// Approval rows live in Budget_Approvals with Type1 == "Modification" and a
                 	// Budget_Modification lookup back to the modification record.
                 	vModId = modificationId.toLong();
                 	vAction = ifnull(action,"").trim().toLowerCase();
                 	if(vModId == 0)
                 	{
                 		return "No Modification ID provided.";
                 	}
                 	if(vAction != "created" && vAction != "approved" && vAction != "rejected")
                 	{
                 		return "Unknown action: " + vAction;
                 	}
                 	modRec = Budget_Modification[ID == vModId];
                 	if(ifnull(modRec.Reference_Number,"").startsWith("PO:"))
                 	{
                 		return "ERROR: This modification uses the combined Purchase Order approval chain.";
                 	}
                 	if(modRec == null)
                 	{
                 		return "Modification not found.";
                 	}
                 	// Self-heal: an emailed modification is by definition in the approval flow.
                 	if(vAction == "created" && ifnull(modRec.Status,"") != "Submitted")
                 	{
                 		modRec.Status="Submitted";
                 	}
                 	// ---- Modification display data ----
                 	modType = ifnull(modRec.Modification_Type,"").trim();
                 	modAmount = ifnull(modRec.Amount,0.0);
                 	modReason = ifnull(modRec.Reason,"").trim();
                 	modRef = ifnull(modRec.Reference_Number,"").trim();
                 	itemName = "";
                 	if(modRec.Budget_Item != null)
                 	{
                 		itemName = ifnull(modRec.Budget_Item.Item_Name,"");
                 	}
                 	budgetLabel = "";
                 	vBudgetId = 0;
                 	if(modRec.Budget != null)
                 	{
                 		budgetLabel = ifnull(modRec.Budget.Budget_Name,"");
                 		vBudgetId = modRec.Budget.ID;
                 	}
                 	signPrefix = "+";
                 	if(modType == "Decrease")
                 	{
                 		signPrefix = "-";
                 	}
                 	amountText = signPrefix + "$" + modAmount.toString();
                 	// ---- HTML escaping ----
                 	itemNameSafe = itemName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	budgetLabelSafe = budgetLabel.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	modReasonSafe = modReason.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	modReasonSafe = modReasonSafe.replaceAll("\r\n","<br>").replaceAll("\n","<br>");
                 	modRefSafe = modRef.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	if(modReasonSafe == "")
                 	{
                 		modReasonSafe = "No reason was provided.";
                 	}
                 	// ---- Chain rows for this modification ----
                 	nextApprovalRec = null;
                 	nextSortOrder = 999999;
                 	approvedRoles = "";
                 	chainRows = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"];
                 	for each  chainRow in chainRows
                 	{
                 		rowStatus = ifnull(chainRow.Status,"").trim();
                 		rowSort = ifnull(chainRow.Sort_Order,0).toLong();
                 		candidateStatus = rowStatus == "Pending" || rowStatus == "Not Sent";
                 		if(candidateStatus && rowSort < nextSortOrder)
                 		{
                 			nextApprovalRec = chainRow;
                 			nextSortOrder = rowSort;
                 		}
                 		if(rowStatus == "Approved")
                 		{
                 			if(approvedRoles != "")
                 			{
                 				approvedRoles = approvedRoles + ", ";
                 			}
                 			approvedRoles = approvedRoles + ifnull(chainRow.Title,"");
                 		}
                 	}
                 	// Internal app URL for the Budget Management page hosting the widget.
                 	widgetPageUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Budget_Management1";
                 	approvalUrl = widgetPageUrl + "?budgetId=" + vBudgetId + "&modificationId=" + vModId;
                 	// Verified sender for all approval emails.
                 	fromAddress = "Notifications@wbdevelopment.com";
                 	// ---- Shared detail card ----
                 	detailCard = "<div style='background:#f8fafc;border:1px solid #dbe4f0;border-radius:10px;padding:14px 16px;margin:0 0 14px 0;'>";
                 	detailCard = detailCard + "<div style='font-size:13px;color:#64748b;margin-bottom:4px;'>Budget Modification</div>";
                 	detailCard = detailCard + "<div style='font-size:16px;font-weight:700;color:#0f2744;'>" + budgetLabelSafe + " &mdash; " + itemNameSafe + "</div>";
                 	detailCard = detailCard + "<div style='margin-top:10px;font-size:14px;color:#334155;'><b>" + modType + ":</b> " + amountText;
                 	if(modRefSafe != "")
                 	{
                 		detailCard = detailCard + " &nbsp; | &nbsp; <b>Reference:</b> " + modRefSafe;
                 	}
                 	detailCard = detailCard + "</div>";
                 	detailCard = detailCard + "<div style='margin-top:8px;font-size:13px;color:#475569;'><b>Reason:</b> " + modReasonSafe + "</div>";
                 	detailCard = detailCard + "</div>";
                 	linkBlock = "<a href='" + approvalUrl + "' style='display:inline-block;background:#1e40af;color:#ffffff;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;'>Open Budget Page</a>";
                 	linkBlock = linkBlock + "<p style='margin:18px 0 0 0;font-size:12px;color:#64748b;'>If the button does not work, copy and paste this link into your browser:<br>";
                 	linkBlock = linkBlock + "<span style='word-break:break-all;color:#1e40af;'>" + approvalUrl + "</span></p>";
                 	// ---- created / approved: notify the next pending approver ----
                 	if(vAction == "created" || vAction == "approved")
                 	{
                 		if(nextApprovalRec != null)
                 		{
                 			approverEmail = ifnull(nextApprovalRec.Approver,"").trim();
                 			approverRole = ifnull(nextApprovalRec.Title,"").trim();
                 			if(approverEmail == "")
                 			{
                 				return "No approver email found for the next Modification approval.";
                 			}
                 			emailSubject = "Modification Approval Needed - " + budgetLabel + " - " + itemName;
                 			emailBody = "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 			emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Modification Approval Needed</h2>";
                 			emailBody = emailBody + "<p style='margin:0 0 16px 0;'>An after-finalization <b>budget modification</b> is ready for your review as <b>" + approverRole + "</b>.</p>";
                 			emailBody = emailBody + detailCard + linkBlock + "</div>";
                 			sendmail
                 			[
                 				from :fromAddress
                 				to :approverEmail
                 				subject :emailSubject
                 				message :emailBody
                 			]
                 			nextApprovalRec.Status="Pending";
                 			nextApprovalRec.Sent_Date=zoho.currentdate;
                 			return "Modification email sent to " + approverEmail + " (" + approverRole + ").";
                 		}
                 		if(vAction == "approved")
                 		{
                 			// No pending approver remains: the chain is complete.
                 			modRec.Status="Approved";
                 			modRec.Approved_On=zoho.currenttime;
                 			modRec.Approved_By=approvedRoles;
                 			// Roll the newly approved delta into the item's Revised_Final field.
                 			if(modRec.Budget_Item != null)
                 			{
                 				recalcMsg = thisapp.recalcItemRevisedFinal(modRec.Budget_Item.ID);
                 			}
                 			// Roll it up to the category + budget Modified Final totals.
                 			if(vBudgetId != 0)
                 			{
                 				rollupMsg = thisapp.recalcBudgetModifiedTotals(vBudgetId);
                 			}
                 			return "Modification fully approved (" + approvedRoles + ").";
                 		}
                 		return "No approver rows found for this modification.";
                 	}
                 	// ---- rejected: stamp the record and notify approvers who had approved ----
                 	if(vAction == "rejected")
                 	{
                 		modRec.Status="Rejected";
                 		notifiedList = "";
                 		for each  chainRow2 in chainRows
                 		{
                 			rowStatus2 = ifnull(chainRow2.Status,"").trim();
                 			rowEmail2 = ifnull(chainRow2.Approver,"").trim();
                 			if(rowStatus2 == "Approved" && rowEmail2 != "")
                 			{
                 				emailSubject2 = "Modification Rejected - " + budgetLabel + " - " + itemName;
                 				emailBody2 = "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 				emailBody2 = emailBody2 + "<h2 style='margin:0 0 8px 0;color:#8f221c;'>Budget Modification Rejected</h2>";
                 				emailBody2 = emailBody2 + "<p style='margin:0 0 16px 0;'>A budget modification you had approved was <b>rejected</b> later in the chain.</p>";
                 				emailBody2 = emailBody2 + detailCard + linkBlock + "</div>";
                 				sendmail
                 				[
                 					from :fromAddress
                 					to :rowEmail2
                 					subject :emailSubject2
                 					message :emailBody2
                 				]
                 				if(notifiedList != "")
                 				{
                 					notifiedList = notifiedList + ", ";
                 				}
                 				notifiedList = notifiedList + rowEmail2;
                 			}
                 		}
                 		if(notifiedList == "")
                 		{
                 			return "Modification marked Rejected. No prior approvers to notify.";
                 		}
                 		return "Modification marked Rejected. Notified: " + notifiedList + ".";
                 	}
                 	return "No action taken.";
                 }
				 string sendPurchaseOrderEmail(string purchaseOrderId)
                 {
                 	environmentType = thisapp.environment.type;
                 	try 
                 	{
                 		checked = thisapp.poApprovalBundle(purchaseOrderId);
                 		if(checked.get("success") != true)
                 		{
                 			return "ERROR: " + checked.get("error");
                 		}
                 		bundle = checked.get("bundle");
                 		active = bundle.get("active");
                 		if(active.get("id") == null)
                 		{
                 			return "ERROR: No active Purchase Order approver.";
                 		}
                 		approval = Budget_Approvals[ID == active.get("id").toLong()];
                 		if(approval.Sent_Date != null)
                 		{
                 			return "OK: Approval email already recorded.";
                 		}
                 		po = Payment_Request[ID == purchaseOrderId.toLong()];
                 		for each  deletionLock in PO_Phase_Lock[Phase_Key == po.Budget.toString()]
                 		{
                 			if(ifnull(deletionLock.Operation_Token,"").startsWith("delete-"))
                 			{
                 				return "ERROR: PO deletion is in progress. Notification was not sent.";
                 			}
                 		}
                 		if(po.PO_Approval_State != "Pending" || approval.Status != "Pending")
                 		{
                 			return "ERROR: PO approval state changed before notification.";
                 		}
                 		vendor = ifnull(po.Vendor.Vendor_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		phase = ifnull(po.Budget.Budget_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		requestDate = "—";
                 		neededDate = "—";
                 		if(po.Request_Date != null)
                 		{
                 			requestDate = po.Request_Date.toString("MM/dd/yyyy");
                 		}
                 		if(po.Date_Needed != null)
                 		{
                 			neededDate = po.Date_Needed.toString("MM/dd/yyyy");
                 		}
                 		role = ifnull(active.get("role"),"Approver").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		modTotal = 0.00;
                 		for each  modification in bundle.get("modifications")
                 		{
                 			modTotal = modTotal + modification.get("amount").toDecimal();
                 		}
                 		modSummary = "None required";
                 		if(bundle.get("modifications").size() > 0)
                 		{
                 			modSummary = bundle.get("modifications").size() + " modifications · $" + modTotal;
                 		}
                 		// appuri is a relative path; email actions need an absolute Creator URL.
                 		urlEnvironment = environmentType.toString().trim().toLowerCase();
                 		appBase = "https://creatorapp.zoho.com/wbdevelopment";
                 		if(urlEnvironment != "production")
                 		{
                 			if(urlEnvironment != "development" && urlEnvironment != "stage")
                 			{
                 				return "ERROR: PO email environment is unavailable.";
                 			}
                 			appBase = appBase + "/environment/" + urlEnvironment;
                 		}
                 		url = appBase + "/land-master/#Page:Budget_Management1?budgetId=" + po.Budget.toString() + "&purchaseOrderId=" + purchaseOrderId;
                 		body = "<div style='background:#eef3fa;padding:20px;font-family:Arial,sans-serif;color:#17385f'><table role='presentation' cellpadding='0' cellspacing='0' style='width:100%;max-width:640px;margin:auto;background:white;border:1px solid #d5e1ee'><tr><td style='background:#17385f;color:white;padding:18px 22px'><div style='font-size:12px'>PURCHASE ORDER APPROVAL</div><h2 style='font-size:21px;margin:6px 0'>" + phase + "</h2><div>" + vendor + "</div></td></tr><tr><td style='padding:20px 22px'><div style='font-size:28px;font-weight:bold;color:#08745a'>$" + po.PO_Amount_Exact + "</div><p style='margin:8px 0 16px'>Your " + role + " approval is requested.</p><table style='width:100%;font-size:13px;line-height:1.7'><tr><td>PO</td><td align='right'>" + purchaseOrderId + "</td></tr><tr><td>Request date / needed</td><td align='right'>" + requestDate + " / " + neededDate + "</td></tr><tr><td>Line items</td><td align='right'>" + po.PO_Line_Count + "</td></tr><tr><td>Budget modifications</td><td align='right'>" + modSummary + "</td></tr></table><p style='font-size:13px;color:#526982'>Full line details are in the attached Excel file.</p><p style='margin:20px 0 4px'><a href='" + url + "' style='display:inline-block;padding:12px 18px;background:#2256a6;color:white;text-decoration:none;font-weight:bold'>Review purchase order</a></p></td></tr></table></div>";
                 		subjectLine = "Purchase Order Approval · " + ifnull(po.Budget.Budget_Name,"") + " · $" + po.PO_Amount_Exact;
                 		if(environmentType == "Development")
                 		{
                 			subjectLine = "[DEV TEST] " + subjectLine;
                 		}
                 		if(bundle.get("poTestCFO") != null)
                 		{
                 			subjectLine = "[PO TEST] " + subjectLine;
                 			body = "<div style='padding:12px;background:#fff3cd;color:#654d00;font-family:Arial,sans-serif'><b>PO TEST</b> · Temporary CFO approval for this budget only, up to $" + bundle.get("poTestCFO").get("maxAmount") + ". Submitter self-approval is enabled for this captured test route.</div>" + body;
                 		}
                 		workbook = thisapp.poExcelWorkbook(purchaseOrderId);
                 		if(workbook.get("success") != true)
                 		{
                 			return "ERROR: PO Excel attachment could not be generated.";
                 		}
                 		excelFile = workbook.get("content").toFile(workbook.get("filename"));
                 		sendmail
                 		[
                 			from :"Notifications@wbdevelopment.com"
                 			to :approval.Approver
                 			subject :subjectLine
                 			message :body
                 			Attachments :file:excelFile
                 		]
                 		approval.Sent_Date=zoho.currentdate;
                 		if(approval.Sent_Date == null)
                 		{
                 			return "ERROR: Email delivery stamp could not be verified.";
                 		}
                 		return "OK: Combined PO approval email recorded.";
                 	}	catch (emailError)
                 	{
                 		return "ERROR: Combined approval email delivery could not be verified.";
                 	}
                 	return "ERROR: Combined approval email did not finish.";
                 }
				 string Send_Contract_Approvals(string contractId)
                 {
                 	/*  Custom API behind the widget's "Send for Approvals" button.
                 
                 	    Request body (JSON POST):  {"contractId":"<Contract.ID>","user":"name@wbdevelopment.com"}
                 	    Also accepts a bare id when called with thisapp.Send_Contract_Approvals(id).
                 
                 	    A Custom API runs as the publishing admin, so the caller's identity comes
                 	    in the body (the same way Get_User_Access_DEV receives it) and is checked
                 	    against Edit Contracts or Edit Owned Contracts and Actions plus the
                 	    Contract.Owner lookup. Completed contracts remain read-only.
                 
                 	    What it does, per approver whose Email switch is on and who is still
                 	    Not Sent:
                 	      - sends the styled approval email (Send_Contract_Approval_Email), with
                 	        every Attachment whose Email_Attachment is checked attached
                 	      - Status -> Awaiting Approval, Reject_Reason cleared,
                 	        Last/Next_Reminder_Date stamped
                 	    Then Contract.Status -> Awaiting Approvals and Current_Approver -> the
                 	    lowest-sequence approver just emailed.
                 
                 	    Unlike the old "Send for Approvals - Contracts" report action this does
                 	    NOT clear Approval_Email after sending: Status is the gate, so the Email
                 	    switch in the widget keeps meaning "this person is on the email".
                 
                 	    Response (JSON string):
                 	      success      true when at least one email went out
                 	      sent         [approver emails]
                 	      skipped      ["email: reason", ...]
                 	      attachments  number of files attached
                 	      message      one line for the banner                                  */
                 	resp = Map();
                 	sentList = List();
                 	skippedList = List();
                 	raw = ifnull(contractId,"").toString().trim();
                 	cid = 0;
                 	requester = "";
                 	mode = "Send";
                 	targetIds = List();
                 	if(raw.startsWith("{"))
                 	{
                 		pm = raw.toMap();
                 		if(pm.get("contractId") != null)
                 		{
                 			cid = pm.get("contractId").toString().toLong();
                 		}
                 		if(pm.get("user") != null)
                 		{
                 			requester = pm.get("user").toString().trim();
                 		}
                 		if(pm.get("mode") != null)
                 		{
                 			mode = pm.get("mode").toString().trim();
                 		}
                 		if(pm.get("targetIds") != null)
                 		{
                 			targetIds = pm.get("targetIds");
                 		}
                 	}
                 	else if(raw != "")
                 	{
                 		cid = raw.toLong();
                 	}
                 	if(cid == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Missing contractId.");
                 		return resp.toString();
                 	}
                 	if(requester == "")
                 	{
                 		requester = zoho.loginuser;
                 	}
                 	accessRow = User_Access[User == requester];
                 	contract = Contract[ID == cid];
                 	if(contract.ID == null)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Contract not found.");
                 		return resp.toString();
                 	}
                 	if(ifnull(contract.Work_Module,"") == "Construction")
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Construction requests do not use Legal contract approvals.");
                 		return resp.toString();
                 	}
                 	ownedEdit = false;
                 	if(accessRow.ID != null && accessRow.Propose_Contract_Changes == true)
                 	{
                 		for each  ownerId in contract.Owner
                 		{
                 			if(ownerId == accessRow.ID)
                 			{
                 				ownedEdit = true;
                 			}
                 		}
                 	}
                 	if(accessRow.ID == null || (accessRow.Edit_Contracts != true && ownedEdit != true))
                 	{
                 		resp.put("success",false);
                 		resp.put("message","You need Edit Contracts permission or Edit Owned Contracts and Actions and to be added as an owner.");
                 		return resp.toString();
                 	}
                 	if(contract.Archive == true)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","This contract is archived. Unarchive it before sending for approvals.");
                 		return resp.toString();
                 	}
                 	if(ifnull(contract.Status,"").toString() == "Complete")
                 	{
                 		resp.put("success",false);
                 		resp.put("message","This contract is complete and locked.");
                 		return resp.toString();
                 	}
                 	// Reconcile only the approvers selected when the widget opened progress.
                 	// A repair emails an unsent target at most once and never replays a sent row.
                 	if(mode == "Check" || mode == "Repair")
                 	{
                 		if(targetIds.size() == 0)
                 		{
                 			resp.put("ok",false);
                 			resp.put("message","No approval rows were supplied for verification.");
                 			return resp.toString();
                 		}
                 		activeCount = 0;
                 		sentCount = 0;
                 		missingCount = 0;
                 		addresses = List();
                 		roles = List();
                 		for each  targetId in targetIds
                 		{
                 			targetRow = Contract_Approvals[ID == targetId.toString().toLong() && Contract1 == cid];
                 			if(targetRow.ID == null || targetRow.Approval_Email != true)
                 			{
                 				resp.put("ok",false);
                 				resp.put("message","A selected approver is missing or no longer enabled for email.");
                 				return resp.toString();
                 			}
                 			rowStatus = ifnull(targetRow.Status,"").toString().trim();
                 			if(mode == "Repair" && rowStatus == "Not Sent" || rowStatus == "" && targetRow.Last_Reminder_Date == null)
                 			{
                 				repairResult = thisapp.Send_Contract_Approval_Email(cid.toString(),targetRow.ID.toString(),"Send");
                 				if(ifnull(repairResult.get("success"),false) == true)
                 				{
                 					targetRow.Status="Awaiting Approval";
                 					targetRow.Reject_Reason=null;
                 					if(ifnull(contract.Status,"").toString() != "Awaiting Approvals")
                 					{
                 						contract.Status="Awaiting Approvals";
                 						contract.Current_Approver=ifnull(targetRow.Approver,"").toString();
                 					}
                 				}
                 				rowStatus = ifnull(targetRow.Status,"").toString().trim();
                 			}
                 			if(rowStatus == "Awaiting Approval")
                 			{
                 				activeCount = activeCount + 1;
                 				if(targetRow.Last_Reminder_Date != null)
                 				{
                 					sentCount = sentCount + 1;
                 				}
                 				else
                 				{
                 					missingCount = missingCount + 1;
                 				}
                 			}
                 			else
                 			{
                 				missingCount = missingCount + 1;
                 			}
                 			addresses.add(ifnull(targetRow.Approver,"").toString());
                 			roles.add(ifnull(targetRow.Type1,"").toString());
                 		}
                 		contract = Contract[ID == cid];
                 		resp.put("ok",true);
                 		resp.put("contractId",cid.toString());
                 		resp.put("parentStatus",ifnull(contract.Status,"").toString());
                 		resp.put("targetCount",targetIds.size());
                 		resp.put("activeCount",activeCount);
                 		resp.put("sentCount",sentCount);
                 		resp.put("missingCount",missingCount);
                 		resp.put("addresses",addresses);
                 		resp.put("roles",roles);
                 		return resp.toString();
                 	}
                 	attachedCount = Attachment[Contract1 == cid && Email_Attachment == true].count();
                 	if(attachedCount == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Attach at least one file to the approval email (Attachments tab) before sending.");
                 		return resp.toString();
                 	}
                 	/* A blank Status counts as Not Sent: rows inserted through the Data API
                 	   (the widget's add-approver row before 1.60.4) never received the form's
                 	   initial value, so an exact match silently skipped them. */
                 	pending = Contract_Approvals[Contract1 == cid && Approval_Email == true && Status == "Not Sent" || Status == null || Status == ""] sort by Approval_Sequence;
                 	if(pending.count() == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","No approver is switched on for the email, or every switched-on approver has already been sent.");
                 		return resp.toString();
                 	}
                 	firstApprover = "";
                 	for each  row in pending
                 	{
                 		// A prior draft/restart may retain an old reminder stamp. The helper
                 		// creates fresh delivery evidence after sendmail succeeds.
                 		row.Last_Reminder_Date=null;
                 		emailResp = thisapp.Send_Contract_Approval_Email(cid.toString(),row.ID.toString(),"Send");
                 		if(ifnull(emailResp.get("success"),false) == true)
                 		{
                 			row.Status="Awaiting Approval";
                 			row.Reject_Reason=null;
                 			approverText = ifnull(row.Approver,"").toString();
                 			sentList.add(approverText);
                 			if(firstApprover == "")
                 			{
                 				firstApprover = approverText;
                 			}
                 		}
                 		else
                 		{
                 			skippedList.add(ifnull(row.Approver,"(no email)").toString() + ": " + ifnull(emailResp.get("message"),"send failed").toString());
                 		}
                 	}
                 	if(sentList.size() > 0)
                 	{
                 		contract.Status="Awaiting Approvals";
                 		contract.Current_Approver=firstApprover;
                 	}
                 	resp.put("success",sentList.size() > 0);
                 	resp.put("sent",sentList);
                 	resp.put("skipped",skippedList);
                 	resp.put("attachments",attachedCount);
                 	if(sentList.size() > 0)
                 	{
                 		msg = "Approval email sent to " + sentList.size() + " approver";
                 		if(sentList.size() != 1)
                 		{
                 			msg = msg + "s";
                 		}
                 		msg = msg + " with " + attachedCount + " file";
                 		if(attachedCount != 1)
                 		{
                 			msg = msg + "s";
                 		}
                 		msg = msg + ".";
                 		if(skippedList.size() > 0)
                 		{
                 			msg = msg + " " + skippedList.size() + " could not be sent.";
                 		}
                 		resp.put("message",msg);
                 	}
                 	else
                 	{
                 		resp.put("message","No approval email could be sent: " + skippedList.toString());
                 	}
                 	return resp.toString();
                 }
				 map Send_Contract_Approval_Email(string contractId, string approvalId, string mode)
                 {
                 	/*  One approval email for ONE Contract_Approvals row.
                 
                 	    Same shell as Send_Proforma_Approval_Email_With_Context: navy header with
                 	    the contract name, a "Current Step" badge, two summary panels (Contract
                 	    Overview / Approval Chain), an attachments block, and fixed-size
                 	    Approve / Reject / View buttons that survive Outlook.
                 
                 	    mode   "Send"      first send (from Send_Contract_Approvals)
                 	           "Reminder"  re-send from the daily sendApprovalReminders job
                 
                 	    Attaches every Attachment whose Email_Attachment is checked.
                 	    Stamps Last_Reminder_Date / Next_Reminder_Date on the approval row.
                 	    Does NOT change Status - the caller owns that.                          */
                 	response = Map();
                 	try 
                 	{
                 		contractIdText = ifnull(contractId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		modeText = ifnull(mode,"Send").toString().trim();
                 		if(contractIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Contract ID and approval ID are required.");
                 			return response;
                 		}
                 		contractIdLong = contractIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		contract = Contract[ID == contractIdLong];
                 		approvalRow = Contract_Approvals[ID == approvalIdLong];
                 		if(contract.ID == null || approvalRow.ID == null || approvalRow.Contract1 == null || approvalRow.Contract1.ID.toString() != contractIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Contract or approval row not found.");
                 			return response;
                 		}
                 		toAddress = ifnull(approvalRow.Approver,"").toString().trim();
                 		if(ifnull(contract.Work_Module,"") == "Construction")
                 		{
                 			response.put("success",false);
                 			response.put("message","Construction requests do not use Legal contract approvals.");
                 			return response;
                 		}
                 		if(toAddress == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval step " + ifnull(approvalRow.Approval_Sequence,"").toString() + " has no approver email.");
                 			return response;
                 		}
                 		// ---------- attachments: every version flagged for the approval email ----------
                 		attachedFiles = Attachment[Contract1 == contractIdLong && Email_Attachment == true].File_field1.getAll();
                 		attachmentRows = "";
                 		attachmentCount = 0;
                 		versionRows = Attachment[Contract1 == contractIdLong && Email_Attachment == true] sort by Date_field1 desc;
                 		for each  versionRow in versionRows
                 		{
                 			fileName = ifnull(versionRow.File_field1,"").toString();
                 			if(fileName.contains("filepath="))
                 			{
                 				fileName = fileName.getSuffix("filepath=");
                 				if(fileName.contains("&"))
                 				{
                 					fileName = fileName.getPrefix("&");
                 				}
                 			}
                 			if(fileName.contains("/"))
                 			{
                 				fileName = fileName.subString(fileName.lastIndexOf("/") + 1);
                 			}
                 			if(fileName == "")
                 			{
                 				fileName = "Contract file";
                 			}
                 			safeFileName = fileName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			dateText = "";
                 			if(versionRow.Date_field1 != null)
                 			{
                 				dateText = " &nbsp;&middot;&nbsp; " + versionRow.Date_field1.toString("MMM d, yyyy");
                 			}
                 			attachmentRows = attachmentRows + "<div style='margin-top:4px;color:#172033;font-size:13px;'>&#128206; " + safeFileName + "<span style='color:#64748b;'>" + dateText + "</span></div>";
                 			attachmentCount = attachmentCount + 1;
                 		}
                 		// ---------- contract facts ----------
                 		contractName = ifnull(contract.Contract_Name,"Contract #" + contractIdText).toString();
                 		typeText = ifnull(contract.Contract_Type,"—").toString();
                 		builderText = "—";
                 		if(contract.Builder != null)
                 		{
                 			builderText = ifnull(contract.Builder.Builder_Name,"—").toString();
                 		}
                 		subdivisionText = "";
                 		if(contract.Subdivision1 != null)
                 		{
                 			for each  subId in contract.Subdivision1
                 			{
                 				subRec = Subdivision[ID == subId];
                 				if(subRec.ID != null)
                 				{
                 					subName = ifnull(subRec.Subdivision_Name,"").toString();
                 					if(subName != "")
                 					{
                 						subdivisionText = if(subdivisionText == "",subName,subdivisionText + ", " + subName);
                 					}
                 				}
                 			}
                 		}
                 		if(subdivisionText == "")
                 		{
                 			subdivisionText = "—";
                 		}
                 		territoryText = ifnull(contract.Territory,"—").toString();
                 		pointPersonText = "";
                 		if(contract.WBW_Point_Person != null)
                 		{
                 			for each  pp in contract.WBW_Point_Person
                 			{
                 				pointPersonText = if(pointPersonText == "",pp.toString(),pointPersonText + ", " + pp.toString());
                 			}
                 		}
                 		if(pointPersonText == "")
                 		{
                 			pointPersonText = "—";
                 		}
                 		lotsText = "—";
                 		if(contract.Number_of_Lots != null && contract.Number_of_Lots.toString() != "")
                 		{
                 			lotsText = contract.Number_of_Lots.toString() + " lots";
                 			if(contract.Initial_Takedown != null && contract.Initial_Takedown.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Initial_Takedown.toString() + " initial";
                 				if(contract.Initial_Takedown_Days != null && contract.Initial_Takedown_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " within " + contract.Initial_Takedown_Days.toString() + " days";
                 				}
                 			}
                 			if(contract.Second_Closing_Lots != null && contract.Second_Closing_Lots.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Second_Closing_Lots.toString() + " second";
                 				if(contract.Second_Closing_Days != null && contract.Second_Closing_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " " + contract.Second_Closing_Days.toString() + " days after initial due";
                 				}
                 			}
                 			if(contract.Subsequent_Takedown_Lots != null && contract.Subsequent_Takedown_Lots.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Subsequent_Takedown_Lots.toString() + " subsequent";
                 				if(contract.Subsequent_Takedown_Days != null && contract.Subsequent_Takedown_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " every " + contract.Subsequent_Takedown_Days.toString() + " days";
                 				}
                 			}
                 		}
                 		earnestText = "—";
                 		if(contract.Earnest_Money != null && contract.Earnest_Money.toString() != "")
                 		{
                 			earnestText = thisapp.PF_Packet_Money(contract.Earnest_Money.toString());
                 		}
                 		totalPriceText = "—";
                 		if(contract.Total_Contract_Price != null && contract.Total_Contract_Price.toString() != "")
                 		{
                 			totalPriceText = thisapp.PF_Packet_Money(contract.Total_Contract_Price.toString());
                 		}
                 		initiatedByText = ifnull(contract.Modified_User,ifnull(contract.Added_User,"—")).toString();
                 		currentStepText = ifnull(approvalRow.Type1,"Approval").toString();
                 		stepNumberText = ifnull(approvalRow.Approval_Sequence,"").toString();
                 		// ---------- links (same public permalinks the report action uses) ----------
                 		approveUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/view-perma/Approvals_HTML_Page/4rmNhzWYQvp62uhC832KNqhvBkdfuCdHaTRuAkPzRZVemp6h2k4OGUgyyJrsAwM4DS53SHuuJpdy3Bk5DuKFbFqey0y4VyMMdZs3?recordID=" + approvalRow.ID.toString() + "&status=Approved";
                 		rejectUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/Contract_Approvals/record-edit/All_Contract_Approvals/" + approvalRow.ID.toString() + "/56FD5tkOEUKxhpxFhOkgQrUbN8yQVks7WpPAUU6R300UDB4bp59fsE4RDETy3Sp4yTUaMzeVmfY3OkmXRWSh3O2uXKn4pSrnGeOT";
                 		viewUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Contract?recLinkID=" + contractIdText + "&viewLinkName=All_Contracts";
                 		// ---------- escape everything that came from a record ----------
                 		safeContractName = contractName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTypeText = typeText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeBuilderText = builderText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSubdivisionText = subdivisionText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTerritoryText = territoryText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safePointPersonText = pointPersonText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeInitiatedByText = initiatedByText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeCurrentStepText = currentStepText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		// ---------- subject ----------
                 		subjectPrefix = "Approval required";
                 		if(modeText == "Reminder")
                 		{
                 			subjectPrefix = "Reminder - approval still required";
                 		}
                 		subjectText = subjectPrefix + ": " + builderText + " " + currentStepText + " for " + subdivisionText;
                 		// ---------- panels ----------
                 		overviewRows = "";
                 		overviewRows = overviewRows + "<tr><td width='40%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Type</td><td width='60%' style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeTypeText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Subdivision</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeSubdivisionText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Counterparty</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeBuilderText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Territory</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeTerritoryText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Point Person</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safePointPersonText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Lots</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + lotsText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Earnest Money</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + earnestText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Total Price</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;border-bottom:1px solid #e5ebf3;'>" + totalPriceText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;'>Initiated By</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;'>" + safeInitiatedByText + "</td></tr>";
                 		chainRows = "";
                 		chain = Contract_Approvals[Contract1 == contractIdLong] sort by Approval_Sequence;
                 		for each  step in chain
                 		{
                 			stepStatus = ifnull(step.Status,"Not Sent").toString();
                 			stepColor = "#64748b";
                 			stepBg = "#eef2f7";
                 			stepLabel = stepStatus;
                 			if(stepStatus == "Approved")
                 			{
                 				stepColor = "#047857";
                 				stepBg = "#d1fae5";
                 				stepLabel = "&#10003; Approved";
                 			}
                 			else if(stepStatus == "Awaiting Approval")
                 			{
                 				stepColor = "#b45309";
                 				stepBg = "#fef3c7";
                 				stepLabel = "Awaiting";
                 			}
                 			else if(stepStatus == "Rejected")
                 			{
                 				stepColor = "#b91c1c";
                 				stepBg = "#fee2e2";
                 				stepLabel = "&#10005; Rejected";
                 			}
                 			stepApprover = ifnull(step.Approver,"—").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			stepType = ifnull(step.Type1,"").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			stepSeq = ifnull(step.Approval_Sequence,"").toString();
                 			rowWeight = "600";
                 			rowMark = "";
                 			if(step.ID.toString() == approvalRow.ID.toString())
                 			{
                 				rowWeight = "800";
                 				rowMark = " <span style='font-size:10px;font-weight:800;color:#2563eb;'>&larr; YOU</span>";
                 			}
                 			chainRows = chainRows + "<tr><td width='22' style='padding:7px 0;color:#94a3b8;font-size:12px;border-bottom:1px solid #e5ebf3;'>" + stepSeq + "</td><td style='padding:7px 0 7px 6px;font-weight:" + rowWeight + ";color:#172033;font-size:13px;border-bottom:1px solid #e5ebf3;word-break:break-all;'>" + stepApprover + rowMark + "<div style='font-size:11px;color:#64748b;font-weight:500;'>" + stepType + "</div></td><td align='right' style='padding:7px 0 7px 8px;border-bottom:1px solid #e5ebf3;white-space:nowrap;'><span style='display:inline-block;padding:2px 8px;border-radius:999px;background:" + stepBg + ";color:" + stepColor + ";font-size:11px;font-weight:800;'>" + stepLabel + "</span></td></tr>";
                 		}
                 		summaryPanels = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;table-layout:fixed;'>" + "<tr>" + "<td width='50%' valign='top' style='padding-right:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Contract Overview</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + overviewRows + "</table></td></tr>" + "</table></td>" + "<td width='50%' valign='top' style='padding-left:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Approval Chain</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + chainRows + "</table></td></tr>" + "</table></td>" + "</tr></table>";
                 		attachmentBlock = "";
                 		if(attachmentCount > 0)
                 		{
                 			attachmentBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;'>" + "<div style='font-weight:700;color:#173b68;'>Attached for your review (" + attachmentCount + ")</div>" + attachmentRows + "</td></tr></table>";
                 		}
                 		else
                 		{
                 			attachmentBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;color:#92400e;font-size:13px;'>No contract file was attached to this email. Open the contract in Land Master to review the documents.</td></tr></table>";
                 		}
                 		reminderBlock = "";
                 		if(modeText == "Reminder")
                 		{
                 			reminderBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'>" + "<tr><td style='padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#9a3412;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;'>Reminder</div>" + "<div style='color:#431407;line-height:1.5;'>This approval has been waiting since " + ifnull(approvalRow.Last_Reminder_Date,zoho.currentdate).toString("MMM d, yyyy") + ". Your decision keeps the contract moving.</div>" + "</td></tr></table>";
                 		}
                 		// Fixed 120x42 button cells with bgcolor on the TD so Outlook keeps them as buttons.
                 		decisionButtons = "<table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:26px 0 14px;'><tr>" + "<td align='center' bgcolor='#047857' width='120' height='42' style='width:120px;height:42px;background-color:#047857;border:1px solid #065f46;border-radius:8px;'>" + "<a href='" + approveUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Approve</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#b42318' width='120' height='42' style='width:120px;height:42px;background-color:#b42318;border:1px solid #8f1d15;border-radius:8px;'>" + "<a href='" + rejectUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Reject</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#1e40af' width='120' height='42' style='width:120px;height:42px;background-color:#1e40af;border:1px solid #1e3a8a;border-radius:8px;'>" + "<a href='" + viewUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>View</a>" + "</td>" + "</tr></table>";
                 		stepBadge = safeCurrentStepText;
                 		if(stepNumberText != "")
                 		{
                 			stepBadge = "Step " + stepNumberText + " &nbsp;&middot;&nbsp; " + safeCurrentStepText;
                 		}
                 		messageHtml = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='width:100%;background:#eef3fa;margin:0;padding:0;'>" + "<tr><td align='center' style='padding:24px 12px;'>" + "<table role='presentation' width='760' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:760px;background:#ffffff;border-collapse:separate;border-spacing:0;font-family:Arial,Helvetica,sans-serif;'>" + "<tr><td style='background:#102f55;color:#ffffff;padding:24px 26px;border-radius:15px 15px 0 0;border-bottom:4px solid #2563eb;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'><tr>" + "<td valign='bottom' style='padding-right:20px;'>" + "<div style='font-size:11px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.11em;font-weight:700;'>Contract Approval</div>" + "<div style='font-size:24px;font-weight:700;line-height:1.2;margin-top:7px;'>" + safeContractName + "</div>" + "<div style='font-size:13px;color:#c9d8eb;margin-top:8px;'>" + safeBuilderText + " &nbsp;&middot;&nbsp; " + safeSubdivisionText + "</div>" + "</td>" + "<td width='170' valign='bottom' align='right'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#173f6f;border:1px solid #315983;border-radius:10px;'>" + "<tr><td align='left' style='padding:10px 12px;'>" + "<div style='font-size:9px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.09em;font-weight:700;'>Current Step</div>" + "<div style='font-size:15px;color:#ffffff;font-weight:700;margin-top:4px;'>" + stepBadge + "</div>" + "</td></tr></table></td>" + "</tr></table></td></tr>" + "<tr><td style='padding:22px 24px 24px;border-left:1px solid #dce5f0;border-right:1px solid #dce5f0;border-bottom:1px solid #dce5f0;border-radius:0 0 15px 15px;'>" + "<p style='margin:0 0 8px;font-size:15px;color:#172033;'>The <b>" + safeCurrentStepText + "</b> approval for this contract is pending with you.</p>" + "<p style='margin:0;color:#475569;line-height:1.55;'>Review the attached contract documents and record your decision below. Reject opens a short form where a reason is required.</p>" + reminderBlock + summaryPanels + attachmentBlock + decisionButtons + "<div style='font-size:12px;color:#64748b;margin-top:8px;'>Approve records your response as soon as the page opens. Reject asks for a reason and returns the contract to Legal.</div>" + "<div style='margin-top:18px;padding-top:14px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;'>Already have Land Master access? <a href='" + viewUrl + "' style='color:#2563eb;text-decoration:none;font-weight:600;'>Open the full contract</a></div>" + "</td></tr></table></td></tr></table>";
                 		if(attachmentCount > 0)
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :toAddress
                 				subject :subjectText
                 				message :messageHtml
                 				Attachments :file:attachedFiles
                 			]
                 		}
                 		else
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :toAddress
                 				subject :subjectText
                 				message :messageHtml
                 			]
                 		}
                 		// reminder cadence lives on the row: Reminder_Interval_Days (default 5)
                 		intervalDays = ifnull(approvalRow.Reminder_Interval_Days,5).toLong();
                 		if(intervalDays <= 0)
                 		{
                 			intervalDays = 5;
                 		}
                 		approvalRow.Last_Reminder_Date=zoho.currentdate;
                 		approvalRow.Next_Reminder_Date=zoho.currentdate.addDay(intervalDays);
                 		response.put("success",true);
                 		response.put("message","Approval email sent to " + toAddress + ".");
                 		response.put("approver",toAddress);
                 		response.put("attachmentCount",attachmentCount);
                 		response.put("nextReminder",zoho.currentdate.addDay(intervalDays).toString());
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 map Send_Proforma_Approval_Email(string proformaId, string approvalId)
                 {
                 	return thisapp.Send_Proforma_Approval_Email_With_Context(proformaId,approvalId,"Resent","","System");
                 }
				 map Send_Proforma_Approval_Email_With_Context(string proformaId, string approvalId, string routingAction, string routingNote, string routingRole)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		approvalRow = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null || approvalRow.ID == null || approvalRow.Proforma == null || approvalRow.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma or approval row not found.");
                 			return response;
                 		}
                 		toAddress = ifnull(approvalRow.Approver,"").toString().trim();
                 		if(toAddress == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","No email address is assigned to the " + ifnull(approvalRow.Title,"current").toString() + " approval.");
                 			return response;
                 		}
                 		completionEmail = ifnull(routingAction,"").toString() == "Completed";
                 		completionRecipients = List();
                 		completionRowsHtml = "";
                 		if(completionEmail)
                 		{
                 			completionRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			if(ifnull(pf.Status,"") != "Approved" || completionRows.count() == 0)
                 			{
                 				response.put("success",false);
                 				response.put("message","The Pro Forma is not fully approved.");
                 				return response;
                 			}
                 			for each  completionRow in completionRows
                 			{
                 				completionAddress = ifnull(completionRow.Approver,"").toString().trim().toLowerCase();
                 				if(ifnull(completionRow.Status,"") != "Approved" || completionAddress == "")
                 				{
                 					response.put("success",false);
                 					response.put("message","Every approval must be complete and have an email address before notifying all approvers.");
                 					return response;
                 				}
                 				if(completionRecipients.contains(completionAddress) == false)
                 				{
                 					completionRecipients.add(completionAddress);
                 				}
                 				completionRole = thisapp.PF_Packet_Escape(ifnull(completionRow.Title,"Approver").toString());
                 				completionAddressHtml = thisapp.PF_Packet_Escape(completionAddress);
                 				completionDate = "—";
                 				if(completionRow.Responded_Date != null)
                 				{
                 					completionDate = completionRow.Responded_Date.toString("MMM dd, yyyy HH:mm");
                 				}
                 				completionRowsHtml = completionRowsHtml + "<tr><td style='padding:10px;border-bottom:1px solid #e5ebf3;'><b>" + completionRole + "</b><br><span style='color:#64748b;word-break:break-word;'>" + completionAddressHtml + "</span></td><td style='padding:10px;border-bottom:1px solid #e5ebf3;color:#047857;'>Approved<br><span style='font-size:12px;color:#64748b;'>" + completionDate + "</span></td></tr>";
                 			}
                 		}
                 		// Build the complete Deluge-generated PDF packet.
                 		packet = thisapp.PF_Build_Proforma_Approval_PDF(proformaIdText,approvalIdText);
                 		if(ifnull(packet.get("success"),false) != true)
                 		{
                 			response.put("success",false);
                 			response.put("message",ifnull(packet.get("message"),"The approval PDF packet could not be generated.").toString());
                 			return response;
                 		}
                 		pdfText = ifnull(packet.get("pdfText"),"").toString();
                 		fallbackPacketPfName = ifnull(pf.Name,"Pro Forma").toString().replaceAll("['’]","").replaceAll("[^A-Za-z0-9]+","_").replaceAll("_+","_").replaceAll("^_+","").replaceAll("_+$","");
                 		if(fallbackPacketPfName == "")
                 		{
                 			fallbackPacketPfName = "Pro_Forma";
                 		}
                 		packetFileName = ifnull(packet.get("fileName"),fallbackPacketPfName + "_Proforma_Packet_" + zoho.currentdate.toString("yyyy-MM-dd") + ".pdf").toString();
                 		if(pdfText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","The approval PDF packet was generated without file content.");
                 			return response;
                 		}
                 		pdfFile = pdfText.toFile(packetFileName);
                 		publicApprovalPageUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/page-perma/Proforma_Approval_Response/SKynkNA9rksmmQtUQYmxGddr0T8zzRkPET48ymuwzpZjjzGeygeb6pQTxqKZT4HwjrSWq1pFZCry2qsyeFZbpZ9v1RA1AUFrQYAE";
                 		approveUrl = publicApprovalPageUrl + "?approvalId=" + approvalRow.ID.toString() + "&action1=Approve";
                 		denyUrl = publicApprovalPageUrl + "?approvalId=" + approvalRow.ID.toString() + "&action1=Deny";
                 		reviewUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Proforma_Management1?proformaId=" + proformaIdText;
                 		if(completionEmail)
                 		{
                 			reviewUrl = reviewUrl + "&view=dashboard";
                 		}
                 		pfName = ifnull(pf.Name,"Pro Forma #" + proformaIdText).toString();
                 		territoryText = ifnull(pf.Territory,"—").toString();
                 		stageText = ifnull(pf.Probability,"—").toString();
                 		statusText = ifnull(pf.Status,"Draft").toString();
                 		currentStepText = ifnull(approvalRow.Title,"Approver").toString();
                 		if(completionEmail)
                 		{
                 			currentStepText = "Fully Approved";
                 		}
                 		purchaseDateText = "—";
                 		completionDateText = "—";
                 		if(pf.Estimated_Purchase_Date != null)
                 		{
                 			purchaseDateText = pf.Estimated_Purchase_Date.toString("MMM, yyyy");
                 		}
                 		if(pf.Estimated_Completion != null)
                 		{
                 			completionDateText = pf.Estimated_Completion.toString("MMM, yyyy");
                 		}
                 		roiText = "—";
                 		if(pf.ROI1 != null && pf.ROI1.toString().trim() != "")
                 		{
                 			roiText = thisapp.PF_Packet_Number(pf.ROI1.toString(),2) + "%";
                 		}
                 		netProfitText = thisapp.PF_Packet_Money(ifnull(pf.Net_Profit,0).toString());
                 		// Pro Forma owner names: User_Access.Full_Name, falling back to the login trimmed at "@"
                 		// and "_" (the way the widget labels owners) for rows that have no Full_Name yet.
                 		ownerNameList = List();
                 		if(pf.Owner != null)
                 		{
                 			for each  ownerRow in pf.Owner
                 			{
                 				ownerAccess = User_Access[ID == ownerRow.ID];
                 				if(ownerAccess.ID != null)
                 				{
                 					ownerName = ifnull(ownerAccess.Full_Name,"").toString().trim();
                 					if(ownerName == "")
                 					{
                 						ownerName = ifnull(ownerAccess.User,"").toString().trim();
                 						if(ownerName == "")
                 						{
                 							ownerName = ifnull(ownerAccess.Approver_Email,"").toString().trim();
                 						}
                 						if(ownerName.contains("@"))
                 						{
                 							ownerName = ownerName.getPrefix("@");
                 						}
                 						if(ownerName.contains("_"))
                 						{
                 							ownerName = ownerName.getPrefix("_");
                 						}
                 					}
                 					if(ownerName != "" && ownerNameList.contains(ownerName) == false)
                 					{
                 						ownerNameList.add(ownerName);
                 					}
                 				}
                 			}
                 		}
                 		ownerNamesText = "Not assigned";
                 		if(ownerNameList.size() > 0)
                 		{
                 			ownerNamesText = ownerNameList.toString(", ");
                 		}
                 		// Read LOI terms from the saved LOI_Worksheet, Builder and Property records.
                 		loiContext = thisapp.PF_Get_Proforma_LOI_Snapshot(proformaIdText);
                 		if(ifnull(loiContext.get("success"),false) != true)
                 		{
                 			response.put("success",false);
                 			response.put("message",ifnull(loiContext.get("message"),"The saved LOI information could not be loaded.").toString());
                 			return response;
                 		}
                 		sellerText = ifnull(loiContext.get("seller"),"—").toString();
                 		buyingEntityText = ifnull(loiContext.get("buyingEntity"),"—").toString();
                 		propertyText = ifnull(loiContext.get("property"),"—").toString();
                 		acresText = ifnull(loiContext.get("totalAcres"),"—").toString();
                 		pricePerAcreText = ifnull(loiContext.get("amountPerAcre"),"—").toString();
                 		estimatedPurchasePriceText = ifnull(loiContext.get("estimatedPrice"),"—").toString();
                 		earnestMoneyText = ifnull(loiContext.get("earnestMoney"),"—").toString();
                 		feasibilityText = ifnull(loiContext.get("feasibility"),"—").toString();
                 		closingText = ifnull(loiContext.get("closing"),"—").toString();
                 		extensionsText = ifnull(loiContext.get("extensions"),"—").toString();
                 		responseDateText = ifnull(loiContext.get("responseDate"),"—").toString();
                 		effectiveDateText = ifnull(loiContext.get("effectiveDate"),"—").toString();
                 		specialProvisionsText = ifnull(loiContext.get("specialProvisions"),"").toString();
                 		routingActionText = ifnull(routingAction,"").toString();
                 		routingNoteText = ifnull(routingNote,"").toString();
                 		routingRoleText = ifnull(routingRole,"").toString();
                 		subjectPrefix = "Approval required";
                 		if(approvalRow.Title == "Legal")
                 		{
                 			subjectPrefix = "Legal LOI review required";
                 		}
                 		if(routingActionText == "Rejected")
                 		{
                 			subjectPrefix = "Pro Forma returned by " + routingRoleText;
                 		}
                 		if(completionEmail)
                 		{
                 			subjectPrefix = "Pro Forma fully approved - Ready for Legal Module";
                 		}
                 		subjectText = subjectPrefix + ": " + pfName;
                 		// Escape all user-entered or record text before inserting it into HTML.
                 		safePfName = pfName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTerritoryText = territoryText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeStageText = stageText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeStatusText = statusText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeCurrentStepText = currentStepText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSellerText = sellerText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeBuyingEntityText = buyingEntityText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safePropertyText = propertyText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeExtensionsText = extensionsText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeRoutingNote = routingNoteText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeRoutingRole = routingRoleText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSpecialProvisions = specialProvisionsText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeOwnerNames = ownerNamesText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		introText = "The <b>" + safeCurrentStepText + "</b> approval is now pending with you.";
                 		if(routingActionText == "Rejected")
                 		{
                 			introText = "<b>" + safeRoutingRole + "</b> rejected this Pro Forma, so approvals restarted from step 1. The <b>" + safeCurrentStepText + "</b> approval is now pending with you.";
                 		}
                 		if(completionEmail)
                 		{
                 			introText = "This Pro Forma is <b>fully approved</b> by all approvers.";
                 		}
                 		routingBlock = "";
                 		if(routingNoteText != "")
                 		{
                 			noteLabel = "Previous approver note";
                 			if(routingActionText == "Rejected")
                 			{
                 				noteLabel = "Rejection note from " + safeRoutingRole;
                 			}
                 			routingBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'>" + "<tr><td style='padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#9a3412;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;'>" + noteLabel + "</div>" + "<div style='white-space:pre-wrap;color:#431407;line-height:1.5;'>" + safeRoutingNote + "</div>" + "</td></tr></table>";
                 		}
                 		overviewRows = "";
                 		overviewRows = overviewRows + "<tr><td width='44%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Acquisition Owner</td><td width='56%' style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#1d4ed8;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeOwnerNames + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Territory</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeTerritoryText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Stage</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeStageText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Status</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeStatusText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Current Step</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeCurrentStepText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Purchase</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + purchaseDateText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Completion</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + completionDateText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>ROI</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#2563eb;border-bottom:1px solid #e5ebf3;'>" + roiText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;'>Net Profit</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;'>" + netProfitText + "</td></tr>";
                 		loiRows = "";
                 		loiRows = loiRows + "<tr><td width='42%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Seller</td><td width='58%' style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeSellerText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Buying Entity</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeBuyingEntityText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Property</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safePropertyText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Total Acres</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + acresText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Price / Acre</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + pricePerAcreText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Purchase</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;border-bottom:1px solid #e5ebf3;'>" + estimatedPurchasePriceText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Earnest Money</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + earnestMoneyText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Feasibility / Closing</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + feasibilityText + " / " + closingText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Extensions</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeExtensionsText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;'>Response / Effective</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;'>" + responseDateText + " / " + effectiveDateText + "</td></tr>";
                 		summaryPanels = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;table-layout:fixed;'>" + "<tr>" + "<td width='50%' valign='top' style='padding-right:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Pro Forma Overview</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + overviewRows + "</table></td></tr>" + "</table></td>" + "<td width='50%' valign='top' style='padding-left:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>LOI Snapshot</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + loiRows + "</table></td></tr>" + "</table></td>" + "</tr></table>";
                 		legalInstruction = "Review the attached Pro Forma approval packet and record your decision below.";
                 		if(approvalRow.Title == "Legal")
                 		{
                 			legalInstruction = "Review the attached approval packet, including the complete LOI worksheet, Sellers, Properties, and deal terms, before routing it to the next approval step.";
                 		}
                 		// Use bgcolor and borders on the TABLE CELLS so Outlook cannot reduce these to plain text links.
                 		// Padding lives on the TD, not the anchor - Outlook ignores anchor padding, which
                 		// collapsed the buttons to text-tight blocks; real padding stacked on mso-padding-alt
                 		// then ballooned them, so the size is now FIXED: 120x42 via td width/height
                 		// "Open the full Pro Forma" footer link.
                 		decisionButtons = "<table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:26px 0 14px;'><tr>" + "<td align='center' bgcolor='#047857' width='120' height='42' style='width:120px;height:42px;background-color:#047857;border:1px solid #065f46;border-radius:8px;'>" + "<a href='" + approveUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Approve</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#b42318' width='120' height='42' style='width:120px;height:42px;background-color:#b42318;border:1px solid #8f1d15;border-radius:8px;'>" + "<a href='" + denyUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Deny</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#1e40af' width='120' height='42' style='width:120px;height:42px;background-color:#1e40af;border:1px solid #1e3a8a;border-radius:8px;'>" + "<a href='" + reviewUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>View</a>" + "</td>" + "</tr></table>";
                 		decisionHelp = "<div style='font-size:12px;color:#64748b;margin-top:8px;'>Approve records the response when the approval page opens. Deny opens a page where a note is required.</div>";
                 		if(completionEmail)
                 		{
                 			legalInstruction = "It is ready to be submitted to the <b>Legal Module</b>. Open the Pro Forma and select <b>Submit to Legal</b>.";
                 			routingBlock = routingBlock + "<div style='margin-top:18px;font-size:14px;font-weight:700;color:#173b68;'>Approvers</div><table width='100%' cellpadding='0' cellspacing='0' style='margin-top:8px;border:1px solid #dce5f0;border-collapse:collapse;'>" + completionRowsHtml + "</table>";
                 			decisionButtons = "<table role='presentation' cellpadding='0' cellspacing='0' style='margin:26px 0 14px;'><tr><td bgcolor='#1e40af' style='background:#1e40af;border-radius:8px;padding:13px 20px;'><a href='" + reviewUrl + "' style='font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;'>Open Pro Forma</a></td></tr></table>";
                 			decisionHelp = "";
                 		}
                 		messageHtml = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='width:100%;background:#eef3fa;margin:0;padding:0;'>" + "<tr><td align='center' style='padding:24px 12px;'>" + "<table role='presentation' width='760' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:760px;background:#ffffff;border-collapse:separate;border-spacing:0;'>" + "<tr><td style='background:#102f55;color:#ffffff;padding:24px 26px;border-radius:15px 15px 0 0;border-bottom:4px solid #2563eb;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'><tr>" + "<td valign='bottom' style='padding-right:20px;'>" + "<div style='font-size:11px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.11em;font-weight:700;'>Pro Forma Approval</div>" + "<div style='font-size:24px;font-weight:700;line-height:1.2;margin-top:7px;'>" + safePfName + "</div>" + "<div style='font-size:14px;color:#ffffff;margin-top:9px;font-weight:700;'><span style='color:#fcd34d;'>Acquisition Owner:</span> " + safeOwnerNames + "</div>" + "<div style='font-size:13px;color:#c9d8eb;margin-top:6px;'>" + safeTerritoryText + " &nbsp;&middot;&nbsp; " + safeStageText + "</div>" + "</td>" + "<td width='150' valign='bottom' align='right'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#173f6f;border:1px solid #315983;border-radius:10px;'>" + "<tr><td align='left' style='padding:10px 12px;'>" + "<div style='font-size:9px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.09em;font-weight:700;'>Current Step</div>" + "<div style='font-size:16px;color:#ffffff;font-weight:700;margin-top:4px;'>" + safeCurrentStepText + "</div>" + "</td></tr></table></td>" + "</tr></table></td></tr>" + "<tr><td style='padding:22px 24px 24px;border-left:1px solid #dce5f0;border-right:1px solid #dce5f0;border-bottom:1px solid #dce5f0;border-radius:0 0 15px 15px;'>" + "<p style='margin:0 0 8px;font-size:15px;color:#172033;'>" + introText + "</p>" + "<p style='margin:0;color:#475569;line-height:1.55;'>" + legalInstruction + "</p>" + routingBlock + summaryPanels;
                 		if(specialProvisionsText != "")
                 		{
                 			messageHtml = messageHtml + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:14px 16px;background:#fffaf0;border:1px solid #fde3a7;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#8a4b08;text-transform:uppercase;letter-spacing:.07em;'>Special Provisions</div>" + "<div style='margin-top:7px;white-space:pre-wrap;color:#4a3217;line-height:1.5;'>" + safeSpecialProvisions + "</div>" + "</td></tr></table>";
                 		}
                 		messageHtml = messageHtml + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;'>" + "<div style='font-weight:700;color:#173b68;'>Attached approval packet</div>" + "<div style='margin-top:5px;color:#475569;font-size:13px;'>Includes the executive summary, all non-zero Additional Costs, complete LOI terms, Sellers, and Properties.</div>" + "</td></tr></table>" + decisionButtons + decisionHelp + "<div style='margin-top:18px;padding-top:14px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;'>Already have Land Master access? <a href='" + reviewUrl + "' style='color:#2563eb;text-decoration:none;font-weight:600;'>Open the full Pro Forma</a></div>" + "</td></tr></table></td></tr></table>";
                 		if(completionEmail)
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :completionRecipients
                 				subject :subjectText
                 				message :messageHtml
                 				Attachments :file:pdfFile
                 			]
                 			response.put("success",true);
                 			response.put("message","Completion email and PDF packet sent to all approvers.");
                 			response.put("recipientCount",completionRecipients.size());
                 		}
                 		else
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :toAddress
                 				subject :subjectText
                 				message :messageHtml
                 				Attachments :file:pdfFile
                 			]
                 			approvalRow.Sent_Date=zoho.currenttime;
                 			response.put("success",true);
                 			response.put("message","Approval email and PDF packet sent to " + toAddress + ".");
                 		}
                 		response.put("packetFileName",packetFileName);
                 		response.put("pageCount",packet.get("pageCount"));
                 		response.put("additionalCostCount",packet.get("additionalCostCount"));
                 		response.put("containsAdditionalCosts",packet.get("containsAdditionalCosts"));
                 		response.put("containsLOITerms",packet.get("containsLOITerms"));
                 		response.put("sellerCount",packet.get("sellerCount"));
                 		response.put("propertyCount",packet.get("propertyCount"));
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string setProjectProforma(string projectId, string proformaId)
                 {
                 	vProjectId = projectId.toLong();
                 	vProformaText = ifnull(proformaId,"").trim();
                 	if(vProjectId == 0)
                 	{
                 		return "{\"ok\":false,\"error\":\"Missing projectId.\"}";
                 	}
                 	projectRec = Project[ID == vProjectId];
                 	if(projectRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Project not found.\"}";
                 	}
                 	if(vProformaText == "")
                 	{
                 		projectRec.Proforma=null;
                 		resultMap = Map();
                 		resultMap.put("ok",true);
                 		resultMap.put("projectId",vProjectId);
                 		resultMap.put("proformaId","");
                 		return resultMap.toString();
                 	}
                 	vProformaId = vProformaText.toLong();
                 	proformaRec = Add_Pro_Forma[ID == vProformaId];
                 	if(proformaRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Pro Forma not found.\"}";
                 	}
                 	projectRec.Proforma=proformaRec.ID;
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("projectId",vProjectId);
                 	resultMap.put("proformaId",vProformaId);
                 	return resultMap.toString();
                 }
				 map snapshotApprovalRoute(map context)
                 {
                 	result = {"success":false,"contract":"approval-policy-v1"};
                 	try 
                 	{
                 		// Private dependency for initiation adapters, called only after their existing auth checks.
                 		// Unique submission key is bound to workflow, record and immutable submission revision.
                 		typedRecord = Map();
                 		typedRecord.put("value",context.get("recordId"));
                 		typedRevision = Map();
                 		typedRevision.put("value",context.get("submissionRevision"));
                 		if(!typedRecord.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]{1,30}\"[ ]*[}][ ]*") || !typedRevision.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[A-Za-z0-9-]{1,80}\"[ ]*[}][ ]*"))
                 		{
                 			result.put("error","Record ID and immutable submission revision must be exact strings.");
                 			return result;
                 		}
                 		submissionKey = context.get("workflow") + ":" + context.get("recordId") + ":" + context.get("submissionRevision");
                 		existing = Approval_Route_Snapshot[Submission_Key == submissionKey];
                 		if(existing.count() > 0)
                 		{
                 			if(existing.count() != 1 || existing.Context_JSON != context.toString())
                 			{
                 				result.put("error","Snapshot identity conflicts with this submission.");
                 				return result;
                 			}
                 			result.put("snapshot",existing.Route_JSON.toMap());
                 			result.put("snapshotId",existing.ID.toString());
                 			result.put("success",true);
                 			return result;
                 		}
                 		resolved = thisapp.resolveApprovalRoute(context);
                 		if(resolved.get("success") != true)
                 		{
                 			return resolved;
                 		}
                 		snapshot = resolved.get("snapshot");
                 		policy = Approval_Policy[ID == snapshot.get("policyId").toLong()];
                 		if(policy.Adapter_Enabled != true && context.get("workflow") != "Purchase Order" && context.get("workflow") != "Pro Forma" && context.get("workflow") != "Budget Modification")
                 		{
                 			result.put("error","This workflow has not completed its native adapter migration gate.");
                 			return result;
                 		}
                 		rowId = insert into Approval_Route_Snapshot
                 		[
                 			Added_User=zoho.loginuser
                 			Submission_Key=submissionKey
                 			Workflow=context.get("workflow")
                 			Record_ID=context.get("recordId")
                 			Submission_Revision=context.get("submissionRevision")
                 			Policy=policy.ID
                 			Context_JSON=context.toString()
                 			Route_JSON=snapshot.toString()
                 		];
                 		row = Approval_Route_Snapshot[ID == rowId];
                 		if(row.Submission_Key != submissionKey || row.Workflow != context.get("workflow") || row.Record_ID != context.get("recordId") || row.Submission_Revision != context.get("submissionRevision") || row.Policy != policy.ID || row.Context_JSON != context.toString() || row.Route_JSON != snapshot.toString())
                 		{
                 			result.put("error","Submission route snapshot could not be verified. Do not create another.");
                 			return result;
                 		}
                 		result.put("snapshotId",rowId.toString());
                 		result.put("snapshot",snapshot);
                 		result.put("success",true);
                 	}	catch (e)
                 	{
                 		result.put("error","Submission snapshot is unknown. Check its unique submission key before continuing.");
                 	}
                 	return result;
                 }
				 string startAllApprovalChains(int budgetId)
                 {
                 	/********* START BOTH APPROVAL CHAINS *********/
                 	// Return Type: string
                 	// Starts Construction at VP and Development at VP.
                 	// Each chain advances independently after that.
                 	vBudgetId = budgetId.toLong();
                 	constructionResp = thisapp.startApprovalChain(vBudgetId,"Construction");
                 	developmentResp = thisapp.startApprovalChain(vBudgetId,"Development");
                 	return "Construction: " + constructionResp + " | Development: " + developmentResp;
                 }
				 string startApprovalChain(int budgetId, string approvalType)
                 {
                 	/********* START OR RESTART ONE APPROVAL CHAIN *********/
                 	// Return Type: string
                 	//
                 	// Development start/restart:
                 	// - Clear Development + Engineering Final.
                 	// - Copy Development + Engineering Preliminary into Unapproved.
                 	// - Construction values remain unchanged.
                 	//
                 	// Construction start/restart:
                 	// - Clear Construction Final.
                 	// - Preserve Construction Unapproved because it comes from
                 	//   HeavyJob / the external budget import.
                 	// - Development + Engineering values remain unchanged.
                 	//
                 	// The financial values are not changed until a valid first
                 	// approval row has been found.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "No approval type provided.";
                 	}
                 	if(vApprovalType != "Development" && vApprovalType != "Construction")
                 	{
                 		return "Unsupported approval type: " + vApprovalType;
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	// Only initialize a new, untouched chain from the central template.
                 	// Existing approval handlers, staging, emails and finalization are retained.
                 	policyTerritory = "";
                 	if(budgetRec.Subdivision1 != null)
                 	{
                 		policyTerritory = ifnull(budgetRec.Subdivision1.Territory,"");
                 	}
                 	policySubmitter = User_Access[User == zoho.loginuser];
                 	policyContext = {"workflow":"Budget","recordId":vBudgetId.toString(),"territory":policyTerritory,"department":vApprovalType,"submitterId":ifnull(policySubmitter.ID,0).toString(),"amount":"0.00","amountBasisConfirmed":false};
                 	policyExecution = thisapp.applySharedApprovalPolicy(policyContext);
                 	if(policyExecution.get("success") != true)
                 	{
                 		return "Approval template could not be loaded: " + policyExecution.get("error");
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	/********* FIRST VALIDATE THE APPROVAL CHAIN *********/
                 	firstApprovalId = 0;
                 	firstSort = 999999;
                 	approvalRowCount = 0;
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 		{
                 			apprRowsCheck = Budget_Approvals[ID == appr.ID];
                 			if(apprRowsCheck.count() > 0)
                 			{
                 				approvalRowCount = approvalRowCount + 1;
                 				apprSort = 999999;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort < firstSort)
                 				{
                 					firstSort = apprSort;
                 					firstApprovalId = appr.ID;
                 				}
                 			}
                 		}
                 	}
                 	if(firstApprovalId == 0)
                 	{
                 		return "No " + vApprovalType + " approval rows found. No budget values were changed.";
                 	}
                 	// A lost response must not restart an active track, reset its
                 	// financial values, or send the first email a second time.
                 	for each  existingRow in budgetRec.Approvals
                 	{
                 		if(ifnull(existingRow.Type1,"").trim() == vApprovalType && ifnull(existingRow.Status,"").trim() == "Pending" || ifnull(existingRow.Status,"").trim() == "Approved")
                 		{
                 			return vApprovalType + " approval track is already active. Check its persisted state before retrying.";
                 		}
                 	}
                 	/*****************************************************
                                  	 * CLEAR THIS TRACK'S FINAL VALUES
                                  	 *
                                  	 * Development:
                                  	 * - Final -> 0
                                  	 * - Preliminary -> Unapproved
                                  	 *
                                  	 * Construction:
                                  	 * - Final -> 0
                                  	 * - Preserve externally populated Unapproved
                                  	 *****************************************************/
                 	affectedItemCount = 0;
                 	stagedItemCount = 0;
                 	stagedTotal = 0;
                 	budgetCategoriesToStage = Budget_Category[Budget == vBudgetId];
                 	for each  cat in budgetCategoriesToStage
                 	{
                 		deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 		shouldProcess = false;
                 		if(vApprovalType == "Development")
                 		{
                 			if(deptKey.contains("development") || deptKey.contains("engineering"))
                 			{
                 				shouldProcess = true;
                 			}
                 		}
                 		else if(vApprovalType == "Construction")
                 		{
                 			if(deptKey.contains("construction"))
                 			{
                 				shouldProcess = true;
                 			}
                 		}
                 		if(shouldProcess == true)
                 		{
                 			catItemsToStage = Budget_Item[Budget_Category == cat.ID];
                 			for each  itemToStage in catItemsToStage
                 			{
                 				// Starting or restarting this track invalidates its old Final.
                 				itemToStage.Budget_Ttl=0;
                 				affectedItemCount = affectedItemCount + 1;
                 				if(vApprovalType == "Development")
                 				{
                 					prelimVal = 0;
                 					if(itemToStage.Prelim_Budget_Ttl != null)
                 					{
                 						prelimNum = itemToStage.Prelim_Budget_Ttl.toNumber();
                 						if(prelimNum != null)
                 						{
                 							prelimVal = prelimNum;
                 						}
                 					}
                 					// Dev/Eng stages Preliminary into Unapproved.
                 					itemToStage.Unapproved_Final_Budget_Ttl=prelimVal;
                 					stagedItemCount = stagedItemCount + 1;
                 					stagedTotal = stagedTotal + prelimVal;
                 				}
                 				// Construction Unapproved is intentionally not changed.
                 				// It is owned by HeavyJob / the external import process.
                 			}
                 			/********* REFRESH THIS CATEGORY'S FINAL TOTAL *********/
                 			catFinalTotal = 0;
                 			catFinalSum = Budget_Item[Budget_Category == cat.ID].sum(Budget_Ttl);
                 			if(catFinalSum != null)
                 			{
                 				catFinalNum = catFinalSum.toNumber();
                 				if(catFinalNum != null)
                 				{
                 					catFinalTotal = catFinalNum;
                 				}
                 			}
                 			cat.Budget_Total=catFinalTotal;
                 		}
                 	}
                 	/********* REFRESH PARENT BUDGET FINAL GRAND TOTAL *********/
                 	newGrandTotal = 0;
                 	allBudgetCategories = Budget_Category[Budget == vBudgetId];
                 	for each  catTotalRec in allBudgetCategories
                 	{
                 		if(catTotalRec.Budget_Total != null)
                 		{
                 			catTotalNum = catTotalRec.Budget_Total.toNumber();
                 			if(catTotalNum != null)
                 			{
                 				newGrandTotal = newGrandTotal + catTotalNum;
                 			}
                 		}
                 	}
                 	budgetRec.Budget_Grand_Total=newGrandTotal;
                 	/********* RESET THIS TRACK'S APPROVAL ROWS *********/
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 		{
                 			apprRows = Budget_Approvals[ID == appr.ID];
                 			for each  ar in apprRows
                 			{
                 				ar.Status="Not Sent";
                 				ar.Sent_Date=null;
                 				ar.Responded_Date=null;
                 				// Prior approval notes are intentionally retained.
                 				// Uncomment this if a restart should erase the notes:
                 				// ar.Approval_Notes="";
                 			}
                 		}
                 	}
                 	/********* SET FIRST APPROVER TO PENDING *********/
                 	firstApprovalRows = Budget_Approvals[ID == firstApprovalId];
                 	for each  firstApproval in firstApprovalRows
                 	{
                 		firstApproval.Status="Pending";
                 		// sendApprovalEmail stamps Sent_Date only after sendmail succeeds.
                 		firstApproval.Sent_Date=null;
                 		firstApproval.Responded_Date=null;
                 	}
                 	syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId,vApprovalType);
                 	emailResp = thisapp.sendApprovalEmail(vBudgetId,firstApprovalId);
                 	if(vApprovalType == "Development")
                 	{
                 		stageResp = "Cleared " + affectedItemCount + " Development/Engineering Final items and staged " + stagedItemCount + " Preliminary items totaling " + stagedTotal + " into Unapproved.";
                 	}
                 	else
                 	{
                 		stageResp = "Cleared " + affectedItemCount + " Construction Final items. Construction Unapproved values were preserved.";
                 	}
                 	return vApprovalType + " chain started. " + stageResp + " " + emailResp + " " + syncResp;
                 }
				 map Start_Proforma_Approval_Chain(string proformaId)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		progressMode = "Start";
                 		progressInput = Map();
                 		if(proformaIdText.startsWith("{"))
                 		{
                 			progressInput = proformaIdText.toMap();
                 			typedProformaId = {"value":progressInput.get("id")};
                 			if(!typedProformaId.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]{1,30}\"[ ]*[}][ ]*"))
                 			{
                 				response.put("success",false);
                 				response.put("message","Pro Forma ID must be an exact string.");
                 				return response;
                 			}
                 			proformaIdText = ifnull(progressInput.get("id"),"").toString().trim();
                 			progressMode = ifnull(progressInput.get("mode"),"Start").toString().trim();
                 		}
                 		// The widget requests Settings preview through Check so the previous API
                 		// cannot mistake the new preview mode for approval initiation.
                 		if(progressMode == "Check" && progressInput.get("settingsPreview") == true)
                 		{
                 			progressMode = "Preview";
                 		}
                 		if(progressMode != "Start" && progressMode != "StartSettings" && progressMode != "Preview" && progressMode != "Check" && progressMode != "Repair")
                 		{
                 			response.put("success",false);
                 			response.put("message","Unsupported Pro Forma approval mode.");
                 			return response;
                 		}
                 		if(proformaIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID is required.");
                 			return response;
                 		}
                 		if(!proformaIdText.matches("[0-9]{1,30}"))
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID is invalid.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma not found.");
                 			return response;
                 		}
                 		accessRow = User_Access[User == zoho.loginuser];
                 		if(accessRow.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","A User Access record is required to send a Pro Forma for approvals.");
                 			return response;
                 		}
                 		isPfOwner = false;
                 		if(pf.Owner != null)
                 		{
                 			for each  ownerRow in pf.Owner
                 			{
                 				if(ownerRow.ID.toString() == accessRow.ID.toString())
                 				{
                 					isPfOwner = true;
                 					break;
                 				}
                 			}
                 		}
                 		canSendThisProforma = accessRow.Edit_All_Proformas == true || isPfOwner;
                 		policyContext = {"workflow":"Pro Forma","recordId":proformaIdText,"territory":ifnull(pf.Territory,""),"department":"","submitterId":accessRow.ID.toString()};
                 		if(progressMode == "Preview")
                 		{
                 			response.put("success",false);
                 			response.put("contract","proforma-approval-settings-v1");
                 			response.put("policyModel","territory-perpetual-v2");
                 			response.put("mode","Preview");
                 			response.put("proformaId",proformaIdText);
                 			canPreviewRoute = accessRow.Edit_All_Pro_Forma_Approvals == true;
                 			if(accessRow.Edit_Owned_Pro_Forma_Approvals == true && isPfOwner)
                 			{
                 				canPreviewRoute = true;
                 			}
                 			if(accessRow.Edit_Owned_Proformas == true && isPfOwner)
                 			{
                 				canPreviewRoute = true;
                 			}
                 			if(accessRow.Send_Pro_Formas_for_Approvals == true && canSendThisProforma)
                 			{
                 				canPreviewRoute = true;
                 			}
                 			if(canPreviewRoute == false)
                 			{
                 				response.put("message","You do not have permission to view this Pro Forma approval route.");
                 				return response;
                 			}
                 			previewResolution = thisapp.resolveApprovalRoute(policyContext);
                 			if(previewResolution.get("success") != true)
                 			{
                 				response.put("message",previewResolution.get("error"));
                 				return response;
                 			}
                 			previewSnapshot = previewResolution.get("snapshot");
                 			previewPolicy = Approval_Policy[ID == previewSnapshot.get("policyId").toLong()];
                 			if(previewPolicy.Enabled != true)
                 			{
                 				response.put("message","Enable the Pro Forma approval policy in Settings before sending approvals.");
                 				return response;
                 			}
                 			previewRoute = previewSnapshot.get("route");
                 			if(previewRoute.size() == 0 || previewRoute.size() > 8)
                 			{
                 				response.put("message","Pro Forma execution supports 1 to 8 approval steps.");
                 				return response;
                 			}
                 			response.put("success",true);
                 			response.put("policyId",previewSnapshot.get("policyId"));
                 			response.put("route",previewRoute);
                 			return response;
                 		}
                 		if(accessRow.Send_Pro_Formas_for_Approvals != true)
                 		{
                 			response.put("success",false);
                 			response.put("message","You do not have Send Pro Formas for Approvals permission.");
                 			return response;
                 		}
                 		if(canSendThisProforma == false)
                 		{
                 			response.put("success",false);
                 			response.put("message","You must be an owner of this Pro Forma to send it for approvals, unless you have Edit All Proformas.");
                 			return response;
                 		}
                 		// Targeted reconciliation uses the existing Custom API argument. Check never
                 		// mutates; Repair makes one bounded attempt to restore the first route/email.
                 		if(progressMode == "Check" || progressMode == "Repair")
                 		{
                 			progressRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			progressFirst = null;
                 			progressCount = 0;
                 			progressPending = 0;
                 			progressApproved = 0;
                 			progressLaterUntouched = true;
                 			for each  progressRow in progressRows
                 			{
                 				progressCount = progressCount + 1;
                 				if(progressFirst == null)
                 				{
                 					progressFirst = progressRow;
                 				}
                 				else if(progressRow.Status != "Not Sent" || progressRow.Sent_Date != null || progressRow.Responded_Date != null || ifnull(progressRow.Approval_Notes,"").trim() != "")
                 				{
                 					progressLaterUntouched = false;
                 				}
                 				if(ifnull(progressRow.Status,"").trim() == "Pending")
                 				{
                 					progressPending = progressPending + 1;
                 				}
                 				if(ifnull(progressRow.Status,"").trim() == "Approved")
                 				{
                 					progressApproved = progressApproved + 1;
                 				}
                 			}
                 			repairError = "";
                 			repairCandidate = false;
                 			if(progressMode == "Repair" && progressFirst != null && progressLaterUntouched && progressApproved == 0)
                 			{
                 				parentCanRepair = ifnull(pf.Status,"").trim() == "Pending Approval";
                 				firstCanRepair = ifnull(progressFirst.Status,"").trim() == "Pending";
                 				pendingCanRepair = progressPending == 1;
                 				repairCandidate = parentCanRepair && firstCanRepair && pendingCanRepair && progressFirst.Responded_Date == null && ifnull(progressFirst.Approval_Notes,"").trim() == "";
                 			}
                 			if(repairCandidate)
                 			{
                 				progressFirst.Status="Pending";
                 				pf.Lock_Inputs=true;
                 				pf.Status="Pending Approval";
                 				if(progressFirst.Sent_Date == null)
                 				{
                 					try 
                 					{
                 						repairEmail = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,progressFirst.ID.toString(),"Started","","System");
                 						if(ifnull(repairEmail.get("success"),false) != true)
                 						{
                 							repairError = ifnull(repairEmail.get("message"),"Approval email could not be sent.").toString();
                 						}
                 					}					catch (repairException)
                 					{
                 						repairError = repairException.toString();
                 					}
                 				}
                 			}
                 			progressRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			progressFirst = null;
                 			progressCount = 0;
                 			progressPending = 0;
                 			progressApproved = 0;
                 			for each  progressRow in progressRows
                 			{
                 				progressCount = progressCount + 1;
                 				if(progressFirst == null)
                 				{
                 					progressFirst = progressRow;
                 				}
                 				if(ifnull(progressRow.Status,"").trim() == "Pending")
                 				{
                 					progressPending = progressPending + 1;
                 				}
                 				if(ifnull(progressRow.Status,"").trim() == "Approved")
                 				{
                 					progressApproved = progressApproved + 1;
                 				}
                 			}
                 			firstIdText = "";
                 			firstStatusText = "";
                 			firstRoleText = "";
                 			firstAddressText = "";
                 			firstSentText = "";
                 			if(progressFirst != null)
                 			{
                 				firstIdText = progressFirst.ID.toString();
                 				firstStatusText = ifnull(progressFirst.Status,"").trim();
                 				firstRoleText = ifnull(progressFirst.Title,"").trim();
                 				firstAddressText = ifnull(progressFirst.Approver,"").trim();
                 				if(progressFirst.Sent_Date != null)
                 				{
                 					firstSentText = progressFirst.Sent_Date.toString();
                 				}
                 			}
                 			response.put("success",true);
                 			response.put("mode",progressMode);
                 			response.put("savedRouteContract","proforma-approval-existing-v1");
                 			response.put("proformaId",proformaIdText);
                 			response.put("status",ifnull(pf.Status,"").toString().trim());
                 			response.put("locked",pf.Lock_Inputs == true);
                 			response.put("rowCount",progressCount);
                 			response.put("pendingCount",progressPending);
                 			response.put("approvedCount",progressApproved);
                 			response.put("firstId",firstIdText);
                 			response.put("firstStatus",firstStatusText);
                 			response.put("role",firstRoleText);
                 			response.put("address",firstAddressText);
                 			response.put("sentDate",firstSentText);
                 			response.put("emailSent",firstSentText != "");
                 			response.put("repairError",repairError);
                 			return response;
                 		}
                 		if(pf.Purchasing_Company == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Select a Purchasing Company before sending this Pro Forma for approvals.");
                 			return response;
                 		}
                 		sellerRows = Builder[Proforma == proformaIdLong];
                 		if(sellerRows.count() == 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Add at least one fully completed Seller record before sending this Pro Forma for approvals.");
                 			return response;
                 		}
                 		incompleteSellers = List();
                 		for each  sellerRow in sellerRows
                 		{
                 			missingSellerFields = List();
                 			if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "")
                 			{
                 				missingSellerFields.add("Seller Name");
                 			}
                 			if(ifnull(sellerRow.Email,"").toString().trim() == "")
                 			{
                 				missingSellerFields.add("Email");
                 			}
                 			if(ifnull(sellerRow.Phone_Number,"").toString().trim() == "")
                 			{
                 				missingSellerFields.add("Phone");
                 			}
                 			if(ifnull(sellerRow.Street_Address,"").toString().trim() == "")
                 			{
                 				missingSellerFields.add("Street Address");
                 			}
                 			if(ifnull(sellerRow.City_State_ZIP,"").toString().trim() == "")
                 			{
                 				missingSellerFields.add("City, State ZIP");
                 			}
                 			if(missingSellerFields.size() > 0)
                 			{
                 				sellerLabel = if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "","Seller " + sellerRow.ID.toString(),sellerRow.Builder_Name.toString());
                 				incompleteSellers.add(sellerLabel + " needs " + missingSellerFields.toString(", "));
                 			}
                 		}
                 		if(incompleteSellers.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Complete the Seller record(s): " + incompleteSellers.toString("; "));
                 			return response;
                 		}
                 		propertyRows = Property[Proforma == proformaIdLong];
                 		if(propertyRows.count() == 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Add at least one fully completed Property record before sending this Pro Forma for approvals.");
                 			return response;
                 		}
                 		incompleteProperties = List();
                 		for each  propertyRow in propertyRows
                 		{
                 			missingPropertyFields = List();
                 			if(ifnull(propertyRow.Common_Name,"").toString().trim() == "")
                 			{
                 				missingPropertyFields.add("Common Name");
                 			}
                 			if(ifnull(propertyRow.Property_ID,"").toString().trim() == "")
                 			{
                 				missingPropertyFields.add("CAD / Property ID");
                 			}
                 			if(ifnull(propertyRow.County,"").toString().trim() == "")
                 			{
                 				missingPropertyFields.add("County");
                 			}
                 			if(ifnull(propertyRow.City,"").toString().trim() == "")
                 			{
                 				missingPropertyFields.add("City");
                 			}
                 			if(propertyRow.Acres == null || propertyRow.Acres <= 0)
                 			{
                 				missingPropertyFields.add("Acres");
                 			}
                 			if(ifnull(propertyRow.TerraVault_URL,"").toString().trim() == "")
                 			{
                 				missingPropertyFields.add("TerraVault URL");
                 			}
                 			if(propertyRow.Seller == null)
                 			{
                 				missingPropertyFields.add("Seller");
                 			}
                 			if(propertyRow.Company1 == null)
                 			{
                 				missingPropertyFields.add("Purchasing Company");
                 			}
                 			if(missingPropertyFields.size() > 0)
                 			{
                 				propertyLabel = if(ifnull(propertyRow.Common_Name,"").toString().trim() == "","Property " + propertyRow.ID.toString(),propertyRow.Common_Name.toString());
                 				incompleteProperties.add(propertyLabel + " needs " + missingPropertyFields.toString(", "));
                 			}
                 		}
                 		if(incompleteProperties.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Complete the Property record(s): " + incompleteProperties.toString("; "));
                 			return response;
                 		}
                 		rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		// A lost API response must not restart an already delivered chain.
                 		firstExisting = null;
                 		existingPending = 0;
                 		existingApproved = 0;
                 		existingHistory = false;
                 		existingLaterUntouched = true;
                 		for each  existingRow in rows
                 		{
                 			if(firstExisting == null)
                 			{
                 				firstExisting = existingRow;
                 			}
                 			else if(existingRow.Status != "Not Sent" || existingRow.Sent_Date != null || existingRow.Responded_Date != null || ifnull(existingRow.Approval_Notes,"").trim() != "")
                 			{
                 				existingLaterUntouched = false;
                 			}
                 			if(existingRow.Status != "Not Sent" || existingRow.Sent_Date != null || existingRow.Responded_Date != null || ifnull(existingRow.Approval_Notes,"").trim() != "")
                 			{
                 				existingHistory = true;
                 			}
                 			if(ifnull(existingRow.Status,"").trim() == "Pending")
                 			{
                 				existingPending = existingPending + 1;
                 			}
                 			if(ifnull(existingRow.Status,"").trim() == "Approved")
                 			{
                 				existingApproved = existingApproved + 1;
                 			}
                 		}
                 		if(firstExisting != null && ifnull(firstExisting.Status,"").trim() == "Pending" && firstExisting.Sent_Date != null && firstExisting.Responded_Date == null && ifnull(firstExisting.Approval_Notes,"").trim() == "" && existingLaterUntouched && existingPending == 1 && existingApproved == 0)
                 		{
                 			pf.Status="Pending Approval";
                 			pf.Lock_Inputs=true;
                 			response.put("success",true);
                 			response.put("message","Approval request was already sent to " + ifnull(firstExisting.Title,"the first approver") + ".");
                 			response.put("pendingApprovalId",firstExisting.ID.toString());
                 			return response;
                 		}
                 		if(existingHistory)
                 		{
                 			response.put("success",false);
                 			response.put("message","This Pro Forma already has approval history. Check its current approval flow before sending again.");
                 			return response;
                 		}
                 		if(progressMode == "StartSettings")
                 		{
                 			if(rows.count() > 0)
                 			{
                 				response.put("success",false);
                 				response.put("message","This Pro Forma has a saved approval route. Refresh before sending.");
                 				return response;
                 			}
                 			typedExpectedPolicy = {"value":progressInput.get("expectedPolicyId")};
                 			if(!typedExpectedPolicy.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]{1,30}\"[ ]*[}][ ]*") || progressInput.get("expectedRoute") == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","Refresh the Settings approval route before sending approvals.");
                 				return response;
                 			}
                 			policyContext.put("expectedPolicyId",progressInput.get("expectedPolicyId"));
                 			policyContext.put("expectedRoute",progressInput.get("expectedRoute"));
                 		}
                 		if(progressInput.get("expectedExistingRoute") != null)
                 		{
                 			expectedExisting = progressInput.get("expectedExistingRoute");
                 			if(expectedExisting.size() != rows.count() || rows.count() == 0)
                 			{
                 				response.put("success",false);
                 				response.put("message","The saved approval route changed. Refresh before sending.");
                 				return response;
                 			}
                 			existingPosition = 0;
                 			for each  savedRow in rows
                 			{
                 				expectedSaved = expectedExisting.get(existingPosition).toString().toMap();
                 				if(expectedSaved.get("id") != savedRow.ID.toString() || expectedSaved.get("role") != ifnull(savedRow.Title,"").trim() || expectedSaved.get("email") != ifnull(savedRow.Approver,"").trim() || expectedSaved.get("order") != savedRow.Sort_Order)
                 				{
                 					response.put("success",false);
                 					response.put("message","The saved approval route changed. Refresh before sending.");
                 					return response;
                 				}
                 				existingPosition = existingPosition + 1;
                 			}
                 		}
                 		policyExecution = thisapp.applySharedApprovalPolicy(policyContext);
                 		if(policyExecution.get("success") != true)
                 		{
                 			response.put("success",false);
                 			response.put("message",policyExecution.get("error"));
                 			return response;
                 		}
                 		if(policyExecution.get("shared") == true)
                 		{
                 			response.put("policySnapshotId",policyExecution.get("snapshotId"));
                 		}
                 		else if(policyExecution.get("retainedExistingRoute") != true)
                 		{
                 			response.put("success",false);
                 			response.put("message","Configure and enable the Pro Forma approval policy in Settings before sending approvals.");
                 			return response;
                 		}
                 		rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		if(rows.count() == 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Add at least one approval step before submitting this Pro Forma.");
                 			return response;
                 		}
                 		missingRecipients = List();
                 		missingTitles = List();
                 		expectedOrder = 1;
                 		for each  row in rows
                 		{
                 			rowTitle = ifnull(row.Title,"").toString().trim();
                 			rowEmail = ifnull(row.Approver,"").toString().trim();
                 			if(rowTitle == "")
                 			{
                 				missingTitles.add("Step " + expectedOrder.toString());
                 			}
                 			if(rowEmail == "")
                 			{
                 				missingRecipients.add(if(rowTitle == "","Step " + expectedOrder.toString(),rowTitle));
                 			}
                 			// Normalize the sequence before routing so there can be no gaps.
                 			row.Sort_Order=expectedOrder;
                 			expectedOrder = expectedOrder + 1;
                 		}
                 		if(missingTitles.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Missing approval step name for: " + missingTitles.toString(", "));
                 			return response;
                 		}
                 		if(missingRecipients.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Missing approver email for: " + missingRecipients.toString(", "));
                 			return response;
                 		}
                 		for each  row in rows
                 		{
                 			row.Status="Not Sent";
                 			row.Approval_Notes="";
                 			row.Sent_Date=null;
                 			row.Responded_Date=null;
                 		}
                 		firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
                 		if(firstRow.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","The first approval row could not be found.");
                 			return response;
                 		}
                 		firstRow.Status="Pending";
                 		// The email helper stamps Sent_Date only after sendmail succeeds.
                 		firstRow.Sent_Date=null;
                 		firstRow.Responded_Date=null;
                 		pf.Lock_Inputs=true;
                 		previousPfStatus = ifnull(pf.Status,"Draft");
                 		pf.Status="Pending Approval";
                 		emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Started","","System");
                 		if(ifnull(emailResult.get("success"),false) != true)
                 		{
                 			firstRow.Status="Not Sent";
                 			firstRow.Sent_Date=null;
                 			pf.Lock_Inputs=false;
                 			pf.Status=previousPfStatus;
                 			response.put("success",false);
                 			response.put("message",emailResult.get("message"));
                 			return response;
                 		}
                 		pf.Status="Pending Approval";
                 		response.put("success",true);
                 		response.put("message","Approval request sent to " + firstRow.Title + " with the approval PDF packet.");
                 		response.put("pendingApprovalId",firstRow.ID.toString());
                 		response.put("packetFileName",emailResult.get("packetFileName"));
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string submitBudgetModification(int modificationId)
                 {
                 	/********* SUBMIT BUDGET MODIFICATION *********/
                 	// Return Type: string ("OK: ..." or "ERROR: ...")
                 	// Promotes a Draft modification using its published Settings approval rule,
                 	// marks it Submitted, and sends the first approval email.
                 	vModId = modificationId.toLong();
                 	if(vModId == 0)
                 	{
                 		return "ERROR: No modification provided.";
                 	}
                 	modRec = Budget_Modification[ID == vModId];
                 	if(modRec == null)
                 	{
                 		return "ERROR: Modification not found.";
                 	}
                 	if(ifnull(modRec.Reference_Number,"").startsWith("PO:"))
                 	{
                 		return "ERROR: This modification is approved with its Purchase Order. Open the PO to edit or resubmit.";
                 	}
                 	if(ifnull(modRec.Status,"") != "Draft" && ifnull(modRec.Status,"") != "Submitted")
                 	{
                 		return "ERROR: This modification cannot be submitted from its current status.";
                 	}
                 	firstExisting = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"] sort by Sort_Order;
                 	if(ifnull(modRec.Status,"") == "Submitted" && firstExisting.count() > 0)
                 	{
                 		firstSubmitted = null;
                 		pendingSubmitted = 0;
                 		approvedSubmitted = 0;
                 		for each  submittedRow in firstExisting
                 		{
                 			if(firstSubmitted == null)
                 			{
                 				firstSubmitted = submittedRow;
                 			}
                 			if(ifnull(submittedRow.Status,"") == "Pending")
                 			{
                 				pendingSubmitted = pendingSubmitted + 1;
                 			}
                 			if(ifnull(submittedRow.Status,"") == "Approved")
                 			{
                 				approvedSubmitted = approvedSubmitted + 1;
                 			}
                 		}
                 		if(approvedSubmitted > 0)
                 		{
                 			return "ERROR: Modification approvals are already in progress.";
                 		}
                 		if(firstSubmitted != null && ifnull(firstSubmitted.Status,"") == "Pending" && firstSubmitted.Sent_Date != null && pendingSubmitted == 1)
                 		{
                 			return "OK: Modification already submitted and first approval email sent.";
                 		}
                 	}
                 	vBudgetId = 0;
                 	if(modRec.Budget != null)
                 	{
                 		vBudgetId = modRec.Budget.ID;
                 	}
                 	policyTerritory = "";
                 	if(vBudgetId != 0)
                 	{
                 		policyBudget = Add_Budget[ID == vBudgetId];
                 		if(policyBudget.Subdivision1 != null)
                 		{
                 			policyTerritory = ifnull(policyBudget.Subdivision1.Territory,"");
                 		}
                 	}
                 	policySubmitter = User_Access[User == zoho.loginuser];
                 	policyContext = {"workflow":"Budget Modification","recordId":vModId.toString(),"budgetId":vBudgetId.toString(),"territory":policyTerritory,"department":ifnull(modRec.Approval_Track,"Development"),"submitterId":ifnull(policySubmitter.ID,0).toString(),"amount":thisapp.poCurrencyString(modRec.Amount.toString())};
                 	policyExecution = thisapp.applySharedApprovalPolicy(policyContext);
                 	if(policyExecution.get("success") != true)
                 	{
                 		return "ERROR: Approval template could not be loaded: " + policyExecution.get("error");
                 	}
                 	if(policyExecution.get("shared") != true && policyExecution.get("retainedExistingRoute") != true)
                 	{
                 		return "ERROR: Promote the Settings-based Budget Modification approval functions before submitting.";
                 	}
                 	existing = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"];
                 	if(existing.count() == 0)
                 	{
                 		return "ERROR: The Settings approval route did not create a chain. No approval email was sent.";
                 	}
                 	modRec.Status="Submitted";
                 	emailMsg = "";
                 	try 
                 	{
                 		emailMsg = thisapp.sendModificationEmail(vModId,"created");
                 	}	catch (emailException)
                 	{
                 		emailMsg = "Approval email could not be sent: " + emailException.toString();
                 	}
                 	return "OK: Modification submitted. " + ifnull(emailMsg,"");
                 }
				 string Submit_LOI_For_Legal_Approval(string proformaId)
                 {
                 	result = Map();
                 	try 
                 	{
                 		legalAccess = User_Access[User == zoho.loginuser];
                 		if(legalAccess.count() == 0 || legalAccess.Submit_to_Legal_Module != true)
                 		{
                 			result.put("success",false);
                 			result.put("message","Submit to Legal Module access is required.");
                 			return result.toString();
                 		}
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		missing = List();
                 		if(pf.Lock_Inputs != true)
                 		{
                 			missing.add("Lock Inputs");
                 		}
                 		if(pf.Seller == null || pf.Seller.trim() == "")
                 		{
                 			missing.add("Seller");
                 		}
                 		if(pf.Authorized_Signer_for_Seller == null || pf.Authorized_Signer_for_Seller.trim() == "")
                 		{
                 			missing.add("Authorized Signer for Seller");
                 		}
                 		if(pf.Street_Address == null || pf.Street_Address.trim() == "")
                 		{
                 			missing.add("Street Address");
                 		}
                 		if(pf.Seller_City_State_ZIP == null || pf.Seller_City_State_ZIP.trim() == "")
                 		{
                 			missing.add("Seller City State ZIP");
                 		}
                 		if(pf.Seller_Phone == null || pf.Seller_Phone.trim() == "")
                 		{
                 			missing.add("Seller Phone");
                 		}
                 		if(pf.Seller_Email == null || pf.Seller_Email.trim() == "")
                 		{
                 			missing.add("Seller Email");
                 		}
                 		if(pf.Purchasing_Company == null)
                 		{
                 			missing.add("Purchasing Company");
                 		}
                 		if(pf.CAD_ID == null || pf.CAD_ID.trim() == "")
                 		{
                 			missing.add("CAD ID");
                 		}
                 		if(pf.Property_County == null || pf.Property_County.trim() == "")
                 		{
                 			missing.add("Property County");
                 		}
                 		if(pf.Property_City == null || pf.Property_City.trim() == "")
                 		{
                 			missing.add("Property City");
                 		}
                 		if(pf.Total_Acres == null)
                 		{
                 			missing.add("Total Acres");
                 		}
                 		if(pf.Land_Cost_Acre == null)
                 		{
                 			missing.add("Amount per Acre");
                 		}
                 		if(pf.Earnest_Money == null)
                 		{
                 			missing.add("Earnest Money");
                 		}
                 		if(pf.Initial_Feasibility_Days == null)
                 		{
                 			missing.add("Initial Feasibility Days");
                 		}
                 		if(pf.Extensions == null)
                 		{
                 			missing.add("Extensions");
                 		}
                 		if(pf.Days_per_Extension == null)
                 		{
                 			missing.add("Days per Extension");
                 		}
                 		if(pf.Amount_per_Extension == null)
                 		{
                 			missing.add("Amount per Extension");
                 		}
                 		if(pf.Closing_Days_Feas == null)
                 		{
                 			missing.add("Closing Days after Feasibility");
                 		}
                 		if(pf.Response_Date == null)
                 		{
                 			missing.add("Response Date");
                 		}
                 		if(missing.size() > 0)
                 		{
                 			result.put("success",false);
                 			result.put("message","Complete the required LOI fields before sending to Legal: " + missing.toString(", "));
                 			result.put("missing",missing);
                 			return result.toString();
                 		}
                 		legalEmail = "rbelliveau@wbdevelopment.com";
                 		if(legalEmail == "LEGAL_EMAIL_HERE" || legalEmail.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","Replace LEGAL_EMAIL_HERE in Submit_LOI_For_Legal_Approval before using this function.");
                 			return result.toString();
                 		}
                 		buyingEntityName = pf.Purchasing_Company.toString();
                 		companyRec = Company[ID == pf.Purchasing_Company];
                 		if(companyRec.ID != null && companyRec.Company_Name != null && companyRec.Company_Name.trim() != "")
                 		{
                 			buyingEntityName = companyRec.Company_Name.trim();
                 		}
                 		token = pf.ID.toString() + "-" + zoho.currenttime.toLong().toString() + "-" + randomNumber(100000000,999999999).toString();
                 		reviewUrl = zoho.appuri + "page-embed/Contracts?loiReviewId=" + pf.ID.toString() + "&token=" + token;
                 		pf.LOI_Legal_Status="Pending Approval";
                 		pf.LOI_Approval_Token=token;
                 		pf.LOI_Legal_Note="";
                 		specialProvisions = if(pf.Special_Provisions == null || pf.Special_Provisions.trim() == "","None.",pf.Special_Provisions);
                 		buyerBroker = if(pf.Broker_Buyer == null || pf.Broker_Buyer.trim() == "","None",pf.Broker_Buyer);
                 		sellerBroker = if(pf.Broker_Seller == null || pf.Broker_Seller.trim() == "","None",pf.Broker_Seller);
                 		emailBody = "<div style='font-family:Arial,sans-serif;color:#173252;max-width:760px'>";
                 		emailBody = emailBody + "<h2 style='margin:0 0 6px'>LOI Review Request: " + ifnull(pf.Name,"Pro Forma") + "</h2>";
                 		emailBody = emailBody + "<p style='margin:0 0 18px;color:#5c7394'>Please review the terms below. Approval from Contract Management will create the Acquisition Contract and generate the LOI document.</p>";
                 		emailBody = emailBody + "<table cellpadding='7' cellspacing='0' style='border-collapse:collapse;width:100%;font-size:13px'>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Seller</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Seller,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Authorized Signer</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Authorized_Signer_for_Seller,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Property</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Street_Address,"") + ", " + ifnull(pf.Seller_City_State_ZIP,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Purchasing Company</b></td><td style='border:1px solid #dde4ef'>" + buyingEntityName + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>CAD ID</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.CAD_ID,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>County / City</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Property_County,"") + " / " + ifnull(pf.Property_City,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Total Acres</b></td><td style='border:1px solid #dde4ef'>" + pf.Total_Acres.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Amount per Acre</b></td><td style='border:1px solid #dde4ef'>$" + pf.Land_Cost_Acre.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Earnest Money</b></td><td style='border:1px solid #dde4ef'>$" + pf.Earnest_Money.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Feasibility</b></td><td style='border:1px solid #dde4ef'>" + pf.Initial_Feasibility_Days.toString() + " days; " + pf.Extensions.toString() + " extension(s) of " + pf.Days_per_Extension.toString() + " days at $" + pf.Amount_per_Extension.toString() + " each</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Closing</b></td><td style='border:1px solid #dde4ef'>" + pf.Closing_Days_Feas.toString() + " days after feasibility</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Response Date</b></td><td style='border:1px solid #dde4ef'>" + pf.Response_Date.toString("MM/dd/yyyy") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Buyer Broker</b></td><td style='border:1px solid #dde4ef'>" + buyerBroker + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Seller Broker</b></td><td style='border:1px solid #dde4ef'>" + sellerBroker + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Special Provisions</b></td><td style='border:1px solid #dde4ef'>" + specialProvisions + "</td></tr>";
                 		emailBody = emailBody + "</table>";
                 		emailBody = emailBody + "<p style='margin:20px 0'><a href='" + reviewUrl + "' style='display:inline-block;background:#2563eb;color:white;text-decoration:none;padding:11px 18px;border-radius:8px;font-weight:bold'>Review LOI in Contract Management</a></p>";
                 		emailBody = emailBody + "</div>";
                 		sendmail
                 		[
                 			from :"Notifications@wbdevelopment.com"
                 			to :legalEmail
                 			subject :"LOI Review Request - " + ifnull(pf.Name,"Pro Forma")
                 			message :emailBody
                 		]
                 		result.put("success",true);
                 		result.put("message","LOI sent to Legal for approval.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("reviewUrl",reviewUrl);
                 		result.put("status","Pending Approval");
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI approval request failed at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		return result.toString();
                 	}
                 	return "nice";
                 }
				 string syncBudgetApprovalStatus(int budgetId, string approvalType)
                 {
                 	/********* SYNC PARENT BUDGET APPROVAL STATUS *********/
                 	// Return Type: string
                 	// Updates Add_Budget.Const_Budget_Approval_Status or Add_Budget.Development_Budget_Approval_Status
                 	// based on the current approval rows for the selected approval type.
                 	// Parent statuses stay simple: Not Sent, Pending, Approved.
                 	// Rejected approval rows are treated as Pending at the parent level because the chain is still active.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "No approval type provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	totalRows = 0;
                 	approvedRows = 0;
                 	startedRows = 0;
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"") == vApprovalType)
                 		{
                 			totalRows = totalRows + 1;
                 			apprStatus = ifnull(appr.Status,"");
                 			if(apprStatus == "")
                 			{
                 				apprStatus = "Not Sent";
                 			}
                 			if(apprStatus == "Approved")
                 			{
                 				approvedRows = approvedRows + 1;
                 				startedRows = startedRows + 1;
                 			}
                 			else if(apprStatus == "Pending" || apprStatus == "Rejected")
                 			{
                 				startedRows = startedRows + 1;
                 			}
                 		}
                 	}
                 	parentStatus = "Not Sent";
                 	if(totalRows > 0 && approvedRows == totalRows)
                 	{
                 		parentStatus = "Approved";
                 	}
                 	else if(startedRows > 0)
                 	{
                 		parentStatus = "Pending";
                 	}
                 	else
                 	{
                 		parentStatus = "Not Sent";
                 	}
                 	if(vApprovalType == "Construction")
                 	{
                 		budgetRec.Const_Budget_Approval_Status=parentStatus;
                 	}
                 	else if(vApprovalType == "Development")
                 	{
                 		budgetRec.Development_Budget_Approval_Status=parentStatus;
                 	}
                 	return vApprovalType + " budget approval status synced to " + parentStatus + ".";
                 }
				 string territoryApproverEmail(string territoryName, string role)
                 {
                 	/********* TERRITORY DEFAULT APPROVER *********/
                 	// Return Type: string (email address, or "" when no default is configured)
                 	// Resolves a territory's default approver from the Territory form:
                 	//   role "VP"      -> Territory.VP
                 	//   role "Dev Mgr" -> Territory.Dev_Mgr
                 	// Both are multi-select lookups to User_Access; the email comes from that
                 	// row's Approver_Email. User_Access.User is a Users picklist whose value is
                 	// the Zoho login name (e.g. "jking_wbdevelopment84"), NOT an email address,
                 	// so Approver_Email is the only reliable routing address.
                 	// Callers fall back to their own default when this returns "".
                 	vName = ifnull(territoryName,"").trim();
                 	vRole = ifnull(role,"").trim().toLowerCase();
                 	if(vName == "")
                 	{
                 		return "";
                 	}
                 	terrRec = Territory[Territory_Name == vName];
                 	if(terrRec == null)
                 	{
                 		return "";
                 	}
                 	people = terrRec.VP;
                 	if(vRole == "dev mgr" || vRole == "devmgr" || vRole == "dev manager")
                 	{
                 		people = terrRec.Dev_Mgr;
                 	}
                 	if(people == null)
                 	{
                 		return "";
                 	}
                 	out = "";
                 	for each  personRow in people
                 	{
                 		if(out == "")
                 		{
                 			uaRec = User_Access[ID == personRow.ID];
                 			if(uaRec != null)
                 			{
                 				cand = ifnull(uaRec.Approver_Email,"").trim();
                 				if(cand != "")
                 				{
                 					out = cand;
                 				}
                 			}
                 		}
                 	}
                 	return out;
                 }
				 string Update_Assigned_To_Me(string user, string area, bool enabled)
                 {
                 	requester = zoho.loginuser;
                 	if(requester == null || requester.trim() == "")
                 	{
                 		requester = user;
                 	}
                 	result = Map();
                 	result.put("success",false);
                 	if(requester == null || requester.trim() == "")
                 	{
                 		result.put("message","A signed-in Creator user is required.");
                 		return result.toString();
                 	}
                 	key = area.toLowerCase().trim();
                 	fieldName = "";
                 	if(key == "budget" || key == "budgets")
                 	{
                 		fieldName = "Budgets_Assigned_to_Me";
                 		key = "budget";
                 	}
                 	else if(key == "proforma" || key == "pro_forma" || key == "proformas")
                 	{
                 		fieldName = "Pro_Forma_Assigned_to_Me";
                 		key = "proforma";
                 	}
                 	else if(key == "legal" || key == "contracts")
                 	{
                 		fieldName = "Legal_Assigned_to_Me";
                 		key = "legal";
                 	}
                 	else
                 	{
                 		result.put("message","Unknown Assigned to Me area.");
                 		return result.toString();
                 	}
                 	accessRow = User_Access[User == requester];
                 	if(accessRow.ID == null)
                 	{
                 		result.put("message","No User Access record was found for the signed-in user.");
                 		return result.toString();
                 	}
                 	if(fieldName == "Budgets_Assigned_to_Me")
                 	{
                 		accessRow.Budgets_Assigned_to_Me=enabled;
                 	}
                 	else if(fieldName == "Pro_Forma_Assigned_to_Me")
                 	{
                 		accessRow.Pro_Forma_Assigned_to_Me=enabled;
                 	}
                 	else
                 	{
                 		accessRow.Legal_Assigned_to_Me=enabled;
                 	}
                 	result.put("success",true);
                 	result.put("area",key);
                 	result.put("enabled",enabled);
                 	result.put("userAccessId",accessRow.ID.toString());
                 	return result.toString();
                 }
				 map Update_Proforma_Approval_Recipient(map request)
                 {
                 	// Retired compatibility endpoint. Preserve captured recipients and history.
                 	response = Map();
                 	response.put("success",false);
                 	response.put("message","Manage Pro Forma approvers in Settings > Approval Policies.");
                 	return response;
                 }
				 string utilitiesconvertIntegerToCurrency(int number)
                 {
                 	separator = ",";
                 	// --- specify your type of separator (i'm using a comma)
                 	divisor = 3;
                 	// specify how many digits in between each separator
                 	// --- convert integer to string & remove hyphen if number is negative
                 	string = number.toString().remove("-");
                 	// --- get length of string
                 	stringLen = string.length();
                 	separators = 0;
                 	// --- calculate how many separators will be needed to construct your currency string
                 	// ------ if equally divisible 3, reduce number of separators by one (basically checks to see if number of digits is exactly divisible by 3 which means there will be one less separator)
                 	if(stringLen / divisor = (stringLen / divisor).floor())
                 	{
                 		separators = stringLen / divisor - 1;
                 	}
                 	// ------ if there is a remainder after dividing by 3, set the # of separators (basically, this means there is 1 or 2 digits at the front of the number, in front of the very first separator)
                 	else
                 	{
                 		separators = (stringLen / divisor).floor();
                 	}
                 	// --- build your List needed for 'for each' loop
                 	// ------ makeRange is a custom function required to build the List
                 	range = thisapp.utilitiesmakeRange(1,separators);
                 	stringBuild = "";
                 	// --- declare stringBuild variable used to continually construct the sting
                 	// --- execute 'for each' loop to parse through the number and add separators
                 	for each  i in range
                 	{
                 		// --- append separator to front of substring and add suffix of stringBuild value from previous loop iteration
                 		stringBuild = separator + string.substring(stringLen - i * divisor,stringLen - (i - 1) * divisor) + stringBuild;
                 	}
                 	// --- get the first set of leading digits before the first separator
                 	stringBuild = string.substring(0,stringLen - separators * divisor) + stringBuild;
                 	// --- now let's bring it all together
                 	// ------ check to see if number is positive or negative and format accordingly (you can change how you want to handle negative numbers, I wrap them in parentheses but you can modify this code to add a hyphen as the prefix, with no parentheses)
                 	if(number < 0)
                 	{
                 		numConverted = "($" + stringBuild + ")";
                 		// --- parentheses formatting for negative #'s
                 	}
                 	else
                 	{
                 		numConverted = "$" + stringBuild;
                 	}
                 	return numConverted;
                 }
				 list utilitiesmakeRange(int start, int end)
                 {
                 	if(start > end)
                 	{
                 		return {};
                 	}
                 	else
                 	{
                 		lst = List:Int();
                 		lst.add(start);
                 		lst.addAll(thisapp.utilitiesmakeRange(start + 1,end));
                 		return lst;
                 	}
                 }
				 map workflowRunLog(map event)
                 {
                 	// Independent API transaction: an importer exception cannot roll this record back.
                 	// Final timestamps and failure mail run in the log form's own on-success transaction.
                 	result = Map();
                 	action = ifnull(event.get("action"),"").toString();
                 	runtimeType = ifnull(thisapp.environment.type,"").toString().toLowerCase();
                 	runtimeLink = ifnull(thisapp.environment.linkname,"").toString();
                 	if(runtimeType != "development" && runtimeType != "stage" && runtimeType != "production")
                 	{
                 		throw "Unknown Creator environment: type=" + runtimeType + "; link=" + runtimeLink + ". Audit refused cross-environment write.";
                 	}
                 	headers = {"Content-Type":"application/json"};
                 	if(runtimeType != "production")
                 	{
                 		headers.put("environment",runtimeLink);
                 	}
                 	fields = Map();
                 	runIdText = "";
                 	status = "Running";
                 	if(action == "start")
                 	{
                 		workflowName = ifnull(event.get("workflow"),"").toString().trim();
                 		systemName = ifnull(event.get("system"),"").toString().trim();
                 		if(workflowName == "" || systemName == "")
                 		{
                 			throw "Workflow audit requires a workflow name and external system.";
                 		}
                 		fields = {"Workflow_Name":workflowName,"External_System":systemName,"Run_Status":"Running","Started_At":zoho.currenttime.toString("MM/dd/yyyy hh:mm:ss a"),"Stage":"Starting","Rows_Received":0,"Rows_Processed":0,"Rows_Created":0,"Rows_Updated":0,"Rows_Skipped":0,"Rows_Failed":0,"Failure_Notified":false};
                 	}
                 	else
                 	{
                 		if(action != "update" && action != "finish")
                 		{
                 			throw "Unknown workflow audit action: " + action;
                 		}
                 		runIdText = ifnull(event.get("id"),"").toString();
                 		if(!runIdText.matches("[0-9]+"))
                 		{
                 			throw "Workflow audit update requires its numeric run ID.";
                 		}
                 		status = ifnull(event.get("status"),"Running").toString();
                 		statuses = {"Running","Success","Failed","Partial","Skipped","Timed Out"};
                 		if(!statuses.contains(status))
                 		{
                 			throw "Unknown workflow audit status: " + status;
                 		}
                 		fields.put("Run_Status",status);
                 		textFields = {"stage":"Stage","reference":"External_Reference","message":"Message","details":"Details"};
                 		for each  key in textFields.keys()
                 		{
                 			if(event.get(key) != null)
                 			{
                 				value = event.get(key).toString();
                 				limit = 255;
                 				if(key == "message")
                 				{
                 					limit = 5000;
                 				}
                 				if(key == "details")
                 				{
                 					limit = 30000;
                 				}
                 				if(value.length() > limit)
                 				{
                 					value = value.left(limit);
                 				}
                 				fields.put(textFields.get(key),value);
                 			}
                 		}
                 		counts = event.get("counts");
                 		countFields = {"received":"Rows_Received","processed":"Rows_Processed","created":"Rows_Created","updated":"Rows_Updated","skipped":"Rows_Skipped","failed":"Rows_Failed"};
                 		if(counts != null)
                 		{
                 			for each  key in countFields.keys()
                 			{
                 				if(counts.get(key) != null)
                 				{
                 					fields.put(countFields.get(key),counts.get(key));
                 				}
                 			}
                 		}
                 	}
                 	payload = {"data":fields};
                 	if(action == "start")
                 	{
                 		http = invokeurl
                 		[
                 			url :"https://www.zohoapis.com/creator/v2.1/data/wbdevelopment/land-master/form/Workflow_Run_Log"
                 			type :POST
                 			parameters:payload.toString()
                 			headers:headers
                 			detailed:true
                 			connection:"workflow_audit_admin"
                 		];
                 	}
                 	else
                 	{
                 		http = invokeurl
                 		[
                 			url :"https://www.zohoapis.com/creator/v2.1/data/wbdevelopment/land-master/report/Workflow_Run_Log_Report/" + runIdText
                 			type :PATCH
                 			parameters:payload.toString()
                 			headers:headers
                 			detailed:true
                 			connection:"workflow_audit_admin"
                 		];
                 	}
                 	if(http.get("responseCode") < 200 || http.get("responseCode") >= 300)
                 	{
                 		throw "Workflow audit HTTP " + http.get("responseCode") + "; environment=" + runtimeLink + ". Do not replay an unknown write.";
                 	}
                 	body = http.get("responseText").toString().toMap();
                 	if(ifnull(body.get("code"),"").toString() != "3000" || body.get("error") != null)
                 	{
                 		throw "Creator rejected workflow audit write; code=" + body.get("code") + "; " + body.get("message");
                 	}
                 	ack = body;
                 	if(body.get("result") != null)
                 	{
                 		if(body.get("result").size() != 1 || body.get("data") != null)
                 		{
                 			throw "Creator returned ambiguous audit results. Do not replay.";
                 		}
                 		ack = body.get("result").get(0);
                 	}
                 	if(ifnull(ack.get("code"),"").toString() != "3000" || ack.get("data") == null || ack.get("error") != null)
                 	{
                 		throw "Creator did not acknowledge the audit record. Do not replay.";
                 	}
                 	ackId = ifnull(ack.get("data").get("ID"),"").toString();
                 	if(!ackId.matches("[0-9]+") || (runIdText != "" && ackId != runIdText))
                 	{
                 		throw "Creator did not acknowledge the intended audit record ID. Do not replay.";
                 	}
                 	result.put("id",ackId);
                 	result.put("status",status);
                 	return result;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Mass_Create_Lots as "Mass Create Lots"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											//set variables
										lotNamer = input.Lot_Start_Number;
										blockNum = input.Block.toString();
										lots = input.Lot_End_Number - input.Lot_Start_Number + 1;
										counter = leftpad("1",lots).replaceAll(" ","1,").toList();
										//if a buyer is selected in Mass Create, then create lots as Contracted
										lotStatus = "Open";
										if(input.Buyer != null)
										{
											lotStatus = "Contracted";
										}
										//create lots loop
										for each index i in counter
										{
											lotName2 = lotNamer.toString();
											if(lotName2.length() < 2)
											{
												lotName2 = leftpad(lotName2,2).replaceAll(" ","0");
											}
											if(blockNum.length() < 2)
											{
												blockNum = leftpad(blockNum,2).replaceAll(" ","0");
											}
											insert into Lots
											[
												Lot_Number=lotNamer
												Subdivision_Code=input.Subdivision_Code
												Lot_Code=input.Subdivision_Code + '-B' + blockNum + '-L' + lotName2.toString()
												Added_User=zoho.loginuser
												Subdivision=input.Subdivision
												Block=input.Block
												Phase=input.Phase
												Base_Price=input.Base_Price
												Escalator=input.Escalator
												Escalator_Start_Date=input.Escalator_Start_Date
												City=input.City
												County=input.County
												Additional_Fees=input.Additional_Fees
												Builder1=input.Buyer
												Status=lotStatus
												Fee_Type=input.Fee_Type
												Earnest_Money=input.Earnest_Money
												Lot_Size=input.Lot_Size
											]
											lotNamer = lotNamer + 1;
										}
										//return lotNamer + " Lots Created";
						)
					}
				}

			}
			Set_Subdiv_Code as "Set Subdiv Code"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add

				on user input of Subdivision
				{
					actions 
