			Calc_Land_Cost_Pro_Forma as "Calc Land Cost - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Land_Cost_Acre
				{
					actions 
					{
						custom deluge script
						(
											if(Land_Cost_Acre != null && input.Total_Acres != null)
										{
											installmentSum = 0;
											input.Land_Cost = input.Land_Cost_Acre * input.Total_Acres;
											for each  installment in input.Land_Purchase_Installments
											{
												installmentSum = installmentSum + installment.Cost;
											}
										}
						)
					}
				}

			}
			Calc_Land_Cost_Pro_Forma1 as "Calc Land Cost - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Total_Acres
				{
					actions 
					{
						custom deluge script
						(
											if(Land_Cost_Acre != null && input.Total_Acres != null)
										{
											installmentSum = 0;
											input.Land_Cost = input.Land_Cost_Acre * input.Total_Acres;
											for each  installment in input.Land_Purchase_Installments
											{
												installmentSum = installmentSum + installment.Cost;
											}
										}
						)
					}
				}

			}
			Populate_Land_Purch_Insta as "Populate Land Purch Installments - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Purchase_Installments
				{
					actions 
					{
						custom deluge script
						(
											input.Land_Purchase_Installments.clear();
										loop = thisapp.forLoop(1,input.Purchase_Installments);
										installmentStart = 1;
										for each  el in loop
										{
											row = Add_Pro_Forma.Land_Purchase_Installments();
											row.Installment=installmentStart;
											row.Month1=installmentStart;
											row.Percent1=100 / input.Purchase_Installments;
											row.Cost=input.Land_Cost / input.Purchase_Installments;
											row.Date1=input.Estimated_Purchase_Date.addMonth(installmentStart - 1);
											row.Type1="Purchase";
											input.Land_Purchase_Installments.insert(row);
											installmentStart = installmentStart + 1;
										}
						)
					}
				}

			}
			Update_Pro_Forma_Months_B as "Update Pro Forma Months - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											//CLEAR ALL RELEVANT MONTH VALUES BEFORE RECALC
										if(input.Budget.Pro_Forma != null)
										{
											for each  mnth in Proforma_Months[Proforma == input.Budget.Pro_Forma]
											{
												mnth.Construction_Cost_Addl=null;
												mnth.Entitlement_Engineering_Addl=null;
												mnth.Reimbursed_Fees=null;
												mnth.Reimbursements=null;
												mnth.Cash_Flow=null;
												mnth.Running_Cash_Flow=null;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											//FILL OUT ENG COST
											//getUrl("https://postman-echo.com/delay/12");
											startMo = 1;
											addlCosts = Budget_Item[Budget == input.Budget && Add_l_Cost != null && Budget_Category.Budget_Category_Name != "Reimbursements" && Budget_Category.Deparment == "Engineering" || Budget_Category.Deparment == "Development"];
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Eng_Phase != null] sort by Eng_Phase,Date1;
											//mnths = Proforma_Months [ <field> <opr> <expression> ] sort by Const_Phase, Date1;
											for each  month in mnths
											{
												addlCost = 0;
												for each  cost in addlCosts
												{
													if(cost.Start_Phase <= month.Eng_Phase && cost.End_Phase >= month.Eng_Phase)
													{
														//count number of phases
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Budget.Pro_Forma.Engineering_Length_Months.toLong();
														addlCost = addlCost + cost.Add_l_Cost / costSpread;
													}
												}
												//cCurve = Construction_Curve[Pro_Forma == input.ID && Month_Number == startMo];
												phz = Proforma_Phase[Pro_Forma = input.Budget.Pro_Forma && Phase = month.Eng_Phase];
												month.Entitlement_Engineering=input.Budget.Pro_Forma.Engineering_Cost_Lot * phz.Total_Lots / input.Budget.Pro_Forma.Engineering_Length_Months;
												month.Entitlement_Engineering_Addl=addlCost;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											// FILL OUT CONST COST ON MONTHS (Deluge-safe)
											addlCosts = Budget_Item[Budget == input.Budget && Add_l_Cost != null && Budget_Category.Deparment == "Construction"];
											baseCost = ifnull(input.Budget.Pro_Forma.Ft_St_per_Lot,0) * ifnull(input.Budget.Pro_Forma.Const_Cost_FF,0);
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Const_Phase != null] sort by Const_Phase,Date1;
											// Preload phase → Total_Lots
											phaseLots = Map();
											for each  ph in Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma]
											{
												phaseLots.put(ph.Phase,ifnull(ph.Total_Lots,0));
											}
											// Preload curve percents ordered by Month_Number
											curvePercents = List();
											for each  c in Construction_Curve[Pro_Forma == input.Budget.Pro_Forma] sort by Month_Number
											{
												curvePercents.add(ifnull(c.Percent_Cost,0));
											}
											curveSize = curvePercents.size().toLong();
											idx = 0;
											// Apply costs per month (minimal loop body, no ternary)
											for each  month in mnths
											{
												addlCost = 0;
												for each  cost in addlCosts
												{
													if(cost.Start_Phase <= month.Const_Phase && cost.End_Phase >= month.Const_Phase)
													{
														//count number of phases
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Budget.Pro_Forma.Construction_Length.toLong();
														addlCost = addlCost + cost.Add_l_Cost / numPhases;
													}
												}
												lots = ifnull(phaseLots.get(month.Const_Phase),0);
												pct = 0;
												if(curveSize > 0)
												{
													pct = ifnull(curvePercents.get(idx),0);
												}
												//info lots.toString() + " - " + baseCost.toString() + " - " + pct.toString();
												month.Construction_Cost_Base=lots * baseCost * pct / 100;
												month.Construction_Cost_Addl=addlCost * pct / 100;
												idx = idx + 1;
												if(idx >= curveSize)
												{
													idx = 0;
												}
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											// REIMBURSEMENTS (NON IMPACT FEES) SPREAD ACROSS PHASES OR MONTHS
											// Get all reimbursement items once for this budget
											reimbList = Budget_Item[Budget == input.Budget && Budget_Category.Budget_Category_Name == "Reimbursements" && Add_l_Cost != null];
											for each  reimb in reimbList
											{
												if(reimb.Item_Name.contains("Impact Fees") == false)
												{
													// This will hold the months that match this reimbursement
													// PATH 1: Phase-defined (Start_Phase / End_Phase)
													if(reimb.Start_Phase != null && reimb.End_Phase != null)
													{
														matchedMonths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Eng_Phase >= reimb.Start_Phase && Eng_Phase <= reimb.End_Phase];
													}
													// PATH 2: Month-defined (Start_Month / End_Month)
													else if(reimb.Start_Phase == null && reimb.End_Phase == null)
													{
														matchedMonths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 >= reimb.Start_Month && Month1 <= reimb.End_Month];
													}
													// Only proceed if we actually found months (avoid "invalid collection object")
													if(matchedMonths != null)
													{
														denom = matchedMonths.distinct(Month1).size();
														if(denom > 0)
														{
															perMonthAmount = reimb.Add_l_Cost / denom;
															// Track which Month1 values have already had this reimb applied
															monthApplied = List();
															// Add this reimb's share ON TOP OF any existing Reimbursements value
															for each  m in matchedMonths
															{
																currentMonthNo = m.Month1;
																// If we've already applied this reimbursement to this Month1, skip any second application
																if(monthApplied.contains(currentMonthNo))
																{
																	// Skip this second (or later) application for this Month1
																	continue;
																}
																existingVal = ifnull(m.Reimbursements,0.0);
																m.Reimbursements=existingVal + perMonthAmount;
																// Mark this Month1 as having been updated for this reimbursement
																monthApplied.add(currentMonthNo);
															}
														}
													}
												}
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//REIMBURSED FEES (IMPACT FEES) SPREAD EVENLY OVER ANY MONTH WITH LOT SALES
										if(input.Budget.Pro_Forma != null)
										{
											impFees = Budget_Item[Budget == input.Budget && Category = "Reimbursements" && Item_Name.contains("Impact Fees")].sum(Add_l_Cost);
											for each  pfMonth in Proforma_Months[Proforma == input.Budget.Pro_Forma && Lot_Sale_Phase != null && Lots_Sold > 0]
											{
												pfMonth.Reimbursed_Fees=impFees / input.Budget.Pro_Forma.Lots * pfMonth.Lots_Sold;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//FILL OUT CASH FLOW
										if(input.Budget.Pro_Forma != null)
										{
											for each  mnth in Proforma_Months[Proforma == input.Budget.Pro_Forma]
											{
												mnth.Cash_Flow=ifNull(mnth.Finished_Lot_Sales,0) - ifNull(mnth.Land_Cost,0) + ifNull(mnth.Land_Sale,0) - ifNull(mnth.Construction_Cost_Base,0) - ifNull(mnth.Construction_Cost_Addl,0) - ifNull(mnth.Entitlement_Engineering,0) - ifNull(mnth.Entitlement_Engineering_Addl,0) + ifNull(mnth.Reimbursements,0) + ifNull(mnth.Reimbursed_Fees,0);
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//FILL OUT RUNNING CASH FLOW
										if(input.Budget.Pro_Forma != null)
										{
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma].Month1.getAll();
											unqMonths = mnths.distinct().size();
											loop = thisapp.forLoop(1,unqMonths);
											monthNo = 1;
											for each  el in loop
											{
												prevMnth = monthNo - 1;
												if(monthNo == 1)
												{
													loopMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo];
													loopMonth.Running_Cash_Flow=loopMonth.Cash_Flow;
												}
												if(monthNo != 1)
												{
													loopMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo];
													loopMonthcashflow = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo].sum(Cash_Flow);
													prevMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == prevMnth].sum(Running_Cash_Flow);
													loopMonth.Running_Cash_Flow=prevMonth + loopMonthcashflow;
												}
												monthNo = monthNo + 1;
											}
											info "Running cash flow finished";
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											pf = Add_Pro_Forma[ID = input.Budget.Pro_Forma];
											//TOTALS
											constCost = Proforma_Months[Proforma == pf].sum(Construction_Cost_Base);
											constCostaddl = Proforma_Months[Proforma == pf].sum(Construction_Cost_Addl);
											engCost = Proforma_Months[Proforma == pf].sum(Entitlement_Engineering);
											engCostaddl = Proforma_Months[Proforma == pf].sum(Entitlement_Engineering_Addl);
											reimbursements = Proforma_Months[Proforma == pf].sum(Reimbursements);
											cashFlow = Proforma_Months[Proforma == pf].sum(Cash_Flow);
											reimbFees = Proforma_Months[Proforma == pf].sum(Reimbursed_Fees);
											pf.Gross_Sales=pf.Sale_Price_FF * pf.Lots * pf.Lot_Size_Ft;
											//input.Construction_Cost_Base = constCost;
											pf.Construction_Cost_Addl=constCostaddl;
											//input.Entitlement_Cost = engCost;
											pf.Entitlement_Engineering_Addl=engCostaddl;
											pf.Total_Expenses=pf.Construction_Cost_Base + pf.Construction_Cost_Addl + pf.Entitlement_Cost + pf.Entitlement_Engineering_Addl + pf.Land_Cost;
											pf.Reimbursements=reimbursements;
											pf.Reimbursed_Fees=reimbFees;
											//input.Net_Profit = cashFlow;
											pf.Total_Income=ifNull(pf.Gross_Sales,0) + ifNull(pf.MUD_Revenue,0) + ifNull(pf.Reimbursements,0) + ifNull(pf.Reimbursed_Fees,0) + ifNull(pf.Land_Sale,0);
											pf.Net_Profit=pf.Total_Income - pf.Total_Expenses;
										}
						)
					}
				}

			}
			Schedule_Validation_Profo1 as "Schedule Validation - Proforma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Engineering_Length_Months
				{
					actions 
					{
						custom deluge script
						(
											// Calculate Construction_Start_Month from delays and lengths
										if(input.Engineering_Delay_Months != null && input.Engineering_Length_Months != null && input.Construction_Delay_Months != null)
										{
											input.Construction_Start_Month = input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months;
										}
										// Calculate Takedown_Start_Month from construction timing
										if(input.Construction_Start_Month != null && input.Construction_Length.toNumber() != null)
										{
											input.Takedown_Start_Month = input.Construction_Start_Month + input.Construction_Length.toNumber() + 1;
										}
										// Validate Estimated_Purchase_Date falls on the 1st of the month
										if(input.Estimated_Purchase_Date != null)
										{
											if(day(input.Estimated_Purchase_Date) != 1)
											{
												alert "Estimated Purchase Date must be the 1st of the month.";
											}
										}
										// Calculate Estimated_Lot_Sale_Start from purchase date and takedown start month
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null)
										{
											input.Estimated_Lot_Sale_Start = addMonth(input.Estimated_Purchase_Date,input.Takedown_Start_Month - 1);
										}
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null && input.Engineering_Length_Months != null && input.Construction_Length != null && input.Engineering_Delay_Months != null && input.Construction_Delay_Months != null && input.Initial_Takedown != null && input.Lots_per_Month != null && input.Lots != null && input.Phases != null)
										{
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(input.Takedown_Start_Month + ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + if(input.Phases > 2,(input.Phases - 2) * ceil((input.Lots / input.Phases) / input.Lots_per_Month),0) + IF(input.Phases > 1,ceil((input.Lots - (input.Phases - 1) * ceil(input.Lots / input.Phases)) / input.Lots_per_Month),0) - 1);
										}
										if(Estimated_Purchase_Date != NULL && Engineering_Delay_Months != NULL && Engineering_Length_Months != NULL && Construction_Delay_Months != NULL)
										{
											input.Engineering_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months);
											input.Construction_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months);
										}
						)
					}
				}

			}
			Schedule_Validation_Profo2 as "Schedule Validation - Proforma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Construction_Length
				{
					actions 
					{
						custom deluge script
						(
											// Calculate Construction_Start_Month from delays and lengths
										if(input.Engineering_Delay_Months != null && input.Engineering_Length_Months != null && input.Construction_Delay_Months != null)
										{
											input.Construction_Start_Month = input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months;
										}
										// Calculate Takedown_Start_Month from construction timing
										if(input.Construction_Start_Month != null && input.Construction_Length.toNumber() != null)
										{
											input.Takedown_Start_Month = input.Construction_Start_Month + input.Construction_Length.toNumber() + 1;
										}
										// Validate Estimated_Purchase_Date falls on the 1st of the month
										if(input.Estimated_Purchase_Date != null)
										{
											if(day(input.Estimated_Purchase_Date) != 1)
											{
												alert "Estimated Purchase Date must be the 1st of the month.";
											}
										}
										// Calculate Estimated_Lot_Sale_Start from purchase date and takedown start month
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null)
										{
											input.Estimated_Lot_Sale_Start = addMonth(input.Estimated_Purchase_Date,input.Takedown_Start_Month - 1);
										}
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null && input.Engineering_Length_Months != null && input.Construction_Length != null && input.Engineering_Delay_Months != null && input.Construction_Delay_Months != null && input.Initial_Takedown != null && input.Lots_per_Month != null && input.Lots != null && input.Phases != null)
										{
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(input.Takedown_Start_Month + ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + if(input.Phases > 2,(input.Phases - 2) * ceil((input.Lots / input.Phases) / input.Lots_per_Month),0) + IF(input.Phases > 1,ceil((input.Lots - (input.Phases - 1) * ceil(input.Lots / input.Phases)) / input.Lots_per_Month),0) - 1);
										}
										if(Estimated_Purchase_Date != NULL && Engineering_Delay_Months != NULL && Engineering_Length_Months != NULL && Construction_Delay_Months != NULL)
										{
											input.Engineering_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months);
											input.Construction_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months);
										}
						)
					}
				}

			}
			Schedule_Validation_Profo3 as "Schedule Validation - Proforma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Engineering_Delay_Months
				{
					actions 
					{
						custom deluge script
						(
											// Calculate Construction_Start_Month from delays and lengths
										if(input.Engineering_Delay_Months != null && input.Engineering_Length_Months != null && input.Construction_Delay_Months != null)
										{
											input.Construction_Start_Month = input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months;
										}
										// Calculate Takedown_Start_Month from construction timing
										if(input.Construction_Start_Month != null && input.Construction_Length.toNumber() != null)
										{
											input.Takedown_Start_Month = input.Construction_Start_Month + input.Construction_Length.toNumber() + 1;
										}
										// Validate Estimated_Purchase_Date falls on the 1st of the month
										if(input.Estimated_Purchase_Date != null)
										{
											if(day(input.Estimated_Purchase_Date) != 1)
											{
												alert "Estimated Purchase Date must be the 1st of the month.";
											}
										}
										// Calculate Estimated_Lot_Sale_Start from purchase date and takedown start month
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null)
										{
											input.Estimated_Lot_Sale_Start = addMonth(input.Estimated_Purchase_Date,input.Takedown_Start_Month - 1);
										}
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null && input.Engineering_Length_Months != null && input.Construction_Length != null && input.Engineering_Delay_Months != null && input.Construction_Delay_Months != null && input.Initial_Takedown != null && input.Lots_per_Month != null && input.Lots != null && input.Phases != null)
										{
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(input.Takedown_Start_Month + ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + if(input.Phases > 2,(input.Phases - 2) * ceil((input.Lots / input.Phases) / input.Lots_per_Month),0) + IF(input.Phases > 1,ceil((input.Lots - (input.Phases - 1) * ceil(input.Lots / input.Phases)) / input.Lots_per_Month),0) - 1);
										}
										if(Estimated_Purchase_Date != NULL && Engineering_Delay_Months != NULL && Engineering_Length_Months != NULL && Construction_Delay_Months != NULL)
										{
											input.Engineering_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months);
											input.Construction_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months);
										}
						)
					}
				}

			}
			Schedule_Validation_Profo4 as "Schedule Validation - Proforma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Construction_Delay_Months
				{
					actions 
					{
						custom deluge script
						(
											// Calculate Construction_Start_Month from delays and lengths
										if(input.Engineering_Delay_Months != null && input.Engineering_Length_Months != null && input.Construction_Delay_Months != null)
										{
											input.Construction_Start_Month = input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months;
										}
										// Calculate Takedown_Start_Month from construction timing
										if(input.Construction_Start_Month != null && input.Construction_Length.toNumber() != null)
										{
											input.Takedown_Start_Month = input.Construction_Start_Month + input.Construction_Length.toNumber() + 1;
										}
										// Validate Estimated_Purchase_Date falls on the 1st of the month
										if(input.Estimated_Purchase_Date != null)
										{
											if(day(input.Estimated_Purchase_Date) != 1)
											{
												alert "Estimated Purchase Date must be the 1st of the month.";
											}
										}
										// Calculate Estimated_Lot_Sale_Start from purchase date and takedown start month
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null)
										{
											input.Estimated_Lot_Sale_Start = addMonth(input.Estimated_Purchase_Date,input.Takedown_Start_Month - 1);
										}
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null && input.Engineering_Length_Months != null && input.Construction_Length != null && input.Engineering_Delay_Months != null && input.Construction_Delay_Months != null && input.Initial_Takedown != null && input.Lots_per_Month != null && input.Lots != null && input.Phases != null)
										{
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(input.Takedown_Start_Month + ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + if(input.Phases > 2,(input.Phases - 2) * ceil((input.Lots / input.Phases) / input.Lots_per_Month),0) + IF(input.Phases > 1,ceil((input.Lots - (input.Phases - 1) * ceil(input.Lots / input.Phases)) / input.Lots_per_Month),0) - 1);
										}
										if(Estimated_Purchase_Date != NULL && Engineering_Delay_Months != NULL && Engineering_Length_Months != NULL && Construction_Delay_Months != NULL)
										{
											input.Engineering_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months);
											input.Construction_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months);
										}
						)
					}
				}

			}
			Form_Logic_Checks_Pro_For as "Form Logic Checks - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Purchase_Installments == null || Purchase_Installments == 0)
										{
											alert "Please complete Land Purchase section.";
											cancel submit;
										}
										pct = 0;
										for each  curve in input.Construction_Curve
										{
											pct = pct + curve.Percent_Cost;
										}
										if(pct != 100)
										{
											alert "Construction Cost Curve does not reach 100%.";
											cancel submit;
										}
										installmentTotal = 0;
										for each  inst in input.Land_Purchase_Installments
										{
											installmentTotal = installmentTotal + inst.Cost;
										}
										if(installmentTotal != input.Land_Cost)
										{
											alert "Land Installment total does not match Land Cost.";
											cancel submit;
										}
										/* ===== NEW: Land Sale + Sale Installments must be BOTH filled or BOTH blank ===== */
										landSaleEmpty = input.Land_Sale == null || input.Land_Sale == 0;
										saleInstEmpty = input.Sale_Installments == null || input.Sale_Installments == 0;
										if((landSaleEmpty && !saleInstEmpty) || (!landSaleEmpty && saleInstEmpty))
										{
											alert "Please complete both Land Sale and Sale Installments (or leave both blank).";
											cancel submit;
										}
										/* ===== EXISTING: only validate totals when both are filled ===== */
										if(!landSaleEmpty && !saleInstEmpty)
										{
											saleinstallmentTotal = 0;
											for each  inst in input.Land_Sale_Installments
											{
												saleinstallmentTotal = saleinstallmentTotal + inst.Cost;
											}
											if(saleinstallmentTotal != input.Land_Sale)
											{
												alert "Land Sale Installment total does not match Land Sale.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			RUN_EVERYTHING_ON_SUCCESS as "RUN EVERYTHING ON SUCCESS"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Phase-level lot-sales schedule (opt-in; legacy branch below is unchanged).
										if(ifnull(input.Lot_Sales_Schedule_Version,0).toLong() == 2)
										{
											phaseCount = ifnull(input.Phases,0).toLong();
											phaseRows = Proforma_Phase[Pro_Forma == input.ID] sort by Phase;
											if(phaseCount < 1 || phaseRows.count() != phaseCount)
											{
												throw "Phase schedule needs exactly one row per active phase.";
											}
											engDelay = ifnull(input.Engineering_Delay_Months,0).toLong();
											engLength = ifnull(input.Engineering_Length_Months,0).toLong();
											constDelay = ifnull(input.Construction_Delay_Months,0).toLong();
											constLength = ifnull(input.Construction_Length,0).toLong();
											if(engDelay < 0 || constDelay < 0 || engLength < 1 || constLength < 1 || ifnull(input.Lots,0) < 1)
											{
												throw "Project lots, engineering, and construction inputs are invalid.";
											}
											phaseNo = 1;
											allocated = 0;
											previousFinal = 0;
											for each  ph in phaseRows
											{
												lots = ifnull(ph.Total_Lots,0).toLong();
												initial = ifnull(ph.Initial_Take_Lots,0).toLong();
												delay = ifnull(ph.Initial_Delay_Months,0).toLong();
												remaining = lots - initial;
												firstDelay = ifnull(ph.First_Recurring_Delay_Months,0).toLong();
												perTake = ifnull(ph.Lots_Per_Take,0).toLong();
												frequency = ifnull(ph.Take_Frequency,"").toString();
												step = 1;
												if(frequency == "Quarterly")
												{
													step = 3;
												}
												else if(frequency != "Monthly")
												{
													throw "Phase " + phaseNo + " needs a Monthly or Quarterly frequency.";
												}
												if(ifnull(ph.Phase,0).toLong() != phaseNo || lots < 1 || initial < 1 || initial > lots || delay < 0)
												{
													throw "Phase " + phaseNo + " has invalid lot allocation, initial take, or delay.";
												}
												if(remaining > 0)
												{
													if(firstDelay < 1 || perTake < 1)
													{
														throw "Phase " + phaseNo + " needs a positive recurring delay and lots per take.";
													}
												}
												rate = ifnull(ph.Annual_Escalator_Pct,0).toDecimal();
												if(rate < 0)
												{
													throw "Phase " + phaseNo + " annual escalator cannot be negative.";
												}
												if(ifnull(ph.Escalator_Enabled,false) == true && rate > 0 && ph.Esc_Start_Date == null)
												{
													throw "Phase " + phaseNo + " needs an escalator start date.";
												}
												if(phaseNo == 1)
												{
													engStart = engDelay + 1;
													engEnd = engStart + engLength - 1;
													constStart = engEnd + constDelay + 1;
													constEnd = constStart + constLength - 1;
												}
												else
												{
													constEnd = previousFinal;
													constStart = constEnd - constLength + 1;
													engEnd = constStart - constDelay - 1;
													engStart = engEnd - engLength + 1;
													if(engStart < 1)
													{
														throw "Phase " + phaseNo + " engineering would start before project month 1.";
													}
												}
												saleStart = constEnd + 1 + delay;
												saleEnd = saleStart;
												if(remaining > 0)
												{
													recurringCount = ceil(remaining / perTake);
													saleEnd = saleStart + firstDelay + (recurringCount - 1) * step;
												}
												if(saleEnd > 600)
												{
													throw "Phase " + phaseNo + " ends after the 600-month limit.";
												}
												ph.Acres=input.Total_Acres * lots / input.Lots;
												ph.Eng_Start_Month=engStart;
												ph.Eng_End_Month=engEnd;
												ph.Const_Start_Month=constStart;
												ph.Const_End_Month=constEnd;
												ph.Lot_Sale_Start_Month=saleStart;
												ph.Lot_Closing_Length=saleEnd - saleStart + 1;
												ph.Lot_Sale_End_Month=saleEnd;
												previousFinal = saleEnd;
												allocated = allocated + lots;
												phaseNo = phaseNo + 1;
											}
											if(allocated != input.Lots)
											{
												throw "Phase allocations must equal project lots; allocated " + allocated + " of " + input.Lots + ".";
											}
										}
										else
										{
											// ===== EXISTING LOGIC =====
											delete from Proforma_Phase[Pro_Forma == input.ID];
											// X = input.Phases
											iterationCount = ifnull(input.Phases,0);
											lotStart = input.Takedown_Start_Month;
											lotsRemaining = input.Lots;
											if(iterationCount <= 0)
											{
												return;
											}
											// OPTIONAL: clear existing Phase records for this Pro Forma (uncomment if desired)
											// existingPhases = Proforma_Phase[Pro_Forma == input.ID];
											// for each  ph in existingPhases
											// {
											// 	ph.delete();
											// }
											// Build a list with X dummy elements using your pattern
											iterationString = "".leftPad(iterationCount);
											iterationString = iterationString.replaceAll(" ",",");
											iterationString = iterationString.subString(0,iterationString.length() - 1);
											listPads = iterationString.toList();
											// Iterate X times, incrementing Phase each time
											phaseNo = 1;
											for each  phz in thisapp.forLoop(1,iterationCount)
											{
												lotsperPhase = ceil(input.Lots / input.Phases);
												engStart = null;
												engEnd = null;
												constStart = null;
												constEnd = null;
												lotclosingLength = 0;
												totalLotsPhase = 0;
												if(phaseNo == 1)
												{
													engStart = input.Engineering_Delay_Months + 1;
													engEnd = input.Engineering_Delay_Months + input.Engineering_Length_Months;
													constStart = input.Construction_Start_Month + 1;
													constEnd = input.Construction_Start_Month + input.Construction_Length.toNumber();
													lotclosingLength = ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + 1;
												}
												if(phaseNo != 1)
												{
													constStart = lotStart - input.Construction_Length.toNumber();
													constEnd = lotStart - 1;
													engStart = lotStart - input.Construction_Length.toNumber() - input.Construction_Start_Month + input.Engineering_Delay_Months;
													engEnd = lotStart - input.Construction_Length.toNumber() - input.Construction_Start_Month + input.Engineering_Delay_Months + input.Engineering_Length_Months - 1;
													lotclosingLength = ceil((input.Lots / input.Phases) / input.Lots_per_Month);
												}
												//Final Phase check -- double check that its not 1 phase project
												if(phaseNo == input.Phases && input.Phases != 1)
												{
													totalLotsPhase = lotsRemaining;
													lotclosingLength = ceil(lotsRemaining / input.Lots_per_Month);
												}
												else
												{
													totalLotsPhase = lotsperPhase;
												}
												lotSaleStart = lotStart;
												lotSaleEnd = lotStart + lotclosingLength - 1;
												// Create a Phase record instead of a subform row
												newPhase = insert into Proforma_Phase
												[
													Pro_Forma=input.ID
													Phase=phaseNo
													Acres=input.Total_Acres / input.Phases
													Eng_Start_Month=engStart
													Eng_End_Month=engEnd
													Const_Start_Month=constStart
													Const_End_Month=constEnd
													Total_Lots=totalLotsPhase
													Lot_Sale_Start_Month=lotSaleStart
													Lot_Closing_Length=lotclosingLength
													Lot_Sale_End_Month=lotSaleEnd
													Added_User=zoho.loginuser
												];
												lotStart = lotStart + lotclosingLength;
												phaseNo = phaseNo + 1;
												lotsRemaining = lotsRemaining - lotsperPhase;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											// Version 2 builds one row per active construction/engineering phase.
										// It preserves one master per project month; version 1 below is unchanged.
										if(ifnull(input.Lot_Sales_Schedule_Version,0).toLong() == 2)
										{
											phaseRows = Proforma_Phase[Pro_Forma == input.ID] sort by Phase;
											firstPhase = Proforma_Phase[Pro_Forma == input.ID && Phase == 1];
											lastPhase = Proforma_Phase[Pro_Forma == input.ID && Phase == input.Phases];
											if(firstPhase == null || lastPhase == null || input.Estimated_Purchase_Date == null)
											{
												throw "Phase schedule or estimated purchase date is missing.";
											}
											endMo = ifnull(lastPhase.Lot_Sale_End_Month,0).toLong();
											maxInstallment = Land_Installments[Pro_Forma == input.ID || Pro_Forma2 == input.ID || Pro_Forma_PID_MUD == input.ID].maximum(Month1);
											if(maxInstallment != null && maxInstallment > endMo)
											{
												endMo = maxInstallment;
											}
											for each  costItem in Proforma_Item[Pro_Forma_Const == input.ID || Pro_Forma_Dev == input.ID]
											{
												specificText = ifnull(costItem.Specific_Months_List,"");
												specificTokens = specificText.toList(",");
												for each  token in specificTokens
												{
													value = token.trim();
													if(value.isNumber() && value.toLong() > endMo)
													{
														endMo = value.toLong();
													}
												}
												if(ifnull(costItem.Start_Month,0) > endMo)
												{
													endMo = costItem.Start_Month;
												}
												if(ifnull(costItem.End_Month,0) > endMo)
												{
													endMo = costItem.End_Month;
												}
											}
											for each  ph in phaseRows
											{
												if(ph.Eng_End_Month > endMo)
												{
													endMo = ph.Eng_End_Month;
												}
												if(ph.Const_End_Month > endMo)
												{
													endMo = ph.Const_End_Month;
												}
											}
											if(endMo < 1 || endMo > 600)
											{
												throw "The phase schedule must end within project months 1 through 600.";
											}
											delete from Proforma_Months[Proforma == input.ID];
											input.Takedown_Start_Month = firstPhase.Lot_Sale_Start_Month;
											input.Estimated_Lot_Sale_Start = input.Estimated_Purchase_Date.addMonth(firstPhase.Lot_Sale_Start_Month - 1);
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(endMo - 1);
											monthNo = 1;
											for each  dummy in thisapp.forLoop(1,endMo)
											{
												rowDate = input.Estimated_Purchase_Date.addMonth(monthNo - 1);
												activeCount = 0;
												for each  ph in phaseRows
												{
													constPhase = null;
													engPhase = null;
													if(ph.Const_Start_Month <= monthNo && ph.Const_End_Month >= monthNo)
													{
														constPhase = ph.Phase;
													}
													if(ph.Eng_Start_Month <= monthNo && ph.Eng_End_Month >= monthNo)
													{
														engPhase = ph.Phase;
													}
													if(constPhase != null || engPhase != null)
													{
														isMaster = false;
														if(activeCount == 0)
														{
															isMaster = true;
														}
														insert into Proforma_Months
														[
															Proforma=input.ID
															Date1=rowDate
															Month1=monthNo
															Const_Phase=constPhase
															Eng_Phase=engPhase
															Master_Month=isMaster
															Added_User=zoho.loginuser
														]
														activeCount = activeCount + 1;
													}
												}
												if(activeCount == 0)
												{
													insert into Proforma_Months
													[
														Proforma=input.ID
														Date1=rowDate
														Month1=monthNo
														Master_Month=true
														Added_User=zoho.loginuser
													]
												}
												monthNo = monthNo + 1;
											}
										}
										else
										{
											//CREATE MONTHS
											// OPTIONAL: clear existing Proforma_Months for this Pro Forma 
											delete from Proforma_Months[Proforma == input.ID];
											// How many months we're generating: use the last phase's Lot_Sale_End_Month
											endMo = 0;
											lastPhase = Proforma_Phase[Pro_Forma == input.ID && Phase == input.Phases];
											mudpidInstall = Land_Installments[Pro_Forma_PID_MUD == input.ID].maximum(Month1);
											if(lastPhase != null)
											{
												endMo = lastPhase.Lot_Sale_End_Month;
											}
											if(mudpidInstall > endMo)
											{
												endMo = mudpidInstall;
											}
											if(endMo == null || endMo <= 0)
											{
												return;
											}
											// Your helper that returns [1,2,3,...,endMo]
											listPads2 = thisapp.forLoop(1,endMo);
											info listPads2.size();
											// We'll walk monthNo manually
											monthNo = 1;
											for each  dummy in listPads2
											{
												rowDate = input.Estimated_Purchase_Date.addMonth(monthNo - 1);
												// --- MATCHES FOR THIS MONTH ---
												constMatches = Proforma_Phase[Pro_Forma == input.ID && Const_Start_Month <= monthNo && Const_End_Month >= monthNo];
												engMatches = Proforma_Phase[Pro_Forma == input.ID && Eng_Start_Month <= monthNo && Eng_End_Month >= monthNo];
												// Grab up to 2 Const phases for this month
												constPhase1 = null;
												constPhase2 = null;
												cIndex = 0;
												for each  cRec in constMatches
												{
													if(cIndex == 0)
													{
														constPhase1 = cRec.Phase;
													}
													else if(cIndex == 1)
													{
														constPhase2 = cRec.Phase;
													}
													cIndex = cIndex + 1;
													if(cIndex >= 2)
													{
														break;
													}
												}
												// Grab up to 2 Eng phases for this month
												engPhase1 = null;
												engPhase2 = null;
												eIndex = 0;
												for each  eRec in engMatches
												{
													if(eIndex == 0)
													{
														engPhase1 = eRec.Phase;
													}
													else if(eIndex == 1)
													{
														engPhase2 = eRec.Phase;
													}
													eIndex = eIndex + 1;
													if(eIndex >= 2)
													{
														break;
													}
												}
												// --- ROW INSERT LOGIC ---
												if(constPhase1 == null && engPhase1 == null)
												{
													// No Const or Eng this month -> single blank row
													insert into Proforma_Months
													[
														Proforma=input.ID
														Date1=rowDate
														Month1=monthNo
														Master_Month=TRUE
														Added_User=zoho.loginuser
													]
												}
												else
												{
													// ROW 1: pair first Const + first Eng (can be null, that's fine)
													insert into Proforma_Months
													[
														Proforma=input.ID
														Date1=rowDate
														Month1=monthNo
														Const_Phase=constPhase1
														Eng_Phase=engPhase1
														Master_Month=TRUE
														Added_User=zoho.loginuser
													]
													// ROW 2: only if there is a 2nd Const or Eng phase
													if(constPhase2 != null || engPhase2 != null)
													{
														insert into Proforma_Months
														[
															Proforma=input.ID
															Date1=rowDate
															Month1=monthNo
															Const_Phase=constPhase2
															Eng_Phase=engPhase2
															Master_Month=FALSE
															Added_User=zoho.loginuser
														]
													}
												}
												// Next month
												monthNo = monthNo + 1;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											// Phase-level event receipts; legacy pace logic remains below for version 1.
										if(ifnull(input.Lot_Sales_Schedule_Version,0).toLong() == 2)
										{
											totalSold = 0;
											phaseRows = Proforma_Phase[Pro_Forma == input.ID] sort by Phase;
											for each  ph in phaseRows
											{
												lots = ifnull(ph.Total_Lots,0).toLong();
												initial = ifnull(ph.Initial_Take_Lots,0).toLong();
												remaining = lots - initial;
												firstDelay = ifnull(ph.First_Recurring_Delay_Months,0).toLong();
												perTake = ifnull(ph.Lots_Per_Take,0).toLong();
												step = 1;
												if(ph.Take_Frequency == "Quarterly")
												{
													step = 3;
												}
												takeCount = 1;
												if(remaining > 0)
												{
													takeCount = takeCount + ceil(remaining / perTake);
												}
												takeNo = 1;
												lastSaleMonth = 0;
												for each  take in thisapp.forLoop(1,takeCount)
												{
													sold = initial;
													saleMonth = ph.Lot_Sale_Start_Month;
													if(takeNo > 1)
													{
														sold = perTake;
														if(remaining < sold)
														{
															sold = remaining;
														}
														saleMonth = ph.Lot_Sale_Start_Month + firstDelay + (takeNo - 2) * step;
														remaining = remaining - sold;
													}
													monthRow = Proforma_Months[Proforma == input.ID && Month1 == saleMonth && Master_Month == true];
													if(monthRow == null)
													{
														throw "Missing master month for phase " + ph.Phase + " sale month " + saleMonth + ".";
													}
													basis = sold * input.Sale_Price_FF * input.Lot_Size_Ft;
													baseIncome = basis.round(0);
													markupPct = ifnull(ph.Additional_Markup_Pct,0).toDecimal();
													markupIncome = (basis * markupPct / 100).round(0);
													annualPct = ifnull(ph.Annual_Escalator_Pct,0).toDecimal();
													enabled = ifnull(ph.Escalator_Enabled,false);
													elapsed = 0;
													if(enabled == true && annualPct > 0)
													{
														saleDate = input.Estimated_Purchase_Date.addMonth(saleMonth - 1);
														elapsed = (saleDate.getYear() - ph.Esc_Start_Date.getYear()) * 12 + saleDate.getMonth() - ph.Esc_Start_Date.getMonth();
														if(elapsed < 0)
														{
															elapsed = 0;
														}
													}
													escalatorIncome = (basis * annualPct * elapsed / 1200).round(0);
													monthRow.Lot_Sale_Phase=ph.Phase;
													monthRow.Lots_Sold=sold;
													monthRow.Base_Lot_Sales=baseIncome;
													monthRow.Additional_Markup_Income=markupIncome;
													monthRow.Escalator_Interest_Accrued=escalatorIncome;
													monthRow.Escalator_Percentage=if(enabled == true,annualPct,0);
													monthRow.Escalator_Elapsed_Months=elapsed;
													monthRow.Escalator_Applied_Pct=if(enabled == true,annualPct * elapsed / 12,0);
													monthRow.Finished_Lot_Sales=baseIncome + markupIncome + escalatorIncome;
													totalSold = totalSold + sold;
													lastSaleMonth = saleMonth;
													takeNo = takeNo + 1;
												}
												if(remaining != 0 || lastSaleMonth != ph.Lot_Sale_End_Month)
												{
													throw "Phase " + ph.Phase + " event totals disagree with its schedule.";
												}
											}
											if(totalSold != input.Lots)
											{
												throw "The event schedule sells " + totalSold + " lots, but the project has " + input.Lots + ".";
											}
										}
										else
										{
											// FILL LOT SALES
											lotsRemaining = 0;
											maxMonth = 0;
											// --- 2) Build unique Month1 list and loop over month numbers (not rows) ---
											mnthsList = Proforma_Months[Proforma == input.ID].Month1.getAll();
											unqMonths = mnthsList.distinct().size();
											loop = thisapp.forLoop(1,unqMonths);
											// This will walk monthNo = 1..unqMonths and ONLY touch the first row for each month
											monthNo = 1;
											for each  el in loop
											{
												// Only use the FIRST Proforma_Months record for this monthNo
												mnth = Proforma_Months[Proforma == input.ID && Month1 == monthNo];
												if(mnth != null)
												{
													// Sale phase that covers this month
													lotPhase = Proforma_Phase[Pro_Forma == input.ID && Lot_Sale_Start_Month <= monthNo && Lot_Sale_End_Month >= monthNo];
													if(lotPhase != null)
													{
														mnth.Lot_Sale_Phase=lotPhase.Phase;
														// ---- first month of phase 1: apply initial takedown ----
														if(lotPhase.Phase == 1 && monthNo == lotPhase.Lot_Sale_Start_Month)
														{
															phaseLots = ifNull(lotPhase.Total_Lots,0);
															lotsRemaining = phaseLots - ifNull(input.Initial_Takedown,0);
															mnth.Lots_Sold=input.Initial_Takedown;
														}
														// ---- first month of non-phase 1: initialize remaining lots ----
														if(lotPhase.Phase != 1 && monthNo == lotPhase.Lot_Sale_Start_Month)
														{
															phaseLots = ifNull(lotPhase.Total_Lots,0);
															lotsRemaining = phaseLots;
														}
														// ---- middle months: full Lots_per_Month (phase 1) ----
														if(monthNo > lotPhase.Lot_Sale_Start_Month && monthNo < lotPhase.Lot_Sale_End_Month && lotsRemaining > input.Lots_per_Month && lotPhase.Phase == 1)
														{
															mnth.Lots_Sold=input.Lots_per_Month;
															lotsRemaining = lotsRemaining - input.Lots_per_Month;
														}
														// ---- middle months: full Lots_per_Month (other phases) ----
														if(monthNo >= lotPhase.Lot_Sale_Start_Month && monthNo < lotPhase.Lot_Sale_End_Month && lotsRemaining > input.Lots_per_Month && lotPhase.Phase != 1)
														{
															mnth.Lots_Sold=input.Lots_per_Month;
															lotsRemaining = lotsRemaining - input.Lots_per_Month;
														}
														// ---- last month of range: sell the remainder if <= Lots_per_Month ----
														if(monthNo > lotPhase.Lot_Sale_Start_Month && monthNo == lotPhase.Lot_Sale_End_Month && lotsRemaining <= input.Lots_per_Month)
														{
															mnth.Lots_Sold=lotsRemaining;
															lotsRemaining = 0;
														}
														// Finished Lot Sales only on this single "primary" row for the month
														finishedSaleamt = ifNull(mnth.Lots_Sold,0) * input.Sale_Price_FF * input.Lot_Size_Ft;
														if(finishedSaleamt > 0)
														{
															mnth.Finished_Lot_Sales=finishedSaleamt;
														}
													}
												}
												// Next project month number
												monthNo = monthNo + 1;
											}
											info "Lot Sales successful";
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											// ============================================================
										// FILL OUT ENG COST + OVERHEAD
										//
										// OPTIMIZED WITHOUT CHANGING EXISTING ALLOCATION BEHAVIOR
										//
										// Original behavior preserved for:
										// - Across Phases
										// - Engineering End
										// - Construction Start
										// - Construction End
										// - Specific Months
										// - Legacy Start_Month / End_Month fallback
										// - Master_Month-only Specific Months allocation
										// - Engineering-only additional cost used for Engineering Overhead
										// - Development additional cost excluded from Engineering Overhead
										// - Existing rounding behavior
										// - Existing base Engineering calculation behavior
										//
										// Optimization:
										// Instead of:
										//
										//     for each month
										//     {
										//         for each cost
										//         {
										//             evaluate everything
										//         }
										//     }
										//
										// We:
										// 1. Index month rows once.
										// 2. Process each cost once against only applicable rows.
										// 3. Accumulate results by Proforma_Months record ID.
										// 4. Write each month once.
										// ============================================================
										// getUrl("https://postman-echo.com/delay/12");
										startMo = 1;
										// ============================================================
										// LOAD ADDITIONAL COSTS
										// ============================================================
										addlCosts = Proforma_Item[(Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Engineering") || (Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Development") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Engineering") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Development")];
										// ============================================================
										// LOAD MONTH ROWS
										//
										// Preserve the exact same population as the existing code:
										//
										// - Engineering phase rows
										// - Construction phase rows
										// - Master month rows
										// ============================================================
										mnths = Proforma_Months[(Proforma == input.ID && Eng_Phase != null) || (Proforma == input.ID && Const_Phase != null) || (Proforma == input.ID && Master_Month == true)] sort by Date1;
										// This is the same record population used by the existing legacy
										// Specific Months fallback, but it is loaded ONCE instead of once
										// for every Specific Months cost item.
										legacyMnths = Proforma_Months[Proforma == input.ID && Master_Month == true];
										// ============================================================
										// PRELOAD PHASE INFORMATION
										//
										// This is intentionally the same information and same overwrite
										// behavior as the existing implementation.
										// ============================================================
										phaseEngEnd = Map();
										phaseEngLots = Map();
										phaseConstStart = Map();
										phaseConstEnd = Map();
										allPhases = Proforma_Phase[Pro_Forma == input.ID];
										for each  phz in allPhases
										{
											if(phz.Phase != null)
											{
												phaseKey = phz.Phase.toString();
												if(phz.Eng_End_Month != null)
												{
													phaseEngEnd.put(phaseKey,phz.Eng_End_Month.toLong());
												}
												if(phz.Total_Lots != null)
												{
													phaseEngLots.put(phaseKey,phz.Total_Lots);
												}
												if(phz.Const_Start_Month != null)
												{
													phaseConstStart.put(phaseKey,phz.Const_Start_Month.toLong());
												}
												if(phz.Const_End_Month != null)
												{
													phaseConstEnd.put(phaseKey,phz.Const_End_Month.toLong());
												}
											}
										}
										// ============================================================
										// BUILD MONTH INDEXES
										//
										// These maps let us locate only the month rows that a cost could
										// actually affect.
										//
										// engRowsByPhase:
										//     phase -> list of engineering month record IDs
										//
										// engRowsByPhaseMonth:
										//     phase + month -> engineering month record IDs
										//
										// constRowsByPhaseMonth:
										//     phase + month -> construction month record IDs
										//
										// masterRowsByMonth:
										//     month -> Master_Month record IDs
										//
										// engPhaseValues / constPhaseValues:
										//     actual phase values that occur on Proforma_Months records
										//
										// Using the actual Proforma_Months phase values preserves the
										// original behavior even if month data and Proforma_Phase data
										// are temporarily inconsistent.
										// ============================================================
										engRowsByPhase = Map();
										engRowsByPhaseMonth = Map();
										constRowsByPhaseMonth = Map();
										masterRowsByMonth = Map();
										engPhaseValues = List();
										constPhaseValues = List();
										for each  month in mnths
										{
											rowKey = month.ID.toString();
											engPhaseNo = month.Eng_Phase;
											constPhaseNo = month.Const_Phase;
											// --------------------------------------------------------
											// INDEX ENGINEERING ROWS
											// --------------------------------------------------------
											if(engPhaseNo != null)
											{
												engPhaseKey = engPhaseNo.toString();
												if(engPhaseValues.contains(engPhaseNo) == false)
												{
													engPhaseValues.add(engPhaseNo);
												}
												// All engineering rows belonging to this phase
												engPhaseRowIds = engRowsByPhase.get(engPhaseKey);
												if(engPhaseRowIds == null)
												{
													engPhaseRowIds = List();
												}
												engPhaseRowIds.add(rowKey);
												engRowsByPhase.put(engPhaseKey,engPhaseRowIds);
												// Exact engineering phase + month index
												if(month.Month1 != null)
												{
													monthNoText = month.Month1.toLong().toString();
													engPhaseMonthKey = engPhaseKey + "|" + monthNoText;
													engPhaseMonthRowIds = engRowsByPhaseMonth.get(engPhaseMonthKey);
													if(engPhaseMonthRowIds == null)
													{
														engPhaseMonthRowIds = List();
													}
													engPhaseMonthRowIds.add(rowKey);
													engRowsByPhaseMonth.put(engPhaseMonthKey,engPhaseMonthRowIds);
												}
											}
											// --------------------------------------------------------
											// INDEX CONSTRUCTION ROWS
											// --------------------------------------------------------
											if(constPhaseNo != null)
											{
												constPhaseKey = constPhaseNo.toString();
												if(constPhaseValues.contains(constPhaseNo) == false)
												{
													constPhaseValues.add(constPhaseNo);
												}
												if(month.Month1 != null)
												{
													monthNoText = month.Month1.toLong().toString();
													constPhaseMonthKey = constPhaseKey + "|" + monthNoText;
													constPhaseMonthRowIds = constRowsByPhaseMonth.get(constPhaseMonthKey);
													if(constPhaseMonthRowIds == null)
													{
														constPhaseMonthRowIds = List();
													}
													constPhaseMonthRowIds.add(rowKey);
													constRowsByPhaseMonth.put(constPhaseMonthKey,constPhaseMonthRowIds);
												}
											}
											// --------------------------------------------------------
											// INDEX MASTER MONTH ROWS
											//
											// Specific Months must ONLY apply to Master_Month records.
											// --------------------------------------------------------
											if(month.Master_Month == true)
											{
												if(month.Month1 != null)
												{
													masterMonthKey = month.Month1.toLong().toString();
													masterMonthRowIds = masterRowsByMonth.get(masterMonthKey);
													if(masterMonthRowIds == null)
													{
														masterMonthRowIds = List();
													}
													masterMonthRowIds.add(rowKey);
													masterRowsByMonth.put(masterMonthKey,masterMonthRowIds);
												}
											}
										}
										// ============================================================
										// RESULT MAPS
										//
										// addlByRow:
										//     All qualifying Engineering + Development additional cost
										//     that belongs on the Proforma_Months record.
										//
										// engOnlyAddlByRow:
										//     Only Engineering-department additional cost.
										//
										//     This is kept separately because existing behavior applies
										//     Engineering Overhead ONLY to Engineering-department
										//     additional cost.
										//
										// IMPORTANT:
										// Costs are processed in the same addlCosts iteration order as
										// the existing nested loop. Each target row's accumulator is
										// therefore updated in cost order.
										// ============================================================
										addlByRow = Map();
										engOnlyAddlByRow = Map();
										// ============================================================
										// PROCESS ADDITIONAL COSTS
										// ============================================================
										for each  cost in addlCosts
										{
											// ========================================================
											// ACROSS PHASES
											//
											// EXISTING BEHAVIOR:
											//
											// For every engineering month whose Eng_Phase falls inside
											// Start_Phase / End_Phase:
											//
											// Add_l_Cost
											// ----------------------------------------------
											// (# phases * Engineering_Length_Months)
											//
											// This section targets ONLY those engineering rows instead
											// of scanning every Proforma_Months row.
											// ========================================================
											if(cost.Cost_Application == "Across Phases")
											{
												for each  engPhaseValue in engPhaseValues
												{
													if(cost.Start_Phase <= engPhaseValue && cost.End_Phase >= engPhaseValue)
													{
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Engineering_Length_Months.toLong();
														acrossAmount = cost.Add_l_Cost / costSpread;
														engPhaseKey = engPhaseValue.toString();
														targetRowIds = engRowsByPhase.get(engPhaseKey);
														if(targetRowIds != null)
														{
															for each  targetRowId in targetRowIds
															{
																existingAddl = addlByRow.get(targetRowId);
																if(existingAddl == null)
																{
																	existingAddl = 0;
																}
																addlByRow.put(targetRowId,existingAddl + acrossAmount);
																if(cost.Department == "Engineering")
																{
																	existingEngOnly = engOnlyAddlByRow.get(targetRowId);
																	if(existingEngOnly == null)
																	{
																		existingEngOnly = 0;
																	}
																	engOnlyAddlByRow.put(targetRowId,existingEngOnly + acrossAmount);
																}
															}
														}
													}
												}
											}
											// ========================================================
											// ENGINEERING END
											//
											// EXISTING BEHAVIOR:
											//
											// Cost is divided evenly by number of selected phases and
											// applied once in each applicable phase's Eng_End_Month.
											// ========================================================
											if(cost.Cost_Application == "Engineering End")
											{
												for each  engPhaseValue in engPhaseValues
												{
													if(cost.Start_Phase <= engPhaseValue && cost.End_Phase >= engPhaseValue)
													{
														engPhaseKey = engPhaseValue.toString();
														engEndMo = phaseEngEnd.get(engPhaseKey);
														if(engEndMo != null)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															engPhaseMonthKey = engPhaseKey + "|" + engEndMo.toString();
															targetRowIds = engRowsByPhaseMonth.get(engPhaseMonthKey);
															if(targetRowIds != null)
															{
																for each  targetRowId in targetRowIds
																{
																	existingAddl = addlByRow.get(targetRowId);
																	if(existingAddl == null)
																	{
																		existingAddl = 0;
																	}
																	addlByRow.put(targetRowId,existingAddl + phaseCost);
																	if(cost.Department == "Engineering")
																	{
																		existingEngOnly = engOnlyAddlByRow.get(targetRowId);
																		if(existingEngOnly == null)
																		{
																			existingEngOnly = 0;
																		}
																		engOnlyAddlByRow.put(targetRowId,existingEngOnly + phaseCost);
																	}
																}
															}
														}
													}
												}
											}
											// ========================================================
											// CONSTRUCTION START
											//
											// EXISTING BEHAVIOR:
											//
											// Cost is divided evenly by number of selected phases and
											// applied once in each applicable phase's Const_Start_Month.
											//
											// IMPORTANT:
											// Engineering-department costs applied here still count
											// toward Engineering Overhead in the original code.
											// That behavior is preserved.
											// ========================================================
											if(cost.Cost_Application == "Construction Start")
											{
												for each  constPhaseValue in constPhaseValues
												{
													if(cost.Start_Phase <= constPhaseValue && cost.End_Phase >= constPhaseValue)
													{
														constPhaseKey = constPhaseValue.toString();
														constStartMo = phaseConstStart.get(constPhaseKey);
														if(constStartMo != null)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															constPhaseMonthKey = constPhaseKey + "|" + constStartMo.toString();
															targetRowIds = constRowsByPhaseMonth.get(constPhaseMonthKey);
															if(targetRowIds != null)
															{
																for each  targetRowId in targetRowIds
																{
																	existingAddl = addlByRow.get(targetRowId);
																	if(existingAddl == null)
																	{
																		existingAddl = 0;
																	}
																	addlByRow.put(targetRowId,existingAddl + phaseCost);
																	if(cost.Department == "Engineering")
																	{
																		existingEngOnly = engOnlyAddlByRow.get(targetRowId);
																		if(existingEngOnly == null)
																		{
																			existingEngOnly = 0;
																		}
																		engOnlyAddlByRow.put(targetRowId,existingEngOnly + phaseCost);
																	}
																}
															}
														}
													}
												}
											}
											// ========================================================
											// CONSTRUCTION END
											//
											// EXISTING BEHAVIOR:
											//
											// Cost is divided evenly by number of selected phases and
											// applied once in each applicable phase's Const_End_Month.
											// ========================================================
											if(cost.Cost_Application == "Construction End")
											{
												for each  constPhaseValue in constPhaseValues
												{
													if(cost.Start_Phase <= constPhaseValue && cost.End_Phase >= constPhaseValue)
													{
														constPhaseKey = constPhaseValue.toString();
														constEndMo = phaseConstEnd.get(constPhaseKey);
														if(constEndMo != null)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															constPhaseMonthKey = constPhaseKey + "|" + constEndMo.toString();
															targetRowIds = constRowsByPhaseMonth.get(constPhaseMonthKey);
															if(targetRowIds != null)
															{
																for each  targetRowId in targetRowIds
																{
																	existingAddl = addlByRow.get(targetRowId);
																	if(existingAddl == null)
																	{
																		existingAddl = 0;
																	}
																	addlByRow.put(targetRowId,existingAddl + phaseCost);
																	if(cost.Department == "Engineering")
																	{
																		existingEngOnly = engOnlyAddlByRow.get(targetRowId);
																		if(existingEngOnly == null)
																		{
																			existingEngOnly = 0;
																		}
																		engOnlyAddlByRow.put(targetRowId,existingEngOnly + phaseCost);
																	}
																}
															}
														}
													}
												}
											}
											// ========================================================
											// SPECIFIC MONTHS
											//
											// EXISTING BEHAVIOR PRESERVED EXACTLY:
											//
											// 1. Specific_Months_List is preferred.
											//
											// 2. If Specific_Months_List is NONBLANK, usedList becomes
											//    true immediately.
											//
											//    Even if the supplied list ultimately produces no valid
											//    selected months, the legacy Start_Month / End_Month
											//    fallback DOES NOT run.
											//
											// 3. Legacy Start_Month / End_Month is used ONLY when the
											//    raw Specific_Months_List is blank.
											//
											// 4. Selected months are de-duplicated.
											//
											// 5. Cost is divided by number of selected months.
											//
											// 6. Allocation is written ONLY to Master_Month rows.
											// ========================================================
											if(cost.Cost_Application == "Specific Months")
											{
												selMonths = List();
												raw = ifnull(cost.Specific_Months_List,"").toString().trim();
												usedList = false;
												// ----------------------------------------------------
												// CURRENT SPECIFIC MONTH LIST
												// ----------------------------------------------------
												if(raw != "")
												{
													usedList = true;
													for each  tok in raw.toList(",")
													{
														t = tok.trim();
														if(t != "")
														{
															n = t.toLong();
															if(n > 0)
															{
																monthText = n.toString();
																if(selMonths.contains(monthText) == false)
																{
																	selMonths.add(monthText);
																}
															}
														}
													}
												}
												// ----------------------------------------------------
												// LEGACY FALLBACK
												//
												// Preserve original "usedList == false" behavior.
												// ----------------------------------------------------
												if(usedList == false)
												{
													if(cost.Start_Month != null && cost.End_Month != null)
													{
														sm = cost.Start_Month.toLong();
														em = cost.End_Month.toLong();
														if(sm > 0 && em >= sm)
														{
															for each  lm in legacyMnths
															{
																if(lm.Month1 != null)
																{
																	lmNo = lm.Month1.toLong();
																	if(lmNo >= sm && lmNo <= em)
																	{
																		lmText = lmNo.toString();
																		if(selMonths.contains(lmText) == false)
																		{
																			selMonths.add(lmText);
																		}
																	}
																}
															}
														}
													}
												}
												// ----------------------------------------------------
												// ALLOCATE TO MASTER MONTH ROWS
												// ----------------------------------------------------
												if(selMonths.size() > 0)
												{
													denom = selMonths.size();
													specificMonthCost = cost.Add_l_Cost / denom;
													for each  selectedMonthText in selMonths
													{
														targetRowIds = masterRowsByMonth.get(selectedMonthText);
														if(targetRowIds != null)
														{
															for each  targetRowId in targetRowIds
															{
																existingAddl = addlByRow.get(targetRowId);
																if(existingAddl == null)
																{
																	existingAddl = 0;
																}
																addlByRow.put(targetRowId,existingAddl + specificMonthCost);
																if(cost.Department == "Engineering")
																{
																	existingEngOnly = engOnlyAddlByRow.get(targetRowId);
																	if(existingEngOnly == null)
																	{
																		existingEngOnly = 0;
																	}
																	engOnlyAddlByRow.put(targetRowId,existingEngOnly + specificMonthCost);
																}
															}
														}
													}
												}
											}
										}
										// ============================================================
										// WRITE MONTH VALUES
										//
										// ONE final loop through Proforma_Months.
										// There is no longer an inner loop through addlCosts.
										// ============================================================
										for each  month in mnths
										{
											rowKey = month.ID.toString();
											engPhaseNo = month.Eng_Phase;
											// --------------------------------------------------------
											// Retrieve already-calculated additional cost
											// --------------------------------------------------------
											addlCost = addlByRow.get(rowKey);
											if(addlCost == null)
											{
												addlCost = 0;
											}
											engonlyaddlCost = engOnlyAddlByRow.get(rowKey);
											if(engonlyaddlCost == null)
											{
												engonlyaddlCost = 0;
											}
											// --------------------------------------------------------
											// BASE ENGINEERING COST
											//
											// EXACT EXISTING BEHAVIOR:
											//
											// Only assign Entitlement_Engineering when:
											// - Eng_Phase is not null
											// - phaseEngLots has a non-null Total_Lots
											//
											// No extra null/zero guards have been added here because
											// doing so would alter existing behavior.
											// --------------------------------------------------------
											if(engPhaseNo != null)
											{
												engLots = phaseEngLots.get(engPhaseNo.toString());
												if(engLots != null)
												{
													month.Entitlement_Engineering=(input.Engineering_Cost_Lot * engLots / input.Engineering_Length_Months).round(2);
												}
											}
											// --------------------------------------------------------
											// ADDITIONAL ENGINEERING / DEVELOPMENT COST
											//
											// EXACT EXISTING BEHAVIOR:
											// Always write this field for every included month row,
											// including zero.
											// --------------------------------------------------------
											month.Entitlement_Engineering_Addl=addlCost.round(2);
											// ========================================================
											// ENGINEERING OVERHEAD
											//
											// EXACT EXISTING BEHAVIOR:
											//
											// Includes:
											// - Base engineering cost
											// - Engineering-department additional cost
											//
											// Does NOT include:
											// - Development-department additional cost
											//
											// Also preserves the existing behavior that the OH field
											// is only assigned when input.Engineering_Overhead != null.
											// ========================================================
											baseEngForOH = 0;
											if(ifnull(month.Entitlement_Engineering,0) != 0)
											{
												baseEngForOH = baseEngForOH + month.Entitlement_Engineering;
											}
											if(ifnull(engonlyaddlCost,0) != 0)
											{
												baseEngForOH = baseEngForOH + engonlyaddlCost;
											}
											if(input.Engineering_Overhead != null)
											{
												month.Engineering_Overhead=(baseEngForOH * ifnull(input.Engineering_Overhead,0) / 100).round(0);
											}
										}
										info "Eng cost successful";
						)
					}
					actions 
