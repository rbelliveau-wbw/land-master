                 				firstInitial = firstPdfPhase.Initial_Take_Lots.toLong();
                 				firstHasRecurring = firstPdfPhase.Total_Lots.toLong() > firstInitial;
                 				firstFrequency = firstPdfPhase.Take_Frequency.toString();
                 				frequencySuffix = if(firstFrequency == "Quarterly","/quarter","/month");
                 				allInitialSame = true;
                 				allRecurringSame = true;
                 				for each  pdfPhase in pdfPhases
