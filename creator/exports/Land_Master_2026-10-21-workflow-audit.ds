			Edit_Budget_Items as "Edit Budget Items"
			{
				type =  form
				form = Add_Budget

				record event = on edit

				on user input of Budget_Categories.Edit_Items
				{
					actions 
					{
						custom deluge script
						(
											row.Edit_Items=false;
										if(Budget_Type == "Development")
										{
											openURL("https://creatorapp.zohopublic.com/wbdevelopment/land-master/Budget_Category/record-edit/All_Budget_Categories/" + row.ID + "/AgVAyCP5z76Y1bG5VgvCC0OwqtwCV0YBqr6HSEGfatm00bgfZSQ73ZsMphXEnz7FbbKhw08VwhrvhThhh7eXRFnkNdVfG3vkCr8F","same window");
										}
										if(Budget_Type == "Pro Forma")
										{
											openUrl("#Form:Budget_Category?recLinkID=" + row.ID + "&viewLinkName=All_Budget_Categories","popup window","height=80%,width=80%");
										}
						)
					}
				}

