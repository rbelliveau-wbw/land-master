			Load_Approval_Template_Co as "Load Approval Template - Contract"
			{
				type =  form
				form = Contract

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Existing Creator workflow Load_Approval_Template_Co; preserve Legal behavior.
										if(ifnull(input.Work_Module,"") != "Construction")
										{
											settings = Settings[ID != 0];
											for each  approver in settings.Builder_Approval_Template
											{
												approvalRow = Contract.Approvals1();
												approvalRow.Approval_Sequence=approver.Approval_Sequence;
												approvalRow.Approver=approver.Approver;
												input.Approvals1.insert(approvalRow);
											}
										}
						)
					}
				}

			}
			Load_Contract_Action_Temp as "Load Contract Action Template - Contract"
			{
				type =  form
				form = Contract

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Existing Creator workflow Load_Contract_Action_Temp; preserve Legal behavior.
										if(ifnull(input.Work_Module,"") != "Construction")
										{
											settings = Settings[ID != 0];
											for each  action in settings.Builder_Contract_Action_Template
											{
												if(ifnull(action.Work_Module,"") != "Construction")
												{
													actionRow = Contract.Contract_Actions();
													actionRow.Work_Module="Legal";
													actionRow.Contract_Action=action.Contract_Action;
													actionRow.Sort_Order=action.Sort_Order;
													input.Contract_Actions.insert(actionRow);
												}
											}
										}
						)
					}
				}

			}
			Write_Latest_Action_Appro as "Write Latest Action/Approver - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											multipleApprovers = "";
										// Fetch Contract Action records where Contract1 matches Input.ID and Complete is FALSE, sorted by Date_Sent
										actionsList = Contract_Actions[Contract1 == input.ID && Complete == false && Start_Date != null] sort by Start_Date;
										approvalsList = Contract_Approvals[Contract1 == input.ID && Status == "Awaiting Approval"];
										latestCompleted = Contract_Actions[Contract1 == input.ID && Complete == true] sort by Start_Date desc;
										// Check if any records are returned
										if(actionsList.count() > 0)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Action = actionsList.Contract_Action;
										}
										if(actionsList.count() = 0)
										{
											// If there all Actions are completed, grab the latest one and fill in the field
											input.Current_Action = latestCompleted.Contract_Action;
										}
										if(approvalsList.count() = 1)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Approver = approvalsList.Approver;
										}
										if(approvalsList.count() > 1)
										{
											for each  approver in approvalsList
											{
												multipleApprovers = approver.Approver + ", " + multipleApprovers;
											}
											input.Current_Approver = multipleApprovers;
										}
										if(approvalsList.count() = 0)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Approver = null;
										}
						)
					}
				}

			}
