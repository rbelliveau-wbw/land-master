                 			{
                 				loiRec.Version_Number=ws.get("Version_Number").toLong();
                 			}
                 			if(ws.get("Response_Date") != null && ws.get("Response_Date").toString() != "")
                 			{
                 				loiRec.Response_Date=ws.get("Response_Date").toString().toDate("MM/dd/yyyy");
                 			}
                 			if(ws.get("Assumed_Effective_Date") != null && ws.get("Assumed_Effective_Date").toString() != "")
                 			{
                 				loiRec.Assumed_Effective_Date=ws.get("Assumed_Effective_Date").toString().toDate("MM/dd/yyyy");
                 			}
                 			else if(loiRec.Assumed_Effective_Date == null || ws.get("Assumed_Effective_Date") != null)
                 			{
                 				loiRec.Assumed_Effective_Date=zoho.currentdate;
                 			}
                 			if(ws.get("Projected_Hard_Close_Date") != null)
                 			{
                 				if(ws.get("Projected_Hard_Close_Date").toString().trim() == "")
                 				{
                 					loiRec.Projected_Hard_Close_Date=null;
                 				}
                 				else
                 				{
                 					loiRec.Projected_Hard_Close_Date=ws.get("Projected_Hard_Close_Date").toString().toDate("MM/dd/yyyy");
                 				}
                 			}
                 			if(ws.get("Earnest_Money_Due_Date") != null && ws.get("Earnest_Money_Due_Date").toString() != "")
                 			{
                 				loiRec.Earnest_Money_Due_Date=ws.get("Earnest_Money_Due_Date").toString().toDate("MM/dd/yyyy");
                 			}
                 			if(ws.get("Is_Current") != null)
                 			{
                 				loiRec.Is_Current=ws.get("Is_Current").toString().toLowerCase() == "true";
                 			}
                 			if(ws.get("Locked") != null)
                 			{
                 				loiRec.Locked=ws.get("Locked").toString().toLowerCase() == "true";
                 			}
                 			if(companyId != "")
                 			{
                 				loiRec.Company=companyId.toLong();
                 			}
                 			if(ifnull(ws.get("Contract"),"").toString().trim() != "")
                 			{
                 				loiRec.Contract=ws.get("Contract").toString().toLong();
                 			}
                 			resp.put("success",true);
                 			resp.put("loiWorksheetId",loiRec.ID.toString());
                 			pfCheck = Add_Pro_Forma[ID == pfKey];
                 			if(pfCheck != null)
                 			{
                 				resp.put("purchasingCompany",ifnull(pfCheck.Purchasing_Company,"").toString());
                 			}
                 			resp.put("sellerMap",sellerMapOut);
                 			resp.put("propertyMap",propertyMapOut);
                 			resp.put("action","loi_saved");
                 			return resp.toString();
                 		}
                 		header = data.get("header");
                 		incomingPhaseSales = data.get("phaseSales");
                 		if(incomingPhaseSales == null || incomingPhaseSales.size() < 1)
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Phase sales are required. Reload this Pro Forma in the current widget before saving.");
                 			return resp.toString();
                 		}
                 		isNew = pfId == "";
                 		if(isNew)
                 		{
                 			newRec = insert into Add_Pro_Forma
                 			[
                 				Name=ifnull(header.get("Name"),"")
                 				Probability=ifnull(header.get("Probability"),"Medium")
                 				Added_User=zoho.loginuser
                 			];
                 			pfKey = newRec.toLong();
                 			pf = Add_Pro_Forma[ID == pfKey];
                 			if(pf.count() == 0)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","New pro forma could not be read back after insert.");
                 				return resp.toString();
                 			}
                 		}
                 		else
                 		{
                 			pfIdLong = pfId.toLong();
                 			pf = Add_Pro_Forma[ID == pfIdLong];
                 			if(pf.count() == 0)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro forma " + pfId + " not found.");
                 				return resp.toString();
                 			}
                 			pfKey = pf.ID.toLong();
                 			completedApprovalRows = Budget_Approvals[Proforma == pfKey];
                 			approvalIsComplete = completedApprovalRows.count() > 0;
                 			for each  completedApprovalRow in completedApprovalRows
                 			{
                 				if(ifnull(completedApprovalRow.Status,"Not Sent").toString() != "Approved")
                 				{
                 					approvalIsComplete = false;
                 				}
                 			}
                 			headerSaveProtected = approvalIsComplete || ifnull(pf.Status,"").toString() == "Approved";
                 			if(!migrationEditAccess && headerSaveProtected)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","This Pro Forma is fully approved and can never be unlocked or edited.");
                 				return resp.toString();
                 			}
                 		}
                 		// Validate changed owner assignments before a normal save writes any child rows.
                 		if(!isNew && header.get("Owner") != null)
                 		{
                 			requestedOwnerIds = List();
                 			for each  requestedOwner in header.get("Owner")
                 			{
                 				requestedOwnerText = ifnull(requestedOwner,"").toString().trim();
                 				if(requestedOwnerText != "" && !requestedOwnerIds.contains(requestedOwnerText))
                 				{
                 					requestedOwnerIds.add(requestedOwnerText);
                 				}
                 			}
                 			currentOwnerIds = List();
                 			for each  currentOwner in pf.Owner
                 			{
                 				currentOwnerIds.add(currentOwner.ID.toString());
                 			}
                 			ownerAssignmentChanged = requestedOwnerIds.size() > 0 && requestedOwnerIds.size() != currentOwnerIds.size();
                 			for each  requestedOwnerId in requestedOwnerIds
                 			{
                 				if(!currentOwnerIds.contains(requestedOwnerId))
                 				{
                 					ownerAssignmentChanged = true;
                 				}
                 			}
                 			if(ownerAssignmentChanged)
                 			{
                 				quickPf = pf;
                 				pfKey = pf.ID;
                 				// Never trust a supplied User Access ID when changing ownership.
                 				ownerActor = User_Access[User == zoho.loginuser];
                 				canUpdateOwners = false;
                 				if(ownerActor.count() > 0)
                 				{
                 					canUpdateOwners = ownerActor.Edit_Proforma_Owner == true || ownerActor.Edit_Budget_Owners == true;
                 					if(!canUpdateOwners && ownerActor.Edit_Owned_Proformas == true && quickPf.Owner != null)
                 					{
                 						for each  existingOwner in quickPf.Owner
                 						{
                 							if(existingOwner.ID.toString() == ownerActor.ID.toString())
                 							{
                 								canUpdateOwners = true;
                 							}
                 						}
                 					}
                 				}
                 				if(!canUpdateOwners)
                 				{
                 					resp.put("success",false);
                 					resp.put("error","Edit Pro Forma Owner access, or Edit Owned Pro Formas on a Pro Forma you already own, is required.");
                 					return resp.toString();
                 				}
                 				ownerChangeLocked = quickPf.Lock_Inputs == true || ifnull(quickPf.Status,"") == "Approved";
                 				for each  ownerApproval in Budget_Approvals[Proforma == pfKey]
                 				{
                 					if(ifnull(ownerApproval.Status,"Not Sent") != "Not Sent")
                 					{
                 						ownerChangeLocked = true;
                 					}
                 				}
                 				if(ownerChangeLocked)
                 				{
                 					resp.put("success",false);
                 					resp.put("error","Unlock the Pro Forma and cancel active approvals before changing owners.");
                 					return resp.toString();
                 				}
                 			}
                 		}
                 		instIds = List();
