rif; font-size: 12px; font-style: normal\"><b>${Notes}<\/b><\/span> <span style=\"color: rgb(0, 0, 0); font-family: Lato, Arimo, sans-serif; font-size: 12px; font-weight: 400; font-style: normal\">&nbsp;<\/span>\n  <\/div>"}}],"style":""},{"colElements":[{"id":"u_elem_225803747563771197","type":"lookupfields","element":{"valueStyle":"width: 50%; border-color: rgb(239, 130, 22); background-color: rgb(255, 255, 255); border-width: 0px; border-style: solid","valueTextStyle":"font-weight: bold","fieldLayoutType":"1","related_Form":"Additional_Items","labelText":"Additional Items","wrapperStyle":"width: 100%; border-collapse: collapse; font-size: 8pt; line-height: 0.8em","labelStyle":"width: 50%; display: none","Label_Name":"Additional_Items","refFields":[{"valueStyle":"font-size: 8pt; line-height: 0.8em; width: 180px; text-align: left","fieldLayoutType":"2","labelText":"Name","labelStyle":"color: rgba(0, 0, 0, 0)","Label_Name":"Name"},{"valueStyle":"font-size: 8pt; line-height: 0.8em; width: 60px; text-align: left","fieldLayoutType":"2","labelText":"Amount","labelStyle":"color: rgba(0, 0, 0, 0)","Label_Name":"Amount"},{"valueStyle":"font-size: 8pt; line-height: 0.8em; width: 3px; text-align: left","fieldLayoutType":"2","labelText":"Quantity","labelStyle":"color: rgba(0, 0, 0, 0)","Label_Name":"Quantity"},{"valueStyle":"font-size: 8pt; line-height: 0.8em; width: 75px; text-align: left","fieldLayoutType":"2","labelText":"Total","labelStyle":"color: rgba(0, 0, 0, 0)","Label_Name":"Total"}],"labelTextStyle":""}},{"type":"columns","element":{"split":"78,22","id":"u_elem_790983","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_26759994000000954","fields":[],"content":"<div\n    style=\"background: rgba(0, 0, 0, 0); padding: 0px; border-top: 1px dashed rgb(51, 51, 51)\">\n   <p\n      style=\"text-align: left; margin: 0px; color: rgb(0, 0, 0)\"><span style=\"font-size: 10px; font-weight: 700\"> TOTAL<\/span><\/p>\n  <\/div>"}}],"style":""},{"