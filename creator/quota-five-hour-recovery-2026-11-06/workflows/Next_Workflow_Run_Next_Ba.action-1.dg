// Next Workflow Run/Next Batch owns the shared five-hour anchor and batch cursor.
										settings = Settings[ID != 0];
										if(settings.count() != 1 || settings.Next_Workflow_Run == null)
										{
											throw "Expected one Settings record with Next Workflow Run.";
										}
										currentBatch = settings.Current_Batch;
										cycleDate = settings.Next_Workflow_Run;
										// Freeze the old cycle and batch before any Settings clock advance.
										cycleBatch = 0;
										if(currentBatch != null && currentBatch >= 0 && currentBatch <= 4)
										{
											cycleBatch = currentBatch;
										}
										// Keep the independent clock moving if queue metadata cannot be saved.
										try 
										{
											thisapp.workflowStarterFrame(settings.ID.toString(),cycleDate.toString("MM/dd/yyyy hh:mm:ss a"),cycleBatch);
										}catch (starterFrameError)
										{
											info "Starter cycle frame was not acknowledged; the shared clock still advances. " + starterFrameError.toString();
										}
										nextBatch = 0;
										if(currentBatch != null && currentBatch >= 0 && currentBatch < 4)
										{
											nextBatch = currentBatch + 1;
										}
										// Publish both values together. Null, 4, and legacy values outside 0–4 reset to 0.
										update settings
										[
											Current_Batch=nextBatch
											Next_Workflow_Run=cycleDate.addHour(5)
										];
