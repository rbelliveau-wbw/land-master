// Preserve the existing thirty-minute watchdog for other workflows. Actual
// imports can span many bounded steps, each with its own immutable watchdog.
run = Workflow_Run_Log[ID == input.ID];
if(run.count() == 1 && run.Run_Status == "Running")
{
	deferActual = false;
	try
	{
		state = ifnull(run.Export_State,"{}").toMap();
		actualWorkflows = {"Budgets_Import_Load_GP_Co","Budgets_Import_Great_Plai1","Budgets_Import_Load_HCSS_"};
		if(state.get("version") == 1 && actualWorkflows.contains(state.get("workflow")) && state.get("actualDeadline") != null && state.get("actualDeadline").toLong() > zoho.currenttime.toLong() && state.get("actualDeadline").toLong() <= run.Started_At.addMinutes(120).toLong() + 1000)
		{
			watchKey = run.ID.toString() + "|wake|" + state.get("tick") + "|10";
			watch = Workflow_Export_Lock[Claim_Key == watchKey];
			waitingWithResume = state.get("phase") == "waiting" && run.Resume_At != null;
			validPhase = state.get("phase") == "processing" || state.get("phase") == "polling" || waitingWithResume;
			deferActual = validPhase && watch.count() == 1 && watch.Wake_At != null && watch.Wake_At > zoho.currenttime;
		}
	}
	catch(watchStateError)
	{
		deferActual = false;
	}
	if(!deferActual)
	{
		thisapp.workflowRunLog({"action":"finish","id":run.ID.toString(),"status":"Timed Out","stage":"Watchdog","message":"No terminal acknowledgement within thirty minutes of start, or no valid bounded actual continuation remains.","details":"Last stage=" + ifnull(run.Stage,"") + "; resume at=" + ifnull(run.Resume_At,"").toString() + "; checkpoint=" + ifnull(run.Export_State,"") + ". The workflow may have hit a Creator execution limit, been interrupted, or lost its acknowledgement. Review the source reference and destination records before retrying; no automatic replay was performed.","counts":{"failed":1},"clearResume":true});
	}
}
