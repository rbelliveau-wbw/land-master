// Existing native batch: Budget_Item[Template_Item == false], 100 records.
// Both sources are checked before any field on this item is changed.
actualWriteAttempted = false;
actualSource = "Great Plains";
try
{
	gpActualElements = thisapp.budgetImportedActualElements(input.ID,"Great Plains");
	actualSource = "HeavyJob";
	hcssActualElements = thisapp.budgetImportedActualElements(input.ID,"HeavyJob");
	gpComponents = gpActualElements.get("components");
	hcssComponents = hcssActualElements.get("components");
	actualSource = "Creator Budget Item";
	if(Budget_Item[ID == input.ID].count() != 1) { throw "The native Budget Item is missing or ambiguous."; }
	actualItem = Budget_Item[ID == input.ID];
	actualPercentComplete = Budget_Import_Item[Budget_Item == input.ID].sum(Percent_Complete);
	actualWriteAttempted = true;
	// One native update replaces fourteen separate field-update statements.
	update actualItem
	[
		PROJ_Actual=gpActualElements.get("total")
		HCSS_Actuals=hcssActualElements.get("total")
		GP_Labor_Actuals=gpComponents.get("Labor")
		GP_Materials_Actuals=gpComponents.get("Materials")
		GP_Equipment_Actuals=gpComponents.get("Equipment")
		GP_Subcontractor_Actuals=gpComponents.get("Subcontractor")
		GP_Other_Actuals=gpComponents.get("Other")
		HCSS_Labor_Actuals=hcssComponents.get("Labor")
		HCSS_Materials_Actuals=hcssComponents.get("Materials")
		HCSS_Equipment_Actuals=hcssComponents.get("Equipment")
		HCSS_Subcontractor_Actuals=hcssComponents.get("Subcontractor")
		HCSS_Other_Actuals=hcssComponents.get("Other")
		Cost_to_Complete=hcssActualElements.get("costToComplete")
		Percent_Complete=actualPercentComplete
	];
	// Preserve the existing Construction budget approval lifecycle exactly.
	if(input.Department == "Construction")
	{
		constBudgetCost = Budget_Import_Item[Budget_Item == input.ID && Data_Source == "HeavyJob Budget"].sum(Cost);
		if(constBudgetCost == null) { constBudgetCost = 0; }
		constApprovalStatus = ifnull(input.Budget.Const_Budget_Approval_Status,"Not Sent");
		if(constApprovalStatus == "Approved")
		{
			input.Unapproved_Final_Budget_Ttl = 0;
		}
		else
		{
			input.Unapproved_Final_Budget_Ttl = constBudgetCost;
		}
	}
}
catch(actualError)
{
	// Emit the original item/source error before attempting an external audit.
	// An audit failure must never replace that original cause or trigger replay.
	actualFailure = "Budget Item=" + input.ID + "; Source=" + actualSource + "; " + actualError.toString();
	info actualFailure;
	actualStatus = "Failed";
	if(actualWriteAttempted) { actualStatus = "Partial"; }
	try
	{
		thisapp.workflowRunLog({"action":"start","terminal":true,"workflow":"Budgets - Apply Cost to Budget Lines","system":"Creator Batch Workflows","status":actualStatus,"stage":"Apply Actual Elements","reference":input.ID.toString(),"counts":{"received":1,"processed":1,"created":0,"updated":0,"skipped":0,"failed":1},"message":actualFailure,"details":"Source=" + actualSource + "; Budget Item=" + input.ID + "; batch size=100. Native writes may roll back. Review the failed batch before retrying; no automatic replay."});
	}
	catch(actualAuditError)
	{
		info "BUDGET ACTUAL AUDIT FAILED; original=" + actualFailure + "; audit=" + actualAuditError.toString() + ". No audit retry or business replay.";
	}
	throw actualFailure;
}
