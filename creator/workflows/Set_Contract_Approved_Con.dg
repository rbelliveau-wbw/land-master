// Contract_Approvals / on add or edit / on success.
// Candidate replacement for "Set Contract Approved - Contract Approval".
// Keep a Proposed parent in Legal Review while its approval rows are created.
contract = Contract[ID == input.Contract1];
approvals = Contract_Approvals[Contract1 == input.Contract1 && Contract_Action == null && Status != "Approved" && Status != "Not Sent"];
if(input.Contract_Action == null && contract.ID != null && ifnull(contract.Work_Module,"") != "Construction" && ifnull(contract.Status,"") != "Proposed" && approvals.count() == 0)
{
    contract.Status="Approved";
}
