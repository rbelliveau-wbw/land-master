// Add_Pro_Forma / Deleted / Validations on record deletion.
// No global orphan sweep. Only this parent's saved children are eligible.
if(input.ID != null && LOI_Worksheet[Proforma == input.ID].count() > 0)
{
	alert "This Pro Forma has LOI records. Archive it instead.";
	cancel delete;
}
if(input.ID != null)
{
	for each storedRow1 in Land_Installments[Pro_Forma == input.ID]
	{
		sharedChild = false;
		if(storedRow1.Pro_Forma2 != null && storedRow1.Pro_Forma2 != input.ID) { sharedChild = true; }
		if(storedRow1.Pro_Forma_PID_MUD != null && storedRow1.Pro_Forma_PID_MUD != input.ID) { sharedChild = true; }
		if(!sharedChild)
		{
			delete from Land_Installments[ID == storedRow1.ID && Pro_Forma == input.ID];
		}
	}
	for each storedRow1 in Land_Installments[Pro_Forma2 == input.ID]
	{
		sharedChild = false;
