// Completion fills blank Lot fields only; preserve existing values.
if(input.Contract_Type == "Lot" || input.Contract_Type == "Lot (Master)" || input.Contract_Type == "Lot (Amendment)" && input.Status == "Complete")
{
    completionResult = thisapp.Complete_Lot_Contract(input.ID.toString());
    completionMap = completionResult.toMap();
    if(completionMap.get("error") != null)
    {
        info completionMap.get("error");
    }
}
