// Generated by global-city/generate.mjs. Keep policy in globalCityPolicy.
// Project / City: persisted single consumer; existing native storage/mandatory rules stay unchanged.
sharedCityRequested = List();
if(input.City != null)
{
 if(input.City != "")
 {
  sharedCityRequested.add(input.City);
 }
}
sharedCitySavedValues = List();
sharedCityAllowRetained = false;
if(input.ID != null)
{
 sharedCityStored = Project[ID == input.ID];
 if(sharedCityStored.count() > 0 && sharedCityStored.ID == input.ID)
 {
  if(sharedCityStored.City != null)
  {
   if(sharedCityStored.City != "")
   {
    sharedCitySavedValues.add(sharedCityStored.City);
   }
  }
  sharedCityValuesLeft = List();
  for each sharedCitySetValue in sharedCityRequested
  {
   if(!sharedCityValuesLeft.contains(sharedCitySetValue))
   {
    sharedCityValuesLeft.add(sharedCitySetValue);
   }
  }
  sharedCityValuesRight = List();
  for each sharedCitySetValue in sharedCitySavedValues
  {
   if(!sharedCityValuesRight.contains(sharedCitySetValue))
   {
    sharedCityValuesRight.add(sharedCitySetValue);
   }
  }
  sharedCityValuesSame = sharedCityValuesLeft.size() == sharedCityValuesRight.size();
  for each sharedCitySetValue in sharedCityValuesLeft
  {
   if(!sharedCityValuesRight.contains(sharedCitySetValue))
   {
    sharedCityValuesSame = false;
   }
  }
  sharedCitySameScope = true;
  sharedCityAllowRetained = sharedCityValuesSame && sharedCitySameScope;
 }
}
sharedCityPolicy = thisapp.globalCityPolicy(sharedCityRequested,sharedCitySavedValues,sharedCityAllowRetained);
sharedCityChoices = sharedCityPolicy.get("choices");
// Preserve the mounted selection if the global authority is unavailable.
// The server guard still rejects a save until that configuration is repaired.
if(sharedCityChoices.size() > 0)
{
clear City;
City:ui.add(sharedCityChoices);
input.City = null;
for each sharedCityCurrent in sharedCityRequested
{
 if(sharedCityChoices.contains(sharedCityCurrent))
 {
  input.City = sharedCityCurrent;
 }
}
}
