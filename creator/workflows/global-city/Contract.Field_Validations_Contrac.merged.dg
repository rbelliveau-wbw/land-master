// Prepend inside the EXISTING Field_Validations_Contrac sole script action.
// Preserve its complete current body, including the globalCityPolicy suffix.
// Do not create a duplicate native workflow or duplicate the existing script.
// Native Deluge record operations in the guarded helper bypass this form action.
rejectionStoredParent = Contract[ID == input.ID];
rejectionPointerBefore = "";
if(rejectionStoredParent.count() > 0)
{
    rejectionPointerBefore = ifnull(rejectionStoredParent.Construction_Rejection_Operation,"");
}
if(ifnull(input.Construction_Rejection_Operation,"") != rejectionPointerBefore)
{
    alert "Construction review history can only be recorded by the review action.";
    cancel submit;
}
if(rejectionStoredParent.count() > 0 && ifnull(rejectionStoredParent.Work_Module,"") == "Construction")
{
    // Prevent native Accept/Edit from racing a claimed rejection operation.
    rejectionInFlight = Construction_Review_Log[(Contract1 == input.ID) && (Kind == "Decision") && (State == "recording")];
    if(rejectionInFlight.count() > 0 && input.Status != rejectionStoredParent.Status)
    {
        alert "A construction review is in progress. Check its result before changing status.";
        cancel submit;
    }
    // Direct status writes cannot bypass the reason and notification operation.
    if(rejectionStoredParent.Status == "Proposed" && input.Status == "Rejected")
    {
        alert "Use Reject in Construction Review to record a reason and notify the submitter.";
        cancel submit;
    }
}

// Contract / on add or edit / on validate. New construction inputs stay optional
// in Creator; required input checks are confined to the construction widget.
constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
storedRequest = Contract[ID == input.ID];
requestMode = ifnull(input.Work_Module,"");
if(requestMode == "")
{
    requestMode = "Legal";
}
if(requestMode != "Legal" && requestMode != "Construction")
{
    alert "Choose Legal or Construction for Work Module.";
    cancel submit;
}
if(storedRequest.count() > 0)
{
    storedMode = ifnull(storedRequest.Work_Module,"");
    if(storedMode == "")
    {
        storedMode = "Legal";
    }
    if(requestMode != storedMode)
    {
        alert "An existing request cannot be moved between Legal and Construction.";
        cancel submit;
    }
}
constructionTypes = {"Internal","Offsite","Amenity","MUD Bid"};
if(requestMode == "Construction")
{
    constructionEditor = thisapp.hasConstructionPermission(zoho.loginuser,true);
    constructionSubmitter = thisapp.hasConstructionPermission(zoho.loginuser,false);
    if(storedRequest.count() > 0)
    {
        if(constructionEditor != true)
        {
            alert "Edit All Construction Requests permission is required to change a submitted request.";
            cancel submit;
        }
        if(ifnull(storedRequest.Status,"") == "Complete")
        {
            alert "This construction request is complete and read-only.";
            cancel submit;
        }
    }
    else
    {
        if(constructionEditor != true && constructionSubmitter != true)
        {
            alert "Submit Construction Requests or Edit All Construction Requests permission is required.";
            cancel submit;
        }
        // Submit-only users cannot bypass the construction Review queue.
        input.Status = "Proposed";
        submittedActionCount = 0;
        for each  submittedAction in input.Contract_Actions
        {
            submittedActionCount = submittedActionCount + 1;
        }
        if(constructionEditor != true && submittedActionCount > 0)
        {
            alert "Construction task lists are added by the construction reviewer.";
            cancel submit;
        }
    }
    if(input.Contract_Type != null && !constructionTypes.contains(input.Contract_Type))
    {
        alert "Choose a construction Budget Type.";
        cancel submit;
    }
    if(input.Subdivision1 != null && input.Subdivision1.size() > 1)
    {
        alert "Choose one Subdivision for a construction request.";
        cancel submit;
    }
    // Derive request scope from the selected Subdivision, including API writes.
    for each  requestSubdivisionId in input.Subdivision1
    {
        requestSubdivision = Subdivision[ID == requestSubdivisionId];
        if(requestSubdivision.count() == 0)
        {
            alert "The selected Subdivision is unavailable.";
            cancel submit;
        }
        input.Project = requestSubdivision.Project;
        input.Company_Entity = requestSubdivision.Company1;
        input.County = requestSubdivision.County;
        input.City = requestSubdivision.City;
        input.Territory = requestSubdivision.Territory;
        requestProject = Project[ID == requestSubdivision.Project];
        if(input.Territory == null || input.Territory == "")
        {
            if(requestProject.count() > 0)
            {
                input.Territory = requestProject.Territory;
            }
        }
    }
    submittedApprovalCount = 0;
    for each  submittedApproval in input.Approvals1
    {
        submittedApprovalCount = submittedApprovalCount + 1;
    }
    if(submittedApprovalCount > 0)
    {
        alert "Construction requests do not use Legal contract approvals.";
        cancel submit;
    }
    // Linked actions inherit the parent's module and budget type.
    for each  constructionAction in input.Contract_Actions
    {
        constructionAction.Work_Module="Construction";
        constructionAction.Type_field=input.Contract_Type;
        constructionAction.Template_Action=false;
    }
}
else if(constructionBudgetingProfile)
{
    alert "This profile can only create or edit Construction requests.";
    cancel submit;
}
else if(constructionTypes.contains(input.Contract_Type))
{
    alert "Construction Budget Types require Construction Work Module.";
    cancel submit;
}
isLotRequest = input.Contract_Type == "Lot" || input.Contract_Type == "Lot (Master)" || input.Contract_Type == "Lot (Amendment)";
if(isLotRequest)
{
    if(input.Builder == null)
    {
        alert "Lot contracts must have a Builder / Counterparty selection.";
        cancel submit;
    }
}
if(input.Contract_Type == "Lot (Amendment)" && input.Subdivision1.size() == 0)
{
    alert "Lot (Amendment) must have a Subdivision selection.";
    cancel submit;
}
if(input.Parent_Contract != null)
{
    parentContract = Contract[ID == input.Parent_Contract];
    if(parentContract.count() == 0 || parentContract.ID == input.ID || parentContract.Parent_Contract != null)
    {
        alert "Choose a top-level Parent Contract. A contract cannot be its own parent.";
        cancel submit;
    }
    parentMode = ifnull(parentContract.Work_Module,"");
    if(parentMode == "")
    {
        parentMode = "Legal";
    }
    if(parentMode != requestMode)
    {
        alert "The parent request must be in the same Work Module.";
        cancel submit;
    }
    if(input.ID != null)
    {
        childContracts = Contract[Parent_Contract == input.ID];
        if(childContracts.count() > 0)
        {
            alert "A Master with child contracts cannot be assigned a parent.";
            cancel submit;
        }
    }
    if(input.Contract_Type == "Lot (Amendment)")
    {
        parentIsLotMaster = parentContract.Contract_Type == "Lot (Master)" || parentContract.Contract_Type == "Lot";
        if(parentIsLotMaster != true || parentContract.Builder != input.Builder || parentContract.Project != input.Project)
        {
            alert "The optional parent must be a Lot (Master) with the same Project and Builder / Counterparty.";
            cancel submit;
        }
    }
}

// Generated by global-city/generate.mjs. Keep policy in globalCityPolicy.
// Contract / City: persisted single consumer; existing native storage/mandatory rules stay unchanged.
sharedCityRequested = List();
if(input.City != null)
{
 if(input.City != "")
 {
  sharedCityRequested.add(input.City);
 }
}
sharedCitySavedValues = List();
sharedCityAllowRetained = false;
if(input.ID != null)
{
 sharedCityStored = Contract[ID == input.ID];
 if(sharedCityStored.count() > 0 && sharedCityStored.ID == input.ID)
 {
  if(sharedCityStored.City != null)
  {
   if(sharedCityStored.City != "")
   {
    sharedCitySavedValues.add(sharedCityStored.City);
   }
  }
  sharedCityValuesLeft = List();
  for each sharedCitySetValue in sharedCityRequested
  {
   if(!sharedCityValuesLeft.contains(sharedCitySetValue))
   {
    sharedCityValuesLeft.add(sharedCitySetValue);
   }
  }
  sharedCityValuesRight = List();
  for each sharedCitySetValue in sharedCitySavedValues
  {
   if(!sharedCityValuesRight.contains(sharedCitySetValue))
   {
    sharedCityValuesRight.add(sharedCitySetValue);
   }
  }
  sharedCityValuesSame = sharedCityValuesLeft.size() == sharedCityValuesRight.size();
  for each sharedCitySetValue in sharedCityValuesLeft
  {
   if(!sharedCityValuesRight.contains(sharedCitySetValue))
   {
    sharedCityValuesSame = false;
   }
  }
  sharedCitySameScope = true;
  if(ifnull(input.Project,"").toString() != ifnull(sharedCityStored.Project,"").toString())
  {
   sharedCitySameScope = false;
  }
  sharedCityInputScope = List();
  if(input.Subdivision1 != null)
  {
   for each sharedCityScopeId in input.Subdivision1
   {
    sharedCityInputScope.add(sharedCityScopeId.toString());
   }
  }
  sharedCitySavedScope = List();
  if(sharedCityStored.Subdivision1 != null)
  {
   for each sharedCityScopeId in sharedCityStored.Subdivision1
   {
    sharedCitySavedScope.add(sharedCityScopeId.toString());
   }
  }
  sharedCityScopeLeft = List();
  for each sharedCitySetValue in sharedCityInputScope
  {
   if(!sharedCityScopeLeft.contains(sharedCitySetValue))
   {
    sharedCityScopeLeft.add(sharedCitySetValue);
   }
  }
  sharedCityScopeRight = List();
  for each sharedCitySetValue in sharedCitySavedScope
  {
   if(!sharedCityScopeRight.contains(sharedCitySetValue))
   {
    sharedCityScopeRight.add(sharedCitySetValue);
   }
  }
  sharedCityScopeSame = sharedCityScopeLeft.size() == sharedCityScopeRight.size();
  for each sharedCitySetValue in sharedCityScopeLeft
  {
   if(!sharedCityScopeRight.contains(sharedCitySetValue))
   {
    sharedCityScopeSame = false;
   }
  }
  if(sharedCityScopeSame != true)
  {
   sharedCitySameScope = false;
  }
  if(ifnull(input.Contract_Type,"").toString() != ifnull(sharedCityStored.Contract_Type,"").toString())
  {
   sharedCitySameScope = false;
  }
  sharedCityCurrentModule = ifnull(input.Work_Module,"").toString();
  sharedCitySavedModule = ifnull(sharedCityStored.Work_Module,"").toString();
  if(sharedCityCurrentModule == "")
  {
   sharedCityCurrentModule = "Legal";
  }
  if(sharedCitySavedModule == "")
  {
   sharedCitySavedModule = "Legal";
  }
  if(sharedCityCurrentModule != sharedCitySavedModule)
  {
   sharedCitySameScope = false;
  }
  sharedCityAllowRetained = sharedCityValuesSame && sharedCitySameScope;
 }
}
sharedCityPolicy = thisapp.globalCityPolicy(sharedCityRequested,sharedCitySavedValues,sharedCityAllowRetained);
if(sharedCityPolicy.get("ok") != true)
{
 alert sharedCityPolicy.get("message");
 cancel submit;
}
