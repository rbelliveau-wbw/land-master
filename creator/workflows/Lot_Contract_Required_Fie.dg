isLotContract = input.Contract_Type == "Lot" || input.Contract_Type == "Lot (Master)" || input.Contract_Type == "Lot (Amendment)";
hasLotScope = input.Subdivision1.size() > 0 || input.Lots1.size() > 0;
if(isLotContract && hasLotScope)
{
 // Compare only lot terms so pricing, files and type edits preserve legacy terms.
 termsChanged = true;
 if(input.ID != null)
 {
  oldContract = Contract[ID == input.ID];
  if(oldContract.count() > 0)
  {
   termsChanged = oldContract.Number_of_Lots != input.Number_of_Lots || oldContract.Initial_Takedown != input.Initial_Takedown || oldContract.Initial_Takedown_Days != input.Initial_Takedown_Days || oldContract.Second_Closing_Lots != input.Second_Closing_Lots || oldContract.Second_Closing_Days != input.Second_Closing_Days || oldContract.Subsequent_Takedown_Lots != input.Subsequent_Takedown_Lots || oldContract.Subsequent_Takedown_Days != input.Subsequent_Takedown_Days;
  }
 }
 hasSecond = input.Second_Closing_Lots != null || input.Second_Closing_Days != null;
 if(termsChanged || hasSecond)
 {
  if(input.Second_Closing_Lots == null || input.Second_Closing_Lots <= 0 || input.Second_Closing_Days == null || input.Second_Closing_Days < 0)
  {
   alert "Enter positive whole Second Closing lots and Second Closing days of zero or more.";
   cancel submit;
  }
  cadenceTerms = Map();
  cadenceTerms.put("Total_Lot_Obligation",input.Number_of_Lots);
  cadenceTerms.put("Initial_Takedown",input.Initial_Takedown);
  cadenceTerms.put("Initial_Due_Offset_Days",input.Initial_Takedown_Days);
  cadenceTerms.put("Second_Closing_Lots",input.Second_Closing_Lots);
  cadenceTerms.put("Second_Closing_Days",input.Second_Closing_Days);
  cadenceTerms.put("Continued_Takedown",input.Subsequent_Takedown_Lots);
  cadenceTerms.put("Continued_Takedown_Delay_Days",input.Subsequent_Takedown_Days);
  cadenceTerms.put("Elapsed_Days",0);
  cadence = thisapp.Calculate_Takedown_Cadence(cadenceTerms);
  if(cadence.get("ok") != true)
  {
   alert cadence.get("message");
   cancel submit;
  }
 }
 recurringRequired = !hasSecond || ifnull(input.Number_of_Lots,0) > ifnull(input.Initial_Takedown,0) + ifnull(input.Second_Closing_Lots,0);
 if(hasSecond && recurringRequired)
 {
  if(ifnull(input.Subsequent_Takedown_Lots,0) <= 0 || ifnull(input.Subsequent_Takedown_Days,0) <= 0)
  {
   alert "Enter positive Subsequent Closing lots and days while lots remain.";
   cancel submit;
  }
 }
 if(input.Status == "Complete")
 {
  missingInitial = input.Number_of_Lots == null || input.Initial_Takedown == null || input.Initial_Takedown_Days == null;
  missingRecurring = false;
  if(recurringRequired)
  {
   missingRecurring = input.Subsequent_Takedown_Lots == null || input.Subsequent_Takedown_Days == null;
  }
  if(missingInitial || missingRecurring)
  {
   alert "Please add all Lot Closing details before moving to Complete.";
   cancel submit;
  }
 }
}
