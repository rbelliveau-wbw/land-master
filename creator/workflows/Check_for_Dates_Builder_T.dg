// Replacement custom script for existing Check_for_Dates_Builder_T workflow.
// Builder_Takedown: on add or edit, on validate. No schema changes.
// Prepared only; not published to Creator.

if(input.Interest_Rate_1 != null || input.Date1_1 != null || input.Date1_2 != null)
{
	if(input.Interest_Rate_1 == null || input.Date1_1 == null || input.Date1_2 == null)
	{
		alert "Complete the rate and both dates for interest period 1.";
		cancel submit;
	}
	if(input.Date1_1 != null && input.Date1_2 != null)
	{
		if(input.Date1_2 < input.Date1_1)
		{
			alert "Interest period 1 must end after it begins.";
			cancel submit;
		}
		if(input.Purchase_Date != null && input.Date1_2 > input.Purchase_Date)
		{
			alert "Interest period 1 ends after the purchase date.";
			cancel submit;
		}
	}
}

