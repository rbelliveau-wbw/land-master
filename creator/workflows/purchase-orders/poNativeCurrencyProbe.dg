map poNativeCurrencyProbe()
{
 result = {"success":false};
 try
 {
  if(zoho.loginuser != zoho.adminuser) { result.put("error","Application owner only."); return result; }
  exact = "9999999999999.99";
  converted = exact.toDecimal();
  result.put("converted",converted.toString());
  rowId = insert into PO_Currency_Probe
  [
   Added_User=zoho.loginuser
   Expected=exact
   Amount=exact
  ];
  row = PO_Currency_Probe[ID == rowId];
  result.put("rowId",rowId.toString());
  result.put("expected",exact);
  result.put("actual",row.Amount.toString());
  result.put("success",row.Amount.toString() == exact);
  // Owner-only Development test context; no approvals or notification calls.
  access = User_Access[User == zoho.loginuser];
  result.put("userAccessId",access.ID.toString());
  vendor = Vendors[Vendor_ID == "CODEX-PO-DEV-20261008"];
  if(vendor.ID == null)
  {
   vendorId = insert into Vendors
   [
    Added_User=zoho.loginuser
    Vendor_ID="CODEX-PO-DEV-20261008"
    Vendor_Name="Development PO Test Vendor"
   ];
   vendor = Vendors[ID == vendorId];
  }
  fixture = Add_Budget[Budget_Name == "Development PO Test 2026-10-08"];
  if(fixture.ID == null)
  {
   fixtureId = insert into Add_Budget
   [
    Added_User=zoho.loginuser
    Budget_Name="Development PO Test 2026-10-08"
    Development_Budget_Approval_Status="Approved"
    Budget_Type="Development"
    Archived=false
   ];
   fixture = Add_Budget[ID == fixtureId];
  }
  fixtureCategory = Budget_Category[Budget == fixture.ID && Budget_Category_Name == "Engineering"];
  if(fixtureCategory.ID == null)
  {
   categoryId = insert into Budget_Category
   [
    Added_User=zoho.loginuser
    Budget=fixture.ID
    Budget_Category_Name="Engineering"
    Deparment="Engineering"
   ];
   fixtureCategory = Budget_Category[ID == categoryId];
  }
  for each n in {1,2}
  {
   fixtureCode="CODEX-PO-DEV-20261008-" + n;
   if(Budget_Item[Budget_Code == fixtureCode].count() == 0)
   {
    fixtureItemId = insert into Budget_Item
    [
     Added_User=zoho.loginuser
     Budget=fixture.ID
     Budget_Category=fixtureCategory.ID
     Item_Name="Development PO Test " + n
     Category="Engineering"
     Department="Engineering"
     Dept_Code=99
     Cost_Code=n
     Budget_Code=fixtureCode
     Template_Item=false
     Budget_Ttl=1000.00
    ];
   }
  }
  result.put("vendorId",vendor.ID.toString());
  chosenBudget = 0;
  testItems = List();
  for each item in Budget_Item[Budget == fixture.ID && Template_Item != true && Budget_Ttl > 10]
  {
   budget = Add_Budget[ID == item.Budget && Archived != true];
   category = Budget_Category[ID == item.Budget_Category];
   eligible = false;
   if((category.Deparment == "Development" || category.Deparment == "Engineering") && budget.Development_Budget_Approval_Status == "Approved") { eligible = true; }
   if(category.Deparment == "Construction" && budget.Const_Budget_Approval_Status == "Approved") { eligible = true; }
   if(budget.ID != null && eligible == true && (chosenBudget == 0 || chosenBudget == budget.ID))
   {
    chosenBudget = budget.ID;
    testItems.add(item.ID.toString());
    if(testItems.size() == 2) { break; }
   }
  }
  result.put("budgetId",chosenBudget.toString());
  result.put("budgetItemIds",testItems);
  // Isolated Draft only; no approval initiation and no notification helper.
  testModification = Budget_Modification[Reference_Number == "CODEX-PO-LINK-DEV-20261008"];
  if(testModification.ID == null && testItems.size() > 0)
  {
   modificationId = insert into Budget_Modification
   [
    Added_User=zoho.loginuser
    Budget=fixture.ID
    Budget_Category=fixtureCategory.ID
    Budget_Item=testItems.get(0).toLong()
    Reference_Number="CODEX-PO-LINK-DEV-20261008"
    Reason="Isolated Development PO linked-modification test; no approval or email"
    Modification_Type="Increase"
    Approval_Track="Development"
    Status="Draft"
    Amount=1.00
   ];
   testModification = Budget_Modification[ID == modificationId];
  }
  if(testModification.ID != null && testModification.Budget == fixture.ID && testModification.Status == "Draft")
  {
   result.put("budgetModificationId",testModification.ID.toString());
  }
 }
 catch(e) { result.put("error",e.toString()); }
 return result;
}
