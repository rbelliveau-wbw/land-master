form PO_Phase_Lock
{
	displayname = "PO Phase Lock"
	success message = "PO record saved"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	must have unique Phase_Key
	(
		type = text
		maxchar = 30
		row = 1
		column = 1
		width = medium
	)
	Operation_Token
	(
		type = text
		maxchar = 80
		row = 1
		column = 1
		width = medium
	)
	Actor
	(
		type = picklist
		values = User_Access.ID
		displayformat = [User]
		row = 1
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
