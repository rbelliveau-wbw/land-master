// Previous-day additions and last persisted updates to Legal contracts and actions.
settings = Settings[ID != 0];
recipients = ifnull(settings.Receive_Legal_Notifications,"");
if(recipients != "")
{
	yesterday = zoho.currentdate.addDay(-1);
	today = zoho.currentdate;
	activity = List();
	for each contractRow in Contract[(Work_Module == null || Work_Module == "" || Work_Module == "Legal") && Added_Time >= yesterday && Added_Time < today] sort by Added_Time asc
	{
		activity.add({"change":"Contract Added","contract":contractRow.Contract_Name,"action":"","status":contractRow.Status,"notes":"","actor":contractRow.Added_User,"time":contractRow.Added_Time});
	}
	for each contractRow in Contract[(Work_Module == null || Work_Module == "" || Work_Module == "Legal") && Modified_Time >= yesterday && Modified_Time < today] sort by Modified_Time asc
	{
		if(contractRow.Modified_Time > contractRow.Added_Time || contractRow.Modified_User != contractRow.Added_User)
		{
			activity.add({"change":"Contract Updated","contract":contractRow.Contract_Name,"action":"","status":contractRow.Status,"notes":"","actor":contractRow.Modified_User,"time":contractRow.Modified_Time});
		}
	}
	for each actionRow in Contract_Actions[Contract1 != null && (Work_Module == null || Work_Module == "" || Work_Module == "Legal") && Added_Time >= yesterday && Added_Time < today] sort by Added_Time asc
	{
		if(ifnull(actionRow.Contract1.Work_Module,"") != "Construction")
		{
			activity.add({"change":"Action Added","contract":actionRow.Contract1.Contract_Name,"action":actionRow.Contract_Action,"status":actionRow.Status,"notes":actionRow.Dev_Notes,"actor":actionRow.Added_User,"time":actionRow.Added_Time});
		}
	}
	for each actionRow in Contract_Actions[Contract1 != null && (Work_Module == null || Work_Module == "" || Work_Module == "Legal") && Modified_Time >= yesterday && Modified_Time < today] sort by Modified_Time asc
	{
		if(ifnull(actionRow.Contract1.Work_Module,"") != "Construction" && (actionRow.Modified_Time > actionRow.Added_Time || actionRow.Modified_User != actionRow.Added_User))
		{
			activity.add({"change":"Action Updated","contract":actionRow.Contract1.Contract_Name,"action":actionRow.Contract_Action,"status":actionRow.Status,"notes":actionRow.Dev_Notes,"actor":actionRow.Modified_User,"time":actionRow.Modified_Time});
		}
	}
	if(activity.size() > 0)
	{
		body = "<div style='font:14px Arial,sans-serif;color:#172033'><h2>Legal Activity Digest</h2><p>" + yesterday.toString("MM/dd/yyyy") + "</p><table cellpadding='8' cellspacing='0' border='1' style='border-collapse:collapse;border-color:#d1d5db'>";
		body = body + "<tr style='background:#eef3fa'><th align='left'>Change</th><th align='left'>Contract</th><th align='left'>Action</th><th align='left'>Status</th><th align='left'>Dev Notes</th><th align='left'>Performed By</th><th align='left'>Time</th></tr>";
		for each changeRow in activity
		{
			actor = ifnull(changeRow.get("actor"),"").toString().trim();
			if(actor == "")
			{
				actor = "Unknown";
			}
			body = body + "<tr><td>" + changeRow.get("change") + "</td><td>" + thisapp.PF_Packet_Escape(ifnull(changeRow.get("contract"),"").toString()) + "</td><td>" + thisapp.PF_Packet_Escape(ifnull(changeRow.get("action"),"").toString()) + "</td><td>" + thisapp.PF_Packet_Escape(ifnull(changeRow.get("status"),"").toString()) + "</td><td>" + thisapp.PF_Packet_Escape(ifnull(changeRow.get("notes"),"").toString()).replaceAll("\n","<br>") + "</td><td>" + thisapp.PF_Packet_Escape(actor) + "</td><td>" + changeRow.get("time").toString("MM/dd/yyyy h:mm a") + "</td></tr>";
		}
		body = body + "</table></div>";
		sendmail
		[
			from :"Notifications@wbdevelopment.com"
			to :recipients
			subject :"Legal Activity Digest - " + yesterday.toString("MM/dd/yyyy")
			message :body
		]
	}
}
