// Contract / on add or edit / on success.
// Delegate every Lot write to the guarded fill-only completion function.
// Do not retain the old pricing/builder/status writes or status reconciliation.
if(input.Contract_Type == "Lot" && input.Status == "Complete")
{
    completionResult = thisapp.Complete_Lot_Contract(input.ID.toString());
    completionMap = completionResult.toMap();
    if(completionMap.get("error") != null)
    {
        info completionMap.get("error");
    }
}
