// Comment_Log: Created or Edited -> Validations on form submission.
// Runs for the widget's SDK addRecord/updateRecord writes, without skip_workflow.
commentText = ifnull(input.Comment,"").trim();
if(commentText == "" || commentText.length() > 60000)
{
	alert "Enter a comment between 1 and 60000 characters.";
	cancel submit;
}
if(input.Project == null && input.Budget == null && input.Pro_Forma == null && input.Contract1 == null)
{
	alert "Link the comment to a Project, Budget, Pro Forma, or Contract.";
	cancel submit;
}
existingComment = Comment_Log[ID == input.ID];
// Construction submitters can discuss requests without gaining request editing.
commentContractId = input.Contract1;
if(existingComment.count() > 0)
{
	commentContractId = existingComment.Contract1;
}
constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
if(constructionBudgetingProfile)
{
	if(input.Project != null || input.Budget != null || input.Pro_Forma != null)
	{
		alert "Construction comments cannot also be linked to Budgets, Projects, or Pro Formas.";
		cancel submit;
	}
	if(existingComment.count() > 0)
	{
		if(existingComment.Project != null || existingComment.Budget != null || existingComment.Pro_Forma != null)
		{
			alert "Construction comments cannot also be linked to Budgets, Projects, or Pro Formas.";
			cancel submit;
		}
	}
	scopedCommentParent = Contract[ID == commentContractId];
	if(commentContractId == null || scopedCommentParent.count() == 0 || ifnull(scopedCommentParent.Work_Module,"") != "Construction")
	{
		alert "This profile can only comment on Construction requests.";
		cancel submit;
	}
}
if(commentContractId != null)
{
	commentContract = Contract[ID == commentContractId];
	if(commentContract.count() > 0 && ifnull(commentContract.Work_Module,"") == "Construction")
	{
		constructionAllowed = thisapp.hasConstructionPermission(zoho.loginuser,false);
		if(constructionAllowed != true)
		{
			alert "Construction request access is required to add or change comments.";
			cancel submit;
		}
	}
}
if(existingComment.count() > 0)
{
	if(existingComment.Added_User != zoho.loginuser)
	{
		alert "Only the author can edit or delete this comment.";
		cancel submit;
	}
	if(existingComment.Added_Time.addHour(24) <= zoho.currenttime)
	{
		alert "Comments can only be edited or deleted within 24 hours of posting.";
		cancel submit;
	}
	if(existingComment.Deleted == true)
	{
		alert "A deleted comment cannot be changed.";
		cancel submit;
	}
	input.Project = existingComment.Project;
	input.Budget = existingComment.Budget;
	input.Pro_Forma = existingComment.Pro_Forma;
	input.Contract1 = existingComment.Contract1;
	input.User = existingComment.User;
	input.Author_Name = existingComment.Author_Name;
	input.Edited = existingComment.Edited;
	if(input.Deleted == true)
	{
		input.Comment = "Deleted by user";
	}
	else
	{
		input.Deleted = false;
		input.Comment = commentText;
		if(commentText != ifnull(existingComment.Comment,""))
		{
			input.Edited = true;
		}
	}
}
else
{
	input.Comment = commentText;
	input.User = zoho.loginuser;
	input.Edited = false;
	input.Deleted = false;
	input.Author_Name = zoho.loginuser;
	authorAccess = User_Access[User == zoho.loginuser];
	if(authorAccess.count() > 0)
	{
		fullName = ifnull(authorAccess.Full_Name,"").trim();
		if(fullName != "")
		{
			input.Author_Name = fullName;
		}
	}
}
