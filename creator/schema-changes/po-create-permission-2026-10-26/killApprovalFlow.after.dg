string killApprovalFlow(string budgetId)
{
	/********* CANCEL BOTH APPROVAL CHAINS *********/
	//
	// Development:
	// - Reset approval rows and status.
	// - Clear Development/Engineering Final and Unapproved.
	//
	// Construction:
	// - Reset approval rows and status.
	// - Move Construction Final back into Unapproved.
	// - Clear Construction Final.
	vBudgetId = budgetId.toLong();
	if(vBudgetId == 0)
	{
		return "{\"ok\":false,\"error\":\"No Budget ID provided.\"}";
	}
	budgetRec = Add_Budget[ID == vBudgetId];
	if(budgetRec == null)
	{
		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
	}
	// Preserve sender and global approval-admin cancellation, including the locked-phase tools.
	if(zoho.loginuser != zoho.adminuser)
	{
		requestAccess = User_Access[User == zoho.loginuser];
		if(requestAccess.count() != 1 || (requestAccess.Send_for_Approvals != true && requestAccess.Edit_All_Approvals != true))
		{
			return "{\"ok\":false,\"error\":\"Send for Approvals or Edit All Approvals permission is required.\"}";
		}
		try 
		{
			requestProfile = thisapp.permissions.profileForUser(zoho.loginuser);
			if(requestProfile == "Construction Budgeting")
			{
				return "{\"ok\":false,\"error\":\"Construction Budgeting has read-only Budget access except PO creation.\"}";
			}
		}		catch (profileError)
		{
			return "{\"ok\":false,\"error\":\"Budget permission profile could not be verified.\"}";
		}
	}
	/********* RESET BOTH TRACK STATUSES *********/
	budgetRec.Const_Budget_Approval_Status="Not Sent";
	budgetRec.Development_Budget_Approval_Status="Not Sent";
	/********* RESET ALL APPROVAL ROWS *********/
	rowsReset = 0;
	approvalRows = Budget_Approvals[Budget == vBudgetId];
	for each  ar in approvalRows
	{
		ar.Status="Not Sent";
		ar.Sent_Date=null;
		ar.Responded_Date=null;
		rowsReset = rowsReset + 1;
	}
	/********* MOVE CONSTRUCTION FINAL BACK TO UNAPPROVED *********/
	constructionItemsMoved = 0;
	constructionTotalMoved = 0;
	budgetCategories = Budget_Category[Budget == vBudgetId];
	for each  cat in budgetCategories
	{
		deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
		if(deptKey.contains("construction"))
		{
			constructionItems = Budget_Item[Budget_Category == cat.ID];
			for each  itemToMove in constructionItems
			{
				finalValue = 0;
				if(itemToMove.Budget_Ttl != null)
				{
					finalValue = itemToMove.Budget_Ttl;
				}
				// Move Construction Final back into Unapproved.
				itemToMove.Unapproved_Final_Budget_Ttl=finalValue;
				// Clear Construction Final.
				itemToMove.Budget_Ttl=0;
				constructionItemsMoved = constructionItemsMoved + 1;
				constructionTotalMoved = constructionTotalMoved + finalValue;
			}
		}
	}
	/********* CLEAR AND RECALCULATE BOTH TRACKS *********/
	devFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Development","CLEAR");
	// Construction CLEAR must preserve Unapproved_Final_Budget_Ttl.
	constFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Construction","CLEAR");
	resultMap = Map();
	resultMap.put("ok",true);
	resultMap.put("rowsReset",rowsReset);
	resultMap.put("constructionItemsMoved",constructionItemsMoved);
	resultMap.put("constructionTotalMoved",constructionTotalMoved);
	resultMap.put("developmentFinancialResult",devFinancialResp);
	resultMap.put("constructionFinancialResult",constFinancialResp);
	return resultMap.toString();
}