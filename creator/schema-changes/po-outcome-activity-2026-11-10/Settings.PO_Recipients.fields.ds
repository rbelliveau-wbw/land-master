// Candidate fields to add inside the existing Settings form.
Purchase_Order_Notifications
(
    type = section
    displayname = "Purchase Order Notifications"
    visibility = true
    row = 6
    column = 0
    width = medium
)
PO_Approved_Recipients
(
    type = list
    displayname = "Approved Notification Recipients"
