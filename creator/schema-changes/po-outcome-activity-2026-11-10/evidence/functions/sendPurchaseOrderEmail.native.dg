string sendPurchaseOrderEmail(string purchaseOrderId)
{
	environmentType = thisapp.environment.type;
	activityId = 0;
	mailStarted = false;
	try 
	{
		checked = thisapp.poApprovalBundle(purchaseOrderId);
		if(checked.get("success") != true)
		{
			return "ERROR: " + checked.get("error");
		}
		bundle = checked.get("bundle");
		active = bundle.get("active");
		if(active.get("id") == null)
		{
			return "ERROR: No active Purchase Order approver.";
		}
		approval = Budget_Approvals[ID == active.get("id").toLong()];
		if(approval.Sent_Date != null)
		{
			return "OK: Approval email already recorded.";
		}
		po = Payment_Request[ID == purchaseOrderId.toLong()];
		for each  deletionLock in PO_Phase_Lock[Phase_Key == po.Budget.toString()]
		{
			if(ifnull(deletionLock.Operation_Token,"").startsWith("delete-"))
			{
				return "ERROR: PO deletion is in progress. Notification was not sent.";
			}
		}
		if(po.PO_Approval_State != "Pending" || approval.Status != "Pending")
		{
			return "ERROR: PO approval state changed before notification.";
		}
		operation = "po-approval|" + purchaseOrderId + "|" + po.PO_Revision + "|" + approval.ID;
		latestId = 0;
		nextAttempt = 1;
		for each  previous in Activity_Log[Operation_ID == operation && Event == "Approval Request Email"]
		{
			if(previous.ID > latestId)
			{
				latestId = previous.ID;
			}
		}
		if(latestId > 0)
		{
			previous = Activity_Log[ID == latestId];
			if(previous.Status == "Sent" && previous.Sent_At != null)
			{
				approval.Sent_Date=previous.Sent_At.toDate();
				return "OK: Approval email already recorded.";
			}
			if(previous.Status != "Failed")
			{
				return "ERROR: The prior approval email attempt needs a read-only delivery check. It was not resent.";
			}
			nextAttempt = previous.Attempt_No + 1;
		}
		actorId = "";
		nativeActor = User_Access[User == zoho.loginuser];
		if(nativeActor.count() == 1)
		{
			actorId = nativeActor.ID.toString();
		}
		currentLock = PO_Phase_Lock[Phase_Key == po.Budget.toString()];
		if(currentLock.count() == 1 && currentLock.Actor != null)
		{
			actorId = currentLock.Actor.toString();
		}
		emailAddress = ifnull(approval.Approver,"").trim().toLowerCase();
		validEmailAddress = emailAddress.matches("^[^\\s@]+@[^\\s@]+[.][^\\s@]+$");
		recipientName = ifnull(active.get("name"),"");
		activityProof = {"revision":po.PO_Revision,"recipientKey":"approver-" + approval.ID,"approvalId":approval.ID.toString(),"userAccessId":active.get("userAccessId")};
		activityEvent = {"operationId":operation,"recipientKey":"approver-" + approval.ID,"objectType":"Purchase Order","objectId":purchaseOrderId,"contextType":"Budget","contextId":po.Budget.toString(),"process":"PO Approval","event":"Approval Request Email","recipientEmail":if(validEmailAddress,emailAddress,null),"recipientName":recipientName,"subject":"Purchase Order Approval","snapshot":activityProof,"actorId":actorId};
		claim = thisapp.activityEmailClaim(activityEvent,nextAttempt);
		if(claim.get("claimed") != true)
		{
			return "ERROR: " + claim.get("error");
		}
		activityId = claim.get("id").toLong();
		activity = Activity_Log[ID == activityId];
		if(!validEmailAddress)
		{
			activity.Status="Failed";
			activity.Error_Detail="The active approver has no valid email address. No email was sent.";
			return "ERROR: The active approver has no valid email address.";
		}
		vendor = ifnull(po.Vendor.Vendor_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
		phase = ifnull(po.Budget.Budget_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
		requestDate = "—";
		neededDate = "—";
		if(po.Request_Date != null)
		{
			requestDate = po.Request_Date.toString("MM/dd/yyyy");
		}
		if(po.Date_Needed != null)
		{
			neededDate = po.Date_Needed.toString("MM/dd/yyyy");
		}
		role = ifnull(active.get("role"),"Approver").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
		modTotal = 0.00;
		for each  modification in bundle.get("modifications")
		{
			modNet = modification.get("amount").toDecimal();
			if(modification.get("componentReallocation") == true && modification.get("modificationType") == "Decrease")
			{
				modNet = 0 - modNet;
			}
			modTotal = modTotal + modNet;
		}
		modSummary = "None required";
		if(bundle.get("modifications").size() > 0)
		{
			modSummary = bundle.get("modifications").size() + " modifications · Net $" + modTotal;
		}
		// appuri is a relative path; email actions need an absolute Creator URL.
		urlEnvironment = environmentType.toString().trim().toLowerCase();
		appBase = "https://creatorapp.zoho.com/wbdevelopment";
		if(urlEnvironment != "production")
		{
			if(urlEnvironment != "development" && urlEnvironment != "stage")
			{
				activity.Status="Failed";
				activity.Error_Detail="PO email environment is unavailable. No email was sent.";
				return "ERROR: PO email environment is unavailable.";
			}
			appBase = appBase + "/environment/" + urlEnvironment;
		}
		url = appBase + "/land-master/#Page:Budget_Management1?budgetId=" + po.Budget.toString() + "&purchaseOrderId=" + purchaseOrderId;
		body = "<div style='background:#eef3fa;padding:20px;font-family:Arial,sans-serif;color:#17385f'><table role='presentation' cellpadding='0' cellspacing='0' style='width:100%;max-width:640px;margin:auto;background:white;border:1px solid #d5e1ee'><tr><td style='background:#17385f;color:white;padding:18px 22px'><div style='font-size:12px'>PURCHASE ORDER APPROVAL</div><h2 style='font-size:21px;margin:6px 0'>" + phase + "</h2><div>" + vendor + "</div></td></tr><tr><td style='padding:20px 22px'><div style='font-size:28px;font-weight:bold;color:#08745a'>$" + po.PO_Amount_Exact + "</div><p style='margin:8px 0 16px'>Your " + role + " approval is requested.</p><table style='width:100%;font-size:13px;line-height:1.7'><tr><td>PO</td><td align='right'>" + purchaseOrderId + "</td></tr><tr><td>Request date / needed</td><td align='right'>" + requestDate + " / " + neededDate + "</td></tr><tr><td>Line items</td><td align='right'>" + po.PO_Line_Count + "</td></tr><tr><td>Budget modifications</td><td align='right'>" + modSummary + "</td></tr></table><p style='font-size:13px;color:#526982'>Full line details are in the attached Excel file.</p><p style='margin:20px 0 4px'><a href='" + url + "' style='display:inline-block;padding:12px 18px;background:#2256a6;color:white;text-decoration:none;font-weight:bold'>Review purchase order</a></p></td></tr></table></div>";
		elementBody = "";
		if(bundle.get("modifications").size() > 0)
		{
			elementBody = "<h3 style='font-size:15px;margin:18px 0 8px'>Proposed Budget Changes</h3><table style='width:100%;font-size:10px;border-collapse:collapse'><thead><tr>";
			for each  heading in {"Cost Code","Budget Item","Net Change","(1) Labor","(2) Materials","(3) Equipment","(4) Subcontractor","(5) Other"}
			{
				elementBody = elementBody + "<th style='padding:5px;border-bottom:1px solid #cbd5e1;text-align:right'>" + heading + "</th>";
			}
			elementBody = elementBody + "</tr></thead><tbody>";
			for each  modification in bundle.get("modifications")
			{
				modItem = Budget_Item[ID == modification.get("budgetItemId").toLong()];
				modItemName = ifnull(modItem.Item_Name,"Budget Item").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
				modCostCode = ifnull(modItem.Cost_Code,"").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
				modNet = modification.get("amount").toDecimal();
				if(modification.get("componentReallocation") == true && modification.get("modificationType") == "Decrease")
				{
					modNet = 0 - modNet;
				}
				elementBody = elementBody + "<tr><td style='padding:5px'>" + modCostCode + "</td><td style='padding:5px'>" + modItemName + "</td><td style='padding:5px;text-align:right'>" + modNet.text("$#,##0.00") + "</td>";
				for each  componentCode in {"1","2","3","4","5"}
				{
					modPart = null;
					if(modification.get("componentReallocation") == true)
					{
						modPart = modification.get("signedComponents").get(componentCode);
					}
					else if(modification.get("components") != null)
					{
						modPart = modification.get("components").get(componentCode);
					}
					modDisplay = "—";
					if(modPart != null)
					{
						modDisplay = modPart.toDecimal().text("$#,##0.00");
					}
					elementBody = elementBody + "<td style='padding:5px;text-align:right'>" + modDisplay + "</td>";
				}
				elementBody = elementBody + "</tr>";
			}
			elementBody = elementBody + "</tbody></table>";
		}
		elementBody = elementBody + "<h3 style='font-size:15px;margin:18px 0 8px'>Budget Element Details</h3><table style='width:100%;font-size:10px;border-collapse:collapse'><thead><tr>";
		for each  heading in {"Cost Code","Budget Item","Element","Final","Approved Mods","Modified Budget","Existing POs","Available","This PO","Remaining"}
		{
			elementBody = elementBody + "<th style='padding:5px;border-bottom:1px solid #cbd5e1;text-align:right'>" + heading + "</th>";
		}
		elementBody = elementBody + "</tr></thead><tbody>";
		for each  element in thisapp.poElementExportRows(purchaseOrderId)
		{
			costCode = ifnull(element.get("costCode"),"").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
			elementBody = elementBody + "<tr><td style='padding:5px;border-bottom:1px solid #e2e8f0'>" + costCode + "</td>";
			elementIndex = 0;
			for each  value in element.get("values")
			{
				display = "—";
				if(elementIndex < 2)
				{
					display = ifnull(value,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
				}
				else if(value != null)
				{
					display = value.text("$#,##0.####");
				}
				elementBody = elementBody + "<td style='padding:5px;border-bottom:1px solid #e2e8f0;text-align:right'>" + display + "</td>";
				elementIndex = elementIndex + 1;
			}
			elementBody = elementBody + "</tr>";
		}
		elementBody = elementBody + "</tbody></table><p style='font-size:11px;color:#64748b'>Final + Approved Mods = Modified Budget; Modified Budget − Existing POs = Available; Available − This PO = Remaining. Unavailable allocations remain —.</p>";
		body = body + "<div style='max-width:800px;margin:16px auto;padding:16px;background:#fff;font-family:Arial,sans-serif;color:#17385f'>" + elementBody + "</div>";
		subjectLine = "Purchase Order Approval · " + ifnull(po.Budget.Budget_Name,"") + " · $" + po.PO_Amount_Exact;
		if(environmentType == "Development")
		{
			subjectLine = "[DEV TEST] " + subjectLine;
		}
		if(bundle.get("poTestCFO") != null)
		{
			subjectLine = "[PO TEST] " + subjectLine;
			body = "<div style='padding:12px;background:#fff3cd;color:#654d00;font-family:Arial,sans-serif'><b>PO TEST</b> · Temporary CFO approval for this budget only, up to $" + bundle.get("poTestCFO").get("maxAmount") + ". Submitter self-approval is enabled for this captured test route.</div>" + body;
		}
		workbook = thisapp.poExcelWorkbook(purchaseOrderId);
		if(workbook.get("success") != true)
		{
			activity.Status="Failed";
			activity.Error_Detail="The PO Excel attachment could not be generated. No email was sent.";
			return "ERROR: PO Excel attachment could not be generated.";
		}
		excelFile = workbook.get("content").toFile(workbook.get("filename"));
		activity.Subject=subjectLine;
		if(po.PO_Approval_State != "Pending" || approval.Status != "Pending")
		{
			activity.Status="Failed";
			activity.Error_Detail="The approval changed before notification. No email was sent.";
			return "ERROR: PO approval state changed before notification.";
		}
		activity.Status="Sending";
		mailStarted = true;
		sendmail
		[
			from :"Notifications@wbdevelopment.com"
			to :approval.Approver
			subject :subjectLine
			message :body
			Attachments :file:excelFile
		]
		activity.Sent_At=zoho.currenttime;
		approval.Sent_Date=zoho.currentdate;
		if(approval.Sent_Date == null)
		{
			activity.Status="Unknown";
			activity.Error_Detail="Email was submitted, but its approval delivery stamp could not be confirmed.";
			return "ERROR: Email delivery stamp could not be verified.";
		}
		activity.Status="Sent";
		return "OK: Combined PO approval email recorded.";
	}	catch (emailError)
	{
		if(activityId > 0)
		{
			activity = Activity_Log[ID == activityId];
			activity.Status=if(mailStarted,"Unknown","Failed");
			activity.Error_Detail=if(mailStarted,"Email delivery could not be confirmed. Check delivery before any resend.","The notification could not be prepared. No email was sent.");
		}
		return "ERROR: Combined approval email delivery could not be verified.";
	}
	return "ERROR: Combined approval email did not finish.";
}
