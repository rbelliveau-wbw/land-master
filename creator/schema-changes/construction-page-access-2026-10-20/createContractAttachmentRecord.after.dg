string createContractAttachmentRecord(string contractId)
{
	/********* CREATE EMPTY CONTRACT ATTACHMENT CHILD RECORD *********/
	response = Map();
	vContractId = ifnull(contractId,"").trim();
	if(vContractId == "")
	{
		response.put("ok",false);
		response.put("message","Missing Contract ID.");
		return response.toString();
	}
	contractRows = Contract[ID == vContractId.toLong()];
	if(contractRows.count() == 0)
	{
		response.put("ok",false);
		response.put("message","Contract not found.");
		return response.toString();
	}
	constructionBudgetingProfile = thisapp.permissions.isUserInProfile("Construction Budgeting");
	if(constructionBudgetingProfile && ifnull(contractRows.Work_Module,"") != "Construction")
	{
		response.put("ok",false);
		response.put("message","This profile can only manage Construction attachments.");
		return response.toString();
	}
	if(ifnull(contractRows.Work_Module,"") == "Construction")
	{
		constructionAllowed = thisapp.hasConstructionPermission(zoho.loginuser,false);
		if(constructionAllowed != true)
		{
			response.put("ok",false);
			response.put("message","Construction request access is required to add attachments.");
			return response.toString();
		}
	}
	try 
	{
		if(ifnull(contractRows.Status,"").toString() == "Complete")
		{
			response.put("ok",false);
			response.put("message","This contract is complete and read-only.");
			return response.toString();
		}
		attachmentId = insert into Attachment
		[
			Contract1=vContractId.toLong()
			Date_field1=zoho.currenttime
			Email_Attachment=true
			Added_User=zoho.loginuser
		];
		response.put("ok",true);
		response.put("attachmentId",attachmentId.toString());
		response.put("message","Attachment record created.");
		return response.toString();
	}	catch (createError)
	{
		response.put("ok",false);
		response.put("message","Attachment record creation failed: " + createError.toString());
		return response.toString();
	}
	response.put("ok",false);
	response.put("message","Attachment record creation ended without a response.");
	return response.toString();
}