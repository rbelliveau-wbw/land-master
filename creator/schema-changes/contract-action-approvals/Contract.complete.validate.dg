// Add Contract / Edited / Validation on submission
if(input.Status == "Complete" && ifnull(input.Work_Module,"") != "Construction")
{
    for each requiredAction in Contract_Actions[Contract1 == input.ID && Requires_Approval == true]
    {
        if(requiredAction.Complete != true || requiredAction.Status != "Complete")
        {
            alert "Finish the required approval actions before completing the contract.";
            cancel submit;
        }
    }
}
