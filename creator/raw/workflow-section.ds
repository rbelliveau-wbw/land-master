			Mass_Update_Tax_Mass_Upda as "Mass Update Tax - Mass Update Tax"
			{
				type =  form
				form = Mass_Update_Tax

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										for each  parcel in input.Tax_Parcel_Year
										{
											for each  taxRate1 in input.Tax_Rates
											{
												totalTaxrate = totalTaxrate + taxRate1.Tax_Rate;
											}
											taxRates = input.Tax_Rates.toList();
											if(input.Status != null)
											{
												parcel.Appeal_Protest=input.Status;
											}
											if(taxRates.size() != 0)
											{
												parcel.Tax_Rates=input.Tax_Rates;
												parcel.Cumulative_Tax_Rate=totalTaxrate;
											}
											if(input.Appeal_Date != null)
											{
												parcel.Protest_Hearing_Date=input.Appeal_Date;
											}
											if(input.Appeal_Deadline != null)
											{
												parcel.Protest_Deadline=input.Appeal_Deadline;
											}
											if(input.FMV != null)
											{
												parcel.Notice_FMV=input.FMV;
											}
											if(input.Appraised_Value != null)
											{
												parcel.Appraised_Value=input.Appraised_Value;
											}
											if(input.Protest_Value != null)
											{
												parcel.Protest_Value=input.Protest_Value;
											}
											if(input.Arbitration_Value != null)
											{
												parcel.Arbitration_Value=input.Arbitration_Value;
											}
										}
										info taxRates;
										openUrl("#Script:page.parent.refresh ","parent window");
						)
					}
				}

			}
			Set_Subdiv_Blank_Mass_Cre as "Set Subdiv Blank - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

