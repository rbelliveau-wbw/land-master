			Write_Latest_Action_Appro as "Write Latest Action/Approver - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											multipleApprovers = "";
										// Fetch Contract Action records where Contract1 matches Input.ID and Complete is FALSE, sorted by Date_Sent
										actionsList = Contract_Actions[Contract1 == input.ID && Complete == false && Start_Date != null] sort by Start_Date;
										approvalsList = Contract_Approvals[Contract1 == input.ID && Status == "Awaiting Approval"];
										latestCompleted = Contract_Actions[Contract1 == input.ID && Complete == true] sort by Start_Date desc;
										// Check if any records are returned
										if(actionsList.count() > 0)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Action = actionsList.Contract_Action;
										}
										if(actionsList.count() = 0)
										{
											// If there all Actions are completed, grab the latest one and fill in the field
											input.Current_Action = latestCompleted.Contract_Action;
										}
										if(approvalsList.count() = 1)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Approver = approvalsList.Approver;
										}
										if(approvalsList.count() > 1)
										{
											for each  approver in approvalsList
											{
												multipleApprovers = approver.Approver + ", " + multipleApprovers;
											}
											input.Current_Approver = multipleApprovers;
										}
										if(approvalsList.count() = 0)
										{
											// Update input form's Current_Action field with the Contract Action from the earliest record
											input.Current_Approver = null;
										}
						)
					}
				}

			}
			Set_Date_Contract_Action as "Set Date - Contract Action"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on add row of Contract_Actions
				{
					actions 
