											if(fc != null && fc.ID != null)
											{
												fc.Forecasted_Lots=row.AUG_LOTS;
												for each  subdiv in input.Subdivisions
												{
													futureForecasted = Forecast[Subdivision1 == subdiv && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots);
													lotsPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model = FALSE];
													lotTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model = FALSE];
													subdiv.Unforecasted_Lots=lotTotal.count(ID) - lotsPurchased.count(ID) - futureForecasted;
													input.plain1 = thisapp.buildForecastManagerSummary(input.Subdivisions);
												}
											}
										}
						)
					}
				}

			}
			SEP_Edit_Forecast_Manager as "SEP Edit - Forecast Manager"
			{
				type =  form
				form = Forecast_Manager

				record event = on add

				on user input of Forecasts.SEP_LOTS
				{
					actions 
					{
						custom deluge script
						(
											forecastWindowOpen = false;
										settingsList = Settings[ID != 0].Open_Forecasting_Window.getAll();
										if(settingsList != null && !settingsList.isEmpty())
										{
											forecastWindowOpen = settingsList.get(0);
										}
										oldValue = null;
										forecastStartDate = null;
										fc = null;
										if(row.SEPID != null)
										{
											fc = Forecast[ID == row.SEPID.toNumber()];
											if(fc.ID != null)
											{
												oldValue = fc.Forecasted_Lots;
												forecastStartDate = fc.Forecast_Start_Date;
											}
										}
										if(forecastWindowOpen != true)
										{
											alert "Forecasting window closed for the month.";
											row.SEP_LOTS=oldValue;
										}
										else if(forecastStartDate != null && forecastStartDate.addDay(28) < zoho.currentdate)
										{
											alert "Past forecasts cannot be edited.";
											row.SEP_LOTS=oldValue;
										}
										else
										{
											if(fc != null && fc.ID != null)
											{
												fc.Forecasted_Lots=row.SEP_LOTS;
												for each  subdiv in input.Subdivisions
												{
													futureForecasted = Forecast[Subdivision1 == subdiv && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots);
													lotsPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model = FALSE];
													lotTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model = FALSE];
													subdiv.Unforecasted_Lots=lotTotal.count(ID) - lotsPurchased.count(ID) - futureForecasted;
													input.plain1 = thisapp.buildForecastManagerSummary(input.Subdivisions);
												}
											}
										}
						)
					}
				}

			}
