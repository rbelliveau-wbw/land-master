						)
					}
				}

			}
			Create_Takedown_Schedule_1 as "Create Takedown Schedule 2 - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											existingTdsched = Takedown_Schedule[Takedown_Schedule_Code = input.Subdivision1.Subdivision_Code + ' - ' + input.Builder.Builder_Name];
										if(Status == "Complete" && Contract_Type == "Lot")
										{
											if(existingTdsched.count() == 0)
											{
												insert into Takedown_Schedule
												[
													Added_User=zoho.loginuser
													Subdivisions=input.Subdivision1
													Builder1=input.Builder
													Status="Active"
													Total_Lot_Obligation=input.Number_of_Lots
													Initial_Takedown=input.Initial_Takedown
													Initial_Delay_Days=input.Initial_Takedown_Days
													Continued_Takedown=input.Subsequent_Takedown_Lots
													Continued_Takedown_Delay_Days=input.Subsequent_Takedown_Days
													Add_Contract_Contract_Name=input.ID
													Takedown_Schedule_Code=input.Subdivision1.Subdivision_Code + ' - ' + input.Builder.Builder_Name
												]
											}
										}
						)
					}
				}

