			Set_Const_Eng_Base_Cost_P as "Set Const & Eng Base Cost - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Lots
				{
					actions 
					{
						custom deluge script
						(
											if(Engineering_Cost_Lot != null && Lots != null)
										{
											input.Entitlement_Cost = input.Engineering_Cost_Lot * input.Lots;
										}
						)
					}
				}

			}
