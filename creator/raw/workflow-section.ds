			Subform_Field_Validation_ as "Subform Field Validation - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Budget_Type == "Pro Forma")
										{
											for each  itemRow in input.Budget_Items
											{
												//if(itemRow.Add_l_Cost != null && itemRow.Start_Phase == null || itemRow.End_Phase == null)
												//{
												//	alert "Please enter start and end phase.";
												//	cancel submit;
												//}
												if(itemRow.Add_l_Cost == null && itemRow.Start_Phase != null || itemRow.End_Phase != null)
												{
													alert "Please enter all item costs where phases are designated.";
													cancel submit;
												}
												// Validate Add'l Cost line: must have EITHER complete phase range OR complete month range
												if(itemRow.Add_l_Cost != null && itemRow.Add_l_Cost != 0 && itemRow.Item_Name.contains("Impact Fees") == false)
												{
													// Adjust field names if yours differ
													hasPhaseStart = itemRow.Start_Phase != null;
													hasPhaseEnd = itemRow.End_Phase != null;
													hasMonthStart = itemRow.Start_Month != null;
													hasMonthEnd = itemRow.End_Month != null;
													phaseComplete = hasPhaseStart == true && hasPhaseEnd == true;
													monthComplete = hasMonthStart == true && hasMonthEnd == true;
													phasePartial = hasPhaseStart == true || hasPhaseEnd == true && phaseComplete == false;
													monthPartial = hasMonthStart == true || hasMonthEnd == true && monthComplete == false;
													// 1) No incomplete ranges
													if(phasePartial)
													{
														alert "Please enter Start and End Phase for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													if(monthPartial)
													{
														alert "Please enter Start and End Month for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													// 2) Not both, not neither
													if(phaseComplete && monthComplete)
													{
														alert "Please provide either phase range or month range for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
													if(!phaseComplete && !monthComplete)
													{
														alert "Please provide a complete Phase range or a complete Month range to apply additional cost for " + itemRow.Item_Name + " line item.";
														cancel submit;
													}
												}
											}
										}
						)
					}
				}

			}
			CSS_Styling_Pro_Forma as "CSS Styling - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											x = "<style>";
										// =====================
										// TABS (UPDATED to match new styling)
										// =====================
										x = x + ".zc-Tabs-group .form-field .tempContDiv .choice-table-row{display:table-cell !important;vertical-align:bottom;}";
										x = x + "@media(max-width:900px){.form-group.clearfix.zc-Tabs-group.zc-radio-field-group{width:100%!important;min-width:0!important;}}";
										x = x + ".zc-Tabs-label{display:none !important;}";
										x = x + "[name=\"parentOf-Tabs\"]{width:100% !important;}";
										// Remove the old underline bar + make the wrapper feel like your new UI (no shadow)
										x = x + ".zc-Tabs-group .form-field .tempContDiv{border-bottom:none!important;padding:6px 6px 0 6px!important;margin-bottom:0!important;background:#ffffff!important;border:1px solid #e5e7eb!important;border-radius:14px!important;box-shadow:none!important;display:inline-block!important;}";
										x = x + ".zc-Tabs-group .form-field .tempContDiv .choice-table-row div.choice-table-cell{display:block;text-align:center;width:100% !important;padding:0 !important;margin:0;}";
										x = x + ".zc-Tabs-group .form-field .tempContDiv .choice-table-row .customRadio+label{display:none !important;}";
										x = x + "[name=\"Tabs\"]{display:none !important;}";
										// Blue tab look (matches Addl_Costs_Tabs styling style-wise)
										x = x + ".zc-Tabs-group .form-field .tempContDiv .choice-table-row .choice-table-cell span label.choice-label-text{" + "display:block!important;" + "width:100%!important;" + "background:#eff6ff!important;" + "color:#1e3a8a!important;" + "font-size:15px!important;" + "font-weight:800!important;" + "padding:10px 22px!important;" + "border:1px solid transparent!important;" + "border-bottom:none!important;" + "border-radius:10px 10px 0 0!important;" + "box-sizing:border-box!important;" + "letter-spacing:0.4px!important;" + "text-transform:uppercase!important;" + "transition:background 0.18s ease,color 0.18s ease,border-color 0.18s ease,transform 0.12s ease!important;" + "}";
										x = x + ".zc-Tabs-group .form-field .tempContDiv .choice-table-row .choice-table-cell span label.choice-label-text:hover{" + "background:#dbeafe!important;" + "color:#1d4ed8!important;" + "border-color:#bfdbfe!important;" + "cursor:pointer!important;" + "transform:translateY(-1px)!important;" + "}";
										// Checked (no shadow, stronger blue)
