			Form_Logic_Checks_Pro_For as "Form Logic Checks - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Purchase_Installments == null || Purchase_Installments == 0)
										{
											alert "Please complete Land Purchase section.";
											cancel submit;
										}
										pct = 0;
										for each  curve in input.Construction_Curve
										{
											pct = pct + curve.Percent_Cost;
										}
										if(pct != 100)
										{
											alert "Construction Cost Curve does not reach 100%.";
											cancel submit;
										}
										installmentTotal = 0;
										for each  inst in input.Land_Purchase_Installments
										{
											installmentTotal = installmentTotal + inst.Cost;
										}
										if(installmentTotal != input.Land_Cost)
										{
											alert "Land Installment total does not match Land Cost.";
											cancel submit;
										}
										/* ===== NEW: Land Sale + Sale Installments must be BOTH filled or BOTH blank ===== */
										landSaleEmpty = input.Land_Sale == null || input.Land_Sale == 0;
										saleInstEmpty = input.Sale_Installments == null || input.Sale_Installments == 0;
										if((landSaleEmpty && !saleInstEmpty) || (!landSaleEmpty && saleInstEmpty))
										{
											alert "Please complete both Land Sale and Sale Installments (or leave both blank).";
											cancel submit;
										}
										/* ===== EXISTING: only validate totals when both are filled ===== */
										if(!landSaleEmpty && !saleInstEmpty)
										{
											saleinstallmentTotal = 0;
											for each  inst in input.Land_Sale_Installments
											{
												saleinstallmentTotal = saleinstallmentTotal + inst.Cost;
											}
											if(saleinstallmentTotal != input.Land_Sale)
											{
												alert "Land Sale Installment total does not match Land Sale.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			RUN_EVERYTHING_ON_SUCCESS as "RUN EVERYTHING ON SUCCESS"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===== EXISTING LOGIC =====
										delete from Proforma_Phase[Pro_Forma == input.ID];
										// X = input.Phases
										iterationCount = ifnull(input.Phases,0);
										lotStart = input.Takedown_Start_Month;
										lotsRemaining = input.Lots;
										if(iterationCount <= 0)
										{
											return;
										}
										// OPTIONAL: clear existing Phase records for this Pro Forma (uncomment if desired)
										// existingPhases = Proforma_Phase[Pro_Forma == input.ID];
										// for each  ph in existingPhases
										// {
										// 	ph.delete();
										// }
										// Build a list with X dummy elements using your pattern
										iterationString = "".leftPad(iterationCount);
										iterationString = iterationString.replaceAll(" ",",");
										iterationString = iterationString.subString(0,iterationString.length() - 1);
										listPads = iterationString.toList();
										// Iterate X times, incrementing Phase each time
										phaseNo = 1;
										for each  phz in thisapp.forLoop(1,iterationCount)
										{
											lotsperPhase = ceil(input.Lots / input.Phases);
											engStart = null;
											engEnd = null;
											constStart = null;
											constEnd = null;
											lotclosingLength = 0;
											totalLotsPhase = 0;
											if(phaseNo == 1)
											{
												engStart = input.Engineering_Delay_Months + 1;
												engEnd = input.Engineering_Delay_Months + input.Engineering_Length_Months;
												constStart = input.Construction_Start_Month + 1;
												constEnd = input.Construction_Start_Month + input.Construction_Length.toNumber();
												lotclosingLength = ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + 1;
											}
											if(phaseNo != 1)
											{
												constStart = lotStart - input.Construction_Length.toNumber();
												constEnd = lotStart - 1;
												engStart = lotStart - input.Construction_Length.toNumber() - input.Construction_Start_Month + input.Engineering_Delay_Months;
												engEnd = lotStart - input.Construction_Length.toNumber() - input.Construction_Start_Month + input.Engineering_Delay_Months + input.Engineering_Length_Months - 1;
												lotclosingLength = ceil((input.Lots / input.Phases) / input.Lots_per_Month);
											}
											//Final Phase check -- double check that its not 1 phase project
											if(phaseNo == input.Phases && input.Phases != 1)
											{
												totalLotsPhase = lotsRemaining;
												lotclosingLength = ceil(lotsRemaining / input.Lots_per_Month);
											}
											else
											{
												totalLotsPhase = lotsperPhase;
											}
											lotSaleStart = lotStart;
											lotSaleEnd = lotStart + lotclosingLength - 1;
											// Create a Phase record instead of a subform row
											newPhase = insert into Proforma_Phase
											[
												Pro_Forma=input.ID
												Phase=phaseNo
												Acres=input.Total_Acres / input.Phases
												Eng_Start_Month=engStart
												Eng_End_Month=engEnd
												Const_Start_Month=constStart
												Const_End_Month=constEnd
												Total_Lots=totalLotsPhase
												Lot_Sale_Start_Month=lotSaleStart
												Lot_Closing_Length=lotclosingLength
												Lot_Sale_End_Month=lotSaleEnd
												Added_User=zoho.loginuser
											];
											lotStart = lotStart + lotclosingLength;
											phaseNo = phaseNo + 1;
											lotsRemaining = lotsRemaining - lotsperPhase;
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//CREATE MONTHS
										// OPTIONAL: clear existing Proforma_Months for this Pro Forma 
										delete from Proforma_Months[Proforma == input.ID];
										// How many months we're generating: use the last phase's Lot_Sale_End_Month
										endMo = 0;
										lastPhase = Proforma_Phase[Pro_Forma == input.ID && Phase == input.Phases];
										mudpidInstall = Land_Installments[Pro_Forma_PID_MUD == input.ID].maximum(Month1);
										if(lastPhase != null)
										{
											endMo = lastPhase.Lot_Sale_End_Month;
										}
										if(mudpidInstall > endMo)
										{
											endMo = mudpidInstall;
										}
										if(endMo == null || endMo <= 0)
										{
											return;
										}
										// Your helper that returns [1,2,3,...,endMo]
										listPads2 = thisapp.forLoop(1,endMo);
										info listPads2.size();
										// We'll walk monthNo manually
										monthNo = 1;
										for each  dummy in listPads2
										{
											rowDate = input.Estimated_Purchase_Date.addMonth(monthNo - 1);
											// --- MATCHES FOR THIS MONTH ---
											constMatches = Proforma_Phase[Pro_Forma == input.ID && Const_Start_Month <= monthNo && Const_End_Month >= monthNo];
											engMatches = Proforma_Phase[Pro_Forma == input.ID && Eng_Start_Month <= monthNo && Eng_End_Month >= monthNo];
											// Grab up to 2 Const phases for this month
											constPhase1 = null;
											constPhase2 = null;
											cIndex = 0;
											for each  cRec in constMatches
											{
												if(cIndex == 0)
												{
													constPhase1 = cRec.Phase;
												}
												else if(cIndex == 1)
												{
													constPhase2 = cRec.Phase;
												}
												cIndex = cIndex + 1;
												if(cIndex >= 2)
												{
													break;
												}
											}
											// Grab up to 2 Eng phases for this month
											engPhase1 = null;
											engPhase2 = null;
											eIndex = 0;
											for each  eRec in engMatches
											{
												if(eIndex == 0)
												{
													engPhase1 = eRec.Phase;
												}
												else if(eIndex == 1)
												{
													engPhase2 = eRec.Phase;
												}
												eIndex = eIndex + 1;
												if(eIndex >= 2)
												{
													break;
												}
											}
											// --- ROW INSERT LOGIC ---
											if(constPhase1 == null && engPhase1 == null)
											{
												// No Const or Eng this month -> single blank row
												insert into Proforma_Months
												[
													Proforma=input.ID
													Date1=rowDate
													Month1=monthNo
													Master_Month=TRUE
													Added_User=zoho.loginuser
												]
											}
											else
											{
												// ROW 1: pair first Const + first Eng (can be null, that's fine)
												insert into Proforma_Months
												[
													Proforma=input.ID
													Date1=rowDate
													Month1=monthNo
													Const_Phase=constPhase1
													Eng_Phase=engPhase1
													Master_Month=TRUE
													Added_User=zoho.loginuser
												]
												// ROW 2: only if there is a 2nd Const or Eng phase
												if(constPhase2 != null || engPhase2 != null)
												{
													insert into Proforma_Months
													[
														Proforma=input.ID
														Date1=rowDate
														Month1=monthNo
														Const_Phase=constPhase2
														Eng_Phase=engPhase2
														Master_Month=FALSE
														Added_User=zoho.loginuser
													]
												}
											}
											// Next month
											monthNo = monthNo + 1;
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											// FILL LOT SALES
										lotsRemaining = 0;
										maxMonth = 0;
										// --- 2) Build unique Month1 list and loop over month numbers (not rows) ---
										mnthsList = Proforma_Months[Proforma == input.ID].Month1.getAll();
										unqMonths = mnthsList.distinct().size();
										loop = thisapp.forLoop(1,unqMonths);
										// This will walk monthNo = 1..unqMonths and ONLY touch the first row for each month
										monthNo = 1;
										for each  el in loop
										{
											// Only use the FIRST Proforma_Months record for this monthNo
											mnth = Proforma_Months[Proforma == input.ID && Month1 == monthNo];
											if(mnth != null)
											{
												// Sale phase that covers this month
												lotPhase = Proforma_Phase[Pro_Forma == input.ID && Lot_Sale_Start_Month <= monthNo && Lot_Sale_End_Month >= monthNo];
												if(lotPhase != null)
												{
													mnth.Lot_Sale_Phase=lotPhase.Phase;
													// ---- first month of phase 1: apply initial takedown ----
													if(lotPhase.Phase == 1 && monthNo == lotPhase.Lot_Sale_Start_Month)
													{
														phaseLots = ifNull(lotPhase.Total_Lots,0);
														lotsRemaining = phaseLots - ifNull(input.Initial_Takedown,0);
														mnth.Lots_Sold=input.Initial_Takedown;
													}
													// ---- first month of non-phase 1: initialize remaining lots ----
													if(lotPhase.Phase != 1 && monthNo == lotPhase.Lot_Sale_Start_Month)
													{
														phaseLots = ifNull(lotPhase.Total_Lots,0);
														lotsRemaining = phaseLots;
													}
													// ---- middle months: full Lots_per_Month (phase 1) ----
													if(monthNo > lotPhase.Lot_Sale_Start_Month && monthNo < lotPhase.Lot_Sale_End_Month && lotsRemaining > input.Lots_per_Month && lotPhase.Phase == 1)
													{
														mnth.Lots_Sold=input.Lots_per_Month;
														lotsRemaining = lotsRemaining - input.Lots_per_Month;
													}
													// ---- middle months: full Lots_per_Month (other phases) ----
													if(monthNo >= lotPhase.Lot_Sale_Start_Month && monthNo < lotPhase.Lot_Sale_End_Month && lotsRemaining > input.Lots_per_Month && lotPhase.Phase != 1)
													{
														mnth.Lots_Sold=input.Lots_per_Month;
														lotsRemaining = lotsRemaining - input.Lots_per_Month;
													}
													// ---- last month of range: sell the remainder if <= Lots_per_Month ----
													if(monthNo > lotPhase.Lot_Sale_Start_Month && monthNo == lotPhase.Lot_Sale_End_Month && lotsRemaining <= input.Lots_per_Month)
													{
														mnth.Lots_Sold=lotsRemaining;
														lotsRemaining = 0;
													}
													// Finished Lot Sales only on this single "primary" row for the month
													finishedSaleamt = ifNull(mnth.Lots_Sold,0) * input.Sale_Price_FF * input.Lot_Size_Ft;
													if(finishedSaleamt > 0)
													{
														mnth.Finished_Lot_Sales=finishedSaleamt;
													}
												}
											}
											// Next project month number
											monthNo = monthNo + 1;
										}
										info "Lot Sales successful";
						)
					}
					actions 
					{
						custom deluge script
						(
											// FILL OUT ENG COST + OVERHEAD
										// getUrl("https://postman-echo.com/delay/12");
										startMo = 1;
										addlCosts = Proforma_Item[(Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Engineering") || (Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Development") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Engineering") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Category != "Reimbursements" && Department == "Development")];
										// Include:
										// - Engineering phase rows
										// - Construction phase rows
										// - Master month rows so Specific Months costs can be applied exactly once
										mnths = Proforma_Months[(Proforma == input.ID && Eng_Phase != null) || (Proforma == input.ID && Const_Phase != null) || (Proforma == input.ID && Master_Month == true)] sort by Date1;
										// Preload phase information
										phaseEngEnd = Map();
										phaseEngLots = Map();
										phaseConstStart = Map();
										phaseConstEnd = Map();
										allPhases = Proforma_Phase[Pro_Forma == input.ID];
										for each  phz in allPhases
										{
											if(phz.Phase != null)
											{
												phaseKey = phz.Phase.toString();
												if(phz.Eng_End_Month != null)
												{
													phaseEngEnd.put(phaseKey,phz.Eng_End_Month.toLong());
												}
												if(phz.Total_Lots != null)
												{
													phaseEngLots.put(phaseKey,phz.Total_Lots);
												}
												if(phz.Const_Start_Month != null)
												{
													phaseConstStart.put(phaseKey,phz.Const_Start_Month.toLong());
												}
												if(phz.Const_End_Month != null)
												{
													phaseConstEnd.put(phaseKey,phz.Const_End_Month.toLong());
												}
											}
										}
										/************************************************************
										 * Pre-parse Specific Months selections once per item.
										 *
										 * selMonths contains text values because Deluge List.contains()
										 * requires the searched value to have the same data type.
										 ************************************************************/
										specMonthsByItem = Map();
										specDenomByItem = Map();
										for each  cost in addlCosts
										{
											if(cost.Cost_Application == "Specific Months")
											{
												selMonths = List();
												raw = ifnull(cost.Specific_Months_List,"").toString().trim();
												usedList = false;
												if(raw != "")
												{
													usedList = true;
													for each  tok in raw.toList(",")
													{
														t = tok.trim();
														if(t != "")
														{
															n = t.toLong();
															if(n > 0)
															{
																monthText = n.toString();
																if(selMonths.contains(monthText) == false)
																{
																	selMonths.add(monthText);
																}
															}
														}
													}
												}
												// Legacy fallback using Start_Month and End_Month
												if(usedList == false)
												{
													if(cost.Start_Month != null && cost.End_Month != null)
													{
														sm = cost.Start_Month.toLong();
														em = cost.End_Month.toLong();
														if(sm > 0 && em >= sm)
														{
															legacyMnths = Proforma_Months[Proforma == input.ID && Master_Month == true];
															for each  lm in legacyMnths
															{
																if(lm.Month1 != null)
																{
																	lmNo = lm.Month1.toLong();
																	if(lmNo >= sm && lmNo <= em)
																	{
																		lmText = lmNo.toString();
																		if(selMonths.contains(lmText) == false)
																		{
																			selMonths.add(lmText);
																		}
																	}
																}
															}
														}
													}
												}
												if(selMonths.size() > 0)
												{
													costKey = cost.ID.toString();
													specMonthsByItem.put(costKey,selMonths);
													specDenomByItem.put(costKey,selMonths.size());
												}
											}
										}
										for each  month in mnths
										{
											engPhaseNo = month.Eng_Phase;
											constPhaseNo = month.Const_Phase;
											addlCost = 0;
											engonlyaddlCost = 0;
											for each  cost in addlCosts
											{
												/***********************
												 * ENGINEERING MONTH LOGIC
												 ***********************/
												if(engPhaseNo != null)
												{
													// ACROSS PHASES:
													// Spread across every engineering month within the phase range
													if(cost.Cost_Application == "Across Phases" && cost.Start_Phase <= engPhaseNo && cost.End_Phase >= engPhaseNo)
													{
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Engineering_Length_Months.toLong();
														addlCost = addlCost + cost.Add_l_Cost / costSpread;
														if(cost.Department == "Engineering")
														{
															engonlyaddlCost = engonlyaddlCost + cost.Add_l_Cost / costSpread;
														}
													}
													// ENGINEERING END:
													// Apply once in the engineering end month for each applicable phase
													if(cost.Cost_Application == "Engineering End" && cost.Start_Phase <= engPhaseNo && cost.End_Phase >= engPhaseNo)
													{
														engEndMo = phaseEngEnd.get(engPhaseNo.toString());
														if(engEndMo != null && month.Month1 != null && month.Month1.toLong() == engEndMo)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															addlCost = addlCost + phaseCost;
															if(cost.Department == "Engineering")
															{
																engonlyaddlCost = engonlyaddlCost + phaseCost;
															}
														}
													}
												}
												/***********************
												 * CONSTRUCTION START LOGIC
												 ***********************/
												if(constPhaseNo != null)
												{
													// Apply once in the construction start month for each applicable phase
													if(cost.Cost_Application == "Construction Start" && cost.Start_Phase <= constPhaseNo && cost.End_Phase >= constPhaseNo)
													{
														constStartMo = phaseConstStart.get(constPhaseNo.toString());
														if(constStartMo != null && month.Month1 != null && month.Month1.toLong() == constStartMo)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															addlCost = addlCost + phaseCost;
															if(cost.Department == "Engineering")
															{
																engonlyaddlCost = engonlyaddlCost + phaseCost;
															}
														}
													}
												}
												/***********************
												 * CONSTRUCTION END LOGIC
												 ***********************/
												if(constPhaseNo != null)
												{
													// Apply once in the construction end month for each applicable phase
													if(cost.Cost_Application == "Construction End" && cost.Start_Phase <= constPhaseNo && cost.End_Phase >= constPhaseNo)
													{
														constEndMo = phaseConstEnd.get(constPhaseNo.toString());
														if(constEndMo != null && month.Month1 != null && month.Month1.toLong() == constEndMo)
														{
															numPhases = cost.End_Phase - cost.Start_Phase + 1;
															phaseCost = cost.Add_l_Cost / numPhases;
															addlCost = addlCost + phaseCost;
															if(cost.Department == "Engineering")
															{
																engonlyaddlCost = engonlyaddlCost + phaseCost;
															}
														}
													}
												}
												/************************************************************
												 * SPECIFIC MONTHS LOGIC
												 *
												 * Apply only to the Master_Month record.
												 *
												 * This prevents the same calendar-month installment from
												 * being duplicated when multiple engineering/construction
												 * phase rows exist for the same Month1.
												 ************************************************************/
												if(cost.Cost_Application == "Specific Months")
												{
													if(month.Master_Month == true)
													{
														costKey = cost.ID.toString();
														selMonths = specMonthsByItem.get(costKey);
														if(selMonths != null)
														{
															denom = specDenomByItem.get(costKey);
															if(denom != null && denom > 0)
															{
																if(month.Month1 != null)
																{
																	monthText = month.Month1.toLong().toString();
																	if(selMonths.contains(monthText))
																	{
																		specificMonthCost = cost.Add_l_Cost / denom;
																		addlCost = addlCost + specificMonthCost;
																		if(cost.Department == "Engineering")
																		{
																			engonlyaddlCost = engonlyaddlCost + specificMonthCost;
																		}
																	}
																}
															}
														}
													}
												}
											}
											// Only write base engineering cost on engineering phase rows
											if(engPhaseNo != null)
											{
												engLots = phaseEngLots.get(engPhaseNo.toString());
												if(engLots != null)
												{
													month.Entitlement_Engineering=(input.Engineering_Cost_Lot * engLots / input.Engineering_Length_Months).round(2);
												}
											}
											// Write additional cost for any applicable engineering,
											// construction, or master-month record
											month.Entitlement_Engineering_Addl=addlCost.round(2);
											/************************************************************
											 * Engineering Overhead
											 *
											 * Includes:
											 * - Base engineering cost
											 * - Engineering-department additional cost
											 *
											 * Development-department additional costs remain included in
											 * Entitlement_Engineering_Addl but do not receive Engineering
											 * Overhead.
											 ************************************************************/
											baseEngForOH = 0;
											if(ifnull(month.Entitlement_Engineering,0) != 0)
											{
												baseEngForOH = baseEngForOH + month.Entitlement_Engineering;
											}
											if(ifnull(engonlyaddlCost,0) != 0)
											{
												baseEngForOH = baseEngForOH + engonlyaddlCost;
											}
											if(input.Engineering_Overhead != null)
											{
												month.Engineering_Overhead=(baseEngForOH * ifnull(input.Engineering_Overhead,0) / 100).round(0);
											}
										}
										info "Eng cost successful";
						)
					}
					actions 
					{
						custom deluge script
						(
											// FILL OUT CONST COST + OVERHEAD ON MONTHS (Deluge-safe)
										input.Est_Lots_per_Acre = input.Lots / input.Total_Acres;
										input.Ft_St_per_Lot = input.Total_Street_LF / input.Lots;
										addlCosts = Proforma_Item[(Pro_Forma_Const == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Department == "Construction") || (Pro_Forma_Dev == input.ID && Add_l_Cost != null && Add_l_Cost != 0 && Department == "Construction")];
										baseCost = ifnull(input.Ft_St_per_Lot,0) * ifnull(input.Const_Cost_FF,0);
										mnths = Proforma_Months[Proforma == input.ID && Const_Phase != null] sort by Const_Phase,Date1;
										// Preload phase → Total_Lots
										phaseLots = Map();
										for each  ph in Proforma_Phase[Pro_Forma == input.ID]
										{
											phaseLots.put(ph.Phase,ifnull(ph.Total_Lots,0));
										}
										// Preload curve percents ordered by Month_Number
										curvePercents = List();
										for each  c in Construction_Curve[Pro_Forma == input.ID] sort by Month_Number
										{
											curvePercents.add(ifnull(c.Percent_Cost,0));
										}
										curveSize = curvePercents.size().toLong();
										idx = 0;
										// Apply costs per month (minimal loop body, no ternary)
										for each  month in mnths
										{
											addlCost = 0;
											for each  cost in addlCosts
											{
												if(cost.Start_Phase <= month.Const_Phase && cost.End_Phase >= month.Const_Phase)
												{
													//count number of phases
													numPhases = cost.End_Phase - cost.Start_Phase + 1;
													costSpread = numPhases * input.Construction_Length.toLong();
													addlCost = addlCost + cost.Add_l_Cost / numPhases;
												}
											}
											lots = ifnull(phaseLots.get(month.Const_Phase),0);
											pct = 0;
											if(curveSize > 0)
											{
												pct = ifnull(curvePercents.get(idx),0);
											}
											//info lots.toString() + " - " + baseCost.toString() + " - " + pct.toString();
											month.Construction_Cost_Base=(lots * baseCost * pct / 100).round(2);
											month.Construction_Cost_Addl=addlCost * pct / 100;
											if(input.Construction_Overhead != null)
											{
												month.Construction_Overhead=(lots * baseCost * pct / 100 + addlCost * pct / 100) * input.Construction_Overhead / 100;
											}
											idx = idx + 1;
											if(idx >= curveSize)
											{
												idx = 0;
											}
										}
										info "Const cost successful";
						)
					}
					actions 
					{
						custom deluge script
						(
											// REIMBURSEMENTS (NON IMPACT FEES) USING COST_APPLICATION LOGIC
										reimbList = Proforma_Item[(Pro_Forma_Const == input.ID && Category == "Reimbursements" && Add_l_Cost != null && Add_l_Cost != 0) || (Pro_Forma_Dev == input.ID && Category == "Reimbursements" && Add_l_Cost != null && Add_l_Cost != 0)];
										mnths = Proforma_Months[(Proforma == input.ID && Eng_Phase != null) || (Proforma == input.ID && Const_Phase != null)] sort by Date1;
										phaseEngEnd = Map();
										phaseConstStart = Map();
										phaseConstEnd = Map();
										allPhases = Proforma_Phase[Pro_Forma == input.ID];
										for each  phz in allPhases
										{
											if(phz.Phase != null)
											{
												if(phz.Eng_End_Month != null)
												{
													phaseEngEnd.put(phz.Phase.toString(),phz.Eng_End_Month.toLong());
												}
												if(phz.Const_Start_Month != null)
												{
													phaseConstStart.put(phz.Phase.toString(),phz.Const_Start_Month.toLong());
												}
												if(phz.Const_End_Month != null)
												{
													phaseConstEnd.put(phz.Phase.toString(),phz.Const_End_Month.toLong());
												}
											}
										}
										hasSpecific = false;
										for each  chk in reimbList
										{
											if(chk.Cost_Application == "Specific Months" && chk.Item_Name.contains("Impact Fees") == false)
											{
												hasSpecific = true;
											}
										}
										if(reimbList.count() > 0)
										{
											for each  month in mnths
											{
												engPhaseNo = month.Eng_Phase;
												constPhaseNo = month.Const_Phase;
												reimbAddl = 0;
												for each  reimb in reimbList
												{
													if(reimb.Item_Name.contains("Impact Fees") == false)
													{
														/***********************
														 * ENGINEERING MONTH LOGIC
														 ***********************/
														if(engPhaseNo != null)
														{
															// ACROSS PHASES: spread across ALL ENG months in phases range
															if(reimb.Cost_Application == "Across Phases" && reimb.Start_Phase <= engPhaseNo && reimb.End_Phase >= engPhaseNo)
															{
																numPhases = reimb.End_Phase - reimb.Start_Phase + 1;
																costSpread = numPhases * input.Engineering_Length_Months.toLong();
																reimbAddl = reimbAddl + reimb.Add_l_Cost / costSpread;
															}
															// ENGINEERING END: drop once in the ENG end month for that phase
															if(reimb.Cost_Application == "Engineering End" && reimb.Start_Phase <= engPhaseNo && reimb.End_Phase >= engPhaseNo)
															{
																endMo = phaseEngEnd.get(engPhaseNo.toString());
																if(endMo != null && month.Month1 != null && month.Month1.toLong() == endMo)
																{
																	numPhases = reimb.End_Phase - reimb.Start_Phase + 1;
																	reimbAddl = reimbAddl + reimb.Add_l_Cost / numPhases;
																}
															}
														}
														/***********************
														 * CONSTRUCTION MONTH LOGIC
														 ***********************/
														if(constPhaseNo != null)
														{
															// CONSTRUCTION START: drop once in the CONST start month for that phase
															if(reimb.Cost_Application == "Construction Start" && reimb.Start_Phase <= constPhaseNo && reimb.End_Phase >= constPhaseNo)
															{
																startMo = phaseConstStart.get(constPhaseNo.toString());
																if(startMo != null && month.Month1 != null && month.Month1.toLong() == startMo)
																{
																	numPhases = reimb.End_Phase - reimb.Start_Phase + 1;
																	reimbAddl = reimbAddl + reimb.Add_l_Cost / numPhases;
																}
															}
															// CONSTRUCTION END: drop once in the CONST end month for that phase
															if(reimb.Cost_Application == "Construction End" && reimb.Start_Phase <= constPhaseNo && reimb.End_Phase >= constPhaseNo)
															{
																endMoC = phaseConstEnd.get(constPhaseNo.toString());
																if(endMoC != null && month.Month1 != null && month.Month1.toLong() == endMoC)
																{
																	numPhases = reimb.End_Phase - reimb.Start_Phase + 1;
																	reimbAddl = reimbAddl + reimb.Add_l_Cost / numPhases;
																}
															}
														}
													}
												}
												month.Reimbursements=reimbAddl;
											}
										}
										/***********************
										 * SPECIFIC MONTHS LOGIC — master months only, so months with no
										 * eng/const phase (e.g. land-cost-only months) can still receive it.
										 * Months come from Specific_Months_List (CSV, e.g. "5,12,18").
										 * Falls back to Start_Month..End_Month range for legacy records.
										 * NOTE: selMonths holds TEXT — Deluge's List.contains() requires TEXT.
										 ***********************/
										if(hasSpecific)
										{
											specMonthsByItem = Map();
											specDenomByItem = Map();
											for each  reimb in reimbList
											{
												if(reimb.Item_Name.contains("Impact Fees") == false && reimb.Cost_Application == "Specific Months")
												{
													selMonths = List();
													raw = ifnull(reimb.Specific_Months_List,"").toString().trim();
													usedList = false;
													if(raw != "")
													{
														usedList = true;
														for each  tok in raw.toList(",")
														{
															t = tok.trim();
															if(t != "")
															{
																n = t.toLong();
																if(n > 0)
																{
																	if(selMonths.contains(n.toString()) == false)
																	{
																		selMonths.add(n.toString());
																	}
																}
															}
														}
													}
													if(usedList == false)
													{
														if(reimb.Start_Month != null && reimb.End_Month != null)
														{
															sm = reimb.Start_Month.toLong();
															em = reimb.End_Month.toLong();
															if(sm > 0 && em >= sm)
															{
																legacyMnths = Proforma_Months[Proforma == input.ID && Master_Month == true];
																for each  lm in legacyMnths
																{
																	if(lm.Month1 != null)
																	{
																		lmNo = lm.Month1.toLong();
																		if(lmNo >= sm && lmNo <= em)
																		{
																			if(selMonths.contains(lmNo.toString()) == false)
																			{
																				selMonths.add(lmNo.toString());
																			}
																		}
																	}
																}
															}
														}
													}
													if(selMonths.size() > 0)
													{
														specMonthsByItem.put(reimb.ID.toString(),selMonths);
														specDenomByItem.put(reimb.ID.toString(),selMonths.size());
													}
												}
											}
											masterMnths = Proforma_Months[Proforma == input.ID && Master_Month == true] sort by Date1;
											for each  mmonth in masterMnths
											{
												specAdd = 0;
												for each  reimb in reimbList
												{
													if(reimb.Item_Name.contains("Impact Fees") == false && reimb.Cost_Application == "Specific Months")
													{
														selMonths = specMonthsByItem.get(reimb.ID.toString());
														if(selMonths != null)
														{
															denom = specDenomByItem.get(reimb.ID.toString());
															if(denom != null && denom > 0)
															{
																if(mmonth.Month1 != null && selMonths.contains(mmonth.Month1.toLong().toString()))
																{
																	specAdd = specAdd + reimb.Add_l_Cost / denom;
																}
															}
														}
													}
												}
												if(specAdd > 0)
												{
													mmonth.Reimbursements=ifnull(mmonth.Reimbursements,0) + specAdd;
												}
											}
										}
										info "Reimbursements (non impact fees) successful";
						)
					}
					actions 
					{
						custom deluge script
						(
											//REIMBURSED FEES (IMPACT FEES) + OVERHEAD COST SPREAD EVENLY OVER ANY MONTH WITH LOT SALES
										impFees = Proforma_Item[Pro_Forma_Const == input.ID || Pro_Forma_Dev == input.ID && Category = "Reimbursements" && Item_Name.contains("Impact Fees")].sum(Add_l_Cost);
										for each  pfMonth in Proforma_Months[Proforma == input.ID && Lot_Sale_Phase != null && Lots_Sold > 0]
										{
											pfMonth.Reimbursed_Fees=impFees / input.Lots * pfMonth.Lots_Sold;
