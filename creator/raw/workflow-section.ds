			Set_Purchase_Date_Lots1 as "Set Purchase Date - Lots"
			{
				type =  form
				form = Lots

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											purchdateText = input.Purch_Date_Text;
										if(purchdateText.isDate() = TRUE && purchdateText.length() = 10)
										{
											input.Purchase_Date = input.Purch_Date_Text;
										}
										else if(purchdateText = "")
										{
											input.Purchase_Date = null;
										}
										else
										{
											alert "Please enter a valid date formated MM/dd/YYYY.";
											cancel submit;
										}
						)
					}
				}

			}
