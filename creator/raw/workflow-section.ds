			Installment_Month_Check_P as "Installment Month Check - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Land_Purchase_Installments.Month1
				{
					actions 
					{
						custom deluge script
						(
											lotsperPhase = ceil(input.Lots / input.Phases);
										lastPhaseLots = input.Lots - lotsperPhase * (input.Phases - 1);
										len1 = ceil((lotsperPhase - ifnull(input.Initial_Takedown,0)) / ifnull(input.Lots_per_Month,1)) + 1;
										lenMid = ceil(lotsperPhase / ifnull(input.Lots_per_Month,1));
										lenLast = ceil(lastPhaseLots / ifnull(input.Lots_per_Month,1));
										estFinalLotSaleEnd = input.Takedown_Start_Month + len1 + lenMid * (input.Phases - 2) + lenLast - 1;
										if(row.Month1 > estFinalLotSaleEnd)
										{
											alert "Installment month must fall within the project range. \n" + "(1 - " + estFinalLotSaleEnd + " months)";
										}
						)
					}
				}

			}
