			Ensure_Sequential_Approva as "Ensure Sequential Approval - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											//this code enforces that Approval Sequences start at 1 and must increase by 1 each step without gaps
										//Approval emails depend on approval flow being sequential (ie 1,2,3) - gap would cause approval flow to stall
										startSequence = 0;
										disApprovals = input.Approvals1.distinct(Approval_Sequence);
										countDisapproval = disApprovals.size();
										//loop X number of times where X is equal to the number of distinct Approval Sequences there are 
										for each index x in disApprovals
										{
											//Check for an Approval Sequence of 1 and iterate + 1 for every loop
											startSequence = startSequence + 1;
											//if there is not an Approval with a sequence of "1"  then cancel submit and throw alert
											if(disApprovals.contains(startSequence) = false)
											{
												alert "Approvals must be in sequential order starting from 1.";
												cancel submit;
											}
										}
						)
					}
				}

			}
