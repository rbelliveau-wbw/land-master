			Check_if_Exceed_Available as "Check if Exceed Available Lots - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											totalFclotcount = 0;
										availLots = Lots[Subdivision == input.Subdivision1 && Purchase_Date == null].count(Lot_Code);
										firstThismonth = zoho.currentdate.toStartOfMonth();
										for each  fc in input.Forecast_Months
										{
											if(fc.Forecasted_Lots != null && fc.Forecast_Start_Date >= firstThismonth)
											{
												fcLotcount = fc.Forecasted_Lots;
												totalFclotcount = totalFclotcount + fcLotcount;
											}
										}
										if(totalFclotcount > availLots)
										{
											alert "Forecasted lots for current and future months (" + totalFclotcount + ") currently exceed number of available lots (" + availLots + ") in " + input.Subdivision1.Subdivision_Name + ". \n  \n Press OK to proceed.";
										}
						)
					}
				}

			}
			Search_Type_Contracts_Mgm as "Search Type - Contracts Mgmt"
			{
				type =  form
				form = Contracts_Management_Search

				record event = on add or edit

				on user input of Type1
				{
					actions 
					{
						custom deluge script
						(
											lotBuyer = "";
										lotBuilder = "";
										contType = "";
										lotStatus = "";
										lotCity = "";
										lotCounty = "";
										subdivName = "";
										subdivName2 = "";
										subdivName3 = "";
										basePrice = "";
										lotNo = "";
										block = "";
										monthName = "";
										monthNum = "";
										monthSearch = "";
										specDate = "";
										monthQuery = "";
										reportName1 = "All_Contracts_v2?";
										reportName2 = "All_Contracts?";
										reportName3 = "All_Takedown_Schedules?";
										if(input.Builder1.isEmpty() = false)
										{
											lotBuyer = "&&Builder1=[" + Builder[ID == input.Builder1].Builder_Name.getAll() + "]";
											lotBuilder = "&&Builder=[" + Builder[ID == input.Builder1].Builder_Name.getAll() + "]";
											info lotBuilder;
										}
										if(input.Status.isEmpty() = false)
										{
											lotStatus = "&&Status=[" + input.Status + "]";
										}
										if(input.Block.isEmpty() = false)
										{
											block = "&&Block=[" + input.Block + "]";
										}
										if(input.Subdivision.isEmpty() = false)
										{
											subdivName = "&&Subdivision=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
											subdivName2 = "&&Subdivision1=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
											subdivName3 = "&&Subdivisions=[" + Subdivision[ID == input.Subdivision].Subdivision_Name.getAll() + "]";
										}
										if(input.Type1.isEmpty() = false)
										{
											contType = "&&Contract_Type=[" + input.Type1 + "]";
										}
										lotsUrl1 = zoho.appuri + "view-embed/" + reportName1;
										lotsUrl2 = zoho.appuri + "view-embed/" + reportName2;
										lotsUrl3 = zoho.appuri + "view-embed/" + reportName3;
										queryUrl1 = lotsUrl1 + contType + lotBuilder + subdivName2;
										queryUrl2 = lotsUrl2 + contType + lotBuilder + subdivName2;
										queryUrl3 = lotsUrl3 + lotBuyer + subdivName3;
										openUrl(queryUrl1,"iframe","frame16");
										openUrl(queryUrl2,"iframe","frame09");
										//openUrl(queryUrl3,"iframe","frame10");
						)
					}
				}

			}
