			Mass_Update_Lots_Mass_Upd as "Mass Update Lots - Mass Update"
			{
				type =  form
				form = Mass_Update_Lots

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  lot in input.Lots_to_Update
										{
											if(input.Builder1 != null)
											{
												lot.Builder1=input.Builder1;
											}
											if(input.Fee_Type != null)
											{
												lot.Fee_Type=input.Fee_Type;
											}
											if(input.Escalator_Start_Date != null)
											{
												lot.Escalator_Start_Date=input.Escalator_Start_Date;
											}
											if(input.Prime_1 == "TRUE")
											{
												lot.Prime_1=TRUE;
											}
											if(input.Prime_1 == "FALSE")
											{
												lot.Prime_1=FALSE;
											}
											if(input.Base_Price != null)
											{
												lot.Base_Price=input.Base_Price;
											}
											if(input.Appraised_Value != null)
											{
												lot.Appraised_Value=input.Appraised_Value;
											}
											if(input.Escalator != null)
											{
												lot.Escalator=input.Escalator;
											}
											if(input.Additional_Fees != null)
											{
												lot.Additional_Fees=input.Additional_Fees;
											}
											if(input.Earnest_Money != null)
											{
												lot.Earnest_Money=input.Earnest_Money;
											}
											if(input.Lot_Size != null)
											{
												lot.Lot_Size=input.Lot_Size;
											}
											if(input.Addl_Tax != null)
											{
												lot.Additional_Tax=input.Addl_Tax;
											}
										}
										//openUrl("#Script:page.parent.refresh ","parent window");
						)
					}
				}

			}
