			Search_Forecasts_FC_Manag as "Search Forecasts - FC Manager"
			{
				type =  form
				form = Forecast_Manager

				record event = on add or edit

				on user input of Search
				{
					actions 
					{
						custom deluge script
						(
											hasSubdivisions = input.Subdivisions != null;
										hasBuilders = input.Builders != null && !input.Builders.isEmpty();
										hasWFY = input.WFY != null && !input.WFY.isEmpty();
										useAllBuilders = input.All_Builders == true;
										useAllYears = input.All_Years == true;
										// Alert logic:
										// Subdivisions is always required
										// Builders is only required if All_Builders is not checked
										// WFY is only required if All_Years is not checked
										if(!hasSubdivisions || (!useAllBuilders && !hasBuilders) || (!useAllYears && !hasWFY))
										{
											alert "Please fill in Subdivision" + if(!useAllBuilders,", Builder","") + if(!useAllYears,", and WFY",".");
										}
										else
										{
											if(useAllBuilders && useAllYears)
											{
												fyRows = Forecast_Year[Subdivision1 == input.Subdivisions && Status == "Builder"];
											}
											else if(useAllBuilders && !useAllYears)
											{
												fyRows = Forecast_Year[Subdivision1 == input.Subdivisions && Forecast_Year in input.WFY && Status == "Builder"];
											}
											else if(!useAllBuilders && useAllYears)
											{
												fyRows = Forecast_Year[Subdivision1 == input.Subdivisions && Builder1 in input.Builders && Status == "Builder"];
											}
											else
											{
												fyRows = Forecast_Year[Subdivision1 == input.Subdivisions && Builder1 in input.Builders && Forecast_Year in input.WFY && Status == "Builder"];
											}
											// Sort Forecast_Year first, then Builder
											sortKeys = List();
											fyIdByKey = Map();
											for each  fy in fyRows
											{
												yearKey = ifnull(fy.Forecast_Year,"").toString();
												if(yearKey.length() < 4)
												{
													yearKey = leftpad(yearKey,4).replaceAll(" ","0");
												}
												builderKey = "";
												if(fy.Builder1 != null)
												{
													builderKey = fy.Builder1.toString().toLowerCase();
												}
												sortKey = yearKey + "||" + builderKey + "||" + fy.ID.toString();
												sortKeys.add(sortKey);
												fyIdByKey.put(sortKey,fy.ID);
											}
											sortKeys.sort(true);
											input.Forecasts.clear();
											for each  sortKey in sortKeys
											{
												fyId = fyIdByKey.get(sortKey);
												fyRec = Forecast_Year[ID == fyId];
												row = Forecast_Manager.Forecasts();
												row.Subdivision1=fyRec.Subdivision1;
												row.Builder1=fyRec.Builder1;
												row.WFY=fyRec.Forecast_Year;
												for each  fc in Forecast[Forecast_Year2 == fyId]
												{
													monthVal = ifnull(fc.Forecast_Month,"").toString().toUpperCase();
													if(monthVal == "JAN" || monthVal == "JANUARY")
													{
														row.JAN_LOTS=fc.Forecasted_Lots;
														row.JANID=fc.ID;
													}
													else if(monthVal == "FEB" || monthVal == "FEBRUARY")
													{
														row.FEB_LOTS=fc.Forecasted_Lots;
														row.FEBID=fc.ID;
													}
													else if(monthVal == "MAR" || monthVal == "MARCH")
													{
														row.MAR_LOTS=fc.Forecasted_Lots;
														row.MARID=fc.ID;
													}
													else if(monthVal == "APR" || monthVal == "APRIL")
													{
														row.APR_LOTS=fc.Forecasted_Lots;
														row.APRID=fc.ID;
													}
													else if(monthVal == "MAY")
													{
														row.MAY_LOTS=fc.Forecasted_Lots;
														row.MAYID=fc.ID;
													}
													else if(monthVal == "JUN" || monthVal == "JUNE")
													{
														row.JUN_LOTS=fc.Forecasted_Lots;
														row.JUNID=fc.ID;
													}
													else if(monthVal == "JUL" || monthVal == "JULY")
													{
														row.JUL_LOTS=fc.Forecasted_Lots;
														row.JULID=fc.ID;
													}
													else if(monthVal == "AUG" || monthVal == "AUGUST")
													{
														row.AUG_LOTS=fc.Forecasted_Lots;
														row.AUGID=fc.ID;
													}
													else if(monthVal == "SEP" || monthVal == "SEPTEMBER")
													{
														row.SEP_LOTS=fc.Forecasted_Lots;
														row.SEPID=fc.ID;
													}
													else if(monthVal == "OCT" || monthVal == "OCTOBER")
													{
														row.OCT_LOTS=fc.Forecasted_Lots;
														row.OCTID=fc.ID;
													}
													else if(monthVal == "NOV" || monthVal == "NOVEMBER")
													{
														row.NOV_LOTS=fc.Forecasted_Lots;
														row.NOVID=fc.ID;
													}
													else if(monthVal == "DEC" || monthVal == "DECEMBER")
													{
														row.DEC_LOTS=fc.Forecasted_Lots;
														row.DECID=fc.ID;
													}
												}
												input.Forecasts.insert(row);
											}
										}
						)
					}
				}

			}
