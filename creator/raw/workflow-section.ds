			Last_Takedown_Prev_Count_ as "Last Takedown & Prev Count Fields - TD Schedule"
			{
				type =  schedule
				start = "2024-01-04 05:55:21"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through all Takedown_Schedules daily and updates the following fields regarding previous 30, 90, 6 months, and 12 months Sold C ount
										//status = "Sold";
										for each  takedown in Takedown_Schedule[ID != 0]
										{
											thirtydayCount = 0;
											ninetydayCount = 0;
											sixmonthCount = 0;
											twelvemonthCount = 0;
											for each  subdiv in takedown.Subdivisions
											{
												latestbtdDate = Builder_Takedown[Subdivision1 = subdiv && Builder1 = takedown.Builder1 && Purchase_Date <= zoho.currentdate] sort by Purchase_Date;
												latestbtdLotcount = Builder_Takedown[Subdivision1 = subdiv && Builder1 = takedown.Builder1 && Purchase_Date = latestbtdDate.maximum(Purchase_Date)] sort by Purchase_Date;
												lotCount = latestbtdLotcount.maximum(Lot_Count);
												lastDate = latestbtdDate.maximum(Purchase_Date);
												takedown.Last_Takedown_Amount=lotCount;
												takedown.Last_Takedown_Date=lastDate;
												thirtydayQuery = Lots[Close_Date >= zoho.currentdate.subDay(30) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												ninetydayQuery = Lots[Close_Date >= zoho.currentdate.subDay(90) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												sixmonthQuery = Lots[Close_Date >= zoho.currentdate.subMonth(6) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												twelvemonthQuery = Lots[Close_Date >= zoho.currentdate.subMonth(12) && Subdivision == subdiv && Builder1 == takedown.Builder1].count();
												thirtydayCount = thirtydayCount + thirtydayQuery;
												ninetydayCount = ninetydayCount + ninetydayQuery;
												sixmonthCount = sixmonthCount + sixmonthQuery;
												twelvemonthCount = twelvemonthCount + twelvemonthQuery;
											}
											takedown.Last_30_Day_Sales=thirtydayCount;
											takedown.Last_90_Day_Sales=ninetydayCount;
											takedown.Last_6_Month_Sales=sixmonthCount;
											takedown.Last_12_Month_Sales=twelvemonthCount;
										}
					)
					}
				}
			}
