			Update_Totals_Name_on_Sav as "Update Totals & Name on Saving - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											//query all Forecasts that belong to this FC Year and sum the Sold/Actual lots for months prior to current month
										fcActual = Forecast[Forecast_Year2 == input.ID && Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1 && Forecast_Year == input.Forecast_Year && Forecast_Start_Date <= zoho.currentdate.subMonth(1)].sum(Actual_Lots);
										//info fcActual;
										//query all Forecasts that belong to this FC Year and sum the Forecasted lots this month and going forward
										fcForecasted = Forecast[Forecast_Year2 == input.ID && Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1 && Forecast_Year == input.Forecast_Year && Forecast_Start_Date > zoho.currentdate.subMonth(1)].sum(Forecasted_Lots);
										//info fcForecasted;
										//set Forecasted plus Actual variable
										fcPlusactual = fcActual.toLong() + fcForecasted.toLong();
										//write lotsSold count and lotsContracted count to Forecast Year fields
										input.Total_Sold_Forecasted = fcPlusactual;
										input.Forecast_Name = input.Subdivision_Code + " - " + input.Builder1.Builder_Name + " - FC" + input.Forecast_Year;
										//if Builder changed from Placeholder to real builder, update all Forecasts to new Builder
										for each  fc in Forecast_Months
										{
											if(fc.Builder1 != input.Builder1)
											{
												fc.Builder1=input.Builder1;
											}
										}
						)
					}
				}

			}
