			Dev_Notes_Contract_Action as "Dev Notes - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Complete == TRUE && input.Dev_Notes == "")
										{
											alert "Please input Dev Notes and resubmit.";
											cancel submit;
										}
										if(input.Complete == TRUE && input.Dev_Mgr == null)
										{
											alert "Please input a Development Manager and resubmit.";
											cancel submit;
										}
						)
					}
				}

			}
			Load_HTML_CSS_Contract_Ac as "Load HTML/CSS - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											statusText = "Open";
										statusClass = "open";
										if(input.Complete == true || ifnull(input.Status,"") == "Complete")
										{
											statusText = "Complete";
											statusClass = "complete";
										}
										contractName = "—";
										if(input.Contract1 != null)
										{
											try 
											{
												contractName = ifnull(input.Contract1.Contract_Name,"—");
											}
											catch (e)
											{
												contractName = "—";
											}
										}
										actionText = ifnull(input.Contract_Action,"—");
										startDateText = "—";
										if(input.Start_Date != null)
										{
											startDateText = input.Start_Date.toString("MM/dd/yyyy");
										}
										dueDateText = "—";
										if(input.Due_Date != null)
										{
											dueDateText = input.Due_Date.toString("MM/dd/yyyy");
										}
										completeDateText = "—";
										if(input.Complete_Date != null)
										{
											completeDateText = input.Complete_Date.toString("MM/dd/yyyy");
										}
										completeHelper = "Sets action to complete and adds todays date.";
										if(input.Complete == true && completeDateText != "—")
										{
											completeHelper = "Completed on " + completeDateText + ".";
										}
										contractName = contractName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										actionText = actionText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										completeHelperCss = completeHelper.replaceAll("\\","\\\\").replaceAll("'","\\'");
										html = "";
										html = html + "<style>";
										html = html + ".zc-Action_Summary_HTML-group{margin-bottom:0!important;}";
										html = html + ".zc-Action_Summary_HTML-group>.form-label{display:none!important;}";
										html = html + ".zc-Action_Summary_HTML-group .form-field{width:100%!important;float:none!important;}";
										html = html + ".ca-wrap{padding:8px 0 0 0;font-family:Arial,Helvetica,sans-serif;}";
										html = html + ".ca-card{background:#fff;border:1px solid #dfe5ee;border-radius:12px 12px 0 0;overflow:hidden;box-shadow:0 2px 10px rgba(16,24,40,.04);border-bottom:0;}";
										html = html + ".ca-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:18px 20px;border-bottom:1px solid #edf1f6;background:#fbfcfe;}";
										html = html + ".ca-eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:4px;}";
										html = html + ".ca-contract{font-size:20px;font-weight:700;color:#1f2937;line-height:1.2;margin-bottom:4px;}";
										html = html + ".ca-sub{font-size:13px;color:#6b7280;}";
										html = html + ".ca-badge{display:inline-block;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap;}";
