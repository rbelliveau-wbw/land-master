			Builder_Search_Forecast_M as "Builder Search - Forecast Mgmt"
			{
				type =  form
				form = Forecast_Search

				record event = on add or edit

				on user input of Builder1
				{
					actions 
					{
						custom deluge script
						(
											forecastYear = "";
										county = "";
										city = "";
										builder = "";
										subdiv = "";
										territory = "";
										reportName = "All_Forecast_Years?";
										if(input.Forecast_Year != "")
										{
											forecastYear = "&Forecast_Year=" + input.Forecast_Year;
										}
										if(input.Subdivision1.isEmpty() = false)
										{
											subdiv = "&Subdivision1=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
										}
										if(input.Territory != "")
										{
											territory = "&Subdivision1.Territory=" + input.Territory;
											subdiv = "";
										}
										if(input.County != "")
										{
											county = "&Subdivision1.County=" + input.County;
											subdiv = "";
										}
										if(input.City != "")
										{
											city = "&Subdivision1.City=" + input.City;
											county = "";
											subdiv = "";
										}
										if(input.Builder1.isEmpty() = false)
										{
											builder = "&&Builder1=[" + Builder[ID == input.Builder1].Builder_Name.getAll() + "]";
										}
										reportUrl = zoho.appuri + "view-embed/";
										query1Url = reportUrl + reportName + forecastYear + builder + subdiv + city + county + territory;
										openUrl(query1Url,"iframe","frame14");
						)
					}
				}

			}
