			Budgets_Check_HCSS_Budget as "Budgets - Check HCSS Budget Line Exists"
			{
				type =  schedule
				start = "2026-05-21 12:05:25"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: HeavyJob Budget Deleted Line Cleanup + CostCodeID Refresh
										//
										// Scope:
										// - Read Analytics source report.
										// - Build active CostCodeID list.
										// - Build active stable budget line Code list.
										// - Build a map of stable Code -> current Analytics CostCodeID.
										// - Check existing Budget_Import_Item records.
										//
										// Logic:
										// - If old Cost_Code_ID still exists in Analytics:
										//     • Do nothing.
										// - If old Cost_Code_ID is gone, but stable Code still exists:
										//     • Update Budget_Import_Item.Cost_Code_ID to the new CostCodeID.
										// - If old Cost_Code_ID is gone and stable Code is gone:
										//     • Set Budget_Import_Item.Cost = 0.
										//
										// IMPORTANT:
										// - This script does NOT insert records.
										// - This script does NOT update existing costs from Analytics.
										// - This script does NOT update Updated_Date.
										// - This script does NOT update descriptions, codes, data source, or IDs other than Cost_Code_ID.
										// - The ONLY database writes allowed in this script are:
										//
										//     existingItem.Cost_Code_ID = newCostCodeId;
										//     existingItem.Cost = 0;
										//
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000023687048";
										// === 1) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("H.zzz_CostCodeID_Guid");
										cols.add("H.JobCode");
										cols.add("H.Minor Code");
										config.put("selectedColumns",cols);
										// === 2) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 3) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 4) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 5) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 6) Parse the rows array ===
										rows = dataResp.get("data");
										// === 7) Build list of subdivision codes that currently have budgets ===
										budgCodes = Add_Budget[ID != 0].Subdivision_Code.getAll();
										// === 8) Build active source lists ===
										//
										// activeCostCodeIDs:
										// - Current CostCodeIDs that exist in Analytics.
										//
										// activeBudgetLineCodes:
										// - Stable Budget_Import_Item.Code values that exist in Analytics.
										// - Format: Subdivision_Code + "-B-" + Minor_Code
										//
										// sourceCostCodeIdByBudgetLineCode:
										// - Map from stable Code to current Analytics CostCodeID.
										// - Used to refresh Budget_Import_Item.Cost_Code_ID when HeavyJob recreates a line.
										activeCostCodeIDs = List();
										activeBudgetLineCodes = List();
										duplicateBudgetLineCodes = List();
										sourceCostCodeIdByBudgetLineCode = Map();
										for each  rec in rows
										{
											sourceCostCodeId = ifnull(rec.get("H.zzz_CostCodeID_Guid"),"").toString();
											sourceJobCode = ifnull(rec.get("H.JobCode"),"").toString();
											sourceMinorCode = ifnull(rec.get("H.Minor Code"),"").toString();
											if(sourceJobCode != "" && sourceMinorCode != "")
											{
												subdiv = External_System_Mapping[External_Code == sourceJobCode];
												if(subdiv.count() > 0)
												{
													subdivCode = ifnull(subdiv.Subdivision1.Subdivision_Code,"").toString();
													// Only consider source rows for subdivisions that actually have budgets
													if(subdivCode != "" && budgCodes.contains(subdivCode))
													{
														sourceBudgetLineCode = subdivCode + "-B-" + sourceMinorCode;
														if(activeBudgetLineCodes.contains(sourceBudgetLineCode) == false)
														{
															activeBudgetLineCodes.add(sourceBudgetLineCode);
															if(sourceCostCodeId != "")
															{
																sourceCostCodeIdByBudgetLineCode.put(sourceBudgetLineCode,sourceCostCodeId);
															}
														}
														else
														{
															// If the same stable Code appears more than once with different CostCodeIDs,
															// do not auto-refresh Cost_Code_ID later. Protect it from zeroing,
															// but avoid guessing which CostCodeID is correct.
															existingMappedCostCodeId = ifnull(sourceCostCodeIdByBudgetLineCode.get(sourceBudgetLineCode),"").toString();
															if(existingMappedCostCodeId != "" && sourceCostCodeId != "" && existingMappedCostCodeId != sourceCostCodeId)
															{
																if(duplicateBudgetLineCodes.contains(sourceBudgetLineCode) == false)
																{
																	duplicateBudgetLineCodes.add(sourceBudgetLineCode);
																}
															}
															if(existingMappedCostCodeId == "" && sourceCostCodeId != "")
															{
																sourceCostCodeIdByBudgetLineCode.put(sourceBudgetLineCode,sourceCostCodeId);
															}
														}
														if(sourceCostCodeId != "" && activeCostCodeIDs.contains(sourceCostCodeId) == false)
														{
															activeCostCodeIDs.add(sourceCostCodeId);
														}
													}
												}
											}
										}
										// === 9) Cleanup deleted budget lines and refresh recreated CostCodeIDs ===
										//
										// A line should be zeroed only if:
										// - Its old Cost_Code_ID is not in the active source report
										// AND
										// - Its stable Code is not in the active source report
										//
										// A line should have Cost_Code_ID refreshed if:
										// - Its old Cost_Code_ID is not in the active source report
										// AND
										// - Its stable Code is still in the active source report
										// AND
										// - The source report has a non-blank new CostCodeID for that stable Code
										zeroedCount = 0;
										checkedCount = 0;
										refreshedCostCodeIdCount = 0;
										protectedByCostCodeIdCount = 0;
										protectedByStableCodeCount = 0;
										skippedDuplicateStableCodeCount = 0;
										skippedBlankCodeCount = 0;
										skippedBlankCostCodeIdCount = 0;
										// Safety guard:
										// If Analytics returns no active stable budget line codes, do NOT change anything.
										// This prevents wiping out costs if the export fails or comes back empty.
										if(activeBudgetLineCodes.size() > 0)
										{
											existingBudgetImportItems = Budget_Import_Item[Data_Source == "HeavyJob Budget" && Cost != 0];
											for each  existingItem in existingBudgetImportItems
											{
												existingCostCodeId = ifnull(existingItem.Cost_Code_ID,"").toString();
												existingBudgetLineCode = ifnull(existingItem.Code,"").toString();
												existingSubdivCode = ifnull(existingItem.Subdivision_Code,"").toString();
												if(existingCostCodeId == "")
												{
													skippedBlankCostCodeIdCount = skippedBlankCostCodeIdCount + 1;
												}
												if(existingBudgetLineCode == "")
												{
													skippedBlankCodeCount = skippedBlankCodeCount + 1;
												}
												if(existingSubdivCode != "" && budgCodes.contains(existingSubdivCode))
												{
													checkedCount = checkedCount + 1;
													costCodeIdStillExists = false;
													stableCodeStillExists = false;
													if(existingCostCodeId != "" && activeCostCodeIDs.contains(existingCostCodeId))
													{
														costCodeIdStillExists = true;
													}
													if(existingBudgetLineCode != "" && activeBudgetLineCodes.contains(existingBudgetLineCode))
													{
														stableCodeStillExists = true;
													}
													if(costCodeIdStillExists)
													{
														protectedByCostCodeIdCount = protectedByCostCodeIdCount + 1;
													}
													else if(stableCodeStillExists)
													{
														protectedByStableCodeCount = protectedByStableCodeCount + 1;
														if(duplicateBudgetLineCodes.contains(existingBudgetLineCode))
														{
															// Stable line exists, so do not zero it.
															// But because the source has duplicate stable codes with different CostCodeIDs,
															// do not guess which CostCodeID to write.
															skippedDuplicateStableCodeCount = skippedDuplicateStableCodeCount + 1;
														}
														else
														{
															newCostCodeId = ifnull(sourceCostCodeIdByBudgetLineCode.get(existingBudgetLineCode),"").toString();
															if(newCostCodeId != "" && newCostCodeId != existingCostCodeId)
															{
																// DATABASE WRITE 1 OF 2:
																// Refresh recreated HeavyJob line to the new current CostCodeID.
																existingItem.Cost_Code_ID=newCostCodeId;
																refreshedCostCodeIdCount = refreshedCostCodeIdCount + 1;
															}
														}
													}
													else
													{
														// DATABASE WRITE 2 OF 2:
														// The CostCodeID is gone and the stable line Code is also gone.
														// This appears to be a truly deleted HeavyJob budget line.
														existingItem.Cost=0;
														zeroedCount = zeroedCount + 1;
													}
												}
											}
										}
										else
										{
											info "Cleanup skipped because activeBudgetLineCodes was empty. No Budget_Import_Item records were changed.";
										}
										info "HeavyJob Budget Deleted Line Cleanup Complete";
										info "Active Source CostCodeIDs: " + activeCostCodeIDs.size();
										info "Active Source Budget Line Codes: " + activeBudgetLineCodes.size();
										info "Duplicate Stable Budget Line Codes: " + duplicateBudgetLineCodes.size();
										info "Existing Budget Import Items Checked: " + checkedCount;
										info "Protected By Same CostCodeID: " + protectedByCostCodeIdCount;
										info "Protected By Stable Code Match: " + protectedByStableCodeCount;
										info "Refreshed Cost_Code_ID Count: " + refreshedCostCodeIdCount;
										info "Skipped Duplicate Stable Code Count: " + skippedDuplicateStableCodeCount;
										info "Skipped Blank Cost_Code_ID Records: " + skippedBlankCostCodeIdCount;
										info "Skipped Blank Code Records: " + skippedBlankCodeCount;
										info "Zeroed Deleted Lines: " + zeroedCount;
					)
					}
				}
			}
			Set_Close_Date_Lots1 as "Set Close Date - Lots"
			{
				type =  schedule
				form = Settings
				start = Next_Workflow_Run
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//search for all lots where Purchase Date <= today and for each set Close Date to today and Status to Sold
										// Only run for lots where Purchase Date is today or in the past, and Status is not already Sold
										for each  lot in Lots[Purchase_Date != null && Purchase_Date <= zoho.currentdate]
										{
											if(lot.Close_Date == null || lot.Close_Date != lot.Purchase_Date)
											{
												lot.Close_Date_Text=lot.Purch_Date_Text;
												lot.Close_Date=lot.Purchase_Date;
												lot.Status="Sold";
											}
										}
										for each  lot in Lots[Builder1 != NULL && Builder1.Builder_Name != "Placeholder" && Status == "Open"]
										{
											lot.Status="Contracted";
										}
										for each  lot in Lots[ID != 0 && Status == "Open"]
										{
											lot.Builder1=4410926000000693249;
										}
					)
					}
				}
			}
			Update_Sold_Contracted_Fo1 as "Update Sold/Contracted - Forecast Year"
			{
				type =  schedule
				form = Settings
				start = Next_Workflow_Run
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//iterate through every Forecast Year record
										for each  forecastYear in Forecast_Year[Status = "Builder"]
										{
											//Forecast Year dropdown is stored as string, this changed to number
											fcyearTonum = forecastYear.Forecast_Year.toNumber();
											//this variable sets the final day of the Forecast Year -- Jan 31st of FC Year + 1 --  to be used in the lotsSold query
											fcYearpone = "01/31/" + (fcyearTonum + 1);
											//query all Sold lots with same Builder/Subdiv as Forecast Year record with Close Date >= 02/01 and Close Date <= 01/31 of the next year
											lotsSold = Lots[Subdivision == forecastYear.Subdivision1 && Builder1 == forecastYear.Builder1 && Status == "Sold" && Close_Date >= "02/01/" + forecastYear.Forecast_Year && Close_Date <= fcYearpone].count();
											//query all Contracted lots with same Builder/Subdiv as Forecast Year
											if(forecastYear.Builder1.Builder_Name != "Placeholder")
											{
												lotsContracted = Lots[Subdivision == forecastYear.Subdivision1 && Builder1 == forecastYear.Builder1 && Status == "Contracted"].count();
											}
											if(forecastYear.Builder1.Builder_Name == "Placeholder")
											{
												lotsContracted = Lots[Subdivision == forecastYear.Subdivision1 && Builder1 == forecastYear.Builder1].count();
											}
											//query all Forecasts that belong to this Forecast year and sum the Actual/Sold values if prev month
											fcActual = Forecast[Subdivision1 == forecastYear.Subdivision1 && Builder1 == forecastYear.Builder1 && Forecast_Year == forecastYear.Forecast_Year && Forecast_Start_Date <= zoho.currentdate.subMonth(1)].sum(Actual_Lots);
											//info fcActual;
											//query all Forecasts that belong to this FC Year and sum the Forecasted lots this month and going forward
											fcForecasted = Forecast[Subdivision1 == forecastYear.Subdivision1 && Builder1 == forecastYear.Builder1 && Forecast_Year == forecastYear.Forecast_Year && Forecast_Start_Date > zoho.currentdate.subMonth(1)].sum(Forecasted_Lots);
											totalLotobligation = Takedown_Schedule[Builder1 == forecastYear.Builder1 && Subdivisions == forecastYear.Subdivision1].Total_Lot_Obligation;
											//info fcForecasted;
											//set Forecasted plus Actual variable
											fcPlusactual = fcActual.toLong() + fcForecasted.toLong();
											//write lotsSold count and lotsContracted count to Forecast Year fields
											forecastYear.Contracted_Lot_Amount=totalLotobligation;
											forecastYear.Running_Forecast_Balance=fcForecasted;
											forecastYear.Total_Sold_Forecasted=fcPlusactual;
											forecastYear.Total_Sold_Lots=lotsSold;
											forecastYear.Total_Contracted_Lots=lotsContracted;
											//set subdiv code -- can delete after runs once
											subdivCode = Subdivision[ID == forecastYear.Subdivision1].Subdivision_Code;
											forecastYear.Subdivision_Code=subdivCode;
										}
					)
					}
				}
			}
			Update_Actual_Lots_Foreca1 as "Update Actual Lots - Forecast"
			{
				type =  schedule
				form = Settings
				start = Next_Workflow_Run
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//iterate through every Forecast record
										for each  forecast in Forecast[Forecast_Start_Date > zoho.currentdate.subDay(60) && Forecast_Start_Date < zoho.currentdate.addDay(45)]
										{
											//create variable for Forecast.Forecast_StartDate plus one month -- to create Forecast end date
											forecastEnddate = forecast.Forecast_Start_Date.addMonth(1);
											//count all Lots with same Builder, Subdiv as Forecast and check for  whether Close Date is within FC Start Date plus one month & status of Closed
											lotsScheduled = Lots[Subdivision == forecast.Subdivision1 && Builder1 == forecast.Builder1 && Purchase_Date >= forecast.Forecast_Start_Date && Purchase_Date < forecastEnddate && Close_Date == null].count();
											lotsSold = Lots[Subdivision == forecast.Subdivision1 && Builder1 == forecast.Builder1 && Close_Date >= forecast.Forecast_Start_Date && Close_Date < forecastEnddate && Status = "Sold"].count();
											//write value to Forecast.Actual_Lots
											if(lotsSold == 0)
											{
												forecast.Actual_Lots=null;
											}
											if(lotsSold > 0)
											{
												forecast.Actual_Lots=lotsSold;
											}
											if(lotsScheduled == 0)
											{
												forecast.Scheduled_Lots=null;
											}
											if(lotsScheduled > 0)
											{
												forecast.Scheduled_Lots=lotsScheduled;
											}
										}
					)
					}
				}
			}
			TAX_WIDGET_CALENDAR_EMAIL as "TAX WIDGET CALENDAR EMAIL"
			{
				type =  schedule
					status = inactive
				start = "2026-06-02 08:30:13"
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// =========================================================
										// Send Simple Outlook ICS Appointment
										// Tomorrow 9:30 AM - 10:00 AM local time
										// =========================================================
										vTo = zoho.loginuserid;
										vFrom = zoho.adminuserid;
										// Test parcel info
										vCounty = "Bell";
										vTaxParcelID = "125271";
										vTaxYear = "2026";
										// Real CRLF — hextoText produces actual control characters
										vCR = hextoText("0D");
										vLF = hextoText("0A");
										vNL = vCR + vLF;
										// Tomorrow date in ICS format
										vEventDate = zoho.currentdate.addDay(1).toString("yyyyMMdd");
										// Outlook calendar title
										vTitle = vCounty + " County - Tax Parcel " + vTaxParcelID + " - " + vTaxYear;
										// Description — "\n" here is the ICS literal escape for an in-field line break
										vDescription = "County: " + vCounty + "\n";
										vDescription = vDescription + "Tax Parcel ID: " + vTaxParcelID + "\n";
										vDescription = vDescription + "Tax Year: " + vTaxYear + "\n";
										vDescription = vDescription + "Generated from Zoho Creator.";
										// Unique ID
										vUID = "tax-parcel-" + vTaxParcelID + "-" + vTaxYear + "-" + zoho.currenttime.toLong().toString() + "@landmaster";
										// Build appointment ICS
										vICS = "";
										vICS = vICS + "BEGIN:VCALENDAR" + vNL;
										vICS = vICS + "VERSION:2.0" + vNL;
										vICS = vICS + "PRODID:-//WB Development//Land Master//EN" + vNL;
										vICS = vICS + "CALSCALE:GREGORIAN" + vNL;
										vICS = vICS + "METHOD:PUBLISH" + vNL;
										vICS = vICS + "BEGIN:VEVENT" + vNL;
										vICS = vICS + "UID:" + vUID + vNL;
										vICS = vICS + "DTSTAMP:" + zoho.currenttime.toString("yyyyMMdd'T'HHmmss") + vNL;
										vICS = vICS + "SUMMARY:" + vTitle + vNL;
										vICS = vICS + "DESCRIPTION:" + vDescription + vNL;
										vICS = vICS + "LOCATION:" + vCounty + " County Appraisal District" + vNL;
										// No timezone block — Outlook treats DTSTART/DTEND as local (floating) time
										vICS = vICS + "DTSTART:" + vEventDate + "T093000" + vNL;
										vICS = vICS + "DTEND:" + vEventDate + "T100000" + vNL;
										vICS = vICS + "STATUS:CONFIRMED" + vNL;
										vICS = vICS + "TRANSP:OPAQUE" + vNL;
										vICS = vICS + "CLASS:PUBLIC" + vNL;
										vICS = vICS + "END:VEVENT" + vNL;
										vICS = vICS + "END:VCALENDAR" + vNL;
										// Create .ics file
										vFileName = "tax_parcel_" + vTaxParcelID + "_" + vTaxYear + ".ics";
										vICSFile = vICS.toFile(vFileName);
										// Send email
										sendmail
										[
											from :vFrom
											to :vTo
											subject :"Calendar Test - " + vTitle
											message :"Attached is a calendar appointment. Open the .ics file, then click Save & Close in Outlook."
											Attachments :file:vICSFile
										]
										info vICS;
										info "Sent calendar appointment to " + vTo;
					)
					}
				}
			}
			Check_for_Stuck_Budget_Ap as "Check for Stuck Budget Approvals"
			{
				type =  schedule
				form = Settings
				start = Next_Workflow_Run
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						fromAddress = "rbelliveau@wbdevelopment.com";
										toAddress = "rbelliveau@wbdevelopment.com";
										/***************************************************************
										 * PASS 1: COUNT APPROVAL ROWS BY BUDGET AND TRACK
										 ***************************************************************/
										totMap = Map();
										pendMap = Map();
										apprMap = Map();
										rejMap = Map();
										allRows = Budget_Approvals[ID != null];
										for each  r in allRows
										{
											if(r.Budget == null)
											{
												continue;
											}
											bid = r.Budget.ID.toString();
											trk = ifnull(r.Type1,"").trim();
											if(trk == "")
											{
												continue;
											}
											k = bid + "|" + trk;
											totMap.put(k,ifnull(totMap.get(k),0) + 1);
											rowStatus = ifnull(r.Status,"").trim().toLowerCase();
											if(rowStatus.contains("pending"))
											{
												pendMap.put(k,ifnull(pendMap.get(k),0) + 1);
											}
											else if(rowStatus.contains("approv"))
											{
												apprMap.put(k,ifnull(apprMap.get(k),0) + 1);
											}
											else if(rowStatus.contains("reject"))
											{
												rejMap.put(k,ifnull(rejMap.get(k),0) + 1);
											}
										}
										/***************************************************************
										 * PASS 2: DETECT AND REPAIR STUCK CHAINS
										 ***************************************************************/
										fixedHtml = "";
										manualHtml = "";
										detectedCount = 0;
										fixedCount = 0;
										manualCount = 0;
										failedCount = 0;
										budgets = Add_Budget[ID != null];
										for each  bud in budgets
										{
											bid = bud.ID.toString();
											trackList = List();
											trackList.add("Construction");
											trackList.add("Development");
											for each  trk in trackList
											{
												k = bid + "|" + trk;
												total = ifnull(totMap.get(k),0);
												if(total == 0)
												{
													continue;
												}
												pendingCt = ifnull(pendMap.get(k),0);
												approvedCt = ifnull(apprMap.get(k),0);
												rejectedCt = ifnull(rejMap.get(k),0);
												// Do not automatically modify rejected chains.
												if(rejectedCt > 0)
												{
													continue;
												}
												// The chain already has an active approver.
												if(pendingCt > 0)
												{
													continue;
												}
												/***********************************************************
												 * READ THE PARENT BUDGET TRACK STATUS
												 ***********************************************************/
												chainStatus = "";
												if(trk == "Construction")
												{
													chainStatus = ifnull(bud.Const_Budget_Approval_Status,"").trim().toLowerCase();
												}
												else
												{
													chainStatus = ifnull(bud.Development_Budget_Approval_Status,"").trim().toLowerCase();
												}
												chainInFlight = chainStatus.contains("pending");
												reason = "";
												fixType = "";
												if(approvedCt > 0 && approvedCt < total)
												{
													reason = "Chain started but no approver is Pending. The next approver was never promoted.";
													fixType = "PROMOTE_NEXT";
												}
												else if(chainInFlight && approvedCt == 0)
												{
													reason = "Budget track reads Pending, but the first approver was never activated.";
													fixType = "ACTIVATE_FIRST";
												}
												else if(chainInFlight && approvedCt == total)
												{
													reason = "All approvers are Approved, but the Budget track still reads Pending.";
													fixType = "MANUAL_COMPLETION";
												}
												if(reason == "")
												{
													continue;
												}
												detectedCount = detectedCount + 1;
												/***********************************************************
												 * BUILD A READABLE BUDGET LABEL
												 ***********************************************************/
												budgetLabel = ifnull(bud.Budget_Name,"Budget");
												projectName = ifnull(bud.Project,"");
												phaseName = ifnull(bud.Phase,"");
												if(projectName != "" && phaseName != "")
												{
													budgetLabel = projectName + " - " + phaseName;
												}
												/***********************************************************
												 * ALL ROWS APPROVED: NO NEXT APPROVER EXISTS
												 *
												 * Do not reactivate an already-approved row. This may
												 * indicate that finalization or status synchronization failed.
												 ***********************************************************/
												if(fixType == "MANUAL_COMPLETION")
												{
													manualCount = manualCount + 1;
													manualHtml = manualHtml + "<tr>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>" + reason + " No approval row was changed.</td>";
													manualHtml = manualHtml + "</tr>";
													continue;
												}
												/***********************************************************
												 * LOAD THIS TRACK'S APPROVAL ROWS
												 ***********************************************************/
												chainRows = Budget_Approvals[Budget == bud.ID && Type1 == trk];
												highestApprovedSort = 0;
												firstApprovalId = 0;
												firstApprovalSort = 999999;
												/***********************************************************
												 * FIND:
												 * - First approval row
												 * - Highest already-approved sort order
												 ***********************************************************/
												for each  chainRow in chainRows
												{
													rowSort = 999999;
													if(chainRow.Sort_Order != null)
													{
														rowSort = chainRow.Sort_Order.toLong();
													}
													rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
													if(rowSort < firstApprovalSort)
													{
														firstApprovalSort = rowSort;
														firstApprovalId = chainRow.ID;
													}
													if(rowStatus.contains("approv") && rowSort > highestApprovedSort)
													{
														highestApprovedSort = rowSort;
													}
												}
												targetApprovalId = 0;
												targetApprovalSort = 999999;
												targetRole = "";
												targetEmail = "";
												/***********************************************************
												 * ACTIVATE THE FIRST APPROVER
												 ***********************************************************/
												if(fixType == "ACTIVATE_FIRST")
												{
													targetApprovalId = firstApprovalId;
												}
												/***********************************************************
												 * PROMOTE THE NEXT APPROVER AFTER THE HIGHEST APPROVED ROW
												 ***********************************************************/
												else if(fixType == "PROMOTE_NEXT")
												{
													for each  chainRow in chainRows
													{
														rowSort = 999999;
														if(chainRow.Sort_Order != null)
														{
															rowSort = chainRow.Sort_Order.toLong();
														}
														rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
														isApproved = rowStatus.contains("approv");
														isRejected = rowStatus.contains("reject");
														if(rowSort > highestApprovedSort && rowSort < targetApprovalSort && isApproved == false && isRejected == false)
														{
															targetApprovalSort = rowSort;
															targetApprovalId = chainRow.ID;
														}
													}
												}
												/***********************************************************
												 * COULD NOT DETERMINE THE APPROVER TO ACTIVATE
												 ***********************************************************/
												if(targetApprovalId == 0)
												{
													failedCount = failedCount + 1;
													manualCount = manualCount + 1;
													manualHtml = manualHtml + "<tr>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
													manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>The watchdog could not determine which approval row should be activated.</td>";
													manualHtml = manualHtml + "</tr>";
													continue;
												}
												/***********************************************************
												 * SET THE TARGET APPROVAL TO PENDING
												 *
												 * All other non-approved rows remain Not Sent.
												 ***********************************************************/
												for each  chainRow in chainRows
												{
													rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
													if(chainRow.ID == targetApprovalId)
													{
														chainRow.Status="Pending";
														chainRow.Sent_Date=zoho.currentdate;
														chainRow.Responded_Date=null;
														targetRole = ifnull(chainRow.Title,"");
														targetEmail = ifnull(chainRow.Approver,"");
													}
													else if(rowStatus.contains("approv") == false && rowStatus.contains("reject") == false)
													{
														chainRow.Status="Not Sent";
														chainRow.Sent_Date=null;
														chainRow.Responded_Date=null;
													}
												}
												/***********************************************************
												 * ENSURE THE PARENT TRACK STATUS IS PENDING
												 ***********************************************************/
												if(trk == "Construction")
												{
													bud.Const_Budget_Approval_Status="Pending";
												}
												else
												{
													bud.Development_Budget_Approval_Status="Pending";
												}
												/***********************************************************
												 * SEND THE APPROVAL EMAIL
												 ***********************************************************/
												emailResult = "";
												fixSuccessful = true;
												try 
												{
													emailResult = thisapp.sendApprovalEmail(bud.ID,targetApprovalId);
												}		catch (sendError)
												{
													fixSuccessful = false;
													emailResult = "Approval row was set to Pending, but the email failed: " + sendError.toString();
												}
												/***********************************************************
												 * SYNCHRONIZE THE TRACK STATUS
												 ***********************************************************/
												try 
												{
													syncResult = thisapp.syncBudgetApprovalStatus(bud.ID,trk);
												}		catch (syncError)
												{
													syncResult = "Status synchronization failed: " + syncError.toString();
												}
												fixedCount = fixedCount + 1;
												if(fixSuccessful == false)
												{
													failedCount = failedCount + 1;
												}
												actionText = "";
												if(fixType == "ACTIVATE_FIRST")
												{
													actionText = "Activated the first approver";
												}
												else
												{
													actionText = "Promoted the next approver";
												}
												fixedHtml = fixedHtml + "<tr>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;'>" + targetRole + "</td>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + targetEmail + "</td>";
												fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>" + actionText + ", set the row to Pending, and attempted to send the approval email.<br><span style='font-size:11px;color:#64748b;'>" + emailResult + "</span></td>";
												fixedHtml = fixedHtml + "</tr>";
											}
										}
										/***************************************************************
										 * SEND WATCHDOG SUMMARY
										 ***************************************************************/
										if(detectedCount > 0)
										{
											emailBody = "";
											emailBody = emailBody + "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
											emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Approval Watchdog Results</h2>";
											emailBody = emailBody + "<p style='margin:0 0 16px 0;'>";
											emailBody = emailBody + "<strong>" + detectedCount + "</strong> stuck approval chain(s) were detected. ";
											emailBody = emailBody + "<strong style='color:#047857;'>" + fixedCount + "</strong> were automatically repaired";
											if(manualCount > 0)
											{
												emailBody = emailBody + ", and <strong style='color:#b91c1c;'>" + manualCount + "</strong> require manual review";
											}
											emailBody = emailBody + ".</p>";
											/***********************************************************
											 * FIXED APPROVALS
											 ***********************************************************/
											if(fixedCount > 0)
											{
												emailBody = emailBody + "<h3 style='margin:20px 0 8px 0;color:#047857;'>Automatically Fixed Approvals</h3>";
												emailBody = emailBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;'>";
												emailBody = emailBody + "<tr style='background:#ecfdf5;'>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Budget</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Track</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Approved</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Activated Role</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Approver</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Repair</th>";
												emailBody = emailBody + "</tr>";
												emailBody = emailBody + fixedHtml;
												emailBody = emailBody + "</table>";
											}
											/***********************************************************
											 * MANUAL REVIEW ITEMS
											 ***********************************************************/
											if(manualCount > 0)
											{
												emailBody = emailBody + "<h3 style='margin:20px 0 8px 0;color:#b91c1c;'>Manual Review Required</h3>";
												emailBody = emailBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;'>";
												emailBody = emailBody + "<tr style='background:#fef2f2;'>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Budget</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Track</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Approved</th>";
												emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Problem</th>";
												emailBody = emailBody + "</tr>";
												emailBody = emailBody + manualHtml;
												emailBody = emailBody + "</table>";
											}
											emailBody = emailBody + "<p style='margin:16px 0 0 0;font-size:12px;color:#64748b;'>";
											emailBody = emailBody + "Automated check from the Land Master approval watchdog. Automatically repaired chains had the appropriate approval row set to Pending and the approval email resent.";
											emailBody = emailBody + "</p>";
											emailBody = emailBody + "</div>";
											subjectText = "Land Master Approvals: " + fixedCount + " fixed";
											if(manualCount > 0)
											{
												subjectText = subjectText + ", " + manualCount + " need review";
											}
											sendmail
											[
												from :fromAddress
												to :toAddress
												subject :subjectText
												message :emailBody
											]
										}
					)
					}
				}
			}
			Update_Budgets_w_Projects1 as "Update Budgets w/ Projects Info - Budget"
			{
				type =  schedule
				form = Settings
				start = Next_Workflow_Run
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// === 1) Analytics identifiers ===
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000000012031";
										// === 2) Request setup ===
										headers = Map();
										// auth header
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										// query config
										config.put("responseFormat","json");
										// columns to return
										cols = list();
										cols.add("Project Code");
										cols.add("Status");
										cols.add("Gross Acres");
										cols.add("Lot Total - Residential");
										cols.add("Equiv. LF of Street");
										config.put("selectedColumns",cols);
										// === 3) Call Zoho Analytics ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Parse response ===
										rows = resp.get("data");
										// list of row-maps
										info rows;
										// === 5) Loop through rows and update matching Subdivisions ===
										for each  proj in rows
										{
											projectCode = proj.get("Project Code").toString();
											if(projectCode != "")
											{
												subdiv = Subdivision[Subdivision_Code == projectCode];
												if(subdiv.count() > 0)
												{
													// pull values, default blanks to zero
													acres = proj.get("Gross Acres");
													status = proj.get("Status");
													lotTotal = proj.get("Lot Total - Residential");
													equivLF = proj.get("Equiv. LF of Street");
													if(acres == "")
													{
														acres = 0;
													}
													if(lotTotal == "")
													{
														lotTotal = 0;
													}
													if(equivLF == "")
													{
														equivLF = 0;
													}
													// write back to Zoho Creator
													subdiv.Projects_Status=status;
													subdiv.Acres=acres;
													subdiv.Lot_Total_Residential=lotTotal;
													subdiv.Equiv_LF_of_Street=equivLF;
												}
											}
										}
					)
					}
					actions 
					{
					on load
					(
						//Iterates through every Budget Category and takes the matching SUbdvision and gets Zoho Projects/Analytics data and writes it to the category
										for each  budgCat in Budget_Category[ID != 0 && Budget.Subdivision1 != NULL]
										{
											subdiv = Subdivision[ID == budgCat.Budget.Subdivision1];
											budgCat.Project=subdiv.Project.Project_Name.toUpperCase();
											budgCat.Phase=if(subdiv.Subphase == "","PHASE " + subdiv.Phase,"PHASE " + subdiv.Phase + "-" + subdiv.Subphase);
											budgCat.Acres=subdiv.Acres;
											budgCat.Equiv_LF_of_Street=subdiv.Equiv_LF_of_Street;
											budgCat.Lot_Total_Residential=subdiv.Lot_Total_Residential;
										}
					)
					}
					actions 
					{
					on load
					(
						//Iterates through every Budget  and takes the matching SUbdvision and gets Zoho Projects/Analytics data and writes it to the category
										for each  budG in Add_Budget[ID != 0]
										{
											if(budG.Subdivision1 != null)
											{
												subdiv = Subdivision[ID == budG.Subdivision1.ID];
												budG.Project=subdiv.Project.Project_Name.toUpperCase();
												budG.Status=subdiv.Projects_Status;
												budG.Phase=if(subdiv.Subphase == "","PHASE " + subdiv.Phase,"PHASE " + subdiv.Phase + "-" + subdiv.Subphase);
												budG.Acres=subdiv.Acres;
												budG.Equiv_LF_of_Street=subdiv.Equiv_LF_of_Street;
												budG.Lot_Total_Residential=subdiv.Lot_Total_Residential;
											}
										}
					)
					}
				}
			}
		}


