			Create_Builder_Takedowns_ as "Create Builder Takedowns - Subdivision"
			{
				type =  form
				form = Subdivision

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  builder in input.Builders
										{
											td = Takedown_Schedule[Builder1 == builder].count();
											if(td == 0)
											{
												insert into Takedown_Schedule
												[
													Takedown_Schedule_Code=input.Subdivision_Name + " - " + builder.Builder_Name
													Added_User=zoho.loginuser
													Builder1=builder
													Continued_Takedown=0
													Continued_Takedown_Delay_Days=0
													Initial_Delay_Days=0
													Initial_Takedown=0
													Status="Active"
													Total_Lot_Obligation=0
												]
											}
										}
						)
					}
				}

			}
