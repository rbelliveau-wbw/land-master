			Calc_Budget_Total_Budget_ as "Calc Budget Total - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit

				on user input of Budget_Items.Budget_Ttl
				{
					actions 
					{
						custom deluge script
						(
											if(row.Budget_Ttl > 0 && Reimbursements == TRUE)
										{
											row.Budget_Ttl=row.Budget_Ttl * -1;
										}
										budgetTotal = 0;
										for each  item in input.Budget_Items
										{
											if(item.Budget_Ttl == null)
											{
												itemTtl = 0;
											}
											else
											{
												itemTtl = item.Budget_Ttl;
											}
											budgetTotal = itemTtl + budgetTotal;
										}
										input.Budget_Total = budgetTotal;
						)
					}
				}

			}
			Update_Grand_Total_Budget as "Update Grand Total - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
