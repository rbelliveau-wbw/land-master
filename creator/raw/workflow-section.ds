			Milestone_Bi_Directional_1 as "Milestone Bi-Directional Sync - Zoho Projects"
			{
				type =  schedule
				start = "2025-08-22 05:51:33"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Creator Milestones Upsert
										// What it does:
										// - Exports milestone fields from a Zoho Analytics view.
										// - For each row:
										//     • If a Milestone exists (by Milestone_ID), update Name, Start_Date, End_Date.
										//     • Else, if matching Subdivision (by Project Code) exists, insert a new Milestone linked to it.
										// Notes:
										// - Requires Analytics connection (zoho_analytics_connection).
										// - Ensure date fields parse correctly in Creator.
										// - Subdivision must exist for new milestone inserts.
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000021880005";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("m.Milestone ID");
										cols.add("m.Milestone Name");
										cols.add("m.Start Date");
										cols.add("m.End Date");
										cols.add("p.Project Code");
										cols.add("m.Project ID");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each Milestone in Land Master ===
										for each  rec in rows
										{
											ms = Milestones[Milestone_ID == rec.get("m.Milestone ID")];
											subdivId = Subdivision[Subdivision_Code == rec.get("p.Project Code")];
											if(ms.count() == 1 && ms.Push_Update == FALSE)
											{
												ms.Milestone_Name=rec.get("m.Milestone Name");
												ms.Start_Date=rec.get("m.Start Date");
												ms.End_Date=rec.get("m.End Date");
												ms.Project_ID=rec.get("m.Project ID");
											}
											if(ms.count() == 0 && subdivId.count() == 1)
											{
												subdivId = Subdivision[Subdivision_Code == rec.get("p.Project Code")];
												milestone = insert into Milestones
												[
													Milestone_Name=rec.get("m.Milestone Name")
													Start_Date=rec.get("m.Start Date")
													End_Date=rec.get("m.End Date")
													Milestone_ID=rec.get("m.Milestone ID")
													Project_ID=rec.get("m.Project ID")
													Subdivision1=subdivId
													Added_User=zoho.loginuser
												];
												//CREATE MILESTONE IN CREATOR
											}
										}
					)
					}
				}
			}
			Budgets_Import_Load_HCSS_ as "Budgets - Import/Load HCSS Job Cost Summary"
			{
				type =  schedule
				start = "2025-10-06 07:11:47"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Budget_Import_Item Upsert
										// What it does:
										// - Exports selected columns from a Zoho Analytics view.
										// - Builds a list of Subdivision codes that have Budgets.
										// - For each exported row whose JobCode is in that list:
										//     • If a Budget_Import_Item exists (by Cost_Code_ID), update Cost + Updated_Date.
										//     • Else insert a new Budget_Import_Item with mapped fields.
										// Notes:
										// - Ensure TotalActualCost is numeric (normalize if needed).
										// - Requires valid Analytics connection (zoho_analytics_connection).
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000023717814";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("Major Code");
										cols.add("H.Minor Code");
										cols.add("TotalActualCost");
										cols.add("J.JobCodeFinal");
										cols.add("H.JobCode");
										cols.add("CostCodeDescription");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each project ===
										extCodes = External_System_Mapping[ID != 0].Subdivision1.getAll();
										for each  rec in rows
										{
											//get subdiv code
											subdiv = External_System_Mapping[External_Code = rec.get("H.JobCode") && External_System == "HeavyJob"];
											budgCheck = Add_Budget[Subdivision_Code == subdiv.Subdivision1.Subdivision_Code];
											//make item if budget exists
											if(budgCheck.count() > 0)
											{
												codeBuild = rec.get("H.JobCode") + "-HJ-" + rec.get("H.Minor Code");
												budgimpItem = Budget_Import_Item[Code = codeBuild && Data_Source == "HeavyJob"];
												if(budgimpItem.count() == 1 && budgimpItem.Cost != rec.get("TotalActualCost"))
												{
													budgimpItem.Cost=rec.get("TotalActualCost");
													budgimpItem.Updated_Date=zoho.currentdate;
													budgimpItem.Data_Source="HeavyJob";
												}
												if(budgimpItem.count() == 0)
												{
													impItem = insert into Budget_Import_Item
													[
														Data_Source="HeavyJob"
														Cost=rec.get("TotalActualCost")
														Cost_Code_Description=rec.get("CostCodeDescription")
														Code=codeBuild
														Subdivision_Code=subdiv.Subdivision1.Subdivision_Code
														Major_Code=rec.get("Major Code")
														Minor_Code=rec.get("H.Minor Code")
														Added_User=zoho.loginuser
														Updated_Date=zoho.currentdate
													];
													//CREATE MILESTONE IN CREATOR
												}
											}
										}
					)
					}
				}
			}
			Update_Projects_Milestone as "Update Projects Milestones - Zoho Projects"
			{
				type =  schedule
					status = inactive
				start = "2025-10-14 09:25:17"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						portalId = "700737166";
										orgId = "700732567";
										for each  ms in Milestones[Push_Update == true]
										{
											// === 4) Short delay to let the job initialize ===
											getUrl("https://postman-echo.com/delay/3");
											body = Map();
											body.put("start_date",ms.Start_Date.toString("MM-dd-YYYY"));
											body.put("end_date",ms.End_Date.toString("MM-dd-YYYY"));
											resp = invokeurl
											[
												url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + ms.Project_ID + "/milestones/" + ms.Milestone_ID
												type :POST
												parameters:body.toString()
												connection:"zoho_projects_connection"
											];
											info resp;
											if(resp.toString().contains(ms.Start_Date.toString("YYYY-MM-dd")) && resp.toString().contains(ms.End_Date.toString("YYYY-MM-dd")))
											{
												ms.Push_Update=false;
												info body;
												info resp;
											}
										}
					)
					}
				}
			}
			Budgets_Import_Great_Plai as "Budgets - Import Great Plains Engineering Costs"
			{
				type =  schedule
				start = "2025-10-29 06:16:16"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Budget_Import_Item Upsert
										// What it does:
										// - Exports selected columns from a Zoho Analytics view.
										// - Analytics view should return 2 possible rows per GP Job:
										//     • Engineering = Cost_Code_Number_1 2101
										//     • Surveying   = Cost_Code_Number_1 2150
										// - For each exported row whose GP Job maps to a Land Master Subdivision:
										//     • If a Budget_Import_Item exists by Code + Data_Source, update Cost + Updated_Date.
										//     • Else insert a new Budget_Import_Item with mapped fields.
										// Notes:
										// - Existing Engineering rows with Code = GP Job + "-2101" will be reduced if the Analytics view
										//   now only sums Cost_Code_Number_1 = 2101 for Engineering.
										// - Surveying rows will be created/updated with Code = GP Job + "-2150".
										// - Requires valid Analytics connection: zoho_analytics_connection.
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000023448031";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("GP Job");
										cols.add("Cost_Code_Description");
										cols.add("SUM_COST");
										cols.add("SUM_COST_Rounded");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update/import each item ===
										budgCodes = Add_Budget[ID != 0].Subdivision_Code.getAll();
										for each  rec in rows
										{
											gpJob = rec.get("GP Job");
											costGroup = ifnull(rec.get("Cost_Code_Description"),"").trim();
											sumCostRounded = rec.get("SUM_COST_Rounded");
											if(gpJob != null && costGroup != "" && sumCostRounded != null)
											{
												subdivCode = External_System_Mapping[External_Code == gpJob && External_System == "Great Plains"];
												if(budgCodes.contains(subdivCode.Subdivision1.Subdivision_Code))
												{
													majorCode = "";
													minorCode = "";
													costCodeDescription = "";
													if(costGroup == "Surveying")
													{
														majorCode = "2100";
														minorCode = "2150";
														costCodeDescription = "Surveying";
													}
													else if(costGroup == "Engineering")
													{
														majorCode = "2100";
														minorCode = "2101";
														costCodeDescription = "Engineering";
													}
													if(minorCode != "")
													{
														codeBuild = gpJob + "-GP-" + minorCode;
														budgimpItem = Budget_Import_Item[Code == codeBuild && Data_Source == "Great Plains"];
														if(budgimpItem.count() == 1)
														{
															budgimpItem.Cost=sumCostRounded;
															budgimpItem.Updated_Date=zoho.currentdate;
															budgimpItem.Data_Source="Great Plains";
															budgimpItem.Cost_Code_Description=costCodeDescription;
															budgimpItem.Subdivision_Code=subdivCode.Subdivision1.Subdivision_Code;
															budgimpItem.Major_Code=majorCode;
															budgimpItem.Minor_Code=minorCode;
														}
														if(budgimpItem.count() == 0)
														{
															impItem = insert into Budget_Import_Item
															[
																Data_Source="Great Plains"
																Cost=sumCostRounded
																Cost_Code_Description=costCodeDescription
																Code=codeBuild
																Subdivision_Code=subdivCode.Subdivision1.Subdivision_Code
																Major_Code=majorCode
																Minor_Code=minorCode
																Added_User=zoho.loginuser
																Cost_Code_ID=codeBuild
																Updated_Date=zoho.currentdate
															];
														}
													}
												}
											}
										}
					)
					}
				}
			}
