			Load_HTML_Mass_Create_Lot as "Load HTML - Mass Create Lots"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.plain = "<div><style>input.zc-live-primary-btn,input.zc-live-secondary-btn,.zc-live-primary-btn,.zc-live-secondary-btn{display:inline-block!important;visibility:visible!important;opacity:1!important;}</style></div>";
						)
					}
				}

			}
			Hide_Fields_set_Defaults_ as "Hide Fields set Defaults - Contract Version"
			{
				type =  form
				form = Contract_Version

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Email_Attachment;
										disable Contract1;
										input.Date_field1 = zoho.currentdate;
										disable Date_field1;
						)
					}
				}

			}
			Create_Approval_Rows_Pro_ as "Create Approval Rows - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Add this to Add_Pro_Forma -> On Success.
										// STRICT DUPLICATE GUARD:
										// - If this Pro Forma already has ANY Budget_Approvals rows, this does nothing.
										// - Only a Pro Forma with zero existing approval rows receives the four rows.
										// Replace the four email constants below with the production recipients.
										vpEmail = "VP_EMAIL@wbdevelopment.com";
										legalEmail = "legal@wbdevelopment.com";
										cfoEmail = "jking@wbdevelopment.com";
