			Show_Prev_Year_Forecast_Y as "Show Prev Year - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on user input of Show_Previous_Year
				{
					actions 
					{
						custom deluge script
						(
											//unhide and disable Forecast Year if button pressed
										if(input.Show_Previous_Year == TRUE)
										{
											show Previous_Year;
											show Forecast_Months.Forecast_Year;
											disable Forecast_Months.Forecast_Year;
											disable Previous_Year.Forecast_Year;
											hide Previous_Year.Subdivision1;
											hide Previous_Year.Builder1;
											hide Previous_Year.Forecast_Start_Date;
											disable Previous_Year.Scheduled_Lots;
											hide Previous_Year.Edit;
											disable Previous_Year.Forecast_Month;
											disable Previous_Year.Actual_Lots;
											disable Previous_Year.Forecasted_Lots;
											//get ID of FC Year for previous year
											prevYear = toString(input.Forecast_Year.toNumber() - 1);
											prevYearfcyear = Forecast_Year[Forecast_Year == prevYear && Builder1 == input.Builder1 && Subdivision1 == input.Subdivision1].ID;
											for each  fc in Forecast[Forecast_Year2 == prevYearfcyear]
											{
												// Add a new row into Forecast_Months subform
												row = Forecast_Year.Previous_Year();
												row.Forecast_Year2=input.ID;
												row.Forecast_Year=fc.Forecast_Year;
												row.Forecast_Month=fc.Forecast_Month;
												row.Scheduled_Lots=fc.Scheduled_Lots;
												row.Actual_Lots=fc.Actual_Lots;
												row.Forecasted_Lots=fc.Forecasted_Lots;
												row.Forecast_Start_Date=fc.Forecast_Start_Date;
												row.Subdivision1=fc.Subdivision1;
												row.Builder1=fc.Builder1;
												row.Delete_me=TRUE;
												input.Previous_Year.insert(row);
											}
										}
										if(input.Show_Previous_Year == FALSE)
										{
											hide Previous_Year;
											input.Previous_Year.clear();
										}
						)
					}
				}

			}
			Show_Next_Year_Forecast_Y as "Show Next Year - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on user input of Show_Next_Year
				{
					actions 
					{
						custom deluge script
						(
											//unhide and disable Forecast Year if button pressed
										if(input.Show_Next_Year == TRUE)
										{
											show Next_Year;
											show Forecast_Months.Forecast_Year;
											disable Forecast_Months.Forecast_Year;
											disable Next_Year.Forecast_Year;
											hide Next_Year.Subdivision1;
											hide Next_Year.Builder1;
											hide Next_Year.Forecast_Start_Date;
											disable Next_Year.Scheduled_Lots;
											//hide Forecast_Months.Edit;
											disable Next_Year.Forecast_Month;
											disable Next_Year.Actual_Lots;
											disable Next_Year.Forecasted_Lots;
											//get ID of FC Year for previous year
											nextYear = toString(input.Forecast_Year.toNumber() + 1);
											nextYearfcyear = Forecast_Year[Forecast_Year == nextYear && Builder1 == input.Builder1 && Subdivision1 == input.Subdivision1].ID;
											//
											for each  fc in Forecast[Forecast_Year2 == nextYearfcyear]
											{
												// Add a new row into Forecast_Months subform
												row = Forecast_Year.Next_Year();
												row.Forecast_Year2=input.ID;
												row.Forecast_Year=fc.Forecast_Year;
												row.Forecast_Month=fc.Forecast_Month;
												row.Scheduled_Lots=fc.Scheduled_Lots;
												row.Actual_Lots=fc.Actual_Lots;
												row.Forecasted_Lots=fc.Forecasted_Lots;
												row.Forecast_Start_Date=fc.Forecast_Start_Date;
												row.Subdivision1=fc.Subdivision1;
												row.Builder1=fc.Builder1;
												row.Delete_me=TRUE;
												input.Next_Year.insert(row);
											}
										}
										if(input.Show_Next_Year == FALSE)
										{
											hide Next_Year;
											input.Next_Year.clear();
										}
						)
					}
				}

			}
			Allow_Next_Year_FC_Edit_F as "Allow Next Year FC Edit - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on user input of Next_Year.Edit
				{
					actions 
					{
						custom deluge script
						(
											settings = Settings[ID != 0].Open_Forecasting_Window.getAll();
										if(settings = TRUE)
										{
											if(row.Edit == TRUE && row.Forecast_Start_Date.addDay(28) < zoho.currenttime)
											{
												alert "Past forecasts cannot be edited.";
												row.Edit=FALSE;
												disable row.Forecasted_Lots;
											}
											if(row.Edit == TRUE && row.Forecast_Start_Date.addDay(28) >= zoho.currenttime)
											{
												enable row.Forecasted_Lots;
											}
										}
						)
					}
				}

			}
			Update_Forecasts_and_Dele as "Update Forecasts and Delete Prev/Next - FC Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  nextyearFc in input.Next_Year
										{
											realFc = Forecast[Forecast_Year == nextyearFc.Forecast_Year && Subdivision1 == nextyearFc.Subdivision1 && Builder1 == nextyearFc.Builder1 && Delete_me == FALSE && Forecast_Month == nextyearFc.Forecast_Month];
											if(realFc.Forecasted_Lots != nextyearFc.Forecasted_Lots)
											{
												realFc.Forecasted_Lots=nextyearFc.Forecasted_Lots;
											}
										}
										delete from Forecast[Subdivision1 = input.Subdivision1 && Builder1 = input.Builder1 && Delete_me == TRUE];
										input.Show_Next_Year = FALSE;
										input.Show_Previous_Year = FALSE;
						)
					}
				}

			}
			Calc_Line_Total_Qty_Build as "Calc Line Total Qty - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add or edit

				on user input of Additional_Items.Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(row.Amount != null && row.Quantity != null && row.Item_Type == "Addition")
										{
											row.Total=row.Amount * row.Quantity;
										}
										if(row.Amount != null && row.Quantity != null && row.Item_Type == "Deduction")
										{
											row.Total=row.Amount * row.Quantity * -1;
										}
						)
					}
				}

			}
