				record event = on add or edit
					status = inactive

				on user input of Budget_Items.End_Phase
				{
					actions 
					{
						custom deluge script
						(
											if(Deparment == "Construction")
										{
											pfPhase = Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma && Phase == row.End_Phase];
											row.End_Month=pfPhase.Const_End_Month;
										}
										if(Deparment == "Development" || Deparment == "Engineering")
										{
											pfPhase = Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma && Phase == row.End_Phase];
											row.End_Month=pfPhase.Eng_End_Month;
										}
						)
					}
				}

			}
			Show_Hide_Fields_Based_on as "Show/Hide Fields Based on Tab - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Tabs
				{
					actions 
					{
						custom deluge script
						(
											hide Phases1;
										hide Construction_Curve;
										hide Months;
										hide General_Info;
										hide Section2;
										hide Land_Purchase;
										hide Project_Schedule;
										hide Land_Purchase_Installments;
										hide Land_Sale_Installments;
										hide ROI;
										hide Totals;
										hide Additional_Costs_Construction;
										hide Additional_Costs_Development;
										hide Addl_Costs_Tabs;
										hide PID_MUD;
										hide Post_Mortem_Link;
										hide Lot_Pricing_Report;
										hide VP;
										hide VP_Totals;
										if(Tabs == "General Information")
										{
											if(zoho.loginuserid == "jking@wbdevelopment.com" || zoho.loginuserid == "rbelliveau@wbdevelopment.com")
											{
												show VP;
												show VP_Totals;
											}
											show ROI;
											show Totals;
											show General_Info;
											show Section2;
											show Post_Mortem_Link;
											show Lot_Pricing_Report;
										}
										if(Tabs == "Project Schedule")
										{
											show Project_Schedule;
										}
										if(Tabs == "Land Purchase/Sale")
										{
											show Land_Purchase;
											show Land_Purchase_Installments;
											show Land_Sale_Installments;
										}
										if(Tabs == "Construction Curve")
										{
											show Construction_Curve;
										}
										if(Tabs == "PIDs/MUD")
										{
											show PID_MUD;
										}
										if(Tabs == "Additional Costs")
										{
											input.Addl_Costs_Tabs = "CONSTRUCTION";
											show Addl_Costs_Tabs;
											show Additional_Costs_Construction;
										}
										if(Tabs == "Months & Phases")
										{
											show Phases1;
											show Months;
											show ROI;
										}
										if(Tabs == "VP")
										{
											show VP;
											show VP_Totals;
										}
						)
					}
				}

			}
