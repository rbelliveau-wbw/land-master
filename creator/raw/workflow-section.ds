				on success
				{
					actions 
					{
						custom deluge script
						(
											settings = Settings[ID != 0];
										legalRecipients = settings.Receive_Legal_Notifications.toString();
										contractFile = Contract_Version[Contract1 == input.Contract1].File_field1 sort by Date_field1 desc;
										if(Approval_Action == "Reject" && Reject_Reason != "")
										{
											sendmail
											[
												from :"Contracts@wbdevelopment.com"
