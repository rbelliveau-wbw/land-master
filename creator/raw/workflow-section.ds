			Still_Has_Subdivisions_Pr as "Still Has Subdivisions - Project"
			{
				type =  form
				form = Project

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											//query for count of all Subdivisions belonging to the Project trying to be deleted
										subDivs = Subdivision[Project == input.ID].count();
										//if count of subdivisions from above is 1 or greater cancel delete and throw error
										if(subDivs >= 1)
										{
											alert "All Subdivisions and Lots belonging to " + input.Project_Name + " must be deleted before it can be deleted.";
											cancel delete;
										}
						)
					}
				}

			}
