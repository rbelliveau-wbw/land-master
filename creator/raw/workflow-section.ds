											budgetSum = Budget_Category[Budget == input.Budget].sum(Budget_Total);
											devBudgetsum = Budget_Category[Budget == input.Budget].sum(Prelim_Budget_Total);
											addlTotalsum = Budget_Category[Budget == input.Budget].sum(Add_l_Cost_Total);
											parentBudget.Budget_Grand_Total=budgetSum;
