		schedule
		{
			Update_Sold_Counts_Takedo as "Update Sold Counts - Takedown Schedule"
			{
				type =  schedule
				start = "2023-01-27 06:00:09"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through all Takedown_Schedules daily and updates the following fields
										//1. Takedown_Schedule.Lots_Sold
										//2. Takedown_Schedule.Takedown_Start_Date
										status = "Sold";
										for each  takedown in Takedown_Schedule[ID != 0]
										{
											lotCount = 0;
											for each  subdiv in takedown.Subdivisions
											{
												lots = Lots[ID != 0 && Builder1 == takedown.Builder1 && Status == status && Purchase_Date != null && Subdivision == subdiv] sort by Purchase_Date;
												lotCount = lotCount + lots.count(ID);
												startDate = lots.minimum(Purchase_Date);
												if(startDate < takedown.Takedown_Start_Date || takedown.Takedown_Start_Date == NULL)
												{
													takedown.Takedown_Start_Date=startDate;
												}
												takedown.Lots_Sold=lotCount;
											}
											if(takedown.Initial_Closing_Date != null)
											{
												takedown.Takedown_Start_Date=takedown.Initial_Closing_Date;
											}
										}
					)
					}
				}
			}
			Update_Takedown_Dates_Tak as "Update Takedown Dates - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-02 01:25:27"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through all Takedown_Schedules daily and updates the following fields
										//1. Takedown_Schedule.Takedown_End_Date
										for each  takedown in Takedown_Schedule[Takedown_Start_Date != null && Takedown_End_Date == null && Continued_Takedown != 0]
										{
											takedownLength = ceil((takedown.Total_Lot_Obligation - takedown.Initial_Takedown) / takedown.Continued_Takedown) * takedown.Continued_Takedown_Delay_Days + takedown.Initial_Delay_Days;
											tdStart = takedown.Takedown_Start_Date;
											takedown.Takedown_End_Date=tdStart.addDay(takedownLength);
										}
					)
					}
				}
			}
			Update_Expected_Sold_Coun as "Update Expected Sold Count - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-01 06:30:13"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through each Takedown Schedule daily and updates : 
										//1. Lots_Expected field based on where we are in the lifespan of the Takedown Schedule
										for each  takedown in Takedown_Schedule[Status != "Completed" && Takedown_Start_Date != NULL && Total_Lot_Obligation != NULL && Initial_Takedown != null && Continued_Takedown_Delay_Days != 0]
										{
											dayDifference = abs(daysBetween(takedown.Takedown_Start_Date,today));
											contdMultiple = floor((dayDifference - takedown.Initial_Delay_Days) / takedown.Continued_Takedown_Delay_Days);
											if(dayDifference <= takedown.Initial_Delay_Days)
											{
												takedown.Lots_Expected=0;
											}
											if(dayDifference > takedown.Initial_Delay_Days && addDay(takedown.Takedown_Start_Date,dayDifference) < takedown.Takedown_End_Date)
											{
												takedown.Lots_Expected=takedown.Initial_Takedown + contdMultiple * takedown.Continued_Takedown;
											}
											if(takedown.Takedown_End_Date <= today)
											{
												takedown.Lots_Expected=takedown.Total_Lot_Obligation;
											}
										}
					)
					}
					actions 
					{
					on load
					(
						//This schedule fixes blank Lots_Expected so the math for Lots_Ahead in Zoho Analytics will work -- TD Schedules with NO SALES YET, Lots_Expected is BLANK, but they have TD Info ( Total Obligation NOT NULL)
										for each  td in Takedown_Schedule[Takedown_Start_Date == null && Lots_Expected == null && Total_Lot_Obligation != null]
										{
											td.Lots_Expected=0;
										}
					)
					}
					actions 
					{
					on load
					(
						// For takedowns that are taken all at once upfront
										for each  td in Takedown_Schedule[Status == "Active" && Takedown_Start_Date != null && Total_Lot_Obligation != null && Initial_Takedown != null && Initial_Delay_Days == 0 && Continued_Takedown == 0]
										{
											td.Lots_Expected=td.Initial_Takedown;
										}
					)
					}
				}
			}
			Update_Subdivision_Status as "Update Subdivision Status - Subdivision"
			{
				type =  schedule
				start = "2023-02-28 07:05:27"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through each Subdivision record and if Lots Sold >= Total Lots in Subdiv set Subdivision.Status to Sold Out
										for each  subdiv in Subdivision[Status = "Active" && Total_Lots != 0]
										{
											lotsSold = subdiv.Lots_Sold;
											totalLots = subdiv.Total_Lots;
											if(lotsSold >= totalLots)
											{
												subdiv.Status="Sold Out";
												//subdiv.Last_Sold_Date=zoho.currentdate;
											}
										}
					)
					}
				}
			}
			Update_Status_on_Takedown as "Update Status on Takedowns - Takedown Schedule"
			{
				type =  schedule
				start = "2023-02-28 07:00:20"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//This code goes through each Takedown_Schedule record daily and sets the Status to "Behind" if Lots_Sold is less than Lots_Expected
										//Lots_Expected is calculated elsehwere and takes into account all fields in TD Schedule and calculates how many lots should be sold based on today's date
										for each  takedown in Takedown_Schedule[Status = "Active" || Status == "Behind"]
										{
											lotsSold = takedown.Lots_Sold;
											lotsExpected = takedown.Lots_Expected;
											takedown.Takedown_Schedule_Code=takedown.Subdivisions.Subdivision_Code + ' - ' + takedown.Builder1.Builder_Name;
											if(lotsSold < lotsExpected)
											{
												takedown.Status="Behind";
											}
											if(lotsSold >= takedown.Total_Lot_Obligation)
											{
												takedown.Status="Completed";
												takedown.Completion_Percent=100;
											}
											if(lotsSold < takedown.Total_Lot_Obligation)
											{
												takedown.Completion_Percent=lotsSold / takedown.Total_Lot_Obligation * 100;
											}
										}
					)
					}
				}
			}
			Update_Sold_Total_Unforec as "Update Sold/Total/Unforecasted Lots - Subdivision"
			{
				type =  schedule
				start = "2023-02-28 12:12:53"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//this code goes through each Subdivsion on a daily basis and queries all Lots and writes the daily values to the following fields 
										//1. Subdivision.Lots_Sold
										//2. Subdivision.Total_Lots
										//3. Subdivision.Last_Sold_Date
										status = "Sold";
										for each  subdiv in Subdivision[Status != "Forecast Placeholder"]
										{
											lotsSold = Lots[ID != 0 && Phase == subdiv.Phase && Status == status && Subdivision == subdiv.ID && Model = FALSE];
											lotsPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model = FALSE];
											futureForecasted = Forecast[Subdivision1 == subdiv && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots);
											lotsLatestsold = Lots[ID != 0 && Phase == subdiv.Phase && Status == status && Subdivision == subdiv.ID && Model = FALSE].maximum(Close_Date);
											lotCount = lotsSold.count(ID);
											lotTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model = FALSE];
											lotsTotal2 = lotTotal.count(ID);
											subdiv.Lots_Sold=lotCount;
											subdiv.Total_Lots=lotsTotal2;
											subdiv.Last_Sold_Date=lotsLatestsold;
											subdiv.Unforecasted_Lots=lotTotal.count(ID) - lotsPurchased.count(ID) - futureForecasted;
										}
					)
					}
				}
			}
			Update_Lot_Count_Builder_ as "Update Lot Count - Builder Takedown"
			{
				type =  schedule
				start = "2023-08-08 05:28:57"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//Goes through every Builder Takedown every day and counts number of Lots and writes that value to Lot_Count
										for each  btd in Builder_Takedown[ID != 0]
