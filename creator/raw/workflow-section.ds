			Set_Next_Action_Date_Cont as "Set Next Action Date - Contract"
			{
				type =  form
				form = Contract

				record event = on add or edit

				on user input of Contract_Actions.Complete
				{
					actions 
					{
						custom deluge script
						(
											// This fires the moment the user checks (or un-checks) the “Complete” box
										// on the CURRENT sub-form row ─ that row is referenced by the keyword `row`.
										if(row.Complete == true)
										{
											row.Complete_Date=zoho.currentdate;
											// only act when it is just marked complete
											/*  Walk the sub-form rows in the order they appear on screen.
										        As soon as we’ve passed the current row, grab the first
										        row that is NOT complete and stamp today’s date into Start_Date.   */
											passedCurrent = false;
											// flag to know we’ve hit THIS row
											for each  nextRow in input.Contract_Actions
											{
												// every visible sub-form row
												if(passedCurrent)
												{
													// we’re looking *after* the row the user just completed
													if(nextRow.Complete != true)
													{
														// found the first unfinished row
														if(nextRow.Start_Date == NULL)
														{
															// found the first unfinished row
															nextRow.Start_Date=zoho.currentdate;
															break;
														}
													}
												}
												// Is this iteration the row the user just changed?
												if(nextRow.ID == row.ID)
												{
													// compare row IDs – safer than object comparison
													passedCurrent = true;
													// everything after this is “next”
												}
											}
										}
						)
					}
				}

			}
