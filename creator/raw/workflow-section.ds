			Set_Months_from_Start_Pha as "Set Months from Start Phase - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on user input of Budget_Items.Start_Phase
				{
					actions 
					{
						custom deluge script
						(
											if(Deparment == "Construction")
										{
											pfPhase = Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma && Phase == row.Start_Phase];
											row.Start_Month=pfPhase.Const_Start_Month;
										}
										if(Deparment == "Development" || Deparment == "Engineering")
										{
											pfPhase = Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma && Phase == row.Start_Phase];
											row.Start_Month=pfPhase.Eng_Start_Month;
										}
						)
					}
				}

			}
