			Pop_Lot_Pricing_Subform_C as "Pop Lot Pricing Subform - Contract"
			{
				type =  form
				form = Contract

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											lotSizes = List();
										for each  lot in input.Lots1
										{
											lotSizes.add(lot.Lot_Size);
										}
										unqSizes = lotSizes.distinct().sort();
										for each  size in unqSizes
										{
											pricingRow = Contract.Pricing();
											pricingRow.Lot_Size=size;
											input.Pricing.insert(pricingRow);
										}
						)
					}
				}

			}
