			Check_for_Dates_Builder_T as "Check for Dates - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Date1_1 != null && Date1_2 == null)
										{
