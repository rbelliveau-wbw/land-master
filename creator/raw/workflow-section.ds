			Mass_Create_Tax_Parcel_Ye1 as "Mass Create Tax Parcel Years - Property"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										subdiv = input.Subdivision.size();
										property = input.Property1.size();
										for each  taxRate1 in input.Tax_Rates
										{
											totalTaxrate = totalTaxrate + taxRate1.Tax_Rate;
										}
										if(property != 0)
										{
											for each  prop in Property[ID == input.Property1]
											{
												tpy = insert into Tax_Parcel_Year
												[
													Tax_Parcel_Year_Code=prop.Common_Name + "-" + input.Year1
													Property1=prop.ID
													Added_User=zoho.loginuser
													Tax_Year=input.Year1
													Taxing_Jurisdiction1=input.Taxing_Jurisdiction2
													Tax_Rates=input.Tax_Rates
													Cumulative_Tax_Rate=totalTaxrate
												];
											}
										}
						)
					}
				}

			}
			Send_Email_Form_Propertie1 as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Mass_Create_Tax
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : "Land Master : New entry added"
							message : "Hello,<br/><br/>A new entry added in 'Mass Create Tax' form of 'Land Master' application.<br/>"
							attachments : template : _default as inline
						)
					}
				}
			}
