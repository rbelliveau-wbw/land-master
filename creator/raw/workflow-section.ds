			Check_for_Missing_Lot_Dat as "Check for Missing Lot Data - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  lot in input.Lots
										{
											if(lot.On_Hold == TRUE)
											{
												alert lot.Lot_Code + " is on hold and cannot be submitted in a Builder Takedown.";
												cancel submit;
											}
											if(lot.Base_Price == null)
											{
												alert "One or more lots is missing a base price.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Clear_Lot_Fields_if_Remov as "Clear Lot Fields if Removed - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											oldLots = old.Lots;
										newLots = input.Lots;
										if(oldLots != newLots)
										{
											lotIntersect = oldLots.intersect(newLots);
											for each  lot in oldLots
											{
												if(lotIntersect.contains(lot) = FALSE)
												{
													updateLot = Lots[ID == lot].ID.getAll();
													for each  newLot in Lots[ID == updateLot]
													{
														newLot.Total_Tax=null;
														newLot.Total=null;
														newLot.Interest1=null;
														newLot.Purchase_Date=null;
														newLot.Purch_Date_Text=null;
														newLot.Entered_Date=null;
														newLot.Entered_Date_Text=null;
														newLot.Close_Date=null;
														newLot.Close_Date_Text=null;
														newLot.WBW_Tax=null;
														newLot.Builder_Tax=null;
														newLot.Status="Open";
													}
												}
											}
										}
						)
					}
				}

			}
			Create_Template_from_Firs as "Create Template from First Takedown - Builder Take"
			{
				type =  form
				form = Builder_Takedown

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											tdTemplate = Takedown_Template[Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1];
										//create collection of additional items
										itemsColl = Collection();
										// for each Additional_Items subform entry in the input
										for each  item in input.Additional_Items
										{
											// 1) create an empty subform-row object
											addlItem = Takedown_Template.Additional_Items();
											// 2) copy across the fields
											addlItem.Item_Type=item.Item_Type;
											addlItem.Name=item.Name;
											addlItem.Quantity=item.Quantity;
											addlItem.Amount=item.Amount;
											addlItem.Total=item.Total;
											// 3) add it to your collection
											itemsColl.insert(addlItem);
										}
										//if there is no TD Template existing create one withe the values input on the Builder Takedown
										if(tdTemplate.count() = 0)
										{
											//create Takedown Template with fields from Builder Takedown
											insert into Takedown_Template
											[
												Additional_Items=itemsColl
												Added_User=zoho.loginuser
												Builder1=input.Builder1
												Name=input.Subdivision1.Subdivision_Code + " - " + input.Builder1.Builder_Name
												Subdivision1=input.Subdivision1
												Tax_Method=input.Tax_Method
												Tax_Status=input.Tax_Status
												Tax_Per_Lot=input.Tax_Per_Lot
												Percent_of_Appraisal=input.Percent_of_Appraisal
												Additional_Fee_Type=input.Additional_Fee_Type
												Additional_Fee=input.Additional_Fees_Per_Lot
												DRH_Subtract_Day=input.DRH_Subtract_Day
												Subtract_Day_From=input.Subtract_Day_From
												Interest_Rate_1=input.Interest_Rate_1
												Interest_Rate_2=input.Interest_Rate_2
												Interest_Rate_3=input.Interest_Rate_3
												Interest_Rate_4=input.Interest_Rate_4
												Interest_Rate_5=input.Interest_Rate_5
												Interest_Rate_6=input.Interest_Rate_6
												Interest_Rate_7=input.Interest_Rate_71
												Interest_Rate_8=input.Interest_Rate_8
												Interest_Rate_9=input.Interest_Rate_9
												Interest_Rate_10=input.Interest_Rate_10
												Interest_Rate_11=input.Interest_Rate_11
												Interest_Rate_12=input.Interest_Rate_12
												To_1=input.Date1_2
												To_2=input.Date2_2
												To_3=input.Date3_2
												To_4=input.Date4_2
												To_5=input.Date5_2
												To_6=input.Date6_2
												To_7=input.Date7_2
												To_8=input.Date8_2
												To_9=input.Date9_2
												To_10=input.Date10_2
												To_11=input.Date11_2
												To_12=input.Date12_2
												From_1=input.Date1_1
												From_2=input.Date2_1
												From_3=input.Date3_1
												From_4=input.Date4_1
												From_5=input.Date5_1
												From_6=input.Date6_1
												From_7=input.Date7_1
												From_8=input.Date8_1
												From_9=input.Date9_1
												From_10=input.Date10_1
												From_11=input.Date11_1
												From_12=input.Date12_1
											]
										}
						)
					}
				}

