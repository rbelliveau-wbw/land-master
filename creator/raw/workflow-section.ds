											parentBudget.Add_l_Grand_Total=addlTotalsum;
										}
						)
					}
				}

			}
			Generate_Budget_Months_Bu as "Generate Budget Months - Budget"
			{
				type =  form
				form = Add_Budget

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Define markup values as variables
										engineeringMarkup = 1 + input.Subdivision1.Engineering_Markup / 100;
										engineeringSubMarkup = 1 + input.Subdivision1.Engineering_Sub_Markup / 100;
										constructionMarkup = 1 + input.Subdivision1.Construction_Markup / 100;
										constructionSubMarkup = 1 + input.Subdivision1.Construction_Sub_Markup / 100;
										capitalCostMarkup = input.Subdivision1.Capital_Cost / 100;
										pointsRate = input.Subdivision1.Points / 100;
										adminRate = input.Subdivision1.Admin_Cost / 100;
										profitShare = input.Subdivision1.Profit_Share / 100;
										// Step 1: Retrieve the necessary dates and length from the Subdivision record
										liLandPurchaseDate = input.LI_Land_Purchase_Date;
										constructionStartDate = input.Construction_Start;
										engineeringCost = input.Engineering_Costs;
										subcontractEngineeringCost = input.Subcontract_Engineering_Costs;
										// Step 2: Calculate months up to Construction Start Date
										monthsUpToConstruction = monthsBetween(liLandPurchaseDate,constructionStartDate) + 1;
										latestSolddate = Lots[Close_Date != null && Subdivision == input.Subdivision1].maximum(Close_Date);
										earliestSolddate = Lots[Close_Date != null && Subdivision == input.Subdivision1].minimum(Close_Date);
										totalRevenue = Lots[Close_Date != null && Subdivision == input.Subdivision1].sum(Total);
										// Step 3: Calculate months up to latestSoldDate
										monthsUpToLatestSold = ceil(daysBetween(liLandPurchaseDate,latestSolddate) / 30);
										// Add 1 to include the month of the latest sold date
										monthsUpToEarliestSold = monthsBetween(liLandPurchaseDate,earliestSolddate);
										// Add 1 to include the month of the earliest sold date
										// Step 4: Generate a counter list for months up to the latest sold date (include the months leading to the latest sold date)
										cyclesUpToConstruction = monthsUpToConstruction;
										cyclesForConstruction = input.Construction_Length_Months;
										constructionEnd = cyclesUpToConstruction + cyclesForConstruction;
										totalCycles = monthsUpToLatestSold;
										// Adjust totalCycles to include months up to earliestSolddate
										totalCount = leftpad("1",totalCycles).replaceAll(" ","1,").toList();
										totalCountnumber = totalCount.size();
										// Adjust for 1-based indexing from leftpad
										prevCtd = 0;
										cashFlow = 0;
										wbConstcost = input.Construction_Cost - input.Subcontract_Construction_Cost;
										wbconstcostSplit = wbConstcost / input.Construction_Length_Months * constructionMarkup;
										subconstcostSplit = input.Subcontract_Construction_Cost / input.Construction_Length_Months * constructionSubMarkup;
										// Step 5: Loop through each month up to the latest sold date and create Budget Month records
										for each index i in totalCount
										{
											engineeringCostSplit = 0;
											subcontractEngineeringCostSplit = 0;
											constructionCost = 0;
											subcontconstCost = 0;
											landCost = 0;
											budgetCost = 0;
											points = 0;
											devcostSplit = 0;
											otherRevenuesplit = 0;
											carryCharge = cashFlow * capitalCostMarkup / 12;
											monthIndex = i;
											// Adjust for 1-based indexing from leftpad
											if(monthIndex == 0)
											{
												landCost = input.LI_Land_Cost * -1;
												// Make it negative
												budgetCost = (input.LI_Land_Cost + wbConstcost * constructionMarkup + input.Subcontract_Construction_Cost * constructionSubMarkup + input.Engineering_Costs * engineeringMarkup + input.Subcontract_Engineering_Costs * engineeringSubMarkup + input.Development_Direct_Costs) * -1;
												points = budgetCost * pointsRate;
											}
											// Adjust for 1-based indexing from leftpad
											if(monthIndex != 0 && monthIndex <= cyclesUpToConstruction - 1)
											{
												// Split Engineering and Subcontract Engineering Costs for months up to Construction Start Date IF not first month
												engineeringCostSplit = engineeringCost / (monthsUpToConstruction - 1) * -1 * engineeringMarkup;
												// Make it negative
												subcontractEngineeringCostSplit = subcontractEngineeringCost / (monthsUpToConstruction - 1) * -1 * engineeringSubMarkup;
												// Make it negative
											}
											if(cyclesUpToConstruction <= monthIndex && constructionEnd > monthIndex)
											{
												constructionCost = wbconstcostSplit * -1;
												// Make it negative
												subcontconstCost = subconstcostSplit * -1;
												// Make it negative
											}
											if(monthIndex != 0 && monthsUpToEarliestSold > monthIndex)
											{
												// Adjust the condition to stop before the earliest sale date
												devcostSplit = input.Development_Direct_Costs / (monthsUpToEarliestSold - 1) * -1;
												// Make it negative
											}
											if(monthIndex != 0 && monthsUpToEarliestSold <= monthIndex && input.Other_Revenue != null)
											{
												// Adjust the condition to stop before the earliest sale date
												otherRevenuesplit = input.Other_Revenue / (totalCycles - monthsUpToEarliestSold);
												// Make it negative
											}
											// Calculate the Start Date for each month (start at the 1st of the month)
											budgetMonthStart = addMonth(liLandPurchaseDate,monthIndex);
											budgetMonthStart = (budgetMonthStart.month() + "/01/" + budgetMonthStart.year()).toDate();
											// Calculate the last day of the month for the Start Date month
											lastDayOfMonth = addDay(addMonth(budgetMonthStart,1),-1);
											// Query for lots sold this month and sum the total
											revenueQuery = Lots[Close_Date >= budgetMonthStart && Close_Date <= lastDayOfMonth && Subdivision == input.Subdivision1].sum(Total);
											// Calculate total cost for the month
											totalCost = points + constructionCost + subcontconstCost + engineeringCostSplit + subcontractEngineeringCostSplit + devcostSplit + landCost;
											adminCost = totalRevenue * adminRate / totalCountnumber * -1;
											finalCost = totalCost + carryCharge + adminCost;
											profit = totalCost + revenueQuery + carryCharge + adminCost + otherRevenuesplit;
											// Insert Budget Month record with negative values
											budgetMonth = insert into Budget_Months
											[
												Start_Date=budgetMonthStart
												End_Date=lastDayOfMonth
												Month_No=monthIndex + 1
												Added_User=zoho.loginuser
												Subdivision=input.Subdivision1
												Budget=input.ID
												Land_Cost=landCost
												Budget_Cost=budgetCost
												Points=points
												Construction_Cost=constructionCost
												Subcontract_Construction_Cost=subcontconstCost
												Engineering_Cost=engineeringCostSplit
												Subcontract_Engineering_Cost=subcontractEngineeringCostSplit
												Development_Cost=devcostSplit
												Total_Cost=totalCost
												Cost_to_Date=totalCost + prevCtd
												Revenue=revenueQuery
												Cash_Flow=totalCost + revenueQuery + cashFlow
												Carry_Charge=carryCharge
												Admin_Cost=adminCost
												Final_Cost=finalCost
												Other_Revenue=otherRevenuesplit
												Profit=profit
												Profit_Share=profit * profitShare
											];
											prevCtd = totalCost + prevCtd;
											cashFlow = totalCost + revenueQuery + cashFlow;
										}
						)
					}
				}

			}
