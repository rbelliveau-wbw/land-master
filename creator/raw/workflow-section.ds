						custom deluge script
						(
											if(Builder_Override.size() == 0 && Status == "Planning")
										{
											for each  year in input.Forecast_Year
											{
												//set variables for Forecast Year input and Forecast Year plus one
												forecastYear = year;
												fcYearplusone = forecastYear.toNumber() + 1;
												//loop code for each Subdivision chosen to create forecasts for
												for each  subdiv in input.Subdivisions
												{
													//query all Lots for number of Sold and Contracted to place on Forecast Year on creation
													lotsSold = Lots[Subdivision == subdiv && Status == "Sold" && Close_Date >= "02/01/" + forecastYear && Close_Date <= "01/31/" + fcYearplusone].count();
													lotsContracted = Lots[Subdivision == subdiv && Status == "Contracted"].count();
													//query existing Forecast Years for whether pre-existing with this Subdiv/Builder/Year combo
													fcYear = Forecast_Year[Subdivision1 == subdiv && Forecast_Year == year && Status == "Planning"];
													// if fcYear query returns 0 results, create Forecast Year & Forecasts
													if(fcYear.count() = 0)
													{
