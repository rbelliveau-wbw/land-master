			Populate_Additional_Costs as "Populate Additional Costs - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											engconstItems = Proforma_Item[Template_Item == TRUE && Department == "Construction"] sort by Cost_Code;
										for each  item in engconstItems
										{
											row = Add_Pro_Forma.Additional_Costs_Construction();
											row.Item_Name=item.Item_Name;
											row.Department=item.Department;
											row.Category=item.Category;
											row.Dept_Code=item.Dept_Code;
											row.Cost_Code=item.Cost_Code;
											row.Template_Item=false;
											//row.Budget_Code="PF" + input.PF_Number.toString() + "-" + item.Cost_Code;
											row.Department=item.Department;
											input.Additional_Costs_Construction.insert(row);
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											devItems = Proforma_Item[Template_Item == TRUE && Department == "Development" || Department == "Engineering"] sort by Cost_Code;
										for each  item in devItems
										{
											row = Add_Pro_Forma.Additional_Costs_Development();
											row.Item_Name=item.Item_Name;
											row.Department=item.Department;
											row.Category=item.Category;
											row.Dept_Code=item.Dept_Code;
											row.Cost_Code=item.Cost_Code;
											row.Template_Item=false;
											//row.Budget_Code="PF" + input.PF_Number.toString() + "-" + item.Cost_Code;
											row.Department=item.Department;
											input.Additional_Costs_Development.insert(row);
										}
						)
					}
				}

			}
			Add_l_Const_Line_Validati as "Add'l Const Line Validation - Pro Forma"
