						)
					}
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// SINGLE MAIN LOOP (FIXED + OVERHEAD OUTPUTS)
										// - Interest calc is MONTH-LEVEL (matches Excel’s single-row-per-month behavior)
										// - Interest ONLY applies if the CURRENT MONTH’S Running_Cash_Flow (BASE) will be < 0
										// - NON-MASTER rows ALWAYS show 0 for:
										//     Cash_Flow, Cash_Flow_with_Overhead, Cash_Flow_with_Interest,
										//     Running_Cash_Flow, Running_Cash_Flow_with_Interest,
										//     Interest, Profit_Share,
										//     Engineering_Overhead, Construction_Overhead, Overhead_Cost
										// - Master row always ties out to the month totals (cash + overhead + interest)
										// ======================================================
										monthRecs = Proforma_Months[Proforma == input.ID] sort by Month1;
										// currentMonthNo cannot be null; sentinel 0 means "not started yet"
										currentMonthNo = 0;
										// month totals (BASE) for the month being accumulated (across ALL rows)
										monthCashSum_Base = 0;
										// month overhead totals (across ALL rows)
										monthEngOvrhd = 0;
										monthConstOvrhd = 0;
										monthAdminOvrhd = 0;
										monthOvrhdTotal = 0;
										// rates (force decimal)
										rate = ifnull(input.Interest,0).toDecimal() / 100;
										profitRate = ifnull(input.Profit_Share,0).toDecimal() / 100;
										for each  mnth in monthRecs
										{
											// FORCE Month1 to be NUMBER so criteria comparisons work
											mnthNo = ifnull(mnth.Month1,0).toLong();
											// ------------------------------
											// INIT FIRST MONTH GROUP
											// ------------------------------
											if(currentMonthNo == 0)
											{
												currentMonthNo = mnthNo;
												monthCashSum_Base = 0;
												monthEngOvrhd = 0;
												monthConstOvrhd = 0;
												monthAdminOvrhd = 0;
												monthOvrhdTotal = 0;
											}
											// ------------------------------
											// FINALIZE PRIOR MONTH (RUNS ONCE PER MONTH GROUP)
											// ------------------------------
											if(mnthNo != currentMonthNo)
											{
												// PREV running values (from MASTER ONLY)
												prevRunning_Base = 0;
												prevRunning_WithInt = 0;
												if(currentMonthNo != 1)
												{
													prevRunning_Base = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo - 1 && Master_Month == true].sum(Running_Cash_Flow);
													prevRunning_Base = ifnull(prevRunning_Base,0);
													prevRunning_WithInt = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo - 1 && Master_Month == true].sum(Running_Cash_Flow_with_Interest);
													prevRunning_WithInt = ifnull(prevRunning_WithInt,0);
												}
												// Month Running CF (BASE)
												runningCF_Base = monthCashSum_Base;
												if(currentMonthNo != 1)
												{
													runningCF_Base = prevRunning_Base + monthCashSum_Base;
												}
												// MONTH-LEVEL interest (apply ONCE), ONLY if current month running BASE is still negative
												interestForMonth = 0;
												monthCash_WithInt = monthCashSum_Base;
												if(runningCF_Base < 0)
												{
													interestForMonth = abs(runningCF_Base * rate / 12);
													monthCash_WithInt = monthCashSum_Base - interestForMonth;
												}
												// Month Running CF (WITH INTEREST)
												runningCF_WithInt = monthCash_WithInt;
												if(currentMonthNo != 1)
												{
													runningCF_WithInt = prevRunning_WithInt + monthCash_WithInt;
												}
												// Month Cash Flow WITH OVERHEAD (month-level)
												monthCash_WithOvrhd = monthCashSum_Base - monthOvrhdTotal;
												// Write values for this month:
												loopMonthRecs = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo];
												for each  r in loopMonthRecs
												{
													if(ifnull(r.Master_Month,false) == true)
													{
														// MONTH TOTALS on Master
														r.Cash_Flow=monthCashSum_Base;
														r.Cash_Flow_with_Overhead=monthCash_WithOvrhd;
														// Overhead columns: MASTER = SUM OF THE MONTH
														r.Engineering_Overhead=monthEngOvrhd;
														r.Construction_Overhead=monthConstOvrhd;
														r.Overhead_Cost=monthAdminOvrhd;
														// Interest / Profit / Running
														r.Interest=interestForMonth;
														r.Cash_Flow_with_Interest=monthCash_WithInt;
														r.Profit_Share=monthCash_WithInt * profitRate;
														r.Running_Cash_Flow=runningCF_Base;
														r.Running_Cash_Flow_with_Interest=runningCF_WithInt;
													}
													else
													{
														// FORCE NON-MASTER OUTPUTS TO 0 (includes overhead cols)
														r.Cash_Flow=0;
														r.Cash_Flow_with_Overhead=0;
														r.Cash_Flow_with_Interest=0;
														r.Running_Cash_Flow=0;
														r.Running_Cash_Flow_with_Interest=0;
														r.Engineering_Overhead=0;
														r.Construction_Overhead=0;
														r.Overhead_Cost=0;
														r.Interest=0;
														r.Profit_Share=0;
													}
												}
												// Reset for new month group
												currentMonthNo = mnthNo;
												monthCashSum_Base = 0;
												monthEngOvrhd = 0;
												monthConstOvrhd = 0;
												monthAdminOvrhd = 0;
												monthOvrhdTotal = 0;
											}
											// ------------------------------
											// ACCUMULATE THIS RECORD INTO MONTH TOTALS (ALWAYS)
											// ------------------------------
											cashFlowRec = ifnull(mnth.Finished_Lot_Sales,0) - ifnull(mnth.Land_Cost,0) + ifnull(mnth.Land_Sale,0) - ifnull(mnth.Construction_Cost_Base,0) - ifnull(mnth.Construction_Cost_Addl,0) - ifnull(mnth.Entitlement_Engineering,0) - ifnull(mnth.Entitlement_Engineering_Addl,0) + ifnull(mnth.Reimbursements,0) + ifnull(mnth.Reimbursed_Fees,0) + ifnull(mnth.PID_MUD_Revenue,0);
											// Overhead totals must SUM across the whole month (not overwrite)
											recEngOvrhd = ifnull(mnth.Engineering_Overhead,0);
											recConstOvrhd = ifnull(mnth.Construction_Overhead,0);
											recAdminOvrhd = ifnull(mnth.Overhead_Cost,0);
											monthEngOvrhd = monthEngOvrhd + recEngOvrhd;
											monthConstOvrhd = monthConstOvrhd + recConstOvrhd;
											monthAdminOvrhd = monthAdminOvrhd + recAdminOvrhd;
											monthOvrhdTotal = monthEngOvrhd + monthConstOvrhd + monthAdminOvrhd;
											monthCashSum_Base = monthCashSum_Base + cashFlowRec;
											// ------------------------------
											// KEEP NON-MASTER ROWS CLEAN IMMEDIATELY (prevents “stale” values showing)
											// ------------------------------
											if(ifnull(mnth.Master_Month,false) != true)
											{
												mnth.Cash_Flow=0;
												mnth.Cash_Flow_with_Overhead=0;
												mnth.Cash_Flow_with_Interest=0;
												mnth.Running_Cash_Flow=0;
												mnth.Running_Cash_Flow_with_Interest=0;
												mnth.Engineering_Overhead=0;
												mnth.Construction_Overhead=0;
												mnth.Overhead_Cost=0;
												mnth.Interest=0;
												mnth.Profit_Share=0;
											}
										}
										// ------------------------------
										// FINALIZE LAST MONTH (RUNS ONCE)
										// ------------------------------
										if(currentMonthNo != 0)
										{
											prevRunning_Base = 0;
											prevRunning_WithInt = 0;
											if(currentMonthNo != 1)
											{
												prevRunning_Base = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo - 1 && Master_Month == true].sum(Running_Cash_Flow);
												prevRunning_Base = ifnull(prevRunning_Base,0);
												prevRunning_WithInt = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo - 1 && Master_Month == true].sum(Running_Cash_Flow_with_Interest);
												prevRunning_WithInt = ifnull(prevRunning_WithInt,0);
											}
											runningCF_Base = monthCashSum_Base;
											if(currentMonthNo != 1)
											{
												runningCF_Base = prevRunning_Base + monthCashSum_Base;
											}
											interestForMonth = 0;
											monthCash_WithInt = monthCashSum_Base;
											if(runningCF_Base < 0)
											{
												interestForMonth = abs(runningCF_Base * rate / 12);
												monthCash_WithInt = monthCashSum_Base - interestForMonth;
											}
											runningCF_WithInt = monthCash_WithInt;
											if(currentMonthNo != 1)
											{
												runningCF_WithInt = prevRunning_WithInt + monthCash_WithInt;
											}
											monthCash_WithOvrhd = monthCashSum_Base - monthOvrhdTotal;
											loopMonthRecs = Proforma_Months[Proforma == input.ID && Month1 == currentMonthNo];
											for each  r in loopMonthRecs
											{
												if(ifnull(r.Master_Month,false) == true)
												{
													r.Cash_Flow=monthCashSum_Base;
													r.Cash_Flow_with_Overhead=monthCash_WithOvrhd;
													// Overhead columns: MASTER = SUM OF THE MONTH
													r.Engineering_Overhead=monthEngOvrhd;
													r.Construction_Overhead=monthConstOvrhd;
													r.Overhead_Cost=monthAdminOvrhd;
													r.Interest=interestForMonth;
													r.Cash_Flow_with_Interest=monthCash_WithInt;
													r.Profit_Share=monthCash_WithInt * profitRate;
													r.Running_Cash_Flow=runningCF_Base;
													r.Running_Cash_Flow_with_Interest=runningCF_WithInt;
												}
												else
												{
													r.Cash_Flow=0;
													r.Cash_Flow_with_Overhead=0;
													r.Cash_Flow_with_Interest=0;
													r.Running_Cash_Flow=0;
													r.Running_Cash_Flow_with_Interest=0;
													r.Engineering_Overhead=0;
													r.Construction_Overhead=0;
													r.Overhead_Cost=0;
													r.Interest=0;
													r.Profit_Share=0;
												}
											}
										}
										info "Month-level cash flow + month-level overhead + month-level interest (master only) + running totals written. Non-master outputs forced to 0.";
						)
						custom deluge script
						(
											//FILL OUT RUNNING CASH FLOW + INTEREST + PROFIT SHARE
						)
					}
					actions 
					{
						custom deluge script
						(
											//TOTALS
										constCost = Proforma_Months[Proforma == input.ID].sum(Construction_Cost_Base);
										constCostaddl = Proforma_Months[Proforma == input.ID].sum(Construction_Cost_Addl);
										engCost = Proforma_Months[Proforma == input.ID].sum(Entitlement_Engineering);
										engCostaddl = Proforma_Months[Proforma == input.ID].sum(Entitlement_Engineering_Addl);
										reimbursements = Proforma_Months[Proforma == input.ID].sum(Reimbursements);
										cashFlow = Proforma_Months[Proforma == input.ID].sum(Cash_Flow);
										reimbFees = Proforma_Months[Proforma == input.ID].sum(Reimbursed_Fees);
										mudpidRev = Proforma_Months[Proforma == input.ID].sum(PID_MUD_Revenue);
										ovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Overhead_Cost);
										engovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Engineering_Overhead);
										constovrhdTotal = Proforma_Months[Proforma == input.ID].sum(Construction_Overhead);
										interestTotal = Proforma_Months[Proforma == input.ID].sum(Interest);
										profitshareTotal = Proforma_Months[Proforma == input.ID].sum(Profit_Share);
										// WRITE TO FIELDS
										input.Gross_Sales = input.Sale_Price_FF * input.Lots * input.Lot_Size_Ft;
										input.Construction_Cost_Base = input.Const_Cost_FF * input.Total_Street_LF;
										input.Construction_Cost_Addl = constCostaddl;
										input.Entitlement_Cost = input.Engineering_Cost_Lot * input.Lots;
										input.Entitlement_Engineering_Addl = engCostaddl;
										input.Total_Expenses = ifnull(input.Construction_Cost_Base,0) + ifnull(input.Construction_Cost_Addl,0) + ifnull(input.Entitlement_Cost,0) + ifnull(input.Entitlement_Engineering_Addl,0) + ifnull(input.Land_Cost,0);
										input.Reimbursements = reimbursements;
										input.Reimbursed_Fees = reimbFees;
										input.MUD_Revenue = mudpidRev;
										//input.Net_Profit = cashFlow;
										input.Total_Income = ifNull(input.Gross_Sales,0) + ifNull(input.MUD_Revenue,0) + ifNull(input.Reimbursements,0) + ifNull(input.Reimbursed_Fees,0) + ifNull(input.Land_Sale,0);
										input.Net_Profit = input.Total_Income - input.Total_Expenses;
										input.Overhead_Total = ovrhdTotal;
										input.Engineering_Overhead_Total = engovrhdTotal;
										input.Construction_Overhead_Total = constovrhdTotal;
										input.Interest_Total = interestTotal;
										input.Profit_Share_Total = profitshareTotal;
						)
					}
				}

			}
