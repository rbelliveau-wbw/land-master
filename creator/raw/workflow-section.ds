adio:checked ~ label.choice-label-text{background:#022f73!important;border-color:#022f73!important;color:#ffffff!important;box-shadow:0 3px 8px rgba(0,0,0,0.24)!important;transform:none!important;}input.zc-live-primary-btn,input.zc-live-secondary-btn,.zc-live-primary-btn,.zc-live-secondary-btn{display:none!important;}</style></div>";
