			Set_Template_Defaults_Bui as "Set Template Defaults - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ===== Builder_Takedown - On Load =====
										lotList = Lots[Takedown_Queue = TRUE];
										feeType = "";
										feeAmount = null;
										taxMethod = "";
										taxPerLot = null;
										percentAppraisal = null;
										taxStatus = "";
										drhSubtract = false;
										subDayFrom = null;
										interest1 = null;
										interest2 = null;
										interest3 = null;
										interest4 = null;
										interest5 = null;
										interest6 = null;
										interest7 = null;
										interest8 = null;
										interest9 = null;
										interest10 = null;
										interest11 = null;
										interest12 = null;
										from1 = null;
										to1 = null;
										from2 = null;
										to2 = null;
										from3 = null;
										to3 = null;
										from4 = null;
										to4 = null;
										from5 = null;
										to5 = null;
										from6 = null;
										to6 = null;
										from7 = null;
										to7 = null;
										from8 = null;
										to8 = null;
										from9 = null;
										to9 = null;
										from10 = null;
										to10 = null;
										from11 = null;
										to11 = null;
										from12 = null;
										to12 = null;
										// Get selected lots from the Lots bigintlist field
										lotRecords = Lots[ID in input.Lots];
										// Get matching Takedown Template
										tdTemplate = Takedown_Template[Subdivision1 == lotList.Subdivision && Builder1 == lotList.Builder1];
										// If template exists, use template values
										if(tdTemplate != null)
										{
											feeType = ifnull(tdTemplate.Additional_Fee_Type,"");
											feeAmount = tdTemplate.Additional_Fee;
											taxMethod = ifnull(tdTemplate.Tax_Method,"");
											taxPerLot = tdTemplate.Tax_Per_Lot;
											percentAppraisal = tdTemplate.Percent_of_Appraisal;
											taxStatus = ifnull(tdTemplate.Tax_Status,"");
											drhSubtract = ifnull(tdTemplate.DRH_Subtract_Day,false);
											subDayFrom = tdTemplate.Subtract_Day_From;
											if(tdTemplate.From_1 != null && tdTemplate.From_1 < zoho.currentdate)
											{
												interest1 = tdTemplate.Interest_Rate_1;
												interest2 = tdTemplate.Interest_Rate_2;
												interest3 = tdTemplate.Interest_Rate_3;
												interest4 = tdTemplate.Interest_Rate_4;
												interest5 = tdTemplate.Interest_Rate_5;
												interest6 = tdTemplate.Interest_Rate_6;
												interest7 = tdTemplate.Interest_Rate_7;
												interest8 = tdTemplate.Interest_Rate_8;
												interest9 = tdTemplate.Interest_Rate_9;
												interest10 = tdTemplate.Interest_Rate_10;
												interest11 = tdTemplate.Interest_Rate_11;
												interest12 = tdTemplate.Interest_Rate_12;
												from1 = tdTemplate.From_1;
												to1 = tdTemplate.To_1;
												from2 = tdTemplate.From_2;
												to2 = tdTemplate.To_2;
												from3 = tdTemplate.From_3;
												to3 = tdTemplate.To_3;
												from4 = tdTemplate.From_4;
												to4 = tdTemplate.To_4;
												from5 = tdTemplate.From_5;
												to5 = tdTemplate.To_5;
												from6 = tdTemplate.From_6;
												to6 = tdTemplate.To_6;
												from7 = tdTemplate.From_7;
												to7 = tdTemplate.To_7;
												from8 = tdTemplate.From_8;
												to8 = tdTemplate.To_8;
												from9 = tdTemplate.From_9;
												to9 = tdTemplate.To_9;
												from10 = tdTemplate.From_10;
												to10 = tdTemplate.To_10;
												from11 = tdTemplate.From_11;
												to11 = tdTemplate.To_11;
												from12 = tdTemplate.From_12;
												to12 = tdTemplate.To_12;
											}
										}
										else
										{
											// No template: use lot values
											feeType = ifnull(lotRecords.Fee_Type,"");
											feeAmount = lotRecords.Additional_Fees;
											interest1 = lotRecords.Escalator;
											from1 = lotRecords.Escalator_Start_Date;
										}
										// Text / bool / list fields
										input.Additional_Fee_Type = feeType;
										input.Tax_Method = taxMethod;
										input.Tax_Status = taxStatus;
										input.DRH_Subtract_Day = drhSubtract;
										input.Subtract_Day_From = subDayFrom;
										// Decimal fields
										input.Additional_Fees_Per_Lot = feeAmount;
										input.Tax_Per_Lot = taxPerLot;
										input.Percent_of_Appraisal = percentAppraisal;
										input.Interest_Rate_1 = interest1;
										input.Interest_Rate_2 = interest2;
										input.Interest_Rate_3 = interest3;
										input.Interest_Rate_4 = interest4;
										input.Interest_Rate_5 = interest5;
										input.Interest_Rate_6 = interest6;
										input.Interest_Rate_71 = interest7;
										input.Interest_Rate_8 = interest8;
										input.Interest_Rate_9 = interest9;
										input.Interest_Rate_10 = interest10;
										input.Interest_Rate_11 = interest11;
										input.Interest_Rate_12 = interest12;
										// Date-time fields
										input.Date1_1 = from1;
										input.Date1_2 = to1;
										input.Date2_1 = from2;
										input.Date2_2 = to2;
										input.Date3_1 = from3;
										input.Date3_2 = to3;
										input.Date4_1 = from4;
										input.Date4_2 = to4;
										input.Date5_1 = from5;
										input.Date5_2 = to5;
