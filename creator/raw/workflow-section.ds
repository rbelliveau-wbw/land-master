			Add_l_Dev_Line_Validation as "Add'l Dev Line Validation - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Additional_Costs_Development.Add_l_Cost
				{
					actions 
					{
						custom deluge script
						(
											if(row.Add_l_Cost != NULL && row.Category != "Reimbursements")
										{
											enable row.Cost_Application;
										}
										if(row.Add_l_Cost != NULL && row.Category == "Reimbursements" && row.Item_Name.contains("Impact Fees") == FALSE)
										{
											enable row.Start_Phase;
											enable row.End_Phase;
											show row.Start_Month;
											show row.End_Month;
											enable row.Start_Month;
											enable row.End_Month;
										}
						)
					}
				}

			}
