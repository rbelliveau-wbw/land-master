			System_Search_Subdivision as "System Search - Subdivision"
			{
				type =  form
				form = System_Search

				record event = on add or edit

				on user input of Subdivision1
				{
					actions 
					{
						custom deluge script
						(
											companyName = "";
										countyName = "";
										projectName = "";
										cityName = "";
										showInactive = "";
										subProjname = "";
										searchAll = "";
										subdivName = "";
										takedownName = "";
										tdProjname = "";
										//searchName = "";
										if(input.Search_All != "")
										{
											//companyName = "Company1=" + input.Search_All + "&Company1_op=26";
											projectName = "&Project_Name=" + input.Search_All + "&Project_Name_op=26";
											subProjname = "&Project=" + input.Search_All + "&Project_op=26";
											takedownName = "&Subdivision=" + input.Search_All + "&Subdivision_op=26";
										}
										if(input.Company1 != null)
										{
											companyName = "Company1=" + Company[ID == input.Company1].Company_Name;
											subdivName = ("&&Subdivision_Name=[" + Project[Company1 == input.Company1].Project_Name.getAll() + "]") + "&Subdivision_Name_op=26";
										}
										if(input.Project1.isEmpty() = false)
										{
											projectName = "&&Project_Name=" + Project[ID == input.Project1].Project_Name;
											subProjname = "&&Project=" + Project[ID == input.Project1].Project_Name;
											takedownName = "&Subdivision=" + Project[ID == input.Project1].Project_Name + "&Subdivision_op=26";
										}
										if(input.County.isEmpty() = false)
										{
											countyName = "&&County=[" + input.County + "]";
										}
										if(input.City.isEmpty() = false)
										{
											cityName = "&&City=[" + input.City + "]";
										}
										if(input.Subdivision1.isEmpty() = false)
										{
											projectName = "&&Project_Name=[" + Subdivision[ID == input.Subdivision1].Project.Project_Name + "]";
											takedownName = "&&Subdivision=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
											subdivName = "&&Subdivision_Name=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
											//takedownName = "&&Takedown_Schedule_Code=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name + "]";
										}
										if(input.Show_Inactive = FALSE)
										{
											showInactive = "&&Status=Active";
											//showInactivetd = "&&Status=Completed";
										}
										if(input.Show_Inactive = TRUE)
										{
											showInactive = "";
											//showInactivetd = "&&Status=Completed";
										}
										//Create the URL to filter down the Projects list
										projectsUrl = zoho.appuri + "view-embed/All_Projects?";
										queryUrl = projectsUrl + companyName + countyName + projectName + cityName + showInactive;
										openUrl(queryUrl,"iframe","frame12");
										info queryUrl;
										//Create the URL to filter down the Subdivisions list
										subdivisionsUrl = zoho.appuri + "view-embed/All_Subdivisions?";
										queryUrl = subdivisionsUrl + companyName + countyName + subProjname + cityName + showInactive + subdivName;
										openUrl(queryUrl,"iframe","frame13");
										info queryUrl;
										//Create the URL to filter down the Takedown_Schedules list
										takedownsUrl = zoho.appuri + "view-embed/All_Takedown_Schedules?";
										queryUrl = takedownsUrl + tdProjname + takedownName;
										openUrl(queryUrl,"iframe","frame14");
										info queryUrl;
						)
					}
				}

			}
