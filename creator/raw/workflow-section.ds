			Generate_Planning_Forecas as "Generate Planning Forecasts - Subdivision"
			{
				type =  form
				form = Subdivision

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Generate_Forecasts == TRUE)
										{
											// Step 1: Get the current year
											currentYear = zoho.currentdate.getYear();
											// Step 2: Create a list with 10 placeholders
											dummyList = leftpad(" ",15).replaceAll(" ",",").toList();
											// Step 3: Initialize an empty list to store year strings
											yearList = List();
											// Step 4: Iterate through the dummy list to populate yearList
											for each  index in dummyList
											{
												yearList.add(currentYear.toString());
												fcYear = Forecast_Year[Subdivision1 == input.ID && Forecast_Year == currentYear.toString() && Status == "Planning"];
												// if fcYear query returns 0 results, create Forecast Year & Forecasts
												if(fcYear.count() = 0)
												{
													insert into Forecast_Year
													[
														Subdivision1=input.ID
														Forecast_Year=currentYear.toString()
														Forecast_Name=input.Subdivision_Code + " - " + "Planning" + " - FC" + currentYear.toString()
														Status="Planning"
														Subdivision_Code=input.Subdivision_Code
														Full_Year_Forecast=0
														Added_User=zoho.loginuser
													]
												}
												currentYear = currentYear + 1;
											}
											// Step 5: Output the list of years
											info yearList;
										}
										input.Generate_Forecasts = FALSE;
										input.Unlock = FALSE;
						)
					}
				}

			}
			Calc_Addl_Line_Items_Take as "Calc Addl Line Items - Takedown Template"
			{
				type =  form
				form = Takedown_Template

				record event = on add or edit

				on user input of Additional_Items.Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(row.Amount != null && row.Quantity != null && row.Item_Type == "Addition")
										{
											row.Total=row.Amount * row.Quantity;
										}
										if(row.Amount != null && row.Quantity != null && row.Item_Type == "Deduction")
										{
											row.Total=row.Amount * row.Quantity * -1;
										}
						)
					}
				}

			}
			Load_Template_Addl_Items_ as "Load Template Addl Items - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											tdTemplate = Takedown_Template[Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1].ID;
										if(tdTemplate != null)
										{
											info tdTemplate;
											for each  addlItem in Additional_Items[Takedown_Template1 == tdTemplate && Takedown_Template1 != null]
											{
												row = Builder_Takedown.Additional_Items();
												row.Item_Type=addlItem.Item_Type;
												row.Name=addlItem.Name;
												row.Amount=addlItem.Amount;
												row.Quantity=addlItem.Quantity;
												row.Total=addlItem.Total;
												input.Additional_Items.insert(row);
											}
										}
										if(tdTemplate == null)
										{
											for each  addlItem in Additional_Items[Subdivision1 == input.Subdivision1]
											{
												row = Builder_Takedown.Additional_Items();
												row.Item_Type=addlItem.Item_Type;
												row.Name=addlItem.Name;
												row.Amount=addlItem.Amount;
												row.Quantity=addlItem.Quantity;
												row.Total=addlItem.Total;
												input.Additional_Items.insert(row);
											}
										}
						)
					}
				}

			}
