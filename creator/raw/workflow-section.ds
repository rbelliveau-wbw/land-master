										}
										if(input.Buyer.isEmpty() = false)
										{
											lotBuyer = "&&Builder1=[" + Builder[ID == input.Buyer].Builder_Name.getAll() + "]";
										}
										if(input.Status.isEmpty() = false)
										{
											lotStatus = "&&Status=[" + input.Status + "]";
										}
										if(input.County.isEmpty() = false)
										{
											lotCounty = "&&County=[" + input.County + "]";
										}
										if(input.City.isEmpty() = false)
										{
											lotCity = "&&City=[" + input.City + "]";
										}
										if(input.Subdivision1.isEmpty() = false)
										{
											subdivName = "&&Subdivision=[" + Subdivision[ID == input.Subdivision1].Subdivision_Name.getAll() + "]";
										}
										if(input.Base_Price.isEmpty() = false)
										{
											basePrice = "&&Base_Price=" + input.Base_Price;
										}
										if(input.Lot_No.isEmpty() = false)
										{
											lotNo = "&&Lot_Number=" + input.Lot_No;
										}
										if(input.Block.isEmpty() = false)
										{
											block = "&&Block=[" + input.Block + "]";
										}
										if(input.Spreadsheet_View = TRUE)
										{
											reportName = "All_Active_Lots?";
										}
										lotsUrl = zoho.appuri + "view-embed/" + reportName;
										queryUrl = lotsUrl + lotCode + lotBuyer + lotStatus + lotCity + lotCounty + subdivName + basePrice + lotNo + block + monthQuery;
										openUrl(queryUrl,"iframe","frame16");
										info queryUrl;
										info lotStatus;
						)
					}
				}

			}
