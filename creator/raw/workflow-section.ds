						(
											html = "";
										html = html + "<style>";
										html = html + ".fm-blank-wrap{font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;padding:14px;border:1px solid #d9deea;border-radius:14px;}";
										html = html + ".fm-blank{background:#ffffff;border:1px dashed #c8d3e6;border-radius:16px;padding:42px 28px;text-align:center;box-shadow:0 8px 24px rgba(28,49,94,.06);}";
										html = html + ".fm-blank-title{font-size:22px;font-weight:700;color:#1f2a44;margin-bottom:8px;}";
										html = html + ".fm-blank-sub{font-size:14px;color:#667089;line-height:1.5;max-width:520px;margin:0 auto;}";
										html = html + ".fm-blank-badge{display:inline-block;margin-top:16px;padding:8px 12px;border-radius:999px;background:#eef4ff;border:1px solid #d7e5ff;color:#0d5bd7;font-size:12px;font-weight:700;}";
										html = html + "</style>";
