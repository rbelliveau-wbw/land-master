			Create_Forecasts_Mass_Cre as "Create Forecasts - Mass Create Forecasts"
			{
				type =  form
				form = Mass_Create_Forecasts

				record event = on add

				on success
				{
					actions  (Status == "Builder")
					{
						custom deluge script
						(
											if(Builder_Override.size() == 0)
										{
											for each  year in input.Forecast_Year
											{
												//set variables for Forecast Year input and Forecast Year plus one
												forecastYear = year;
												fcYearplusone = forecastYear.toNumber() + 1;
												//loop code for each Subdivision chosen to create forecasts for
												for each  subdiv in input.Subdivisions
												{
													//loop code again for each Builder assigned  to each Subdivision record
													for each  builder in subdiv.Builders
													{
														//query all Lots for number of Sold and Contracted to place on Forecast Year on creation
														lotsSold = Lots[Subdivision == subdiv && Builder1 == builder && Status == "Sold" && Close_Date >= "02/01/" + forecastYear && Close_Date <= "01/31/" + fcYearplusone].count();
														lotsContracted = Lots[Subdivision == subdiv && Builder1 == builder && Status == "Contracted"].count();
														//set values for each  month to place into Forecast Months when created
														jan = Forecast_Year.Forecast_Months();
														jan.Forecast_Month="January";
														jan.Forecast_Year=year;
														jan.Forecast_Start_Date="01/01/" + fcYearplusone;
														jan.Builder1=builder;
														jan.Subdivision1=subdiv;
														feb = Forecast_Year.Forecast_Months();
														feb.Forecast_Month="February";
														feb.Forecast_Year=year;
														feb.Forecast_Start_Date="02/01/" + year;
														feb.Builder1=builder;
														feb.Subdivision1=subdiv;
														mar = Forecast_Year.Forecast_Months();
														mar.Forecast_Month="March";
														mar.Forecast_Year=year;
														mar.Forecast_Start_Date="03/01/" + year;
														mar.Builder1=builder;
														mar.Subdivision1=subdiv;
														apr = Forecast_Year.Forecast_Months();
														apr.Forecast_Month="April";
														apr.Forecast_Year=year;
														apr.Forecast_Start_Date="04/01/" + year;
														apr.Builder1=builder;
														apr.Subdivision1=subdiv;
														may = Forecast_Year.Forecast_Months();
														may.Forecast_Month="May";
														may.Forecast_Year=year;
														may.Forecast_Start_Date="05/01/" + year;
														may.Builder1=builder;
														may.Subdivision1=subdiv;
														jun = Forecast_Year.Forecast_Months();
														jun.Forecast_Month="June";
														jun.Forecast_Year=year;
														jun.Forecast_Start_Date="06/01/" + year;
														jun.Builder1=builder;
														jun.Subdivision1=subdiv;
														jul = Forecast_Year.Forecast_Months();
														jul.Forecast_Month="July";
														jul.Forecast_Year=year;
														jul.Forecast_Start_Date="07/01/" + year;
														jul.Builder1=builder;
														jul.Subdivision1=subdiv;
														aug = Forecast_Year.Forecast_Months();
														aug.Forecast_Month="August";
														aug.Forecast_Year=year;
														aug.Forecast_Start_Date="08/01/" + year;
														aug.Builder1=builder;
														aug.Subdivision1=subdiv;
														sep = Forecast_Year.Forecast_Months();
														sep.Forecast_Month="September";
														sep.Forecast_Year=year;
														sep.Forecast_Start_Date="09/01/" + year;
														sep.Builder1=builder;
														sep.Subdivision1=subdiv;
														oct = Forecast_Year.Forecast_Months();
														oct.Forecast_Month="October";
														oct.Forecast_Year=year;
														oct.Forecast_Start_Date="10/01/" + year;
														oct.Builder1=builder;
														oct.Subdivision1=subdiv;
														nov = Forecast_Year.Forecast_Months();
														nov.Forecast_Month="November";
														nov.Forecast_Year=year;
														nov.Forecast_Start_Date="11/01/" + year;
														nov.Builder1=builder;
														nov.Subdivision1=subdiv;
														dec = Forecast_Year.Forecast_Months();
														dec.Forecast_Month="December";
														dec.Forecast_Year=year;
														dec.Forecast_Start_Date="12/01/" + year;
														dec.Builder1=builder;
														dec.Subdivision1=subdiv;
														//create collection of months to easily insert into Forecast Year subform
														months = Collection();
														months.insert(feb,mar,apr,may,jun,jul,aug,sep,oct,nov,dec,jan);
														//query existing Forecast Years for whether pre-existing with this Subdiv/Builder/Year combo
														fcYear = Forecast_Year[Subdivision1 == subdiv && Builder1 == builder && Forecast_Year == year];
														// if fcYear query returns 0 results, create Forecast Year & Forecasts
														if(fcYear.count() = 0)
														{
															insert into Forecast_Year
															[
																Status=input.Status
																Subdivision1=subdiv
																Builder1=builder
																Forecast_Year=year
																Forecast_Name=subdiv.Subdivision_Code + " - " + builder.Builder_Name + " - FC" + year
																Subdivision_Code=subdiv.Subdivision_Code
																Forecast_Months=months
																Full_Year_Forecast=0
																Total_Sold_Lots=lotsSold
																Total_Contracted_Lots=lotsContracted
																Added_User=zoho.loginuser
															]
														}
													}
												}
											}
											openUrl("#Script:page.parent.refresh ","parent window");
										}
										if(Builder_Override.size() != 0)
										{
											for each  year in input.Forecast_Year
											{
												//set variables for Forecast Year input and Forecast Year plus one
												forecastYear = year;
												fcYearplusone = forecastYear.toNumber() + 1;
												//loop code for each Subdivision chosen to create forecasts for
												for each  subdiv in input.Subdivisions
												{
													//loop code again for each Builder assigned  to each Subdivision record
													for each  builder in input.Builder_Override
													{
														//query all Lots for number of Sold and Contracted to place on Forecast Year on creation
														lotsSold = Lots[Subdivision == subdiv && Builder1 == builder && Status == "Sold" && Close_Date >= "02/01/" + forecastYear && Close_Date <= "01/31/" + fcYearplusone].count();
														lotsContracted = Lots[Subdivision == subdiv && Builder1 == builder && Status == "Contracted"].count();
														//set values for each  month to place into Forecast Months when created
														jan = Forecast_Year.Forecast_Months();
														jan.Forecast_Month="January";
														jan.Forecast_Year=year;
														jan.Forecast_Start_Date="01/01/" + fcYearplusone;
														jan.Builder1=builder;
														jan.Subdivision1=subdiv;
														feb = Forecast_Year.Forecast_Months();
														feb.Forecast_Month="February";
														feb.Forecast_Year=year;
														feb.Forecast_Start_Date="02/01/" + year;
														feb.Builder1=builder;
														feb.Subdivision1=subdiv;
														mar = Forecast_Year.Forecast_Months();
														mar.Forecast_Month="March";
														mar.Forecast_Year=year;
														mar.Forecast_Start_Date="03/01/" + year;
														mar.Builder1=builder;
														mar.Subdivision1=subdiv;
														apr = Forecast_Year.Forecast_Months();
														apr.Forecast_Month="April";
														apr.Forecast_Year=year;
														apr.Forecast_Start_Date="04/01/" + year;
														apr.Builder1=builder;
														apr.Subdivision1=subdiv;
														may = Forecast_Year.Forecast_Months();
														may.Forecast_Month="May";
														may.Forecast_Year=year;
														may.Forecast_Start_Date="05/01/" + year;
														may.Builder1=builder;
														may.Subdivision1=subdiv;
														jun = Forecast_Year.Forecast_Months();
														jun.Forecast_Month="June";
														jun.Forecast_Year=year;
														jun.Forecast_Start_Date="06/01/" + year;
														jun.Builder1=builder;
														jun.Subdivision1=subdiv;
														jul = Forecast_Year.Forecast_Months();
														jul.Forecast_Month="July";
														jul.Forecast_Year=year;
														jul.Forecast_Start_Date="07/01/" + year;
														jul.Builder1=builder;
														jul.Subdivision1=subdiv;
														aug = Forecast_Year.Forecast_Months();
														aug.Forecast_Month="August";
														aug.Forecast_Year=year;
														aug.Forecast_Start_Date="08/01/" + year;
														aug.Builder1=builder;
														aug.Subdivision1=subdiv;
														sep = Forecast_Year.Forecast_Months();
														sep.Forecast_Month="September";
														sep.Forecast_Year=year;
														sep.Forecast_Start_Date="09/01/" + year;
														sep.Builder1=builder;
														sep.Subdivision1=subdiv;
														oct = Forecast_Year.Forecast_Months();
														oct.Forecast_Month="October";
														oct.Forecast_Year=year;
														oct.Forecast_Start_Date="10/01/" + year;
														oct.Builder1=builder;
														oct.Subdivision1=subdiv;
														nov = Forecast_Year.Forecast_Months();
														nov.Forecast_Month="November";
														nov.Forecast_Year=year;
														nov.Forecast_Start_Date="11/01/" + year;
														nov.Builder1=builder;
														nov.Subdivision1=subdiv;
														dec = Forecast_Year.Forecast_Months();
														dec.Forecast_Month="December";
														dec.Forecast_Year=year;
														dec.Forecast_Start_Date="12/01/" + year;
														dec.Builder1=builder;
														dec.Subdivision1=subdiv;
														//create collection of months to easily insert into Forecast Year subform
														months = Collection();
														if(input.Status == "Builder")
														{
															months.insert(feb,mar,apr,may,jun,jul,aug,sep,oct,nov,dec,jan);
														}
														//query existing Forecast Years for whether pre-existing with this Subdiv/Builder/Year combo
														fcYear = Forecast_Year[Subdivision1 == subdiv && Builder1 == builder && Forecast_Year == year];
														// if fcYear query returns 0 results, create Forecast Year & Forecasts
														if(fcYear.count() = 0)
														{
															insert into Forecast_Year
															[
																Status=input.Status
																Subdivision1=subdiv
																Builder1=builder
																Forecast_Year=year
																Forecast_Name=subdiv.Subdivision_Code + " - " + builder.Builder_Name + " - FC" + year
																Subdivision_Code=subdiv.Subdivision_Code
																Forecast_Months=months
																Full_Year_Forecast=0
																Total_Sold_Lots=lotsSold
																Total_Contracted_Lots=lotsContracted
																Added_User=zoho.loginuser
															]
														}
													}
												}
											}
											openUrl("#Script:page.parent.refresh ","parent window");
										}
