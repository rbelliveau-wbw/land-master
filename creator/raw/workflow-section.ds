					actions 
					{
					on load
					(
						portalId = "700737166";
										orgId = "700732567";
										for each  ms in Milestones[Push_Update == true]
										{
											// === 4) Short delay to let the job initialize ===
											getUrl("https://postman-echo.com/delay/3");
											body = Map();
											body.put("end_date",ms.End_Date.toString("MM-dd-YYYY"));
											body.put("start_date",ms.Start_Date.toString("MM-dd-YYYY"));
											resp = invokeurl
											[
												url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + ms.Project_ID + "/milestones/" + ms.Milestone_ID
												type :POST
												parameters:body.toString()
												connection:"zoho_projects_connection"
											];
											info resp;
											if(resp.toString().contains(ms.Start_Date.toString("YYYY-MM-dd")) && resp.toString().contains(ms.End_Date.toString("YYYY-MM-dd")))
											{
												ms.Push_Update=false;
												info body;
												info resp;
											}
										}
					)
					}
				}
			}
			Set_Contracts_to_Archived as "Set Contracts to Archived - Contracts"
			{
				type =  schedule
				start = "2026-02-11 03:00:17"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						//ARCHIVE CONTRACTS THAT HAVE COMPLETION DATE OF 14 OR MORE DAYS IN THE PAST
										cutoffDate = zoho.currentdate.addDay(-14);
										for each  contract in Contract[Archive != true && Completion_Date != null && Completion_Date <= cutoffDate]
										{
											contract.Archive=TRUE;
										}
					)
					}
				}
			}
			Budgets_Import_Great_Plai1 as "Budgets - Import Great Plains Development Costs"
			{
				type =  schedule
				start = "2026-03-31 05:16:24"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Budget_Import_Item Upsert
										// What it does:
										// - Exports selected columns from a Zoho Analytics view.
										// - Builds a list of Subdivision codes that have Budgets.
										// - For each exported row whose JobCode is in that list:
										//     • If a Budget_Import_Item exists (by Cost_Code_ID), update Cost + Updated_Date.
										//     • Else insert a new Budget_Import_Item with mapped fields.
										// Notes:
										// - Ensure TotalActualCost is numeric (normalize if needed).
										// - Requires valid Analytics connection (zoho_analytics_connection).
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000029311186";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("WS_Job_Number_Trim");
										cols.add("Cost_Code_Number_1");
										cols.add("Cost_Code_Number_2");
										cols.add("Cost_Code_Description");
										cols.add("Total_Actuals");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each project ===
										//get all Subdiv codes that have a Budget
										budgCodes = Add_Budget[ID != 0].Subdivision_Code.getAll();
										for each  rec in rows
										{
											subdivCode = External_System_Mapping[External_Code == rec.get("WS_Job_Number_Trim") && External_System == "Great Plains"];
											if(budgCodes.contains(subdivCode.Subdivision1.Subdivision_Code))
											{
												info subdivCode;
												jobCode = ifnull(rec.get("WS_Job_Number_Trim"),"").toString().trim();
												codeBuild = rec.get("WS_Job_Number_Trim") + "-GP-" + rec.get("Cost_Code_Number_2");
												budgimpItem = Budget_Import_Item[Code == codeBuild && Data_Source == "Great Plains"];
												if(budgimpItem.count() == 1)
												{
													budgimpItem.Cost=rec.get("Total_Actuals");
													budgimpItem.Updated_Date=zoho.currentdate;
													budgimpItem.Data_Source="Great Plains";
												}
												if(budgimpItem.count() == 0)
												{
													impItem = insert into Budget_Import_Item
													[
														Data_Source="Great Plains"
														Cost=rec.get("Total_Actuals")
														Cost_Code_Description=rec.get("Cost_Code_Description")
														Code=codeBuild
														Subdivision_Code=subdivCode.Subdivision1.Subdivision_Code
														Major_Code=rec.get("Cost_Code_Number_1")
														Minor_Code=rec.get("Cost_Code_Number_2")
														Added_User=zoho.loginuser
														Cost_Code_ID=codeBuild
														Updated_Date=zoho.currentdate
													];
												}
											}
										}
					)
					}
				}
			}
			Budgets_Import_Load_CTC_C as "Budgets - Import/Load CTC & % Complete"
			{
				type =  schedule
				start = "2026-04-06 07:15:50"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// ================================================
										// Script: Analytics → Budget_Import_Item Upsert
										// What it does:
										// - Exports selected columns from a Zoho Analytics view.
										// - Builds a list of Subdivision codes that have Budgets.
										// - For each exported row whose JobCode is in that list:
										//     • If a Budget_Import_Item exists (by Cost_Code_ID), update Cost + Updated_Date.
										//     • Else insert a new Budget_Import_Item with mapped fields.
										// Notes:
										// - Ensure TotalActualCost is numeric (normalize if needed).
										// - Requires valid Analytics connection (zoho_analytics_connection).
										// ================================================
										portalId = "700737166";
										orgId = "700732567";
										workspaceId = "2107789000000003001";
										viewId = "2107789000029519084";
										// === 2) Analytics request setup ===
										headers = Map();
										headers.put("ZANALYTICS-ORGID",orgId);
										config = Map();
										config.put("responseFormat","json");
										cols = List();
										cols.add("H.Major Code");
										cols.add("H.Minor Code");
										cols.add("H.Percent Complete Display");
										cols.add("H.JobCode");
										cols.add("Projected Total");
										config.put("selectedColumns",cols);
										// === 3) Kick off the async export job ===
										params = Map();
										params.put("CONFIG",config.toString());
										resp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/views/" + viewId + "/data"
											type :GET
											parameters:params
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 4) Short delay to let the job initialize ===
										getUrl("https://postman-echo.com/delay/8");
										// === 5) Grab the jobId ===
										jobId = resp.get("data").get("jobId");
										// === 6) Fetch the completed JSON export ===
										dataResp = invokeurl
										[
											url :"https://analyticsapi.zoho.com/restapi/v2/bulk/workspaces/" + workspaceId + "/exportjobs/" + jobId + "/data?exportFormat=json"
											type :GET
											headers:headers
											connection:"zoho_analytics_connection"
										];
										// === 7) Parse the rows array ===
										rows = dataResp.get("data");
										// === 8) Loop through every analytics row and update each project ===
										extCodes = External_System_Mapping[ID != 0].Subdivision1.getAll();
										for each  rec in rows
										{
											//get subdiv code
											subdiv = External_System_Mapping[External_Code = rec.get("H.JobCode")];
											budgCheck = Add_Budget[Subdivision_Code == subdiv.Subdivision1.Subdivision_Code];
											//make item if budget exists
											if(budgCheck.count() > 0)
											{
												info subdiv.Subdivision1.Subdivision_Name;
												budgimpItem = Budget_Import_Item[Code = subdiv.Subdivision1.Subdivision_Code + '-' + rec.get("H.Minor Code") && Data_Source == "HeavyJob"];
												if(budgimpItem.count() == 1 && budgimpItem.Cost_to_Complete != rec.get("Projected Total"))
												{
													info rec;
													budgimpItem.Percent_Complete=rec.get("H.Percent Complete Display");
													budgimpItem.Cost_to_Complete=rec.get("Projected Total");
													budgimpItem.Updated_Date=zoho.currentdate;
												}
											}
										}
					)
					}
				}
			}
			Milestones_Set_Sequence_N as "Milestones - Set Sequence Number"
			{
				type =  schedule
				start = "2026-04-27 07:15:50"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						// Scheduled Function: Set Milestone Sequence by Milestone Name
										sequenceMap = Map();
										sequenceMap.put("Entitlements",1);
										sequenceMap.put("Engineering Design",2);
										sequenceMap.put("Municipal Review",3);
										sequenceMap.put("Pre-Construction",4);
										sequenceMap.put("Rough Cut",5);
										sequenceMap.put("Sewer",6);
										sequenceMap.put("Water",7);
										sequenceMap.put("Storm Drain",8);
										sequenceMap.put("Road Prep",9);
										sequenceMap.put("Dry Utilities",10);
										sequenceMap.put("Punch List",10);
										sequenceMap.put("Closeout",11);
										updatedCount = 0;
										// Change Milestones to your actual form link name if needed
										for each  ms in Milestones[Sequence == null]
										{
											milestoneName = ifnull(ms.Milestone_Name,"");
											milestoneNameLower = milestoneName.toLowerCase();
											for each  seqName in sequenceMap.keys()
											{
												seqNameLower = seqName.toLowerCase();
												if(milestoneNameLower.contains(seqNameLower))
												{
													newSequence = sequenceMap.get(seqName);
													if(ms.Sequence != newSequence)
													{
														ms.Sequence=newSequence;
														updatedCount = updatedCount + 1;
													}
													break;
												}
											}
										}
										info "Milestone sequence update complete. Updated rows: " + updatedCount;
					)
					}
				}
			}
			Contracts_Previous_Day_Ac as "Contracts - Previous Day Actions Update Digest"
			{
				type =  schedule
				start = "2026-05-06 08:00:16"
				frequency = daily
				time zone = "America/Chicago"
				on start
				{
					actions 
					{
					on load
					(
						/********* DAILY PUBLIC CREATED / MODIFIED CONTRACT ACTION EMAIL *********/
										settings = Settings[ID != 0];
										// Change this field name if your Settings field is different
										vRecipients = ifnull(settings.Receive_Legal_Notifications,"");
										if(vRecipients != "")
										{
											vYesterday = zoho.currentdate.addDay(-1);
											vToday = zoho.currentdate;
											/********* CREATED BY PUBLIC YESTERDAY *********/
											publicCreatedActions = Contract_Actions[Added_User == "Public" && Added_Time >= vYesterday && Added_Time < vToday] sort by Added_Time asc;
											/********* MODIFIED BY PUBLIC YESTERDAY *********/
											publicModifiedActions = Contract_Actions[Modified_User == "Public" && Modified_Time >= vYesterday && Modified_Time < vToday] sort by Modified_Time asc;
											vCreatedRows = "";
											vModifiedRows = "";
											vCreatedCount = 0;
											vModifiedCount = 0;
											/********* BUILD CREATED ROWS *********/
											for each  actionRow in publicCreatedActions
											{
												vContractName = "";
												if(actionRow.Contract1 != null)
												{
													vContractName = ifnull(actionRow.Contract1.Contract_Name,"");
												}
												vDevNotes = ifnull(actionRow.Dev_Notes,"");
												vDevNotes = vDevNotes.replaceAll("\n","<br>");
												vCreatedRows = vCreatedRows + "<tr>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + vContractName + "</td>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Contract_Action,"") + "</td>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + vDevNotes + "</td>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Status,"") + "</td>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Dev_Mgr,"") + "</td>";
												vCreatedRows = vCreatedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Added_Time,"") + "</td>";
												vCreatedRows = vCreatedRows + "</tr>";
												vCreatedCount = vCreatedCount + 1;
											}
											/********* BUILD MODIFIED ROWS *********/
											for each  actionRow in publicModifiedActions
											{
												// Avoid showing a newly-created Public action twice in the same email
												vCreatedByPublicYesterday = false;
												if(actionRow.Added_User == "Public" && actionRow.Added_Time >= vYesterday && actionRow.Added_Time < vToday)
												{
													vCreatedByPublicYesterday = true;
												}
												if(vCreatedByPublicYesterday == false)
												{
													vContractName = "";
													if(actionRow.Contract1 != null)
													{
														vContractName = ifnull(actionRow.Contract1.Contract_Name,"");
													}
													vDevNotes = ifnull(actionRow.Dev_Notes,"");
													vDevNotes = vDevNotes.replaceAll("\n","<br>");
													vModifiedRows = vModifiedRows + "<tr>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + vContractName + "</td>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Contract_Action,"") + "</td>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + vDevNotes + "</td>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Status,"") + "</td>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Dev_Mgr,"") + "</td>";
													vModifiedRows = vModifiedRows + "<td style='border:1px solid #d1d5db;padding:8px;'>" + ifnull(actionRow.Modified_Time,"") + "</td>";
													vModifiedRows = vModifiedRows + "</tr>";
													vModifiedCount = vModifiedCount + 1;
												}
											}
											if(vCreatedCount > 0 || vModifiedCount > 0)
											{
												vBody = "";
												vBody = vBody + "<div style='font-family:Arial,sans-serif;color:#111827;'>";
												vBody = vBody + "<h2 style='margin:0 0 6px 0;color:#0f172a;'>Contract Actions Created / Modified</h2>";
												vBody = vBody + "<div style='margin-bottom:16px;color:#6b7280;font-size:13px;'>Activity from " + vYesterday.toString("MM/dd/yyyy") + "</div>";
												if(vCreatedCount > 0)
												{
													vBody = vBody + "<h3 style='margin:18px 0 8px 0;color:#166534;font-size:16px;'>Created</h3>";
													vBody = vBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;margin-bottom:18px;'>";
													vBody = vBody + "<thead>";
													vBody = vBody + "<tr style='background:#f3f4f6;'>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Contract</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Action</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Dev Notes</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Status</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Dev Manager</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Created Time</th>";
													vBody = vBody + "</tr>";
													vBody = vBody + "</thead>";
													vBody = vBody + "<tbody>";
													vBody = vBody + vCreatedRows;
													vBody = vBody + "</tbody>";
													vBody = vBody + "</table>";
												}
												if(vModifiedCount > 0)
												{
													vBody = vBody + "<h3 style='margin:18px 0 8px 0;color:#1d4ed8;font-size:16px;'>Modified</h3>";
													vBody = vBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;margin-bottom:18px;'>";
													vBody = vBody + "<thead>";
													vBody = vBody + "<tr style='background:#f3f4f6;'>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Contract</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Action</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Dev Notes</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Status</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Dev Manager</th>";
													vBody = vBody + "<th style='border:1px solid #d1d5db;padding:8px;text-align:left;'>Modified Time</th>";
													vBody = vBody + "</tr>";
													vBody = vBody + "</thead>";
													vBody = vBody + "<tbody>";
													vBody = vBody + vModifiedRows;
													vBody = vBody + "</tbody>";
													vBody = vBody + "</table>";
												}
												vBody = vBody + "</div>";
												sendmail
												[
													from :"contracts@wbdevelopment.com"
													to :vRecipients
													subject :"Contract Actions Updated - " + vYesterday.toString("MM/dd/yyyy")
													message :vBody
												]
											}
										}
					)
					}
				}
			}
