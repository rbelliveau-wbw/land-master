			Select_Tax_Rates_Mass_Cre as "Select Tax Rates - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Taxing_Jurisdiction2
				{
					actions 
					{
						custom deluge script
						(
											taxRates = Tax_Rate[Taxing_Jurisdiction2 = input.Taxing_Jurisdiction2].ID.getAll();
										input.Tax_Rates = taxRates;
						)
					}
				}

			}
			Mass_Create_Tax_Parcel_Ye as "Mass Create Tax Parcel Years - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										subdiv = input.Subdivision.size();
										property = input.Property1.size();
										for each  taxRate1 in input.Tax_Rates
										{
											totalTaxrate = totalTaxrate + taxRate1.Tax_Rate;
										}
										if(subdiv != 0)
										{
											for each  subdivision in input.Subdivision
											{
												for each  lot in input.Lots1
												{
													tpy = insert into Tax_Parcel_Year
													[
														Tax_Parcel_Year_Code=lot.Lot_Code + "-" + input.Year1
														Subdivision1=subdivision
														Added_User=zoho.loginuser
														Tax_Year=input.Year1
														Taxing_Jurisdiction1=input.Taxing_Jurisdiction2
														Tax_Rates=input.Tax_Rates
														Property_ID=lot.Property_ID
														Appraised_Value=lot.Appraised_Value
														Cumulative_Tax_Rate=totalTaxrate
													];
												}
											}
											//Close_Date >= input.Exclude_Lots
										}
										openUrl("#Script:page.parent.refresh ","parent window");
						)
					}
				}

			}
			Check_for_Appraised_Value as "Check for Appraised Values - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											withValue = 0;
										withoutValue = 0;
										for each  lot in Lots[Subdivision == input.Subdivision]
										{
											if(lot.Appraised_Value != 0)
											{
												withValue = withValue + 1;
											}
											if(lot.Appraised_Value == 0 || lot.Appraised_Value == null)
											{
												withoutValue = withoutValue + 1;
											}
										}
										if(withoutValue != 0)
										{
											info "There are " + withoutValue + " lots with a $0 or blank appraived value -- they will be treated as $0. Continue?";
										}
						)
					}
				}

			}
			Calc_Cumulative_Tax_Rate_ as "Calc Cumulative Tax Rate - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Tax_Rates
				{
					actions 
					{
						custom deluge script
						(
											totalTaxrate = 0;
										for each  taxRate in input.Tax_Rates
										{
											totalTaxrate = totalTaxrate + taxRate.Tax_Rate;
										}
										input.Cumulative_Tax_Rate = totalTaxrate;
						)
					}
				}

			}
			Tax_Table_Search_Name as "Tax Table Search - Name"
