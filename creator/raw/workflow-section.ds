			Lockdown_Fields_Form_Budg as "Lockdown Fields/Form - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											//Budget Category Form
										hide Edit_Items;
										hide disclaimer1;
										hide plain1;
										hide plain2;
										hide Budget_Items.Start_Phase;
										hide Budget_Items.End_Phase;
										hide Budget_Items.Start_Month;
										hide Budget_Items.End_Month;
										hide Budget_Items.Pro_Forma;
										if(zoho.loginuserid != "jking@wbdevelopment.com" && zoho.loginuserid != "rbelliveau@wbdevelopment.com")
										{
											hide Budget_Items.Unapproved_Final_Budget_Ttl;
											hide Unapproved_Final_Budget_Total;
										}
										hide Actual_Total;
										hide Budget_Items.Add_l_Cost;
										hide Add_l_Cost_Total;
										disable Project;
										disable Phase;
										disable Acres;
										disable Lock_Category;
										disable Lot_Total_Residential;
										disable Equiv_LF_of_Street;
										disable Actual_Total;
										disable Deparment;
										disable Budget_Category_Name;
										disable Budget;
										hide Budget_Total;
										disable Category_Code;
										hide Prelim_Budget_Total;
										//IF BUDGET HAS PRELIM OR FINAL LOCKED THEN LOCKDOWN ITEMS INPUT
										if(input.Budget.Lock_Prelim_Budget == TRUE)
										{
											disable Budget_Items.Prelim_Budget_Ttl;
										}
										if(Deparment == "Construction")
										{
											disable Budget_Items.Budget_Ttl;
										}
										// Budget Items Subform
										if(input.Budget.Budget_Type == "Pro Forma")
										{
											show Budget_Items.Start_Phase;
											show Budget_Items.End_Phase;
											show Add_l_Cost_Total;
											disable Add_l_Cost_Total;
											hide Project;
											hide Phase;
											hide Zoho_Projects_Info;
											hide Budget_Items.Prelim_Budget_Ttl;
											hide Budget_Items.Budget_Ttl;
											hide Budget_Items.Percent_Complete;
											show Budget_Items.Add_l_Cost;
											disable Budget_Items.Start_Month;
											disable Budget_Items.End_Month;
										}
										if(input.Budget.Budget_Type == "Pro Forma" && Budget_Category_Name.contains("Reimbursements") == TRUE)
										{
											hide Budget_Items.Prelim_Budget_Ttl;
											hide Budget_Items.Budget_Ttl;
											hide Budget_Items.Percent_Complete;
											show Budget_Items.Start_Month;
											show Budget_Items.End_Month;
											enable Budget_Items.Start_Month;
											enable Budget_Items.End_Month;
										}
										hide Budget_Items.Dept_Code;
										hide Budget_Items.Sort_Order;
										hide Budget_Items.Cost_Code;
										hide Budget_Items.Budget;
										disable Budget_Items.Percent_Complete;
										disable Budget_Items.Cost_to_Complete;
										disable Budget_Items.PROJ_Actual;
										disable Budget_Items.Dept_Code;
										disable Budget_Items.Item_Name;
										disable Budget_Items.Budget_Code;
										disable Budget_Items.HCSS_Actuals;
