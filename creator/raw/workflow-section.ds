			Mark_Complete_Date_Contra as "Mark Complete Date - Contract Action"
			{
				type =  form
				form = Contract_Actions

				record event = on add or edit

				on user input of Complete
				{
					actions 
					{
						custom deluge script
						(
											if(input.Complete == true)
										{
											input.Complete_Date = zoho.currentdate;
											input.Status = "Complete";
										}
										else
										{
											input.Complete_Date = null;
											input.Status = "Open";
										}
										statusText = "Open";
										statusClass = "open";
										if(input.Complete == true || ifnull(input.Status,"") == "Complete")
										{
											statusText = "Complete";
											statusClass = "complete";
										}
										contractName = "—";
										if(input.Contract1 != null)
										{
											try 
											{
												contractName = ifnull(input.Contract1.Contract_Name,"—");
											}
											catch (e)
											{
												contractName = "—";
											}
										}
										actionText = ifnull(input.Contract_Action,"—");
										startDateText = "—";
										if(input.Start_Date != null)
										{
											startDateText = input.Start_Date.toString("MM/dd/yyyy");
										}
										dueDateText = "—";
										if(input.Due_Date != null)
										{
											dueDateText = input.Due_Date.toString("MM/dd/yyyy");
										}
										completeDateText = "—";
										if(input.Complete_Date != null)
										{
											completeDateText = input.Complete_Date.toString("MM/dd/yyyy");
										}
										completeHelper = "Sets action to complete and adds todays date.";
										if(input.Complete == true && completeDateText != "—")
										{
											completeHelper = "Completed on " + completeDateText + ".";
										}
										contractName = contractName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										actionText = actionText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
										completeHelperCss = completeHelper.replaceAll("\\","\\\\").replaceAll("'","\\'");
										html = "";
										html = html + "<style>";
										html = html + ".zc-Action_Summary_HTML-group{margin-bottom:0!important;}";
										html = html + ".zc-Action_Summary_HTML-group>.form-label{display:none!important;}";
										html = html + ".zc-Action_Summary_HTML-group .form-field{width:100%!important;float:none!important;}";
