										html = html + ".ca-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:18px 20px;border-bottom:1px solid #edf1f6;background:#fbfcfe;}";
										html = html + ".ca-eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7b8794;margin-bottom:4px;}";
										html = html + ".ca-contract{font-size:20px;font-weight:700;color:#1f2937;line-height:1.2;margin-bottom:4px;}";
										html = html + ".ca-sub{font-size:13px;color:#6b7280;}";
