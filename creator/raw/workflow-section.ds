						(
											taxRates = Tax_Rate_Template[ID = input.Tax_Rate_Template].Tax_Rates.getAll();
										input.Tax_Rates = taxRates;
										if(input.Tax_Rate_Template == null)
										{
											taxRates = Tax_Rate[Taxing_Jurisdiction2 = input.Taxing_Jurisdiction2].ID.getAll();
