												message :"Reject reason : " + input.Reject_Reason + "<p>Subdivision: " + input.Contract1.Subdivision1.Subdivision_Name + "</p>" + "<p>Buyer: " + input.Contract1.Builder.Builder_Name + "</p>" + "<p>Initiated by: " + input.Approver + "</p>"
												Attachments :file:contractFile
											]
										}
						)
					}
				}

			}
