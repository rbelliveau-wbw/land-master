			Calculate_Interest_Totals as "Calculate Interest & Totals- Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											//set subtotal variables to $0
										addlItemstotal = 0;
										addlfeesSubtotal = 0;
										lotAddlfees = 0;
										totaltaxSubtotal = 0;
										lottotalTax = 0;
										earnestMoney = 0;
										//tdTemplate = Takedown_Template[Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1];
										wbwtaxSubtotal = 0;
										addlTax = 0;
										buildertaxSubtotal = 0;
										earnestMoneytotal = 0;
										totalPrice = 0;
										//this variable holds a "1", and is changed to "0" if DRH Subtract Day is checked
										addDayinterest = 1;
										addDaywbwtax = 1;
										addSingleday = 1;
										//check if Tax Proration Date has a value, if so then use that for tax calc in daysbetweenSettlement
										if(input.Tax_Proration_Date != null)
										{
											taxDate = input.Tax_Proration_Date;
										}
										else
										{
											taxDate = input.Purchase_Date;
										}
										//set a variable for Jan 1st of current year
										janOne = "01/01/" + getYear(taxDate);
										//calc days between Jan 1 of current year and Settlement Date
										daysbetweenSettlement = daysBetween(toDate(janOne),taxDate);
										totalInterest = 0;
										//cycle through interest and subtotal calculation for each Lot in the Builder Takedown
										for each  lot in input.Lots
										{
											//check if earnest money has a value on the lot record else 0
											earnestMoney = ifnull(lot.Earnest_Money,0);
											if(lot.Additional_Tax != null)
											{
												addlTax = lot.Additional_Tax;
											}
											//this if statement changes addSingleday to "0" if DRH Subtract Day is TRUE
											if(input.DRH_Subtract_Day == TRUE)
											{
												addSingleday = 0;
											}
											if(input.Subtract_Day_From.contains("Interest") == TRUE)
											{
												addDayinterest = 0;
											}
											if(input.Subtract_Day_From.contains("Tax") == TRUE)
											{
												addDaywbwtax = 0;
											}
											interest1 = 0;
											interest2 = 0;
											interest3 = 0;
											interest4 = 0;
											interest5 = 0;
											interest6 = 0;
											interest7 = 0;
											interest8 = 0;
											interest9 = 0;
											interest10 = 0;
											interest11 = 0;
											interest12 = 0;
											if(input.Interest_Rate_1 != null && Date1_1 != null && Date1_2 != null)
											{
												interest1 = lot.Base_Price * input.Interest_Rate_1 / 100 * (input.Date1_1.daysBetween(input.Date1_2) + addDayinterest) / 365;
											}
											if(input.Interest_Rate_2 != null && Date2_1 != null && Date2_2 != null)
											{
												interest2 = lot.Base_Price * input.Interest_Rate_2 / 100 * input.Date2_1.daysBetween(input.Date2_2) / 365;
											}
											if(input.Interest_Rate_3 != null && Date3_1 != null && Date3_2 != null)
											{
												interest3 = lot.Base_Price * input.Interest_Rate_3 / 100 * input.Date3_1.daysBetween(input.Date3_2) / 365;
											}
											if(input.Interest_Rate_4 != null && Date4_1 != null && Date4_2 != null)
											{
												interest4 = lot.Base_Price * input.Interest_Rate_4 / 100 * input.Date4_1.daysBetween(input.Date4_2) / 365;
											}
											if(input.Interest_Rate_5 != null && Date5_1 != null && Date5_2 != null)
											{
												interest5 = lot.Base_Price * input.Interest_Rate_5 / 100 * input.Date5_1.daysBetween(input.Date5_2) / 365;
											}
											if(input.Interest_Rate_6 != null && Date6_1 != null && Date6_2 != null)
											{
												interest6 = lot.Base_Price * input.Interest_Rate_6 / 100 * input.Date6_1.daysBetween(input.Date6_2) / 365;
											}
											if(input.Interest_Rate_71 != null && Date7_1 != null && Date7_2 != null)
											{
												interest7 = lot.Base_Price * input.Interest_Rate_71 / 100 * input.Date7_1.daysBetween(input.Date7_2) / 365;
											}
											if(input.Interest_Rate_8 != null && Date8_1 != null && Date8_2 != null)
											{
												interest8 = lot.Base_Price * input.Interest_Rate_8 / 100 * input.Date8_1.daysBetween(input.Date8_2) / 365;
											}
											if(input.Interest_Rate_9 != null && Date9_1 != null && Date9_2 != null)
											{
												interest9 = lot.Base_Price * input.Interest_Rate_9 / 100 * input.Date9_1.daysBetween(input.Date9_2) / 365;
											}
											if(input.Interest_Rate_10 != null && Date10_1 != null && Date10_2 != null)
											{
												interest10 = lot.Base_Price * input.Interest_Rate_10 / 100 * input.Date10_1.daysBetween(input.Date10_2) / 365;
											}
											if(input.Interest_Rate_11 != null && Date11_1 != null && Date11_2 != null)
											{
												interest11 = lot.Base_Price * input.Interest_Rate_11 / 100 * input.Date11_1.daysBetween(input.Date11_2) / 365;
											}
											if(input.Interest_Rate_12 != null && Date12_1 != null && Date12_2 != null)
											{
												interest12 = lot.Base_Price * input.Interest_Rate_12 / 100 * input.Date12_1.daysBetween(input.Date12_2) / 365;
											}
											lot.Interest1=interest1 + interest2 + interest3 + interest4 + interest5 + interest6 + interest7 + interest8 + interest9 + interest10 + interest11 + interest12;
											totalInterest = totalInterest + interest1 + interest2 + interest3 + interest4 + interest5 + interest6 + interest7 + interest8 + interest9 + interest10 + interest11 + interest12;
											//lot.Additional_Fees=if(input.Additional_Fees_Per_Lot = null,0,input.Additional_Fees_Per_Lot);
											if(input.Additional_Fees_Per_Lot == null && lot.Additional_Fees == null)
											{
												lot.Additional_Fees=0;
											}
											if(input.Additional_Fees_Per_Lot != null)
											{
												lot.Additional_Fees=input.Additional_Fees_Per_Lot;
											}
											lotAddlfees = lot.Additional_Fees;
											//check if the corresponding Takedown Template is Flat Tax per Lot of Percentage of Appraisal Value
											if(input.Tax_Method == "Flat")
											{
												lottotalTax = input.Tax_Per_Lot;
											}
											if(input.Tax_Method == "Percentage of Appraisal")
											{
												lottotalTax = input.Percent_of_Appraisal * lot.Appraised_Value / 100;
											}
											lot.Total_Tax=lottotalTax + addlTax;
											if(input.Additional_Fee_Type != null)
											{
												lot.Fee_Type=input.Additional_Fee_Type;
											}
											lot.Builder1=input.Builder1;
											lot.WBW_Tax=(daysbetweenSettlement + addDaywbwtax) / 365 * lot.Total_Tax;
											lot.Builder_Tax=lot.Total_Tax - lot.WBW_Tax;
											if(input.Tax_Status == "Taxes Paid")
											{
												lot.Total=lot.Base_Price + lotAddlfees + lot.Interest1 + lot.Builder_Tax - earnestMoney;
											}
											if(input.Tax_Status == "Taxes Unpaid")
											{
												lot.Total=lot.Base_Price + lotAddlfees + lot.Interest1 - lot.WBW_Tax - earnestMoney;
											}
											if(input.Tax_Status == "Proration Taxes Unpaid")
											{
												lot.Total=lot.Base_Price + lotAddlfees + lot.Interest1 - lot.Total_Tax - lot.WBW_Tax - earnestMoney;
											}
											earnestMoneytotal = earnestMoneytotal + earnestMoney;
											addlfeesSubtotal = addlfeesSubtotal + lotAddlfees;
											totaltaxSubtotal = totaltaxSubtotal + lot.Total_Tax;
											wbwtaxSubtotal = wbwtaxSubtotal + lot.WBW_Tax;
											buildertaxSubtotal = buildertaxSubtotal + lot.Builder_Tax;
											totalPrice = totalPrice + lot.Total;
											lot.Takedown_Queue=false;
										}
										//iterate through all Additional Items and fill in new grand total
										for each  addlItem in input.Additional_Items
										{
											addlItemstotal = addlItemstotal + addlItem.Total;
										}
										input.Interest_Subtotal = totalInterest;
										info totalInterest;
										//write variables to subtotal fields on Builder Takedown
										lotCount = input.Lots.size();
										input.Lot_Count = lotCount;
										input.Earnest_Money_Total = earnestMoneytotal;
										input.Addl_Fees_Subtotal = addlfeesSubtotal;
										input.Total_Tax_Subtotal = totaltaxSubtotal;
										input.WBW_Tax_Subtotal = wbwtaxSubtotal;
										input.Builder_Tax_Subtotal = buildertaxSubtotal;
										input.Total = totalPrice;
										if(input.Additional_Items != null)
										{
											input.Total_w_Additional = totalPrice + addlItemstotal;
										}
										if(input.Additional_Items == null)
										{
											input.Total_w_Additional = totalPrice;
										}
						)
					}
				}

			}
