		workflow
		{
		form
		{
			Mass_Create_Lots as "Mass Create Lots"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											//set variables
										lotNamer = input.Lot_Start_Number;
										blockNum = input.Block.toString();
										lots = input.Lot_End_Number - input.Lot_Start_Number + 1;
										counter = leftpad("1",lots).replaceAll(" ","1,").toList();
										//if a buyer is selected in Mass Create, then create lots as Contracted
										lotStatus = "Open";
										if(input.Buyer != null)
										{
											lotStatus = "Contracted";
										}
										//create lots loop
										for each index i in counter
										{
											lotName2 = lotNamer.toString();
											if(lotName2.length() < 2)
											{
												lotName2 = leftpad(lotName2,2).replaceAll(" ","0");
											}
											if(blockNum.length() < 2)
											{
												blockNum = leftpad(blockNum,2).replaceAll(" ","0");
											}
											insert into Lots
											[
												Lot_Number=lotNamer
												Subdivision_Code=input.Subdivision_Code
												Lot_Code=input.Subdivision_Code + '-B' + blockNum + '-L' + lotName2.toString()
												Added_User=zoho.loginuser
												Subdivision=input.Subdivision
												Block=input.Block
												Phase=input.Phase
												Base_Price=input.Base_Price
												Escalator=input.Escalator
												Escalator_Start_Date=input.Escalator_Start_Date
												City=input.City
												County=input.County
												Additional_Fees=input.Additional_Fees
												Builder1=input.Buyer
												Status=lotStatus
												Fee_Type=input.Fee_Type
												Earnest_Money=input.Earnest_Money
												Lot_Size=input.Lot_Size
											]
											lotNamer = lotNamer + 1;
										}
										//return lotNamer + " Lots Created";
						)
					}
				}

			}
			Set_Subdiv_Code as "Set Subdiv Code"
			{
				type =  form
				form = Mass_Create_Lots

				record event = on add

				on user input of Subdivision
				{
					actions 
					{
						custom deluge script
						(
											subdivCode = Subdivision[ID == input.Subdivision].Subdivision_Code;
										subdivCity = Subdivision[ID == input.Subdivision].City;
										subdivCounty = Subdivision[ID == input.Subdivision].County;
										subdivPhase = input.Subdivision.Phase;
										input.Subdivision_Code = subdivCode;
										input.County = subdivCounty;
										input.City = subdivCity;
										input.Phase = subdivPhase;
						)
					}
				}

			}
			Set_Takedown_Code_Takedow as "Set Takedown Code -- Takedown Schedule"
			{
				type =  form
				form = Takedown_Schedule

				record event = on add or edit

				on user input of Builder1
				{
					actions 
					{
						custom deluge script
						(
											input.Takedown_Schedule_Code = input.Subdivisions.Subdivision_Code + ' - ' + input.Builder1.Builder_Name;
						)
					}
				}

			}
			Set_Lot_Code_if_Manual_Up as "Set Lot Code if Manual Update"
			{
				type =  form
				form = Lots

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											lotNumber = input.Lot_Number.toString();
										blockNum = input.Block.toString();
										if(lotNumber.length() < 2)
										{
											lotNumber = leftpad(lotNumber,2).replaceAll(" ","0");
										}
										if(blockNum.length() < 2)
										{
											blockNum = leftpad(blockNum,2).replaceAll(" ","0");
										}
										input.Lot_Code = input.Subdivision_Code + '-B' + blockNum + '-L' + lotNumber;
										if(Close_Date != null)
										{
											input.Status = "Sold";
										}
										if(Builder1 != null && Purchase_Date == null)
										{
											input.Status = "Contracted";
										}
										if(Builder1 == null && Purchase_Date == null)
										{
											input.Status = "Open";
										}
						)
					}
				}

			}
			Write_Subdivision_Code_Su as "Write Subdivision Code - Subdivision"
			{
				type =  form
				form = Subdivision

				record event = on add or edit

				on user input of Phase
				{
					actions 
					{
						custom deluge script
						(
											phaseNum = input.Phase.toString();
										if(phaseNum.length() < 2)
										{
											phaseNum = leftpad(phaseNum,2).replaceAll(" ","0");
										}
										input.Subdivision_Code = input.Project.Project_Code + phaseNum;
										input.Subdivision_Name = input.Project.Project_Name + " - Phase " + phaseNum;
						)
					}
				}

			}
			Autofill_County_City_Terr as "Autofill County/City/Territ - Subdivision"
			{
				type =  form
