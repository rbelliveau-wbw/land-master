			Allow_Forecast_Lots_Editi as "Allow Forecast Lots Editing - Forecast Year"
			{
				type =  form
				form = Forecast_Year

				record event = on edit

				on user input of Forecast_Months.Edit
				{
					actions 
					{
						custom deluge script
						(
											settings = Settings[ID != 0].Open_Forecasting_Window.getAll();
										if(settings = TRUE)
										{
											if(row.Edit == TRUE && row.Forecast_Start_Date.addDay(28) < zoho.currenttime)
											{
												alert "Past forecasts cannot be edited.";
												row.Edit=FALSE;
												disable row.Forecasted_Lots;
											}
											if(row.Edit == TRUE && row.Forecast_Start_Date.addDay(28) >= zoho.currenttime)
											{
												enable row.Forecasted_Lots;
												row.Edit=FALSE;
											}
										}
										if(settings = FALSE)
										{
											alert "Forecasting window closed for the month.";
										}
										row.Edit=FALSE;
						)
					}
				}

			}
