			Write_Code_and_Name_Subdi as "Write Code and Name - Subdivision"
			{
				type =  form
				form = Subdivision

				record event = on add or edit

				on user input of Subphase
				{
					actions 
					{
						custom deluge script
						(
											phaseNum = input.Phase.toString();
										if(phaseNum.length() < 2)
										{
											phaseNum = leftpad(phaseNum,2).replaceAll(" ","0");
										}
										input.Subdivision_Code = input.Project.Project_Code + phaseNum + "-" + input.Subphase;
										input.Subdivision_Name = input.Project.Project_Name + " - Phase " + phaseNum + "-" + input.Subphase;
						)
					}
				}

			}
			Check_if_Lot_already_Take1 as "Check if Lot already Taken Down - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  lot in input.Lots
										{
											lotId = lot.ID.toString();
											btds = Builder_Takedown[Lots.contains(lotId)].count();
											if(btds >= 1)
											{
												alert lot.Lot_Code + " already exists in another Builder Takedown.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Clear_Lots_Fields_on_Dele as "Clear Lots Fields on Delete - Builder Takedown"
			{
				type =  form
				form = Builder_Takedown

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											//this clears all pertinent Lot fields that are calc'd and updated from saving a Builder Takedown if deleted
										for each  lot in input.Lots
										{
											lot.Total_Tax=null;
											lot.Total=null;
											lot.Interest1=null;
											lot.Purchase_Date=null;
											lot.Purch_Date_Text=null;
											lot.Entered_Date=null;
											lot.Entered_Date_Text=null;
											lot.Close_Date=null;
											lot.Close_Date_Text=null;
											lot.WBW_Tax=null;
											lot.Builder_Tax=null;
											lot.Status="Open";
										}
						)
					}
				}

			}
