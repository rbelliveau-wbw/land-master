			Calc_Land_Cost_Pro_Forma as "Calc Land Cost - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Land_Cost_Acre
				{
					actions 
					{
						custom deluge script
						(
											if(Land_Cost_Acre != null && input.Total_Acres != null)
										{
											installmentSum = 0;
											input.Land_Cost = input.Land_Cost_Acre * input.Total_Acres;
											for each  installment in input.Land_Purchase_Installments
											{
												installmentSum = installmentSum + installment.Cost;
											}
										}
						)
					}
				}

			}
			Calc_Land_Cost_Pro_Forma1 as "Calc Land Cost - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Total_Acres
				{
					actions 
					{
						custom deluge script
						(
											if(Land_Cost_Acre != null && input.Total_Acres != null)
										{
											installmentSum = 0;
											input.Land_Cost = input.Land_Cost_Acre * input.Total_Acres;
											for each  installment in input.Land_Purchase_Installments
											{
												installmentSum = installmentSum + installment.Cost;
											}
										}
						)
					}
				}

			}
			Populate_Land_Purch_Insta as "Populate Land Purch Installments - Pro Forma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Purchase_Installments
				{
					actions 
					{
						custom deluge script
						(
											input.Land_Purchase_Installments.clear();
										loop = thisapp.forLoop(1,input.Purchase_Installments);
										installmentStart = 1;
										for each  el in loop
										{
											row = Add_Pro_Forma.Land_Purchase_Installments();
											row.Installment=installmentStart;
											row.Month1=installmentStart;
											row.Percent1=100 / input.Purchase_Installments;
											row.Cost=input.Land_Cost / input.Purchase_Installments;
											row.Date1=input.Estimated_Purchase_Date.addMonth(installmentStart - 1);
											row.Type1="Purchase";
											input.Land_Purchase_Installments.insert(row);
											installmentStart = installmentStart + 1;
										}
						)
					}
				}

			}
			Update_Pro_Forma_Months_B as "Update Pro Forma Months - Budget Category"
			{
				type =  form
				form = Budget_Category

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											//CLEAR ALL RELEVANT MONTH VALUES BEFORE RECALC
										if(input.Budget.Pro_Forma != null)
										{
											for each  mnth in Proforma_Months[Proforma == input.Budget.Pro_Forma]
											{
												mnth.Construction_Cost_Addl=null;
												mnth.Entitlement_Engineering_Addl=null;
												mnth.Reimbursed_Fees=null;
												mnth.Reimbursements=null;
												mnth.Cash_Flow=null;
												mnth.Running_Cash_Flow=null;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											//FILL OUT ENG COST
											//getUrl("https://postman-echo.com/delay/12");
											startMo = 1;
											addlCosts = Budget_Item[Budget == input.Budget && Add_l_Cost != null && Budget_Category.Budget_Category_Name != "Reimbursements" && Budget_Category.Deparment == "Engineering" || Budget_Category.Deparment == "Development"];
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Eng_Phase != null] sort by Eng_Phase,Date1;
											//mnths = Proforma_Months [ <field> <opr> <expression> ] sort by Const_Phase, Date1;
											for each  month in mnths
											{
												addlCost = 0;
												for each  cost in addlCosts
												{
													if(cost.Start_Phase <= month.Eng_Phase && cost.End_Phase >= month.Eng_Phase)
													{
														//count number of phases
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Budget.Pro_Forma.Engineering_Length_Months.toLong();
														addlCost = addlCost + cost.Add_l_Cost / costSpread;
													}
												}
												//cCurve = Construction_Curve[Pro_Forma == input.ID && Month_Number == startMo];
												phz = Proforma_Phase[Pro_Forma = input.Budget.Pro_Forma && Phase = month.Eng_Phase];
												month.Entitlement_Engineering=input.Budget.Pro_Forma.Engineering_Cost_Lot * phz.Total_Lots / input.Budget.Pro_Forma.Engineering_Length_Months;
												month.Entitlement_Engineering_Addl=addlCost;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											// FILL OUT CONST COST ON MONTHS (Deluge-safe)
											addlCosts = Budget_Item[Budget == input.Budget && Add_l_Cost != null && Budget_Category.Deparment == "Construction"];
											baseCost = ifnull(input.Budget.Pro_Forma.Ft_St_per_Lot,0) * ifnull(input.Budget.Pro_Forma.Const_Cost_FF,0);
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Const_Phase != null] sort by Const_Phase,Date1;
											// Preload phase → Total_Lots
											phaseLots = Map();
											for each  ph in Proforma_Phase[Pro_Forma == input.Budget.Pro_Forma]
											{
												phaseLots.put(ph.Phase,ifnull(ph.Total_Lots,0));
											}
											// Preload curve percents ordered by Month_Number
											curvePercents = List();
											for each  c in Construction_Curve[Pro_Forma == input.Budget.Pro_Forma] sort by Month_Number
											{
												curvePercents.add(ifnull(c.Percent_Cost,0));
											}
											curveSize = curvePercents.size().toLong();
											idx = 0;
											// Apply costs per month (minimal loop body, no ternary)
											for each  month in mnths
											{
												addlCost = 0;
												for each  cost in addlCosts
												{
													if(cost.Start_Phase <= month.Const_Phase && cost.End_Phase >= month.Const_Phase)
													{
														//count number of phases
														numPhases = cost.End_Phase - cost.Start_Phase + 1;
														costSpread = numPhases * input.Budget.Pro_Forma.Construction_Length.toLong();
														addlCost = addlCost + cost.Add_l_Cost / numPhases;
													}
												}
												lots = ifnull(phaseLots.get(month.Const_Phase),0);
												pct = 0;
												if(curveSize > 0)
												{
													pct = ifnull(curvePercents.get(idx),0);
												}
												//info lots.toString() + " - " + baseCost.toString() + " - " + pct.toString();
												month.Construction_Cost_Base=lots * baseCost * pct / 100;
												month.Construction_Cost_Addl=addlCost * pct / 100;
												idx = idx + 1;
												if(idx >= curveSize)
												{
													idx = 0;
												}
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											// REIMBURSEMENTS (NON IMPACT FEES) SPREAD ACROSS PHASES OR MONTHS
											// Get all reimbursement items once for this budget
											reimbList = Budget_Item[Budget == input.Budget && Budget_Category.Budget_Category_Name == "Reimbursements" && Add_l_Cost != null];
											for each  reimb in reimbList
											{
												if(reimb.Item_Name.contains("Impact Fees") == false)
												{
													// This will hold the months that match this reimbursement
													// PATH 1: Phase-defined (Start_Phase / End_Phase)
													if(reimb.Start_Phase != null && reimb.End_Phase != null)
													{
														matchedMonths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Eng_Phase >= reimb.Start_Phase && Eng_Phase <= reimb.End_Phase];
													}
													// PATH 2: Month-defined (Start_Month / End_Month)
													else if(reimb.Start_Phase == null && reimb.End_Phase == null)
													{
														matchedMonths = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 >= reimb.Start_Month && Month1 <= reimb.End_Month];
													}
													// Only proceed if we actually found months (avoid "invalid collection object")
													if(matchedMonths != null)
													{
														denom = matchedMonths.distinct(Month1).size();
														if(denom > 0)
														{
															perMonthAmount = reimb.Add_l_Cost / denom;
															// Track which Month1 values have already had this reimb applied
															monthApplied = List();
															// Add this reimb's share ON TOP OF any existing Reimbursements value
															for each  m in matchedMonths
															{
																currentMonthNo = m.Month1;
																// If we've already applied this reimbursement to this Month1, skip any second application
																if(monthApplied.contains(currentMonthNo))
																{
																	// Skip this second (or later) application for this Month1
																	continue;
																}
																existingVal = ifnull(m.Reimbursements,0.0);
																m.Reimbursements=existingVal + perMonthAmount;
																// Mark this Month1 as having been updated for this reimbursement
																monthApplied.add(currentMonthNo);
															}
														}
													}
												}
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//REIMBURSED FEES (IMPACT FEES) SPREAD EVENLY OVER ANY MONTH WITH LOT SALES
										if(input.Budget.Pro_Forma != null)
										{
											impFees = Budget_Item[Budget == input.Budget && Category = "Reimbursements" && Item_Name.contains("Impact Fees")].sum(Add_l_Cost);
											for each  pfMonth in Proforma_Months[Proforma == input.Budget.Pro_Forma && Lot_Sale_Phase != null && Lots_Sold > 0]
											{
												pfMonth.Reimbursed_Fees=impFees / input.Budget.Pro_Forma.Lots * pfMonth.Lots_Sold;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//FILL OUT CASH FLOW
										if(input.Budget.Pro_Forma != null)
										{
											for each  mnth in Proforma_Months[Proforma == input.Budget.Pro_Forma]
											{
												mnth.Cash_Flow=ifNull(mnth.Finished_Lot_Sales,0) - ifNull(mnth.Land_Cost,0) + ifNull(mnth.Land_Sale,0) - ifNull(mnth.Construction_Cost_Base,0) - ifNull(mnth.Construction_Cost_Addl,0) - ifNull(mnth.Entitlement_Engineering,0) - ifNull(mnth.Entitlement_Engineering_Addl,0) + ifNull(mnth.Reimbursements,0) + ifNull(mnth.Reimbursed_Fees,0);
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											//FILL OUT RUNNING CASH FLOW
										if(input.Budget.Pro_Forma != null)
										{
											mnths = Proforma_Months[Proforma == input.Budget.Pro_Forma].Month1.getAll();
											unqMonths = mnths.distinct().size();
											loop = thisapp.forLoop(1,unqMonths);
											monthNo = 1;
											for each  el in loop
											{
												prevMnth = monthNo - 1;
												if(monthNo == 1)
												{
													loopMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo];
													loopMonth.Running_Cash_Flow=loopMonth.Cash_Flow;
												}
												if(monthNo != 1)
												{
													loopMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo];
													loopMonthcashflow = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == monthNo].sum(Cash_Flow);
													prevMonth = Proforma_Months[Proforma == input.Budget.Pro_Forma && Month1 == prevMnth].sum(Running_Cash_Flow);
													loopMonth.Running_Cash_Flow=prevMonth + loopMonthcashflow;
												}
												monthNo = monthNo + 1;
											}
											info "Running cash flow finished";
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Budget.Pro_Forma != null)
										{
											pf = Add_Pro_Forma[ID = input.Budget.Pro_Forma];
											//TOTALS
											constCost = Proforma_Months[Proforma == pf].sum(Construction_Cost_Base);
											constCostaddl = Proforma_Months[Proforma == pf].sum(Construction_Cost_Addl);
											engCost = Proforma_Months[Proforma == pf].sum(Entitlement_Engineering);
											engCostaddl = Proforma_Months[Proforma == pf].sum(Entitlement_Engineering_Addl);
											reimbursements = Proforma_Months[Proforma == pf].sum(Reimbursements);
											cashFlow = Proforma_Months[Proforma == pf].sum(Cash_Flow);
											reimbFees = Proforma_Months[Proforma == pf].sum(Reimbursed_Fees);
											pf.Gross_Sales=pf.Sale_Price_FF * pf.Lots * pf.Lot_Size_Ft;
											//input.Construction_Cost_Base = constCost;
											pf.Construction_Cost_Addl=constCostaddl;
											//input.Entitlement_Cost = engCost;
											pf.Entitlement_Engineering_Addl=engCostaddl;
											pf.Total_Expenses=pf.Construction_Cost_Base + pf.Construction_Cost_Addl + pf.Entitlement_Cost + pf.Entitlement_Engineering_Addl + pf.Land_Cost;
											pf.Reimbursements=reimbursements;
											pf.Reimbursed_Fees=reimbFees;
											//input.Net_Profit = cashFlow;
											pf.Total_Income=ifNull(pf.Gross_Sales,0) + ifNull(pf.MUD_Revenue,0) + ifNull(pf.Reimbursements,0) + ifNull(pf.Reimbursed_Fees,0) + ifNull(pf.Land_Sale,0);
											pf.Net_Profit=pf.Total_Income - pf.Total_Expenses;
										}
						)
					}
				}

			}
			Schedule_Validation_Profo1 as "Schedule Validation - Proforma"
			{
				type =  form
				form = Add_Pro_Forma

				record event = on add or edit

				on user input of Engineering_Length_Months
				{
					actions 
					{
						custom deluge script
						(
											// Calculate Construction_Start_Month from delays and lengths
										if(input.Engineering_Delay_Months != null && input.Engineering_Length_Months != null && input.Construction_Delay_Months != null)
										{
											input.Construction_Start_Month = input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months;
										}
										// Calculate Takedown_Start_Month from construction timing
										if(input.Construction_Start_Month != null && input.Construction_Length.toNumber() != null)
										{
											input.Takedown_Start_Month = input.Construction_Start_Month + input.Construction_Length.toNumber() + 1;
										}
										// Validate Estimated_Purchase_Date falls on the 1st of the month
										if(input.Estimated_Purchase_Date != null)
										{
											if(day(input.Estimated_Purchase_Date) != 1)
											{
												alert "Estimated Purchase Date must be the 1st of the month.";
											}
										}
										// Calculate Estimated_Lot_Sale_Start from purchase date and takedown start month
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null)
										{
											input.Estimated_Lot_Sale_Start = addMonth(input.Estimated_Purchase_Date,input.Takedown_Start_Month - 1);
										}
										if(input.Estimated_Purchase_Date != null && input.Takedown_Start_Month != null && input.Engineering_Length_Months != null && input.Construction_Length != null && input.Engineering_Delay_Months != null && input.Construction_Delay_Months != null && input.Initial_Takedown != null && input.Lots_per_Month != null && input.Lots != null && input.Phases != null)
										{
											input.Estimated_Completion = input.Estimated_Purchase_Date.addMonth(input.Takedown_Start_Month + ceil((input.Lots / input.Phases - input.Initial_Takedown) / input.Lots_per_Month) + if(input.Phases > 2,(input.Phases - 2) * ceil((input.Lots / input.Phases) / input.Lots_per_Month),0) + IF(input.Phases > 1,ceil((input.Lots - (input.Phases - 1) * ceil(input.Lots / input.Phases)) / input.Lots_per_Month),0) - 1);
										}
										if(Estimated_Purchase_Date != NULL && Engineering_Delay_Months != NULL && Engineering_Length_Months != NULL && Construction_Delay_Months != NULL)
										{
											input.Engineering_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months);
											input.Construction_Start = input.Estimated_Purchase_Date.addMonth(input.Engineering_Delay_Months + input.Engineering_Length_Months + input.Construction_Delay_Months);
										}
						)
					}
				}

			}
