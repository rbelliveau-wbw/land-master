												Sort_Order=1
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="Legal"
												Approver=legalEmail
												Sort_Order=2
												Status="Not Sent"
												Type1="Pro Forma"
											]
											insert into Budget_Approvals
											[
												Added_User=zoho.loginuser
												Proforma=input.ID
												Title="CFO"
												Approver=cfoEmail
												Sort_Order=3
