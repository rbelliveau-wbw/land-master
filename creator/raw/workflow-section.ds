												pfm = Proforma_Months[Proforma = input.ID && Month1 = installment.Month1];
												pfm.Land_Sale=installment.Cost;
											}
											if(installment.Type1 == "PID/MUD")
											{
												pfm = Proforma_Months[Proforma = input.ID && Month1 = installment.Month1];
												pfm.PID_MUD_Revenue=installment.Cost;
											}
										}
										info "Land Cost successful";
						)
					}
