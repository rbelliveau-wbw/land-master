		batchworkflow
		{
			Update_Budget_Totals
			{
    			display name = "Update Budget Totals"
    			type = batchworkflow
    			form = Add_Budget
    			event = "On Schedule"
    			start = "05/11/2026 12:10:07"
    			frequency = daily
    			batch size = 50
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											input.Budget_Grand_Total = Budget_Item[Budget == input.ID].sum(Budget_Ttl);
										input.Prelim_Budget_Grand_Total = Budget_Item[Budget == input.ID].sum(Prelim_Budget_Ttl);
										input.Unapproved_Final_Budget_Grand_Total = Budget_Item[Budget == input.ID].sum(Unapproved_Final_Budget_Ttl);
						)
					}
    			}
			}
			Budgets_Apply_Cost_to_Bud
			{
    			display name = "Budgets - Apply Cost to Budget Lines"
    			type = batchworkflow
    			form = Budget_Item[Template_Item == false]
    			event = "On Schedule"
    			start = "11/27/2025 09:45:35"
    			frequency = daily
    			batch size = 100
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											input.PROJ_Actual = Budget_Import_Item[Budget_Item == input.ID && Data_Source == "Great Plains"].sum(Cost);
										input.HCSS_Actuals = Budget_Import_Item[Budget_Item == input.ID && Data_Source == "HeavyJob"].sum(Cost);
										input.Cost_to_Complete = Budget_Import_Item[Budget_Item == input.ID && Data_Source == "HeavyJob"].sum(Cost_to_Complete);
										input.Percent_Complete = Budget_Import_Item[Budget_Item == input.ID].sum(Percent_Complete);
										if(input.Department == "Construction")
										{
											constBudgetCost = Budget_Import_Item[Budget_Item == input.ID && Data_Source == "HeavyJob Budget"].sum(Cost);
											if(constBudgetCost == null)
											{
												constBudgetCost = 0;
											}
											constApprovalStatus = ifnull(input.Budget.Const_Budget_Approval_Status,"Not Sent");
											if(constApprovalStatus == "Approved")
											{
												// Construction budget has completed approval.
												// Route imported HeavyJob Budget value to Final.
												//Final Numbers no longer updating in real time 7/30/2026
												//input.Budget_Ttl = constBudgetCost;
												input.Unapproved_Final_Budget_Ttl = 0;
											}
											else
											{
												// Construction budget is Not Sent / Pending / Rejected.
												// Route imported HeavyJob Budget value to Unapproved.
												input.Unapproved_Final_Budget_Ttl = constBudgetCost;
											}
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :"contracts@wbdevelopment.com"
											to :"rbelliveau@wbdevelopment.com"
											subject :"Budget Import Items Processing -" + zoho.currentdate
											message :"<div>Import successful.</div>"
										]
						)
					}
    			}
    			on failure 
    			{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :"contracts@wbdevelopment.com"
											to :"rbelliveau@wbdevelopment.com"
											subject :"Budget Import Items Processing" + zoho.currentdate
											message :"<div><br>Import failed.</div>"
										]
						)
					}
    			}
			}
			Budgets_Calc_Category_Tot
			{
    			display name = "Budgets - Calc Category Totals"
    			type = batchworkflow
    			form = Budget_Category
    			event = "On Schedule"
    			start = "11/27/2025 10:45:55"
    			frequency = daily
    			batch size = 500
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											input.Actual_Total = Budget_Item[Budget_Category == input.ID].sum(PROJ_Actual);
										input.Prelim_Budget_Total = Budget_Item[Budget_Category == input.ID].sum(Prelim_Budget_Ttl);
										input.Budget_Total = Budget_Item[Budget_Category == input.ID].sum(Budget_Ttl);
										input.Unapproved_Final_Budget_Total = Budget_Item[Budget_Category == input.ID].sum(Unapproved_Final_Budget_Ttl);
										//input.Budget.Actual_Grand_Total = Budget_Item[Budget == input.Budget].sum(PROJ_Actual);
						)
					}
    			}
			}
			Budgets_Link_Budget_Items
			{
    			display name = "Budgets - Link Budget Items to Import Items"
    			type = batchworkflow
    			form = Budget_Import_Item
    			event = "On Schedule"
    			start = "11/27/2025 09:15:15"
    			frequency = daily
    			batch size = 500
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											// Loop over import rows that don't yet have a linked Budget_Item
										if(input.Budget_Item == null)
										{
											// Build the composite code: <Subdivision_Code>-<Minor_Code>
											itemCode = input.Subdivision_Code + '-' + input.Minor_Code;
											// Look up matching Budget Item by code
											budgItem = Budget_Item[Budget_Code == itemCode];
											if(budgItem.count() == 1)
											{
												// Link the import row to the found Budget Item
												input.Budget_Item = budgItem.ID;
												// Mark import success
												input.Import_Status = "Import Successful";
											}
											else
											{
												// No match found: flag error and capture reason
												input.Import_Status = "Import Error";
												input.Error_Response = "No matching code found on a budget.";
											}
										}
						)
					}
    			}
			}
		}
