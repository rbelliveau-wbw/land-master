			Set_Property_Blank_Select as "Set Property Blank & Select Lots - Mass Create Tax"
			{
				type =  form
				form = Mass_Create_Tax

				record event = on add or edit

				on user input of Subdivision
				{
					actions 
					{
						custom deluge script
						(
											subdiv = input.Subdivision.size();
										property = input.Property1.size();
										if(property != 0 && subdiv != 0)
										{
											input.Property1 = null;
										}
										lotsList = Lots[Subdivision == input.Subdivision && Close_Date == null].ID.getAll();
										input.Lots1 = lotsList;
