			{
				type =  functions
				form = Add_Pro_Forma
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//budget exist check
										budgetExist = Add_Budget[Pro_Forma == input.ID];
										if(budgetExist.count() = 0)
										{
											// Create the Budget from the Pro Forma
											newBudget = insert into Add_Budget
											[
												Added_User=zoho.loginuser
												Pro_Forma=input.ID
												Budget_Type="Pro Forma"
												Budget_Name=input.Name + " Pro Forma - " + zoho.currentdate
											];
											// Fetch all Budget Categories where Template_Item = TRUE
											budgetCategories = Budget_Category[Template_Item == true];
											for each  category in budgetCategories
											{
												// Create a new Budget Category linked to the new Budget
												newBudgetCategory = insert into Budget_Category
												[
													Budget_Category_Name=category.Budget_Category_Name
													Budget=newBudget
													Category_Code=category.Category_Code
													Template_Item=false
													Added_User=zoho.loginuser
													Deparment=category.Deparment
													Reimbursements=category.Reimbursements
												];
												// Fetch all Budget Items where Template_Item=TRUE and Category = Budget_Category.Name
												budgetItems = Budget_Item[Template_Item == true && Category = category.Budget_Category_Name];
												for each  item in budgetItems
												{
													// Create a new Budget Item linked to the new Budget Category
													newBudgetItem = insert into Budget_Item
													[
														Item_Name=item.Item_Name
														Department=item.Department
														Category=item.Category
														Dept_Code=item.Dept_Code
														Cost_Code=item.Cost_Code
														Budget=newBudget
														Budget_Category=newBudgetCategory
														Template_Item=false
														Added_User=zoho.loginuser
														Budget_Code="PF" + input.PF_Number.toString() + "-" + item.Cost_Code
														Department=item.Department
													];
												}
											}
											openURL("#Form:Add_Budget?recLinkID=" + newBudget + "&viewLinkName=All_Budgets","popup window","height=90%,width=90%");
											success message "Budget successfully created for " + input.Name + " Pro Forma.";
										}
										if(budgetExist.count() = 1)
										{
											openURL("#Form:Add_Budget?recLinkID=" + budgetExist.ID + "&viewLinkName=All_Budgets","popup window","height=90%,width=90%");
										}
					)
					}
				}
			}
