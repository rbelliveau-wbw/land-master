			Create_Budget_from_Subdiv as "Create Budget from Subdivision"
			{
				type =  functions
				form = Subdivision
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Create the Budget
										newBudget = insert into Add_Budget
										[
											Subdivision1=input.ID
											Added_User=zoho.loginuser
											Budget_Type="Development"
											Budget_Name=input.Subdivision_Code + " - " + zoho.currentdate
											Subdivision_Code=input.Subdivision_Code
										];
										// Add 8 approval rows to the new Budget
										newBudgetRec = Add_Budget[ID == newBudget];
										// Construction - VP
										row1 = Add_Budget.Approvals();
										row1.Approver="VP@wbdevelopment.com";
										row1.Title="VP";
										row1.Status="Not Sent";
										row1.Type1="Construction";
										row1.Sort_Order=1;
										// Construction - CFO
										row2 = Add_Budget.Approvals();
										row2.Approver="jking@wbdevelopment.com";
										row2.Title="CFO";
										row2.Status="Not Sent";
										row2.Type1="Construction";
										row2.Sort_Order=2;
										// Construction - COO
										row3 = Add_Budget.Approvals();
										row3.Approver="dreinke@wbdevelopment.com";
										row3.Title="COO";
										row3.Status="Not Sent";
										row3.Type1="Construction";
										row3.Sort_Order=3;
										// Development - VP
										row5 = Add_Budget.Approvals();
										row5.Approver="VP@wbdevelopment.com";
										row5.Title="VP";
										row5.Status="Not Sent";
										row5.Type1="Development";
										row5.Sort_Order=1;
										// Development - CFO
										row6 = Add_Budget.Approvals();
										row6.Approver="jking@wbdevelopment.com";
										row6.Title="CFO";
										row6.Status="Not Sent";
										row6.Type1="Development";
										row6.Sort_Order=2;
										// Development - COO
										row7 = Add_Budget.Approvals();
										row7.Approver="dreinke@wbdevelopment.com";
										row7.Title="COO";
										row7.Status="Not Sent";
										row7.Type1="Development";
										row7.Sort_Order=3;
										approvalRows = Collection();
										approvalRows.insert(row1);
										approvalRows.insert(row2);
										approvalRows.insert(row3);
										approvalRows.insert(row5);
										approvalRows.insert(row6);
										approvalRows.insert(row7);
										newBudgetRec.Approvals.insert(approvalRows);
										// Backfill / enforce Sort_Order on all Budget Approval rows
										for each  budgetApproval in Budget_Approvals[ID != 0]
										{
											approvalTitle = ifnull(budgetApproval.Title,"").trim().toUpperCase();
											if(approvalTitle == "VP")
											{
												budgetApproval.Sort_Order=1;
											}
											else if(approvalTitle == "CFO")
											{
												budgetApproval.Sort_Order=2;
											}
											else if(approvalTitle == "COO")
											{
												budgetApproval.Sort_Order=3;
											}
											else if(approvalTitle == "CEO")
											{
												budgetApproval.Sort_Order=4;
											}
										}
										// Fetch all Budget Categories where Template_Item = TRUE
										budgetCategories = Budget_Category[Template_Item == true];
										for each  category in budgetCategories
										{
											// Create a new Budget Category linked to the new Budget
											newBudgetCategory = insert into Budget_Category
											[
												Budget_Category_Name=category.Budget_Category_Name
												Budget=newBudget
												Category_Code=category.Category_Code
												Template_Item=false
												Added_User=zoho.loginuser
												Deparment=category.Deparment
												Reimbursements=category.Reimbursements
											];
											// Fetch all Budget Items where Template_Item=TRUE and Category = Budget_Category.Name
											budgetItems = Budget_Item[Template_Item == true && Category = category.Budget_Category_Name];
											for each  item in budgetItems
											{
												// Create a new Budget Item linked to the new Budget Category
												newBudgetItem = insert into Budget_Item
												[
													Item_Name=item.Item_Name
													Department=item.Department
													Category=item.Category
													Dept_Code=item.Dept_Code
													Cost_Code=item.Cost_Code
													Budget=newBudget
													Budget_Category=newBudgetCategory
													Template_Item=false
													Added_User=zoho.loginuser
													Budget_Code=input.Subdivision_Code + "-" + item.Cost_Code
													Department=item.Department
												];
											}
										}
										success message "Budget successfully created for " + input.Subdivision_Name;
					)
					}
				}
			}
			Refresh_Import_Items_Budg as "Refresh/Import Items - Budget"
			{
				type =  functions
				form = Add_Budget
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Gets all template budget items and check if they exist in the chosen Budget -- if not creates the Budget Item -- used to create missing items in Budgets if a new item is added to the template
										templateItems = Budget_Item[Template_Item == TRUE];
										// Get all existing budget item cost codes for the current budget
										budgItems = Budget_Item[Budget == input.ID].Cost_Code.getAll();
										// Clean up cost codes into a trimmed list
										cleanBudgItems = List();
										for each  code in budgItems
										{
											cleanBudgItems.add(code.toString().trim());
										}
										// Loop through template items
										for each  item in templateItems
										{
											// Normalize the template item's cost code
											code = item.Cost_Code.toString().trim();
											// Check if cost code already exists in current budget
											checkItem = cleanBudgItems.contains(code);
											info "Checking code: " + code + " | Exists: " + checkItem;
											if(checkItem == FALSE)
											{
												// Find matching budget category in this budget
												budgCategory = Budget_Category[Budget_Category_Name == item.Category && Budget == input.ID];
												// Insert missing item into Budget_Item
												newBudgetItem = insert into Budget_Item
												[
													Item_Name=item.Item_Name
													Department=item.Department
													Category=item.Category
													Dept_Code=item.Dept_Code
													Cost_Code=item.Cost_Code
													Budget=input.ID
													Budget_Category=budgCategory.ID
													Template_Item=false
													Added_User=zoho.loginuser
													Budget_Code=input.Subdivision1.Subdivision_Code + "-" + item.Cost_Code
												];
												// Log inserted item
												info "MISSING ITEM CREATED: " + item.Cost_Code + " - " + item.Item_Name;
											}
										}
					)
					}
					actions 
					{
					on click
					(
						// Loop through all categories in the input
										for each  cat in input.Budget_Categories
										{
											// Loop through all budget items within the current category
											for each  item in cat.Budget_Items
											{
												// Find the template item that matches the item's cost code
												templateItem = Budget_Item[Template_Item == TRUE && Cost_Code == item.Cost_Code];
												// Look up the correct budget category using the template item's category
												newCat = Budget_Category[Budget == item.Budget && Budget_Category_Name == templateItem.Category];
												// Update the budget item's category to match the template if it doesn't already match
												if(item.Budget_Category.Budget_Category_Name != newCat.Budget_Category_Name)
												{
													item.Budget_Category=newCat;
													info "BUDGET ITEM " + item.Budget_Code + " MOVED TO " + newCat.Budget_Category_Name;
												}
											}
										}
					)
					}
					actions 
					{
					on click
					(
						//create missing Budget Categories
										//get template categories
										for each  catTemplate in Budget_Category[Template_Item == TRUE]
										{
											budgCats = Budget_Category[Budget == input.ID && Budget_Category_Name == catTemplate.Budget_Category_Name];
											if(budgCats.count() = 0)
											{
												insert into Budget_Category
												[
													Budget_Category_Name=catTemplate.Budget_Category_Name
													Template_Item=false
													Reimbursements=catTemplate.Reimbursements
													Budget=input.ID
													Deparment=catTemplate.Deparment
													Category_Code=catTemplate.Category_Code
													Added_User=zoho.loginuser
												]
												info "Added " + catTemplate.Budget_Category_Name + " to Budget Category list in ";
											}
										}
					)
					}
					actions 
					{
					on click
					(
						//loops through all items in the refreshed budget and fixes the names if they need it
										for each  item in Budget_Item[Budget == input.ID]
										{
											code = input.Subdivision1.Subdivision_Code + "-" + item.Cost_Code;
											if(item.Budget_Code != code)
											{
												info item.Budget_Code + " BEING UPDATED TO: " + code;
												item.Budget_Code=code;
											}
										}
					)
					}
					actions 
					{
					on click
					(
						//put items in the correct category
										for each  item in Budget_Item[Budget == input.ID]
										{
											//get Budget Category
											budgCat = Budget_Category[Budget_Category_Name == item.Category && Template_Item == FALSE && Budget == input.ID];
											//if Budget Cat returns 1 value and it doesn't equal what is currently assigned to the item
											if(budgCat.count() = 1 && item.Budget_Category != budgCat.ID)
											{
												item.Budget_Category=budgCat.ID;
												info "Moved " + item.Item_Name + " to " + budgCat.Budget_Category_Name;
											}
										}
					)
					}
				}
			}
