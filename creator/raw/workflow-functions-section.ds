			Email_Doug_the_Budget as "Email Doug the Budget"
			{
				type =  functions
				form = Add_Budget
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						/********* START BUDGET APPROVAL CHAINS *********/
										// Report button on All_Budgets / Add_Budget row
										resp = thisapp.startAllApprovalChains(input.ID);
										info resp;
					)
					}
					actions  (Acres == 1312312)
					{
					on click
					(
						for each  b in Add_Budget[ID != 0]
										{
											approvalCount = 0;
											if(b.Approvals != null)
											{
												approvalCount = b.Approvals.length();
											}
											if(approvalCount != 8)
											{
												row1 = Add_Budget.Approvals();
												row1.Approver="jking@wbdevelopment.com";
												row1.Title="CFO";
												row1.Status="Not Sent";
												row1.Type1="Construction";
												row2 = Add_Budget.Approvals();
												row2.Approver="dreinke@wbdevelopment.com";
												row2.Title="COO";
												row2.Status="Not Sent";
												row2.Type1="Construction";
												row3 = Add_Budget.Approvals();
												row3.Approver="bruce@wbdevelopment.com";
												row3.Title="CEO";
												row3.Status="Not Sent";
												row3.Type1="Construction";
												row4 = Add_Budget.Approvals();
												row4.Approver="VP@wbdevelopment.com";
												row4.Title="VP";
												row4.Status="Not Sent";
												row4.Type1="Construction";
												row5 = Add_Budget.Approvals();
												row5.Approver="jking@wbdevelopment.com";
												row5.Title="CFO";
												row5.Status="Not Sent";
												row5.Type1="Development";
												row6 = Add_Budget.Approvals();
												row6.Approver="dreinke@wbdevelopment.com";
												row6.Title="COO";
												row6.Status="Not Sent";
												row6.Type1="Development";
												row7 = Add_Budget.Approvals();
												row7.Approver="bruce@wbdevelopment.com";
												row7.Title="CEO";
												row7.Status="Not Sent";
												row7.Type1="Development";
												row8 = Add_Budget.Approvals();
												row8.Approver="VP@wbdevelopment.com";
												row8.Title="VP";
												row8.Status="Not Sent";
												row8.Type1="Development";
												rows = Collection();
												rows.insert(row1);
												rows.insert(row2);
												rows.insert(row3);
												rows.insert(row4);
												rows.insert(row5);
												rows.insert(row6);
												rows.insert(row7);
												rows.insert(row8);
												b.Approvals.insert(rows);
											}
										}
					)
					}
				}
			}
		}
