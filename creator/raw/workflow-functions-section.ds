			Refresh_Forecasts_Forecas as "Refresh Forecasts/Forecast Years - Forecast Year"
			{
				type =  functions
				form = Forecast_Year
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//iterate through every Forecast record
										for each  forecast in Forecast[Forecast_Year2 == input.ID]
										{
											//create variable for Forecast.Forecast_StartDate plus one month -- to create Forecast end date
											forecastEnddate = forecast.Forecast_Start_Date.addMonth(1);
											//count all Lots with same Builder, Subdiv as Forecast and check for  whether Close Date is within FC Start Date plus one month & status of Closed
											lotsScheduled = Lots[Subdivision == forecast.Subdivision1 && Builder1 == forecast.Builder1 && Purchase_Date >= forecast.Forecast_Start_Date && Purchase_Date < forecastEnddate && Close_Date == null].count();
											lotsSold = Lots[Subdivision == forecast.Subdivision1 && Builder1 == forecast.Builder1 && Close_Date >= forecast.Forecast_Start_Date && Close_Date < forecastEnddate && Status = "Sold"].count();
											//write value to Forecast.Actual_Lots
											if(lotsSold == 0)
											{
												forecast.Actual_Lots=null;
											}
											if(lotsScheduled == 0)
											{
												forecast.Scheduled_Lots=null;
											}
											if(lotsSold > 0)
											{
												forecast.Actual_Lots=lotsSold;
											}
											if(lotsScheduled > 0)
											{
												forecast.Scheduled_Lots=lotsScheduled;
											}
										}
					)
					}
					actions 
					{
					on click
					(
						//Forecast Year dropdown is stored as string, this changed to number
										fcyearTonum = input.Forecast_Year.toNumber();
										//this variable sets the final day of the Forecast Year -- Jan 31st of FC Year + 1 --  to be used in the lotsSold query
										fcYearpone = "01/31/" + (fcyearTonum + 1);
										//query all Sold lots with same Builder/Subdiv as Forecast Year record with Close Date >= 02/01 and Close Date <= 01/31 of the next year
										lotsSold = Lots[Subdivision == input.Subdivision1 && Builder1 == input.Builder1 && Status == "Sold" && Close_Date >= "02/01/" + input.Forecast_Year && Close_Date <= fcYearpone].count();
										//query all Contracted lots with same Builder/Subdiv as Forecast Year
										//query all Contracted lots with same Builder/Subdiv as Forecast Year
										if(input.Builder1.Builder_Name != "Placeholder")
										{
											lotsContracted = Lots[Subdivision == input.Subdivision1 && Builder1 == input.Builder1 && Status == "Contracted"].count();
										}
										if(input.Builder1.Builder_Name == "Placeholder")
										{
											lotsContracted = Lots[Subdivision == input.Subdivision1 && Builder1 == input.Builder1].count();
										}
										//query all Forecasts that belong to this Forecast year and sum the Actual/Sold values if prev month
										fcActual = Forecast[Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1 && Forecast_Year == input.Forecast_Year && Forecast_Start_Date <= zoho.currentdate.subMonth(1)].sum(Actual_Lots);
										//info fcActual;
										//query all Forecasts that belong to this FC Year and sum the Forecasted lots this month and going forward
										fcForecasted = Forecast[Subdivision1 == input.Subdivision1 && Builder1 == input.Builder1 && Forecast_Year == input.Forecast_Year && Forecast_Start_Date > zoho.currentdate.subMonth(1)].sum(Forecasted_Lots);
										//info fcForecasted;
										//set Forecasted plus Actual variable
										fcPlusactual = fcActual.toLong() + fcForecasted.toLong();
										//write lotsSold count and lotsContracted count to Forecast Year fields
										input.Total_Sold_Forecasted = fcPlusactual;
										input.Total_Sold_Lots = lotsSold;
										input.Total_Contracted_Lots = lotsContracted;
										//set subdiv code -- can delete after runs once
										subdivCode = Subdivision[ID == input.Subdivision1].Subdivision_Code;
										input.Subdivision_Code = subdivCode;
					)
					}
					actions 
					{
					on click
					(
						if(input.Status == "Planning")
										{
											input.Forecast_Name = input.Subdivision_Code + " - " + "Planning" + " - FC" + input.Forecast_Year;
										}
										if(input.Status == "Builder")
										{
											input.Forecast_Name = input.Subdivision_Code + " - " + input.Builder1.Builder_Name + " - FC" + input.Forecast_Year;
										}
					)
					}
				}
			}
			Send_for_Approvals_Contra1 as "Send for Approvals - Contracts"
			{
				type =  functions
				form = Contract
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//get latest Contract Version by created date
										contractFiles = Contract_Version[Contract1 == input.ID && Email_Attachment == TRUE].File_field1.getAll();
										minApprovalsequence = Contract_Approvals[Contract1 == input.ID && Status == "Not Sent"].minimum(Approval_Sequence);
										for each  contractApproval in input.Approvals1
										{
											contractApproval.Reject_Reason=null;
											emailBody = "<p>The following contract is awaiting your approval.</p><br><a href='https://creatorapp.zohopublic.com/wbdevelopment/land-master/Contract_Approvals/record-edit/All_Contract_Approvals/" + contractApproval.ID + "/56FD5tkOEUKxhpxFhOkgQrUbN8yQVks7WpPAUU6R300UDB4bp59fsE4RDETy3Sp4yTUaMzeVmfY3OkmXRWSh3O2uXKn4pSrnGeOT'>Approve/Reject</a>";
											if(contractApproval.Approval_Email == TRUE)
											{
												sendmail
												[
													from :"Contracts@wbdevelopment.com"
													to :contractApproval.Approver
													subject :input.Builder.Builder_Name + " " + contractApproval.Type1 + " for " + input.Subdivision1.Subdivision_Name + " is awaiting your approval."
													message :emailBody + "<p>Subdivision: " + input.Subdivision1.Subdivision_Name + "</p>" + "<p>Buyer: " + input.Builder.Builder_Name + "</p>" + "<p>Initiated by: " + input.Modified_User + "</p>"
													Attachments :file:contractFiles
												]
												contractApproval.Status="Awaiting Approval";
												contractApproval.Approval_Email=FALSE;
												contractApproval.Last_Reminder_Date=zoho.currentdate;
												contractApproval.Next_Reminder_Date=contractApproval.Last_Reminder_Date.addDay(contractApproval.Reminder_Interval_Days);
												input.Status = "Awaiting Approvals";
												input.Current_Approver = contractApproval.Approver;
											}
										}
					)
					}
				}
			}
