                 			else if(ifnull(pdfPhase.Total_Lots,0).toLong() > ifnull(pdfPhase.Initial_Take_Lots,0).toLong() && pdfPhase.First_Recurring_Delay_Months == null || pdfPhase.Lots_Per_Take == null || ifnull(pdfPhase.First_Recurring_Delay_Months,0).toLong() < 1 || ifnull(pdfPhase.Lots_Per_Take,0).toLong() < 1)
