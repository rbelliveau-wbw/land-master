                 		{
                 			pf.Estimated_Completion=header.get("Estimated_Completion").toString().toDate("MM/dd/yyyy");
                 		}
                 		if(header.get("Gross_Sales") != null && header.get("Gross_Sales").toString() != "")
                 		{
                 			pf.Gross_Sales=header.get("Gross_Sales").toDecimal();
