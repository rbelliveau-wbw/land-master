                 		if(header.get("MUD_Revenue") != null && header.get("MUD_Revenue").toString() != "")
                 		{
                 			pf.MUD_Revenue=header.get("MUD_Revenue").toDecimal();
                 		}
                 		if(header.get("Reimbursements") != null && header.get("Reimbursements").toString() != "")
                 		{
                 			pf.Reimbursements=header.get("Reimbursements").toDecimal();
                 		}
                 		if(header.get("Reimbursed_Fees") != null && header.get("Reimbursed_Fees").toString() != "")
                 		{
                 			pf.Reimbursed_Fees=header.get("Reimbursed_Fees").toDecimal();
                 		}
                 		if(header.get("Total_Income") != null && header.get("Total_Income").toString() != "")
                 		{
                 			pf.Total_Income=header.get("Total_Income").toDecimal();
                 		}
                 		if(header.get("Entitlement_Cost") != null && header.get("Entitlement_Cost").toString() != "")
                 		{
                 			pf.Entitlement_Cost=header.get("Entitlement_Cost").toDecimal();
                 		}
                 		if(header.get("Entitlement_Engineering_Addl") != null && header.get("Entitlement_Engineering_Addl").toString() != "")
                 		{
                 			pf.Entitlement_Engineering_Addl=header.get("Entitlement_Engineering_Addl").toDecimal();
                 		}
                 		if(header.get("Construction_Cost_Base") != null && header.get("Construction_Cost_Base").toString() != "")
                 		{
                 			pf.Construction_Cost_Base=header.get("Construction_Cost_Base").toDecimal().round(0);
                 		}
                 		if(header.get("Construction_Cost_Addl") != null && header.get("Construction_Cost_Addl").toString() != "")
                 		{
                 			pf.Construction_Cost_Addl=header.get("Construction_Cost_Addl").toDecimal();
                 		}
                 		if(header.get("Total_Expenses") != null && header.get("Total_Expenses").toString() != "")
                 		{
                 			pf.Total_Expenses=header.get("Total_Expenses").toDecimal();
                 		}
                 		if(header.get("Net_Profit") != null && header.get("Net_Profit").toString() != "")
                 		{
                 			pf.Net_Profit=header.get("Net_Profit").toDecimal();
                 		}
                 		if(header.get("ROI1") != null && header.get("ROI1").toString() != "")
                 		{
                 			pf.ROI1=header.get("ROI1").toDecimal();
                 		}
                 		if(header.get("IRR") != null && header.get("IRR").toString() != "")
                 		{
                 			pf.IRR=header.get("IRR").toDecimal();
                 		}
                 		if(header.get("XIRR") != null && header.get("XIRR").toString() != "")
                 		{
                 			pf.XIRR=header.get("XIRR").toDecimal();
                 		}
                 		if(header.get("Overhead_Total") != null && header.get("Overhead_Total").toString() != "")
                 		{
                 			pf.Overhead_Total=header.get("Overhead_Total").toDecimal();
                 		}
                 		if(header.get("Engineering_Overhead_Total") != null && header.get("Engineering_Overhead_Total").toString() != "")
                 		{
                 			pf.Engineering_Overhead_Total=header.get("Engineering_Overhead_Total").toDecimal();
