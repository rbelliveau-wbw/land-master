				 string modificationAdmin(string action, int modificationId, int budgetId, string modType, string amount, string reason, string reference, string effectiveDate)
                 {
                 	/********* MODIFICATION ADMIN *********/
                 	// Return Type: string ("OK: ..." or "ERROR: ...")
                 	// actions: "update" | "delete" | "reopen" | "repair" | "check-send" | "repair-send"
                 	// - update: edit fields on any modification (modificationId + optional fields).
                 	// - delete: remove a modification AND its approval chain; recalcs Revised_Final
                 	//   if the modification was Approved.
                 	// - reopen: send a Rejected modification back to Draft with a cleared chain so
                 	//   it can be revised and resubmitted.
                 	// - repair: relink orphaned Modification-type approval rows on a budget to their
                 	//   modifications (artifacts of the pre-6.4 linking bug), building fresh chains
                 	//   where none can be claimed, then removing unreachable leftovers. Idempotent,
                 	//   never sends email.
                 	// The widget gates all three behind User_Access.Edit_Delete_All_Modifications
                 	// (repair is also invoked automatically on inconsistency detection).
                 	vAction = ifnull(action,"").trim().toLowerCase();
                 	combinedMod = Budget_Modification[ID == modificationId.toLong()];
                 	if(ifnull(combinedMod.Reference_Number,"").startsWith("PO:"))
                 	{
                 		return "ERROR: This modification belongs to a combined Purchase Order approval. Open the PO to edit or resubmit.";
                 	}
                 	if(vAction == "check-reject" || vAction == "repair-reject")
                 	{
                 		vModId = modificationId.toLong();
                 		vRowId = ifnull(reference,"").trim();
                 		modRec = Budget_Modification[ID == vModId];
                 		if(modRec == null || vRowId == "")
                 		{
                 			return "ERROR: Modification or approval row not found.";
                 		}
                 		targetRows = Budget_Approvals[ID == vRowId.toLong() && Budget_Modification == vModId && Type1 == "Modification"];
                 		if(targetRows.count() != 1)
                 		{
                 			return "ERROR: Target approval row not found.";
                 		}
                 		targetRow = null;
                 		for each  oneRow in targetRows
                 		{
                 			targetRow = oneRow;
                 		}
                 		if(vAction == "repair-reject" && ifnull(targetRow.Status,"").trim() == "Rejected" && ifnull(modRec.Status,"").trim() == "Submitted")
                 		{
                 			modRec.Status="Rejected";
                 		}
                 		rows = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"];
                 		pendingCount = 0;
                 		approvedCount = 0;
                 		rowCount = 0;
                 		for each  row in rows
                 		{
                 			rowCount = rowCount + 1;
                 			if(ifnull(row.Status,"").trim() == "Pending")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			if(ifnull(row.Status,"").trim() == "Approved")
                 			{
                 				approvedCount = approvedCount + 1;
                 			}
                 		}
                 		result = Map();
                 		result.put("ok",true);
                 		result.put("modificationId",vModId.toString());
                 		result.put("approvalId",vRowId);
                 		result.put("status",ifnull(modRec.Status,"").trim());
                 		result.put("currentStatus",ifnull(targetRow.Status,"").trim());
                 		result.put("noteMatches",ifnull(targetRow.Approval_Notes,"").trim() == ifnull(reason,"").trim());
                 		result.put("rowCount",rowCount);
                 		result.put("pendingCount",pendingCount);
                 		result.put("approvedCount",approvedCount);
                 		return result.toString();
                 	}
                 	if(vAction == "check-send" || vAction == "repair-send")
                 	{
                 		vModId = modificationId.toLong();
                 		modRec = Budget_Modification[ID == vModId];
                 		if(modRec == null)
                 		{
                 			return "ERROR: Modification not found.";
                 		}
                 		rows = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"] sort by Sort_Order;
                 		firstRow = null;
                 		pendingCount = 0;
                 		approvedCount = 0;
                 		rowCount = 0;
                 		for each  row in rows
                 		{
                 			rowCount = rowCount + 1;
                 			if(firstRow == null)
                 			{
                 				firstRow = row;
                 			}
                 			if(ifnull(row.Status,"").trim() == "Pending")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			if(ifnull(row.Status,"").trim() == "Approved")
                 			{
                 				approvedCount = approvedCount + 1;
                 			}
                 		}
                 		repairError = "";
                 		repairChainReady = false;
                 		repairStatusReady = false;
                 		if(firstRow != null)
                 		{
                 			firstRepairStatus = ifnull(firstRow.Status,"").trim();
                 			repairStatusReady = firstRepairStatus == "Not Sent" || firstRepairStatus == "Pending";
                 			if(pendingCount == 0)
                 			{
                 				repairChainReady = true;
                 			}
                 			if(pendingCount == 1 && firstRepairStatus == "Pending")
                 			{
                 				repairChainReady = true;
                 			}
                 		}
                 		if(vAction == "repair-send" && ifnull(modRec.Status,"").trim() == "Submitted" && firstRow != null && approvedCount == 0 && repairChainReady && firstRow.Sent_Date == null && repairStatusReady)
                 		{
                 			try 
                 			{
                 				emailResult = thisapp.sendModificationEmail(vModId,"created");
                 				if(!ifnull(emailResult,"").startsWith("Modification email sent"))
                 				{
                 					repairError = ifnull(emailResult,"Approval email could not be sent.");
                 				}
                 			}			catch (repairException)
                 			{
                 				repairError = repairException.toString();
                 			}
                 		}
                 		rows = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"] sort by Sort_Order;
                 		firstRow = null;
                 		pendingCount = 0;
                 		approvedCount = 0;
                 		rowCount = 0;
                 		for each  row in rows
                 		{
                 			rowCount = rowCount + 1;
                 			if(firstRow == null)
                 			{
                 				firstRow = row;
                 			}
                 			if(ifnull(row.Status,"").trim() == "Pending")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			if(ifnull(row.Status,"").trim() == "Approved")
                 			{
                 				approvedCount = approvedCount + 1;
                 			}
                 		}
                 		result = Map();
                 		result.put("ok",true);
                 		result.put("modificationId",vModId.toString());
                 		result.put("status",ifnull(modRec.Status,"").trim());
                 		result.put("rowCount",rowCount);
                 		result.put("pendingCount",pendingCount);
                 		result.put("approvedCount",approvedCount);
                 		firstId = "";
                 		firstStatus = "";
                 		firstRole = "";
                 		firstAddress = "";
                 		firstSent = "";
                 		if(firstRow != null)
                 		{
                 			firstId = firstRow.ID.toString();
                 			firstStatus = ifnull(firstRow.Status,"").trim();
                 			firstRole = ifnull(firstRow.Title,"").trim();
                 			firstAddress = ifnull(firstRow.Approver,"").trim();
                 			if(firstRow.Sent_Date != null)
                 			{
                 				firstSent = firstRow.Sent_Date.toString();
                 			}
                 		}
                 		result.put("firstId",firstId);
                 		result.put("firstStatus",firstStatus);
                 		result.put("role",firstRole);
                 		result.put("address",firstAddress);
                 		result.put("sentDate",firstSent);
                 		result.put("repairError",repairError);
                 		return result.toString();
                 	}
                 	if(vAction == "update")
                 	{
                 		vModId = modificationId.toLong();
                 		modRec = Budget_Modification[ID == vModId];
                 		if(modRec == null)
                 		{
                 			return "ERROR: Modification not found.";
                 		}
                 		vType = ifnull(modType,"").trim();
                 		if(vType == "Increase" || vType == "Decrease")
                 		{
                 			modRec.Modification_Type=vType;
                 		}
                 		vAmt = ifnull(amount,"").trim();
                 		if(vAmt != "")
                 		{
                 			vAmount = vAmt.toDecimal();
                 			if(vAmount <= 0)
                 			{
                 				return "ERROR: Amount must be greater than zero.";
                 			}
                 			modRec.Amount=vAmount;
                 		}
                 		vReason = ifnull(reason,"").trim();
                 		if(vReason != "")
                 		{
                 			modRec.Reason=vReason;
                 		}
                 		vRef = ifnull(reference,"").trim();
                 		if(vRef != "")
                 		{
                 			modRec.Reference_Number=vRef;
                 		}
                 		vDate = ifnull(effectiveDate,"").trim();
                 		if(vDate != "")
                 		{
                 			modRec.Effective_Date=vDate.toDate();
                 		}
                 		// Keep the persisted Revised_Final + Modified Final rollups in sync when an
                 		// approved delta changes.
                 		if(ifnull(modRec.Status,"") == "Approved" && modRec.Budget_Item != null)
                 		{
                 			recalcMsg = thisapp.recalcItemRevisedFinal(modRec.Budget_Item.ID);
                 			if(budgetId.toLong() != 0)
                 			{
                 				rollupMsg = thisapp.recalcBudgetModifiedTotals(budgetId.toLong());
                 			}
                 		}
                 		return "OK: Modification updated.";
                 	}
                 	if(vAction == "delete")
                 	{
                 		vModId = modificationId.toLong();
                 		modRec = Budget_Modification[ID == vModId];
                 		if(modRec == null)
                 		{
                 			return "ERROR: Modification not found.";
                 		}
                 		vItemId = 0;
                 		if(modRec.Budget_Item != null)
                 		{
                 			vItemId = modRec.Budget_Item.ID;
                 		}
                 		wasApproved = ifnull(modRec.Status,"") == "Approved";
                 		// The approval chain goes with the modification.
                 		delete from Budget_Approvals[Budget_Modification == vModId];
                 		delete from Budget_Modification[ID == vModId];
                 		if(wasApproved && vItemId != 0)
                 		{
                 			recalcMsg = thisapp.recalcItemRevisedFinal(vItemId);
                 			if(budgetId.toLong() != 0)
                 			{
                 				rollupMsg = thisapp.recalcBudgetModifiedTotals(budgetId.toLong());
                 			}
                 		}
                 		return "OK: Modification and its approvals deleted.";
                 	}
                 	if(vAction == "reopen")
                 	{
                 		/********* REVISE AND RESUBMIT *********/
                 		// Rejecting a modification is terminal, unlike a budget or Pro Forma
                 		// rejection which returns to the prior approver. Without this the record
                 		// dead-ends: Submit is gone because the status is not Draft, and only a
                 		// delete clears it. Reopen resets it to Draft with a blank chain so the
                 		// normal edit-then-submit flow can run again from the top.
                 		vModId = modificationId.toLong();
                 		modRec = Budget_Modification[ID == vModId];
                 		if(modRec == null)
                 		{
                 			return "ERROR: Modification not found.";
                 		}
                 		vStatus = ifnull(modRec.Status,"").trim();
                 		if(vStatus == "Approved")
                 		{
                 			return "ERROR: An approved modification cannot be reopened. Delete it instead.";
                 		}
                 		if(vStatus == "Submitted")
                 		{
                 			return "ERROR: This modification is already in approvals.";
                 		}
                 		// A fresh chain is rebuilt on submit, and rebuilding beats resetting: it
                 		// picks up the current territory VP and the current COO threshold.
                 		delete from Budget_Approvals[Budget_Modification == vModId];
                 		modRec.Status="Draft";
                 		modRec.Approved_On=null;
                 		modRec.Approved_By="";
                 		// Zoho has silently dropped fetch-assign writes on this form before, and a
                 		// dropped write here would leave the record Rejected with no chain. Reading
                 		// it back turns that into a visible error; clicking Revise & Resubmit again
                 		// then succeeds, because the chain delete is already a no-op.
                 		checkRec = Budget_Modification[ID == vModId];
                 		if(checkRec != null && ifnull(checkRec.Status,"").trim() != "Draft")
                 		{
                 			return "ERROR: The approval chain was cleared but the status did not save. Try Revise & Resubmit once more.";
                 		}
                 		return "OK: Modification reopened for revision.";
                 	}
                 	if(vAction == "repair")
                 	{
                 		vBudgetId = budgetId.toLong();
                 		if(vBudgetId == 0)
                 		{
                 			return "ERROR: No budget provided.";
                 		}
                 		approverEmail = "rbelliveau@wbdevelopment.com";
                 		// Rebuilt chains use the territory VP too, so a repair matches a fresh create.
                 		vTerritory = "";
                 		budgetRec = Add_Budget[ID == vBudgetId];
                 		if(budgetRec != null && budgetRec.Subdivision1 != null)
                 		{
                 			vTerritory = ifnull(budgetRec.Subdivision1.Territory,"").trim();
                 		}
                 		vpEmail = thisapp.territoryApproverEmail(vTerritory,"VP");
                 		if(vpEmail == "")
                 		{
                 			vpEmail = approverEmail;
                 		}
                 		relinked = 0;
                 		rebuilt = 0;
                 		// COO routing threshold applies to rebuilt chains too.
                 		vThreshold = 0.0;
                 		settingsRec = Settings[ID != 0];
                 		if(settingsRec != null)
                 		{
                 			vThreshold = ifnull(settingsRec.COO_Approval_Threshold,0.0);
                 		}
                 		mods = Budget_Modification[Budget == vBudgetId];
                 		for each  modRec in mods
                 		{
                 			if(ifnull(modRec.Reference_Number,"").startsWith("PO:"))
                 			{
                 				continue;
                 			}
                 			linked = Budget_Approvals[Budget_Modification == modRec.ID && Type1 == "Modification"];
                 			if(linked.count() == 0)
                 			{
                 				vStatus = ifnull(modRec.Status,"");
                 				if(vStatus == "Submitted" || vStatus == "Draft")
                 				{
                 					// Claim one orphaned VP + CFO pair if available, else build fresh rows.
                 					orphanVP = Budget_Approvals[Budget == vBudgetId && Type1 == "Modification" && Budget_Modification == null && Sort_Order == 1];
                 					orphanCFO = Budget_Approvals[Budget == vBudgetId && Type1 == "Modification" && Budget_Modification == null && Sort_Order == 2];
                 					if(orphanVP != null && orphanCFO != null)
                 					{
                 						orphanVP.Budget_Modification=modRec.ID;
                 						orphanCFO.Budget_Modification=modRec.ID;
                 						if(vStatus == "Submitted" && ifnull(orphanVP.Status,"") == "Not Sent")
                 						{
                 							orphanVP.Status="Pending";
                 							orphanVP.Sent_Date=zoho.currentdate;
                 						}
                 						relinked = relinked + 1;
                 					}
                 					else
                 					{
                 						vpStatus = "Not Sent";
                 						if(vStatus == "Submitted")
                 						{
                 							vpStatus = "Pending";
                 						}
                 						a1 = insert into Budget_Approvals
                 						[
                 							Added_User=zoho.loginuser
                 							Approver=vpEmail
                 							Title="VP"
                 							Status=vpStatus
                 							Type1="Modification"
                 							Sort_Order=1
                 							Budget=vBudgetId
                 							Budget_Modification=modRec.ID
                 						];
                 						if(vStatus == "Submitted")
                 						{
                 							a1Rec = Budget_Approvals[ID == a1];
                 							if(a1Rec != null)
                 							{
                 								a1Rec.Sent_Date=zoho.currentdate;
                 							}
                 						}
                 						a2 = insert into Budget_Approvals
                 						[
                 							Added_User=zoho.loginuser
                 							Approver=approverEmail
                 							Title="CFO"
                 							Status="Not Sent"
                 							Type1="Modification"
                 							Sort_Order=2
                 							Budget=vBudgetId
                 							Budget_Modification=modRec.ID
                 						];
                 						if(vThreshold > 0 && ifnull(modRec.Amount,0.0) > vThreshold)
                 						{
                 							a3 = insert into Budget_Approvals
                 							[
                 								Added_User=zoho.loginuser
                 								Approver=approverEmail
                 								Title="COO"
                 								Status="Not Sent"
                 								Type1="Modification"
                 								Sort_Order=3
                 								Budget=vBudgetId
                 								Budget_Modification=modRec.ID
                 							];
                 						}
                 						rebuilt = rebuilt + 1;
                 					}
                 				}
                 			}
                 		}
                 		// Any orphans still left are unreachable by the widget - remove them.
                 		leftovers = Budget_Approvals[Budget == vBudgetId && Type1 == "Modification" && Budget_Modification == null];
                 		removed = leftovers.count();
                 		delete from Budget_Approvals[Budget == vBudgetId && Type1 == "Modification" && Budget_Modification == null];
                 		return "OK: repair relinked=" + relinked.toString() + " rebuilt=" + rebuilt.toString() + " removed=" + removed.toString();
                 	}
                 	return "ERROR: Unknown action.";
                 }
				 void openBudget(int proformaId)
                 {
                 	budgetExist = Add_Budget[Pro_Forma == proformaId.toLong()];
                 	if(budgetExist.count() = 1)
                 	{
                 		openURL("#Form:Add_Budget?recLinkID=" + budgetExist.ID + "&viewLinkName=All_Budgets","popup window","height=90%,width=90%");
                 	}
                 }
				 string PF_AI_Review(string payload)
                 {
                 	// AI check of a Pro Forma against the founder's criteria stored in Settings.
                 	// Called by Custom API Review_PF (dev) / Review_PF1 (prod) from the proforma-manager widget.
                 	// Entire JSON: the whole POST body arrives as this single string arg. Also accepts a bare record id.
                 	// Payload: {"proformaId": "...", "reviewedBy": "email", "dryRun": false}
                 	// Returns: {success, proformaId, provider, model, criteriaVersion, reviewedOn, reviewId,
                 	//           result:{verdict, score, summary, meets[], misses[], questions[]}, summarySent:{...}}
                 	resp = Map();
                 	try 
                 	{
                 		// ---- 1. Parse the payload ---------------------------------------------
                 		pfId = payload.trim();
                 		reviewedBy = zoho.loginuserid;
                 		dryRun = false;
                 		if(pfId.startsWith("{"))
                 		{
                 			data = payload.toMap();
                 			if(data.get("payload") != null)
                 			{
                 				data = data.get("payload").toString().toMap();
                 			}
                 			pfId = ifnull(data.get("proformaId"),"").toString().trim();
                 			reviewedBy = ifnull(data.get("reviewedBy"),reviewedBy).toString().trim();
                 			dryRun = ifnull(data.get("dryRun"),"false").toString() == "true";
                 		}
                 		if(pfId == "")
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Pro Forma id is required.");
                 			return resp.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == pfId.toLong()];
                 		if(pf.count() == 0)
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Pro Forma not found.");
                 			return resp.toString();
                 		}
                 		// ---- 2. Criteria + provider/model from the Settings singleton -----------
                 		criteria = "";
                 		provider = "openai";
                 		model = "gpt-5.6-luna";
                 		criteriaVersion = "";
                 		for each  s in Settings[ID != 0]
                 		{
                 			criteria = ifnull(s.PF_Review_Criteria,"").toString().trim();
                 			provider = ifnull(s.PF_Review_Provider,"").toString().trim().toLowerCase();
                 			model = ifnull(s.PF_Review_Model,"").toString().trim();
                 			criteriaVersion = ifnull(s.PF_Review_Criteria_Updated,"").toString();
                 			break;
                 		}
                 		if(provider == "")
                 		{
                 			provider = "openai";
                 		}
                 		if(model == "")
                 		{
                 			model = "gpt-5.6-luna";
                 		}
                 		if(criteria == "")
                 		{
                 			resp.put("success",false);
                 			resp.put("error","PF Review Criteria is empty on the Settings page.");
                 			return resp.toString();
                 		}
                 		if(provider != "openai")
                 		{
                 			// OpenRouter needs its own Connection ("openrouter") and a second invokeurl block —
                 			// Deluge takes the connection name as a literal, so it cannot be switched at runtime.
                 			resp.put("success",false);
                 			resp.put("error","Provider '" + provider + "' is not wired yet. Set PF Review Provider to openai.");
                 			return resp.toString();
                 		}
                 		// ---- 3. Compact deal summary: the numbers only, ratios pre-computed ------
                 		// The model reads figures; it never computes them.
                 		lots = ifnull(pf.Lots,0).toDecimal();
                 		acres = ifnull(pf.Total_Acres,0).toDecimal();
                 		landCost = ifnull(pf.Land_Cost,0).toDecimal();
                 		grossSales = ifnull(pf.Gross_Sales,0).toDecimal();
                 		totalIncome = ifnull(pf.Total_Income,0).toDecimal();
                 		totalExpenses = ifnull(pf.Total_Expenses,0).toDecimal();
                 		netProfit = ifnull(pf.Net_Profit,0).toDecimal();
                 		summary = Map();
                 		summary.put("name",ifnull(pf.Name,"").toString());
                 		summary.put("pf_number",ifnull(pf.PF_Number,"").toString());
                 		summary.put("territory",ifnull(pf.Territory,"").toString());
                 		summary.put("probability",ifnull(pf.Probability,"").toString());
                 		summary.put("mud_pid",ifnull(pf.MUD_PID,"").toString());
                 		summary.put("lots",lots);
                 		summary.put("total_acres",acres);
                 		summary.put("lots_per_acre",if(acres > 0,(lots / acres).round(2),0));
                 		summary.put("phases",ifnull(pf.Phases,0));
                 		summary.put("lot_size_ft",ifnull(pf.Lot_Size_Ft,0));
                 		summary.put("land_cost",landCost);
                 		summary.put("land_cost_per_acre",ifnull(pf.Land_Cost_Acre,0));
                 		summary.put("land_cost_per_lot",if(lots > 0,(landCost / lots).round(0),0));
                 		summary.put("sale_price_per_front_foot",ifnull(pf.Sale_Price_FF,0));
                 		summary.put("engineering_cost_per_lot",ifnull(pf.Engineering_Cost_Lot,0));
                 		summary.put("construction_cost_base_per_front_foot",ifnull(pf.Const_Cost_FF,0));
                 		summary.put("gross_sales",grossSales);
                 		summary.put("total_income",totalIncome);
                 		summary.put("total_expenses",totalExpenses);
                 		summary.put("net_profit",netProfit);
                 		summary.put("net_margin_pct",if(totalIncome > 0,(netProfit / totalIncome * 100).round(1),0));
                 		summary.put("profit_per_lot",if(lots > 0,(netProfit / lots).round(0),0));
                 		summary.put("roi_pct",ifnull(pf.ROI1,0));
                 		summary.put("irr_pct",ifnull(pf.IRR,0));
                 		summary.put("xirr_pct",ifnull(pf.XIRR,0));
                 		lotMix = List();
                 		for each  mix in Lot_Mix_Row[Pro_Forma == pfId.toLong()]
                 		{
                 			mixRow = Map();
                 			mixRow.put("lot_size_ft",ifnull(mix.Lot_Size_Ft,0));
                 			mixRow.put("lot_count",ifnull(mix.Lot_Count,0));
                 			mixRow.put("price_per_lf",ifnull(mix.Price_LF,0));
                 			lotMix.add(mixRow);
                 		}
                 		summary.put("lot_mix",lotMix);
                 		// ---- 4. Prompt ---------------------------------------------------------
                 		systemMsg = "You are the founder's deal reviewer at a residential land development company. " + "Judge this pro forma STRICTLY against the FOUNDER CRITERIA below. " + "Every number you cite must appear in the DEAL SUMMARY; never invent, estimate, or recompute a figure. " + "If a criterion cannot be judged from the summary, say so under misses and ask for it under questions. " + "Verdict rules: Fail if any deal killer is hit; Watch if a must-have is unproven or marginal; Pass only when every stated threshold is met. " + "Score is 0-100 confidence that the founder would pursue this deal as presented. " + "Reply with ONE JSON object and nothing else, exactly this shape: " + "{\"verdict\":\"Pass|Watch|Fail\",\"score\":0,\"summary\":\"two or three plain sentences\"," + "\"meets\":[\"criterion met, with the number\"],\"misses\":[\"criterion missed or unjudgeable, with the number or 'not provided'\"]," + "\"questions\":[\"what the founder would ask before going further\"]}" + "\n\nFOUNDER CRITERIA:\n" + criteria;
                 		userMsg = "DEAL SUMMARY (JSON):\n" + summary.toString();
                 		sysMap = Map();
                 		sysMap.put("role","system");
                 		sysMap.put("content",systemMsg);
                 		usrMap = Map();
                 		usrMap.put("role","user");
                 		usrMap.put("content",userMsg);
                 		messages = List();
                 		messages.add(sysMap);
                 		messages.add(usrMap);
                 		fmt = Map();
                 		fmt.put("type","json_object");
                 		body = Map();
                 		body.put("model",model);
                 		body.put("messages",messages);
                 		body.put("response_format",fmt);
                 		// max_completion_tokens is accepted by every current chat model; max_tokens is rejected by the gpt-5 family.
                 		// Reasoning models spend part of this on thinking, so leave headroom. No temperature: reasoning models refuse it.
                 		body.put("max_completion_tokens",2000);
                 		if(dryRun)
                 		{
                 			resp.put("success",true);
                 			resp.put("dryRun",true);
                 			resp.put("model",model);
                 			resp.put("request",body);
                 			resp.put("summarySent",summary);
                 			return resp.toString();
                 		}
                 		// ---- 5. Call the model through the "openai" Connection (key never in code) ----
                 		hdrs = Map();
                 		hdrs.put("Content-Type","application/json");
                 		apiResp = invokeurl
                 		[
                 			url :"https://api.openai.com/v1/chat/completions"
                 			type :POST
                 			parameters:body.toString()
                 			headers:hdrs
                 			connection:"openai"
                 		];
                 		respMap = apiResp.toString().toMap();
                 		if(respMap.get("error") != null)
                 		{
                 			errObj = respMap.get("error").toString();
                 			errMsg = errObj;
                 			if(errObj.startsWith("{"))
                 			{
                 				errMsg = ifnull(errObj.toMap().get("message"),errObj).toString();
                 			}
                 			resp.put("success",false);
                 			resp.put("error","Model call failed: " + errMsg);
                 			resp.put("model",model);
                 			return resp.toString();
                 		}
                 		choices = respMap.get("choices");
                 		if(choices == null || choices.size() == 0)
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Model returned no choices.");
                 			resp.put("model",model);
                 			return resp.toString();
                 		}
                 		content = ifnull(choices.get(0).get("message").get("content"),"").toString().trim();
                 		content = content.replaceAll("```json","").replaceAll("```","").trim();
                 		if(!content.startsWith("{"))
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Model reply was not JSON: " + content.left(200));
                 			resp.put("model",model);
                 			return resp.toString();
                 		}
                 		// ---- 6. Parse + normalise ---------------------------------------------
                 		parsed = content.toMap();
                 		verdict = ifnull(parsed.get("verdict"),"Watch").toString().trim();
                 		if(verdict != "Pass" && verdict != "Watch" && verdict != "Fail")
                 		{
                 			verdict = "Watch";
                 		}
                 		scoreStr = ifnull(parsed.get("score"),"0").toString().trim();
                 		score = 0;
                 		if(scoreStr.isNumber())
                 		{
                 			score = scoreStr.toDecimal().round(0).toLong();
                 		}
                 		if(score < 0)
                 		{
                 			score = 0;
                 		}
                 		if(score > 100)
                 		{
                 			score = 100;
                 		}
                 		summaryTxt = ifnull(parsed.get("summary"),"").toString().trim();
                 		meetsList = ifnull(parsed.get("meets"),List());
                 		missesList = ifnull(parsed.get("misses"),List());
                 		questionsList = ifnull(parsed.get("questions"),List());
                 		meetsTxt = "";
                 		for each  item in meetsList
                 		{
                 			meetsTxt = meetsTxt + if(meetsTxt == "","","\n") + item.toString();
                 		}
                 		missesTxt = "";
                 		for each  item in missesList
                 		{
                 			missesTxt = missesTxt + if(missesTxt == "","","\n") + item.toString();
                 		}
                 		questionsTxt = "";
                 		for each  item in questionsList
                 		{
                 			questionsTxt = questionsTxt + if(questionsTxt == "","","\n") + item.toString();
                 		}
                 		result = Map();
                 		result.put("verdict",verdict);
                 		result.put("score",score);
                 		result.put("summary",summaryTxt);
                 		result.put("meets",meetsList);
                 		result.put("misses",missesList);
                 		result.put("questions",questionsList);
                 		// ---- 7. Keep every run as a Proforma_AI_Review row ---------------------------
                 		// Insert-with-fields is the one Deluge write path prod does not silently drop.
                 		// Deal_Snapshot stores the exact numbers the verdict was judged on.
                 		reviewId = insert into Proforma_AI_Review
                 		[
                 			Added_User=zoho.loginuser
                 			Pro_Forma=pfId.toLong()
                 			Verdict=verdict
                 			Score=score
                 			Summary=summaryTxt
                 			Meets=meetsTxt
                 			Misses=missesTxt
                 			Questions=questionsTxt
                 			Deal_Snapshot=summary.toString()
                 			Reviewed_On=zoho.currenttime
                 			Model=model
                 			Criteria_Version=criteriaVersion
                 			Reviewed_By=reviewedBy
                 		];
                 		// ---- 8. Stamp the Pro Forma's latest-review fields ------------------------
                 		// Fetch-assign edits can be silently dropped in prod, so the widget re-writes
                 		// these same values via the REST update after it gets this response.
                 		pf.AI_Review_Verdict=verdict;
                 		pf.AI_Review_Score=score;
                 		pf.AI_Review_Summary=summaryTxt;
                 		pf.AI_Reviewed_On=zoho.currenttime;
                 		pf.AI_Review_Criteria_Version=criteriaVersion;
                 		// ---- 9. Return ---------------------------------------------------------
                 		resp.put("success",true);
                 		resp.put("proformaId",pfId);
                 		resp.put("provider",provider);
                 		resp.put("model",model);
                 		resp.put("criteriaVersion",criteriaVersion);
                 		resp.put("reviewedOn",zoho.currenttime.toString("MM/dd/yyyy hh:mm:ss a"));
                 		resp.put("reviewedBy",reviewedBy);
                 		resp.put("reviewId",reviewId.toString());
                 		resp.put("result",result);
                 		resp.put("summarySent",summary);
                 		resp.put("usage",ifnull(respMap.get("usage"),Map()));
                 	}	catch (e)
                 	{
                 		resp.put("success",false);
                 		resp.put("error",e.toString());
                 	}
                 	return resp.toString();
                 }
				 string PF_Budget_Transfer(string payload)
                 {
                 	response = Map();
                 	response.put("success",false);
                 	wrote = false;
                 	completed = List();
                 	try 
                 	{
                 		data = payload.toMap();
                 		op = ifnull(data.get("op"),"").toString();
                 		if(op == "budget_transfer_capabilities")
                 		{
                 			response.put("success",true);
                 			response.put("action",op);
                 			response.put("budgetTransferVersion",if(data.get("budgetTransferClientVersion") == 3,3,if(data.get("budgetTransferClientVersion") == 2,2,1)));
                 			return response.toString();
                 		}
                 		if(op != "budget_transfer_preview" && op != "budget_transfer_apply")
                 		{
                 			response.put("error","Unknown Budget transfer operation.");
                 			return response.toString();
                 		}
                 		// Resolve the authenticated caller, never a client-supplied access ID.
                 		actor = User_Access[User == zoho.loginuser];
                 		if(actor.count() != 1 || actor.Send_Costs_to_Budgets != true)
                 		{
                 			response.put("error","Send Costs to Budgets access is required.");
                 			return response.toString();
                 		}
                 		if(actor.count() != 1 || (actor.Edit_All_Budgets != true && actor.Edit_Owned_Budgets != true))
                 		{
                 			response.put("error","Budget edit access is required.");
                 			return response.toString();
                 		}
                 		pfText = ifnull(data.get("id"),"").toString();
                 		projectText = ifnull(data.get("projectId"),"").toString();
                 		if(!pfText.isNumber() || !projectText.isNumber())
                 		{
                 			response.put("error","A saved Pro Forma and Project are required.");
                 			return response.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == pfText.toLong()];
                 		project = Project[ID == projectText.toLong()];
                 		if(pf.count() != 1 || project.count() != 1)
                 		{
                 			response.put("error","Pro Forma or Project was not found.");
                 			return response.toString();
                 		}
                 		ctx = Map();
                 		ctx.put("actor",actor.ID.toString());
                 		pm = Map();
                 		pm.put("Name",ifnull(pf.Name,""));
                 		pm.put("Phases",ifnull(pf.Phases,0));
                 		pm.put("Lots",ifnull(pf.Lots,0));
                 		pm.put("Total_Acres",ifnull(pf.Total_Acres,0));
                 		pm.put("Total_Street_LF",ifnull(pf.Total_Street_LF,0));
                 		pm.put("Lot_Size_Ft",ifnull(pf.Lot_Size_Ft,0));
                 		pm.put("Sale_Price_FF",ifnull(pf.Sale_Price_FF,0));
                 		pm.put("Land_Cost_Acre",ifnull(pf.Land_Cost_Acre,0));
                 		pm.put("Engineering_Cost_Lot",ifnull(pf.Engineering_Cost_Lot,0));
                 		pm.put("Const_Cost_FF",ifnull(pf.Const_Cost_FF,0));
                 		pm.put("ID",pf.ID.toString());
                 		pm.put("Modified_Time",pf.Modified_Time.toString());
                 		ctx.put("pf",pm);
                 		projectMap = Map();
                 		projectMap.put("ID",project.ID.toString());
                 		projectMap.put("Project_Name",project.Project_Name);
                 		projectMap.put("Proforma",ifnull(project.Proforma,"").toString());
                 		projectMap.put("Modified_Time",project.Modified_Time.toString());
                 		ctx.put("project",projectMap);
                 		phaseRows = List();
                 		for each  r in Proforma_Phase[Pro_Forma == pf.ID] sort by ID
                 		{
                 			m = Map();
                 			m.put("ID",r.ID.toString());
                 			m.put("Phase",ifnull(r.Phase,0));
                 			m.put("Total_Lots",ifnull(r.Total_Lots,0));
                 			phaseRows.add(m);
                 		}
                 		ctx.put("phases",phaseRows);
                 		itemRows = List();
                 		for each  sourceItem in Proforma_Item[Pro_Forma_Dev == pf.ID || Pro_Forma_Const == pf.ID] sort by ID
                 		{
                 			m = Map();
                 			m.put("Item_Name",ifnull(sourceItem.Item_Name,""));
                 			m.put("Category",ifnull(sourceItem.Category,""));
                 			m.put("Department",ifnull(sourceItem.Department,""));
                 			m.put("Cost_Code",ifnull(sourceItem.Cost_Code,0));
                 			m.put("Add_l_Cost",ifnull(sourceItem.Add_l_Cost,0));
                 			m.put("Unit",ifnull(sourceItem.Unit,""));
                 			m.put("Per_Unit",ifnull(sourceItem.Per_Unit,0));
                 			m.put("Cost_Application",ifnull(sourceItem.Cost_Application,""));
                 			m.put("Start_Phase",ifnull(sourceItem.Start_Phase,0));
                 			m.put("End_Phase",ifnull(sourceItem.End_Phase,0));
                 			m.put("Description",ifnull(sourceItem.Description,""));
                 			m.put("Template_Item",ifnull(sourceItem.Template_Item,false));
                 			m.put("ID",sourceItem.ID.toString());
                 			itemRows.add(m);
                 		}
                 		ctx.put("items",itemRows);
                 		subs = List();
                 		budgets = List();
                 		categories = List();
                 		items = List();
                 		approvals = List();
                 		modifications = List();
                 		for each  sub in Subdivision[Project == project.ID] sort by ID
                 		{
                 			m = Map();
                 			m.put("ID",sub.ID.toString());
                 			m.put("Subdivision_Name",sub.Subdivision_Name);
                 			m.put("Phase",ifnull(sub.Phase,0));
                 			subs.add(m);
                 			for each  b in Add_Budget[Subdivision1 == sub.ID && Archived != true] sort by ID
                 			{
                 				m = Map();
                 				m.put("Budget_Name",ifnull(b.Budget_Name,""));
                 				m.put("Archived",ifnull(b.Archived,false));
                 				m.put("Lock_Prelim_Budget",ifnull(b.Lock_Prelim_Budget,false));
                 				m.put("Lock_Final_Budget",ifnull(b.Lock_Final_Budget,false));
                 				m.put("Development_Budget_Approval_Status",ifnull(b.Development_Budget_Approval_Status,""));
                 				m.put("Const_Budget_Approval_Status",ifnull(b.Const_Budget_Approval_Status,""));
                 				m.put("Prelim_Budget_Grand_Total",ifnull(b.Prelim_Budget_Grand_Total,0));
                 				m.put("Unapproved_Final_Budget_Grand_Total",ifnull(b.Unapproved_Final_Budget_Grand_Total,0));
                 				m.put("Budget_Grand_Total",ifnull(b.Budget_Grand_Total,0));
                 				m.put("Const_Cost_to_Date",ifnull(b.Const_Cost_to_Date,0));
                 				m.put("Lot_Total_Residential",ifnull(b.Lot_Total_Residential,0));
                 				m.put("Acres",ifnull(b.Acres,0));
                 				m.put("Equiv_LF_of_Street",ifnull(b.Equiv_LF_of_Street,0));
                 				m.put("Lot_Price",ifnull(b.Lot_Price,0));
                 				m.put("Land_Cost",ifnull(b.Land_Cost,0));
                 				m.put("ID",b.ID.toString());
                 				m.put("Subdivision1",sub.ID.toString());
                 				m.put("Modified_Time",b.Modified_Time.toString());
                 				canEdit = actor.Edit_All_Budgets == true;
                 				if(!canEdit && actor.Edit_Owned_Budgets == true && b.Budget_Owner != null)
                 				{
                 					for each  owner in b.Budget_Owner
                 					{
                 						if(owner.ID == actor.ID)
                 						{
                 							canEdit = true;
                 						}
                 					}
                 				}
                 				if(!canEdit)
                 				{
                 					response.put("error","Budget edit access is required for every Project subdivision.");
                 					return response.toString();
                 				}
                 				m.put("_canEdit",canEdit);
                 				budgets.add(m);
                 				for each  c in Budget_Category[Budget == b.ID] sort by ID
                 				{
                 					m = Map();
                 					m.put("Budget_Category_Name",ifnull(c.Budget_Category_Name,""));
                 					m.put("Category_Code",ifnull(c.Category_Code,0));
                 					m.put("Deparment",ifnull(c.Deparment,""));
                 					m.put("Lock_Category",ifnull(c.Lock_Category,false));
                 					m.put("Template_Item",ifnull(c.Template_Item,false));
                 					m.put("Prelim_Budget_Total",ifnull(c.Prelim_Budget_Total,0));
                 					m.put("Unapproved_Final_Budget_Total",ifnull(c.Unapproved_Final_Budget_Total,0));
                 					m.put("Budget_Total",ifnull(c.Budget_Total,0));
                 					m.put("Actual_Total",ifnull(c.Actual_Total,0));
                 					m.put("Add_l_Cost_Total",ifnull(c.Add_l_Cost_Total,0));
                 					m.put("ID",c.ID.toString());
                 					m.put("Budget",b.ID.toString());
                 					m.put("Modified_Time",c.Modified_Time.toString());
                 					categories.add(m);
                 				}
                 				for each  i in Budget_Item[Budget == b.ID] sort by ID
                 				{
                 					m = Map();
                 					m.put("Item_Name",ifnull(i.Item_Name,""));
                 					m.put("Category",ifnull(i.Category,""));
                 					m.put("Department",ifnull(i.Department,""));
                 					m.put("Cost_Code",ifnull(i.Cost_Code,0));
                 					m.put("Description",ifnull(i.Description,""));
                 					m.put("Template_Item",ifnull(i.Template_Item,false));
                 					m.put("Unit",ifnull(i.Unit,""));
                 					m.put("Per_Unit",ifnull(i.Per_Unit,0));
                 					m.put("Prelim_Budget_Ttl",ifnull(i.Prelim_Budget_Ttl,0));
                 					m.put("Unapproved_Final_Budget_Ttl",ifnull(i.Unapproved_Final_Budget_Ttl,0));
                 					m.put("Budget_Ttl",ifnull(i.Budget_Ttl,0));
                 					m.put("Add_l_Cost",ifnull(i.Add_l_Cost,0));
                 					m.put("PROJ_Actual",ifnull(i.PROJ_Actual,0));
                 					m.put("HCSS_Actuals",ifnull(i.HCSS_Actuals,0));
                 					m.put("Cost_to_Complete",ifnull(i.Cost_to_Complete,0));
                 					m.put("ID",i.ID.toString());
                 					m.put("Budget",b.ID.toString());
                 					m.put("Budget_Category",ifnull(i.Budget_Category,"").toString());
                 					m.put("Modified_Time",i.Modified_Time.toString());
                 					items.add(m);
                 				}
                 				for each  a in Budget_Approvals[Budget == b.ID] sort by ID
                 				{
                 					m = Map();
                 					m.put("ID",a.ID.toString());
                 					m.put("Budget",b.ID.toString());
                 					m.put("Status",ifnull(a.Status,"Not Sent"));
                 					approvals.add(m);
                 				}
                 				for each  modificationRec in Budget_Modification[Budget == b.ID] sort by ID
                 				{
                 					m = Map();
                 					m.put("ID",modificationRec.ID.toString());
                 					m.put("Budget",b.ID.toString());
                 					m.put("Status",ifnull(modificationRec.Status,"Draft"));
                 					m.put("Amount",ifnull(modificationRec.Amount,0));
                 					modifications.add(m);
                 				}
                 			}
                 		}
                 		ctx.put("subdivisions",subs);
                 		ctx.put("budgets",budgets);
                 		ctx.put("categories",categories);
                 		ctx.put("budgetItems",items);
                 		ctx.put("approvals",approvals);
                 		ctx.put("modifications",modifications);
                 		mapping = ifnull(data.get("mapping"),Map());
                 		ctx.put("headerOverrides",ifnull(data.get("headerOverrides"),Map()));
                 		ctx.put("noteOverrides",ifnull(data.get("noteOverrides"),Map()));
                 		// Hash the complete source and destination snapshot BEFORE the planner adds derived amounts.
                 		signature = zoho.encryption.sha256(ctx.toString() + mapping.toString());
                 		response.put("context",ctx);
                 		plan = thisapp.PF_Budget_Transfer_Plan(ctx,mapping);
                 		response.put("action",op);
                 		response.put("plan",plan);
                 		response.put("token",signature);
                 		if(op == "budget_transfer_preview")
                 		{
                 			response.put("success",true);
                 			return response.toString();
                 		}
                 		if(plan.get("canSend") != true)
                 		{
                 			response.put("error","Budget transfer is blocked. Refresh the preview and resolve its errors.");
                 			return response.toString();
                 		}
                 		if(ifnull(data.get("token"),"").toString() != signature)
                 		{
                 			response.put("error","Source or target data changed. Refresh the preview before sending.");
                 			return response.toString();
                 		}
                 		// Destination metrics and notes are validated against the recomputed plan; amounts and item IDs come from saved records.
                 		for each  phase in plan.get("phases")
                 		{
                 			b = Add_Budget[ID == phase.get("budgetId").toLong()];
                 			h = phase.get("header");
                 			wrote = true;
                 			b.Lot_Total_Residential=h.get("Lot_Total_Residential").toLong();
                 			b.Acres=h.get("Acres");
                 			b.Equiv_LF_of_Street=h.get("Equiv_LF_of_Street");
                 			b.Lot_Price=h.get("Lot_Price");
                 			b.Land_Cost=h.get("Land_Cost");
                 			for each  w in phase.get("writes")
                 			{
                 				i = Budget_Item[ID == w.get("itemId").toLong() && Budget == b.ID];
                 				i.Unit=if(w.get("unit") == "",null,w.get("unit"));
                 				i.Per_Unit=if(w.get("unit") == "",null,w.get("rate"));
                 				// Budget quantities are the arbiter for per-unit costs.
                 				amount = w.get("amount");
                 				if(w.get("unit") != "")
                 				{
                 					qty = 0;
                 					if(w.get("unit") == "Lot")
                 					{
                 						qty = b.Lot_Total_Residential;
                 					}
                 					if(w.get("unit") == "Acre")
                 					{
                 						qty = b.Acres;
                 					}
                 					if(w.get("unit") == "LF")
                 					{
                 						qty = b.Equiv_LF_of_Street;
                 					}
                 					amount = qty * w.get("rate");
                 					amount = amount.round(2);
                 					if(w.get("amount") < 0)
                 					{
                 						amount = 0 - amount.abs();
                 					}
                 				}
                 				i.Prelim_Budget_Ttl=amount;
                 				i.Description=w.get("notes");
                 			}
                 			for each  c in Budget_Category[Budget == b.ID && Template_Item != true]
                 			{
                 				c.Lot_Total_Residential=b.Lot_Total_Residential;
                 				c.Acres=b.Acres;
                 				c.Equiv_LF_of_Street=b.Equiv_LF_of_Street;
                 				c.Prelim_Budget_Total=ifnull(Budget_Item[Budget_Category == c.ID && Template_Item != true].sum(Prelim_Budget_Ttl),0);
                 			}
                 			b.Prelim_Budget_Grand_Total=ifnull(Budget_Category[Budget == b.ID && Template_Item != true].sum(Prelim_Budget_Total),0);
                 			// Verify each persisted destination before reporting success.
                 			if(b.Lot_Total_Residential != h.get("Lot_Total_Residential") || b.Acres != h.get("Acres") || b.Equiv_LF_of_Street != h.get("Equiv_LF_of_Street") || b.Lot_Price != h.get("Lot_Price") || b.Land_Cost != h.get("Land_Cost") || b.Prelim_Budget_Grand_Total != phase.get("total"))
                 			{
                 				response.put("error","Budget quantities or totals did not verify. Inspect the affected Budgets before retrying.");
                 				response.put("partial",true);
                 				response.put("completed",completed);
                 				return response.toString();
                 			}
                 			for each  w in phase.get("writes")
                 			{
                 				i = Budget_Item[ID == w.get("itemId").toLong() && Budget == b.ID];
                 				if(i.Prelim_Budget_Ttl != w.get("amount") || ifnull(i.Unit,"") != w.get("unit") || ifnull(i.Per_Unit,0) != w.get("rate") || ifnull(i.Description,"") != w.get("notes"))
                 				{
                 					response.put("error","Budget Item values did not verify. Inspect the affected Budgets before retrying.");
                 					response.put("partial",true);
                 					response.put("completed",completed);
                 					return response.toString();
                 				}
                 			}
                 			completed.add(b.ID.toString());
                 		}
                 		project.Proforma=pf.ID;
                 		if(project.Proforma != pf.ID)
                 		{
                 			response.put("error","Budget costs were saved, but the Project Pro Forma association did not verify.");
                 			response.put("partial",true);
                 			response.put("completed",completed);
                 			return response.toString();
                 		}
                 		response.put("success",true);
                 		response.put("completed",completed);
                 		response.put("message","Costs sent to " + completed.size() + " Budgets.");
                 		return response.toString();
                 	}	catch (transferError)
                 	{
                 		response.put("success",false);
                 		response.put("error",transferError.toString());
                 		response.put("partial",wrote);
                 		response.put("completed",completed);
                 		return response.toString();
                 	}
                 	response.put("error","Budget transfer ended without a response.");
                 	return response.toString();
                 }
				 map PF_Budget_Transfer_Plan(map ctx, map mapping)
                 {
                 	plan = Map();
                 	errors = List();
                 	outliers = List();
                 	phases = List();
                 	pf = ctx.get("pf");
                 	count = ifnull(pf.get("Phases"),0).toLong();
                 	if(count < 1 || count > 100 || count != ifnull(pf.get("Phases"),0))
                 	{
                 		errors.add("PF must have between 1 and 100 phases.");
                 		count = 0;
                 	}
                 	if(count != ctx.get("subdivisions").size())
                 	{
                 		errors.add("PF phase count must match Project subdivision count.");
                 	}
                 	phaseLots = Map();
                 	totalLots = 0;
                 	for each  phaseRow in ctx.get("phases")
                 	{
                 		phaseKey = ifnull(phaseRow.get("Phase"),0).toDecimal();
                 		phaseMapKey = phaseKey.toString();
                 		if(phaseKey == phaseKey.floor())
                 		{
                 			phaseMapKey = phaseKey.toLong().toString();
                 		}
                 		lots = ifnull(phaseRow.get("Total_Lots"),0).toDecimal();
                 		if(phaseKey != phaseKey.floor() || phaseKey < 1 || phaseKey > count || phaseLots.get(phaseMapKey) != null || lots < 0 || lots != lots.floor())
                 		{
                 			errors.add("Invalid or duplicate saved Proforma Phase lot allocation.");
                 		}
                 		phaseLots.put(phaseMapKey,lots);
                 		totalLots = totalLots + lots;
                 	}
                 	if(phaseLots.size() != count || totalLots != ifnull(pf.get("Lots"),0))
                 	{
                 		errors.add("Saved Proforma Phase lot counts must match PF phases and total lots.");
                 	}
                 	applications = {"Across Phases","Engineering End","Construction Start","Construction End"};
                 	units = {"Lot","Acre","LF"};
                 	// Index destination items to keep matching within Creator execution limits.
                 	budgetItemsByBudget = Map();
                 	for each  indexedItem in ctx.get("budgetItems")
                 	{
                 		if(indexedItem.get("Template_Item") != true)
                 		{
                 			indexedBudget = ifnull(indexedItem.get("Budget"),"").toString();
                 			indexedRows = ifnull(budgetItemsByBudget.get(indexedBudget),List());
                 			indexedRows.add(indexedItem);
                 			budgetItemsByBudget.put(indexedBudget,indexedRows);
                 		}
                 	}
                 	seen = List();
                 	grandTotal = 0;
                 	headerOverrides = ifnull(ctx.get("headerOverrides"),Map());
                 	headerFields = {"Lot_Total_Residential","Acres","Equiv_LF_of_Street","Lot_Price","Land_Cost"};
                 	noteOverrides = ifnull(ctx.get("noteOverrides"),Map());
                 	for each  notePhase in noteOverrides.keys()
                 	{
                 		if(!notePhase.toString().isNumber())
                 		{
                 			errors.add("Unknown phase in Budget notes.");
                 		}
                 		else if(notePhase.toDecimal() < 1 || notePhase.toDecimal() > count || notePhase.toDecimal() != notePhase.toDecimal().floor() || notePhase.toString() != notePhase.toLong().toString())
                 		{
                 			errors.add("Unknown phase in Budget notes.");
                 		}
                 	}
                 	for each  editPhase in headerOverrides.keys()
                 	{
                 		if(!editPhase.toString().isNumber())
                 		{
                 			errors.add("Unknown phase in Budget edits.");
                 		}
                 		else if(editPhase.toDecimal() < 1 || editPhase.toDecimal() > count || editPhase.toDecimal() != editPhase.toDecimal().floor() || editPhase.toString() != editPhase.toLong().toString())
                 		{
                 			errors.add("Unknown phase in Budget edits.");
                 		}
                 	}
                 	if(count > 0)
                 	{
                 		p = 0;
                 		for each  ignoredPhase in thisapp.forLoop(1,count)
                 		{
                 			p = p + 1;
                 			sid = ifnull(mapping.get(p.toString()),"").toString();
                 			phase = Map();
                 			phase.put("phase",p);
                 			phase.put("subdivisionId",sid);
                 			phase.put("subdivision","Choose subdivision");
                 			phase.put("budgetId","");
                 			phase.put("budget","");
                 			lines = List();
                 			writes = List();
                 			phaseErrors = List();
                 			h = Map();
                 			h.put("Lot_Total_Residential",ifnull(phaseLots.get(p.toString()),0));
                 			acres = ifnull(pf.get("Total_Acres"),0) / count;
                 			h.put("Acres",acres.round(2));
                 			street = ifnull(pf.get("Total_Street_LF"),0) / count;
                 			h.put("Equiv_LF_of_Street",street.round(2));
                 			lotPrice = ifnull(pf.get("Lot_Size_Ft"),0) * ifnull(pf.get("Sale_Price_FF"),0);
                 			h.put("Lot_Price",lotPrice.round(2));
                 			h.put("Land_Cost",ifnull(pf.get("Land_Cost_Acre"),0));
                 			edits = ifnull(headerOverrides.get(p.toString()),Map());
                 			for each  field in edits.keys()
                 			{
                 				raw = ifnull(edits.get(field),"").toString().trim();
                 				if(!headerFields.contains(field))
                 				{
                 					phaseErrors.add("Unknown Budget metric.");
                 				}
                 				else if(!raw.isNumber())
                 				{
                 					phaseErrors.add(field + " must be a nonnegative number.");
                 				}
                 				else
                 				{
                 					value = raw.toDecimal();
                 					if(value < 0 || (field == "Lot_Total_Residential" && value != value.floor() || value > 9007199254740991) || (field != "Lot_Total_Residential" && value != value.round(2)))
                 					{
                 						phaseErrors.add(field + " must be nonnegative with valid precision.");
                 					}
                 					else
                 					{
                 						h.put(field,value);
                 					}
                 				}
                 			}
                 			phase.put("header",h);
                 			foundSub = false;
                 			for each  sub in ctx.get("subdivisions")
                 			{
                 				if(sub.get("ID") == sid)
                 				{
                 					foundSub = true;
                 					phase.put("subdivision",sub.get("Subdivision_Name"));
                 				}
                 			}
                 			if(!foundSub)
                 			{
                 				phaseErrors.add("Choose a Project subdivision.");
                 			}
                 			if(seen.contains(sid))
                 			{
                 				phaseErrors.add("Each subdivision must be used once.");
                 			}
                 			seen.add(sid);
                 			matches = List();
                 			for each  budget in ctx.get("budgets")
                 			{
                 				if(budget.get("Subdivision1") == sid && budget.get("Archived") != true)
                 				{
                 					matches.add(budget);
                 				}
                 			}
                 			phaseTotal = 0;
                 			if(foundSub && matches.size() == 1)
                 			{
                 				b = matches.get(0);
                 				bid = b.get("ID");
                 				phase.put("budgetId",bid);
                 				phase.put("budget",b.get("Budget_Name"));
                 				if(b.get("_canEdit") != true)
                 				{
                 					phaseErrors.add("Budget edit access is required.");
                 				}
                 				if(b.get("Lock_Prelim_Budget") == true || b.get("Lock_Final_Budget") == true || (ifnull(b.get("Development_Budget_Approval_Status"),"") != "" && b.get("Development_Budget_Approval_Status") != "Not Sent") || (ifnull(b.get("Const_Budget_Approval_Status"),"") != "" && b.get("Const_Budget_Approval_Status") != "Not Sent"))
                 				{
                 					phaseErrors.add("Budget is locked or has started approvals.");
                 				}
                 				for each  approval in ctx.get("approvals")
                 				{
                 					if(approval.get("Budget") == bid && ifnull(approval.get("Status"),"") != "" && approval.get("Status") != "Not Sent")
                 					{
                 						phaseErrors.add("Budget has started approvals.");
                 					}
                 				}
                 				for each  modification in ifnull(ctx.get("modifications"),List())
                 				{
                 					if(modification.get("Budget") == bid && ifnull(modification.get("Amount"),0) != 0 || (ifnull(modification.get("Status"),"") != "" && modification.get("Status") != "Draft"))
                 					{
                 						phaseErrors.add("Budget has existing modifications.");
                 					}
                 				}
                 				notEmpty = false;
                 				for each  field in {"Prelim_Budget_Grand_Total","Unapproved_Final_Budget_Grand_Total","Budget_Grand_Total","Const_Cost_to_Date"}
                 				{
                 					if(ifnull(b.get(field),0) != 0)
                 					{
                 						notEmpty = true;
                 					}
                 				}
                 				itemMatches = Map();
                 				cs = Map();
                 				for each  c in ctx.get("categories")
                 				{
                 					if(c.get("Budget") == bid && c.get("Template_Item") != true)
                 					{
                 						cs.put(c.get("ID"),c);
                 						if(c.get("Lock_Category") == true)
                 						{
                 							phaseErrors.add("Budget category is locked.");
                 						}
                 						for each  field in {"Prelim_Budget_Total","Unapproved_Final_Budget_Total","Budget_Total","Actual_Total","Add_l_Cost_Total"}
                 						{
                 							if(ifnull(c.get(field),0) != 0)
                 							{
                 								notEmpty = true;
                 							}
                 						}
                 					}
                 				}
                 				for each  i in ctx.get("budgetItems")
                 				{
                 					if(i.get("Budget") == bid && i.get("Template_Item") != true)
                 					{
                 						matchCode = ifnull(i.get("Cost_Code"),"").toString();
                 						matchRows = ifnull(itemMatches.get(matchCode),List());
                 						matchRows.add(i);
                 						itemMatches.put(matchCode,matchRows);
                 						if(ifnull(i.get("Prelim_Budget_Ttl"),0) != 0 || ifnull(i.get("Unapproved_Final_Budget_Ttl"),0) != 0 || ifnull(i.get("Budget_Ttl"),0) != 0 || ifnull(i.get("Add_l_Cost"),0) != 0 || ifnull(i.get("PROJ_Actual"),0) != 0 || ifnull(i.get("HCSS_Actuals"),0) != 0 || ifnull(i.get("Cost_to_Complete"),0) != 0 || ifnull(i.get("Per_Unit"),0) != 0 || ifnull(i.get("Unit"),"") != "")
                 						{
                 							notEmpty = true;
                 						}
                 					}
                 				}
                 				if(notEmpty)
                 				{
                 					phaseErrors.add("Only empty Budgets can receive costs.");
                 				}
                 				sources = List();
                 				for each  code in {2101,3100}
                 				{
                 					src = Map();
                 					src.put("base",true);
                 					src.put("Item_Name",if(code == 2101,"Entitlement & Eng","Construction Base"));
                 					src.put("Cost_Code",code);
                 					src.put("Department",if(code == 2101,"Engineering","Construction"));
                 					src.put("amount",if(code == 2101,ifnull(pf.get("Engineering_Cost_Lot"),0) * ifnull(pf.get("Lots"),0) / count,ifnull(pf.get("Const_Cost_FF"),0) * ifnull(pf.get("Total_Street_LF"),0) / count).round(2));
                 					sources.add(src);
                 				}
                 				for each  sourceRow in ctx.get("items")
                 				{
                 					src = sourceRow;
                 					cost = ifnull(src.get("Add_l_Cost"),0);
                 					unit = ifnull(src.get("Unit"),"").toString();
                 					rate = ifnull(src.get("Per_Unit"),0);
                 					if(src.get("Template_Item") != true && cost != 0 || rate != 0 || unit != "")
                 					{
                 						app = ifnull(src.get("Cost_Application"),"").toString();
                 						sp = ifnull(src.get("Start_Phase"),0);
                 						ep = ifnull(src.get("End_Phase"),0);
                 						if(ifnull(src.get("Category"),"").toString().trim().toLowerCase() == "reimbursements" && ifnull(src.get("Item_Name"),"").toString().trim().toLowerCase().startsWith("impact fees"))
                 						{
                 							app = "Across Phases";
                 							sp = 1;
                 							ep = count;
                 						}
                 						// Normalize saved Number fields and Impact Fees endpoints before floor comparisons.
                 						sp = sp.toDecimal();
                 						ep = ep.toDecimal();
                 						reason = "";
                 						scope = false;
                 						if(!applications.contains(app))
                 						{
                 							reason = if(app == "Specific Months","Specific Months has no unambiguous phase allocation.","Cost Application has no unambiguous phase allocation.");
                 							scope = p == 1;
                 						}
                 						else if(sp < 1 || ep < sp || ep > count || sp != sp.floor() || ep != ep.floor())
                 						{
                 							reason = "Phase range is missing or invalid.";
                 							scope = p == 1;
                 						}
                 						else if(p >= sp && p <= ep)
                 						{
                 							scope = true;
                 							if(unit != "" || rate != 0 && !units.contains(unit) || rate <= 0)
                 							{
                 								reason = "Per-unit pricing is incomplete.";
                 							}
                 							else
                 							{
                 								qty = 0;
                 								if(unit == "Lot")
                 								{
                 									qty = h.get("Lot_Total_Residential");
                 								}
                 								if(unit == "Acre")
                 								{
                 									qty = h.get("Acres");
                 								}
                 								if(unit == "LF")
                 								{
                 									qty = h.get("Equiv_LF_of_Street");
                 								}
                 								src.put("amount",if(unit == "",cost / (ep - sp + 1),rate * qty).round(2));
                 								sources.add(src);
                 							}
                 						}
                 						if(scope && reason != "")
                 						{
                 							o = Map();
                 							o.put("source",src.get("Item_Name"));
                 							o.put("code",src.get("Cost_Code"));
                 							o.put("amount",cost);
                 							o.put("notes",ifnull(src.get("Description"),""));
                 							o.put("reason",reason);
                 							o.put("phase",if(p == 1,null,p));
                 							outliers.add(o);
                 						}
                 					}
                 				}
                 				writeMap = Map();
                 				for each  src in sources
                 				{
                 					reason = "";
                 					found = List();
                 					for each  i in ifnull(itemMatches.get(ifnull(src.get("Cost_Code"),"").toString()),List())
                 					{
                 						if(i.get("Cost_Code") == src.get("Cost_Code") && i.get("Department") == src.get("Department"))
                 						{
                 							found.add(i);
                 						}
                 					}
                 					target = Map();
                 					if(found.size() != 1)
                 					{
                 						reason = if(found.size() > 1,"Multiple matching Budget Item lines.","Matching Budget Item/category is missing.");
                 					}
                 					else
                 					{
                 						target = found.get(0);
                 						if(cs.get(target.get("Budget_Category")) == null)
                 						{
                 							reason = "Matching Budget Item/category is missing.";
                 						}
                 					}
                 					unit = ifnull(src.get("Unit"),"").toString();
                 					rate = ifnull(src.get("Per_Unit"),0);
                 					prior = writeMap.get(target.get("ID"));
                 					if(reason == "" && prior != null && unit != "" || prior.get("unit") != "")
                 					{
                 						reason = "Per-unit and other costs share this Budget line.";
                 					}
                 					if(reason == "" && unit != "" && src.get("amount") <= 0)
                 					{
                 						reason = "Target Budget has no " + unit + " quantity.";
                 					}
                 					if(reason != "")
                 					{
                 						if(src.get("base") == true)
                 						{
                 							phaseErrors.add(src.get("Cost_Code") + " — " + reason);
                 						}
                 						else
                 						{
                 							o = Map();
                 							o.put("source",src.get("Item_Name"));
                 							o.put("code",src.get("Cost_Code"));
                 							o.put("amount",src.get("Add_l_Cost"));
                 							o.put("notes",ifnull(src.get("Description"),""));
                 							o.put("reason",reason);
                 							o.put("phase",p);
                 							outliers.add(o);
                 						}
                 					}
                 					else
                 					{
                 						amount = src.get("amount");
                 						if(src.get("Cost_Code").toString().startsWith("8") || ifnull(target.get("Category"),"").toString().toLowerCase().contains("reimbursement"))
                 						{
                 							amount = 0 - amount.abs();
                 						}
                 						notes = ifnull(src.get("Description"),"").toString();
                 						if(prior == null)
                 						{
                 							prior = Map();
                 							prior.put("itemId",target.get("ID"));
                 							prior.put("categoryId",target.get("Budget_Category"));
                 							prior.put("amount",0);
                 							prior.put("unit",unit);
                 							prior.put("rate",rate);
                 							prior.put("notes",ifnull(target.get("Description"),"").toString());
                 						}
                 						accumulated = prior.get("amount") + amount;
                 						prior.put("amount",accumulated.round(2));
                 						existingNotes = prior.get("notes");
                 						if(notes != "" && !existingNotes.contains(notes))
                 						{
                 							prior.put("notes",existingNotes + if(existingNotes == "","","\n\n") + notes);
                 						}
                 						writeMap.put(target.get("ID"),prior);
                 						line = Map();
                 						line.put("source",src.get("Item_Name"));
                 						line.put("code",src.get("Cost_Code"));
                 						line.put("target",target.get("Item_Name"));
                 						line.put("amount",amount);
                 						line.put("unit",unit);
                 						line.put("rate",rate);
                 						line.put("notes",notes);
                 						lines.add(line);
                 					}
                 				}
                 				for each  key in writeMap.keys()
                 				{
                 					w = writeMap.get(key);
                 					writes.add(w);
                 					phaseTotal = phaseTotal + w.get("amount");
                 				}
                 			}
                 			else if(foundSub)
                 			{
                 				phaseErrors.add(if(matches.size() > 1,"More than one active Budget exists for this subdivision.","An existing Budget is required."));
                 			}
                 			noteEdits = ifnull(noteOverrides.get(p.toString()),Map());
                 			for each  noteItem in noteEdits.keys()
                 			{
                 				matchedNote = false;
                 				for each  noteWrite in writes
                 				{
                 					if(noteWrite.get("itemId") == noteItem.toString())
                 					{
                 						matchedNote = true;
                 						noteWrite.put("notes",ifnull(noteEdits.get(noteItem),"").toString());
                 					}
                 				}
                 				if(!matchedNote)
                 				{
                 					phaseErrors.add("Budget note must belong to a transferred item in this phase.");
                 				}
                 			}
                 			phase.put("lines",lines);
                 			phase.put("writes",writes);
                 			phase.put("errors",phaseErrors);
                 			phase.put("total",phaseTotal.round(2));
                 			phases.add(phase);
                 			for each  error in phaseErrors
                 			{
                 				errors.add("Phase " + p + ": " + error);
                 			}
                 			grandTotal = grandTotal + phaseTotal;
                 		}
                 	}
                 	plan.put("phases",phases);
                 	plan.put("errors",errors);
                 	plan.put("outliers",outliers);
                 	plan.put("canSend",errors.size() == 0);
                 	plan.put("total",grandTotal.round(2));
                 	return plan;
                 }
				 map PF_Build_LOI_Document(string proformaId)
                 {
                 	result = Map();
                 	trace = List();
                 	stage = "start";
                 	try 
                 	{
                 		startEntry = Map();
                 		startEntry.put("level","info");
                 		startEntry.put("stage","start");
                 		startEntry.put("message","LOI document generation started");
                 		startEntry.put("meta",{"proformaId":proformaId,"loginUser":zoho.loginuser});
