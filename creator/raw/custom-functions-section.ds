                 			sellerNameById.put(sellerRec.ID.toString(),ifnull(sellerRec.Builder_Name,"Seller #" + sellerRec.ID).toString());
                 		}
                 		page = thisapp.PF_PDF_Rect(0,0,792,612,panel,"",0);
                 		page = page + thisapp.PF_PDF_Rect(0,556,792,56,navy,"",0);
                 		page = page + thisapp.PF_PDF_Text(28,582,17,"bold",white,"Sellers and Properties");
                 		page = page + thisapp.PF_PDF_Text(28,563,8,"regular","0.82 0.89 0.98",pfName + " | saved records at " + generatedLabel);
                 		page = page + thisapp.PF_PDF_Text(28,530,9,"bold",navy,"SELLERS");
                 		page = page + thisapp.PF_PDF_Rect(28,496,736,24,navy,"",0);
                 		page = page + thisapp.PF_PDF_Text(38,504,7,"bold",white,"SELLER");
                 		page = page + thisapp.PF_PDF_Text(310,504,7,"bold",white,"EMAIL");
                 		page = page + thisapp.PF_PDF_Text(580,504,7,"bold",white,"PHONE");
                 		y = 490;
                 		sellerIndex = 0;
                 		for each  sellerItem in sellers
                 		{
                 			sellerIndex = sellerIndex + 1;
                 			sellerRowFill = white;
                 			if(sellerIndex % 2 == 0)
                 			{
                 				sellerRowFill = "0.95 0.97 0.99";
                 			}
                 			page = page + thisapp.PF_PDF_Rect(28,y - 25,736,25,sellerRowFill,line,0.35);
                 			page = page + thisapp.PF_PDF_Text(38,y - 16,8,"bold",ink,ifnull(sellerItem.Builder_Name,"Seller").toString());
                 			page = page + thisapp.PF_PDF_Text(310,y - 16,8,"regular",ink,ifnull(sellerItem.Email,"Not provided").toString());
                 			page = page + thisapp.PF_PDF_Text(580,y - 16,8,"regular",ink,ifnull(sellerItem.Phone_Number,"Not provided").toString());
                 			y = y - 25;
                 		}
                 		if(sellerIndex == 0)
                 		{
                 			page = page + thisapp.PF_PDF_Rect(28,445,736,45,white,line,0.5);
                 			page = page + thisapp.PF_PDF_Text(40,463,9,"italic",muted,"No Sellers are linked to this Pro Forma.");
                 			y = 435;
                 		}
                 		page = page + thisapp.PF_PDF_Text(28,y - 22,9,"bold",navy,"PROPERTIES");
                 		y = y - 54;
                 		page = page + thisapp.PF_PDF_Rect(28,y,736,24,navy,"",0);
                 		page = page + thisapp.PF_PDF_Text(38,y + 8,7,"bold",white,"PROPERTY");
                 		page = page + thisapp.PF_PDF_Text(205,y + 8,7,"bold",white,"CAD / PROPERTY ID");
                 		page = page + thisapp.PF_PDF_Text(335,y + 8,7,"bold",white,"FACILITY ID");
                 		page = page + thisapp.PF_PDF_Text(430,y + 8,7,"bold",white,"COUNTY");
                 		page = page + thisapp.PF_PDF_Text(515,y + 8,7,"bold",white,"ACRES");
                 		page = page + thisapp.PF_PDF_Text(575,y + 8,7,"bold",white,"SELLER ASSIGNMENT");
                 		y = y - 6;
                 		propertyIndex = 0;
                 		for each  propertyItem in properties
                 		{
                 			propertyIndex = propertyIndex + 1;
                 			assignedSellerText = "Not provided";
                 			if(propertyItem.Seller != null)
                 			{
                 				sellerReferenceId = propertyItem.Seller.toString();
                 				sellerReferenceName = sellerNameById.get(sellerReferenceId);
                 				if(sellerReferenceName == null)
                 				{
                 					sellerReferenceName = "Seller #" + sellerReferenceId;
                 				}
                 				assignedSellerText = sellerReferenceName;
                 			}
                 			propertyText = ifnull(propertyItem.Common_Name,ifnull(propertyItem.Property_ID,"Property")).toString();
                 			propertyLines = thisapp.PF_PDF_Wrap(propertyText,25);
                 			sellerLines = thisapp.PF_PDF_Wrap(assignedSellerText,28);
                 			rowLines = propertyLines.size();
                 			if(sellerLines.size() > rowLines)
                 			{
                 				rowLines = sellerLines.size();
                 			}
                 			rowHeight = 12 + rowLines * 10;
                 			if(rowHeight < 25)
                 			{
                 				rowHeight = 25;
                 			}
                 			if(y - rowHeight < 48)
                 			{
                 				pageStreams.add(page);
                 				page = thisapp.PF_PDF_Rect(0,0,792,612,panel,"",0);
                 				page = page + thisapp.PF_PDF_Rect(0,556,792,56,navy,"",0);
                 				page = page + thisapp.PF_PDF_Text(28,582,17,"bold",white,"Properties - continued");
                 				page = page + thisapp.PF_PDF_Text(28,563,8,"regular","0.82 0.89 0.98",pfName);
                 				y = 520;
                 				page = page + thisapp.PF_PDF_Rect(28,y,736,24,navy,"",0);
                 				page = page + thisapp.PF_PDF_Text(38,y + 8,7,"bold",white,"PROPERTY");
                 				page = page + thisapp.PF_PDF_Text(205,y + 8,7,"bold",white,"CAD / PROPERTY ID");
                 				page = page + thisapp.PF_PDF_Text(335,y + 8,7,"bold",white,"FACILITY ID");
                 				page = page + thisapp.PF_PDF_Text(430,y + 8,7,"bold",white,"COUNTY");
                 				page = page + thisapp.PF_PDF_Text(515,y + 8,7,"bold",white,"ACRES");
                 				page = page + thisapp.PF_PDF_Text(575,y + 8,7,"bold",white,"SELLER ASSIGNMENT");
                 				y = y - 6;
                 			}
                 			rowFill = white;
                 			if(propertyIndex % 2 == 0)
                 			{
                 				rowFill = "0.95 0.97 0.99";
                 			}
                 			page = page + thisapp.PF_PDF_Rect(28,y - rowHeight,736,rowHeight,rowFill,line,0.35);
                 			lineY = y - 15;
                 			for each  propertyLine in propertyLines
                 			{
                 				page = page + thisapp.PF_PDF_Text(38,lineY,7,"regular",ink,propertyLine);
                 				lineY = lineY - 10;
                 			}
                 			page = page + thisapp.PF_PDF_Text(205,y - 15,7,"regular",ink,ifnull(propertyItem.Property_ID,"Not provided").toString());
                 			page = page + thisapp.PF_PDF_Text(335,y - 15,7,"regular",ink,ifnull(propertyItem.Facility_ID,"Not provided").toString());
                 			page = page + thisapp.PF_PDF_Text(430,y - 15,7,"regular",ink,ifnull(propertyItem.County,"Not provided").toString());
                 			page = page + thisapp.PF_PDF_Text(515,y - 15,7,"bold",ink,thisapp.PF_Packet_Number(ifnull(propertyItem.Acres,"").toString(),2));
                 			lineY = y - 15;
                 			for each  sellerLine in sellerLines
                 			{
                 				page = page + thisapp.PF_PDF_Text(575,lineY,7,"regular",ink,sellerLine);
                 				lineY = lineY - 10;
                 			}
                 			y = y - rowHeight;
                 		}
                 		if(propertyIndex == 0)
                 		{
                 			page = page + thisapp.PF_PDF_Rect(28,y - 50,736,45,white,line,0.5);
                 			page = page + thisapp.PF_PDF_Text(40,y - 32,9,"italic",muted,"No Properties are linked to this Pro Forma.");
                 		}
                 		pageStreams.add(page);
                 		/*
                 		 * Expected minimum:
                 		 * 1. Executive summary
                 		 * 2. Additional Costs
                 		 * 3. LOI page 1
                 		 * 4. LOI page 2
                 		 * 5. Sellers and Properties
                 		 */
                 		if(pageStreams.size() < 5)
                 		{
                 			result.put("success",false);
                 			result.put("message","Approval packet was incomplete before compilation. Expected the summary, Additional Costs, complete LOI terms, and Sellers/Properties sections.");
                 			return result;
                 		}
                 		pdfText = thisapp.PF_PDF_Compile(pageStreams,"Pro Forma Approval Packet - " + pfName);
                 		if(pdfText == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","The Deluge PDF compiler returned no content.");
                 			return result;
                 		}
                 		result.put("success",true);
                 		result.put("pdfText",pdfText);
                 		result.put("fileName","Proforma_Approval_Packet_" + proformaIdText + "_" + zoho.currenttime.toString("yyyyMMdd_HHmmss") + ".pdf");
                 		result.put("containsAdditionalCosts",true);
                 		result.put("containsLOITerms",true);
                 		result.put("pageCount",pageStreams.size());
                 		result.put("additionalCostCount",additionalItems.count());
                 		result.put("sellerCount",sellers.count());
                 		result.put("propertyCount",properties.count());
                 		return result;
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message",e.toString());
                 		return result;
                 	}
                 	return result;
                 }
				 map PF_Get_Proforma_LOI_Snapshot(string proformaId)
                 {
                 	result = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		if(proformaIdText == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","Pro Forma ID is required.");
                 			return result;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma could not be found.");
                 			return result;
                 		}
                 		/*
                 		 * Prefer the current worksheet. Fall back to any worksheet
                 		 * attached to this Pro Forma.
                 		 */
                 		loiRec = LOI_Worksheet[Proforma == proformaIdLong && Is_Current == true];
                 		if(loiRec.ID == null)
                 		{
                 			loiRec = LOI_Worksheet[Proforma == proformaIdLong];
                 		}
                 		/*
                 		 * PURCHASING COMPANY
                 		 */
                 		buyingEntityText = "—";
                 		if(loiRec.ID != null && loiRec.Company != null)
                 		{
                 			companyRec = Company[ID == loiRec.Company];
                 			if(companyRec.ID != null)
                 			{
                 				buyingEntityText = ifnull(companyRec.Company_Name,"—").toString();
                 			}
                 		}
                 		else if(pf.Purchasing_Company != null)
                 		{
                 			companyRec = Company[ID == pf.Purchasing_Company];
                 			if(companyRec.ID != null)
                 			{
                 				buyingEntityText = ifnull(companyRec.Company_Name,"—").toString();
                 			}
                 		}
                 		/*
                 		 * SELLERS
                 		 *
                 		 * Sellers created in the LOI tab are Builder records with
                 		 * Type1 = Seller and Proforma containing this Pro Forma.
                 		 */
                 		sellerText = "";
                 		for each  sellerRec in Builder[Proforma == proformaIdLong] sort by Builder_Name
                 		{
                 			sellerName = ifnull(sellerRec.Builder_Name,"").toString().trim();
                 			if(sellerName != "")
                 			{
                 				if(sellerText != "")
                 				{
                 					sellerText = sellerText + ", ";
                 				}
                 				sellerText = sellerText + sellerName;
                 			}
                 		}
                 		/*
                 		 * Fall back to the old Pro Forma header field for legacy
                 		 * records that do not have linked Builder records.
                 		 */
                 		if(sellerText == "" && pf.Seller != null)
                 		{
                 			sellerText = pf.Seller.toString().trim();
                 		}
                 		if(sellerText == "")
                 		{
                 			sellerText = "—";
                 		}
                 		/*
                 		 * PROPERTIES
                 		 */
                 		propertyText = "";
                 		propertyAcresTotal = 0;
                 		propertyCount = 0;
                 		for each  propertyRec in Property[Proforma == proformaIdLong] sort by Common_Name
                 		{
                 			propertyCount = propertyCount + 1;
                 			propertyName = ifnull(propertyRec.Common_Name,"").toString().trim();
                 			if(propertyName == "")
                 			{
                 				propertyName = ifnull(propertyRec.Property_ID,"").toString().trim();
                 			}
                 			if(propertyName == "")
                 			{
                 				propertyName = "Property " + propertyCount.toString();
                 			}
                 			propertyLine = propertyName;
                 			if(propertyRec.County != null && propertyRec.County.toString().trim() != "")
                 			{
                 				propertyLine = propertyLine + " — " + propertyRec.County.toString() + " County";
                 			}
                 			if(propertyRec.Acres != null && propertyRec.Acres.toString().trim() != "")
                 			{
                 				propertyAcresTotal = propertyAcresTotal + propertyRec.Acres.toDecimal();
                 			}
                 			if(propertyText != "")
                 			{
                 				propertyText = propertyText + "; ";
                 			}
                 			propertyText = propertyText + propertyLine;
                 		}
                 		/*
                 		 * Legacy fallback to Pro Forma address fields.
                 		 */
                 		if(propertyText == "")
                 		{
                 			if(pf.Street_Address != null && pf.Street_Address.toString().trim() != "")
                 			{
                 				propertyText = pf.Street_Address.toString();
                 			}
                 			if(pf.Property_City != null && pf.Property_City.toString().trim() != "")
                 			{
                 				if(propertyText != "")
                 				{
                 					propertyText = propertyText + ", ";
                 				}
                 				propertyText = propertyText + pf.Property_City.toString();
                 			}
                 			if(pf.Property_County != null && pf.Property_County.toString().trim() != "")
                 			{
                 				if(propertyText != "")
                 				{
                 					propertyText = propertyText + ", ";
                 				}
                 				propertyText = propertyText + pf.Property_County.toString() + " County";
                 			}
                 		}
                 		if(propertyText == "")
                 		{
                 			propertyText = "—";
                 		}
                 		/*
                 		 * WORKSHEET ECONOMICS
                 		 */
                 		totalAcresRaw = "";
                 		if(loiRec.ID != null && loiRec.Total_Acres != null && loiRec.Total_Acres.toString().trim() != "")
                 		{
                 			totalAcresRaw = loiRec.Total_Acres.toString();
                 		}
                 		else if(pf.Total_Acres != null && pf.Total_Acres.toString().trim() != "")
                 		{
                 			totalAcresRaw = pf.Total_Acres.toString();
                 		}
                 		else if(propertyAcresTotal > 0)
                 		{
                 			totalAcresRaw = propertyAcresTotal.toString();
                 		}
                 		totalAcresText = "—";
                 		if(totalAcresRaw != "")
                 		{
                 			totalAcresText = thisapp.PF_Packet_Number(totalAcresRaw,2);
                 		}
                 		amountPerAcreRaw = "";
                 		if(loiRec.ID != null && loiRec.Amount_Per_Acre != null && loiRec.Amount_Per_Acre.toString().trim() != "")
                 		{
                 			amountPerAcreRaw = loiRec.Amount_Per_Acre.toString();
                 		}
                 		else if(pf.Land_Cost_Acre != null && pf.Land_Cost_Acre.toString().trim() != "")
                 		{
                 			amountPerAcreRaw = pf.Land_Cost_Acre.toString();
                 		}
                 		amountPerAcreText = "—";
                 		if(amountPerAcreRaw != "")
                 		{
                 			amountPerAcreText = thisapp.PF_Packet_Money(amountPerAcreRaw);
                 		}
                 		estimatedPriceRaw = "";
                 		if(loiRec.ID != null && loiRec.Estimated_Price != null && loiRec.Estimated_Price.toString().trim() != "")
                 		{
                 			estimatedPriceRaw = loiRec.Estimated_Price.toString();
                 		}
                 		else if(totalAcresRaw != "" && amountPerAcreRaw != "")
                 		{
                 			estimatedPriceRaw = (totalAcresRaw.toDecimal() * amountPerAcreRaw.toDecimal()).toString();
                 		}
                 		else if(pf.Land_Cost != null && pf.Land_Cost.toString().trim() != "")
                 		{
                 			estimatedPriceRaw = pf.Land_Cost.toString();
                 		}
                 		estimatedPriceText = "—";
                 		if(estimatedPriceRaw != "")
                 		{
                 			estimatedPriceText = thisapp.PF_Packet_Money(estimatedPriceRaw);
                 		}
                 		earnestMoneyRaw = "";
                 		if(loiRec.ID != null && loiRec.Earnest_Money != null && loiRec.Earnest_Money.toString().trim() != "")
                 		{
                 			earnestMoneyRaw = loiRec.Earnest_Money.toString();
                 		}
                 		else if(pf.Earnest_Money != null && pf.Earnest_Money.toString().trim() != "")
                 		{
                 			earnestMoneyRaw = pf.Earnest_Money.toString();
                 		}
                 		earnestMoneyText = "—";
                 		if(earnestMoneyRaw != "")
                 		{
                 			earnestMoneyText = thisapp.PF_Packet_Money(earnestMoneyRaw);
                 		}
                 		/*
                 		 * TIMING
                 		 */
                 		feasibilityDaysRaw = "";
                 		if(loiRec.ID != null && loiRec.Initial_Feasibility_Days != null && loiRec.Initial_Feasibility_Days.toString().trim() != "")
                 		{
                 			feasibilityDaysRaw = loiRec.Initial_Feasibility_Days.toString();
                 		}
                 		else if(pf.Initial_Feasibility_Days != null && pf.Initial_Feasibility_Days.toString().trim() != "")
                 		{
                 			feasibilityDaysRaw = pf.Initial_Feasibility_Days.toString();
                 		}
                 		feasibilityText = "—";
                 		if(feasibilityDaysRaw != "")
                 		{
                 			feasibilityText = thisapp.PF_Packet_Number(feasibilityDaysRaw,0) + " days";
                 		}
                 		closingDaysRaw = "";
                 		if(loiRec.ID != null && loiRec.Closing_Days_After_Feasibility != null && loiRec.Closing_Days_After_Feasibility.toString().trim() != "")
                 		{
                 			closingDaysRaw = loiRec.Closing_Days_After_Feasibility.toString();
                 		}
                 		else if(pf.Closing_Days_Feas != null && pf.Closing_Days_Feas.toString().trim() != "")
                 		{
                 			closingDaysRaw = pf.Closing_Days_Feas.toString();
                 		}
                 		closingText = "—";
                 		if(closingDaysRaw != "")
                 		{
                 			closingText = thisapp.PF_Packet_Number(closingDaysRaw,0) + " days";
                 		}
                 		extensionsRaw = "";
                 		daysPerExtensionRaw = "";
                 		amountPerExtensionRaw = "";
                 		if(loiRec.ID != null && loiRec.Extensions != null && loiRec.Extensions.toString().trim() != "")
                 		{
                 			extensionsRaw = loiRec.Extensions.toString();
                 		}
                 		else if(pf.Extensions != null && pf.Extensions.toString().trim() != "")
                 		{
                 			extensionsRaw = pf.Extensions.toString();
                 		}
                 		if(loiRec.ID != null && loiRec.Days_Per_Extension != null && loiRec.Days_Per_Extension.toString().trim() != "")
                 		{
                 			daysPerExtensionRaw = loiRec.Days_Per_Extension.toString();
                 		}
                 		else if(pf.Days_per_Extension != null && pf.Days_per_Extension.toString().trim() != "")
                 		{
                 			daysPerExtensionRaw = pf.Days_per_Extension.toString();
                 		}
                 		if(loiRec.ID != null && loiRec.Amount_Per_Extension != null && loiRec.Amount_Per_Extension.toString().trim() != "")
                 		{
                 			amountPerExtensionRaw = loiRec.Amount_Per_Extension.toString();
                 		}
                 		else if(pf.Amount_per_Extension != null && pf.Amount_per_Extension.toString().trim() != "")
                 		{
                 			amountPerExtensionRaw = pf.Amount_per_Extension.toString();
                 		}
                 		extensionsText = "—";
                 		if(extensionsRaw != "" || daysPerExtensionRaw != "" || amountPerExtensionRaw != "")
                 		{
                 			extensionsText = "";
                 			if(extensionsRaw != "")
                 			{
                 				extensionsText = thisapp.PF_Packet_Number(extensionsRaw,0) + " extensions";
                 			}
                 			if(daysPerExtensionRaw != "")
                 			{
                 				if(extensionsText != "")
                 				{
                 					extensionsText = extensionsText + " × ";
                 				}
                 				extensionsText = extensionsText + thisapp.PF_Packet_Number(daysPerExtensionRaw,0) + " days";
                 			}
                 			if(amountPerExtensionRaw != "")
                 			{
                 				if(extensionsText != "")
                 				{
                 					extensionsText = extensionsText + " at ";
                 				}
                 				extensionsText = extensionsText + thisapp.PF_Packet_Money(amountPerExtensionRaw) + " each";
                 			}
                 		}
                 		/*
                 		 * DATES AND CONTACTS
                 		 */
                 		responseDateText = "—";
                 		if(loiRec.ID != null && loiRec.Response_Date != null)
                 		{
                 			responseDateText = loiRec.Response_Date.toString("MMM d, yyyy");
                 		}
                 		else if(pf.Response_Date != null)
                 		{
                 			responseDateText = pf.Response_Date.toString("MMM d, yyyy");
                 		}
                 		effectiveDateText = "—";
                 		if(loiRec.ID != null && loiRec.Assumed_Effective_Date != null)
                 		{
                 			effectiveDateText = loiRec.Assumed_Effective_Date.toString("MMM d, yyyy");
                 		}
                 		buyerBrokerText = "—";
                 		if(loiRec.ID != null && loiRec.Buyer_Broker != null && loiRec.Buyer_Broker.toString().trim() != "")
                 		{
                 			buyerBrokerText = loiRec.Buyer_Broker.toString();
                 		}
                 		else if(pf.Broker_Buyer != null && pf.Broker_Buyer.toString().trim() != "")
                 		{
                 			buyerBrokerText = pf.Broker_Buyer.toString();
                 		}
                 		sellerBrokerText = "—";
                 		if(loiRec.ID != null && loiRec.Seller_Broker != null && loiRec.Seller_Broker.toString().trim() != "")
                 		{
                 			sellerBrokerText = loiRec.Seller_Broker.toString();
                 		}
                 		else if(pf.Broker_Seller != null && pf.Broker_Seller.toString().trim() != "")
                 		{
                 			sellerBrokerText = pf.Broker_Seller.toString();
                 		}
                 		acquisitionEmailText = "—";
                 		if(loiRec.ID != null && loiRec.Acquisition_Email != null && loiRec.Acquisition_Email.toString().trim() != "")
                 		{
                 			acquisitionEmailText = loiRec.Acquisition_Email.toString();
                 		}
                 		else if(pf.Acquisition_Email != null && pf.Acquisition_Email.toString().trim() != "")
                 		{
                 			acquisitionEmailText = pf.Acquisition_Email.toString();
                 		}
                 		specialProvisionsText = "";
                 		if(loiRec.ID != null && loiRec.Special_Provisions != null && loiRec.Special_Provisions.toString().trim() != "")
                 		{
                 			specialProvisionsText = loiRec.Special_Provisions.toString();
                 		}
                 		else if(pf.Special_Provisions != null && pf.Special_Provisions.toString().trim() != "")
                 		{
                 			specialProvisionsText = pf.Special_Provisions.toString();
                 		}
                 		result.put("success",true);
                 		result.put("worksheetId",if(loiRec.ID == null,"",loiRec.ID.toString()));
                 		result.put("seller",sellerText);
                 		result.put("buyingEntity",buyingEntityText);
                 		result.put("property",propertyText);
                 		result.put("totalAcres",totalAcresText);
                 		result.put("amountPerAcre",amountPerAcreText);
                 		result.put("estimatedPrice",estimatedPriceText);
                 		result.put("earnestMoney",earnestMoneyText);
                 		result.put("feasibility",feasibilityText);
                 		result.put("closing",closingText);
                 		result.put("extensions",extensionsText);
                 		result.put("responseDate",responseDateText);
                 		result.put("effectiveDate",effectiveDateText);
                 		result.put("buyerBroker",buyerBrokerText);
                 		result.put("sellerBroker",sellerBrokerText);
                 		result.put("acquisitionEmail",acquisitionEmailText);
                 		result.put("specialProvisions",specialProvisionsText);
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message",e.toString());
                 	}
                 	return result;
                 }
				 string PF_Packet_Escape(string value)
                 {
                 	textValue = ifnull(value,"").toString();
                 	textValue = textValue.replaceAll("&","&amp;");
                 	textValue = textValue.replaceAll("<","&lt;");
                 	textValue = textValue.replaceAll(">","&gt;");
                 	textValue = textValue.replaceAll("\"","&quot;");
                 	textValue = textValue.replaceAll("'","&#39;");
                 	return textValue;
                 }
				 string PF_Packet_Money(string value)
                 {
                 	clean = ifnull(value,"").toString();
                 	clean = clean.trim();
                 	if(clean == "")
                 	{
                 		return "-";
                 	}
                 	clean = clean.replaceAll("\\$","");
                 	clean = clean.replaceAll(",","");
                 	numberValue = clean.toDecimal();
                 	if(numberValue < 0)
                 	{
                 		return "($" + (numberValue * -1).round(0).toText("#,##0") + ")";
                 	}
                 	return "$" + numberValue.round(0).toText("#,##0");
                 }
				 string PF_Packet_Number(string value, int decimals)
                 {
                 	clean = ifnull(value,"").toString();
                 	clean = clean.trim();
                 	if(clean == "")
                 	{
                 		return "-";
                 	}
                 	clean = clean.replaceAll(",","");
                 	numberValue = clean.toDecimal();
                 	if(decimals == 2)
                 	{
                 		return numberValue.round(2).toText("#,##0.00");
                 	}
                 	if(decimals == 1)
                 	{
                 		return numberValue.round(1).toText("#,##0.0");
                 	}
                 	return numberValue.round(0).toText("#,##0");
                 }
				 string PF_PDF_Clean(string value)
                 {
                 	textValue = ifnull(value,"").toString();
                 	textValue = textValue.replaceAll("\r\n"," ");
                 	textValue = textValue.replaceAll("\n"," ");
                 	textValue = textValue.replaceAll("\r"," ");
                 	textValue = textValue.replaceAll("–","-");
                 	textValue = textValue.replaceAll("—","-");
                 	textValue = textValue.replaceAll("’","'");
                 	textValue = textValue.replaceAll("‘","'");
                 	textValue = textValue.replaceAll("“","\"");
                 	textValue = textValue.replaceAll("”","\"");
                 	textValue = textValue.replaceAll("•","-");
                 	textValue = textValue.replaceAll("[^ -~]","?");
                 	textValue = textValue.replaceAll("[ ]+"," ");
                 	return textValue.trim();
                 }
				 string PF_PDF_Compile(list pageStreams, string documentTitle)
                 {
                 	pageCount = pageStreams.size();
                 	if(pageCount == 0)
                 	{
                 		return "";
                 	}
                 	fontRegularObject = 3 + pageCount * 2;
                 	fontBoldObject = fontRegularObject + 1;
                 	fontItalicObject = fontRegularObject + 2;
                 	infoObject = fontRegularObject + 3;
                 	objects = List();
                 	objects.add("<< /Type /Catalog /Pages 2 0 R >>");
                 	kids = "";
                 	pageCounter = 0;
                 	for each  ignoredPageStream in pageStreams
                 	{
                 		pageObjectNumber = 3 + pageCounter * 2;
                 		kids = kids + pageObjectNumber + " 0 R ";
                 		pageCounter = pageCounter + 1;
                 	}
                 	objects.add("<< /Type /Pages /Kids [" + kids + "] /Count " + pageCount + " >>");
                 	pageCounter = 0;
                 	for each  baseStreamContent in pageStreams
                 	{
                 		pageObjectNumber = 3 + pageCounter * 2;
                 		contentObjectNumber = pageObjectNumber + 1;
                 		pageNumber = pageCounter + 1;
                 		streamContent = baseStreamContent;
                 		streamContent = streamContent + thisapp.PF_PDF_Line(28,32,764,32,"0.82 0.86 0.91",0.5);
                 		streamContent = streamContent + thisapp.PF_PDF_Text(28,18,7,"regular","0.36 0.43 0.52","CONFIDENTIAL - Pro Forma Approval Packet");
                 		streamContent = streamContent + thisapp.PF_PDF_Text(680,18,7,"regular","0.36 0.43 0.52","Page " + pageNumber + " of " + pageCount);
                 		pageObject = "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 792 612] /Resources << /ProcSet [/PDF /Text] /Font << /F1 " + fontRegularObject + " 0 R /F2 " + fontBoldObject + " 0 R /F3 " + fontItalicObject + " 0 R >> >> /Contents " + contentObjectNumber + " 0 R >>";
                 		contentObject = "<< /Length " + streamContent.length() + " >>\nstream\n" + streamContent + "endstream";
                 		objects.add(pageObject);
                 		objects.add(contentObject);
                 		pageCounter = pageCounter + 1;
                 	}
                 	objects.add("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>");
                 	objects.add("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>");
                 	objects.add("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Oblique /Encoding /WinAnsiEncoding >>");
                 	titleHex = thisapp.PF_PDF_Clean(documentTitle).textToHex();
                 	objects.add("<< /Title <" + titleHex + "> /Producer <5a6f686f2043726561746f722044656c756765> >>");
                 	pdfText = "%PDF-1.4\n";
                 	offsets = List();
                 	objectCounter = 0;
                 	for each  objectText in objects
                 	{
                 		objectNumber = objectCounter + 1;
                 		offsets.add(pdfText.length());
                 		pdfText = pdfText + objectNumber + " 0 obj\n" + objectText + "\nendobj\n";
                 		objectCounter = objectCounter + 1;
                 	}
                 	xrefOffset = pdfText.length();
                 	pdfText = pdfText + "xref\n0 " + (objects.size() + 1) + "\n0000000000 65535 f \n";
                 	for each  objectOffset in offsets
                 	{
                 		paddedOffset = ("0000000000" + objectOffset.toString()).right(10);
                 		pdfText = pdfText + paddedOffset + " 00000 n \n";
                 	}
                 	pdfText = pdfText + "trailer\n<< /Size " + (objects.size() + 1) + " /Root 1 0 R /Info " + infoObject + " 0 R >>\nstartxref\n" + xrefOffset + "\n%%EOF";
                 	return pdfText;
                 }
				 string PF_PDF_Line(decimal x1, decimal y1, decimal x2, decimal y2, string color, decimal lineWidth)
                 {
                 	return "q\n" + color + " RG\n" + lineWidth + " w\n" + x1 + " " + y1 + " m " + x2 + " " + y2 + " l S\nQ\n";
                 }
				 string PF_PDF_Rect(decimal x, decimal y, decimal width, decimal height, string fillColor, string strokeColor, decimal lineWidth)
                 {
                 	command = "q\n";
                 	if(fillColor != "")
                 	{
                 		command = command + fillColor + " rg\n";
                 	}
                 	if(strokeColor != "")
                 	{
                 		command = command + strokeColor + " RG\n" + lineWidth + " w\n";
                 	}
                 	command = command + x + " " + y + " " + width + " " + height + " re ";
                 	if(fillColor != "" && strokeColor != "")
                 	{
                 		command = command + "B\n";
                 	}
                 	else if(fillColor != "")
                 	{
                 		command = command + "f\n";
                 	}
                 	else
                 	{
                 		command = command + "S\n";
                 	}
                 	command = command + "Q\n";
                 	return command;
                 }
				 string PF_PDF_Text(decimal x, decimal y, decimal size, string fontKey, string color, string value)
                 {
                 	clean = thisapp.PF_PDF_Clean(value);
                 	if(clean == "")
                 	{
                 		return "";
                 	}
                 	fontName = "F1";
                 	if(fontKey == "bold")
                 	{
                 		fontName = "F2";
                 	}
                 	if(fontKey == "italic")
                 	{
                 		fontName = "F3";
                 	}
                 	hexValue = clean.textToHex();
                 	return color + " rg\nBT /" + fontName + " " + size + " Tf 1 0 0 1 " + x + " " + y + " Tm <" + hexValue + "> Tj ET\n";
                 }
				 list PF_PDF_Wrap(string value, int maxChars)
                 {
                 	lines = List();
                 	clean = thisapp.PF_PDF_Clean(value);
                 	if(clean == "")
                 	{
                 		lines.add("Not provided");
                 		return lines;
                 	}
                 	words = clean.toList(" ");
                 	current = "";
                 	for each  word in words
                 	{
                 		if(word.length() > maxChars)
                 		{
                 			word = word.left(maxChars - 3) + "...";
                 		}
                 		candidate = word;
                 		if(current != "")
                 		{
                 			candidate = current + " " + word;
                 		}
                 		if(candidate.length() <= maxChars)
                 		{
                 			current = candidate;
                 		}
                 		else
                 		{
                 			if(current != "")
                 			{
                 				lines.add(current);
                 			}
                 			current = word;
                 		}
                 	}
                 	if(current != "")
                 	{
                 		lines.add(current);
                 	}
                 	if(lines.size() == 0)
                 	{
                 		lines.add("Not provided");
                 	}
                 	return lines;
                 }
				 string proforma_save(string payload)
                 {
                 	resp = Map();
                 	try 
                 	{
                 		data = payload.toMap();
                 		if(data.get("header") == null && data.get("payload") != null)
                 		{
                 			data = data.get("payload").toString().toMap();
                 		}
                 		pfId = ifnull(data.get("id"),"").toString().trim();
                 		isNew = false;
                 		header = Map();
                 		deleteStage = "";
                 		op = ifnull(data.get("op"),"").toString().trim();
                 		if(op == "quick_create_company")
                 		{
                 			comp = data.get("company");
                 			cName = ifnull(comp.get("Company_Name"),"").toString().trim();
                 			if(cName == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Company Name is required.");
                 				return resp.toString();
                 			}
                 			newComp = insert into Company
                 			[
                 				Company_Name=cName
                 				Added_User=zoho.loginuser
                 			];
                 			compRec = Company[ID == newComp];
                 			facil = ifnull(comp.get("Facility_ID"),"").toString().trim();
                 			if(facil != "")
                 			{
                 				compRec.Facility_ID=facil.toLong();
                 			}
                 			acct = ifnull(comp.get("Account_Number"),"").toString().trim();
                 			if(acct != "")
                 			{
                 				compRec.Account_Number=acct.toLong();
                 			}
                 			if(pfId != "")
                 			{
                 				cIds = List();
                 				cFound = false;
                 				for each  cx in compRec.Proforma
                 				{
                 					cIds.add(cx);
                 					if(cx.toString() == pfId)
                 					{
                 						cFound = true;
                 					}
                 				}
                 				if(!cFound)
                 				{
                 					cIds.add(pfId.toLong());
                 					compRec.Proforma=cIds;
                 				}
                 			}
                 			resp.put("success",true);
                 			resp.put("companyId",newComp.toString());
                 			resp.put("action","company_created");
                 			return resp.toString();
                 		}
                 		if(op == "update_lock" || op == "update_owners")
                 		{
                 			if(pfId == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro Forma id is required.");
                 				return resp.toString();
                 			}
                 			quickAccessId = ifnull(data.get("userAccessId"),"").toString().trim();
                 			if(quickAccessId == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","A valid User Access record is required.");
                 				return resp.toString();
                 			}
                 			quickAccess = User_Access[ID == quickAccessId.toLong()];
                 			if(quickAccess == null)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","The User Access record was not found.");
                 				return resp.toString();
                 			}
                 			pfKey = pfId.toLong();
                 			quickPf = Add_Pro_Forma[ID == pfKey];
                 			if(quickPf == null)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro Forma " + pfId + " was not found.");
                 				return resp.toString();
                 			}
                 			if(op == "update_lock")
                 			{
                 				canQuickEdit = quickAccess.Edit_All_Proformas == true;
                 				if(!canQuickEdit && quickAccess.Edit_Owned_Proformas == true)
                 				{
                 					for each  quickOwner in quickPf.Owner
                 					{
                 						if(quickOwner.toString() == quickAccess.ID.toString())
                 						{
                 							canQuickEdit = true;
                 							break;
                 						}
                 					}
                 				}
                 				if(!canQuickEdit)
                 				{
                 					resp.put("success",false);
                 					resp.put("error","You do not have access to lock or unlock this Pro Forma.");
                 					return resp.toString();
                 				}
                 				lockValue = ifnull(data.get("lock"),false).toString().toLowerCase() == "true";
                 				quickPf.Lock_Inputs=lockValue;
                 				resp.put("success",true);
                 				resp.put("id",pfId);
                 				resp.put("lock",lockValue);
                 				resp.put("action","lock_updated");
                 				return resp.toString();
                 			}
                 			if(quickAccess.Edit_Proforma_Owner != true && quickAccess.Edit_Budget_Owners != true)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Edit Pro Forma Owners access is required.");
                 				return resp.toString();
                 			}
                 			ownerIds = List();
                 			for each  ownerValue in ifnull(data.get("ownerIds"),List())
                 			{
                 				ownerIdText = ifnull(ownerValue,"").toString().trim();
                 				if(ownerIdText != "")
                 				{
                 					ownerAccess = User_Access[ID == ownerIdText.toLong()];
                 					if(ownerAccess == null)
                 					{
                 						resp.put("success",false);
                 						resp.put("error","Owner " + ownerIdText + " was not found in User Access.");
                 						return resp.toString();
                 					}
                 					ownerIds.add(ownerAccess.ID);
                 				}
                 			}
                 			quickPf.Owner=ownerIds;
                 			resp.put("success",true);
                 			resp.put("id",pfId);
                 			resp.put("ownerIds",ownerIds);
                 			resp.put("action","owners_updated");
                 			return resp.toString();
                 		}
                 		if(op == "archive_proforma" || op == "delete_proforma")
                 		{
                 			if(pfId == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro Forma id is required.");
                 				return resp.toString();
                 			}
                 			manageAccessId = ifnull(data.get("userAccessId"),"").toString().trim();
                 			if(manageAccessId == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Delete / Archive Pro Formas access is required.");
                 				return resp.toString();
                 			}
                 			manageAccess = User_Access[ID == manageAccessId.toLong()];
                 			if(manageAccess == null || manageAccess.Delete_Archive_Pro_Formas != true)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Delete / Archive Pro Formas access is required.");
                 				return resp.toString();
                 			}
                 			pfKey = pfId.toLong();
                 			managePf = Add_Pro_Forma[ID == pfKey];
                 			if(managePf == null)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro Forma " + pfId + " was not found.");
                 				return resp.toString();
                 			}
                 			if(op == "archive_proforma")
                 			{
                 				archiveValue = ifnull(data.get("archive"),true).toString().toLowerCase() == "true";
                 				managePf.Archive=archiveValue;
                 				resp.put("success",true);
                 				resp.put("id",pfId);
                 				resp.put("archive",archiveValue);
                 				resp.put("action",if(archiveValue,"archived","restored"));
                 				return resp.toString();
                 			}
                 			// LOI records and the Company / Builder / Property master records created
                 			// through the LOI tab are protected. Require Archive instead of Delete.
                 			deleteStage = "loi_protection_check";
                 			protectedLoiIds = List();
                 			for each  protectedLoi in LOI_Worksheet[Proforma == pfKey]
                 			{
                 				protectedLoiIds.add(protectedLoi.ID);
                 			}
                 			if(protectedLoiIds.size() > 0)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","This Pro Forma has LOI records and cannot be deleted. Archive it instead.");
                 				resp.put("errorCode","LOI_DELETE_BLOCKED");
                 				resp.put("loiWorksheetCount",protectedLoiIds.size());
                 				return resp.toString();
                 			}
                 			deleted = Map();
                 			// Delete each lookup path separately. Combining lookup fields with OR in a
                 			// collection fetch caused Creator's runtime "Invalid statement found" error.
                 			deleteStage = "land_purchase_installments";
                 			landDeleteCount = 0;
                 			deleteIds = List();
                 			for each  purchaseRec in Land_Installments[Pro_Forma == pfKey]
                 			{
                 				deleteIds.add(purchaseRec.ID);
                 			}
                 			for each  childId in deleteIds
                 			{
                 				delete from Land_Installments[ID == childId];
                 				landDeleteCount = landDeleteCount + 1;
                 			}
                 			deleteStage = "land_sale_installments";
                 			deleteIds = List();
                 			for each  saleRec in Land_Installments[Pro_Forma2 == pfKey]
                 			{
                 				deleteIds.add(saleRec.ID);
                 			}
                 			for each  childId in deleteIds
                 			{
                 				delete from Land_Installments[ID == childId];
                 				landDeleteCount = landDeleteCount + 1;
                 			}
                 			deleteStage = "pid_mud_installments";
                 			deleteIds = List();
                 			for each  pidRec in Land_Installments[Pro_Forma_PID_MUD == pfKey]
                 			{
                 				deleteIds.add(pidRec.ID);
                 			}
                 			for each  childId in deleteIds
                 			{
                 				delete from Land_Installments[ID == childId];
                 				landDeleteCount = landDeleteCount + 1;
                 			}
                 			deleted.put("Land_Installments",landDeleteCount);
                 			deleteStage = "construction_additional_items";
                 			itemDeleteCount = 0;
                 			deleteIds = List();
                 			for each  constItemRec in Proforma_Item[Pro_Forma_Const == pfKey]
                 			{
                 				deleteIds.add(constItemRec.ID);
                 			}
                 			for each  childId in deleteIds
                 			{
                 				delete from Proforma_Item[ID == childId];
                 				itemDeleteCount = itemDeleteCount + 1;
                 			}
                 			deleteStage = "development_additional_items";
                 			deleteIds = List();
                 			for each  devItemRec in Proforma_Item[Pro_Forma_Dev == pfKey]
                 			{
                 				deleteIds.add(devItemRec.ID);
                 			}
                 			for each  childId in deleteIds
                 			{
                 				delete from Proforma_Item[ID == childId];
                 				itemDeleteCount = itemDeleteCount + 1;
                 			}
                 			deleted.put("Proforma_Item",itemDeleteCount);
                 			deleteStage = "construction_curve";
                 			deleteIds = List();
                 			for each  curveRec in Construction_Curve[Pro_Forma == pfKey]
                 			{
                 				deleteIds.add(curveRec.ID);
                 			}
                 			deleted.put("Construction_Curve",deleteIds.size());
                 			for each  childId in deleteIds
                 			{
                 				delete from Construction_Curve[ID == childId];
                 			}
                 			deleteStage = "proforma_phases";
                 			deleteIds = List();
                 			for each  phaseRec in Proforma_Phase[Pro_Forma == pfKey]
                 			{
                 				deleteIds.add(phaseRec.ID);
                 			}
                 			deleted.put("Proforma_Phase",deleteIds.size());
                 			for each  childId in deleteIds
                 			{
                 				delete from Proforma_Phase[ID == childId];
                 			}
                 			deleteStage = "proforma_months";
                 			deleteIds = List();
                 			for each  monthRec in Proforma_Months[Proforma == pfKey]
                 			{
                 				deleteIds.add(monthRec.ID);
                 			}
                 			deleted.put("Proforma_Months",deleteIds.size());
                 			for each  childId in deleteIds
                 			{
                 				delete from Proforma_Months[ID == childId];
                 			}
                 			// Do not delete or modify LOI Worksheets, Companies, Builders/Sellers,
                 			// or Properties. The LOI protection check above prevents orphaning them.
                 			deleteStage = "parent_proforma";
                 			delete from Add_Pro_Forma[ID == pfKey];
                 			deleteStage = "complete";
                 			resp.put("success",true);
                 			resp.put("id",pfId);
                 			resp.put("deleted",deleted);
                 			resp.put("action","deleted");
                 			return resp.toString();
                 		}
                 		if(op == "save_loi")
                 		{
                 			if(pfId == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Pro forma id is required for save_loi.");
                 				return resp.toString();
                 			}
                 			pfKey = pfId.toLong();
                 			loi = ifnull(data.get("loi"),Map());
                 			ws = ifnull(loi.get("worksheet"),Map());
                 			companyId = ifnull(ws.get("Company"),"").toString().trim();
                 			tempMap = Map();
                 			sellerMapOut = List();
                 			for each  ns in ifnull(loi.get("newSellers"),List())
                 			{
                 				nsName = ifnull(ns.get("Builder_Name"),"").toString().trim();
                 				if(nsName != "")
                 				{
                 					newB = insert into Builder
                 					[
                 						Builder_Name=nsName
                 						Email=ifnull(ns.get("Email"),"")
                 						Phone_Number=ifnull(ns.get("Phone_Number"),"")
                 						Type1="Seller"
                 						Added_User=zoho.loginuser
                 					];
                 					bRec = Builder[ID == newB];
                 					bIds = List();
                 					bIds.add(pfKey);
                 					bRec.Proforma=bIds;
                 					tempMap.put(ifnull(ns.get("tempId"),"").toString(),newB.toString());
                 					sm = Map();
                 					sm.put("tempId",ifnull(ns.get("tempId"),"").toString());
                 					sm.put("id",newB.toString());
                 					sellerMapOut.add(sm);
                 				}
                 			}
                 			for each  sid in ifnull(loi.get("sellerIds"),List())
                 			{
                 				sidStr = sid.toString().trim();
                 				if(sidStr != "")
                 				{
                 					exB = Builder[ID == sidStr.toLong()];
                 					if(exB != null)
                 					{
                 						exIds = List();
                 						exFound = false;
                 						for each  ex in exB.Proforma
                 						{
                 							exIds.add(ex);
                 							if(ex.toString() == pfId)
                 							{
                 								exFound = true;
                 							}
                 						}
                 						if(!exFound)
                 						{
                 							exIds.add(pfKey);
                 							exB.Proforma=exIds;
                 						}
                 					}
                 				}
                 			}
                 			if(companyId != "")
                 			{
                 				coRec = Company[ID == companyId.toLong()];
                 				if(coRec != null)
                 				{
                 					coIds = List();
                 					coFound = false;
                 					for each  co in coRec.Proforma
                 					{
                 						coIds.add(co);
                 						if(co.toString() == pfId)
                 						{
                 							coFound = true;
                 						}
                 					}
                 					if(!coFound)
                 					{
                 						coIds.add(pfKey);
                 						coRec.Proforma=coIds;
                 					}
                 				}
                 			}
                 			propertyMapOut = List();
                 			for each  np in ifnull(loi.get("newProperties"),List())
                 			{
                 				npName = ifnull(np.get("Common_Name"),"").toString().trim();
                 				npPid = ifnull(np.get("Property_ID"),"").toString().trim();
                 				if(npName != "" || npPid != "")
                 				{
                 					newP = insert into Property
                 					[
                 						Common_Name=npName
                 						Property_ID=npPid
                 						Facility_ID=ifnull(np.get("Facility_ID"),"")
                 						County=ifnull(np.get("County"),"")
                 						Added_User=zoho.loginuser
                 					];
                 					pRec = Property[ID == newP];
                 					npAcres = ifnull(np.get("Acres"),"").toString().trim();
                 					if(npAcres != "")
                 					{
                 						pRec.Acres=npAcres.toDecimal();
                 					}
                 					pRec.Proforma=pfKey;
                 					sRef = ifnull(np.get("sellerRef"),"").toString().trim();
                 					if(tempMap.get(sRef) != null)
                 					{
                 						sRef = tempMap.get(sRef).toString();
                 					}
                 					if(sRef != "")
                 					{
                 						pRec.Seller=sRef.toLong();
                 					}
                 					if(companyId != "")
                 					{
                 						pRec.Company1=companyId.toLong();
                 					}
                 					pm = Map();
                 					pm.put("tempId",ifnull(np.get("tempId"),"").toString());
                 					pm.put("id",newP.toString());
                 					propertyMapOut.add(pm);
                 				}
                 			}
                 			assigns = ifnull(loi.get("propertyAssignments"),Map());
                 			for each  pid in ifnull(loi.get("propertyIds"),List())
                 			{
                 				pidStr = pid.toString().trim();
                 				if(pidStr != "")
                 				{
                 					exP = Property[ID == pidStr.toLong()];
                 					if(exP != null)
                 					{
                 						exP.Proforma=pfKey;
                 						aRow = assigns.get(pidStr);
                 						if(aRow != null)
                 						{
                 							aSid = ifnull(aRow.get("sellerId"),"").toString().trim();
                 							if(tempMap.get(aSid) != null)
                 							{
                 								aSid = tempMap.get(aSid).toString();
                 							}
                 							if(aSid != "")
                 							{
                 								exP.Seller=aSid.toLong();
                 							}
                 						}
                 						if(companyId != "")
                 						{
                 							exP.Company1=companyId.toLong();
                 						}
                 					}
                 				}
                 			}
                 			loiId = ifnull(loi.get("id"),"").toString().trim();
                 			loiRecId = 0;
                 			// A Pro Forma can already exist while its first LOI Worksheet does not.
                 			// Resolve the worksheet by record existence, not by whether the Pro Forma is new.
                 			if(loiId != "")
                 			{
                 				requestedLoiRec = LOI_Worksheet[ID == loiId.toLong() && Proforma == pfKey];
                 				if(requestedLoiRec.ID != null)
                 				{
                 					loiRecId = requestedLoiRec.ID.toLong();
                 				}
                 			}
                 			// If the client did not supply a usable worksheet ID, reuse this
                 			// Pro Forma's current worksheet when one exists.
                 			if(loiRecId == 0)
                 			{
                 				currentLoiRec = LOI_Worksheet[Proforma == pfKey && Is_Current == true];
                 				if(currentLoiRec.ID != null)
                 				{
                 					loiRecId = currentLoiRec.ID.toLong();
                 				}
                 			}
                 			// Existing Pro Formas may be receiving LOI data for the first time.
                 			// Create and link the worksheet in the insert itself so there is never
                 			// an empty record variable to update.
                 			if(loiRecId == 0)
                 			{
                 				newLoi = insert into LOI_Worksheet
                 				[
                 					Proforma=pfKey
                 					Is_Current=true
                 					Added_User=zoho.loginuser
                 				];
                 				loiRecId = newLoi.toLong();
                 			}
                 			loiRec = LOI_Worksheet[ID == loiRecId];
                 			if(loiRec.ID == null)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","The LOI Worksheet could not be created or loaded.");
                 				resp.put("errorCode","LOI_WORKSHEET_NOT_FOUND");
                 				return resp.toString();
                 			}
                 			loiRec.Proforma=pfKey;
