                 			failWriterEntry.put("message","Writer did not return a file");
                 			failWriterEntry.put("meta",{"response":mergedFile});
                 			trace.add(failWriterEntry);
                 			result.put("success",false);
                 			result.put("message","Zoho Writer did not return a DOCX file.");
                 			result.put("stage",stage);
                 			result.put("writerResponse",mergedFile);
                 			result.put("audit",trace);
                 			return result;
                 		}
                 		fileName = fileBaseName + ".docx";
                 		mergedFile.setFileName(fileName);
                 		writerOkEntry = Map();
                 		writerOkEntry.put("level","success");
                 		writerOkEntry.put("stage",stage);
                 		writerOkEntry.put("message","Writer returned the merged DOCX");
                 		writerOkEntry.put("meta",{"fileName":fileName});
                 		trace.add(writerOkEntry);
                 		result.put("success",true);
                 		result.put("file",mergedFile);
                 		result.put("fileName",fileName);
                 		result.put("missing",missing);
                 		result.put("audit",trace);
                 		result.put("contractTerritory",contractTerritory);
                 		result.put("wbwPointPerson",wbwPointPerson);
                 		return result;
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI generation failed during " + stage + ": " + e.message);
                 		result.put("stage",stage);
                 		result.put("audit",trace);
                 	}
                 	return result;
                 }
				 map PF_Build_Proforma_Approval_PDF(string proformaId, string approvalId)
                 {
                 	result = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","Pro Forma ID and approval ID are required while building the PDF.");
                 			return result;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		approvalRow = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null || approvalRow.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","Pro Forma or approval record not found while building the PDF.");
                 			return result;
                 		}
                 		if(approvalRow.Proforma == null || approvalRow.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			result.put("success",false);
                 			result.put("message","The approval record is not connected to the supplied Pro Forma.");
                 			return result;
                 		}
                 		/*
                 		* Parentheses ensure Additional Cost and cash snapshot filters
                 		* apply only to this Pro Forma.
                 		*/
                 		// Read the Pro Forma's actual child rows. A combined Proforma_Item criteria
                 		// can omit Development rows even while the parent subform contains them.
                 		additionalItemIds = List();
                 		if(pf.Additional_Costs_Development != null)
                 		{
                 			for each  developmentItem in pf.Additional_Costs_Development
                 			{
                 				if(developmentItem.Add_l_Cost != null && developmentItem.Add_l_Cost != 0)
                 				{
                 					additionalItemIds.add(developmentItem.ID.toString());
                 				}
                 			}
                 		}
                 		if(pf.Additional_Costs_Construction != null)
                 		{
                 			for each  constructionItem in pf.Additional_Costs_Construction
                 			{
                 				if(constructionItem.Add_l_Cost != null && constructionItem.Add_l_Cost != 0)
                 				{
                 					additionalItemIds.add(constructionItem.ID.toString());
                 				}
                 			}
                 		}
                 		loi = LOI_Worksheet[Proforma == proformaIdLong && Is_Current == true];
                 		if(loi.ID == null)
                 		{
                 			loi = LOI_Worksheet[Proforma == proformaIdLong];
                 		}
                 		sellers = Builder[Proforma == proformaIdLong] sort by Builder_Name;
                 		properties = Property[Proforma == proformaIdLong] sort by Common_Name;
                 		approvalRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		purchaseRows = Land_Installments[Pro_Forma == proformaIdLong] sort by Month1;
                 		saleRows = Land_Installments[Pro_Forma2 == proformaIdLong && Type1 == "Sale"] sort by Month1;
                 		pidMudRows = Land_Installments[Pro_Forma_PID_MUD == proformaIdLong && Type1 == "PID/MUD"] sort by Month1;
                 		lotMixRows = Lot_Mix_Row[Pro_Forma == proformaIdLong] sort by Lot_Size_Ft;
                 		pfName = ifnull(pf.Name,"Pro Forma #" + proformaIdText).toString();
                 		territory = ifnull(pf.Territory,"Not provided").toString();
                 		// Pro Forma owner names: User_Access.Full_Name, falling back to the login trimmed at "@"
                 		// and "_" (the way the widget labels owners) for rows that have no Full_Name yet.
                 		ownerNameList = List();
                 		if(pf.Owner != null)
                 		{
                 			for each  ownerRow in pf.Owner
                 			{
                 				ownerAccess = User_Access[ID == ownerRow.ID];
                 				if(ownerAccess.ID != null)
                 				{
                 					ownerName = ifnull(ownerAccess.Full_Name,"").toString().trim();
                 					if(ownerName == "")
                 					{
                 						ownerName = ifnull(ownerAccess.User,"").toString().trim();
                 						if(ownerName == "")
                 						{
                 							ownerName = ifnull(ownerAccess.Approver_Email,"").toString().trim();
                 						}
                 						if(ownerName.contains("@"))
                 						{
                 							ownerName = ownerName.getPrefix("@");
                 						}
                 						if(ownerName.contains("_"))
                 						{
                 							ownerName = ownerName.getPrefix("_");
                 						}
                 					}
                 					if(ownerName != "" && ownerNameList.contains(ownerName) == false)
                 					{
                 						ownerNameList.add(ownerName);
                 					}
                 				}
                 			}
                 		}
                 		ownerNamesLabel = "Not assigned";
                 		if(ownerNameList.size() > 0)
                 		{
                 			ownerNamesLabel = ownerNameList.toString(", ");
                 		}
                 		stage = ifnull(pf.Probability,"Not provided").toString();
                 		statusValue = ifnull(pf.Status,"Draft").toString();
                 		generatedLabel = zoho.currenttime.toString("MMM d, yyyy 'at' h:mm a");
                 		purchaseLabel = "Not provided";
                 		completionLabel = "Not provided";
                 		engineeringStartLabel = "Not provided";
                 		constructionStartLabel = "Not provided";
                 		lotSaleStartLabel = "Not provided";
                 		if(pf.Estimated_Purchase_Date != null)
                 		{
                 			purchaseLabel = pf.Estimated_Purchase_Date.toString("MMM, yyyy");
                 		}
                 		if(pf.Estimated_Completion != null)
                 		{
                 			completionLabel = pf.Estimated_Completion.toString("MMM, yyyy");
                 		}
                 		if(pf.Engineering_Start != null)
                 		{
                 			engineeringStartLabel = pf.Engineering_Start.toString("MMM, yyyy");
                 		}
                 		if(pf.Construction_Start != null)
                 		{
                 			constructionStartLabel = pf.Construction_Start.toString("MMM, yyyy");
                 		}
                 		if(pf.Estimated_Lot_Sale_Start != null)
                 		{
                 			lotSaleStartLabel = pf.Estimated_Lot_Sale_Start.toString("MMM, yyyy");
                 		}
                 		companyName = "Not provided";
                 		if(loi.ID != null && loi.Company != null)
                 		{
                 			companyRecord = Company[ID == loi.Company];
                 			if(companyRecord.ID != null)
                 			{
                 				companyName = ifnull(companyRecord.Company_Name,"Not provided").toString();
                 			}
                 		}
                 		else if(pf.Purchasing_Company != null)
                 		{
                 			companyRecord = Company[ID == pf.Purchasing_Company];
                 			if(companyRecord.ID != null)
                 			{
                 				companyName = ifnull(companyRecord.Company_Name,"Not provided").toString();
                 			}
                 		}
                 		lotsValue = ifnull(pf.Lots,0).toDecimal();
                 		baseConstCostPerLot = ifnull(pf.Ft_St_per_Lot,0).toDecimal() * ifnull(pf.Const_Cost_FF,0).toDecimal();
                 		totalCostPerLot = 0;
                 		developmentCostPerLot = 0;
                 		if(lotsValue > 0)
                 		{
                 			totalCostPerLot = (ifnull(pf.Total_Expenses,0).toDecimal() - ifnull(pf.Land_Cost,0).toDecimal()) / lotsValue;
                 			developmentCostPerLot = totalCostPerLot - baseConstCostPerLot;
                 			if(developmentCostPerLot < 0)
                 			{
                 				developmentCostPerLot = 0;
                 			}
                 		}
                 		lotSalePrice = ifnull(pf.Sale_Price_FF,0).toDecimal() * ifnull(pf.Lot_Size_Ft,0).toDecimal();
                 		projectCostPerLot = 0;
                 		constructionAdditionalCostPerLot = 0;
                 		if(lotsValue > 0)
                 		{
                 			projectCostPerLot = ifnull(pf.Total_Expenses,0).toDecimal() / lotsValue;
                 			constructionAdditionalCostPerLot = ifnull(pf.Construction_Cost_Addl,0).toDecimal() / lotsValue;
                 		}
                 		lotMixLabel = "Not provided";
                 		lotMixParts = List();
                 		for each  lotMixItem in lotMixRows
                 		{
                 			lotMixSize = ifnull(lotMixItem.Lot_Size_Ft,"").toString().trim();
                 			lotMixCount = ifnull(lotMixItem.Lot_Count,"").toString().trim();
                 			if(lotMixSize != "" && lotMixCount != "")
                 			{
                 				lotMixParts.add(thisapp.PF_Packet_Number(lotMixSize,0) + "s: " + thisapp.PF_Packet_Number(lotMixCount,0));
                 			}
                 		}
                 		if(lotMixParts.size() > 0)
                 		{
                 			lotMixLabel = lotMixParts.toString(", ");
                 		}
                 		firstSaleInstallmentLabel = "None";
                 		saleInstallmentTotal = 0;
                 		saleInstallmentIndex = 0;
                 		for each  saleInstallment in saleRows
                 		{
                 			saleInstallmentTotal = saleInstallmentTotal + ifnull(saleInstallment.Cost,0).toDecimal();
                 			if(saleInstallmentIndex == 0)
                 			{
                 				firstSaleDate = "Date not provided";
                 				if(saleInstallment.Date1 != null)
                 				{
                 					firstSaleDate = saleInstallment.Date1.toString("MMM, yyyy");
                 				}
                 				firstSaleInstallmentLabel = firstSaleDate;
                 			}
                 			saleInstallmentIndex = saleInstallmentIndex + 1;
                 		}
                 		if(saleInstallmentIndex > 0)
                 		{
                 			firstSaleInstallmentLabel = firstSaleInstallmentLabel + " (1 of " + saleInstallmentIndex.toString() + ")";
                 		}
                 		pidMudTotal = 0;
                 		for each  reimbursementItem in pidMudRows
                 		{
                 			pidMudTotal = pidMudTotal + ifnull(reimbursementItem.Cost,0).toDecimal();
                 		}
                 		developmentRecordedTotal = 0;
                 		constructionAdditionalTotal = 0;
                 		impactFeesTotal = 0;
                 		otherReimbursementsTotal = 0;
                 		for each  additionalTotalItemId in additionalItemIds
                 		{
                 			additionalTotalItem = Proforma_Item[ID == additionalTotalItemId.toLong()];
                 			additionalDepartment = ifnull(additionalTotalItem.Department,"").toString();
                 			additionalCategory = ifnull(additionalTotalItem.Category,"").toString().trim().toLowerCase();
                 			additionalAmount = ifnull(additionalTotalItem.Add_l_Cost,0).toDecimal();
                 			if(additionalCategory == "reimbursements")
                 			{
                 				if(ifnull(additionalTotalItem.Item_Name,"").toString().toLowerCase().contains("impact fee"))
                 				{
                 					impactFeesTotal = impactFeesTotal + additionalAmount;
                 				}
                 				else
                 				{
                 					otherReimbursementsTotal = otherReimbursementsTotal + additionalAmount;
                 				}
                 			}
                 			else if(additionalDepartment != "Construction")
                 			{
                 				developmentRecordedTotal = developmentRecordedTotal + additionalAmount;
                 			}
                 			else if(additionalDepartment == "Construction")
                 			{
                 				constructionAdditionalTotal = constructionAdditionalTotal + additionalAmount;
                 			}
                 		}
                 		developmentAdditionalTotal = developmentRecordedTotal;
                 		developmentHeaderTotal = ifnull(pf.Entitlement_Engineering_Addl,0).toDecimal();
                 		if(developmentHeaderTotal != 0)
                 		{
                 			developmentAdditionalTotal = developmentHeaderTotal;
                 		}
                 		roiDisplay = "Not provided";
                 		if(pf.ROI1 != null && pf.ROI1.toString().trim() != "")
                 		{
                 			roiDisplay = thisapp.PF_Packet_Number(pf.ROI1.toString(),2) + "%";
                 		}
                 		irrDisplay = "—";
                 		if(pf.IRR != null && pf.IRR.toString().trim() != "")
                 		{
                 			irrDisplay = thisapp.PF_Packet_Number(pf.IRR.toString(),2) + "%";
                 		}
                 		xirrDisplay = "—";
                 		if(pf.XIRR != null && pf.XIRR.toString().trim() != "")
                 		{
                 			xirrDisplay = thisapp.PF_Packet_Number(pf.XIRR.toString(),2) + "%";
                 		}
                 		pageStreams = List();
                 		ownerOverflowBlocks = List();
                 		/*
                 		* PDF palette.
                 		*/
                 		navy = "0.05 0.16 0.30";
                 		deepNavy = "0.04 0.13 0.25";
                 		blue = "0.14 0.38 0.78";
                 		green = "0.04 0.50 0.25";
                 		red = "0.75 0.12 0.16";
                 		purple = "0.45 0.20 0.78";
                 		orange = "0.75 0.35 0.05";
                 		ink = "0.07 0.12 0.20";
                 		muted = "0.35 0.42 0.52";
                 		lightMuted = "0.55 0.61 0.70";
                 		line = "0.84 0.88 0.93";
                 		softLine = "0.90 0.93 0.96";
                 		canvas = "0.95 0.97 0.99";
                 		panel = "0.98 0.99 1.00";
                 		white = "1 1 1";
                 		softBlue = "0.92 0.95 1.00";
                 		sectionBlue = "0.11 0.31 0.56";
                 		softGreen = "0.92 0.98 0.95";
                 		softRed = "1.00 0.94 0.95";
                 		softPurple = "0.96 0.94 1.00";
                 		softOrange = "1.00 0.96 0.90";
                 		/*
                 		* =========================================================
                 		* PAGE 1 - EXECUTIVE APPROVAL DASHBOARD
                 		* =========================================================
                 		*/
                 		page = thisapp.PF_PDF_Rect(0,0,1224,792,canvas,"",0);
                 		pfHeader = pfName;
                 		if(pfHeader.length() > 33)
                 		{
                 			pfHeader = pfHeader.left(30) + "...";
                 		}
                 		ownerHeader = ownerNamesLabel;
                 		territoryHeader = territory;
                 		if(territoryHeader.length() > 26)
                 		{
                 			territoryHeader = territoryHeader.left(23) + "...";
                 		}
                 		/* Compact identity, return and flow band from the approved one-sheet layout. */
                 		page = page + thisapp.PF_PDF_Rect(28,682,430,82,deepNavy,"",0);
                 		page = page + thisapp.PF_PDF_Rect(28,682,430,4,blue,"",0);
                 		page = page + thisapp.PF_PDF_Text(46,744,17,"bold",white,pfHeader);
                 		ownerLines = thisapp.PF_PDF_Wrap("Owners: " + ownerHeader,58);
                 		ownerY = 726;
                 		ownerLineCount = 0;
                 		for each  ownerLine in ownerLines
                 		{
                 			if(ownerLineCount < 2)
                 			{
                 				page = page + thisapp.PF_PDF_Text(46,ownerY,9.2,"regular","0.78 0.85 0.93",ownerLine);
                 				ownerY = ownerY - 10;
                 			}
                 			ownerLineCount = ownerLineCount + 1;
                 		}
                 		if(ownerLineCount > 2)
                 		{
                 			ownerBlock = Map();
                 			ownerBlock.put("title","Acquisition owners");
                 			ownerBlock.put("body",ownerHeader);
                 			ownerOverflowBlocks.add(ownerBlock);
                 		}
                 		identityDatesY = if(ownerLineCount > 1,700,708);
                 		identityStatusY = if(ownerLineCount > 1,686,690);
                 		page = page + thisapp.PF_PDF_Text(46,identityDatesY,8.4,"regular","0.78 0.85 0.93","Purchase: " + purchaseLabel + " | Completion: " + completionLabel);
                 		page = page + thisapp.PF_PDF_Text(46,identityStatusY,8.4,"regular","0.78 0.85 0.93",territoryHeader + " | Stage: " + stage + " | Status: " + statusValue);
                 		page = page + thisapp.PF_PDF_Rect(472,724,584,40,softBlue,line,0.35);
                 		returnX = {488,680,872};
                 		returnLabels = {"ROI","IRR","XIRR"};
                 		returnValues = {roiDisplay,irrDisplay,xirrDisplay};
                 		for each index returnIndex in returnLabels
                 		{
                 			if(returnIndex > 0)
                 			{
                 				page = page + thisapp.PF_PDF_Rect(returnX.get(returnIndex) - 14,732,0.6,24,"0.78 0.84 0.91","",0);
                 			}
                 			page = page + thisapp.PF_PDF_Text(returnX.get(returnIndex),742,11,"bold",muted,returnLabels.get(returnIndex));
                 			page = page + thisapp.PF_PDF_Text(returnX.get(returnIndex) + 65,740,19,"bold",blue,returnValues.get(returnIndex));
                 		}
                 		page = page + thisapp.PF_PDF_Rect(472,682,584,40,white,line,0.35);
                 		flowX = {488,680,872};
                 		flowLabels = {"INFLOWS","OUTFLOWS","NET PROFIT"};
                 		flowValues = {thisapp.PF_Packet_Money(ifnull(pf.Total_Income,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Total_Expenses,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Net_Profit,0).toString())};
                 		flowColors = {green,red,navy};
                 		for each index flowIndex in flowLabels
                 		{
                 			if(flowIndex > 0)
                 			{
                 				page = page + thisapp.PF_PDF_Rect(flowX.get(flowIndex) - 14,690,0.6,24,"0.78 0.84 0.91","",0);
                 			}
                 			page = page + thisapp.PF_PDF_Text(flowX.get(flowIndex),697,10.5,"bold",muted,flowLabels.get(flowIndex));
                 			page = page + thisapp.PF_PDF_Text(flowX.get(flowIndex) + 65,694,15.5,"bold",flowColors.get(flowIndex),flowValues.get(flowIndex));
                 		}
                 		page = page + thisapp.PF_PDF_Rect(1070,682,126,82,deepNavy,"",0);
                 		page = page + thisapp.PF_PDF_Rect(1082,704,102,42,"0.09 0.25 0.44","0.20 0.42 0.68",0.5);
                 		page = page + thisapp.PF_PDF_Text(1092,732,5.5,"bold","0.70 0.81 0.93","CURRENT STEP");
                 		page = page + thisapp.PF_PDF_Text(1092,714,9.5,"bold",white,ifnull(approvalRow.Title,"Approver").toString());
                 		/* Complete Inflows and Outflows sections from the Word template. */
                 		page = page + thisapp.PF_PDF_Rect(28,506,204,162,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(28,506,4,162,green,"",0);
                 		page = page + thisapp.PF_PDF_Text(40,646,9.5,"bold",green,"TOTAL INFLOWS");
                 		page = page + thisapp.PF_PDF_Text(40,623,16,"bold",green,thisapp.PF_Packet_Money(ifnull(pf.Total_Income,0).toString()));
                 		inflowLabels = {"Gross Sales","MUD Revenue","Reimbursements","Reimbursed Fees","Land Sales (Other)"};
                 		inflowValues = {thisapp.PF_Packet_Money(ifnull(pf.Gross_Sales,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.MUD_Revenue,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Reimbursements,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Reimbursed_Fees,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Land_Sale,0).toString())};
                 		for each index inflowIndex in inflowLabels
                 		{
                 			flowRowY = 601 - inflowIndex * 19;
                 			page = page + thisapp.PF_PDF_Text(40,flowRowY,11,"regular",muted,inflowLabels.get(inflowIndex));
                 			page = page + thisapp.PF_PDF_Text(144,flowRowY,11,"bold",ink,inflowValues.get(inflowIndex));
                 		}
                 		page = page + thisapp.PF_PDF_Rect(246,506,244,162,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(246,506,4,162,red,"",0);
                 		page = page + thisapp.PF_PDF_Text(258,646,9.5,"bold",red,"TOTAL OUTFLOWS");
                 		page = page + thisapp.PF_PDF_Text(258,623,16,"bold",red,thisapp.PF_Packet_Money(ifnull(pf.Total_Expenses,0).toString()));
                 		outflowLabels = {"Land Cost","Engineering Base","Ent/Eng Add'l","Construction Base","Construction Add'l"};
                 		outflowValues = {thisapp.PF_Packet_Money(ifnull(pf.Land_Cost,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Entitlement_Cost,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Entitlement_Engineering_Addl,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Construction_Cost_Base,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Construction_Cost_Addl,0).toString())};
                 		for each index outflowIndex in outflowLabels
                 		{
                 			flowRowY = 601 - outflowIndex * 19;
                 			page = page + thisapp.PF_PDF_Text(258,flowRowY,11,"regular",muted,outflowLabels.get(outflowIndex));
                 			page = page + thisapp.PF_PDF_Text(366,flowRowY,11,"bold",ink,outflowValues.get(outflowIndex));
                 		}
                 		/* Main panel shells and section headers. */
                 		page = page + thisapp.PF_PDF_Rect(358,44,316,228,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(358,246,316,26,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(370,255,9,"bold",white,"LAND PURCHASE / INSTALLMENTS");
                 		page = page + thisapp.PF_PDF_Text(570,255,10,"bold",white,thisapp.PF_Packet_Money(ifnull(pf.Land_Cost,0).toString()) + " / " + purchaseRows.count().toString());
                 		page = page + thisapp.PF_PDF_Rect(1018,44,178,624,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(1018,618,178,50,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(1030,649,10,"bold",white,"PID/MUD/TIRZ");
                 		page = page + thisapp.PF_PDF_Text(1124,633,10,"bold",white,thisapp.PF_Packet_Money(pidMudTotal.toString()));
                 		page = page + thisapp.PF_PDF_Rect(504,506,170,162,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(504,642,170,26,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(516,651,9,"bold",white,"SITE INFO");
                 		page = page + thisapp.PF_PDF_Rect(28,44,316,228,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(28,246,316,26,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(40,255,9,"bold",white,"TIMELINE");
                 		page = page + thisapp.PF_PDF_Rect(28,286,316,212,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(28,472,316,26,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(40,481,9,"bold",white,"LOT SALES");
                 		page = page + thisapp.PF_PDF_Text(206,481,10,"bold",white,thisapp.PF_Packet_Money(ifnull(pf.Gross_Sales,0).toString()));
                 		page = page + thisapp.PF_PDF_Rect(358,286,316,212,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(358,472,316,26,sectionBlue,"",0);
                 		page = page + thisapp.PF_PDF_Text(370,481,9,"bold",white,"COSTS");
                 		page = page + thisapp.PF_PDF_Text(542,484,10,"bold",white,thisapp.PF_Packet_Money(ifnull(pf.Total_Expenses,0).toString()));
                 		page = page + thisapp.PF_PDF_Text(542,474,8,"bold",white,thisapp.PF_Packet_Money(projectCostPerLot.toString()) + "/lot");
                 		/* Land Purchase installment table from the supplied page-one template. */
                 		purchasePreviewLimit = 8;
