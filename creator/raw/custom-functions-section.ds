				 string recalcAllRevisedFinals()
                 {
                 	/********* RECALC REVISED FINAL — BATCH *********/
                 	// Nightly safety net: recompute Revised_Final for every Budget_Item that has
                 	// modifications, plus any item whose Revised_Final drifted from Budget_Ttl
                 	// with no modifications (e.g. Final changed after finalization).
                 	itemIds = List();
                 	modRows = Budget_Modification[ID != 0];
                 	for each  mr in modRows
                 	{
                 		if(mr.Budget_Item != null)
                 		{
                 			iid = mr.Budget_Item.ID;
                 			if(!itemIds.contains(iid))
                 			{
                 				itemIds.add(iid);
                 			}
                 		}
                 	}
                 	updated = 0;
                 	for each  iid2 in itemIds
                 	{
                 		result = thisapp.recalcItemRevisedFinal(iid2.toLong());
                 		updated = updated + 1;
                 	}
                 	// Items with a stale Revised_Final but no modifications: reset to Budget_Ttl.
                 	staleRows = Budget_Item[Revised_Final != null];
                 	for each  sr in staleRows
                 	{
                 		if(!itemIds.contains(sr.ID))
                 		{
                 			finVal = ifnull(sr.Budget_Ttl,0.0);
                 			if(ifnull(sr.Revised_Final,0.0) != finVal)
                 			{
                 				sr.Revised_Final=finVal;
                 				updated = updated + 1;
                 			}
                 		}
                 	}
                 	return "Recalculated Revised Final for " + updated + " items.";
                 }
				 string recalcBudgetModifiedTotals(int budgetId)
                 {
                 	/********* RECALC MODIFIED FINAL ROLLUPS *********/
                 	// Return Type: string
                 	// Modified Final = Final (Budget_Ttl) + sum of APPROVED modification amounts,
                 	// rolled up from items to Budget_Category.Modified_Final_Total and then to
                 	// Add_Budget.Modified_Final_Grand_Total.
                 	// Computed from the modification records directly rather than from
                 	// Budget_Item.Revised_Final so a blank/stale Revised_Final cannot skew it.
                 	// Called when a modification chain completes (see sendModificationEmail).
                 	vBudgetId = budgetId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	grandTotal = 0.0;
                 	catCount = 0;
                 	cats = Budget_Category[Budget == vBudgetId];
                 	for each  cat in cats
                 	{
                 		catTotal = 0.0;
                 		catItems = Budget_Item[Budget_Category == cat.ID];
                 		for each  it in catItems
                 		{
                 			itemTotal = ifnull(it.Budget_Ttl,0.0);
                 			modRows = Budget_Modification[Budget_Item == it.ID && Status == "Approved"];
                 			for each  mr in modRows
                 			{
                 				amt = ifnull(mr.Amount,0.0);
                 				if(ifnull(mr.Modification_Type,"") == "Decrease")
                 				{
                 					itemTotal = itemTotal - amt;
                 				}
                 				else
                 				{
                 					itemTotal = itemTotal + amt;
                 				}
                 			}
                 			catTotal = catTotal + itemTotal;
                 		}
                 		cat.Modified_Final_Total=catTotal;
                 		grandTotal = grandTotal + catTotal;
                 		catCount = catCount + 1;
                 	}
                 	budgetRec.Modified_Final_Grand_Total=grandTotal;
                 	return "Modified Final updated for budget " + vBudgetId + " (" + catCount + " categories, grand total " + grandTotal + ").";
                 }
				 string recalcItemRevisedFinal(int itemId)
                 {
                 	/********* RECALC REVISED FINAL — ONE ITEM *********/
                 	// Revised_Final = Budget_Ttl + sum of APPROVED Budget_Modification amounts
                 	// (Increase positive, Decrease negative). Called after modification
                 	// approval and from the nightly batch recalc.
                 	vItemId = itemId.toLong();
                 	if(vItemId == 0)
                 	{
                 		return "No Item ID provided.";
                 	}
                 	itemRec = Budget_Item[ID == vItemId];
                 	if(itemRec == null)
                 	{
                 		return "Budget Item not found.";
                 	}
                 	approvedSum = 0.0;
                 	modRows = Budget_Modification[Budget_Item == vItemId && Status == "Approved"];
                 	for each  mr in modRows
                 	{
                 		amt = ifnull(mr.Amount,0.0);
                 		if(ifnull(mr.Modification_Type,"") == "Decrease")
                 		{
                 			approvedSum = approvedSum - amt;
                 		}
                 		else
                 		{
                 			approvedSum = approvedSum + amt;
                 		}
                 	}
                 	itemRec.Revised_Final=ifnull(itemRec.Budget_Ttl,0.0) + approvedSum;
                 	return "Revised Final updated for item " + vItemId + ".";
                 }
				 string reportProformaWidgetError(string payload)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(payload == null || payload.toString().trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("error","No error-report payload was supplied.");
                 			return result.toString();
                 		}
                 		data = payload.toString().toMap();
                 		reportId = ifnull(data.get("reportId"),"").toString().trim();
                 		subjectText = ifnull(data.get("subject"),"[Pro Forma Widget Error]").toString().trim();
                 		bodyText = ifnull(data.get("body"),"").toString();
                 		if(subjectText == "")
                 		{
                 			subjectText = "[Pro Forma Widget Error]";
                 		}
                 		if(bodyText == "")
                 		{
                 			bodyText = "The widget submitted an empty error body.\n\nRaw payload:\n" + payload.toString();
                 		}
                 		sendmail
                 		[
                 			from :"Notifications@wbdevelopment.com"
                 			to :"rbelliveau@wbdevelopment.com"
                 			subject :subjectText
                 			message :bodyText
                 		]
                 		result.put("success",true);
                 		result.put("reportId",reportId);
                 		result.put("recipient","rbelliveau@wbdevelopment.com");
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("error",e.toString());
                 	}
                 	return result.toString();
                 }
				 map resolveApprovalRoute(map context)
                 {
                 	result = {"success":false,"contract":"approval-policy-v1"};
                 	try 
                 	{
                 		for each  identityField in {"companyId","submitterId"}
                 		{
                 			typedIdentity = Map();
                 			typedIdentity.put("value",context.get(identityField));
                 			if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 			{
                 				result.put("error","Company and submitter IDs must be strings.");
                 				return result;
                 			}
                 		}
                 		workflows = {"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
                 		if(!workflows.contains(context.get("workflow")))
                 		{
                 			result.put("error","Workflow is invalid.");
                 			return result;
                 		}
                 		companyText = ifnull(context.get("companyId"),"").toString();
                 		submitterText = ifnull(context.get("submitterId"),"").toString();
                 		amountText = thisapp.poCurrencyString(ifnull(context.get("amount"),"").toString());
                 		typedAmount = Map();
                 		typedAmount.put("value",context.get("amount"));
                 		if(context.get("workflow") == "Pro Forma" || context.get("workflow") == "Contract")
                 		{
                 			amountText = "0.00";
                 			typedAmount.put("value","0.00");
                 		}
                 		if(amountText == "" || !typedAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
                 		{
                 			result.put("error","Company, submitter identity and an exact amount are required.");
                 			return result;
                 		}
                 		territory = ifnull(context.get("territory"),"").toString();
                 		department = ifnull(context.get("department"),"").toString();
                 		day = context.get("effectiveDate").toString().toDate("yyyy-MM-dd");
                 		if(day.toString("yyyy-MM-dd") != context.get("effectiveDate"))
                 		{
                 			result.put("error","Effective date is invalid.");
                 			return result;
                 		}
                 		amount = amountText.replaceAll("[.]","").toLong();
                 		policyId = 0;
                 		bestRank = -1;
                 		matched = 0;
                 		for each  policy in Approval_Policy[Workflow == context.get("workflow") && Status == "Published"]
                 		{
                 			if(policy.Company != companyText.toLong() && context.get("workflow") != "Purchase Order" || policy.Company != null)
                 			{
                 				continue;
                 			}
                 			valid = policy.Effective_From == null || policy.Effective_From <= day && policy.Effective_To == null || day < policy.Effective_To;
                 			pTerritory = ifnull(policy.Territory_Key,"");
                 			pDepartment = ifnull(policy.Department_Key,"");
                 			if(valid && pTerritory == "" || pTerritory == territory && pDepartment == "" || pDepartment == department)
                 			{
                 				rank = 0;
                 				if(policy.Company != null)
                 				{
                 					rank = rank + 8;
                 				}
                 				if(pTerritory != "")
                 				{
                 					rank = rank + 4;
                 				}
                 				if(pDepartment != "")
                 				{
                 					rank = rank + 2;
                 				}
                 				if(rank > bestRank)
                 				{
                 					bestRank = rank;
                 					policyId = policy.ID;
                 					matched = 1;
                 				}
                 				else if(rank == bestRank)
                 				{
                 					matched = matched + 1;
                 				}
                 			}
                 		}
                 		if(matched != 1)
                 		{
                 			result.put("error","Published policy is missing or ambiguous at the highest applicable scope.");
                 			return result;
                 		}
                 		policy = Approval_Policy[ID == policyId];
                 		if(policy.Version == null || policy.Version < 1)
                 		{
                 			result.put("error","Published policy version is invalid.");
                 			return result;
                 		}
                 		if(policy.Enabled != true)
                 		{
                 			result.put("error","The applicable published policy is disabled. No company fallback was used.");
                 			return result;
                 		}
                 		if((policy.Self_Approval != "Allow" && policy.Self_Approval != "Deny") || (policy.Duplicate_Person != "Separate steps" && policy.Duplicate_Person != "Reject"))
                 		{
                 			result.put("error","Self-approval and multiple-role rules must be explicitly configured.");
                 			return result;
                 		}
                 		if(policy.Workflow == "Purchase Order" && policy.Self_Approval != "Deny" || policy.Duplicate_Person != "Reject")
                 		{
                 			result.put("error","Purchase Orders require distinct approvers and forbid submitter self-approval.");
                 			return result;
                 		}
                 		steps = policy.Steps_JSON.toJSONList();
                 		if(steps.size() == 0 || steps.size() > 30)
                 		{
                 			result.put("error","Published policy requires 1–30 ordered steps.");
                 			return result;
                 		}
                 		route = List();
                 		excluded = List();
                 		people = List();
                 		stepKeys = List();
                 		expectedOrder = 0;
                 		for each  step in steps
                 		{
                 			expectedOrder = expectedOrder + 1;
                 			if(!ifnull(step.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || step.get("order") != expectedOrder || stepKeys.contains(step.get("key")))
                 			{
                 				result.put("error","Policy steps have duplicate keys or invalid sequential order.");
                 				return result;
                 			}
                 			typedRole = Map();
                 			typedRole.put("value",step.get("roleId"));
                 			if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 			{
                 				result.put("error","Step role ID must be a string.");
                 				return result;
                 			}
                 			stepKeys.add(step.get("key"));
                 			condition = step.get("condition");
                 			if(policy.Workflow == "Pro Forma" || policy.Workflow == "Contract" && condition != "Always")
                 			{
                 				result.put("error","Pro Forma and Contract use straight approval chains without amount thresholds.");
                 				return result;
                 			}
                 			applies = step.get("enabled") == true;
                 			reason = "Required step";
                 			if(step.get("enabled") != true && step.get("enabled") != false)
                 			{
                 				result.put("error","Step enabled state is not explicit.");
                 				return result;
                 			}
                 			if(condition == "Above" || condition == "At or above")
                 			{
                 				thresholdText = thisapp.poCurrencyString(ifnull(step.get("threshold"),"").toString());
                 				typedThreshold = Map();
                 				typedThreshold.put("value",step.get("threshold"));
                 				if(thresholdText == "" || !typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
                 				{
                 					result.put("error","Conditional threshold must be an exact currency string.");
                 					return result;
                 				}
                 				threshold = thresholdText.replaceAll("[.]","").toLong();
                 				if(condition == "Above" && amount <= threshold)
                 				{
                 					applies = false;
                 				}
                 				if(condition == "At or above" && amount < threshold)
                 				{
                 					applies = false;
                 				}
                 				reason = amountText + " is " + condition.toLowerCase() + " " + thresholdText;
                 			}
                 			else if(condition == "Budget modification attached")
                 			{
                 				if(policy.Workflow != "Purchase Order")
                 				{
                 					result.put("error","Linked budget modification conditions belong to Purchase Orders.");
                 					return result;
                 				}
                 				if(context.get("hasBudgetModification") != true && context.get("hasBudgetModification") != false)
                 				{
                 					result.put("error","Linked PO budget modification context is required.");
                 					return result;
                 				}
                 				if(context.get("hasBudgetModification") != true)
                 				{
                 					applies = false;
                 				}
                 				reason = "A budget modification is linked to this PO";
                 			}
                 			else if(condition == "Budget line exceeded")
                 			{
                 				if(policy.Workflow != "Purchase Order" || (context.get("hasBudgetOverrun") != true && context.get("hasBudgetOverrun") != false))
                 				{
                 					result.put("error","An explicit PO budget-line overrun context is required.");
                 					return result;
                 				}
                 				if(context.get("hasBudgetOverrun") != true)
                 				{
                 					applies = false;
                 				}
                 				reason = "At least one PO budget item exceeds its available budget";
                 			}
                 			else if(condition != "Always")
                 			{
                 				result.put("error","Unsupported step condition.");
                 				return result;
                 			}
                 			if(applies != true)
                 			{
                 				excludedReason = condition + " threshold is not met";
                 				if(condition == "Budget modification attached")
                 				{
                 					excludedReason = "No budget modification is linked to this PO";
                 				}
                 				if(condition == "Budget line exceeded")
                 				{
                 					excludedReason = "All PO budget items are within their available budgets";
                 				}
                 				if(step.get("enabled") == false)
                 				{
                 					excludedReason = "Disabled";
                 				}
                 				excluded.add({"key":step.get("key"),"reason":excludedReason});
                 			}
                 			else
                 			{
                 				roleText = step.get("roleId").toString();
                 				role = Approval_Role[ID == roleText.toLong()];
                 				if(role.ID == null || role.Active != true)
                 				{
                 					result.put("error","Role is missing or inactive for step " + expectedOrder);
                 					return result;
                 				}
                 				assignmentId = 0;
                 				assignmentRank = -1;
                 				assignmentCount = 0;
                 				personId = 0;
                 				assignmentActive = false;
                 				territoryVP = policy.Workflow == "Purchase Order" && role.Role_Name == "VP";
                 				if(territoryVP)
                 				{
                 					territoryRecord = Territory[Territory_Name == territory];
                 					if(territoryRecord.count() != 1)
                 					{
                 						result.put("error","The PO territory must identify one Territory record with a VP.");
                 						return result;
                 					}
                 					vpIds = List();
                 					for each  vpPerson in territoryRecord.VP
                 					{
                 						if(!vpIds.contains(vpPerson.ID))
                 						{
                 							vpIds.add(vpPerson.ID);
                 						}
                 					}
                 					if(vpIds.size() != 1)
                 					{
                 						result.put("error","Configure exactly one VP on the PO Territory record.");
                 						return result;
                 					}
                 					personId = vpIds.get(0);
                 					assignmentActive = true;
                 				}
                 				else
                 				{
                 					for each  assignment in Approval_Role_Assignment[Role == role.ID]
                 					{
                 						if(assignment.Company != companyText.toLong() && policy.Workflow != "Purchase Order" || assignment.Company != null)
                 						{
                 							continue;
                 						}
                 						aTerritory = ifnull(assignment.Territory_Key,"");
                 						aDepartment = ifnull(assignment.Department_Key,"");
                 						aValid = assignment.Effective_From == null || assignment.Effective_From <= day && assignment.Effective_To == null || day < assignment.Effective_To;
                 						if(aValid && aTerritory == "" || aTerritory == territory && aDepartment == "" || aDepartment == department)
                 						{
                 							rank = 0;
                 							if(assignment.Company != null)
                 							{
                 								rank = rank + 8;
                 							}
                 							if(aTerritory != "")
                 							{
                 								rank = rank + 4;
                 							}
                 							if(aDepartment != "")
                 							{
                 								rank = rank + 2;
                 							}
                 							if(rank > assignmentRank)
                 							{
                 								assignmentRank = rank;
                 								assignmentId = assignment.ID;
                 								assignmentCount = 1;
                 							}
                 							else if(rank == assignmentRank)
                 							{
                 								assignmentCount = assignmentCount + 1;
                 							}
                 						}
                 					}
                 					if(assignmentCount != 1)
                 					{
                 						result.put("error","Assignment for " + role.Role_Name + " is missing or ambiguous at the highest applicable scope.");
                 						return result;
                 					}
                 					assignment = Approval_Role_Assignment[ID == assignmentId];
                 					personId = assignment.Person;
                 					assignmentActive = assignment.Active == true;
                 				}
                 				person = User_Access[ID == personId];
                 				email = ifnull(person.Approver_Email,"").trim();
                 				if(assignmentActive != true || person.ID == null || person.Approval_Routing_Enabled != true || person.User == null || !email.matches("[^ @]+@[^ @]+[.][^ @]+"))
                 				{
                 					result.put("error","Approver for " + role.Role_Name + " is inactive or has no valid Approver Email.");
                 					return result;
                 				}
                 				if(policy.Self_Approval == "Deny" && person.ID.toString() == submitterText)
                 				{
                 					result.put("error","Policy forbids submitter self-approval.");
                 					return result;
                 				}
                 				if(policy.Duplicate_Person == "Reject" && people.contains(person.ID.toString()))
                 				{
                 					result.put("error","One person fills multiple required roles; this policy rejects the overlap.");
                 					return result;
                 				}
                 				people.add(person.ID.toString());
                 				assignmentText = assignmentId.toString();
                 				if(territoryVP)
                 				{
                 					assignmentText = "";
                 				}
                 				route.add({"order":route.size() + 1,"policyStepOrder":expectedOrder,"key":step.get("key"),"roleId":role.ID.toString(),"role":role.Role_Name,"assignmentId":assignmentText,"userAccessId":person.ID.toString(),"name":ifnull(person.Full_Name,""),"email":email,"reason":reason});
                 			}
                 		}
                 		if(route.size() == 0)
                 		{
                 			result.put("error","No enabled applicable approval steps.");
                 			return result;
                 		}
                 		result.put("snapshot",{"policyId":policy.ID.toString(),"policyVersion":policy.Version,"context":context,"route":route,"excluded":excluded,"selfApproval":policy.Self_Approval,"duplicatePerson":policy.Duplicate_Person});
                 		result.put("success",true);
                 	}	catch (e)
                 	{
                 		result.put("error","Approval configuration is invalid. Check scope, versions, ordered steps and exact amounts.");
                 	}
                 	return result;
                 }
				 string Review_LOI_Request(string proformaId, string tokenId, string decision, string legalNote)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		if(ifnull(decision,"").trim().toUpperCase() == "CHECK_REJECT")
                 		{
                 			checkStatus = ifnull(pf.LOI_Legal_Status,"").trim();
                 			checkNote = ifnull(legalNote,"").trim();
                 			checkToken = ifnull(tokenId,"").trim();
                 			if(checkStatus == "Pending Approval" && checkToken == "" || checkToken != ifnull(pf.LOI_Approval_Token,"").trim())
                 			{
                 				result.put("success",false);
                 				result.put("message","The LOI approval token is invalid or expired.");
                 				return result.toString();
                 			}
                 			if(checkStatus == "Rejected" && checkNote == "" || checkNote != ifnull(pf.LOI_Legal_Note,"").trim())
                 			{
                 				result.put("success",false);
                 				result.put("message","The rejection note did not match this LOI.");
                 				return result.toString();
                 			}
                 			result.put("success",true);
                 			result.put("proformaId",pf.ID.toString());
                 			result.put("status",checkStatus);
                 			result.put("noteMatches",checkStatus == "Rejected" && checkNote == ifnull(pf.LOI_Legal_Note,"").trim());
                 			result.put("tokenCleared",ifnull(pf.LOI_Approval_Token,"").trim() == "");
                 			return result.toString();
                 		}
                 		if(ifnull(pf.LOI_Legal_Status,"") != "Pending Approval")
                 		{
                 			result.put("success",false);
                 			result.put("message","This LOI is no longer pending Legal approval.");
                 			result.put("status",ifnull(pf.LOI_Legal_Status,""));
                 			return result.toString();
                 		}
                 		if(tokenId == null || tokenId.trim() == "" || ifnull(pf.LOI_Approval_Token,"") != tokenId.trim())
                 		{
                 			result.put("success",false);
                 			result.put("message","The LOI approval token is invalid or expired.");
                 			return result.toString();
                 		}
                 		decisionValue = ifnull(decision,"").trim().toUpperCase();
                 		noteValue = ifnull(legalNote,"").trim();
                 		if(decisionValue == "REJECT")
                 		{
                 			if(noteValue == "")
                 			{
                 				result.put("success",false);
                 				result.put("message","Enter a Legal note before rejecting the LOI.");
                 				return result.toString();
                 			}
                 			pf.LOI_Legal_Status="Rejected";
                 			pf.LOI_Legal_Note=noteValue;
                 			pf.LOI_Approval_Token="";
                 			notificationSent = false;
                 			if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 			{
                 				sendmail
                 				[
                 					from :"Notifications@wbdevelopment.com"
                 					to :pf.Acquisition_Email
                 					subject :"LOI Rejected by Legal - " + ifnull(pf.Name,"Pro Forma")
                 					message :"Legal rejected the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b>.<br><br><b>Legal note:</b><br>" + noteValue
                 				]
                 				notificationSent = true;
                 			}
                 			result.put("success",true);
                 			result.put("decision","REJECT");
                 			result.put("message","LOI rejected and returned to the Pro Forma.");
                 			result.put("proformaId",pf.ID.toString());
                 			result.put("notificationSent",notificationSent);
                 			result.put("notificationAddress",ifnull(pf.Acquisition_Email,"").trim());
                 			return result.toString();
                 		}
                 		if(decisionValue != "APPROVE")
                 		{
                 			result.put("success",false);
                 			result.put("message","Decision must be APPROVE or REJECT.");
                 			return result.toString();
                 		}
                 		// Call the existing function that generates the Writer document,
                 		// creates/reuses the Acquisition Contract, and attaches Attachment.
                 		contractResultText = thisapp.Create_LOI_Contract(proformaId);
                 		contractResult = contractResultText.toMap();
                 		contractSuccess = contractResult.get("success");
                 		if(contractSuccess != true && contractSuccess.toString() != "true")
                 		{
                 			result.put("success",false);
                 			result.put("message",ifnull(contractResult.get("message"),"Create_LOI_Contract did not complete successfully."));
                 			result.put("contractResult",contractResult);
                 			return result.toString();
                 		}
                 		contractIdText = contractResult.get("contractId").toString();
                 		pf.LOI_Legal_Status="Approved";
                 		pf.LOI_Legal_Note=noteValue;
                 		pf.LOI_Approval_Token="";
                 		pf.LOI_Contract=contractIdText.toLong();
                 		if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :pf.Acquisition_Email
                 				subject :"LOI Approved by Legal - " + ifnull(pf.Name,"Pro Forma")
                 				message :"Legal approved the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b> and Contract <b>" + contractIdText + "</b> was created.<br><br><b>Legal note:</b><br>" + if(noteValue == "","No note entered.",noteValue)
                 			]
                 		}
                 		result.put("success",true);
                 		result.put("decision","APPROVE");
                 		result.put("message","LOI approved and Contract created.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("contractId",contractIdText);
                 		result.put("contractVersionId",contractResult.get("contractVersionId"));
                 		result.put("contractUrl",contractResult.get("contractUrl"));
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI review failed at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		return result.toString();
                 	}
                 	return "nice";
                 }
				 string sendApprovalEmail(int budgetId, int approvalId)
                 {
                 	/********* SEND ONE APPROVAL EMAIL *********/
                 	// Return Type: string
                 	// Sends the approval email for one specific Budget_Approvals row.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalId = approvalId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalId == 0)
                 	{
                 		return "No Approval ID provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	approvalRows = Budget_Approvals[ID == vApprovalId];
                 	if(approvalRows.count() == 0)
                 	{
                 		return "Approval row not found.";
                 	}
                 	approvalRec = null;
                 	for each  ar in approvalRows
                 	{
                 		approvalRec = ar;
                 	}
                 	approverEmail = ifnull(approvalRec.Approver,"").trim();
                 	approvalRole = ifnull(approvalRec.Title,"").trim();
                 	approvalType = ifnull(approvalRec.Type1,"").trim();
                 	if(approvalType == "Purchase Order")
                 	{
                 		return "Purchase Orders use the combined PO email. Open the PO to check or retry its notification.";
                 	}
                 	approvalSortOrder = ifnull(approvalRec.Sort_Order,0).toLong();
                 	if(approverEmail == "")
                 	{
                 		return "No approver email found for " + approvalType + " " + approvalRole + ".";
                 	}
                 	if(approvalRole == "")
                 	{
                 		return "No approval role found.";
                 	}
                 	if(approvalType == "")
                 	{
                 		return "No approval type found.";
                 	}
                 	// ============================================================
                 	// FIND THE APPROVAL NOTES THAT SHOULD APPEAR IN THIS EMAIL
                 	//
                 	// Forward approval:
                 	//     Pull notes from the immediately previous approved row.
                 	//
                 	// Rejection:
                 	//     Pull notes from the immediately next rejected row.
                 	// ============================================================
                 	previousApprovalRec = null;
                 	nextApprovalRec = null;
                 	previousSortOrder = -1;
                 	nextSortOrder = 999999;
                 	trackApprovalRows = Budget_Approvals[Budget == vBudgetId && Type1 == approvalType];
                 	for each  trackRow in trackApprovalRows
                 	{
                 		trackSortOrder = ifnull(trackRow.Sort_Order,0).toLong();
                 		if(trackSortOrder < approvalSortOrder && trackSortOrder > previousSortOrder)
                 		{
                 			previousApprovalRec = trackRow;
                 			previousSortOrder = trackSortOrder;
                 		}
                 		if(trackSortOrder > approvalSortOrder && trackSortOrder < nextSortOrder)
                 		{
                 			nextApprovalRec = trackRow;
                 			nextSortOrder = trackSortOrder;
                 		}
                 	}
                 	approvalNotes = "";
                 	notesSourceRole = "";
                 	notesHeading = "Approval Notes";
                 	notesContext = "";
                 	// Check rejection first because the email is being routed backward.
                 	if(nextApprovalRec != null && ifnull(nextApprovalRec.Status,"").trim() == "Rejected")
                 	{
                 		approvalNotes = ifnull(nextApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(nextApprovalRec.Title,"").trim();
                 		notesHeading = "Rejection Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the rejecting approver";
                 		}
                 	}
                 	else if(previousApprovalRec != null && ifnull(previousApprovalRec.Status,"").trim() == "Approved")
                 	{
                 		approvalNotes = ifnull(previousApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(previousApprovalRec.Title,"").trim();
                 		notesHeading = "Approval Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the previous approver";
                 		}
                 	}
                 	else
                 	{
                 		notesContext = "No previous approval response";
                 	}
                 	if(approvalNotes == "")
                 	{
                 		approvalNotes = "No notes were provided.";
                 	}
                 	// Basic HTML escaping for approval notes.
                 	approvalNotesSafe = approvalNotes;
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("&","&amp;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("<","&lt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll(">","&gt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\r\n","<br>");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\n","<br>");
                 	notesHeadingSafe = notesHeading;
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("&","&amp;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("<","&lt;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll(">","&gt;");
                 	notesContextSafe = notesContext;
                 	notesContextSafe = notesContextSafe.replaceAll("&","&amp;");
                 	notesContextSafe = notesContextSafe.replaceAll("<","&lt;");
                 	notesContextSafe = notesContextSafe.replaceAll(">","&gt;");
                 	// Internal app URL for the Budget Management page hosting the widget.
                 	widgetPageUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Budget_Management1";
                 	// Verified sender for all approval emails.
                 	fromAddress = "jking@wbdevelopment.com";
                 	// Build budget display info.
                 	budgetName = ifnull(budgetRec.Budget_Name,"Budget Review");
                 	projectName = ifnull(budgetRec.Project,"");
                 	phaseName = ifnull(budgetRec.Phase,"");
                 	subdivisionCode = ifnull(budgetRec.Subdivision_Code,"");
                 	subdivisionName = "";
                 	territoryText = "";
                 	if(budgetRec.Subdivision1 != null)
                 	{
                 		subdivisionName = ifnull(budgetRec.Subdivision1.Subdivision_Name,"");
                 		territoryText = ifnull(budgetRec.Subdivision1.Territory,"");
                 	}
                 	budgetLabel = budgetName;
                 	if(projectName != "" && phaseName != "")
                 	{
                 		budgetLabel = projectName + " - " + phaseName + " - " + budgetName;
                 	}
                 	else if(projectName != "")
                 	{
                 		budgetLabel = projectName + " - " + budgetName;
                 	}
                 	if(subdivisionName != "")
                 	{
                 		budgetLabel = subdivisionName + " - " + budgetName;
                 	}
                 	// Basic HTML escaping.
                 	budgetLabelSafe = budgetLabel;
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("&","&amp;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("<","&lt;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll(">","&gt;");
                 	subdivisionCodeSafe = subdivisionCode;
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("&","&amp;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("<","&lt;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll(">","&gt;");
                 	territorySafe = territoryText;
                 	territorySafe = territorySafe.replaceAll("&","&amp;");
                 	territorySafe = territorySafe.replaceAll("<","&lt;");
                 	territorySafe = territorySafe.replaceAll(">","&gt;");
                 	// Deep link to the widget page, opening directly to this budget.
                 	approvalUrl = widgetPageUrl + "?budgetId=" + vBudgetId;
                 	emailSubject = approvalType + " Budget Approval Needed - " + budgetLabel;
                 	emailBody = "";
                 	emailBody = emailBody + "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 	emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Approval Needed</h2>";
                 	emailBody = emailBody + "<p style='margin:0 0 16px 0;'>A <b>" + approvalType + "</b> budget approval is ready for your review as <b>" + approvalRole + "</b>.</p>";
                 	// Budget information card.
                 	emailBody = emailBody + "<div style='background:#f8fafc;border:1px solid #dbe4f0;border-radius:10px;padding:14px 16px;margin:0 0 14px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;color:#64748b;margin-bottom:4px;'>Budget</div>";
                 	emailBody = emailBody + "<div style='font-size:16px;font-weight:700;color:#0f2744;'>" + budgetLabelSafe + "</div>";
                 	if(subdivisionCodeSafe != "" || territorySafe != "")
                 	{
                 		emailBody = emailBody + "<div style='margin-top:10px;font-size:13px;color:#475569;'>";
                 		if(subdivisionCodeSafe != "")
                 		{
                 			emailBody = emailBody + "<b>Subdivision Code:</b> " + subdivisionCodeSafe;
                 		}
                 		if(subdivisionCodeSafe != "" && territorySafe != "")
                 		{
                 			emailBody = emailBody + " &nbsp; | &nbsp; ";
                 		}
                 		if(territorySafe != "")
                 		{
                 			emailBody = emailBody + "<b>Territory:</b> " + territorySafe;
                 		}
                 		emailBody = emailBody + "</div>";
                 	}
                 	emailBody = emailBody + "</div>";
                 	// Approval or rejection notes card.
                 	emailBody = emailBody + "<div style='background:#fffdf5;border:1px solid #e7d9a8;border-left:4px solid #c79a22;border-radius:10px;padding:14px 16px;margin:0 0 18px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;font-weight:700;color:#785b12;margin-bottom:2px;'>" + notesHeadingSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:12px;color:#8a6d22;margin-bottom:8px;'>" + notesContextSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:14px;color:#334155;white-space:normal;'>" + approvalNotesSafe + "</div>";
                 	emailBody = emailBody + "</div>";
                 	emailBody = emailBody + "<a href='" + approvalUrl + "' style='display:inline-block;background:#1e40af;color:#ffffff;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;'>Open Approval Page</a>";
                 	emailBody = emailBody + "<p style='margin:18px 0 0 0;font-size:12px;color:#64748b;'>If the button does not work, copy and paste this link into your browser:<br>";
                 	emailBody = emailBody + "<span style='word-break:break-all;color:#1e40af;'>" + approvalUrl + "</span></p>";
                 	emailBody = emailBody + "</div>";
                 	sendmail
                 	[
                 		from :fromAddress
                 		to :approverEmail
                 		subject :emailSubject
                 		message :emailBody
                 	]
                 	// Mark sent date after successful send.
                 	approvalRec.Sent_Date=zoho.currentdate;
                 	return "Email sent to " + approverEmail + " for " + approvalType + " " + approvalRole + ".";
                 }
				 string sendApprovalReminders()
                 {
                 	/********* PENDING APPROVAL REMINDERS *********/
                 	// Return Type: string
                 	// Runs daily from a schedule.
                 	//
                 	// Two passes:
                 	//   1. CONTRACT approvals - every Contract_Approvals row still Awaiting
                 	//      Approval whose own Next_Reminder_Date has arrived gets the styled
                 	//      approval email again (Send_Contract_Approval_Email in "Reminder"
                 	//      mode, which re-stamps Last/Next_Reminder_Date from the row's
                 	//      Reminder_Interval_Days). This pass runs EVERY day: the cadence lives
                 	//      on each row, not on Settings.
                 	//   2. BUDGET / PRO FORMA / MODIFICATION approvals - unchanged: does nothing
                 	//      until Settings.Next_Approval_Reminder_Date has arrived, then re-sends
                 	//      for every Budget_Approvals row still Pending and pushes the next date
                 	//      out by Settings.Approval_Reminder_Interval_Days (default 3).
                 	//
                 	// Every run that sends anything emails rbelliveau@wbdevelopment.com a recap
                 	// table (type, recipient, role, item). A day with nothing due stays silent.
                 	today = zoho.currentdate;
                 	tdStyle = "padding:6px 10px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#0f2744;";
                 	thStyle = "padding:7px 10px;text-align:left;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#5c7394;border-bottom:2px solid #cbd5e1;";
                 	/********* PASS 1: CONTRACT APPROVALS *********/
                 	contractCount = 0;
                 	contractFailed = 0;
                 	contractRows = "";
                 	dueContractApprovals = Contract_Approvals[Status == "Awaiting Approval" && Next_Reminder_Date <= today && Contract1 != null];
                 	for each  ca in dueContractApprovals
                 	{
                 		ctResp = thisapp.Send_Contract_Approval_Email(ca.Contract1.ID.toString(),ca.ID.toString(),"Reminder");
                 		if(ifnull(ctResp.get("success"),false) == true)
                 		{
                 			contractCount = contractCount + 1;
                 			itemLabel = ifnull(ca.Contract1.Contract_Name,"").trim();
                 			if(itemLabel == "")
                 			{
                 				itemLabel = "Contract " + ca.Contract1.ID;
                 			}
                 			contractRows = contractRows + "<tr><td style='" + tdStyle + "'>Contract</td><td style='" + tdStyle + "'>" + ifnull(ca.Approver,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ca.Type1,"") + "</td><td style='" + tdStyle + "'>" + itemLabel + "</td></tr>";
                 		}
                 		else
                 		{
                 			contractFailed = contractFailed + 1;
                 			contractRows = contractRows + "<tr><td style='" + tdStyle + "color:#b91c1c;'>Contract (failed)</td><td style='" + tdStyle + "'>" + ifnull(ca.Approver,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ca.Type1,"") + "</td><td style='" + tdStyle + "'>" + ifnull(ctResp.get("message"),"") + "</td></tr>";
                 		}
                 	}
                 	/********* PASS 2: BUDGET / PRO FORMA / MODIFICATION (Settings gate) *********/
                 	settingsRec = Settings[ID != 0];
                 	if(settingsRec == null)
                 	{
                 		return "No Settings record found.";
                 	}
                 	vInterval = ifnull(settingsRec.Approval_Reminder_Interval_Days,0).toLong();
                 	if(vInterval <= 0)
                 	{
                 		vInterval = 3;
                 	}
                 	vNext = settingsRec.Next_Approval_Reminder_Date;
                 	budgetDue = true;
                 	notDueNote = "";
                 	if(vNext == null)
                 	{
                 		// First run: arm the schedule without blasting reminders immediately.
                 		settingsRec.Next_Approval_Reminder_Date=today.addDay(vInterval);
                 		budgetDue = false;
                 		notDueNote = "Budget reminder date was empty; armed for " + today.addDay(vInterval).toString() + ".";
                 	}
                 	else if(vNext > today)
                 	{
                 		budgetDue = false;
                 		notDueNote = "Budget reminders not due yet. Next reminder " + vNext.toString() + ".";
                 	}
                 	budgetCount = 0;
                 	proformaCount = 0;
                 	modCount = 0;
                 	skipped = 0;
                 	recapRows = "";
                 	newNext = vNext;
                 	if(budgetDue)
                 	{
                 		pendingRows = Budget_Approvals[Status == "Pending"];
                 		for each  row in pendingRows
                 		{
                 			rowType = ifnull(row.Type1,"").trim();
                 			if(rowType == "Purchase Order")
                 			{
                 				continue;
                 			}
                 			approverEmail = ifnull(row.Approver,"").trim();
                 			approverRole = ifnull(row.Title,"").trim();
                 			sentThis = false;
                 			displayType = rowType;
                 			itemLabel = "";
                 			if(rowType == "Modification")
                 			{
                 				if(row.Budget_Modification != null)
                 				{
                 					modMsg = thisapp.sendModificationEmail(row.Budget_Modification.ID,"created");
                 					modCount = modCount + 1;
                 					sentThis = true;
                 					itemLabel = ifnull(row.Budget_Modification.Reference_Number,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Modification " + row.Budget_Modification.ID;
                 					}
                 					if(row.Budget != null)
                 					{
                 						itemLabel = itemLabel + " (" + ifnull(row.Budget.Budget_Name,"") + ")";
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			else if(rowType == "Pro Forma")
                 			{
                 				if(row.Proforma != null)
                 				{
                 					pfMsg = thisapp.Send_Proforma_Approval_Email(row.Proforma.ID.toString(),row.ID.toString());
                 					proformaCount = proformaCount + 1;
                 					sentThis = true;
                 					itemLabel = ifnull(row.Proforma.Name,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Pro Forma " + row.Proforma.ID;
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			else
                 			{
                 				if(row.Budget != null)
                 				{
                 					budgetMsg = thisapp.sendApprovalEmail(row.Budget.ID,row.ID);
                 					budgetCount = budgetCount + 1;
                 					sentThis = true;
                 					if(displayType == "")
                 					{
                 						displayType = "Budget";
                 					}
                 					itemLabel = ifnull(row.Budget.Budget_Name,"").trim();
                 					if(itemLabel == "")
                 					{
                 						itemLabel = "Budget " + row.Budget.ID;
                 					}
                 				}
                 				else
                 				{
                 					skipped = skipped + 1;
                 				}
                 			}
                 			if(sentThis)
                 			{
                 				recapRows = recapRows + "<tr><td style='" + tdStyle + "'>" + displayType + "</td><td style='" + tdStyle + "'>" + approverEmail + "</td><td style='" + tdStyle + "'>" + approverRole + "</td><td style='" + tdStyle + "'>" + itemLabel + "</td></tr>";
                 			}
                 		}
                 		newNext = today.addDay(vInterval);
                 		settingsRec.Next_Approval_Reminder_Date=newNext;
                 	}
                 	/********* RECAP *********/
                 	totalSent = budgetCount + proformaCount + modCount + contractCount;
                 	if(totalSent == 0 && contractFailed == 0)
                 	{
                 		if(budgetDue)
                 		{
                 			// Due day with nothing pending: say so, as before.
                 			recapBody = "<div style='font-family:Arial,Helvetica,sans-serif;'>";
                 			recapBody = recapBody + "<h3 style='margin:0 0 4px 0;color:#0b2345;'>Approval reminders " + today.toString() + "</h3>";
                 			recapBody = recapBody + "<p style='margin:0 0 14px 0;font-size:13px;color:#475569;'>No pending approvals needed reminders. Next budget reminder " + newNext.toString() + ".</p></div>";
                 			sendmail
                 			[
                 				from :"jking@wbdevelopment.com"
                 				to :"rbelliveau@wbdevelopment.com"
                 				subject :"Approval reminders: nothing to send"
                 				message :recapBody
                 			]
                 			return "OK: nothing to send. Next budget reminder " + newNext.toString() + ".";
                 		}
                 		return notDueNote + " No contract reminders were due.";
                 	}
                 	skippedNote = "";
                 	if(skipped > 0)
                 	{
                 		skippedNote = " " + skipped + " pending row(s) were skipped (missing linked record).";
                 	}
                 	if(contractFailed > 0)
                 	{
                 		skippedNote = skippedNote + " " + contractFailed + " contract reminder(s) failed to send.";
                 	}
                 	recapBody = "<div style='font-family:Arial,Helvetica,sans-serif;'>";
                 	recapBody = recapBody + "<h3 style='margin:0 0 4px 0;color:#0b2345;'>Approval reminders " + today.toString() + "</h3>";
                 	summaryLine = totalSent + " reminder(s) - contracts " + contractCount + ", budgets " + budgetCount + ", pro formas " + proformaCount + ", modifications " + modCount + "." + skippedNote;
                 	if(budgetDue)
                 	{
                 		summaryLine = summaryLine + " Next budget reminder " + newNext.toString() + ".";
                 	}
                 	else
                 	{
                 		summaryLine = summaryLine + " " + notDueNote;
                 	}
                 	recapBody = recapBody + "<p style='margin:0 0 14px 0;font-size:13px;color:#475569;'>" + summaryLine + "</p>";
                 	recapBody = recapBody + "<table style='border-collapse:collapse;width:100%;max-width:720px;'><tr><th style='" + thStyle + "'>Type</th><th style='" + thStyle + "'>Sent To</th><th style='" + thStyle + "'>Role / Step</th><th style='" + thStyle + "'>Item</th></tr>";
                 	recapBody = recapBody + contractRows + recapRows + "</table></div>";
                 	emailSubject = "Approval reminders sent: " + totalSent + " (contracts " + contractCount + ", budgets " + budgetCount + ", pro formas " + proformaCount + ", mods " + modCount + ")";
                 	sendmail
                 	[
                 		from :"jking@wbdevelopment.com"
                 		to :"rbelliveau@wbdevelopment.com"
                 		subject :emailSubject
                 		message :recapBody
                 	]
                 	return "OK: reminders sent - contracts=" + contractCount + ", budgets=" + budgetCount + ", proformas=" + proformaCount + ", modifications=" + modCount + ", skipped=" + skipped + ", contractFailed=" + contractFailed + ".";
                 }
				 string sendModificationEmail(int modificationId, string action)
                 {
                 	/********* BUDGET MODIFICATION EMAIL *********/
                 	// Return Type: string
                 	// Sends the email that accompanies a Budget Modification lifecycle event.
                 	// action: "created" | "approved" | "rejected"
                 	// Approval rows live in Budget_Approvals with Type1 == "Modification" and a
                 	// Budget_Modification lookup back to the modification record.
                 	vModId = modificationId.toLong();
                 	vAction = ifnull(action,"").trim().toLowerCase();
                 	if(vModId == 0)
                 	{
                 		return "No Modification ID provided.";
                 	}
                 	if(vAction != "created" && vAction != "approved" && vAction != "rejected")
                 	{
                 		return "Unknown action: " + vAction;
                 	}
                 	modRec = Budget_Modification[ID == vModId];
                 	if(ifnull(modRec.Reference_Number,"").startsWith("PO:"))
                 	{
                 		return "ERROR: This modification uses the combined Purchase Order approval chain.";
                 	}
                 	if(modRec == null)
                 	{
                 		return "Modification not found.";
                 	}
                 	// Self-heal: an emailed modification is by definition in the approval flow.
                 	if(vAction == "created" && ifnull(modRec.Status,"") != "Submitted")
                 	{
                 		modRec.Status="Submitted";
                 	}
                 	// ---- Modification display data ----
                 	modType = ifnull(modRec.Modification_Type,"").trim();
                 	modAmount = ifnull(modRec.Amount,0.0);
                 	modReason = ifnull(modRec.Reason,"").trim();
                 	modRef = ifnull(modRec.Reference_Number,"").trim();
                 	itemName = "";
                 	if(modRec.Budget_Item != null)
                 	{
                 		itemName = ifnull(modRec.Budget_Item.Item_Name,"");
                 	}
                 	budgetLabel = "";
                 	vBudgetId = 0;
                 	if(modRec.Budget != null)
                 	{
                 		budgetLabel = ifnull(modRec.Budget.Budget_Name,"");
                 		vBudgetId = modRec.Budget.ID;
                 	}
                 	signPrefix = "+";
                 	if(modType == "Decrease")
                 	{
                 		signPrefix = "-";
                 	}
                 	amountText = signPrefix + "$" + modAmount.toString();
                 	// ---- HTML escaping ----
                 	itemNameSafe = itemName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	budgetLabelSafe = budgetLabel.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	modReasonSafe = modReason.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	modReasonSafe = modReasonSafe.replaceAll("\r\n","<br>").replaceAll("\n","<br>");
                 	modRefSafe = modRef.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 	if(modReasonSafe == "")
                 	{
                 		modReasonSafe = "No reason was provided.";
                 	}
                 	// ---- Chain rows for this modification ----
                 	nextApprovalRec = null;
                 	nextSortOrder = 999999;
                 	approvedRoles = "";
                 	chainRows = Budget_Approvals[Budget_Modification == vModId && Type1 == "Modification"];
                 	for each  chainRow in chainRows
                 	{
                 		rowStatus = ifnull(chainRow.Status,"").trim();
                 		rowSort = ifnull(chainRow.Sort_Order,0).toLong();
                 		candidateStatus = rowStatus == "Pending" || rowStatus == "Not Sent";
                 		if(candidateStatus && rowSort < nextSortOrder)
                 		{
                 			nextApprovalRec = chainRow;
                 			nextSortOrder = rowSort;
                 		}
                 		if(rowStatus == "Approved")
                 		{
                 			if(approvedRoles != "")
                 			{
                 				approvedRoles = approvedRoles + ", ";
                 			}
                 			approvedRoles = approvedRoles + ifnull(chainRow.Title,"");
                 		}
                 	}
                 	// Internal app URL for the Budget Management page hosting the widget.
                 	widgetPageUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Budget_Management1";
                 	approvalUrl = widgetPageUrl + "?budgetId=" + vBudgetId + "&modificationId=" + vModId;
                 	// Verified sender for all approval emails.
                 	fromAddress = "jking@wbdevelopment.com";
                 	// ---- Shared detail card ----
                 	detailCard = "<div style='background:#f8fafc;border:1px solid #dbe4f0;border-radius:10px;padding:14px 16px;margin:0 0 14px 0;'>";
                 	detailCard = detailCard + "<div style='font-size:13px;color:#64748b;margin-bottom:4px;'>Budget Modification</div>";
                 	detailCard = detailCard + "<div style='font-size:16px;font-weight:700;color:#0f2744;'>" + budgetLabelSafe + " &mdash; " + itemNameSafe + "</div>";
                 	detailCard = detailCard + "<div style='margin-top:10px;font-size:14px;color:#334155;'><b>" + modType + ":</b> " + amountText;
                 	if(modRefSafe != "")
                 	{
                 		detailCard = detailCard + " &nbsp; | &nbsp; <b>Reference:</b> " + modRefSafe;
                 	}
                 	detailCard = detailCard + "</div>";
                 	detailCard = detailCard + "<div style='margin-top:8px;font-size:13px;color:#475569;'><b>Reason:</b> " + modReasonSafe + "</div>";
                 	detailCard = detailCard + "</div>";
                 	linkBlock = "<a href='" + approvalUrl + "' style='display:inline-block;background:#1e40af;color:#ffffff;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;'>Open Budget Page</a>";
                 	linkBlock = linkBlock + "<p style='margin:18px 0 0 0;font-size:12px;color:#64748b;'>If the button does not work, copy and paste this link into your browser:<br>";
                 	linkBlock = linkBlock + "<span style='word-break:break-all;color:#1e40af;'>" + approvalUrl + "</span></p>";
                 	// ---- created / approved: notify the next pending approver ----
                 	if(vAction == "created" || vAction == "approved")
                 	{
                 		if(nextApprovalRec != null)
                 		{
                 			approverEmail = ifnull(nextApprovalRec.Approver,"").trim();
                 			approverRole = ifnull(nextApprovalRec.Title,"").trim();
                 			if(approverEmail == "")
                 			{
                 				return "No approver email found for the next Modification approval.";
                 			}
                 			emailSubject = "Modification Approval Needed - " + budgetLabel + " - " + itemName;
                 			emailBody = "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 			emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Modification Approval Needed</h2>";
                 			emailBody = emailBody + "<p style='margin:0 0 16px 0;'>An after-finalization <b>budget modification</b> is ready for your review as <b>" + approverRole + "</b>.</p>";
                 			emailBody = emailBody + detailCard + linkBlock + "</div>";
                 			sendmail
                 			[
                 				from :fromAddress
                 				to :approverEmail
                 				subject :emailSubject
                 				message :emailBody
                 			]
                 			nextApprovalRec.Status="Pending";
                 			nextApprovalRec.Sent_Date=zoho.currentdate;
                 			return "Modification email sent to " + approverEmail + " (" + approverRole + ").";
                 		}
                 		if(vAction == "approved")
                 		{
                 			// No pending approver remains: the chain is complete.
                 			modRec.Status="Approved";
                 			modRec.Approved_On=zoho.currenttime;
                 			modRec.Approved_By=approvedRoles;
                 			// Roll the newly approved delta into the item's Revised_Final field.
                 			if(modRec.Budget_Item != null)
                 			{
                 				recalcMsg = thisapp.recalcItemRevisedFinal(modRec.Budget_Item.ID);
                 			}
                 			// Roll it up to the category + budget Modified Final totals.
                 			if(vBudgetId != 0)
                 			{
                 				rollupMsg = thisapp.recalcBudgetModifiedTotals(vBudgetId);
                 			}
                 			return "Modification fully approved (" + approvedRoles + ").";
                 		}
                 		return "No approver rows found for this modification.";
                 	}
                 	// ---- rejected: stamp the record and notify approvers who had approved ----
                 	if(vAction == "rejected")
                 	{
                 		modRec.Status="Rejected";
                 		notifiedList = "";
                 		for each  chainRow2 in chainRows
                 		{
                 			rowStatus2 = ifnull(chainRow2.Status,"").trim();
                 			rowEmail2 = ifnull(chainRow2.Approver,"").trim();
                 			if(rowStatus2 == "Approved" && rowEmail2 != "")
                 			{
                 				emailSubject2 = "Modification Rejected - " + budgetLabel + " - " + itemName;
                 				emailBody2 = "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 				emailBody2 = emailBody2 + "<h2 style='margin:0 0 8px 0;color:#8f221c;'>Budget Modification Rejected</h2>";
                 				emailBody2 = emailBody2 + "<p style='margin:0 0 16px 0;'>A budget modification you had approved was <b>rejected</b> later in the chain.</p>";
                 				emailBody2 = emailBody2 + detailCard + linkBlock + "</div>";
                 				sendmail
                 				[
                 					from :fromAddress
                 					to :rowEmail2
                 					subject :emailSubject2
                 					message :emailBody2
                 				]
                 				if(notifiedList != "")
                 				{
                 					notifiedList = notifiedList + ", ";
                 				}
                 				notifiedList = notifiedList + rowEmail2;
                 			}
                 		}
                 		if(notifiedList == "")
                 		{
                 			return "Modification marked Rejected. No prior approvers to notify.";
                 		}
                 		return "Modification marked Rejected. Notified: " + notifiedList + ".";
                 	}
                 	return "No action taken.";
                 }
				 string sendPurchaseOrderEmail(string purchaseOrderId)
                 {
                 	try 
                 	{
                 		checked = thisapp.poApprovalBundle(purchaseOrderId);
                 		if(checked.get("success") != true)
                 		{
                 			return "ERROR: " + checked.get("error");
                 		}
                 		bundle = checked.get("bundle");
                 		active = bundle.get("active");
                 		if(active.get("id") == null)
                 		{
                 			return "ERROR: No active Purchase Order approver.";
                 		}
                 		approval = Budget_Approvals[ID == active.get("id").toLong()];
                 		if(approval.Sent_Date != null)
                 		{
                 			return "OK: Approval email already recorded.";
                 		}
                 		po = Payment_Request[ID == purchaseOrderId.toLong()];
                 		if(po.PO_Approval_State != "Pending" || approval.Status != "Pending")
                 		{
                 			return "ERROR: PO approval state changed before notification.";
                 		}
                 		vendor = ifnull(po.Vendor.Vendor_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		phase = ifnull(po.Budget.Budget_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		body = "<div style='font-family:Arial,sans-serif;color:#0b2345;line-height:1.5'><h2>Purchase Order Approval</h2><p><b>" + phase + "</b><br>Vendor: " + vendor + "<br>PO: " + purchaseOrderId + "<br>Amount: $" + po.PO_Amount_Exact + "<br>Request date: " + po.Request_Date.toString("yyyy-MM-dd") + "<br>Date needed: " + po.Date_Needed.toString("yyyy-MM-dd") + "</p><table style='border-collapse:collapse;width:100%;font-size:12px'><tr style='background:#edf4ff'><th align='left'>Cost code / budget item</th><th align='left'>Description</th><th>Quantity</th><th>UOM</th><th>Unit price</th><th>Total</th></tr>";
                 		for each  line in PO_Item[Purchase_Order == po.ID && Revision == po.PO_Revision] sort by Line_Order
                 		{
                 			itemName = ifnull(line.Budget_Item.Item_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			note = ifnull(line.Description,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll("\n","<br>");
                 			body = body + "<tr><td style='padding:9px;border-bottom:1px solid #d5e1ee'><b>" + ifnull(line.Cost_Code,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;") + "</b><br>" + itemName + "</td><td>" + note + "</td><td align='right'>" + ifnull(line.Quantity_Exact,"—") + "</td><td align='center'>" + ifnull(line.UOM,"—") + "</td><td align='right'>" + ifnull(line.Unit_Price_Exact,"—") + "</td><td align='right'>$" + line.Final_Amount_Exact + "</td></tr>";
                 		}
                 		body = body + "</table><h3>Budget Modifications</h3>";
                 		if(bundle.get("modifications").size() == 0)
                 		{
                 			body = body + "<p>No budget modifications required.</p>";
                 		}
                 		for each  modification in bundle.get("modifications")
                 		{
                 			item = Budget_Item[ID == modification.get("budgetItemId").toLong()];
                 			name = ifnull(item.Item_Name,"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			body = body + "<p>" + name + " · +$" + modification.get("amount") + " · Modification " + modification.get("id") + "</p>";
                 		}
                 		body = body + "<h3>Approval chain</h3><ol>";
                 		for each  step in bundle.get("rows")
                 		{
                 			safeRole = step.get("role").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			safeNotes = step.get("notes").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			body = body + "<li>" + safeRole + " · " + step.get("status") + if(safeNotes == "","","<br>" + safeNotes) + "</li>";
                 		}
                 		url = zoho.appuri + "#Page:Budget_Management1?budgetId=" + po.Budget.toString() + "&purchaseOrderId=" + purchaseOrderId;
                 		body = body + "</ol><p><a href='" + url + "'>Review and approve PO and all modifications</a></p></div>";
                 		sendmail
                 		[
                 			from :"jking@wbdevelopment.com"
                 			to :approval.Approver
                 			subject :"Purchase Order Approval · " + ifnull(po.Budget.Budget_Name,"") + " · $" + po.PO_Amount_Exact
                 			message :body
                 		]
                 		approval.Sent_Date=zoho.currentdate;
                 		if(approval.Sent_Date == null)
                 		{
                 			return "ERROR: Email delivery stamp could not be verified.";
                 		}
                 		return "OK: Combined PO approval email recorded.";
                 	}	catch (emailError)
                 	{
                 		return "ERROR: Combined approval email delivery could not be verified.";
                 	}
                 	return "ERROR: Combined approval email did not finish.";
                 }
				 string Send_Contract_Approvals(string contractId)
                 {
                 	/*  Custom API behind the widget's "Send for Approvals" button.
                 
                 	    Request body (JSON POST):  {"contractId":"<Contract.ID>","user":"name@wbdevelopment.com"}
                 	    Also accepts a bare id when called with thisapp.Send_Contract_Approvals(id).
                 
                 	    A Custom API runs as the publishing admin, so the caller's identity comes
                 	    in the body (the same way Get_User_Access_DEV receives it) and is checked
                 	    against Edit Contracts or Edit Owned Contracts and Actions plus the
                 	    Contract.Owner lookup. Completed contracts remain read-only.
                 
                 	    What it does, per approver whose Email switch is on and who is still
                 	    Not Sent:
                 	      - sends the styled approval email (Send_Contract_Approval_Email), with
                 	        every Attachment whose Email_Attachment is checked attached
                 	      - Status -> Awaiting Approval, Reject_Reason cleared,
                 	        Last/Next_Reminder_Date stamped
                 	    Then Contract.Status -> Awaiting Approvals and Current_Approver -> the
                 	    lowest-sequence approver just emailed.
                 
                 	    Unlike the old "Send for Approvals - Contracts" report action this does
                 	    NOT clear Approval_Email after sending: Status is the gate, so the Email
                 	    switch in the widget keeps meaning "this person is on the email".
                 
                 	    Response (JSON string):
                 	      success      true when at least one email went out
                 	      sent         [approver emails]
                 	      skipped      ["email: reason", ...]
                 	      attachments  number of files attached
                 	      message      one line for the banner                                  */
                 	resp = Map();
                 	sentList = List();
                 	skippedList = List();
                 	raw = ifnull(contractId,"").toString().trim();
                 	cid = 0;
                 	requester = "";
                 	mode = "Send";
                 	targetIds = List();
                 	if(raw.startsWith("{"))
                 	{
                 		pm = raw.toMap();
                 		if(pm.get("contractId") != null)
                 		{
                 			cid = pm.get("contractId").toString().toLong();
                 		}
                 		if(pm.get("user") != null)
                 		{
                 			requester = pm.get("user").toString().trim();
                 		}
                 		if(pm.get("mode") != null)
                 		{
                 			mode = pm.get("mode").toString().trim();
                 		}
                 		if(pm.get("targetIds") != null)
                 		{
                 			targetIds = pm.get("targetIds");
                 		}
                 	}
                 	else if(raw != "")
                 	{
                 		cid = raw.toLong();
                 	}
                 	if(cid == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Missing contractId.");
                 		return resp.toString();
                 	}
                 	if(requester == "")
                 	{
                 		requester = zoho.loginuser;
                 	}
                 	accessRow = User_Access[User == requester];
                 	contract = Contract[ID == cid];
                 	if(contract.ID == null)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Contract not found.");
                 		return resp.toString();
                 	}
                 	ownedEdit = false;
                 	if(accessRow.ID != null && accessRow.Propose_Contract_Changes == true)
                 	{
                 		for each  ownerId in contract.Owner
                 		{
                 			if(ownerId == accessRow.ID)
                 			{
                 				ownedEdit = true;
                 			}
                 		}
                 	}
                 	if(accessRow.ID == null || (accessRow.Edit_Contracts != true && ownedEdit != true))
                 	{
                 		resp.put("success",false);
                 		resp.put("message","You need Edit Contracts permission or Edit Owned Contracts and Actions and to be added as an owner.");
                 		return resp.toString();
                 	}
                 	if(contract.Archive == true)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","This contract is archived. Unarchive it before sending for approvals.");
                 		return resp.toString();
                 	}
                 	if(ifnull(contract.Status,"").toString() == "Complete")
                 	{
                 		resp.put("success",false);
                 		resp.put("message","This contract is complete and locked.");
                 		return resp.toString();
                 	}
                 	// Reconcile only the approvers selected when the widget opened progress.
                 	// A repair emails an unsent target at most once and never replays a sent row.
                 	if(mode == "Check" || mode == "Repair")
                 	{
                 		if(targetIds.size() == 0)
                 		{
                 			resp.put("ok",false);
                 			resp.put("message","No approval rows were supplied for verification.");
                 			return resp.toString();
                 		}
                 		activeCount = 0;
                 		sentCount = 0;
                 		missingCount = 0;
                 		addresses = List();
                 		roles = List();
                 		for each  targetId in targetIds
                 		{
                 			targetRow = Contract_Approvals[ID == targetId.toString().toLong() && Contract1 == cid];
                 			if(targetRow.ID == null || targetRow.Approval_Email != true)
                 			{
                 				resp.put("ok",false);
                 				resp.put("message","A selected approver is missing or no longer enabled for email.");
                 				return resp.toString();
                 			}
                 			rowStatus = ifnull(targetRow.Status,"").toString().trim();
                 			if(mode == "Repair" && rowStatus == "Not Sent" || rowStatus == "" && targetRow.Last_Reminder_Date == null)
                 			{
                 				repairResult = thisapp.Send_Contract_Approval_Email(cid.toString(),targetRow.ID.toString(),"Send");
                 				if(ifnull(repairResult.get("success"),false) == true)
                 				{
                 					targetRow.Status="Awaiting Approval";
                 					targetRow.Reject_Reason=null;
                 					if(ifnull(contract.Status,"").toString() != "Awaiting Approvals")
                 					{
                 						contract.Status="Awaiting Approvals";
                 						contract.Current_Approver=ifnull(targetRow.Approver,"").toString();
                 					}
                 				}
                 				rowStatus = ifnull(targetRow.Status,"").toString().trim();
                 			}
                 			if(rowStatus == "Awaiting Approval")
                 			{
                 				activeCount = activeCount + 1;
                 				if(targetRow.Last_Reminder_Date != null)
                 				{
                 					sentCount = sentCount + 1;
                 				}
                 				else
                 				{
                 					missingCount = missingCount + 1;
                 				}
                 			}
                 			else
                 			{
                 				missingCount = missingCount + 1;
                 			}
                 			addresses.add(ifnull(targetRow.Approver,"").toString());
                 			roles.add(ifnull(targetRow.Type1,"").toString());
                 		}
                 		contract = Contract[ID == cid];
                 		resp.put("ok",true);
                 		resp.put("contractId",cid.toString());
                 		resp.put("parentStatus",ifnull(contract.Status,"").toString());
                 		resp.put("targetCount",targetIds.size());
                 		resp.put("activeCount",activeCount);
                 		resp.put("sentCount",sentCount);
                 		resp.put("missingCount",missingCount);
                 		resp.put("addresses",addresses);
                 		resp.put("roles",roles);
                 		return resp.toString();
                 	}
                 	attachedCount = Attachment[Contract1 == cid && Email_Attachment == true].count();
                 	if(attachedCount == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","Attach at least one file to the approval email (Attachments tab) before sending.");
                 		return resp.toString();
                 	}
                 	/* A blank Status counts as Not Sent: rows inserted through the Data API
                 	   (the widget's add-approver row before 1.60.4) never received the form's
                 	   initial value, so an exact match silently skipped them. */
                 	pending = Contract_Approvals[Contract1 == cid && Approval_Email == true && Status == "Not Sent" || Status == null || Status == ""] sort by Approval_Sequence;
                 	if(pending.count() == 0)
                 	{
                 		resp.put("success",false);
                 		resp.put("message","No approver is switched on for the email, or every switched-on approver has already been sent.");
                 		return resp.toString();
                 	}
                 	firstApprover = "";
                 	for each  row in pending
                 	{
                 		// A prior draft/restart may retain an old reminder stamp. The helper
                 		// creates fresh delivery evidence after sendmail succeeds.
                 		row.Last_Reminder_Date=null;
                 		emailResp = thisapp.Send_Contract_Approval_Email(cid.toString(),row.ID.toString(),"Send");
                 		if(ifnull(emailResp.get("success"),false) == true)
                 		{
                 			row.Status="Awaiting Approval";
                 			row.Reject_Reason=null;
                 			approverText = ifnull(row.Approver,"").toString();
                 			sentList.add(approverText);
                 			if(firstApprover == "")
                 			{
                 				firstApprover = approverText;
                 			}
                 		}
                 		else
                 		{
                 			skippedList.add(ifnull(row.Approver,"(no email)").toString() + ": " + ifnull(emailResp.get("message"),"send failed").toString());
                 		}
                 	}
                 	if(sentList.size() > 0)
                 	{
                 		contract.Status="Awaiting Approvals";
                 		contract.Current_Approver=firstApprover;
                 	}
                 	resp.put("success",sentList.size() > 0);
                 	resp.put("sent",sentList);
                 	resp.put("skipped",skippedList);
                 	resp.put("attachments",attachedCount);
                 	if(sentList.size() > 0)
                 	{
                 		msg = "Approval email sent to " + sentList.size() + " approver";
                 		if(sentList.size() != 1)
                 		{
                 			msg = msg + "s";
                 		}
                 		msg = msg + " with " + attachedCount + " file";
                 		if(attachedCount != 1)
                 		{
                 			msg = msg + "s";
                 		}
                 		msg = msg + ".";
                 		if(skippedList.size() > 0)
                 		{
                 			msg = msg + " " + skippedList.size() + " could not be sent.";
                 		}
                 		resp.put("message",msg);
                 	}
                 	else
                 	{
                 		resp.put("message","No approval email could be sent: " + skippedList.toString());
                 	}
                 	return resp.toString();
                 }
				 map Send_Contract_Approval_Email(string contractId, string approvalId, string mode)
                 {
                 	/*  One approval email for ONE Contract_Approvals row.
                 
                 	    Same shell as Send_Proforma_Approval_Email_With_Context: navy header with
                 	    the contract name, a "Current Step" badge, two summary panels (Contract
                 	    Overview / Approval Chain), an attachments block, and fixed-size
                 	    Approve / Reject / View buttons that survive Outlook.
                 
                 	    mode   "Send"      first send (from Send_Contract_Approvals)
                 	           "Reminder"  re-send from the daily sendApprovalReminders job
                 
                 	    Attaches every Attachment whose Email_Attachment is checked.
                 	    Stamps Last_Reminder_Date / Next_Reminder_Date on the approval row.
                 	    Does NOT change Status - the caller owns that.                          */
                 	response = Map();
                 	try 
                 	{
                 		contractIdText = ifnull(contractId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		modeText = ifnull(mode,"Send").toString().trim();
                 		if(contractIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Contract ID and approval ID are required.");
                 			return response;
                 		}
                 		contractIdLong = contractIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		contract = Contract[ID == contractIdLong];
                 		approvalRow = Contract_Approvals[ID == approvalIdLong];
                 		if(contract.ID == null || approvalRow.ID == null || approvalRow.Contract1 == null || approvalRow.Contract1.ID.toString() != contractIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Contract or approval row not found.");
                 			return response;
                 		}
                 		toAddress = ifnull(approvalRow.Approver,"").toString().trim();
                 		if(toAddress == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval step " + ifnull(approvalRow.Approval_Sequence,"").toString() + " has no approver email.");
                 			return response;
                 		}
                 		// ---------- attachments: every version flagged for the approval email ----------
                 		attachedFiles = Attachment[Contract1 == contractIdLong && Email_Attachment == true].File_field1.getAll();
                 		attachmentRows = "";
                 		attachmentCount = 0;
                 		versionRows = Attachment[Contract1 == contractIdLong && Email_Attachment == true] sort by Date_field1 desc;
                 		for each  versionRow in versionRows
                 		{
                 			fileName = ifnull(versionRow.File_field1,"").toString();
                 			if(fileName.contains("filepath="))
                 			{
                 				fileName = fileName.getSuffix("filepath=");
                 				if(fileName.contains("&"))
                 				{
                 					fileName = fileName.getPrefix("&");
                 				}
                 			}
                 			if(fileName.contains("/"))
                 			{
                 				fileName = fileName.subString(fileName.lastIndexOf("/") + 1);
                 			}
                 			if(fileName == "")
                 			{
                 				fileName = "Contract file";
                 			}
                 			safeFileName = fileName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			dateText = "";
                 			if(versionRow.Date_field1 != null)
                 			{
                 				dateText = " &nbsp;&middot;&nbsp; " + versionRow.Date_field1.toString("MMM d, yyyy");
                 			}
                 			attachmentRows = attachmentRows + "<div style='margin-top:4px;color:#172033;font-size:13px;'>&#128206; " + safeFileName + "<span style='color:#64748b;'>" + dateText + "</span></div>";
                 			attachmentCount = attachmentCount + 1;
                 		}
                 		// ---------- contract facts ----------
                 		contractName = ifnull(contract.Contract_Name,"Contract #" + contractIdText).toString();
                 		typeText = ifnull(contract.Contract_Type,"—").toString();
                 		builderText = "—";
                 		if(contract.Builder != null)
                 		{
                 			builderText = ifnull(contract.Builder.Builder_Name,"—").toString();
                 		}
                 		subdivisionText = "";
                 		if(contract.Subdivision1 != null)
                 		{
                 			for each  subId in contract.Subdivision1
                 			{
                 				subRec = Subdivision[ID == subId];
                 				if(subRec.ID != null)
                 				{
                 					subName = ifnull(subRec.Subdivision_Name,"").toString();
                 					if(subName != "")
                 					{
                 						subdivisionText = if(subdivisionText == "",subName,subdivisionText + ", " + subName);
                 					}
                 				}
                 			}
                 		}
                 		if(subdivisionText == "")
                 		{
                 			subdivisionText = "—";
                 		}
                 		territoryText = ifnull(contract.Territory,"—").toString();
                 		pointPersonText = "";
                 		if(contract.WBW_Point_Person != null)
                 		{
                 			for each  pp in contract.WBW_Point_Person
                 			{
                 				pointPersonText = if(pointPersonText == "",pp.toString(),pointPersonText + ", " + pp.toString());
                 			}
                 		}
                 		if(pointPersonText == "")
                 		{
                 			pointPersonText = "—";
                 		}
                 		lotsText = "—";
                 		if(contract.Number_of_Lots != null && contract.Number_of_Lots.toString() != "")
                 		{
                 			lotsText = contract.Number_of_Lots.toString() + " lots";
                 			if(contract.Initial_Takedown != null && contract.Initial_Takedown.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Initial_Takedown.toString() + " initial";
                 				if(contract.Initial_Takedown_Days != null && contract.Initial_Takedown_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " within " + contract.Initial_Takedown_Days.toString() + " days";
                 				}
                 			}
                 			if(contract.Second_Closing_Lots != null && contract.Second_Closing_Lots.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Second_Closing_Lots.toString() + " second";
                 				if(contract.Second_Closing_Days != null && contract.Second_Closing_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " " + contract.Second_Closing_Days.toString() + " days after initial due";
                 				}
                 			}
                 			if(contract.Subsequent_Takedown_Lots != null && contract.Subsequent_Takedown_Lots.toString() != "")
                 			{
                 				lotsText = lotsText + " &nbsp;&middot;&nbsp; " + contract.Subsequent_Takedown_Lots.toString() + " subsequent";
                 				if(contract.Subsequent_Takedown_Days != null && contract.Subsequent_Takedown_Days.toString() != "")
                 				{
                 					lotsText = lotsText + " every " + contract.Subsequent_Takedown_Days.toString() + " days";
                 				}
                 			}
                 		}
                 		earnestText = "—";
                 		if(contract.Earnest_Money != null && contract.Earnest_Money.toString() != "")
                 		{
                 			earnestText = thisapp.PF_Packet_Money(contract.Earnest_Money.toString());
                 		}
                 		totalPriceText = "—";
                 		if(contract.Total_Contract_Price != null && contract.Total_Contract_Price.toString() != "")
                 		{
                 			totalPriceText = thisapp.PF_Packet_Money(contract.Total_Contract_Price.toString());
                 		}
                 		initiatedByText = ifnull(contract.Modified_User,ifnull(contract.Added_User,"—")).toString();
                 		currentStepText = ifnull(approvalRow.Type1,"Approval").toString();
                 		stepNumberText = ifnull(approvalRow.Approval_Sequence,"").toString();
                 		// ---------- links (same public permalinks the report action uses) ----------
                 		approveUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/view-perma/Approvals_HTML_Page/4rmNhzWYQvp62uhC832KNqhvBkdfuCdHaTRuAkPzRZVemp6h2k4OGUgyyJrsAwM4DS53SHuuJpdy3Bk5DuKFbFqey0y4VyMMdZs3?recordID=" + approvalRow.ID.toString() + "&status=Approved";
                 		rejectUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/Contract_Approvals/record-edit/All_Contract_Approvals/" + approvalRow.ID.toString() + "/56FD5tkOEUKxhpxFhOkgQrUbN8yQVks7WpPAUU6R300UDB4bp59fsE4RDETy3Sp4yTUaMzeVmfY3OkmXRWSh3O2uXKn4pSrnGeOT";
                 		viewUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Form:Contract?recLinkID=" + contractIdText + "&viewLinkName=All_Contracts";
                 		// ---------- escape everything that came from a record ----------
                 		safeContractName = contractName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTypeText = typeText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeBuilderText = builderText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSubdivisionText = subdivisionText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTerritoryText = territoryText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safePointPersonText = pointPersonText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeInitiatedByText = initiatedByText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeCurrentStepText = currentStepText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		// ---------- subject ----------
                 		subjectPrefix = "Approval required";
                 		if(modeText == "Reminder")
                 		{
                 			subjectPrefix = "Reminder - approval still required";
                 		}
                 		subjectText = subjectPrefix + ": " + builderText + " " + currentStepText + " for " + subdivisionText;
                 		// ---------- panels ----------
                 		overviewRows = "";
                 		overviewRows = overviewRows + "<tr><td width='40%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Type</td><td width='60%' style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeTypeText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Subdivision</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeSubdivisionText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Counterparty</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeBuilderText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Territory</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeTerritoryText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Point Person</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safePointPersonText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Lots</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + lotsText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Earnest Money</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + earnestText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Total Price</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;border-bottom:1px solid #e5ebf3;'>" + totalPriceText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;'>Initiated By</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;'>" + safeInitiatedByText + "</td></tr>";
                 		chainRows = "";
                 		chain = Contract_Approvals[Contract1 == contractIdLong] sort by Approval_Sequence;
                 		for each  step in chain
                 		{
                 			stepStatus = ifnull(step.Status,"Not Sent").toString();
                 			stepColor = "#64748b";
                 			stepBg = "#eef2f7";
                 			stepLabel = stepStatus;
                 			if(stepStatus == "Approved")
                 			{
                 				stepColor = "#047857";
                 				stepBg = "#d1fae5";
                 				stepLabel = "&#10003; Approved";
                 			}
                 			else if(stepStatus == "Awaiting Approval")
                 			{
                 				stepColor = "#b45309";
                 				stepBg = "#fef3c7";
                 				stepLabel = "Awaiting";
                 			}
                 			else if(stepStatus == "Rejected")
                 			{
                 				stepColor = "#b91c1c";
                 				stepBg = "#fee2e2";
                 				stepLabel = "&#10005; Rejected";
                 			}
                 			stepApprover = ifnull(step.Approver,"—").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			stepType = ifnull(step.Type1,"").toString().replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 			stepSeq = ifnull(step.Approval_Sequence,"").toString();
                 			rowWeight = "600";
                 			rowMark = "";
                 			if(step.ID.toString() == approvalRow.ID.toString())
                 			{
                 				rowWeight = "800";
                 				rowMark = " <span style='font-size:10px;font-weight:800;color:#2563eb;'>&larr; YOU</span>";
                 			}
                 			chainRows = chainRows + "<tr><td width='22' style='padding:7px 0;color:#94a3b8;font-size:12px;border-bottom:1px solid #e5ebf3;'>" + stepSeq + "</td><td style='padding:7px 0 7px 6px;font-weight:" + rowWeight + ";color:#172033;font-size:13px;border-bottom:1px solid #e5ebf3;word-break:break-all;'>" + stepApprover + rowMark + "<div style='font-size:11px;color:#64748b;font-weight:500;'>" + stepType + "</div></td><td align='right' style='padding:7px 0 7px 8px;border-bottom:1px solid #e5ebf3;white-space:nowrap;'><span style='display:inline-block;padding:2px 8px;border-radius:999px;background:" + stepBg + ";color:" + stepColor + ";font-size:11px;font-weight:800;'>" + stepLabel + "</span></td></tr>";
                 		}
                 		summaryPanels = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;table-layout:fixed;'>" + "<tr>" + "<td width='50%' valign='top' style='padding-right:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Contract Overview</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + overviewRows + "</table></td></tr>" + "</table></td>" + "<td width='50%' valign='top' style='padding-left:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Approval Chain</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + chainRows + "</table></td></tr>" + "</table></td>" + "</tr></table>";
                 		attachmentBlock = "";
                 		if(attachmentCount > 0)
                 		{
                 			attachmentBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;'>" + "<div style='font-weight:700;color:#173b68;'>Attached for your review (" + attachmentCount + ")</div>" + attachmentRows + "</td></tr></table>";
                 		}
                 		else
                 		{
                 			attachmentBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;color:#92400e;font-size:13px;'>No contract file was attached to this email. Open the contract in Land Master to review the documents.</td></tr></table>";
                 		}
                 		reminderBlock = "";
                 		if(modeText == "Reminder")
                 		{
                 			reminderBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'>" + "<tr><td style='padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#9a3412;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;'>Reminder</div>" + "<div style='color:#431407;line-height:1.5;'>This approval has been waiting since " + ifnull(approvalRow.Last_Reminder_Date,zoho.currentdate).toString("MMM d, yyyy") + ". Your decision keeps the contract moving.</div>" + "</td></tr></table>";
                 		}
                 		// Fixed 120x42 button cells with bgcolor on the TD so Outlook keeps them as buttons.
                 		decisionButtons = "<table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:26px 0 14px;'><tr>" + "<td align='center' bgcolor='#047857' width='120' height='42' style='width:120px;height:42px;background-color:#047857;border:1px solid #065f46;border-radius:8px;'>" + "<a href='" + approveUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Approve</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#b42318' width='120' height='42' style='width:120px;height:42px;background-color:#b42318;border:1px solid #8f1d15;border-radius:8px;'>" + "<a href='" + rejectUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Reject</a>" + "</td>" + "<td width='14' style='width:14px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td align='center' bgcolor='#1e40af' width='120' height='42' style='width:120px;height:42px;background-color:#1e40af;border:1px solid #1e3a8a;border-radius:8px;'>" + "<a href='" + viewUrl + "' style='display:block;width:120px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>View</a>" + "</td>" + "</tr></table>";
                 		stepBadge = safeCurrentStepText;
                 		if(stepNumberText != "")
                 		{
                 			stepBadge = "Step " + stepNumberText + " &nbsp;&middot;&nbsp; " + safeCurrentStepText;
                 		}
                 		messageHtml = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='width:100%;background:#eef3fa;margin:0;padding:0;'>" + "<tr><td align='center' style='padding:24px 12px;'>" + "<table role='presentation' width='760' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:760px;background:#ffffff;border-collapse:separate;border-spacing:0;font-family:Arial,Helvetica,sans-serif;'>" + "<tr><td style='background:#102f55;color:#ffffff;padding:24px 26px;border-radius:15px 15px 0 0;border-bottom:4px solid #2563eb;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'><tr>" + "<td valign='bottom' style='padding-right:20px;'>" + "<div style='font-size:11px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.11em;font-weight:700;'>Contract Approval</div>" + "<div style='font-size:24px;font-weight:700;line-height:1.2;margin-top:7px;'>" + safeContractName + "</div>" + "<div style='font-size:13px;color:#c9d8eb;margin-top:8px;'>" + safeBuilderText + " &nbsp;&middot;&nbsp; " + safeSubdivisionText + "</div>" + "</td>" + "<td width='170' valign='bottom' align='right'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#173f6f;border:1px solid #315983;border-radius:10px;'>" + "<tr><td align='left' style='padding:10px 12px;'>" + "<div style='font-size:9px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.09em;font-weight:700;'>Current Step</div>" + "<div style='font-size:15px;color:#ffffff;font-weight:700;margin-top:4px;'>" + stepBadge + "</div>" + "</td></tr></table></td>" + "</tr></table></td></tr>" + "<tr><td style='padding:22px 24px 24px;border-left:1px solid #dce5f0;border-right:1px solid #dce5f0;border-bottom:1px solid #dce5f0;border-radius:0 0 15px 15px;'>" + "<p style='margin:0 0 8px;font-size:15px;color:#172033;'>The <b>" + safeCurrentStepText + "</b> approval for this contract is pending with you.</p>" + "<p style='margin:0;color:#475569;line-height:1.55;'>Review the attached contract documents and record your decision below. Reject opens a short form where a reason is required.</p>" + reminderBlock + summaryPanels + attachmentBlock + decisionButtons + "<div style='font-size:12px;color:#64748b;margin-top:8px;'>Approve records your response as soon as the page opens. Reject asks for a reason and returns the contract to Legal.</div>" + "<div style='margin-top:18px;padding-top:14px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;'>Already have Land Master access? <a href='" + viewUrl + "' style='color:#2563eb;text-decoration:none;font-weight:600;'>Open the full contract</a></div>" + "</td></tr></table></td></tr></table>";
                 		if(attachmentCount > 0)
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :toAddress
                 				subject :subjectText
                 				message :messageHtml
                 				Attachments :file:attachedFiles
                 			]
                 		}
                 		else
                 		{
                 			sendmail
                 			[
                 				from :"Notifications@wbdevelopment.com"
                 				to :toAddress
                 				subject :subjectText
                 				message :messageHtml
                 			]
                 		}
                 		// reminder cadence lives on the row: Reminder_Interval_Days (default 5)
                 		intervalDays = ifnull(approvalRow.Reminder_Interval_Days,5).toLong();
                 		if(intervalDays <= 0)
                 		{
                 			intervalDays = 5;
                 		}
                 		approvalRow.Last_Reminder_Date=zoho.currentdate;
                 		approvalRow.Next_Reminder_Date=zoho.currentdate.addDay(intervalDays);
                 		response.put("success",true);
                 		response.put("message","Approval email sent to " + toAddress + ".");
                 		response.put("approver",toAddress);
                 		response.put("attachmentCount",attachmentCount);
                 		response.put("nextReminder",zoho.currentdate.addDay(intervalDays).toString());
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 map Send_Proforma_Approval_Email(string proformaId, string approvalId)
                 {
                 	return thisapp.Send_Proforma_Approval_Email_With_Context(proformaId,approvalId,"Resent","","System");
                 }
				 map Send_Proforma_Approval_Email_With_Context(string proformaId, string approvalId, string routingAction, string routingNote, string routingRole)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		approvalRow = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null || approvalRow.ID == null || approvalRow.Proforma == null || approvalRow.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma or approval row not found.");
                 			return response;
                 		}
                 		toAddress = ifnull(approvalRow.Approver,"").toString().trim();
                 		if(toAddress == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","No email address is assigned to the " + ifnull(approvalRow.Title,"current").toString() + " approval.");
                 			return response;
                 		}
                 		completionEmail = ifnull(routingAction,"").toString() == "Completed";
                 		completionRecipients = List();
                 		completionRowsHtml = "";
                 		if(completionEmail)
                 		{
                 			completionRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			if(ifnull(pf.Status,"") != "Approved" || completionRows.count() == 0)
                 			{
                 				response.put("success",false);
                 				response.put("message","The Pro Forma is not fully approved.");
                 				return response;
                 			}
                 			for each  completionRow in completionRows
                 			{
                 				completionAddress = ifnull(completionRow.Approver,"").toString().trim().toLowerCase();
                 				if(ifnull(completionRow.Status,"") != "Approved" || completionAddress == "")
                 				{
                 					response.put("success",false);
                 					response.put("message","Every approval must be complete and have an email address before notifying all approvers.");
                 					return response;
                 				}
                 				if(completionRecipients.contains(completionAddress) == false)
                 				{
                 					completionRecipients.add(completionAddress);
                 				}
                 				completionRole = thisapp.PF_Packet_Escape(ifnull(completionRow.Title,"Approver").toString());
                 				completionAddressHtml = thisapp.PF_Packet_Escape(completionAddress);
