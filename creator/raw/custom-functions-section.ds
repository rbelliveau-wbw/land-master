		 functions
		 {
			 Deluge
			 {
				 string applyBudgetTrackFinalState(string budgetId, string approvalType, string action)
                 {
                 	/********* APPLY FINAL STATE TO ONE APPROVAL TRACK *********/
                 	// action values:
                 	// STAGE:
                 	//   Development = clear Final and refresh Unapproved from Preliminary.
                 	//   Construction = clear Final only; preserve externally populated Unapproved.
                 	// FINALIZE:
                 	//   Copy Unapproved into Final, then clear Unapproved to 0 for either track.
                 	// CLEAR:
                 	//   Clear Final for the selected track.
                 	//   Development also clears its workflow-owned Unapproved.
                 	//   Construction preserves externally populated Unapproved when killed/restarted.
                 	// CLEAR_FINAL:
                 	//   Clear Final only and preserve Unapproved for either track.
                 	vBudgetId = budgetId.toLong();
                 	vType = ifnull(approvalType,"").trim();
                 	vAction = ifnull(action,"").trim().toUpperCase();
                 	if(vBudgetId == 0)
                 	{
                 		return "{\"ok\":false,\"error\":\"Missing budgetId.\"}";
                 	}
                 	if(vType != "Development" && vType != "Construction")
                 	{
                 		return "{\"ok\":false,\"error\":\"approvalType must be Development or Construction.\"}";
                 	}
                 	if(vAction != "STAGE" && vAction != "FINALIZE" && vAction != "CLEAR" && vAction != "CLEAR_FINAL")
                 	{
                 		return "{\"ok\":false,\"error\":\"Invalid action.\"}";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
                 	}
                 	categoriesChanged = 0;
                 	itemsChanged = 0;
                 	allCategories = Budget_Category[Budget == vBudgetId];
                 	for each  ct in allCategories
                 	{
                 		deptName = ifnull(ct.Deparment,"").trim();
                 		isTargetCategory = false;
                 		if(vType == "Construction" && deptName == "Construction")
                 		{
                 			isTargetCategory = true;
                 		}
                 		else if(vType == "Development" && deptName == "Development" || deptName == "Engineering")
                 		{
                 			isTargetCategory = true;
                 		}
                 		if(isTargetCategory)
                 		{
                 			categoriesChanged = categoriesChanged + 1;
                 			trackItems = Budget_Item[Budget_Category == ct.ID];
                 			for each  it in trackItems
                 			{
                 				if(vAction == "STAGE")
                 				{
                 					// Starting/restarting either track always invalidates that track's Final.
                 					it.Budget_Ttl=0;
                 					if(vType == "Development")
                 					{
                 						// Dev/Eng approval values are staged from Preliminary.
                 						prelimValue = 0;
                 						if(it.Prelim_Budget_Ttl != null)
                 						{
                 							prelimValue = it.Prelim_Budget_Ttl;
                 						}
                 						it.Unapproved_Final_Budget_Ttl=prelimValue;
                 					}
                 					// Construction Unapproved is externally owned. Do not touch it.
                 				}
                 				else if(vAction == "FINALIZE")
                 				{
                 					finalValue = 0;
                 					if(it.Unapproved_Final_Budget_Ttl != null)
                 					{
                 						finalValue = it.Unapproved_Final_Budget_Ttl;
                 					}
                 					// Final is populated only when this track completes.
                 					it.Budget_Ttl=finalValue;
                 					// Once either track finishes, move Unapproved into Final and clear Unapproved.
                 					it.Unapproved_Final_Budget_Ttl=0;
                 				}
                 				else if(vAction == "CLEAR")
                 				{
                 					// Killing the selected chain invalidates only that track's Final.
                 					it.Budget_Ttl=0;
                 					if(vType == "Development")
                 					{
                 						// Dev/Eng Unapproved is workflow-owned.
                 						it.Unapproved_Final_Budget_Ttl=0;
                 					}
                 					// Construction Unapproved remains untouched.
                 				}
                 				else if(vAction == "CLEAR_FINAL")
                 				{
                 					it.Budget_Ttl=0;
                 				}
                 				itemsChanged = itemsChanged + 1;
                 			}
                 		}
                 	}
                 	// Rebuild all category Final totals and the budget Final grand total.
                 	// The already-approved opposite track remains included.
                 	grandFinal = 0;
                 	allCategoriesToRecalc = Budget_Category[Budget == vBudgetId];
                 	for each  rc in allCategoriesToRecalc
                 	{
                 		categoryFinal = Budget_Item[Budget_Category == rc.ID].sum(Budget_Ttl);
                 		if(categoryFinal == null)
                 		{
                 			categoryFinal = 0;
                 		}
                 		rc.Budget_Total=categoryFinal;
                 		grandFinal = grandFinal + categoryFinal;
                 	}
                 	budgetRec.Budget_Grand_Total=grandFinal;
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("approvalType",vType);
                 	resultMap.put("action",vAction);
                 	resultMap.put("categoriesChanged",categoriesChanged);
                 	resultMap.put("itemsChanged",itemsChanged);
                 	resultMap.put("budgetGrandFinal",grandFinal);
                 	return resultMap.toString();
                 }
				 map applySharedApprovalPolicy(map context)
                 {
                 	// Private initiation adapter. Existing entry points must authorize first.
                 	// Existing execution rows remain the only decision history.
                 	result = Map();
                 	result.put("success",false);
                 	result.put("shared",false);
                 	result.put("contract","approval-policy-v1");
                 	try 
                 	{
                 		workflow = context.get("workflow");
                 		if(workflow != "Budget" && workflow != "Budget Modification" && workflow != "Pro Forma")
                 		{
                 			result.put("error","This execution adapter supports Budget, Budget Modification and Pro Forma.");
                 			return result;
                 		}
                 		recordId = context.get("recordId").toString().toLong();
                 		track = ifnull(context.get("department"),"");
                 		ids = List();
                 		if(workflow == "Budget")
                 		{
                 			for each  budgetExecution in Budget_Approvals[Budget == recordId && Type1 == track] sort by Sort_Order
                 			{
                 				ids.add(budgetExecution.ID.toString());
                 			}
                 		}
                 		else if(workflow == "Budget Modification")
                 		{
                 			for each  modificationExecution in Budget_Approvals[Budget_Modification == recordId && Type1 == "Modification"] sort by Sort_Order
                 			{
                 				ids.add(modificationExecution.ID.toString());
                 			}
                 		}
                 		else
                 		{
                 			for each  proformaExecution in Budget_Approvals[Proforma == recordId] sort by Sort_Order
                 			{
                 				ids.add(proformaExecution.ID.toString());
                 			}
                 		}
                 		for each  existingId in ids
                 		{
                 			existingExecution = Budget_Approvals[ID == existingId.toLong()];
                 			// Templates initialize an untouched chain. Existing decisions and notes
                 			// continue through the original workflow with their original recipients.
                 			if(existingExecution.Status != "Not Sent" || existingExecution.Sent_Date != null || existingExecution.Responded_Date != null || ifnull(existingExecution.Approval_Notes,"").trim() != "")
                 			{
                 				result.put("shared",false);
                 				result.put("success",true);
                 				result.put("retainedExistingRoute",true);
                 				return result;
                 			}
                 		}
                 		companyText = ifnull(context.get("companyId"),"").toString();
                 		if(!companyText.matches("[0-9]+"))
                 		{
                 			result.put("success",true);
                 			return result;
                 		}
                 		territory = ifnull(context.get("territory"),"");
                 		department = ifnull(context.get("department"),"");
                 		day = context.get("effectiveDate").toDate("yyyy-MM-dd");
                 		bestRank = -1;
                 		matches = 0;
                 		selectedId = 0;
                 		for each  candidatePolicy in Approval_Policy[Workflow == workflow && Company == companyText.toLong() && Status == "Published"]
                 		{
                 			pTerritory = ifnull(candidatePolicy.Territory_Key,"");
                 			pDepartment = ifnull(candidatePolicy.Department_Key,"");
                 			effectiveValid = true;
                 			scopeValid = true;
                 			if(candidatePolicy.Effective_From != null && candidatePolicy.Effective_From > day)
                 			{
                 				effectiveValid = false;
                 			}
                 			if(candidatePolicy.Effective_To != null && day >= candidatePolicy.Effective_To)
                 			{
                 				effectiveValid = false;
                 			}
                 			if(pTerritory != "" && pTerritory != territory)
                 			{
                 				scopeValid = false;
                 			}
                 			if(pDepartment != "" && pDepartment != department)
                 			{
                 				scopeValid = false;
                 			}
                 			if(effectiveValid && scopeValid)
                 			{
                 				rank = 0;
                 				if(pTerritory != "")
                 				{
                 					rank = rank + 4;
                 				}
                 				if(pDepartment != "")
                 				{
                 					rank = rank + 2;
                 				}
                 				if(rank > bestRank)
                 				{
                 					bestRank = rank;
                 					matches = 1;
                 					selectedId = candidatePolicy.ID;
                 				}
                 				else if(rank == bestRank)
                 				{
                 					matches = matches + 1;
                 				}
                 			}
                 		}
                 		if(matches == 0)
                 		{
                 			result.put("success",true);
                 			return result;
                 		}
                 		if(matches != 1)
                 		{
                 			result.put("error","Published policy is ambiguous at the highest applicable scope.");
                 			return result;
                 		}
                 		selected = Approval_Policy[ID == selectedId];
                 		// Until one workflow passes its migration gate, retain its existing execution.
                 		if(selected.Adapter_Enabled != true)
                 		{
                 			result.put("success",true);
                 			return result;
                 		}
                 		result.put("shared",true);
                 		if(workflow == "Budget" && context.get("amountBasisConfirmed") != true)
                 		{
                 			for each  budgetTemplateStep in selected.Steps_JSON.toJSONList()
                 			{
                 				if(budgetTemplateStep.get("enabled") == true && budgetTemplateStep.get("condition") == "Above" || budgetTemplateStep.get("condition") == "At or above")
                 				{
                 					result.put("error","The Budget threshold amount basis must be confirmed before this template can start an approval chain.");
                 					return result;
                 				}
                 			}
                 		}
                 		resolved = thisapp.resolveApprovalRoute(context);
                 		if(resolved.get("success") != true)
                 		{
                 			result.put("error",resolved.get("error"));
                 			return result;
                 		}
                 		resolvedRoute = resolved.get("snapshot").get("route");
                 		if(workflow == "Pro Forma" && resolvedRoute.size() > 8)
                 		{
                 			result.put("error","Pro Forma execution supports up to 8 approval steps.");
                 			return result;
                 		}
                 		context.put("executionRows",ids);
                 		context.put("submissionRevision",zoho.currenttime.toString("yyyyMMddHHmmssSSS"));
                 		captured = thisapp.snapshotApprovalRoute(context);
                 		if(captured.get("success") != true)
                 		{
                 			result.put("error",captured.get("error"));
                 			return result;
                 		}
                 		route = captured.get("snapshot").get("route");
                 		boundIds = List();
                 		position = 0;
                 		for each  step in route
                 		{
                 			if(position < ids.size())
                 			{
                 				executionId = ids.get(position).toLong();
                 			}
                 			else
                 			{
                 				parentBudget = null;
                 				parentProforma = null;
                 				parentModification = null;
                 				executionType = track;
                 				if(workflow == "Budget")
                 				{
                 					parentBudget = recordId;
                 				}
                 				else if(workflow == "Budget Modification")
                 				{
                 					parentBudget = context.get("budgetId").toString().toLong();
                 					parentModification = recordId;
                 					executionType = "Modification";
                 				}
                 				else
                 				{
                 					parentProforma = recordId;
                 					executionType = "Pro Forma";
                 				}
                 				executionId = insert into Budget_Approvals
                 				[
                 					Added_User=zoho.loginuser
                 					Budget=parentBudget
                 					Proforma=parentProforma
                 					Budget_Modification=parentModification
                 					Type1=executionType
                 					Status="Not Sent"
                 					Sort_Order=step.get("order")
                 					Title=step.get("role")
                 					Approver=step.get("email")
                 				];
                 			}
                 			execution = Budget_Approvals[ID == executionId];
                 			execution.Title=step.get("role");
                 			execution.Approver=step.get("email");
                 			execution.Sort_Order=step.get("order");
                 			execution.Status="Not Sent";
                 			execution.Sent_Date=null;
                 			execution.Responded_Date=null;
                 			if(execution.ID == null || execution.Title != step.get("role") || execution.Approver != step.get("email") || execution.Sort_Order != step.get("order") || execution.Status != "Not Sent" || execution.Sent_Date != null || execution.Responded_Date != null)
                 			{
                 				result.put("error","Execution row readback differs. Do not send approval emails.");
                 				return result;
                 			}
                 			boundIds.add(execution.ID.toString());
                 			position = position + 1;
                 		}
                 		// Unused, untouched default rows have no approval history. Retain their
                 		// records and IDs in the snapshot, but detach them from this new chain.
                 		// The existing approval handlers therefore need no new status or branch.
                 		for each  unusedId in ids
                 		{
                 			if(!boundIds.contains(unusedId))
                 			{
                 				unusedExecution = Budget_Approvals[ID == unusedId.toLong()];
                 				unusedExecution.Budget=null;
                 				unusedExecution.Proforma=null;
                 				unusedExecution.Budget_Modification=null;
                 				if(unusedExecution.Budget != null || unusedExecution.Proforma != null || unusedExecution.Budget_Modification != null)
                 				{
                 					result.put("error","Unused default row could not be detached. Do not send approval emails.");
                 					return result;
                 				}
                 			}
                 		}
                 		result.put("snapshotId",captured.get("snapshotId"));
                 		result.put("executionRows",boundIds);
                 		result.put("success",true);
                 	}	catch (adapterError)
                 	{
                 		result.put("error","Policy execution could not be verified. Recheck the existing chain before sending emails.");
                 	}
                 	return result;
                 }
				 map approvalConfigurationSnapshot()
                 {
                 	result = {"success":false,"contract":"approval-policy-v1"};
                 	try 
                 	{
                 		roles = List();
                 		assignments = List();
                 		policies = List();
                 		users = List();
                 		companies = List();
                 		territories = List();
                 		for each  roleRow in Approval_Role[ID != 0]
                 		{
                 			roles.add({"id":roleRow.ID.toString(),"name":roleRow.Role_Name,"active":roleRow.Active});
                 		}
                 		for each  assignmentRow in Approval_Role_Assignment[ID != 0]
                 		{
                 			fromText = "";
                 			toText = "";
                 			if(assignmentRow.Effective_From != null)
                 			{
                 				fromText = assignmentRow.Effective_From.toString("yyyy-MM-dd");
                 			}
                 			if(assignmentRow.Effective_To != null)
                 			{
                 				toText = assignmentRow.Effective_To.toString("yyyy-MM-dd");
                 			}
                 			companyKey = "";
                 			if(assignmentRow.Company != null)
                 			{
                 				companyKey = assignmentRow.Company.toString();
                 			}
                 			assignments.add({"id":assignmentRow.ID.toString(),"roleId":assignmentRow.Role.toString(),"companyId":companyKey,"territory":ifnull(assignmentRow.Territory_Key,""),"department":ifnull(assignmentRow.Department_Key,""),"userAccessId":assignmentRow.Person.toString(),"active":assignmentRow.Active,"effectiveFrom":fromText,"effectiveTo":toText});
                 		}
                 		for each  policyRow in Approval_Policy[ID != 0]
                 		{
                 			fromText = "";
                 			toText = "";
                 			if(policyRow.Effective_From != null)
                 			{
                 				fromText = policyRow.Effective_From.toString("yyyy-MM-dd");
                 			}
                 			if(policyRow.Effective_To != null)
                 			{
                 				toText = policyRow.Effective_To.toString("yyyy-MM-dd");
                 			}
                 			companyKey = "";
                 			if(policyRow.Company != null)
                 			{
                 				companyKey = policyRow.Company.toString();
                 			}
                 			policies.add({"id":policyRow.ID.toString(),"companyId":companyKey,"workflow":policyRow.Workflow,"territory":ifnull(policyRow.Territory_Key,""),"department":ifnull(policyRow.Department_Key,""),"version":policyRow.Version,"status":policyRow.Status,"enabled":policyRow.Enabled,"selfApproval":policyRow.Self_Approval,"duplicatePerson":policyRow.Duplicate_Person,"effectiveFrom":fromText,"effectiveTo":toText,"steps":policyRow.Steps_JSON.toJSONList(),"adapterEnabled":policyRow.Adapter_Enabled});
                 		}
                 		for each  personRow in User_Access[ID != 0]
                 		{
                 			users.add({"id":personRow.ID.toString(),"user":ifnull(personRow.User,"").toString(),"name":ifnull(personRow.Full_Name,""),"approverEmail":ifnull(personRow.Approver_Email,""),"routingEnabled":personRow.Approval_Routing_Enabled == true});
                 		}
                 		for each  companyRow in Company[ID != 0]
                 		{
                 			companies.add({"id":companyRow.ID.toString(),"label":companyRow.Company_Name});
                 		}
                 		for each  territoryRow in Territory[ID != 0]
                 		{
                 			vpIds = List();
                 			for each  vpPerson in territoryRow.VP
                 			{
                 				if(!vpIds.contains(vpPerson.ID.toString()))
                 				{
                 					vpIds.add(vpPerson.ID.toString());
                 				}
                 			}
                 			territories.add({"id":territoryRow.Territory_Name,"label":territoryRow.Territory_Name,"vpUserAccessIds":vpIds});
                 		}
                 		auditRows = List();
                 		for each  event in Approval_Config_Audit[ID != 0]
                 		{
                 			beforeValue = Map();
                 			afterValue = Map();
                 			intendedValue = Map();
                 			if(ifnull(event.Before_JSON,"") != "")
                 			{
                 				beforeValue = event.Before_JSON.toMap();
                 			}
                 			if(ifnull(event.After_JSON,"") != "")
                 			{
                 				afterValue = event.After_JSON.toMap();
                 			}
                 			if(ifnull(event.Intended_JSON,"") != "")
                 			{
                 				intendedValue = event.Intended_JSON.toMap();
                 			}
                 			auditRows.add({"id":event.ID.toString(),"action":event.Action,"status":event.Status,"actorId":event.Actor.toString(),"before":beforeValue,"after":afterValue,"intended":intendedValue,"error":ifnull(event.Error_Text,"")});
                 		}
                 		result.put("configuration",{"roles":roles,"assignments":assignments,"policies":policies,"users":users,"companies":companies,"territories":territories,"audit":auditRows});
                 		result.put("canAdmin",zoho.loginuser == zoho.adminuser);
                 		result.put("success",true);
                 	}	catch (e)
                 	{
                 		result.put("error","Approval configuration cannot be read completely.");
                 	}
                 	return result;
                 }
				 string approvalWatchdog()
                 {
                 	/********* APPROVAL WATCHDOG *********/
                 	// Return Type: string
                 	// Sweeps every approval chain and repairs the ones that have stalled with no
                 	// active approver. Three separate approval systems share Budget_Approvals:
                 	//
                 	//   Budget tracks  - keyed by Budget + Type1 ("Development" / "Construction")
                 	//                    parent status: Add_Budget.Development_Budget_Approval_Status
                 	//                                   Add_Budget.Const_Budget_Approval_Status
                 	//   Pro Formas     - keyed by Proforma
                 	//                    parent status: Add_Pro_Forma.Status
                 	//   Modifications  - keyed by Budget_Modification
                 	//                    parent status: Budget_Modification.Status
                 	//
                 	// Rows are classified by WHICH LOOKUP IS POPULATED rather than by Type1, so a
                 	// blank or renamed Type1 cannot hide a whole chain from the sweep.
                 	//
                 	// Rejection semantics differ by system and the watchdog respects that:
                 	//   Budgets / Pro Formas - rejection bounces the chain back one step, so the
                 	//                          chain stays alive. A rejected chain with no pending
                 	//                          row means the bounce-back failed: reported, never
                 	//                          auto-repaired, because promoting the wrong row here
                 	//                          would re-open a decision somebody already made.
                 	//   Modifications        - rejection is terminal. Those are not stuck; they are
                 	//                          waiting on the submitter to revise and resubmit, and
                 	//                          are listed separately so they stay visible.
                 	//
                 	// Modification repairs delegate to sendModificationEmail, which already picks
                 	// the next approver, stamps the record and runs the Revised/Modified Final
                 	// rollups. Reusing it keeps one implementation of that logic.
                 	fromAddress = "rbelliveau@wbdevelopment.com";
                 	toAddress = "rbelliveau@wbdevelopment.com";
                 	/***************************************************************
                 	 * PASS 1: CLASSIFY AND COUNT EVERY APPROVAL ROW
                 	 ***************************************************************/
                 	keyList = List();
                 	kindMap = Map();
                 	parentMap = Map();
                 	trackMap = Map();
                 	totMap = Map();
                 	pendMap = Map();
                 	apprMap = Map();
                 	rejMap = Map();
                 	allRows = Budget_Approvals[ID != null];
                 	for each  r in allRows
                 	{
                 		rowKind = "";
                 		parentId = "";
                 		trk = "";
                 		if(r.Budget_Modification != null)
                 		{
                 			rowKind = "MOD";
                 			parentId = r.Budget_Modification.ID.toString();
                 		}
                 		else if(r.Proforma != null)
                 		{
                 			rowKind = "PF";
                 			parentId = r.Proforma.ID.toString();
                 		}
                 		else if(r.Budget != null)
                 		{
                 			trk = ifnull(r.Type1,"").trim();
                 			// Modification rows that lost their link are handled by the orphan
                 			// sweep below, not as a budget track.
                 			if(trk != "Development" && trk != "Construction")
                 			{
                 				continue;
                 			}
                 			rowKind = "BUD";
                 			parentId = r.Budget.ID.toString();
                 		}
                 		if(rowKind == "")
                 		{
                 			continue;
                 		}
                 		k = rowKind + "|" + parentId + "|" + trk;
                 		if(keyList.contains(k) == false)
                 		{
                 			keyList.add(k);
                 			kindMap.put(k,rowKind);
                 			parentMap.put(k,parentId);
                 			trackMap.put(k,trk);
                 		}
                 		totMap.put(k,ifnull(totMap.get(k),0) + 1);
                 		rowStatus = ifnull(r.Status,"").trim().toLowerCase();
                 		if(rowStatus.contains("pending"))
                 		{
                 			pendMap.put(k,ifnull(pendMap.get(k),0) + 1);
                 		}
                 		else if(rowStatus.contains("approv"))
                 		{
                 			apprMap.put(k,ifnull(apprMap.get(k),0) + 1);
                 		}
                 		else if(rowStatus.contains("reject"))
                 		{
                 			rejMap.put(k,ifnull(rejMap.get(k),0) + 1);
                 		}
                 	}
                 	/***************************************************************
                 	 * PASS 2: DETECT AND REPAIR STALLED CHAINS
                 	 ***************************************************************/
                 	fixedHtml = "";
                 	manualHtml = "";
                 	waitingHtml = "";
                 	detectedCount = 0;
                 	fixedCount = 0;
                 	manualCount = 0;
                 	waitingCount = 0;
                 	failedCount = 0;
                 	for each  k in keyList
                 	{
                 		rowKind = kindMap.get(k).toString();
                 		parentIdLong = parentMap.get(k).toString().toLong();
                 		trk = trackMap.get(k).toString();
                 		total = ifnull(totMap.get(k),0);
                 		pendingCt = ifnull(pendMap.get(k),0);
                 		approvedCt = ifnull(apprMap.get(k),0);
                 		rejectedCt = ifnull(rejMap.get(k),0);
                 		if(total == 0)
                 		{
                 			continue;
                 		}
                 		// An approver is already holding this chain.
                 		if(pendingCt > 0)
                 		{
                 			continue;
                 		}
                 		/***********************************************************
                 		 * BUDGET MODIFICATIONS
                 		 ***********************************************************/
                 		if(rowKind == "MOD")
                 		{
                 			modRec = Budget_Modification[ID == parentIdLong];
                 			if(modRec == null)
                 			{
                 				continue;
                 			}
                 			modStatus = ifnull(modRec.Status,"").trim();
                 			modLabel = "Modification " + parentIdLong.toString();
                 			if(modRec.Budget_Item != null)
                 			{
                 				modLabel = ifnull(modRec.Budget_Item.Item_Name,modLabel);
                 			}
                 			modRefText = ifnull(modRec.Reference_Number,"").trim();
                 			if(modRefText != "")
                 			{
                 				modLabel = modLabel + " (" + modRefText + ")";
                 			}
                 			// Settled and consistent: nothing to do.
                 			if(modStatus == "Approved" && approvedCt == total)
                 			{
                 				continue;
                 			}
                 			if(modStatus == "Draft" && approvedCt == 0 && rejectedCt == 0)
                 			{
                 				continue;
                 			}
                 			// Terminal by design. Not stuck - it needs the submitter to revise and
                 			// resubmit - but it stays listed so it cannot sit unnoticed forever.
                 			if(modStatus == "Rejected" && rejectedCt > 0)
                 			{
                 				waitingCount = waitingCount + 1;
                 				waitingHtml = waitingHtml + "<tr>";
                 				waitingHtml = waitingHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + modLabel + "</td>";
                 				waitingHtml = waitingHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Modification</td>";
                 				waitingHtml = waitingHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				waitingHtml = waitingHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#92400e;'>Rejected. Use Revise &amp; Resubmit on the budget page to send it back through approvals, or delete it.</td>";
                 				waitingHtml = waitingHtml + "</tr>";
                 				continue;
                 			}
                 			detectedCount = detectedCount + 1;
                 			modAction = "";
                 			modFixText = "";
                 			if(modStatus == "Submitted" && rejectedCt > 0)
                 			{
                 				modAction = "rejected";
                 				modFixText = "An approver rejected this modification but the record was never stamped Rejected.";
                 			}
                 			else if(modStatus == "Submitted" && approvedCt == total)
                 			{
                 				modAction = "approved";
                 				modFixText = "Every approver signed off but the record was never stamped Approved and the rollups never ran.";
                 			}
                 			else if(modStatus == "Submitted")
                 			{
                 				modAction = "created";
                 				modFixText = "The modification is in approvals but no approver is Pending.";
                 			}
                 			if(modAction == "")
                 			{
                 				// Draft with approval activity, or Approved with an incomplete chain.
                 				manualCount = manualCount + 1;
                 				manualHtml = manualHtml + "<tr>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + modLabel + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Modification</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>Record reads " + modStatus + " but the approval rows disagree. No row was changed.</td>";
                 				manualHtml = manualHtml + "</tr>";
                 				continue;
                 			}
                 			modResult = "";
                 			modOk = true;
                 			try 
                 			{
                 				modResult = thisapp.sendModificationEmail(parentIdLong,modAction);
                 			}			catch (modError)
                 			{
                 				modOk = false;
                 				modResult = "Repair failed: " + modError.toString();
                 			}
                 			fixedCount = fixedCount + 1;
                 			if(modOk == false)
                 			{
                 				failedCount = failedCount + 1;
                 			}
                 			fixedHtml = fixedHtml + "<tr>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + modLabel + "</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Modification</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>&mdash;</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>" + modFixText + "<br><span style='font-size:11px;color:#64748b;'>" + modResult + "</span></td>";
                 			fixedHtml = fixedHtml + "</tr>";
                 			continue;
                 		}
                 		/***********************************************************
                 		 * PRO FORMAS
                 		 ***********************************************************/
                 		if(rowKind == "PF")
                 		{
                 			pfRec = Add_Pro_Forma[ID == parentIdLong];
                 			if(pfRec == null)
                 			{
                 				continue;
                 			}
                 			pfStatus = ifnull(pfRec.Status,"").trim();
                 			pfLabel = "Pro Forma " + parentIdLong.toString();
                 			pfName = ifnull(pfRec.Name,"").toString().trim();
                 			if(pfName != "")
                 			{
                 				pfLabel = pfName;
                 			}
                 			// Only chains the Pro Forma itself believes are in flight.
                 			if(pfStatus != "Pending Approval")
                 			{
                 				continue;
                 			}
                 			detectedCount = detectedCount + 1;
                 			/*******************************************************
                 			 * EVERY STEP APPROVED BUT THE PRO FORMA NEVER FLIPPED
                 			 *
                 			 * The parent status is derived from the rows, so this is
                 			 * safe to set directly.
                 			 *******************************************************/
                 			if(approvedCt == total)
                 			{
                 				pfRec.Status="Approved";
                 				fixedCount = fixedCount + 1;
                 				fixedHtml = fixedHtml + "<tr>";
                 				fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + pfLabel + "</td>";
                 				fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Pro Forma</td>";
                 				fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>&mdash;</td>";
                 				fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>All steps were approved but the Pro Forma still read Pending Approval. Status set to Approved.</td>";
                 				fixedHtml = fixedHtml + "</tr>";
                 				continue;
                 			}
                 			/*******************************************************
                 			 * A REJECTION DID NOT LAND BACK ON THE PRIOR APPROVER
                 			 *******************************************************/
                 			if(rejectedCt > 0)
                 			{
                 				manualCount = manualCount + 1;
                 				manualHtml = manualHtml + "<tr>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + pfLabel + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Pro Forma</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>A step was rejected but no prior approver is Pending. No approval row was changed.</td>";
                 				manualHtml = manualHtml + "</tr>";
                 				continue;
                 			}
                 			/*******************************************************
                 			 * PROMOTE THE NEXT UNTOUCHED STEP
                 			 *******************************************************/
                 			pfChain = Budget_Approvals[Proforma == parentIdLong];
                 			pfHighestApproved = 0;
                 			pfTargetId = 0;
                 			pfTargetSort = 999999;
                 			pfTargetRole = "";
                 			pfTargetEmail = "";
                 			for each  pfRow in pfChain
                 			{
                 				pfRowSort = 999999;
                 				if(pfRow.Sort_Order != null)
                 				{
                 					pfRowSort = pfRow.Sort_Order.toLong();
                 				}
                 				if(ifnull(pfRow.Status,"").trim().toLowerCase().contains("approv") && pfRowSort > pfHighestApproved)
                 				{
                 					pfHighestApproved = pfRowSort;
                 				}
                 			}
                 			for each  pfRow in pfChain
                 			{
                 				pfRowSort = 999999;
                 				if(pfRow.Sort_Order != null)
                 				{
                 					pfRowSort = pfRow.Sort_Order.toLong();
                 				}
                 				pfRowStatus = ifnull(pfRow.Status,"").trim().toLowerCase();
                 				if(pfRowSort > pfHighestApproved && pfRowSort < pfTargetSort && pfRowStatus.contains("approv") == false && pfRowStatus.contains("reject") == false)
                 				{
                 					pfTargetSort = pfRowSort;
                 					pfTargetId = pfRow.ID;
                 					pfTargetRole = ifnull(pfRow.Title,"");
                 					pfTargetEmail = ifnull(pfRow.Approver,"");
                 				}
                 			}
                 			if(pfTargetId == 0)
                 			{
                 				failedCount = failedCount + 1;
                 				manualCount = manualCount + 1;
                 				manualHtml = manualHtml + "<tr>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + pfLabel + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Pro Forma</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>The watchdog could not determine which approval step should be activated.</td>";
                 				manualHtml = manualHtml + "</tr>";
                 				continue;
                 			}
                 			for each  pfRow in pfChain
                 			{
                 				pfRowStatus = ifnull(pfRow.Status,"").trim().toLowerCase();
                 				if(pfRow.ID == pfTargetId)
                 				{
                 					pfRow.Status="Pending";
                 					pfRow.Sent_Date=zoho.currenttime;
                 					pfRow.Responded_Date=null;
                 				}
                 				else if(pfRowStatus.contains("approv") == false && pfRowStatus.contains("reject") == false)
                 				{
                 					pfRow.Status="Not Sent";
                 					pfRow.Sent_Date=null;
                 					pfRow.Responded_Date=null;
                 				}
                 			}
                 			// This one reports failure in its return map rather than throwing, so the
                 			// success flag has to be read - a try/catch alone would call a failed
                 			// send a successful repair.
                 			pfEmailResult = "";
                 			pfOk = true;
                 			try 
                 			{
                 				pfResultMap = thisapp.Send_Proforma_Approval_Email(parentIdLong.toString(),pfTargetId.toString());
                 				pfEmailResult = ifnull(pfResultMap.get("message"),"").toString();
                 				if(ifnull(pfResultMap.get("success"),false) != true)
                 				{
                 					pfOk = false;
                 					if(pfEmailResult == "")
                 					{
                 						pfEmailResult = "The approval email could not be sent.";
                 					}
                 					pfEmailResult = "The step was set to Pending, but the email failed: " + pfEmailResult;
                 				}
                 			}			catch (pfError)
                 			{
                 				pfOk = false;
                 				pfEmailResult = "The step was set to Pending, but the email failed: " + pfError.toString();
                 			}
                 			fixedCount = fixedCount + 1;
                 			if(pfOk == false)
                 			{
                 				failedCount = failedCount + 1;
                 			}
                 			fixedHtml = fixedHtml + "<tr>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + pfLabel + "</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Pro Forma</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;'>" + pfTargetRole + "<br><span style='font-size:11px;color:#64748b;'>" + pfTargetEmail + "</span></td>";
                 			fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>No step was Pending. Activated the next approver and resent the approval email.<br><span style='font-size:11px;color:#64748b;'>" + pfEmailResult + "</span></td>";
                 			fixedHtml = fixedHtml + "</tr>";
                 			continue;
                 		}
                 		/***********************************************************
                 		 * BUDGET TRACKS (Development / Construction)
                 		 ***********************************************************/
                 		budRec = Add_Budget[ID == parentIdLong];
                 		if(budRec == null)
                 		{
                 			continue;
                 		}
                 		budgetLabel = ifnull(budRec.Budget_Name,"Budget");
                 		projectName = ifnull(budRec.Project,"");
                 		phaseName = ifnull(budRec.Phase,"");
                 		if(projectName != "" && phaseName != "")
                 		{
                 			budgetLabel = projectName + " - " + phaseName;
                 		}
                 		chainStatus = "";
                 		if(trk == "Construction")
                 		{
                 			chainStatus = ifnull(budRec.Const_Budget_Approval_Status,"").trim().toLowerCase();
                 		}
                 		else
                 		{
                 			chainStatus = ifnull(budRec.Development_Budget_Approval_Status,"").trim().toLowerCase();
                 		}
                 		chainInFlight = chainStatus.contains("pending");
                 		/***********************************************************
                 		 * A REJECTION DID NOT LAND BACK ON THE PRIOR APPROVER
                 		 *
                 		 * Budget rejection sends the chain back one step, so a rejected
                 		 * chain should always have a Pending row. Report only: guessing
                 		 * which row to reopen risks reversing somebody's decision.
                 		 ***********************************************************/
                 		if(rejectedCt > 0)
                 		{
                 			if(chainInFlight)
                 			{
                 				detectedCount = detectedCount + 1;
                 				manualCount = manualCount + 1;
                 				manualHtml = manualHtml + "<tr>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 				manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>A step was rejected but the chain never returned to a prior approver. No approval row was changed.</td>";
                 				manualHtml = manualHtml + "</tr>";
                 			}
                 			continue;
                 		}
                 		reason = "";
                 		fixType = "";
                 		if(approvedCt > 0 && approvedCt < total)
                 		{
                 			reason = "Chain started but no approver is Pending. The next approver was never promoted.";
                 			fixType = "PROMOTE_NEXT";
                 		}
                 		else if(chainInFlight && approvedCt == 0)
                 		{
                 			reason = "Budget track reads Pending, but the first approver was never activated.";
                 			fixType = "ACTIVATE_FIRST";
                 		}
                 		else if(chainInFlight && approvedCt == total)
                 		{
                 			reason = "All approvers are Approved, but the Budget track still reads Pending.";
                 			fixType = "MANUAL_COMPLETION";
                 		}
                 		if(reason == "")
                 		{
                 			continue;
                 		}
                 		detectedCount = detectedCount + 1;
                 		/***********************************************************
                 		 * ALL ROWS APPROVED: NO NEXT APPROVER EXISTS
                 		 *
                 		 * Do not reactivate an already-approved row. This may indicate
                 		 * that finalization or status synchronization failed, and
                 		 * flipping the parent status would hide that.
                 		 ***********************************************************/
                 		if(fixType == "MANUAL_COMPLETION")
                 		{
                 			manualCount = manualCount + 1;
                 			manualHtml = manualHtml + "<tr>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>" + reason + " No approval row was changed.</td>";
                 			manualHtml = manualHtml + "</tr>";
                 			continue;
                 		}
                 		chainRows = Budget_Approvals[Budget == parentIdLong && Type1 == trk];
                 		highestApprovedSort = 0;
                 		firstApprovalId = 0;
                 		firstApprovalSort = 999999;
                 		for each  chainRow in chainRows
                 		{
                 			rowSort = 999999;
                 			if(chainRow.Sort_Order != null)
                 			{
                 				rowSort = chainRow.Sort_Order.toLong();
                 			}
                 			rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
                 			if(rowSort < firstApprovalSort)
                 			{
                 				firstApprovalSort = rowSort;
                 				firstApprovalId = chainRow.ID;
                 			}
                 			if(rowStatus.contains("approv") && rowSort > highestApprovedSort)
                 			{
                 				highestApprovedSort = rowSort;
                 			}
                 		}
                 		targetApprovalId = 0;
                 		targetApprovalSort = 999999;
                 		targetRole = "";
                 		targetEmail = "";
                 		if(fixType == "ACTIVATE_FIRST")
                 		{
                 			targetApprovalId = firstApprovalId;
                 		}
                 		else if(fixType == "PROMOTE_NEXT")
                 		{
                 			for each  chainRow in chainRows
                 			{
                 				rowSort = 999999;
                 				if(chainRow.Sort_Order != null)
                 				{
                 					rowSort = chainRow.Sort_Order.toLong();
                 				}
                 				rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
                 				isApproved = rowStatus.contains("approv");
                 				isRejected = rowStatus.contains("reject");
                 				if(rowSort > highestApprovedSort && rowSort < targetApprovalSort && isApproved == false && isRejected == false)
                 				{
                 					targetApprovalSort = rowSort;
                 					targetApprovalId = chainRow.ID;
                 				}
                 			}
                 		}
                 		if(targetApprovalId == 0)
                 		{
                 			failedCount = failedCount + 1;
                 			manualCount = manualCount + 1;
                 			manualHtml = manualHtml + "<tr>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 			manualHtml = manualHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#b91c1c;'>The watchdog could not determine which approval row should be activated.</td>";
                 			manualHtml = manualHtml + "</tr>";
                 			continue;
                 		}
                 		for each  chainRow in chainRows
                 		{
                 			rowStatus = ifnull(chainRow.Status,"").trim().toLowerCase();
                 			if(chainRow.ID == targetApprovalId)
                 			{
                 				chainRow.Status="Pending";
                 				chainRow.Sent_Date=zoho.currentdate;
                 				chainRow.Responded_Date=null;
                 				targetRole = ifnull(chainRow.Title,"");
                 				targetEmail = ifnull(chainRow.Approver,"");
                 			}
                 			else if(rowStatus.contains("approv") == false && rowStatus.contains("reject") == false)
                 			{
                 				chainRow.Status="Not Sent";
                 				chainRow.Sent_Date=null;
                 				chainRow.Responded_Date=null;
                 			}
                 		}
                 		if(trk == "Construction")
                 		{
                 			budRec.Const_Budget_Approval_Status="Pending";
                 		}
                 		else
                 		{
                 			budRec.Development_Budget_Approval_Status="Pending";
                 		}
                 		emailResult = "";
                 		fixSuccessful = true;
                 		try 
                 		{
                 			emailResult = thisapp.sendApprovalEmail(parentIdLong,targetApprovalId);
                 		}		catch (sendError)
                 		{
                 			fixSuccessful = false;
                 			emailResult = "Approval row was set to Pending, but the email failed: " + sendError.toString();
                 		}
                 		try 
                 		{
                 			syncResult = thisapp.syncBudgetApprovalStatus(parentIdLong,trk);
                 		}		catch (syncError)
                 		{
                 			syncResult = "Status synchronization failed: " + syncError.toString();
                 		}
                 		fixedCount = fixedCount + 1;
                 		if(fixSuccessful == false)
                 		{
                 			failedCount = failedCount + 1;
                 		}
                 		actionText = "Promoted the next approver";
                 		if(fixType == "ACTIVATE_FIRST")
                 		{
                 			actionText = "Activated the first approver";
                 		}
                 		fixedHtml = fixedHtml + "<tr>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + budgetLabel + "</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + trk + "</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>" + approvedCt + " / " + total + "</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;'>" + targetRole + "<br><span style='font-size:11px;color:#64748b;'>" + targetEmail + "</span></td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>" + actionText + ", set the row to Pending, and attempted to send the approval email.<br><span style='font-size:11px;color:#64748b;'>" + emailResult + "</span></td>";
                 		fixedHtml = fixedHtml + "</tr>";
                 	}
                 	/***************************************************************
                 	 * PASS 3: SUBMITTED MODIFICATIONS THAT HAVE NO CHAIN AT ALL
                 	 *
                 	 * These never appear in pass 1 because they own no approval rows.
                 	 * submitBudgetModification builds the chain and sends the first email.
                 	 ***************************************************************/
                 	chainlessMods = Budget_Modification[Status == "Submitted"];
                 	for each  cm in chainlessMods
                 	{
                 		if(ifnull(cm.Reference_Number,"").startsWith("PO:"))
                 		{
                 			continue;
                 		}
                 		cmRows = Budget_Approvals[Budget_Modification == cm.ID];
                 		if(cmRows.count() > 0)
                 		{
                 			continue;
                 		}
                 		cmLabel = "Modification " + cm.ID.toString();
                 		if(cm.Budget_Item != null)
                 		{
                 			cmLabel = ifnull(cm.Budget_Item.Item_Name,cmLabel);
                 		}
                 		detectedCount = detectedCount + 1;
                 		cmResult = "";
                 		cmOk = true;
                 		try 
                 		{
                 			cmResult = thisapp.submitBudgetModification(cm.ID);
                 		}		catch (cmError)
                 		{
                 			cmOk = false;
                 			cmResult = "Repair failed: " + cmError.toString();
                 		}
                 		fixedCount = fixedCount + 1;
                 		if(cmOk == false)
                 		{
                 			failedCount = failedCount + 1;
                 		}
                 		fixedHtml = fixedHtml + "<tr>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;font-weight:700;color:#0f2744;'>" + cmLabel + "</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>Modification</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>0 / 0</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;'>&mdash;</td>";
                 		fixedHtml = fixedHtml + "<td style='padding:8px 12px;border-bottom:1px solid #e2e8f0;color:#047857;'>Submitted with no approval chain. Rebuilt the chain and sent the first approval email.<br><span style='font-size:11px;color:#64748b;'>" + cmResult + "</span></td>";
                 		fixedHtml = fixedHtml + "</tr>";
                 	}
                 	/***************************************************************
                 	 * ORPHANED MODIFICATION ROWS
                 	 *
                 	 * Approval rows tagged Modification that lost their Budget_Modification
                 	 * link are invisible to the widget. Counted here as a health signal;
                 	 * modificationAdmin("repair") is what actually clears them.
                 	 ***************************************************************/
                 	orphanCount = Budget_Approvals[Type1 == "Modification" && Budget_Modification == null].count();
                 	/***************************************************************
                 	 * SEND WATCHDOG SUMMARY
                 	 ***************************************************************/
                 	if(detectedCount == 0 && waitingCount == 0 && orphanCount == 0)
                 	{
                 		return "OK: no stalled approval chains found.";
                 	}
                 	emailBody = "";
                 	emailBody = emailBody + "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 	emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Approval Watchdog Results</h2>";
                 	emailBody = emailBody + "<p style='margin:0 0 16px 0;'>";
                 	emailBody = emailBody + "<strong>" + detectedCount + "</strong> stalled approval chain(s) were detected across budgets, Pro Formas and modifications. ";
                 	emailBody = emailBody + "<strong style='color:#047857;'>" + fixedCount + "</strong> were automatically repaired";
                 	if(manualCount > 0)
                 	{
                 		emailBody = emailBody + ", and <strong style='color:#b91c1c;'>" + manualCount + "</strong> require manual review";
                 	}
                 	emailBody = emailBody + ".</p>";
                 	if(fixedCount > 0)
                 	{
                 		emailBody = emailBody + "<h3 style='margin:20px 0 8px 0;color:#047857;'>Automatically Fixed Approvals</h3>";
                 		emailBody = emailBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;'>";
                 		emailBody = emailBody + "<tr style='background:#ecfdf5;'>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Record</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Type</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Approved</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Activated</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #a7f3d0;'>Repair</th>";
                 		emailBody = emailBody + "</tr>";
                 		emailBody = emailBody + fixedHtml;
                 		emailBody = emailBody + "</table>";
                 	}
                 	if(manualCount > 0)
                 	{
                 		emailBody = emailBody + "<h3 style='margin:20px 0 8px 0;color:#b91c1c;'>Manual Review Required</h3>";
                 		emailBody = emailBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;'>";
                 		emailBody = emailBody + "<tr style='background:#fef2f2;'>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Record</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Type</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Approved</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fecaca;'>Problem</th>";
                 		emailBody = emailBody + "</tr>";
                 		emailBody = emailBody + manualHtml;
                 		emailBody = emailBody + "</table>";
                 	}
                 	if(waitingCount > 0)
                 	{
                 		emailBody = emailBody + "<h3 style='margin:20px 0 8px 0;color:#92400e;'>Rejected Modifications Awaiting Revision</h3>";
                 		emailBody = emailBody + "<p style='margin:0 0 8px 0;font-size:13px;color:#475569;'>Rejecting a modification is final, unlike a budget or Pro Forma rejection which returns to the prior approver. These are not stuck &mdash; they are waiting on the submitter.</p>";
                 		emailBody = emailBody + "<table style='border-collapse:collapse;width:100%;font-size:13px;'>";
                 		emailBody = emailBody + "<tr style='background:#fffbeb;'>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fde68a;'>Record</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fde68a;'>Type</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fde68a;'>Approved</th>";
                 		emailBody = emailBody + "<th style='padding:8px 12px;text-align:left;border-bottom:2px solid #fde68a;'>Next Step</th>";
                 		emailBody = emailBody + "</tr>";
                 		emailBody = emailBody + waitingHtml;
                 		emailBody = emailBody + "</table>";
                 	}
                 	if(orphanCount > 0)
                 	{
                 		emailBody = emailBody + "<p style='margin:16px 0 0 0;font-size:13px;color:#b91c1c;'><strong>" + orphanCount + "</strong> modification approval row(s) have no Budget Modification link and are invisible in the widget. Open the affected budget in Budget Manager to trigger the automatic repair.</p>";
                 	}
                 	emailBody = emailBody + "<p style='margin:16px 0 0 0;font-size:12px;color:#64748b;'>";
                 	emailBody = emailBody + "Automated check from the Land Master approval watchdog. Automatically repaired chains had the appropriate approval row set to Pending and the approval email resent.";
                 	emailBody = emailBody + "</p>";
                 	emailBody = emailBody + "</div>";
                 	subjectText = "Land Master Approvals: " + fixedCount + " fixed";
                 	if(manualCount > 0)
                 	{
                 		subjectText = subjectText + ", " + manualCount + " need review";
                 	}
                 	if(waitingCount > 0)
                 	{
                 		subjectText = subjectText + ", " + waitingCount + " rejected";
                 	}
                 	sendmail
                 	[
                 		from :fromAddress
                 		to :toAddress
                 		subject :subjectText
                 		message :emailBody
                 	]
                 	return "OK: detected=" + detectedCount + " fixed=" + fixedCount + " manual=" + manualCount + " rejectedWaiting=" + waitingCount + " orphanRows=" + orphanCount + " failed=" + failedCount + ".";
                 }
				 string buildForecastManagerSummary(int subdivisionId)
                 {
                 	html = "";
                 	monthStart = zoho.currentdate.toStartOfMonth();
                 	nextMonthStart = monthStart.addMonth(1);
                 	monthForecastLabel = monthStart.toString("MMMM") + " Forecast";
                 	recent30Start = zoho.currentdate.subDay(30);
                 	recent90Start = zoho.currentdate.subDay(90);
                 	recent6Start = zoho.currentdate.subMonth(6);
                 	recent12Start = zoho.currentdate.subMonth(12);
                 	// ---------- CSS ----------
                 	html = html + "<style>";
                 	html = html + ".fm-scroll{width:100%;overflow-x:auto;padding-bottom:8px;}";
                 	html = html + ".fm-canvas{display:inline-block;min-width:0;}";
                 	html = html + ".fm-wrap{display:inline-block;font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;padding:14px;border:1px solid #d9deea;border-radius:14px;min-width:0;}";
                 	html = html + ".fm-badge{display:inline-block;padding:7px 10px;border-radius:999px;background:#eef4ff;border:1px solid #d7e5ff;color:#0d5bd7;font-size:12px;font-weight:700;white-space:nowrap;}";
                 	html = html + ".fm-section{display:inline-block;margin-bottom:16px;background:#ffffff;border:1px solid #d9deea;border-radius:16px;padding:14px;box-shadow:0 8px 24px rgba(28,49,94,.06);min-width:0;}";
                 	html = html + ".fm-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:nowrap;margin-bottom:12px;}";
                 	html = html + ".fm-head-left{display:flex;align-items:center;gap:10px;min-width:0;}";
                 	html = html + ".fm-title-block{min-width:0;}";
                 	html = html + ".fm-head-divider{width:1px;height:52px;background:#d9deea;flex:0 0 1px;margin:0 8px;}";
                 	html = html + ".fm-section-title{font-size:18px;font-weight:700;color:#1f2a44;white-space:nowrap;}";
                 	html = html + ".fm-section-meta{font-size:12px;color:#667089;margin-top:4px;}";
                 	html = html + ".fm-top-stat{display:inline-block;min-width:132px;padding:8px 10px;border-radius:12px;border:1px solid #d9deea;background:#f8fafc;text-align:center;}";
                 	html = html + ".fm-top-stat-neg{background:#fff1f1;border:1px solid #f2b8b8;}";
                 	html = html + ".fm-top-stat-k{font-size:10px;color:#667089;text-transform:uppercase;letter-spacing:.05em;font-weight:700;}";
                 	html = html + ".fm-top-stat-v{font-size:18px;font-weight:700;color:#1f2a44;margin-top:3px;line-height:1;}";
                 	html = html + ".fm-top-stat-neg .fm-top-stat-v{color:#b42318;}";
                 	html = html + ".fm-grid{display:grid;grid-template-columns:380px max-content;gap:14px;align-items:start;width:max-content;}";
                 	html = html + ".fm-card{background:#ffffff;border:1px solid #d9deea;border-radius:14px;padding:14px;width:380px;min-width:380px;}";
                 	html = html + ".fm-card-title{font-size:12px;color:#667089;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;font-weight:700;}";
                 	html = html + ".fm-table{width:100%;border-collapse:collapse;font-size:13px;}";
                 	html = html + ".fm-table td{padding:8px 0;border-bottom:1px solid #edf1f7;vertical-align:top;}";
                 	html = html + ".fm-table td:first-child{color:#667089;width:44%;}";
                 	html = html + ".fm-builder-grid{display:flex;flex-wrap:nowrap;gap:12px;align-items:stretch;width:max-content;}";
                 	html = html + ".fm-builder-card{background:#fcfdff;border:1px solid #d9deea;border-radius:14px;padding:12px;width:320px;min-width:320px;max-width:320px;}";
                 	html = html + ".fm-builder-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:14px;min-height:52px;}";
                 	html = html + ".fm-builder-title-wrap{min-width:0;flex:1 1 auto;padding-right:6px;}";
                 	html = html + ".fm-builder-name{font-size:16px;font-weight:700;color:#1f2a44;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}";
                 	html = html + ".fm-builder-sub{font-size:12px;color:#667089;margin-top:4px;margin-bottom:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;}";
                 	html = html + ".fm-builder-stat{display:inline-block;min-width:88px;padding:6px 8px;border-radius:10px;border:1px solid #d9deea;background:#ffffff;text-align:center;flex:0 0 auto;}";
                 	html = html + ".fm-builder-stat-neg{background:#fff1f1;border:1px solid #f2b8b8;}";
                 	html = html + ".fm-builder-stat-k{font-size:9px;color:#667089;text-transform:uppercase;letter-spacing:.05em;font-weight:700;}";
                 	html = html + ".fm-builder-stat-v{font-size:16px;font-weight:700;color:#1f2a44;margin-top:3px;line-height:1;}";
                 	html = html + ".fm-builder-stat-neg .fm-builder-stat-v{color:#b42318;}";
                 	html = html + ".fm-progress-label{font-size:11px;color:#667089;text-transform:uppercase;letter-spacing:.06em;margin:2px 0 8px 0;}";
                 	html = html + ".fm-progress-wrap{margin-bottom:10px;}";
                 	html = html + ".fm-progress{height:10px;border-radius:999px;overflow:hidden;margin-bottom:4px;background:#edf2fb;}";
                 	html = html + ".fm-progress-meta{position:relative;height:28px;}";
                 	html = html + ".fm-progress-sold{position:absolute;left:0;top:0;font-size:11px;color:#667089;font-weight:700;white-space:nowrap;}";
                 	html = html + ".fm-progress-expected{position:absolute;top:14px;font-size:11px;color:#b42318;font-weight:700;white-space:nowrap;}";
                 	html = html + ".fm-month{margin:4px 0 14px;border-top:1px solid #d9deea;padding-top:10px;}";
                 	html = html + ".fm-month-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:7px;}";
                 	html = html + ".fm-month-label{font-size:11px;color:#667089;text-transform:uppercase;letter-spacing:.04em;}";
                 	html = html + ".fm-month-status{font-size:12px;color:#1f2a44;font-weight:700;white-space:nowrap;}";
                 	html = html + ".fm-month-status-over{color:#b42318;}";
                 	html = html + ".fm-month-track{height:10px;border-radius:999px;overflow:hidden;background:#edf2fb;}";
                 	html = html + ".fm-month-fill{height:100%;background:#14845a;}";
                 	html = html + ".fm-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}";
                 	html = html + ".fm-mini{border:1px solid #d9deea;border-radius:12px;padding:10px;background:#ffffff;}";
                 	html = html + ".fm-mini-k{font-size:11px;color:#667089;text-transform:uppercase;letter-spacing:.05em;}";
                 	html = html + ".fm-mini-v{font-size:17px;font-weight:700;color:#1f2a44;margin-top:4px;}";
                 	html = html + ".fm-contract-scope{margin-top:16px;padding-top:14px;border-top:2px solid #d9deea;}";
                 	html = html + ".fm-contract-scope .fm-card-title{color:#285b97;}";
                 	html = html + ".fm-empty{padding:16px;background:#ffffff;border:1px dashed #c8d3e6;border-radius:12px;color:#667089;font-size:13px;min-width:0;}";
                 	html = html + "</style>";
                 	// ---------- wrapper ----------
                 	html = html + "<div class='fm-scroll'><div class='fm-canvas'><div class='fm-wrap'>";
                 	doneSubs = List();
                 	if(subdivisionId != null)
                 	{
                 		subIdText = subdivisionId.toString();
                 		if(!doneSubs.contains(subIdText))
                 		{
                 			doneSubs.add(subIdText);
                 			subRec = Subdivision[ID == subdivisionId];
                 			subName = ifnull(subRec.Subdivision_Name,"");
                 			if(subName == "")
                 			{
                 				subName = "Subdivision";
                 			}
                 			subCode = ifnull(subRec.Subdivision_Code,"");
                 			companyName = ifnull(subRec.Company_Name,"");
                 			county = ifnull(subRec.County,"");
                 			projectStatus = ifnull(subRec.Status,"");
                 			totalLots = ifnull(subRec.Total_Lots,0);
                 			lotTotalResidential = ifnull(subRec.Lot_Total_Residential,0);
                 			lotsSold = Lots[Subdivision == subdivisionId && Status == "Sold"].count();
                 			lotsScheduled = Lots[Subdivision == subdivisionId && Status == "Scheduled"].count();
                 			equivLF = ifnull(subRec.Equiv_LF_of_Street,0);
                 			// Single-phase schedules use their own totals. Multi-phase schedules use contract lots.
                 			phaseObligationBySchedule = Map();
                 			phaseSoldBySchedule = Map();
                 			phaseMetricsBySchedule = Map();
                 			singlePhaseObligation = 0;
                 			singlePhaseSold = 0;
                 			phaseContractLotIds = List();
                 			phaseSoldLotIds = List();
                 			phaseForecastBuilderIds = List();
                 			phaseForecastedLots = 0;
                 			phaseForecastByBuilder = Map();
                 			monthForecastByBuilder = Map();
                 			monthSoldByBuilder = Map();
                 			for each  summarySchedule in Takedown_Schedule[Subdivisions == subdivisionId]
                 			{
                 				summaryKey = summarySchedule.ID.toString();
                 				phaseObligation = 0;
                 				phaseSold = 0;
                 				phaseLiveSold = 0;
                 				phaseScheduled = 0;
                 				phaseMonthSold = 0;
                 				phaseLast30 = 0;
                 				phaseLast90 = 0;
                 				phaseLast6 = 0;
                 				phaseLast12 = 0;
                 				phaseLastClose = null;
                 				phaseLastCloseAmount = 0;
                 				isMultiPhaseSchedule = false;
                 				if(summarySchedule.Subdivisions != null)
                 				{
                 					isMultiPhaseSchedule = summarySchedule.Subdivisions.size() > 1;
                 				}
                 				if(!isMultiPhaseSchedule)
                 				{
                 					phaseObligation = ifnull(summarySchedule.Total_Lot_Obligation,0);
                 					if(summarySchedule.Builder1 != null)
                 					{
                 						// Freeze forecastable capacity at the start of this month.
                 						phaseSold = Lots[Subdivision == subdivisionId && Builder1 == summarySchedule.Builder1 && Status == "Sold" && Close_Date != null && Close_Date < monthStart].count();
                 					}
                 					singlePhaseObligation = singlePhaseObligation + phaseObligation;
                 					singlePhaseSold = singlePhaseSold + phaseSold;
                 				}
                 				else if(summarySchedule.Add_Contract_Contract_Name != null)
                 				{
                 					contractRec = Contract[ID == summarySchedule.Add_Contract_Contract_Name];
                 					if(contractRec.count() > 0)
                 					{
                 						contractLotIds = contractRec.Lots1;
                 						if(contractLotIds != null)
                 						{
                 							if(contractLotIds.size() > 0)
                 							{
                 								for each  phaseLot in Lots[ID in contractLotIds && Subdivision == subdivisionId]
                 								{
                 									phaseObligation = phaseObligation + 1;
                 									if(phaseLot.Status == "Scheduled")
                 									{
                 										phaseScheduled = phaseScheduled + 1;
                 									}
                 									if(phaseLot.Status == "Sold")
                 									{
                 										phaseLiveSold = phaseLiveSold + 1;
                 										if(phaseLot.Close_Date != null)
                 										{
                 											if(phaseLot.Close_Date >= monthStart && phaseLot.Close_Date < nextMonthStart)
                 											{
                 												phaseMonthSold = phaseMonthSold + 1;
                 											}
                 											if(phaseLot.Close_Date <= zoho.currentdate)
                 											{
                 												if(phaseLot.Close_Date >= recent30Start)
                 												{
                 													phaseLast30 = phaseLast30 + 1;
                 												}
                 												if(phaseLot.Close_Date >= recent90Start)
                 												{
                 													phaseLast90 = phaseLast90 + 1;
                 												}
                 												if(phaseLot.Close_Date >= recent6Start)
                 												{
                 													phaseLast6 = phaseLast6 + 1;
                 												}
                 												if(phaseLot.Close_Date >= recent12Start)
                 												{
                 													phaseLast12 = phaseLast12 + 1;
                 												}
                 												if(phaseLastClose == null || phaseLot.Close_Date > phaseLastClose)
                 												{
                 													phaseLastClose = phaseLot.Close_Date;
                 													phaseLastCloseAmount = 1;
                 												}
                 												else if(phaseLot.Close_Date == phaseLastClose)
                 												{
                 													phaseLastCloseAmount = phaseLastCloseAmount + 1;
                 												}
                 											}
                 										}
                 									}
                 									if(!phaseContractLotIds.contains(phaseLot.ID))
                 									{
                 										phaseContractLotIds.add(phaseLot.ID);
                 									}
                 									if(phaseLot.Status == "Sold" && phaseLot.Close_Date != null && phaseLot.Close_Date < monthStart)
                 									{
                 										phaseSold = phaseSold + 1;
                 										if(!phaseSoldLotIds.contains(phaseLot.ID))
                 										{
                 											phaseSoldLotIds.add(phaseLot.ID);
                 										}
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 				phaseObligationBySchedule.put(summaryKey,phaseObligation);
                 				phaseSoldBySchedule.put(summaryKey,phaseSold);
                 				phaseMetrics = Map();
                 				phaseMetrics.put("multi",isMultiPhaseSchedule);
                 				phaseMetrics.put("sold",phaseLiveSold);
                 				phaseMetrics.put("scheduled",phaseScheduled);
                 				phaseMetrics.put("monthSold",phaseMonthSold);
                 				phaseMetrics.put("last30",phaseLast30);
                 				phaseMetrics.put("last90",phaseLast90);
                 				phaseMetrics.put("last6",phaseLast6);
                 				phaseMetrics.put("last12",phaseLast12);
                 				phaseMetrics.put("lastClose",phaseLastClose);
                 				phaseMetrics.put("lastCloseAmount",phaseLastCloseAmount);
                 				phaseMetricsBySchedule.put(summaryKey,phaseMetrics);
                 				// Forecast records are keyed by phase and builder, not contract.
                 				if(summarySchedule.Builder1 != null)
                 				{
                 					if(!phaseForecastBuilderIds.contains(summarySchedule.Builder1))
                 					{
                 						phaseForecastBuilderIds.add(summarySchedule.Builder1);
                 						// This month's full forecast still covers the start-of-month pool.
                 						builderForecastCoverage = ifnull(Forecast[Subdivision1 == subdivisionId && Builder1 == summarySchedule.Builder1 && Forecast_Start_Date >= monthStart].sum(Forecasted_Lots),0);
                 						phaseForecastByBuilder.put(summarySchedule.Builder1.toString(),builderForecastCoverage);
                 						// Current-month closings consume only the monthly meter, not forecastable capacity.
                 						monthForecast = ifnull(Forecast[Subdivision1 == subdivisionId && Builder1 == summarySchedule.Builder1 && Forecast_Start_Date >= monthStart && Forecast_Start_Date < nextMonthStart].sum(Forecasted_Lots),0);
                 						monthSold = Lots[Subdivision == subdivisionId && Builder1 == summarySchedule.Builder1 && Status == "Sold" && Close_Date != null && Close_Date >= monthStart && Close_Date < nextMonthStart].count();
                 						monthForecastByBuilder.put(summarySchedule.Builder1.toString(),monthForecast);
                 						monthSoldByBuilder.put(summarySchedule.Builder1.toString(),monthSold);
                 						phaseForecastedLots = phaseForecastedLots + builderForecastCoverage;
                 					}
                 				}
                 			}
                 			unforecastedLots = singlePhaseObligation + phaseContractLotIds.size() - singlePhaseSold - phaseSoldLotIds.size() - phaseForecastedLots;
                 			unforecastedClass = "fm-top-stat";
                 			if(unforecastedLots < 0)
                 			{
                 				unforecastedClass = "fm-top-stat fm-top-stat-neg";
                 			}
                 			lastSoldDateText = "";
                 			if(subRec.Last_Sold_Date != null)
                 			{
                 				lastSoldDateText = subRec.Last_Sold_Date.toString("MM/dd/yyyy");
                 			}
                 			html = html + "<div class='fm-section'>";
                 			html = html + "<div class='fm-section-head'>";
                 			html = html + "<div class='fm-head-left'>";
                 			html = html + "<div class='fm-title-block'>";
                 			html = html + "<div class='fm-section-title'>" + subName + "</div>";
                 			html = html + "<div class='fm-section-meta'>";
                 			if(subCode != "")
                 			{
                 				html = html + subCode;
                 			}
                 			if(subCode != "" && projectStatus != "")
                 			{
                 				html = html + " &nbsp;&middot;&nbsp; ";
                 			}
                 			if(projectStatus != "")
                 			{
                 				html = html + projectStatus;
                 			}
                 			html = html + "</div>";
                 			html = html + "</div>";
                 			html = html + "<div class='fm-head-divider'></div>";
                 			html = html + "<div class='" + unforecastedClass + "'><div class='fm-top-stat-k'>Unforecasted Lots</div><div class='fm-top-stat-v'>" + unforecastedLots.toString() + "</div></div>";
                 			html = html + "</div>";
                 			html = html + "<div class='fm-badge'>Subdivision Snapshot</div>";
                 			html = html + "</div>";
                 			html = html + "<div class='fm-grid'>";
                 			// subdivision details card
                 			html = html + "<div class='fm-card'>";
                 			html = html + "<div class='fm-card-title'>Subdivision Details</div>";
                 			html = html + "<table class='fm-table'>";
                 			html = html + "<tr><td>Subdivision Name</td><td><b>" + subName + "</b></td></tr>";
                 			html = html + "<tr><td>Subdivision Code</td><td><b>" + subCode + "</b></td></tr>";
                 			html = html + "<tr><td>Company</td><td>" + companyName + "</td></tr>";
                 			html = html + "<tr><td>County</td><td>" + county + "</td></tr>";
                 			html = html + "<tr><td>Total Lots (LM)</td><td>" + totalLots.toString() + "</td></tr>";
                 			html = html + "<tr><td>Lot Total Residential</td><td>" + lotTotalResidential.toString() + "</td></tr>";
                 			html = html + "<tr><td>Lots Sold</td><td>" + lotsSold.toString() + "</td></tr>";
                 			html = html + "<tr><td>Lots Scheduled</td><td>" + lotsScheduled.toString() + "</td></tr>";
                 			html = html + "<tr><td>Equiv LF of Street</td><td>" + equivLF.toString() + "</td></tr>";
                 			html = html + "<tr><td>Last Sold Date</td><td>" + lastSoldDateText + "</td></tr>";
                 			html = html + "</table>";
                 			html = html + "</div>";
                 			// all takedown schedules for this subdivision
                 			html = html + "<div class='fm-builder-grid'>";
                 			scheduleFoundForSub = false;
                 			for each  ts in Takedown_Schedule[Subdivisions == subdivisionId]
                 			{
                 				scheduleFoundForSub = true;
                 				builderName = "";
                 				builderForecastedLots = 0;
                 				builderUnforecastedLots = 0;
                 				builderUnforecastedClass = "fm-builder-stat";
                 				builderLotsSold = 0;
                 				builderLotsScheduled = 0;
                 				builderMonthForecast = 0;
                 				builderMonthSold = 0;
                 				builderMonthPercent = 0.0;
                 				builderMonthStatusClass = "fm-month-status";
                 				scheduleLotsSold = 0;
                 				scheduleLotsScheduled = 0;
                 				initialCloseText = "";
                 				initialTakedown = 0;
                 				initialDelayDays = 0;
                 				secondClosingLotsText = "";
                 				secondClosingDaysText = "";
                 				continuedTakedown = 0;
                 				continuedDays = 0;
                 				takedownEndText = "";
                 				lastTakedownText = "";
                 				lastTakedownAmount = 0;
                 				lotsExpected = 0;
                 				totalObligation = 0;
                 				last30 = 0;
                 				last90 = 0;
                 				last6 = 0;
                 				last12 = 0;
                 				soldPercent = 0.0;
                 				projectedPercent = 0.0;
                 				expectedPercent = 0.0;
                 				redExtensionPercent = 0.0;
                 				expectedLabelLeft = 0.0;
                 				showExpectedExtension = false;
                 				showExpectedLabel = false;
                 				progressDisplay = "0";
                 				progressBarStyle = "";
                 				if(ts.Builder1 != null)
                 				{
                 					builderName = ifnull(ts.Builder1.Builder_Name,"");
                 					if(builderName == "")
                 					{
                 						builderName = ts.Builder1.toString();
                 					}
                 					builderForecastedLots = ifnull(phaseForecastByBuilder.get(ts.Builder1.toString()),0);
                 					builderMonthForecast = ifnull(monthForecastByBuilder.get(ts.Builder1.toString()),0);
                 					builderMonthSold = ifnull(monthSoldByBuilder.get(ts.Builder1.toString()),0);
                 					builderLotsSold = Lots[Subdivision == subdivisionId && Builder1 == ts.Builder1 && Status == "Sold"].count();
                 					builderLotsScheduled = Lots[Subdivision == subdivisionId && Builder1 == ts.Builder1 && Status == "Scheduled"].count();
                 					if(ts.Subdivisions != null)
                 					{
                 						for each  scheduleSubdivision in ts.Subdivisions
                 						{
                 							scheduleLotsSold = scheduleLotsSold + Lots[Subdivision == scheduleSubdivision && Builder1 == ts.Builder1 && Status == "Sold"].count();
                 							scheduleLotsScheduled = scheduleLotsScheduled + Lots[Subdivision == scheduleSubdivision && Builder1 == ts.Builder1 && Status == "Scheduled"].count();
                 						}
                 					}
                 				}
                 				if(ts.Takedown_Start_Date != null)
                 				{
                 					initialCloseText = ts.Takedown_Start_Date.toString("MM/dd/yyyy");
                 				}
                 				if(ts.Takedown_End_Date != null)
                 				{
                 					takedownEndText = ts.Takedown_End_Date.toString("MM/dd/yyyy");
                 				}
                 				if(ts.Last_Takedown_Date != null)
                 				{
                 					lastTakedownText = ts.Last_Takedown_Date.toString("MM/dd/yyyy");
                 				}
                 				initialTakedown = ifnull(ts.Initial_Takedown,0);
                 				initialDelayDays = ifnull(ts.Initial_Delay_Days,0);
                 				// Blank legacy terms stay blank until an explicit schedule edit.
                 				if(ts.Second_Closing_Lots != null)
                 				{
                 					secondClosingLotsText = ts.Second_Closing_Lots.toString();
                 				}
                 				if(ts.Second_Closing_Days != null)
                 				{
                 					secondClosingDaysText = ts.Second_Closing_Days.toString();
                 				}
                 				continuedTakedown = ifnull(ts.Continued_Takedown,0);
                 				continuedDays = ifnull(ts.Continued_Takedown_Delay_Days,0);
                 				lastTakedownAmount = ifnull(ts.Last_Takedown_Amount,0);
                 				lotsExpected = ifnull(ts.Lots_Expected,0);
                 				// Contracted and unforecasted counts belong only to the selected phase.
                 				scheduleKey = ts.ID.toString();
                 				totalObligation = ifnull(phaseObligationBySchedule.get(scheduleKey),0);
                 				phaseLotsSold = ifnull(phaseSoldBySchedule.get(scheduleKey),0);
                 				builderUnforecastedLots = totalObligation - phaseLotsSold - builderForecastedLots;
                 				// Keep the full schedule obligation, even when future lots are not populated.
                 				scheduleObligation = ifnull(ts.Total_Lot_Obligation,0);
                 				phaseMetrics = phaseMetricsBySchedule.get(scheduleKey);
                 				isMultiPhaseSchedule = phaseMetrics.get("multi");
                 				progressLabel = "Schedule Progress";
                 				contractProgressDisplay = "0%";
                 				contractProgressBarStyle = "";
                 				contractSalesText = scheduleLotsSold.toString() + " Lots Sold";
                 				if(scheduleLotsScheduled > 0)
                 				{
                 					contractSalesText = contractSalesText + " - " + scheduleLotsScheduled.toString() + " Lots Scheduled";
                 				}
                 				if(builderUnforecastedLots < 0)
                 				{
                 					builderUnforecastedClass = "fm-builder-stat fm-builder-stat-neg";
                 				}
                 				last30 = ifnull(ts.Last_30_Day_Sales,0);
                 				last90 = ifnull(ts.Last_90_Day_Sales,0);
                 				last6 = ifnull(ts.Last_6_Month_Sales,0);
                 				last12 = ifnull(ts.Last_12_Month_Sales,0);
                 				if(scheduleObligation > 0)
                 				{
                 					soldPercent = (scheduleLotsSold * 100.0) / scheduleObligation;
                 					projectedPercent = ((scheduleLotsSold + scheduleLotsScheduled) * 100.0) / scheduleObligation;
                 					expectedPercent = (lotsExpected * 100.0) / scheduleObligation;
                 				}
                 				if(isMultiPhaseSchedule)
                 				{
                 					contractSoldPercent = soldPercent;
                 					contractProjectedPercent = projectedPercent;
                 					if(contractSoldPercent > 100)
                 					{
                 						contractSoldPercent = 100;
                 					}
                 					if(contractProjectedPercent > 100)
                 					{
                 						contractProjectedPercent = 100;
                 					}
                 					contractProgressDisplay = contractSoldPercent.toLong().toString() + "%";
                 					contractProgressBarStyle = "background:linear-gradient(90deg,#0d5bd7 0%,#0d5bd7 " + contractSoldPercent.toString() + "%";
                 					if(scheduleLotsScheduled > 0 && scheduleObligation > 0)
                 					{
                 						contractProgressDisplay = contractProgressDisplay + " &rarr; " + contractProjectedPercent.toLong().toString() + "%";
                 						contractProgressBarStyle = contractProgressBarStyle + ",#b8860b " + contractSoldPercent.toString() + "%,#b8860b " + contractProjectedPercent.toString() + "%";
                 					}
                 					contractProgressBarStyle = contractProgressBarStyle + ",#edf2fb " + contractProjectedPercent.toString() + "%,#edf2fb 100%);";
                 					// Every main-card actual uses the selected phase's linked contract lots.
                 					progressLabel = "Phase Progress";
                 					builderLotsSold = phaseMetrics.get("sold");
                 					builderLotsScheduled = phaseMetrics.get("scheduled");
                 					builderMonthSold = phaseMetrics.get("monthSold");
                 					last30 = phaseMetrics.get("last30");
                 					last90 = phaseMetrics.get("last90");
                 					last6 = phaseMetrics.get("last6");
                 					last12 = phaseMetrics.get("last12");
                 					lastTakedownText = "";
                 					phaseLastClose = phaseMetrics.get("lastClose");
                 					if(phaseLastClose != null)
                 					{
                 						lastTakedownText = phaseLastClose.toString("MM/dd/yyyy");
                 					}
                 					lastTakedownAmount = phaseMetrics.get("lastCloseAmount");
                 					scheduleLotsSold = builderLotsSold;
                 					scheduleLotsScheduled = builderLotsScheduled;
                 					soldPercent = 0.0;
                 					projectedPercent = 0.0;
                 					expectedPercent = 0.0;
                 					// Shared expected takes cannot be allocated to a phase implicitly.
                 					if(totalObligation > 0)
                 					{
                 						soldPercent = (builderLotsSold * 100.0) / totalObligation;
                 						projectedPercent = ((builderLotsSold + builderLotsScheduled) * 100.0) / totalObligation;
                 					}
                 				}
                 				if(soldPercent < 0)
                 				{
                 					soldPercent = 0;
                 				}
                 				if(soldPercent > 100)
                 				{
                 					soldPercent = 100;
                 				}
                 				if(projectedPercent < soldPercent)
                 				{
                 					projectedPercent = soldPercent;
                 				}
                 				if(projectedPercent > 100)
                 				{
                 					projectedPercent = 100;
                 				}
                 				if(expectedPercent < 0)
                 				{
                 					expectedPercent = 0;
                 				}
                 				if(expectedPercent > 100)
                 				{
                 					expectedPercent = 100;
                 				}
                 				progressDisplay = soldPercent.toLong().toString() + "%";
                 				if(builderMonthForecast > 0)
                 				{
                 					builderMonthPercent = (builderMonthSold * 100.0) / builderMonthForecast;
                 				}
                 				if(builderMonthPercent > 100)
                 				{
                 					builderMonthPercent = 100;
                 				}
                 				if(builderMonthSold > builderMonthForecast)
                 				{
                 					builderMonthStatusClass = "fm-month-status fm-month-status-over";
                 				}
                 				if(scheduleLotsScheduled > 0 && scheduleObligation > 0)
                 				{
                 					progressDisplay = progressDisplay + " &rarr; " + projectedPercent.toLong().toString() + "%";
                 				}
                 				if(expectedPercent > soldPercent)
                 				{
                 					showExpectedExtension = true;
                 					redExtensionPercent = expectedPercent - soldPercent;
                 				}
                 				if(lotsExpected > scheduleLotsSold && showExpectedExtension)
                 				{
                 					showExpectedLabel = true;
                 					expectedLabelLeft = soldPercent;
                 					if(expectedLabelLeft > 72)
                 					{
                 						expectedLabelLeft = 72;
                 					}
                 				}
                 				// Sold stays blue; Scheduled extends it in dark yellow.
                 				progressBarStyle = "background:linear-gradient(90deg,#0d5bd7 0%,#0d5bd7 " + soldPercent.toString() + "%";
                 				if(scheduleLotsScheduled > 0)
                 				{
                 					progressBarStyle = progressBarStyle + ",#b8860b " + soldPercent.toString() + "%,#b8860b " + projectedPercent.toString() + "%";
                 				}
                 				// Keep the expected-sales extension only beyond Sold plus Scheduled.
                 				if(expectedPercent > projectedPercent)
                 				{
                 					progressBarStyle = progressBarStyle + ",#f6a6a6 " + projectedPercent.toString() + "%,#f6a6a6 " + expectedPercent.toString() + "%,#edf2fb " + expectedPercent.toString() + "%,#edf2fb 100%);";
                 				}
                 				else
                 				{
                 					progressBarStyle = progressBarStyle + ",#edf2fb " + projectedPercent.toString() + "%,#edf2fb 100%);";
                 				}
                 				html = html + "<div class='fm-builder-card'>";
                 				html = html + "<div class='fm-builder-head'>";
                 				html = html + "<div class='fm-builder-title-wrap'>";
                 				html = html + "<div class='fm-builder-name'>" + builderName + "</div>";
                 				contractedLabel = totalObligation.toString() + " Lots Contracted";
                 				if(isMultiPhaseSchedule)
                 				{
                 					contractedLabel = contractedLabel + " &middot; " + subCode;
                 					if(totalObligation == 0)
                 					{
                 						contractedLabel = "0 Lots Populated &middot; " + subCode;
                 					}
                 				}
                 				html = html + "<div class='fm-builder-sub'>" + contractedLabel + "</div>";
                 				html = html + "</div>";
                 				html = html + "<div class='" + builderUnforecastedClass + "'><div class='fm-builder-stat-k'>Unforecasted Lots</div><div class='fm-builder-stat-v'>" + builderUnforecastedLots.toString() + "</div></div>";
                 				html = html + "</div>";
                 				html = html + "<div class='fm-progress-label'>" + progressLabel + " (" + progressDisplay + ")</div>";
                 				html = html + "<div class='fm-progress-wrap'>";
                 				html = html + "<div class='fm-progress' style='" + progressBarStyle + "'></div>";
                 				html = html + "<div class='fm-progress-meta'>";
                 				builderSalesText = builderLotsSold.toString() + " Lots Sold";
                 				if(builderLotsScheduled > 0)
                 				{
                 					builderSalesText = builderSalesText + " - " + builderLotsScheduled.toString() + " Lots Scheduled";
                 				}
                 				html = html + "<div class='fm-progress-sold'>" + builderSalesText + "</div>";
                 				if(showExpectedLabel)
                 				{
                 					html = html + "<div class='fm-progress-expected' style='left:" + expectedLabelLeft.toString() + "%;'>" + lotsExpected.toString() + " Lots Expected</div>";
                 				}
                 				html = html + "</div>";
                 				html = html + "</div>";
                 				builderMonthSalesText = builderMonthSold.toString() + " of " + builderMonthForecast.toString() + " sold";
                 				html = html + "<div class='fm-month'><div class='fm-month-head'><div class='fm-month-label'>" + monthForecastLabel + "</div><div class='" + builderMonthStatusClass + "'>" + builderMonthSalesText + "</div></div>";
                 				html = html + "<div class='fm-month-track' role='progressbar' aria-label='" + monthForecastLabel + " sold' aria-valuemin='0' aria-valuemax='100' aria-valuenow='" + builderMonthPercent.toLong().toString() + "' aria-valuetext='" + builderMonthSalesText + "'><div class='fm-month-fill' style='width:" + builderMonthPercent.toString() + "%;'></div></div></div>";
                 				html = html + "<table class='fm-table'>";
                 				if(isMultiPhaseSchedule)
                 				{
                 					html = html + "<tr><td>Last Closing Date</td><td>" + lastTakedownText + "</td></tr>";
                 					html = html + "<tr><td>Last Closing (Lots)</td><td>" + lastTakedownAmount.toString() + "</td></tr>";
                 				}
                 				else
                 				{
                 					html = html + "<tr><td>Initial Closing Date</td><td>" + initialCloseText + "</td></tr>";
                 					html = html + "<tr><td>Initial Closing (Lots)</td><td>" + initialTakedown.toString() + "</td></tr>";
                 					html = html + "<tr><td>Initial Closing (Days)</td><td>" + initialDelayDays.toString() + "</td></tr>";
                 					html = html + "<tr><td>Second Closing (Lots)</td><td>" + secondClosingLotsText + "</td></tr>";
                 					html = html + "<tr><td>Second Closing (Days)</td><td>" + secondClosingDaysText + "</td></tr>";
                 					html = html + "<tr><td>Subsequent Closings (Lots)</td><td>" + continuedTakedown.toString() + "</td></tr>";
                 					html = html + "<tr><td>Subsequent Closings (Days)</td><td>" + continuedDays.toString() + "</td></tr>";
                 					html = html + "<tr><td>Takedown End Date</td><td>" + takedownEndText + "</td></tr>";
                 					html = html + "<tr><td>Last Takedown Date</td><td>" + lastTakedownText + "</td></tr>";
                 					html = html + "<tr><td>Last Take (Lots)</td><td>" + lastTakedownAmount.toString() + "</td></tr>";
                 				}
                 				html = html + "</table>";
                 				html = html + "<div style='height:10px;'></div>";
                 				html = html + "<div class='fm-card-title'>Recent Sales</div>";
                 				html = html + "<div class='fm-mini-grid'>";
                 				html = html + "<div class='fm-mini'><div class='fm-mini-k'>Last 30 Day</div><div class='fm-mini-v'>" + last30.toString() + "</div></div>";
                 				html = html + "<div class='fm-mini'><div class='fm-mini-k'>Last 90 Day</div><div class='fm-mini-v'>" + last90.toString() + "</div></div>";
                 				html = html + "<div class='fm-mini'><div class='fm-mini-k'>Last 6 Month</div><div class='fm-mini-v'>" + last6.toString() + "</div></div>";
                 				html = html + "<div class='fm-mini'><div class='fm-mini-k'>Last 12 Month</div><div class='fm-mini-v'>" + last12.toString() + "</div></div>";
                 				html = html + "</div>";
                 				if(isMultiPhaseSchedule)
                 				{
                 					html = html + "<div class='fm-contract-scope'><div class='fm-card-title'>Contract Schedule &mdash; All " + ts.Subdivisions.size().toString() + " Phases</div>";
                 					html = html + "<div class='fm-builder-sub'>" + scheduleObligation.toString() + " Lots Obligated</div>";
                 					html = html + "<div class='fm-progress-label'>Overall Progress (" + contractProgressDisplay + ")</div><div class='fm-progress-wrap'><div class='fm-progress' style='" + contractProgressBarStyle + "'></div><div class='fm-progress-meta'><div class='fm-progress-sold'>" + contractSalesText + "</div></div></div>";
                 					html = html + "<table class='fm-table'>";
                 					html = html + "<tr><td>Initial Closing Date</td><td>" + initialCloseText + "</td></tr>";
                 					html = html + "<tr><td>Initial Closing (Lots)</td><td>" + initialTakedown.toString() + "</td></tr>";
                 					html = html + "<tr><td>Initial Closing (Days)</td><td>" + initialDelayDays.toString() + "</td></tr>";
                 					html = html + "<tr><td>Second Closing (Lots)</td><td>" + secondClosingLotsText + "</td></tr>";
                 					html = html + "<tr><td>Second Closing (Days)</td><td>" + secondClosingDaysText + "</td></tr>";
                 					html = html + "<tr><td>Subsequent Closings (Lots)</td><td>" + continuedTakedown.toString() + "</td></tr>";
                 					html = html + "<tr><td>Subsequent Closings (Days)</td><td>" + continuedDays.toString() + "</td></tr>";
                 					html = html + "<tr><td>Takedown End Date</td><td>" + takedownEndText + "</td></tr>";
                 					html = html + "<tr><td>Lots Expected</td><td>" + lotsExpected.toString() + "</td></tr>";
                 					html = html + "<tr><td>Last 30 Day Sales</td><td>" + ifnull(ts.Last_30_Day_Sales,0).toString() + "</td></tr>";
                 					html = html + "<tr><td>Last 90 Day Sales</td><td>" + ifnull(ts.Last_90_Day_Sales,0).toString() + "</td></tr>";
                 					html = html + "<tr><td>Last 6 Month Sales</td><td>" + ifnull(ts.Last_6_Month_Sales,0).toString() + "</td></tr>";
                 					html = html + "<tr><td>Last 12 Month Sales</td><td>" + ifnull(ts.Last_12_Month_Sales,0).toString() + "</td></tr></table></div>";
                 				}
                 				html = html + "</div>";
                 			}
                 			if(!scheduleFoundForSub)
                 			{
                 				html = html + "<div class='fm-empty'>No Takedown Schedule records were found for this subdivision. Email rbelliveau@wbdevelopment or aarmbrust@wbdevelopment.</div>";
                 			}
                 			html = html + "</div>";
                 			html = html + "</div>";
                 			html = html + "</div>";
                 		}
                 	}
                 	html = html + "</div></div></div>";
                 	return html;
                 }
				 map Calculate_Takedown_Cadence(map terms)
                 {
                 	// PROPOSED new function. This is the three-tier engine only; legacy records
                 	// with neither Second Closing field populated keep their native calculation.
                 	// Initial_Due_Offset_Days is supplied by the calling workflow's date policy.
                 	// Elapsed_Days must be signed; a future start must never be made positive.
                 	result = Map();
                 	result.put("ok",false);
                 	result.put("message","The closing cadence is incomplete or invalid.");
                 	try 
                 	{
                 		requiredFields = {"Total_Lot_Obligation","Initial_Takedown","Initial_Due_Offset_Days","Second_Closing_Lots","Second_Closing_Days","Elapsed_Days"};
                 		complete = true;
                 		for each  fieldName in requiredFields
                 		{
                 			if(terms.get(fieldName) == null || terms.get(fieldName).toString().trim() == "")
                 			{
                 				complete = false;
                 			}
                 		}
                 		if(complete)
                 		{
                 			totalLots = terms.get("Total_Lot_Obligation").toDecimal();
                 			initialLots = terms.get("Initial_Takedown").toDecimal();
                 			initialOffset = terms.get("Initial_Due_Offset_Days").toDecimal();
                 			secondLots = terms.get("Second_Closing_Lots").toDecimal();
                 			secondDays = terms.get("Second_Closing_Days").toDecimal();
                 			// Recurrence may remain blank only when the one-time closings cover
                 			// the obligation. Positive remaining lots require both quantities.
                 			continuedLots = 0;
                 			continuedDays = 0;
                 			if(terms.get("Continued_Takedown") != null && terms.get("Continued_Takedown").toString().trim() != "")
                 			{
                 				continuedLots = terms.get("Continued_Takedown").toDecimal();
                 			}
                 			if(terms.get("Continued_Takedown_Delay_Days") != null && terms.get("Continued_Takedown_Delay_Days").toString().trim() != "")
                 			{
                 				continuedDays = terms.get("Continued_Takedown_Delay_Days").toDecimal();
                 			}
                 			elapsedDays = terms.get("Elapsed_Days").toDecimal();
                 			wholeValues = totalLots == totalLots.floor() && initialLots == initialLots.floor() && initialOffset == initialOffset.floor() && secondLots == secondLots.floor() && secondDays == secondDays.floor() && continuedLots == continuedLots.floor() && continuedDays == continuedDays.floor() && elapsedDays == elapsedDays.floor();
                 			validValues = totalLots > 0 && initialLots >= 0 && initialOffset >= 0 && secondLots > 0 && secondDays >= 0 && continuedLots >= 0 && continuedDays >= 0;
                 			remainingAfterSecond = totalLots - initialLots - secondLots;
                 			recurringValid = remainingAfterSecond <= 0 || (continuedLots > 0 && continuedDays > 0);
                 			if(wholeValues && validValues && recurringValid)
                 			{
                 				secondOffset = initialOffset + secondDays;
                 				endOffset = initialOffset;
                 				if(totalLots > initialLots)
                 				{
                 					endOffset = secondOffset;
                 				}
                 				if(remainingAfterSecond > 0)
                 				{
                 					recurringCount = (remainingAfterSecond / continuedLots).ceil().toLong();
                 					endOffset = secondOffset + recurringCount * continuedDays;
                 				}
                 				expectedLots = 0;
                 				if(elapsedDays >= initialOffset)
                 				{
                 					expectedLots = initialLots;
                 				}
                 				if(elapsedDays >= secondOffset)
                 				{
                 					expectedLots = initialLots + secondLots;
                 					if(remainingAfterSecond > 0)
                 					{
                 						dueRecurringCount = ((elapsedDays - secondOffset) / continuedDays).floor().toLong();
                 						expectedLots = expectedLots + dueRecurringCount * continuedLots;
                 					}
                 				}
                 				if(expectedLots > totalLots)
                 				{
                 					expectedLots = totalLots;
                 				}
                 				result.put("ok",true);
                 				result.put("message","");
                 				result.put("lotsExpected",expectedLots.toLong());
                 				result.put("initialDueOffsetDays",initialOffset.toLong());
                 				result.put("secondDueOffsetDays",secondOffset.toLong());
                 				result.put("endOffsetDays",endOffset.toLong());
                 			}
                 			else if(!recurringValid)
                 			{
                 				result.put("message","Subsequent Closing lots and days must be positive when lots remain after Second Closing.");
                 			}
                 		}
                 	}	catch (calculationError)
                 	{
                 		result.put("ok",false);
                 		result.put("message","The closing cadence contains an invalid number.");
                 	}
                 	return result;
                 }
				 string Claim_Proforma(string proformaId, string userAccessId)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		if(userAccessId == null || userAccessId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No resolved User Access ID was supplied.");
                 			return result.toString();
                 		}
                 		// Get_User_Access already resolved the logged-in Creator user to this
                 		// environment's User_Access record. Do not re-match by email here.
                 		accessRow = User_Access[ID == userAccessId.toLong()];
                 		if(accessRow.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The resolved User Access record could not be found.");
                 			return result.toString();
                 		}
                 		canClaim = accessRow.Edit_Owned_Proformas == true || accessRow.Edit_All_Proformas == true;
                 		if(!canClaim)
                 		{
                 			result.put("success",false);
                 			result.put("message","You do not have permission to claim Pro Formas.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		ownerIds = List();
                 		if(pf.Owner != null)
                 		{
                 			for each  ownerId in pf.Owner
                 			{
                 				ownerIds.add(ownerId);
                 			}
                 		}
                 		if(ownerIds.size() > 0)
                 		{
                 			result.put("success",false);
                 			result.put("message","This Pro Forma already has an owner.");
                 			result.put("ownerIds",ownerIds);
                 			return result.toString();
                 		}
                 		ownerIds.add(accessRow.ID);
                 		pf.Owner=ownerIds;
                 		result.put("success",true);
                 		result.put("message","Pro Forma claimed.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("ownerId",accessRow.ID.toString());
                 		result.put("ownerIds",ownerIds);
                 		result.put("owner",accessRow.User.toString());
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message",e.toString());
                 	}
                 	return result.toString();
                 }
				 string Complete_Lot_Contract(string contractId)
                 {
                 	/*  Server-side half of "complete a Lot contract". Widget 1.60.55 verifies
                 	    the captured Lot outcomes before closing actions and setting the parent
                 	    Contract.Status to Complete. Its final Lot check is read-only. This
                 	    function deliberately does NOT touch Contract.Status or close actions.
                 
                 	    Writes performed here:
                 	      Takedown_Schedule created (once per Subdivision_Code - Builder_Name)
                 	      each eligible priced lot: absent Base_Price, Escalator, Contract1,
                 	      Contract_Schedule; unassigned/Placeholder Builder1; Status LAST
                 	      Contract.Completion_Date when it is still blank
                 
                 	    Response contract - consumed by widget 1.60.55:
                 	      error        hard stop; the widget throws on it and writes nothing else
                 	      updated      lot codes written            (audit log)
                 	      skipped      lot codes with incomplete transfer outcomes (audit log)
                 	      scheduleCode the takedown code
                 	      scheduleId   used to verify the saved Contract_Schedule
                 	      outcomes     exact before/after snapshots, intended fields and verification
                 	      lotTransferPolicy required by the read-only capability check and write ack
                 	    "steps" is additive, for the completion progress modal. It reports only
                 	    the steps THIS function performs; the widget contributes its own.        */
                 	resp = Map();
                 	updatedList = List();
                 	skippedList = List();
                 	steps = List();
                 	requestedIds = List();
                 	updatedIds = List();
                 	linkedIds = List();
                 	preserved = List();
                 	skippedLots = List();
                 	outcomes = List();
                 	lotSnapshots = List();
                 	placeholderBuilderIds = List();
                 	policy = "open-blank-placeholder-v1";
                 	/* arrives either as a bare id (thisapp call) or as the Entire JSON body
                 	   of the Custom API ({"contractId":"..."}) - accept both */
                 	raw = contractId.trim();
                 	cid = 0;
                 	mode = "Complete";
                 	pm = Map();
                 	if(raw.startsWith("{"))
                 	{
                 		pm = raw.toMap();
                 		if(pm.get("mode") != null)
                 		{
                 			mode = pm.get("mode").toString();
                 		}
                 		if(pm.get("contractId") != null)
                 		{
                 			cid = pm.get("contractId").toLong();
                 		}
                 	}
                 	else if(raw != "")
                 	{
                 		cid = raw.toLong();
                 	}
                 	if(cid == 0)
                 	{
                 		resp.put("error","Missing contractId");
                 		return resp.toString();
                 	}
                 	c = Contract[ID == cid];
                 	if(c.count() == 0)
                 	{
                 		resp.put("error","Contract not found");
                 		return resp.toString();
                 	}
                 	if(c.Contract_Type != "Lot" && c.Contract_Type != "Lot (Master)" && c.Contract_Type != "Lot (Amendment)")
                 	{
                 		resp.put("error","Not a Lot contract");
                 		return resp.toString();
                 	}
                 	if(mode != "Check" && mode != "Complete" && mode != "LinkOnly")
                 	{
                 		resp.put("error","Unsupported Lot transfer mode.");
                 		return resp.toString();
                 	}
                 	for each  placeholder in Builder[Builder_Name == "Placeholder"]
                 	{
                 		placeholderBuilderIds.add(placeholder.ID.toString());
                 	}
                 	contractLotIds = List();
                 	for each  selectedLotId in c.Lots1
                 	{
                 		contractLotIds.add(selectedLotId.toString());
                 	}
                 	resp.put("contractId",cid.toString());
                 	resp.put("mode",mode);
                 	resp.put("lotTransferPolicy",policy);
                 	resp.put("placeholderBuilderIds",placeholderBuilderIds);
                 	builderId = null;
                 	if(c.Builder != null)
                 	{
                 		builderId = c.Builder.toString();
                 	}
                 	resp.put("builderId",builderId);
                 	resp.put("preserveExisting",true);
                 	if(mode == "Check")
                 	{
                 		resp.put("lotIds",contractLotIds);
                 		return resp.toString();
                 	}
                 	if(ifnull(c.Status,"").toString() == "Complete")
                 	{
                 		resp.put("error","This contract is complete and read-only.");
                 		return resp.toString();
                 	}
                 	if(pm.get("lotIds") != null)
                 	{
                 		for each  suppliedLotId in pm.get("lotIds")
                 		{
                 			requestedId = suppliedLotId.toString();
                 			if(!contractLotIds.contains(requestedId) || requestedIds.contains(requestedId))
                 			{
                 				resp.put("error","The captured Lot IDs do not match this contract.");
                 				return resp.toString();
                 			}
                 			requestedIds.add(requestedId);
                 		}
                 	}
                 	else if(mode == "LinkOnly")
                 	{
                 		resp.put("error","LinkOnly requires captured Lot IDs.");
                 		return resp.toString();
                 	}
                 	else
                 	{
                 		requestedIds.addAll(contractLotIds);
                 	}
                 	if(mode == "Complete" && requestedIds.size() != contractLotIds.size())
                 	{
                 		resp.put("error","The contract Lot selection changed. Refresh before completing.");
                 		return resp.toString();
                 	}
                 	if(mode == "Complete" && c.Builder == null || c.Builder.Builder_Name == "Placeholder" && c.Subdivision1.size() > 0 || c.Lots1.size() > 0)
                 	{
                 		resp.put("error","Choose a real contract buyer before completing.");
                 		return resp.toString();
                 	}
                 	resp.put("requestedIds",requestedIds);
                 	// LinkOnly performs no schedule, takedown-term or completion-date writes.
                 	if(mode == "Complete")
                 	{
                 		if(c.Contract_Type == "Lot (Amendment)" && c.Subdivision1.size() == 0)
                 		{
                 			resp.put("error","Choose a subdivision before completing a Lot (Amendment).");
                 			return resp.toString();
                 		}
                 		if(c.Parent_Contract != null)
                 		{
                 			parentChildren = Contract[Parent_Contract == cid];
                 			if(parentChildren.count() > 0)
                 			{
                 				resp.put("error","A Master with child contracts cannot be assigned a parent.");
                 				return resp.toString();
                 			}
                 			parent = Contract[ID == c.Parent_Contract];
                 			if(parent.count() == 0 || parent.ID == cid || parent.Parent_Contract != null || (c.Contract_Type == "Lot (Amendment)" && (parent.Contract_Type != "Lot (Master)" && parent.Contract_Type != "Lot") || c.Builder == null || parent.Builder != c.Builder || parent.Project != c.Project))
                 			{
                 				resp.put("error","Choose a top-level parent; Lot Amendments require a Lot Master with the same Project and builder / counterparty.");
                 				return resp.toString();
                 			}
                 		}
                 		// A company-level Master may be completed before subdivisions and lots are known.
                 		if(c.Subdivision1.size() == 0 && c.Lots1.size() == 0)
                 		{
                 			for each  stepKey in {"validate","takedown","lots"}
                 			{
                 				step = Map();
                 				step.put("key",stepKey);
                 				step.put("state","skipped");
                 				step.put("detail","Master has no subdivision or lots; no schedule or Lot fields written.");
                 				steps.add(step);
                 			}
                 			if(c.Completion_Date == null)
                 			{
                 				c.Completion_Date=zoho.currentdate;
                 			}
                 			resp.put("steps",steps);
                 			resp.put("updated",updatedList);
                 			resp.put("skipped",skippedList);
                 			resp.put("updatedIds",updatedIds);
                 			resp.put("linkedIds",linkedIds);
                 			resp.put("preserved",preserved);
                 			resp.put("skippedLots",skippedLots);
                 			resp.put("outcomes",outcomes);
                 			resp.put("lots",lotSnapshots);
                 			return resp.toString();
                 		}
                 		// Refuse a conflicting association before creating schedules or writing lots.
                 		for each  lotId in c.Lots1
                 		{
                 			otherContracts = Contract[Lots1 == lotId && ID != cid];
                 			if(otherContracts.count() > 0)
                 			{
                 				resp.put("error","A selected lot belongs to another contract. Remove it before completing.");
                 				return resp.toString();
                 			}
                 		}
                 		/* ---- step: takedown details present ----------------------------------
                 	   Mirrors the "Lot Contract Required Fields" form workflow. The widget
                 	   already blocks on this, so it is a backstop: without it a schedule can
                 	   be created carrying a null obligation. A cleared Creator number field
                 	   can read back as an empty string, so both forms are treated as missing. */
                 		missing = List();
                 		if(ifnull(c.Number_of_Lots,"").toString().trim() == "")
                 		{
                 			missing.add("Lot Total");
                 		}
                 		if(ifnull(c.Initial_Takedown,"").toString().trim() == "")
                 		{
                 			missing.add("Initial Closing (Lots)");
                 		}
                 		if(ifnull(c.Initial_Takedown_Days,"").toString().trim() == "")
                 		{
                 			missing.add("Initial Closing (Days)");
                 		}
                 		// Both blank preserves untouched legacy terms; new/edited terms require this pair.
                 		if(c.Second_Closing_Lots != null || c.Second_Closing_Days != null)
                 		{
                 			if(c.Number_of_Lots == null || c.Number_of_Lots <= 0)
                 			{
                 				missing.add("Total lots: positive whole number");
                 			}
                 			else if(c.Number_of_Lots.toDecimal() != c.Number_of_Lots.toDecimal().floor())
                 			{
                 				missing.add("Total lots: positive whole number");
                 			}
                 			if(c.Initial_Takedown == null || c.Initial_Takedown < 0)
                 			{
                 				missing.add("Initial Closing (Lots): whole number of zero or more");
                 			}
                 			else if(c.Initial_Takedown.toDecimal() != c.Initial_Takedown.toDecimal().floor())
                 			{
                 				missing.add("Initial Closing (Lots): whole number of zero or more");
                 			}
                 			if(c.Initial_Takedown_Days == null || c.Initial_Takedown_Days < 0)
                 			{
                 				missing.add("Initial Closing (Days): whole number of zero or more");
                 			}
                 			else if(c.Initial_Takedown_Days.toDecimal() != c.Initial_Takedown_Days.toDecimal().floor())
                 			{
                 				missing.add("Initial Closing (Days): whole number of zero or more");
                 			}
                 			if(c.Second_Closing_Lots == null || c.Second_Closing_Lots <= 0)
                 			{
                 				missing.add("Second Closing (Lots): positive whole number");
                 			}
                 			else if(c.Second_Closing_Lots.toDecimal() != c.Second_Closing_Lots.toDecimal().floor())
                 			{
                 				missing.add("Second Closing (Lots): positive whole number");
                 			}
                 			if(c.Second_Closing_Days == null || c.Second_Closing_Days < 0)
                 			{
                 				missing.add("Second Closing (Days): zero or more");
                 			}
                 			else if(c.Second_Closing_Days.toDecimal() != c.Second_Closing_Days.toDecimal().floor())
                 			{
                 				missing.add("Second Closing (Days): whole number of zero or more");
                 			}
                 			if(ifnull(c.Number_of_Lots,0) > ifnull(c.Initial_Takedown,0) + ifnull(c.Second_Closing_Lots,0))
                 			{
                 				if(ifnull(c.Subsequent_Takedown_Lots,0) <= 0 || ifnull(c.Subsequent_Takedown_Days,0) <= 0)
                 				{
                 					missing.add("Subsequent Closing lots and days must be positive while lots remain");
                 				}
                 			}
                 			if(c.Subsequent_Takedown_Lots != null)
                 			{
                 				if(c.Subsequent_Takedown_Lots < 0 || c.Subsequent_Takedown_Lots.toDecimal() != c.Subsequent_Takedown_Lots.toDecimal().floor())
                 				{
                 					missing.add("Subsequent Closing (Lots): whole number of zero or more");
                 				}
                 			}
                 			if(c.Subsequent_Takedown_Days != null)
                 			{
                 				if(c.Subsequent_Takedown_Days < 0 || c.Subsequent_Takedown_Days.toDecimal() != c.Subsequent_Takedown_Days.toDecimal().floor())
                 				{
                 					missing.add("Subsequent Closing (Days): whole number of zero or more");
                 				}
                 			}
                 		}
                 		recurringRequired = c.Second_Closing_Lots == null || c.Second_Closing_Days == null || ifnull(c.Number_of_Lots,0) > ifnull(c.Initial_Takedown,0) + ifnull(c.Second_Closing_Lots,0);
                 		if(recurringRequired && ifnull(c.Subsequent_Takedown_Lots,"").toString().trim() == "")
                 		{
                 			missing.add("Subsequent Closings (Lots)");
                 		}
                 		if(recurringRequired && ifnull(c.Subsequent_Takedown_Days,"").toString().trim() == "")
                 		{
                 			missing.add("Subsequent Closings (Days)");
                 		}
                 		sVal = Map();
                 		sVal.put("key","validate");
                 		sVal.put("label","Takedown details validated");
                 		if(missing.size() > 0)
                 		{
                 			sVal.put("state","failed");
                 			sVal.put("detail","Missing: " + missing.toString(", "));
                 			sVal.put("missing",missing);
                 			steps.add(sVal);
                 			resp.put("steps",steps);
                 			resp.put("error","Add all Lot Takedown details before completing: " + missing.toString(", "));
                 			return resp.toString();
                 		}
                 		sVal.put("state","done");
                 		closingDetail = c.Number_of_Lots.toString() + " lots · " + c.Initial_Takedown.toString() + " initial / " + c.Initial_Takedown_Days.toString() + " days";
                 		if(c.Second_Closing_Lots != null && c.Second_Closing_Days != null)
                 		{
                 			closingDetail = closingDetail + " · " + c.Second_Closing_Lots.toString() + " second / " + c.Second_Closing_Days.toString() + " days after initial due";
                 		}
                 		if(c.Subsequent_Takedown_Lots != null && c.Subsequent_Takedown_Days != null)
                 		{
                 			closingDetail = closingDetail + " · " + c.Subsequent_Takedown_Lots.toString() + " subsequent / " + c.Subsequent_Takedown_Days.toString() + " days";
                 		}
                 		sVal.put("detail",closingDetail);
                 		steps.add(sVal);
                 		/* ---- step: takedown schedule ---------------------------------------- */
                 		sTd = Map();
                 		sTd.put("key","takedown");
                 		sTd.put("label","Takedown Schedule created");
                 		phaseCodes = List();
                 		for each  subId in c.Subdivision1
                 		{
                 			sub = Subdivision[ID == subId];
                 			if(sub.ID != null)
                 			{
                 				phaseCodes.add(ifnull(sub.Subdivision_Code,"").toString());
                 			}
                 		}
                 		phaseCodes.sort();
                 		tdCode = phaseCodes.toString("+") + " - " + c.Builder.Builder_Name;
                 		overlaps = List();
                 		for each  subId in c.Subdivision1
                 		{
                 			for each  other in Takedown_Schedule[Builder1 == c.Builder && Subdivisions == subId && Takedown_Schedule_Code != tdCode]
                 			{
                 				if(!overlaps.contains(other.Takedown_Schedule_Code))
                 				{
                 					overlaps.add(other.Takedown_Schedule_Code);
                 				}
                 			}
                 		}
                 		tdsched = Takedown_Schedule[Takedown_Schedule_Code == tdCode];
                 		tdExisted = tdsched.count() > 0;
                 		if(tdsched.count() == 0)
                 		{
                 			insert into Takedown_Schedule
                 			[
                 				Added_User=zoho.loginuser
                 				Subdivisions=c.Subdivision1
                 				Builder1=c.Builder
                 				Status="Active"
                 				Total_Lot_Obligation=c.Number_of_Lots
                 				Initial_Takedown=c.Initial_Takedown
                 				Initial_Delay_Days=c.Initial_Takedown_Days
                 				Second_Closing_Lots=c.Second_Closing_Lots
                 				Second_Closing_Days=c.Second_Closing_Days
                 				Continued_Takedown=c.Subsequent_Takedown_Lots
                 				Continued_Takedown_Delay_Days=c.Subsequent_Takedown_Days
                 				Add_Contract_Contract_Name=cid
                 				Takedown_Schedule_Code=tdCode
                 			]
                 			tdsched = Takedown_Schedule[Takedown_Schedule_Code == tdCode];
                 		}
                 		sTd.put("code",tdCode);
                 		sTd.put("phases",phaseCodes);
                 		sTd.put("overlaps",overlaps);
                 		if(overlaps.size() > 0)
                 		{
                 			sTd.put("detail",tdCode + " · overlaps existing schedule(s): " + overlaps.toString(", "));
                 		}
                 		if(tdsched.count() > 0)
                 		{
                 			sTd.put("scheduleId",tdsched.ID.toString());
                 		}
                 		if(tdExisted)
                 		{
                 			sTd.put("state","skipped");
                 			sTd.put("detail",tdCode + " already existed - nothing was changed.");
                 		}
                 		else
                 		{
                 			sTd.put("state","done");
                 			sTd.put("detail",tdCode + " · " + c.Number_of_Lots.toString() + " lot obligation");
                 		}
                 		steps.add(sTd);
                 	}
                 	/* ---- guarded per-Lot transfer ---------------------------------------
                 	   Every native update repeats the captured lifecycle and null-field guard.
                 	   This is conditional protection, not a claim of transaction isolation. */
                 	unmatchedSizes = List();
                 	lotTotal = 0;
                 	for each  requestedId in requestedIds
                 	{
                 		lotId = requestedId.toLong();
                 		lotRow = Lots[ID == lotId];
                 		outcome = Map();
                 		outcome.put("id",requestedId);
                 		fields = List();
                 		before = Map();
                 		after = Map();
                 		expected = Map();
                 		reason = "";
                 		state = "preserved";
                 		if(lotRow.count() == 1)
                 		{
                 			lotTotal = lotTotal + 1;
                 			before.put("ID",lotRow.ID.toString());
                 			before.put("Lot_Size",lotRow.Lot_Size);
                 			before.put("Base_Price",lotRow.Base_Price);
                 			before.put("Escalator",lotRow.Escalator);
                 			before.put("Status",lotRow.Status);
                 			before.put("Close_Date",lotRow.Close_Date);
                 			before.put("Purchase_Date",lotRow.Purchase_Date);
                 			before.put("Builder1",null);
                 			before.put("Builder_Name",null);
                 			before.put("Contract1",null);
                 			before.put("Contract_Schedule",null);
                 			if(lotRow.Builder1 != null)
                 			{
                 				before.put("Builder1",lotRow.Builder1.toString());
                 				before.put("Builder_Name",lotRow.Builder1.Builder_Name);
                 			}
                 			if(lotRow.Contract1 != null)
                 			{
                 				before.put("Contract1",lotRow.Contract1.toString());
                 			}
                 			if(lotRow.Contract_Schedule != null)
                 			{
                 				before.put("Contract_Schedule",lotRow.Contract_Schedule.toString());
                 			}
                 			for each  snapshotField in {"ID","Lot_Size","Base_Price","Escalator","Status","Close_Date","Purchase_Date","Builder1","Builder_Name","Contract1","Contract_Schedule"}
                 			{
                 				expected.put(snapshotField,before.get(snapshotField));
                 			}
                 			statusBefore = lotRow.Status;
                 			buyerBefore = lotRow.Builder1;
                 			sizeBefore = lotRow.Lot_Size;
                 			lotStatus = ifnull(statusBefore,"").trim();
                 			otherContracts = Contract[Lots1 == lotId && ID != cid];
                 			if(lotStatus != "" && lotStatus != "Open")
                 			{
                 				reason = "The Lot is not Open or blank.";
                 			}
                 			else if(lotRow.Close_Date != null || lotRow.Purchase_Date != null)
                 			{
                 				reason = "The Lot already has a purchase or close date.";
                 			}
                 			else if(lotRow.Contract1 != null && lotRow.Contract1 != cid)
                 			{
                 				reason = "The Lot already links another contract.";
                 			}
                 			else if(otherContracts.count() > 0)
                 			{
                 				reason = "Another contract claims the Lot.";
                 			}
                 			else if(buyerBefore != null && lotRow.Builder1.Builder_Name != "Placeholder" && mode != "LinkOnly" || buyerBefore != c.Builder)
                 			{
                 				reason = "The Lot already has a real buyer.";
                 			}
                 			else if(mode == "Complete" && lotRow.Contract_Schedule != null && lotRow.Contract_Schedule != tdsched.ID)
                 			{
                 				reason = "The Lot already links another schedule.";
                 			}
                 			if(reason == "" && mode == "LinkOnly")
                 			{
                 				if(lotRow.Contract1 == null)
                 				{
                 					fields.add("Contract1");
                 					expected.put("Contract1",cid.toString());
                 					writeClaims = Contract[Lots1 == lotId && ID != cid];
                 					writeParent = Contract[ID == cid && Lots1 == lotId];
                 					if(writeClaims.count() == 0 && writeParent.count() == 1)
                 					{
                 						update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" || Builder1 == c.Builder && Contract1 == null]
                 						[
                 							Contract1=cid
                 						];
                 					}
                 				}
                 				else
                 				{
                 					reason = "The Lot already links this contract.";
                 				}
                 			}
                 			else if(reason == "" && mode == "Complete")
                 			{
                 				if(sizeBefore == null)
                 				{
                 					reason = "The Lot has no size to match pricing.";
                 					state = "skipped";
                 				}
                 				else
                 				{
                 					pr = Contract_Pricing[Contract1 == cid && Lot_Size == sizeBefore];
                 					if(pr.count() != 1)
                 					{
                 						reason = "Exactly one pricing row is required for this Lot size.";
                 						state = "skipped";
                 						if(!unmatchedSizes.contains(sizeBefore))
                 						{
                 							unmatchedSizes.add(sizeBefore);
                 						}
                 					}
                 					else
                 					{
                 						// Conditional updates preserve populated financial and link fields.
                 						// The captured size must still match the unique pricing row.
                 						if(lotRow.Base_Price == null && pr.Base_Price != null)
                 						{
                 							fields.add("Base_Price");
                 							expected.put("Base_Price",pr.Base_Price);
                 							writeClaims = Contract[Lots1 == lotId && ID != cid];
                 							writeParent = Contract[ID == cid && Lots1 == lotId];
                 							if(writeClaims.count() == 0 && writeParent.count() == 1)
                 							{
                 								update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" && Contract1 == null || Contract1 == cid && Contract_Schedule == null || Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Base_Price == null]
                 								[
                 									Base_Price=pr.Base_Price
                 								];
                 							}
                 						}
                 						if(lotRow.Escalator == null && pr.Escalator != null)
                 						{
                 							fields.add("Escalator");
                 							expected.put("Escalator",pr.Escalator);
                 							writeClaims = Contract[Lots1 == lotId && ID != cid];
                 							writeParent = Contract[ID == cid && Lots1 == lotId];
                 							if(writeClaims.count() == 0 && writeParent.count() == 1)
                 							{
                 								update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" && Contract1 == null || Contract1 == cid && Contract_Schedule == null || Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Escalator == null]
                 								[
                 									Escalator=pr.Escalator
                 								];
                 							}
                 						}
                 						if(lotRow.Contract1 == null)
                 						{
                 							fields.add("Contract1");
                 							expected.put("Contract1",cid.toString());
                 							writeClaims = Contract[Lots1 == lotId && ID != cid];
                 							writeParent = Contract[ID == cid && Lots1 == lotId];
                 							if(writeClaims.count() == 0 && writeParent.count() == 1)
                 							{
                 								update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" && Contract1 == null || Contract1 == cid && Contract_Schedule == null || Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Contract1 == null]
                 								[
                 									Contract1=cid
                 								];
                 							}
                 						}
                 						if(lotRow.Contract_Schedule == null && tdsched.count() > 0)
                 						{
                 							fields.add("Contract_Schedule");
                 							expected.put("Contract_Schedule",tdsched.ID.toString());
                 							writeClaims = Contract[Lots1 == lotId && ID != cid];
                 							writeParent = Contract[ID == cid && Lots1 == lotId];
                 							if(writeClaims.count() == 0 && writeParent.count() == 1)
                 							{
                 								update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" && Contract1 == null || Contract1 == cid && Contract_Schedule == null || Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Contract_Schedule == null]
                 								[
                 									Contract_Schedule=tdsched.ID
                 								];
                 							}
                 						}
                 						if(buyerBefore == null || lotRow.Builder1.Builder_Name == "Placeholder" && c.Builder != null)
                 						{
                 							fields.add("Builder1");
                 							expected.put("Builder1",c.Builder.toString());
                 							writeClaims = Contract[Lots1 == lotId && ID != cid];
                 							writeParent = Contract[ID == cid && Lots1 == lotId];
                 							if(writeClaims.count() == 0 && writeParent.count() == 1)
                 							{
                 								update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == buyerBefore && Builder1 == null || Builder1.Builder_Name == "Placeholder" && Contract1 == null || Contract1 == cid && Contract_Schedule == null || Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Builder1 == buyerBefore]
                 								[
                 									Builder1=c.Builder
                 								];
                 							}
                 						}
                 						expected.put("Builder_Name",c.Builder.Builder_Name);
                 						// Status is last and requires every intended fill to be present.
                 						fields.add("Status");
                 						expected.put("Status","Contracted");
                 						writeClaims = Contract[Lots1 == lotId && ID != cid];
                 						writeParent = Contract[ID == cid && Lots1 == lotId];
                 						expectedBase = expected.get("Base_Price");
                 						expectedEscalator = expected.get("Escalator");
                 						if(writeClaims.count() == 0 && writeParent.count() == 1 && c.Builder != null && tdsched.count() > 0)
                 						{
                 							update Lots[ID == lotId && Status == statusBefore && Close_Date == null && Purchase_Date == null && Builder1 == c.Builder && Contract1 == cid && Contract_Schedule == tdsched.ID && Lot_Size == sizeBefore && Base_Price == expectedBase && Escalator == expectedEscalator]
                 							[
                 								Status="Contracted"
                 							];
                 						}
                 					}
                 				}
                 			}
                 			lotRow = Lots[ID == lotId];
                 			if(lotRow.count() == 1)
                 			{
                 				after.put("ID",lotRow.ID.toString());
                 				after.put("Lot_Size",lotRow.Lot_Size);
                 				after.put("Base_Price",lotRow.Base_Price);
                 				after.put("Escalator",lotRow.Escalator);
                 				after.put("Status",lotRow.Status);
                 				after.put("Close_Date",lotRow.Close_Date);
                 				after.put("Purchase_Date",lotRow.Purchase_Date);
                 				after.put("Builder1",null);
                 				after.put("Builder_Name",null);
                 				after.put("Contract1",null);
                 				after.put("Contract_Schedule",null);
                 				if(lotRow.Builder1 != null)
                 				{
                 					after.put("Builder1",lotRow.Builder1.toString());
                 					after.put("Builder_Name",lotRow.Builder1.Builder_Name);
                 				}
                 				if(lotRow.Contract1 != null)
                 				{
                 					after.put("Contract1",lotRow.Contract1.toString());
                 				}
                 				if(lotRow.Contract_Schedule != null)
                 				{
                 					after.put("Contract_Schedule",lotRow.Contract_Schedule.toString());
                 				}
                 			}
                 		}
                 		else
                 		{
                 			reason = "The exact Lot could not be read.";
                 			state = "skipped";
                 		}
                 		verified = before.size() > 0 && after.size() > 0;
                 		verificationClaims = Contract[Lots1 == lotId && ID != cid];
                 		verificationParent = Contract[ID == cid && Lots1 == lotId];
                 		if(verificationClaims.count() > 0 || verificationParent.count() != 1)
                 		{
                 			verified = false;
                 		}
                 		for each  snapshotField in {"ID","Lot_Size","Base_Price","Escalator","Status","Close_Date","Purchase_Date","Builder1","Builder_Name","Contract1","Contract_Schedule"}
                 		{
                 			if(expected.get(snapshotField) != after.get(snapshotField))
                 			{
                 				verified = false;
                 			}
                 		}
                 		if(fields.size() > 0)
                 		{
                 			if(verified)
                 			{
                 				state = "updated";
                 				updatedIds.add(requestedId);
                 				if(mode == "Complete")
                 				{
                 					updatedList.add(lotRow.Lot_Code);
                 				}
                 			}
                 			else
                 			{
                 				state = "partial";
                 				reason = "The Lot changed or an intended fill did not verify.";
                 			}
                 		}
                 		if(verified && after.get("Contract1") == cid.toString())
                 		{
                 			linkedIds.add(requestedId);
                 		}
                 		outcome.put("state",state);
                 		outcome.put("reason",reason);
                 		outcome.put("fields",fields);
                 		outcome.put("before",before);
                 		outcome.put("after",after);
                 		outcome.put("verified",verified);
                 		outcomes.add(outcome);
                 		if(after.size() > 0)
                 		{
                 			lotSnapshots.add(after);
                 		}
                 		if(state == "preserved")
                 		{
                 			preserved.add(outcome);
                 		}
                 		else if(state == "skipped" || state == "partial")
                 		{
                 			skippedLots.add(outcome);
                 			if(mode == "Complete" && lotRow.count() > 0)
                 			{
                 				skippedList.add(lotRow.Lot_Code);
                 			}
                 		}
                 	}
                 	resp.put("updatedIds",updatedIds);
                 	resp.put("linkedIds",linkedIds);
                 	resp.put("preserved",preserved);
                 	resp.put("skippedLots",skippedLots);
                 	resp.put("outcomes",outcomes);
                 	resp.put("lots",lotSnapshots);
                 	if(mode == "LinkOnly")
                 	{
                 		resp.put("skipped",skippedLots);
                 		return resp.toString();
                 	}
                 	sLots = Map();
                 	sLots.put("key","lots");
                 	sLots.put("label","Lots updated");
                 	sLots.put("updated",updatedList.size());
                 	sLots.put("total",lotTotal);
                 	sLots.put("unmatchedSizes",unmatchedSizes);
                 	sLots.put("unmatchedLots",skippedList);
                 	if(lotTotal == 0)
                 	{
                 		sLots.put("state","skipped");
                 		sLots.put("detail","No lots are linked to this contract");
                 	}
                 	else if(skippedList.size() == 0)
                 	{
                 		sLots.put("state","done");
                 		sLots.put("detail",lotTotal.toString() + " lots checked; eligible fields filled and existing Lots preserved");
                 	}
                 	else
                 	{
                 		sLots.put("state","partial");
                 		sLots.put("detail",skippedLots.size().toString() + " Lots need review; see each Lot result");
                 	}
                 	steps.add(sLots);
                 	if(c.Completion_Date == null)
                 	{
                 		c.Completion_Date=zoho.currentdate;
                 	}
                 	resp.put("updated",updatedList);
                 	resp.put("skipped",skippedList);
                 	resp.put("scheduleCode",tdCode);
                 	if(tdsched.count() > 0)
                 	{
                 		resp.put("scheduleId",tdsched.ID.toString());
                 	}
                 	resp.put("steps",steps);
                 	return resp.toString();
                 }
				 string createBudgetAttachmentRecord(string budgetId)
                 {
                 	/********* CREATE EMPTY CHILD RECORD FOR WIDGET FILE UPLOAD *********/
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	if(vBudgetId == "")
                 	{
                 		return "{\"ok\":false,\"message\":\"Missing Budget ID.\"}";
                 	}
                 	budgetRows = Add_Budget[ID == vBudgetId.toLong()];
                 	if(budgetRows.count() == 0)
                 	{
                 		return "{\"ok\":false,\"message\":\"Budget not found.\"}";
                 	}
                 	try 
                 	{
                 		attachmentId = insert into Attachment
                 		[
                 			Budget=vBudgetId.toLong()
                 			Date_field1=zoho.currenttime
                 			Email_Attachment=false
                 			Added_User=zoho.loginuser
                 		];
                 		resp = Map();
                 		resp.put("ok",true);
                 		resp.put("attachmentId",attachmentId.toString());
                 		resp.put("message","Attachment record created.");
                 		return resp.toString();
                 	}	catch (createError)
                 	{
                 		resp = Map();
                 		resp.put("ok",false);
                 		resp.put("message","Attachment record creation failed: " + createError.toString());
                 		return resp.toString();
                 	}
                 	return "gj";
                 }
				 string createBudgetFromSubdivision(string subdivisionId, string action)
                 {
                 	result = Map();
                 	result.put("success",false);
                 	result.put("verified",false);
                 	result.put("writeStarted",false);
                 	result.put("subdivisionId",ifnull(subdivisionId,"").trim());
                 	newBudget = 0;
                 	try 
                 	{
                 		accessRow = User_Access[User == zoho.loginuser];
                 		if(accessRow.count() != 1 || (accessRow.Edit_All_Budgets != true && accessRow.Edit_Owned_Budgets != true))
                 		{
                 			result.put("error","Budget edit access is required.");
                 			return result.toString();
                 		}
                 		subdivisionKey = ifnull(subdivisionId,"").trim().toLong();
                 		subdivisionRow = Subdivision[ID == subdivisionKey];
                 		if(subdivisionRow.count() != 1 || ifnull(subdivisionRow.Subdivision_Code,"").trim() == "")
                 		{
                 			result.put("error","Select a subdivision with a subdivision code.");
                 			return result.toString();
                 		}
                 		actionText = ifnull(action,"").trim().toLowerCase();
                 		if(actionText != "create" && actionText != "check")
                 		{
                 			result.put("error","Action must be create or check.");
                 			return result.toString();
                 		}
                 		existingBudgets = Add_Budget[Subdivision1 == subdivisionKey || Subdivision_Code == subdivisionRow.Subdivision_Code];
                 		if(actionText == "create" && existingBudgets.count() > 0)
                 		{
                 			result.put("error","This subdivision already has a budget, including archived budgets.");
                 			return result.toString();
                 		}
                 		templateCategories = Budget_Category[Template_Item == true];
                 		expectedItems = 0;
                 		for each  templateCategory in templateCategories
                 		{
                 			expectedItems = expectedItems + Budget_Item[Template_Item == true && Category == templateCategory.Budget_Category_Name].count();
                 		}
                 		if(templateCategories.count() == 0 || expectedItems == 0)
                 		{
                 			result.put("error","Budget templates are unavailable.");
                 			return result.toString();
                 		}
                 		if(actionText == "create")
                 		{
                 			mappings = External_System_Mapping[Subdivision1 == subdivisionKey && External_System == "HeavyJob" && External_Code != null];
                 			if(mappings.count() == 0)
                 			{
                 				result.put("error","A HeavyJob mapping is required for this subdivision.");
                 				return result.toString();
                 			}
                 			result.put("writeStarted",true);
                 			newBudget = insert into Add_Budget
                 			[
                 				Subdivision1=subdivisionKey
                 				Added_User=zoho.loginuser
                 				Budget_Type="Development"
                 				Budget_Name=subdivisionRow.Subdivision_Code + " - " + zoho.currentdate
                 				Subdivision_Code=subdivisionRow.Subdivision_Code
                 			];
                 			newBudgetRec = Add_Budget[ID == newBudget];
                 			owners = List();
                 			owners.add(accessRow.ID);
                 			newBudgetRec.Budget_Owner=owners;
                 			row1 = Add_Budget.Approvals();
                 			row1.Approver="VP@wbdevelopment.com";
                 			row1.Title="VP";
                 			row1.Status="Not Sent";
                 			row1.Type1="Construction";
                 			row1.Sort_Order=1;
                 			row2 = Add_Budget.Approvals();
                 			row2.Approver="jking@wbdevelopment.com";
                 			row2.Title="CFO";
                 			row2.Status="Not Sent";
                 			row2.Type1="Construction";
                 			row2.Sort_Order=2;
                 			row3 = Add_Budget.Approvals();
                 			row3.Approver="dreinke@wbdevelopment.com";
                 			row3.Title="COO";
                 			row3.Status="Not Sent";
                 			row3.Type1="Construction";
                 			row3.Sort_Order=3;
                 			row5 = Add_Budget.Approvals();
                 			row5.Approver="VP@wbdevelopment.com";
                 			row5.Title="VP";
                 			row5.Status="Not Sent";
                 			row5.Type1="Development";
                 			row5.Sort_Order=1;
                 			row6 = Add_Budget.Approvals();
                 			row6.Approver="jking@wbdevelopment.com";
                 			row6.Title="CFO";
                 			row6.Status="Not Sent";
                 			row6.Type1="Development";
                 			row6.Sort_Order=2;
                 			row7 = Add_Budget.Approvals();
                 			row7.Approver="dreinke@wbdevelopment.com";
                 			row7.Title="COO";
                 			row7.Status="Not Sent";
                 			row7.Type1="Development";
                 			row7.Sort_Order=3;
                 			approvalRows = Collection();
                 			approvalRows.insert(row1);
                 			approvalRows.insert(row2);
                 			approvalRows.insert(row3);
                 			approvalRows.insert(row5);
                 			approvalRows.insert(row6);
                 			approvalRows.insert(row7);
                 			newBudgetRec.Approvals.insert(approvalRows);
                 			budgetCategories = Budget_Category[Template_Item == true];
                 			for each  category in budgetCategories
                 			{
                 				newBudgetCategory = insert into Budget_Category
                 				[
                 					Budget_Category_Name=category.Budget_Category_Name
                 					Budget=newBudget
                 					Category_Code=category.Category_Code
                 					Template_Item=false
                 					Added_User=zoho.loginuser
                 					Deparment=category.Deparment
                 					Reimbursements=category.Reimbursements
                 				];
                 				budgetItems = Budget_Item[Template_Item == true && Category == category.Budget_Category_Name];
                 				for each  item in budgetItems
                 				{
                 					newBudgetItem = insert into Budget_Item
                 					[
                 						Item_Name=item.Item_Name
                 						Department=item.Department
                 						Category=item.Category
                 						Dept_Code=item.Dept_Code
                 						Cost_Code=item.Cost_Code
                 						Budget=newBudget
                 						Budget_Category=newBudgetCategory
                 						Template_Item=false
                 						Added_User=zoho.loginuser
                 						Budget_Code=subdivisionRow.Subdivision_Code + "-" + item.Cost_Code
                 					];
                 				}
                 			}
                 		}
                 		else
                 		{
                 			if(existingBudgets.count() != 1)
                 			{
                 				result.put("error","No unique saved budget was found. Review the subdivision before creating again.");
                 				return result.toString();
                 			}
                 			newBudget = existingBudgets.ID;
                 		}
                 		result.put("budgetId",newBudget.toString());
                 		saved = Add_Budget[ID == newBudget];
                 		categoryCount = Budget_Category[Budget == newBudget].count();
                 		itemCount = Budget_Item[Budget == newBudget].count();
                 		approvalCount = Budget_Approvals[Budget == newBudget].count();
                 		result.put("categoryCount",categoryCount);
                 		result.put("itemCount",itemCount);
                 		result.put("approvalCount",approvalCount);
                 		verified = saved.count() == 1 && saved.Subdivision1 == subdivisionKey && categoryCount == templateCategories.count() && itemCount == expectedItems && approvalCount == 6;
                 		for each  categoryTemplate in templateCategories
                 		{
                 			savedCategory = Budget_Category[Budget == newBudget && Category_Code == categoryTemplate.Category_Code && Budget_Category_Name == categoryTemplate.Budget_Category_Name && Template_Item == false];
                 			if(savedCategory.count() != 1)
                 			{
                 				verified = false;
                 			}
                 			else
                 			{
                 				for each  itemTemplate in Budget_Item[Template_Item == true && Category == categoryTemplate.Budget_Category_Name]
                 				{
                 					savedItems = Budget_Item[Budget == newBudget && Budget_Category == savedCategory.ID && Cost_Code == itemTemplate.Cost_Code && Budget_Code == subdivisionRow.Subdivision_Code + "-" + itemTemplate.Cost_Code && Template_Item == false];
                 					if(savedItems.count() != 1)
                 					{
                 						verified = false;
                 					}
                 				}
                 			}
                 		}
                 		tracks = {"Development","Construction"};
                 		roles = {"VP","CFO","COO"};
                 		for each  track in tracks
                 		{
                 			order = 0;
                 			for each  role in roles
                 			{
                 				order = order + 1;
                 				if(Budget_Approvals[Budget == newBudget && Type1 == track && Title == role && Sort_Order == order && Status == "Not Sent"].count() != 1)
                 				{
                 					verified = false;
                 				}
                 			}
                 		}
                 		result.put("verified",verified);
                 		result.put("success",verified);
                 		if(!verified)
                 		{
                 			result.put("error","Budget exists but its template records need review. Do not create another budget.");
                 		}
                 		return result.toString();
                 	}	catch (creationError)
                 	{
                 		if(newBudget != 0)
                 		{
                 			result.put("budgetId",newBudget.toString());
                 		}
                 		result.put("error",creationError.toString());
                 		return result.toString();
                 	}
                 	return result.toString();
                 }
				 string createBudgetModification(int itemId, string modType, string amount, string reason, string reference, string effectiveDate, string track)
                 {
                 	/********* CREATE BUDGET MODIFICATION *********/
                 	// Return Type: string ("OK: ..." or "ERROR: ...")
                 	// Creates the Budget_Modification record and its approval chain, then attempts
                 	// the first approval email. Always return the new ID when delivery fails so
                 	// the widget can reconcile that record without creating a duplicate.
                 	// Chain rules (current): two approvals, both to rbelliveau@wbdevelopment.com,
                 	// as VP (Sort 1) then CFO (Sort 2). Recipients are editable from the widget.
                 	vItemId = itemId.toLong();
                 	if(vItemId == 0)
                 	{
                 		return "ERROR: No item provided.";
                 	}
                 	itemRec = Budget_Item[ID == vItemId];
                 	if(itemRec == null)
                 	{
                 		return "ERROR: Budget Item not found.";
                 	}
                 	vAmount = ifnull(amount,"0").toDecimal();
                 	if(vAmount <= 0)
                 	{
                 		return "ERROR: Amount must be greater than zero.";
                 	}
                 	vReason = ifnull(reason,"").trim();
                 	if(vReason == "")
                 	{
                 		return "ERROR: Reason is required.";
                 	}
                 	vType = ifnull(modType,"").trim();
                 	if(vType != "Decrease")
                 	{
                 		vType = "Increase";
                 	}
                 	vTrack = ifnull(track,"").trim();
                 	if(vTrack != "Construction")
                 	{
                 		vTrack = "Development";
                 	}
                 	vBudgetId = 0;
                 	if(itemRec.Budget != null)
                 	{
                 		vBudgetId = itemRec.Budget.ID;
                 	}
                 	vCatId = 0;
                 	if(itemRec.Budget_Category != null)
                 	{
                 		vCatId = itemRec.Budget_Category.ID;
                 	}
                 	// Reference goes IN the insert — post-insert assignment on the fresh row was
                 	// dropping it in production.
                 	vRef = ifnull(reference,"").trim();
                 	newModId = insert into Budget_Modification
                 	[
                 		Added_User=zoho.loginuser
                 		Budget_Item=vItemId
                 		Budget=vBudgetId
                 		Budget_Category=vCatId
                 		Modification_Type=vType
                 		Amount=vAmount
                 		Reason=vReason
                 		Reference_Number=vRef
                 		Status="Submitted"
                 		Approval_Track=vTrack
                 	];
                 	if(newModId == null || newModId == 0)
                 	{
                 		return "ERROR: Could not create the modification record.";
                 	}
                 	modRec = Budget_Modification[ID == newModId];
                 	if(modRec != null)
                 	{
                 		// Re-assert: some environments have dropped choice values set during insert.
                 		modRec.Status="Submitted";
                 		if(vRef != "" && ifnull(modRec.Reference_Number,"") == "")
                 		{
                 			modRec.Reference_Number=vRef;
                 		}
                 		vDate = ifnull(effectiveDate,"").trim();
                 		if(vDate != "")
                 		{
                 			modRec.Effective_Date=vDate.toDate();
                 		}
                 	}
                 	policyCompany = "";
                 	policyTerritory = "";
                 	if(vBudgetId != 0)
                 	{
                 		policyBudget = Add_Budget[ID == vBudgetId];
                 		if(policyBudget.Subdivision1 != null)
                 		{
                 			policyTerritory = ifnull(policyBudget.Subdivision1.Territory,"");
                 			if(policyBudget.Subdivision1.Company1 != null)
                 			{
                 				policyCompany = policyBudget.Subdivision1.Company1.ID.toString();
                 			}
                 		}
                 	}
                 	policySubmitter = User_Access[User == zoho.loginuser];
                 	policyContext = {"workflow":"Budget Modification","recordId":newModId.toString(),"budgetId":vBudgetId.toString(),"companyId":policyCompany,"territory":policyTerritory,"department":vTrack,"submitterId":ifnull(policySubmitter.ID,0).toString(),"effectiveDate":zoho.currentdate.toString("yyyy-MM-dd"),"amount":thisapp.poCurrencyString(modRec.Amount.toString())};
                 	policyExecution = thisapp.applySharedApprovalPolicy(policyContext);
                 	if(policyExecution.get("success") != true)
                 	{
                 		return "OK: Modification " + newModId + " recorded. Approval template failed: " + policyExecution.get("error");
                 	}
                 	if(policyExecution.get("shared") != true)
                 	{
                 		// ---- Approval chain ----
                 		// VP defaults to the territory's VP (Territory.VP -> User_Access.Approver_Email);
                 		// everything else falls back to the standing placeholder recipient.
                 		approverEmail = "rbelliveau@wbdevelopment.com";
                 		vTerritory = "";
                 		if(vBudgetId != 0)
                 		{
                 			budgetRec = Add_Budget[ID == vBudgetId];
                 			if(budgetRec != null && budgetRec.Subdivision1 != null)
                 			{
                 				vTerritory = ifnull(budgetRec.Subdivision1.Territory,"").trim();
                 			}
                 		}
                 		vpEmail = thisapp.territoryApproverEmail(vTerritory,"VP");
                 		if(vpEmail == "")
                 		{
                 			vpEmail = approverEmail;
                 		}
                 		// Lookups are set IN the insert; a fetch-assign fallback below re-links the row
                 		// if the in-insert value was dropped (assigning through the insert-returned ID
                 		// variable alone proved unreliable in the past).
                 		a1 = insert into Budget_Approvals
                 		[
                 			Added_User=zoho.loginuser
                 			Approver=vpEmail
                 			Title="VP"
                 			Status="Not Sent"
                 			Type1="Modification"
                 			Sort_Order=1
                 			Budget=vBudgetId
                 			Budget_Modification=newModId
                 		];
                 		a1Rec = Budget_Approvals[ID == a1];
                 		if(a1Rec != null && a1Rec.Budget_Modification == null)
                 		{
                 			a1Rec.Budget_Modification=newModId;
                 		}
                 		a2 = insert into Budget_Approvals
                 		[
                 			Added_User=zoho.loginuser
                 			Approver=approverEmail
                 			Title="CFO"
                 			Status="Not Sent"
                 			Type1="Modification"
                 			Sort_Order=2
                 			Budget=vBudgetId
                 			Budget_Modification=newModId
                 		];
                 		a2Rec = Budget_Approvals[ID == a2];
                 		if(a2Rec != null && a2Rec.Budget_Modification == null)
                 		{
                 			a2Rec.Budget_Modification=newModId;
                 		}
                 		// Route large modifications through the COO as well (Settings.COO_Approval_Threshold;
                 		// 0/empty disables the extra step).
                 		vThreshold = 0.0;
                 		settingsRec = Settings[ID != 0];
                 		if(settingsRec != null)
                 		{
                 			vThreshold = ifnull(settingsRec.COO_Approval_Threshold,0.0);
                 		}
                 		if(vThreshold > 0 && vAmount > vThreshold)
                 		{
                 			a3 = insert into Budget_Approvals
                 			[
                 				Added_User=zoho.loginuser
                 				Approver=approverEmail
                 				Title="COO"
                 				Status="Not Sent"
                 				Type1="Modification"
                 				Sort_Order=3
                 				Budget=vBudgetId
                 				Budget_Modification=newModId
                 			];
                 			a3Rec = Budget_Approvals[ID == a3];
                 			if(a3Rec != null && a3Rec.Budget_Modification == null)
                 			{
                 				a3Rec.Budget_Modification=newModId;
                 			}
                 		}
                 	}
                 	// First approval email (marks the first row Pending + stamps Sent_Date).
                 	emailMsg = "";
                 	try 
                 	{
                 		emailMsg = thisapp.sendModificationEmail(newModId,"created");
                 	}	catch (emailException)
                 	{
                 		emailMsg = "Approval email could not be sent: " + emailException.toString();
                 	}
                 	return "OK: Modification " + newModId + " submitted. " + ifnull(emailMsg,"");
                 }
				 void createBuilderTakedown(Lots lotRecords)
                 {
                 	escStart = "";
                 	addlFees = "";
                 	interest1 = "";
                 	interest2 = "";
                 	interest3 = "";
                 	interest4 = "";
                 	interest5 = "";
                 	interest6 = "";
                 	interest7 = "";
                 	interest8 = "";
                 	interest9 = "";
                 	interest10 = "";
                 	interest11 = "";
                 	interest12 = "";
                 	taxPerlot = "";
                 	percentAppraisal = "";
                 	from1 = "";
                 	to1 = "";
                 	from2 = "";
                 	to2 = "";
                 	from3 = "";
                 	to3 = "";
                 	from4 = "";
                 	to4 = "";
                 	from5 = "";
                 	to5 = "";
                 	from6 = "";
                 	to6 = "";
                 	from7 = "";
                 	to7 = "";
                 	from8 = "";
                 	to8 = "";
                 	from9 = "";
                 	to9 = "";
                 	from10 = "";
                 	to10 = "";
                 	from11 = "";
                 	to11 = "";
                 	from12 = "";
                 	to12 = "";
                 	//get Takedown Template
                 	tdTemplate = Takedown_Template[Subdivision1 == lotRecords.Subdivision && Builder1 == lotRecords.Builder1];
                 	//if there is a TD Template that matches above criteria, use it to fill out the following fields on Builder Takedown form
                 	if(tdTemplate != null)
                 	{
                 		feeType = tdTemplate.Additional_Fee_Type.toString();
                 		feeAmount = tdTemplate.Additional_Fee.toString();
                 		taxMethod = tdTemplate.Tax_Method.toString();
                 		taxPerlot = tdTemplate.Tax_Per_Lot.toString();
                 		percentAppraisal = tdTemplate.Percent_of_Appraisal.toString();
                 		taxStatus = tdTemplate.Tax_Status;
                 		drhSubtract = tdTemplate.DRH_Subtract_Day;
                 		subDayfrom = tdTemplate.Subtract_Day_From;
                 	}
                 	//if there is no TD Template, use the values from Lot records for the following fields
                 	if(tdTemplate.count() = 0)
                 	{
                 		feeType = lotRecords.Fee_Type;
                 		feeAmount = lotRecords.maximum(Additional_Fees).toString();
                 		interest1 = lotRecords.maximum(Escalator).toString();
                 		from1 = lotRecords.maximum(Escalator_Start_Date).toString();
                 	}
                 	//get record id's
                 	idRecordList = lotRecords.ID.getall();
                 	statusList = lotRecords.Status.getall();
                 	totaltaxList = lotRecords.Total_Tax.getall();
                 	if(tdTemplate.From_1 < zoho.currentdate)
                 	{
                 		interest1 = tdTemplate.Interest_Rate_1.toString();
                 		interest2 = tdTemplate.Interest_Rate_2.toString();
                 		interest3 = tdTemplate.Interest_Rate_3.toString();
                 		interest4 = tdTemplate.Interest_Rate_4.toString();
                 		interest5 = tdTemplate.Interest_Rate_5.toString();
                 		interest6 = tdTemplate.Interest_Rate_6.toString();
                 		interest7 = tdTemplate.Interest_Rate_7.toString();
                 		interest8 = tdTemplate.Interest_Rate_8.toString();
                 		interest9 = tdTemplate.Interest_Rate_9.toString();
                 		interest10 = tdTemplate.Interest_Rate_10.toString();
                 		interest11 = tdTemplate.Interest_Rate_11.toString();
                 		interest12 = tdTemplate.Interest_Rate_12.toString();
                 		from1 = tdTemplate.From_1.toString();
                 		to1 = tdTemplate.To_1.toString();
                 		from2 = tdTemplate.From_2.toString();
                 		to2 = tdTemplate.To_2.toString();
                 		from3 = tdTemplate.From_3.toString();
                 		to3 = tdTemplate.To_3.toString();
                 		from4 = tdTemplate.From_4.toString();
                 		to4 = tdTemplate.To_4.toString();
                 		from5 = tdTemplate.From_5.toString();
                 		to5 = tdTemplate.To_5.toString();
                 		from6 = tdTemplate.From_6.toString();
                 		to6 = tdTemplate.To_6.toString();
                 		from7 = tdTemplate.From_7.toString();
                 		to7 = tdTemplate.To_7.toString();
                 		from8 = tdTemplate.From_8.toString();
                 		to8 = tdTemplate.To_8.toString();
                 		from9 = tdTemplate.From_9.toString();
                 		to9 = tdTemplate.To_9.toString();
                 		from10 = tdTemplate.From_10.toString();
                 		to10 = tdTemplate.To_10.toString();
                 		from11 = tdTemplate.From_11.toString();
                 		to11 = tdTemplate.To_11.toString();
                 		from12 = tdTemplate.From_12.toString();
                 		to12 = tdTemplate.To_12.toString();
                 	}
                 	//get Builder Takedowns, sort by newest, and grab top line (newest)
                 	//builderTd = (Builder_Takedown[Added_Time = zoho.currentdate].ID sort by Added_Time desc).getAll();
                 	//buildertdTop = builderTd.get(0);
                 	//open URL of newest Builder Takedown
                 	//openUrl(zoho.appuri + "/Builder_Takedown/record-edit/All_Builder_Takedowns/" + buildertdTop,"popup window");
                 	interestUrl = "&&Interest_Rate_1=" + interest1 + "&&Interest_Rate_2=" + interest2 + "&&Interest_Rate_3=" + interest3 + "&&Interest_Rate_4=" + interest4 + "&&Interest_Rate_5=" + interest5 + "&&Interest_Rate_6=" + interest6 + "&&Interest_Rate_8=" + interest8 + "&&Interest_Rate_9=" + interest9 + "&&Interest_Rate_10=" + interest10 + "&&Interest_Rate_11=" + interest11 + "&&Interest_Rate_12=" + interest12 + "&&Interest_Rate_71=" + interest7;
                 	datesUrl = "&&Date1_1=" + from1 + "&&Date1_2=" + to1 + "&&Date2_1=" + from2 + "&&Date2_2=" + to2 + "&&Date3_1=" + from3 + "&&Date3_2=" + to3 + "&&Date4_1=" + from4 + "&&Date4_2=" + to4 + "&&Date5_1=" + from5 + "&&Date5_2=" + to5 + "&&Date6_1=" + from6 + "&&Date6_2=" + to6 + "&&Date7_1=" + from7 + "&&Date7_2=" + to7 + "&&Date8_1=" + from8 + "&&Date8_2=" + to8 + "&&Date9_1=" + from9 + "&&Date9_2=" + to9 + "&&Date10_1=" + from10 + "&&Date10_2=" + to10 + "&&Date11_1=" + from11 + "&&Date11_2=" + to11 + "&&Date12_1=" + from12 + "&&Date12_2=" + to12;
                 	btdUrl = "#Form:Builder_Takedown?Lots=" + idRecordList + "&&Builder1=" + lotRecords.Builder1 + "&&Subdivision1=" + lotRecords.Subdivision + interestUrl + datesUrl + "&&Additional_Fees_Per_Lot=" + feeAmount + "&&Additional_Fee_Type=" + feeType + "&&Tax_Method=" + taxMethod + "&&Tax_Per_Lot=" + taxPerlot + "&&Percent_of_Appraisal=" + percentAppraisal + "&&Tax_Status=" + taxStatus + "&&Subtract_Day_From=" + subDayfrom;
                 	/* carry the contract the lots were completed under into the takedown */
                 	contractPrefill = "";
                 	contractIdList = lotRecords.Contract1.getall();
                 	for each  cval in contractIdList
                 	{
                 		if(contractPrefill == "" && cval != null && cval.toString() != "")
                 		{
                 			contractPrefill = cval.toString();
                 		}
                 	}
                 	if(contractPrefill != "")
                 	{
                 		btdUrl = btdUrl + "&&Contract1=" + contractPrefill;
                 	}
                 	openUrl(btdUrl,"popup window");
                 	//info btdUrl;
                 }
				 void createContract(Lots lotRecords)
                 {
                 	//get record id's
                 	idRecordList = lotRecords.ID.getall();
                 	lotCount = lotRecords.count(ID);
                 	subdiv = lotRecords.Subdivision;
                 	subdivisionFields = Subdivision[ID == subdiv];
                 	contractName = subdivisionFields.Subdivision_Code + " - " + lotRecords.Builder1.Builder_Name + " - " + zoho.currentdate;
                 	//get Builder Takedowns, sort by newest, and grab top line (newest)
                 	//builderTd = (Builder_Takedown[Added_Time = zoho.currentdate].ID sort by Added_Time desc).getAll();
                 	//buildertdTop = builderTd.get(0);
                 	//open URL of newest Builder Takedown
                 	//openUrl(zoho.appuri + "/Builder_Takedown/record-edit/All_Builder_Takedowns/" + buildertdTop,"popup window");
                 	massupdUrl = "#Form:Contract?Number_of_Lots=" + lotCount + "&&Lots1=" + idRecordList + "&&Subdivision1=" + lotRecords.Subdivision + "&&Builder=" + lotRecords.Builder1 + "&&Project=" + subdivisionFields.Project + "&&County=" + subdivisionFields.County + "&&City=" + subdivisionFields.City + "&&Company_Entity=" + subdivisionFields.Company1 + "&&Contract_Name=" + contractName;
                 	openUrl(massupdUrl,"popup window");
                 	//info btdUrl;
                 }
				 string createContractAttachmentRecord(string contractId)
                 {
                 	response = Map();
                 	vContractId = ifnull(contractId,"").trim();
                 	if(vContractId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Contract ID.");
                 		return response.toString();
                 	}
                 	contractRows = Contract[ID == vContractId.toLong()];
                 	if(contractRows.count() == 0)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Contract not found.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		if(ifnull(contractRows.Status,"").toString() == "Complete")
                 		{
                 			response.put("ok",false);
                 			response.put("message","This contract is complete and read-only.");
                 			return response.toString();
                 		}
                 		attachmentId = insert into Attachment
                 		[
                 			Contract1=vContractId.toLong()
                 			Date_field1=zoho.currenttime
                 			Email_Attachment=true
                 			Added_User=zoho.loginuser
                 		];
                 		response.put("ok",true);
                 		response.put("attachmentId",attachmentId.toString());
                 		response.put("message","Attachment record created.");
                 		return response.toString();
                 	}	catch (createError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment record creation failed: " + createError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment record creation ended without a response.");
                 	return response.toString();
                 }
				 string createProformaAttachmentRecord(string proformaId)
                 {
                 	/********* CREATE EMPTY PRO FORMA ATTACHMENT CHILD RECORD *********/
                 	vProformaId = ifnull(proformaId,"").trim();
                 	if(vProformaId == "")
                 	{
                 		return "{\"ok\":false,\"message\":\"Missing Pro Forma ID.\"}";
                 	}
                 	proformaRows = Add_Pro_Forma[ID == vProformaId.toLong()];
                 	if(proformaRows.count() == 0)
                 	{
                 		return "{\"ok\":false,\"message\":\"Pro Forma not found.\"}";
                 	}
                 	try 
                 	{
                 		attachmentId = insert into Attachment
                 		[
                 			Pro_Forma=vProformaId.toLong()
                 			Date_field1=zoho.currenttime
                 			Email_Attachment=false
                 			Added_User=zoho.loginuser
                 		];
                 		response = Map();
                 		response.put("ok",true);
                 		response.put("attachmentId",attachmentId.toString());
                 		response.put("message","Attachment record created.");
                 		return response.toString();
                 	}	catch (createError)
                 	{
                 		response = Map();
                 		response.put("ok",false);
                 		response.put("message","Attachment record creation failed: " + createError.toString());
                 		return response.toString();
                 	}
                 	return response.toString();
                 }
