                 			specialShown = specialShown + 1;
                 		}
                 		/*
                 		 * Legal note panel.
                 		 */
                 		page = page + thisapp.PF_PDF_Rect(28,48,736,96,white,line,0.35);
                 		page = page + thisapp.PF_PDF_Rect(28,118,736,26,softPurple,"",0);
                 		page = page + thisapp.PF_PDF_Text(40,127,7.5,"bold",navy,"LEGAL NOTE");
                 		legalLines = thisapp.PF_PDF_Wrap(loiLegalNote,116);
                 		lineY = 98;
                 		legalShown = 0;
                 		for each  legalLine in legalLines
                 		{
                 			if(legalShown < 5)
                 			{
                 				page = page + thisapp.PF_PDF_Text(40,lineY,7.5,"regular",ink,legalLine);
