				 string Get_Proforma_Approval_PDF(string payload)
                 {
                 	resp = Map();
                 	try 
                 	{
                 		data = payload.toMap();
                 		if(data.get("payload") != null)
                 		{
                 			data = data.get("payload").toString().toMap();
                 		}
                 		pfId = ifnull(data.get("proformaId"),"").toString().trim();
                 		approvalId = ifnull(data.get("approvalId"),"").toString().trim();
                 		if(pfId == "")
                 		{
                 			resp.put("success",false);
                 			resp.put("error","Pro Forma id is required.");
                 			return resp.toString();
                 		}
                 		// Document export shares the authenticated export endpoint, but never submits to Legal.
                 		if(ifnull(data.get("format"),"pdf").toString() == "docx")
                 		{
                 			exportPfId = pfId.toLong();
                 			sellerCount = Builder[Proforma.contains(exportPfId.toString())].count();
                 			propertyCount = Property[Proforma.contains(exportPfId.toString())].count();
                 			if(sellerCount != 1 || propertyCount < 1)
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Manual preparation required: LOI/Contract export needs exactly one seller and at least one parcel.");
                 				return resp.toString();
                 			}
                 			document = thisapp.PF_Build_LOI_Document(pfId);
                 			if(ifnull(document.get("success"),false) != true)
                 			{
                 				resp.put("success",false);
                 				resp.put("error",ifnull(document.get("message"),"Could not generate the Word document."));
                 				return resp.toString();
                 			}
                 			encodedFile = zoho.encryption.base64Encode(document.get("file"));
                 			if(encodedFile == null || encodedFile == "")
                 			{
                 				resp.put("success",false);
                 				resp.put("error","Could not encode the Word document for download.");
                 				return resp.toString();
                 			}
                 			resp.put("success",true);
                 			resp.put("fileName",document.get("fileName"));
                 			resp.put("base64",encodedFile);
                 			resp.put("mimeType","application/vnd.openxmlformats-officedocument.wordprocessingml.document");
                 			return resp.toString();
                 		}
                 		if(approvalId == "")
                 		{
                 			// default to the first approval step of the chain
                 			bestSort = 999999;
                 			for each  apRow in Budget_Approvals[Proforma == pfId.toLong()]
                 			{
                 				rowSort = ifnull(apRow.Sort_Order,0).toString().toLong();
                 				if(approvalId == "" || rowSort < bestSort)
                 				{
                 					bestSort = rowSort;
                 					approvalId = apRow.ID.toString();
                 				}
                 			}
                 		}
                 		if(approvalId == "")
                 		{
                 			resp.put("success",false);
                 			resp.put("error","No approval rows exist for this Pro Forma yet.");
                 			return resp.toString();
                 		}
                 		packet = thisapp.PF_Build_Proforma_Approval_PDF(pfId,approvalId);
                 		if(ifnull(packet.get("success"),false) != true)
                 		{
                 			resp.put("success",false);
                 			resp.put("error",ifnull(packet.get("message"),"Could not build the approval PDF."));
                 			return resp.toString();
                 		}
                 		resp.put("success",true);
                 		fallbackPf = Add_Pro_Forma[ID == pfId.toLong()];
                 		fallbackPfName = ifnull(fallbackPf.Name,"Pro Forma").toString().replaceAll("['’]","").replaceAll("[^A-Za-z0-9]+","_").replaceAll("_+","_").replaceAll("^_+","").replaceAll("_+$","");
                 		if(fallbackPfName == "")
                 		{
                 			fallbackPfName = "Pro_Forma";
                 		}
                 		resp.put("fileName",ifnull(packet.get("fileName"),fallbackPfName + "_Proforma_Packet_" + zoho.currentdate.toString("yyyy-MM-dd") + ".pdf"));
                 		resp.put("pdfText",ifnull(packet.get("pdfText"),""));
                 	}	catch (e)
                 	{
                 		resp.put("success",false);
                 		resp.put("error",e.toString());
                 	}
                 	return resp.toString();
                 }
				 string handleApprovalAction(string budgetId, string approvalId, string approvalAction, string approvalNote)
                 {
                 	/********* HANDLE APPROVAL PAGE BUTTON PRESS *********/
                 	// All record IDs are held internally as strings.
                 	// IDs are converted to long only when required by:
                 	// - Creator record criteria
                 	// - Existing helper functions that accept numeric IDs
                 	//
                 	// Approved:
                 	// - Approves the current row.
                 	// - Sends the next approver.
                 	// - When the last approver finishes:
                 	//     Development: Development + Engineering Unapproved -> Final,
                 	//                  then Unapproved -> 0.
                 	//     Construction: Construction Unapproved -> Final,
                 	//                   then Unapproved -> 0.
                 	// - When both tracks are fully approved:
                 	//     Generates an approved-budget PDF and attaches it to
                 	//     Add_Budget.Attachments.
                 	//
                 	// Rejected:
                 	// - Sends the chain back to the previous approver.
                 	//
                 	// Pending:
                 	// - Saves the note only.
                 	//
                 	// VP cannot reject because there is no previous approver.
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vApprovalId = ifnull(approvalId,"").trim();
                 	vAction = ifnull(approvalAction,"").trim();
                 	vNote = ifnull(approvalNote,"");
                 	if(vBudgetId == "")
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalId == "")
                 	{
                 		return "No Approval ID provided.";
                 	}
                 	if(vAction == "")
                 	{
                 		return "No approval action provided.";
                 	}
                 	/********* LOAD BUDGET *********/
                 	budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	/********* LOAD CURRENT APPROVAL *********/
                 	currentRows = Budget_Approvals[ID == vApprovalId.toLong() && Budget == vBudgetId.toLong()];
                 	if(currentRows.count() == 0)
                 	{
                 		return "Approval row not found.";
                 	}
                 	currentApproval = null;
                 	for each  cr in currentRows
                 	{
                 		currentApproval = cr;
                 	}
                 	vApprovalType = ifnull(currentApproval.Type1,"").trim();
                 	vCurrentRole = ifnull(currentApproval.Title,"").trim();
                 	vCurrentStatus = ifnull(currentApproval.Status,"").trim();
                 	if(vCurrentStatus == "")
                 	{
                 		vCurrentStatus = "Not Sent";
                 	}
                 	vCurrentSort = 0;
                 	if(currentApproval.Sort_Order != null)
                 	{
                 		vCurrentSort = currentApproval.Sort_Order.toLong();
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "Approval Type is blank.";
                 	}
                 	if(vApprovalType != "Development" && vApprovalType != "Construction")
                 	{
                 		return "Unsupported approval type: " + vApprovalType;
                 	}
                 	if(vCurrentSort == 0)
                 	{
                 		return "Sort Order is blank for " + vCurrentRole + ".";
                 	}
                 	// Reconcile the start of one budget track using its first approval row.
                 	// CheckStart is read-only. RepairStart sends only a missing first email;
                 	// it never resets a started chain or advances another approver.
                 	if(vAction == "CheckStart" || vAction == "RepairStart")
                 	{
                 		startRows = Budget_Approvals[Budget == vBudgetId.toLong() && Type1 == vApprovalType];
                 		firstId = "";
                 		firstSort = 999999;
                 		startPending = 0;
                 		startApproved = 0;
                 		startCount = 0;
                 		for each  startRow in startRows
                 		{
                 			startCount = startCount + 1;
                 			startSort = ifnull(startRow.Sort_Order,0).toLong();
                 			if(startSort > 0 && startSort < firstSort)
                 			{
                 				firstSort = startSort;
                 				firstId = startRow.ID.toString();
                 			}
                 			if(ifnull(startRow.Status,"").trim() == "Pending")
                 			{
                 				startPending = startPending + 1;
                 			}
                 			if(ifnull(startRow.Status,"").trim() == "Approved")
                 			{
                 				startApproved = startApproved + 1;
                 			}
                 		}
                 		if(firstId != vApprovalId)
                 		{
                 			return "The requested row is not the first approver in this track.";
                 		}
                 		firstRows = Budget_Approvals[ID == vApprovalId.toLong() && Budget == vBudgetId.toLong()];
                 		firstStatus = "";
                 		firstSentDate = "";
                 		firstRole = "";
                 		firstAddress = "";
                 		for each  firstRow in firstRows
                 		{
                 			firstStatus = ifnull(firstRow.Status,"").trim();
                 			firstRole = ifnull(firstRow.Title,"").trim();
                 			firstAddress = ifnull(firstRow.Approver,"").trim();
                 			if(firstRow.Sent_Date != null)
                 			{
                 				firstSentDate = firstRow.Sent_Date.toString();
                 			}
                 		}
                 		if(vAction == "RepairStart" && firstStatus == "Pending" && startPending == 1 && startApproved == 0)
                 		{
                 			thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			if(firstSentDate == "")
                 			{
                 				try 
                 				{
                 					thisapp.sendApprovalEmail(vBudgetId.toLong(),vApprovalId.toLong());
                 				}				catch (startMailError)
                 				{
                 					// The next check reports the persisted state without claiming delivery.
                 				}
                 			}
                 			firstRows = Budget_Approvals[ID == vApprovalId.toLong() && Budget == vBudgetId.toLong()];
                 			for each  firstRow in firstRows
                 			{
                 				if(firstRow.Sent_Date != null)
                 				{
                 					firstSentDate = firstRow.Sent_Date.toString();
                 				}
                 			}
                 		}
                 		budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 		startParent = ifnull(budgetRec.Development_Budget_Approval_Status,"").trim();
                 		if(vApprovalType == "Construction")
                 		{
                 			startParent = ifnull(budgetRec.Const_Budget_Approval_Status,"").trim();
                 		}
                 		startProgress = Map();
                 		startProgress.put("ok",true);
                 		startProgress.put("budgetId",vBudgetId);
                 		startProgress.put("approvalId",vApprovalId);
                 		startProgress.put("track",vApprovalType);
                 		startProgress.put("parentStatus",startParent);
                 		startProgress.put("rowCount",startCount);
                 		startProgress.put("pendingCount",startPending);
                 		startProgress.put("approvedCount",startApproved);
                 		startProgress.put("firstId",firstId);
                 		startProgress.put("firstStatus",firstStatus);
                 		startProgress.put("role",firstRole);
                 		startProgress.put("address",firstAddress);
                 		startProgress.put("sentDate",firstSentDate);
                 		startProgress.put("emailSent",firstSentDate != "");
                 		return startProgress.toString();
                 	}
                 	/********* TARGETED REJECTION RECONCILIATION *********/
                 	// A rejection returns this track to its immediate predecessor. Repair never
                 	// repeats the rejection; it only restores that predecessor and missing mail.
                 	if(vAction == "CheckReject" || vAction == "RepairReject")
                 	{
                 		rejectRows = Budget_Approvals[Budget == vBudgetId.toLong() && Type1 == vApprovalType];
                 		previousId = "";
                 		previousOrder = 0;
                 		for each  rejectRow in rejectRows
                 		{
                 			rejectOrder = ifnull(rejectRow.Sort_Order,0).toLong();
                 			if(rejectOrder < vCurrentSort && rejectOrder > previousOrder)
                 			{
                 				previousOrder = rejectOrder;
                 				previousId = rejectRow.ID.toString();
                 			}
                 		}
                 		if(previousId == "")
                 		{
                 			return "There is no previous approver for this rejection.";
                 		}
                 		repairError = "";
                 		previousRows = Budget_Approvals[ID == previousId.toLong() && Budget == vBudgetId.toLong()];
                 		if(vAction == "RepairReject" && vCurrentStatus == "Rejected")
                 		{
                 			otherPending = 0;
                 			for each  rejectRow in rejectRows
                 			{
                 				if(rejectRow.ID.toString() != previousId && ifnull(rejectRow.Status,"").trim() == "Pending")
                 				{
                 					otherPending = otherPending + 1;
                 				}
                 			}
                 			if(otherPending == 0)
                 			{
                 				for each  previousRow in previousRows
                 				{
                 					if(ifnull(previousRow.Status,"").trim() != "Pending")
                 					{
                 						previousRow.Status="Pending";
                 						previousRow.Sent_Date=null;
                 						previousRow.Responded_Date=null;
                 					}
                 					thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 					if(previousRow.Sent_Date == null)
                 					{
                 						try 
                 						{
                 							thisapp.sendApprovalEmail(vBudgetId.toLong(),previousId.toLong());
                 						}						catch (rejectMailError)
                 						{
                 							repairError = rejectMailError.toString();
                 						}
                 					}
                 				}
                 			}
                 		}
                 		rejectRows = Budget_Approvals[Budget == vBudgetId.toLong() && Type1 == vApprovalType];
                 		pendingCount = 0;
                 		previousStatus = "";
                 		previousSent = "";
                 		previousRole = "";
                 		previousAddress = "";
                 		for each  rejectRow in rejectRows
                 		{
                 			if(ifnull(rejectRow.Status,"").trim() == "Pending")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			if(rejectRow.ID.toString() == previousId)
                 			{
                 				previousStatus = ifnull(rejectRow.Status,"").trim();
                 				previousRole = ifnull(rejectRow.Title,"").trim();
                 				previousAddress = ifnull(rejectRow.Approver,"").trim();
                 				if(rejectRow.Sent_Date != null)
                 				{
                 					previousSent = rejectRow.Sent_Date.toString();
                 				}
                 			}
                 		}
                 		budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 		parentStatus = ifnull(budgetRec.Development_Budget_Approval_Status,"").trim();
                 		if(vApprovalType == "Construction")
                 		{
                 			parentStatus = ifnull(budgetRec.Const_Budget_Approval_Status,"").trim();
                 		}
                 		rejectProgress = Map();
                 		rejectProgress.put("ok",true);
                 		rejectProgress.put("budgetId",vBudgetId);
                 		rejectProgress.put("approvalId",vApprovalId);
                 		rejectProgress.put("currentStatus",ifnull(currentApproval.Status,"").trim());
                 		rejectProgress.put("previousId",previousId);
                 		rejectProgress.put("previousStatus",previousStatus);
                 		rejectProgress.put("pendingCount",pendingCount);
                 		rejectProgress.put("parentStatus",parentStatus);
                 		rejectProgress.put("role",previousRole);
                 		rejectProgress.put("address",previousAddress);
                 		rejectProgress.put("sentDate",previousSent);
                 		rejectProgress.put("emailSent",previousSent != "");
                 		rejectProgress.put("repairError",repairError);
                 		return rejectProgress.toString();
                 	}
                 	/********* TARGETED APPROVAL RECONCILIATION *********/
                 	// Check is read-only. Repair is idempotent and may be called only once by the widget.
                 	// Sent_Date is the delivery marker: sendApprovalEmail stamps it after sendmail succeeds.
                 	if(vAction == "Check" || vAction == "Repair")
                 	{
                 		repairError = "";
                 		trackRows = Budget_Approvals[Budget == vBudgetId.toLong() && Type1 == vApprovalType];
                 		nextId = "";
                 		nextOrder = 999999;
                 		for each  row in trackRows
                 		{
                 			rowOrder = ifnull(row.Sort_Order,0).toLong();
                 			if(rowOrder > vCurrentSort && rowOrder < nextOrder)
                 			{
                 				nextOrder = rowOrder;
                 				nextId = row.ID.toString();
                 			}
                 		}
                 		if(vAction == "Repair" && vCurrentStatus == "Approved")
                 		{
                 			if(nextId != "")
                 			{
                 				for each  row in trackRows
                 				{
                 					if(row.ID.toString() != nextId && ifnull(row.Status,"").trim() == "Pending")
                 					{
                 						row.Status="Not Sent";
                 						row.Sent_Date=null;
                 					}
                 				}
                 				nextRepairRows = Budget_Approvals[ID == nextId.toLong()];
                 				for each  nextRepair in nextRepairRows
                 				{
                 					if(ifnull(nextRepair.Status,"").trim() != "Pending")
                 					{
                 						nextRepair.Status="Pending";
                 						nextRepair.Sent_Date=null;
                 						nextRepair.Responded_Date=null;
                 					}
                 					if(nextRepair.Sent_Date == null)
                 					{
                 						try 
                 						{
                 							thisapp.sendApprovalEmail(vBudgetId.toLong(),nextId.toLong());
                 						}						catch (sendError)
                 						{
                 							repairError = "The approval email could not be sent: " + sendError.toString();
                 						}
                 					}
                 				}
                 			}
                 			thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		}
                 		// Read the specific track again after a repair; never fetch unrelated budgets.
                 		trackRows = Budget_Approvals[Budget == vBudgetId.toLong() && Type1 == vApprovalType];
                 		pendingCount = 0;
                 		approvedCount = 0;
                 		rowCount = 0;
                 		nextStatus = "";
                 		nextRole = "";
                 		nextEmail = "";
                 		nextSentDate = "";
                 		for each  row in trackRows
                 		{
                 			rowCount = rowCount + 1;
                 			rowStatus = ifnull(row.Status,"").trim();
                 			if(rowStatus == "Pending")
                 			{
                 				pendingCount = pendingCount + 1;
                 			}
                 			if(rowStatus == "Approved")
                 			{
                 				approvedCount = approvedCount + 1;
                 			}
                 			if(row.ID.toString() == nextId)
                 			{
                 				nextStatus = rowStatus;
                 				nextRole = ifnull(row.Title,"").trim();
                 				nextEmail = ifnull(row.Approver,"").trim();
                 				if(row.Sent_Date != null)
                 				{
                 					nextSentDate = row.Sent_Date.toString();
                 				}
                 			}
                 		}
                 		budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 		parentStatus = ifnull(budgetRec.Development_Budget_Approval_Status,"").trim();
                 		if(vApprovalType == "Construction")
                 		{
                 			parentStatus = ifnull(budgetRec.Const_Budget_Approval_Status,"").trim();
                 		}
                 		financialFinalized = false;
                 		if(nextId == "" && rowCount > 0 && approvedCount == rowCount)
                 		{
                 			financialFinalized = true;
                 			grandFinalCheck = 0.0;
                 			budgetCategories = Budget_Category[Budget == vBudgetId.toLong()];
                 			for each  cat in budgetCategories
                 			{
                 				dept = ifnull(cat.Deparment,"").trim().toLowerCase();
                 				inTrack = (vApprovalType == "Construction" && dept.contains("construction")) || (vApprovalType == "Development" && dept.contains("development") || dept.contains("engineering"));
                 				itemFinal = 0.0;
                 				catItems = Budget_Item[Budget_Category == cat.ID];
                 				for each  item in catItems
                 				{
                 					itemFinal = itemFinal + ifnull(item.Budget_Ttl,0).toDecimal();
                 					if(inTrack && ifnull(item.Unapproved_Final_Budget_Ttl,0).toDecimal() != 0)
                 					{
                 						financialFinalized = false;
                 					}
                 				}
                 				catFinal = ifnull(cat.Budget_Total,0).toDecimal();
                 				if(catFinal != itemFinal)
                 				{
                 					financialFinalized = false;
                 				}
                 				grandFinalCheck = grandFinalCheck + catFinal;
                 			}
                 			if(grandFinalCheck != ifnull(budgetRec.Budget_Grand_Total,0).toDecimal())
                 			{
                 				financialFinalized = false;
                 			}
                 		}
                 		if(vAction == "Repair" && nextId == "" && financialFinalized && parentStatus != "Approved")
                 		{
                 			thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 			parentStatus = ifnull(budgetRec.Development_Budget_Approval_Status,"").trim();
                 			if(vApprovalType == "Construction")
                 			{
                 				parentStatus = ifnull(budgetRec.Const_Budget_Approval_Status,"").trim();
                 			}
                 		}
                 		progress = Map();
                 		progress.put("ok",true);
                 		progress.put("budgetId",vBudgetId);
                 		progress.put("approvalId",vApprovalId);
                 		progress.put("track",vApprovalType);
                 		progress.put("currentStatus",ifnull(currentApproval.Status,"").trim());
                 		progress.put("nextId",nextId);
                 		progress.put("nextStatus",nextStatus);
                 		progress.put("pendingCount",pendingCount);
                 		progress.put("role",nextRole);
                 		progress.put("address",nextEmail);
                 		progress.put("emailSent",nextSentDate != "");
                 		progress.put("sentDate",nextSentDate);
                 		progress.put("allApproved",rowCount > 0 && approvedCount == rowCount);
                 		progress.put("parentStatus",parentStatus);
                 		progress.put("financialFinalized",financialFinalized);
                 		progress.put("repairError",repairError);
                 		return progress.toString();
                 	}
                 	/********* FORMAT NOTE *********/
                 	vNote = vNote.replaceAll("\r\n","\n");
                 	vNote = vNote.replaceAll("\r","\n");
                 	vNote = vNote.replaceAll("\n","<br>");
                 	/********* PREVENT STALE OR OUT-OF-SEQUENCE ACTIONS *********/
                 	if(vCurrentStatus != "Pending")
                 	{
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		return vApprovalType + " " + vCurrentRole + " is currently " + vCurrentStatus + ". No action was taken because this approval is not Pending. " + syncResp;
                 	}
                 	/********* SAVE NOTE ONLY *********/
                 	if(vAction == "Pending")
                 	{
                 		currentApproval.Status="Pending";
                 		currentApproval.Approval_Notes=vNote;
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		return vApprovalType + " " + vCurrentRole + " note saved. " + syncResp;
                 	}
                 	/********* APPROVED *********/
                 	if(vAction == "Approved")
                 	{
                 		currentApproval.Status="Approved";
                 		currentApproval.Approval_Notes=vNote;
                 		currentApproval.Responded_Date=zoho.currentdate;
                 		nextApprovalId = "";
                 		nextSort = 999999;
                 		/********* FIND NEXT APPROVER IN THE SAME TRACK *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprSort = 999999;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort > vCurrentSort && apprSort < nextSort)
                 				{
                 					nextSort = apprSort;
                 					nextApprovalId = appr.ID.toString();
                 				}
                 			}
                 		}
                 		/********* SEND NEXT APPROVER *********/
                 		if(nextApprovalId != "")
                 		{
                 			// Ensure only one row in this track remains Pending.
                 			for each  appr in budgetRec.Approvals
                 			{
                 				apprIdText = appr.ID.toString();
                 				if(ifnull(appr.Type1,"").trim() == vApprovalType && apprIdText != nextApprovalId && apprIdText != vApprovalId)
                 				{
                 					if(ifnull(appr.Status,"").trim() == "Pending")
                 					{
                 						pendingRows = Budget_Approvals[ID == apprIdText.toLong()];
                 						for each  pr in pendingRows
                 						{
                 							pr.Status="Not Sent";
                 							pr.Sent_Date=null;
                 							pr.Responded_Date=null;
                 						}
                 					}
                 				}
                 			}
                 			nextRows = Budget_Approvals[ID == nextApprovalId.toLong()];
                 			for each  nextApproval in nextRows
                 			{
                 				nextApproval.Status="Pending";
                 				// Only sendApprovalEmail may stamp Sent_Date after sendmail succeeds.
                 				nextApproval.Sent_Date=null;
                 				nextApproval.Responded_Date=null;
                 			}
                 			emailResp = thisapp.sendApprovalEmail(vBudgetId.toLong(),nextApprovalId.toLong());
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " " + vCurrentRole + " approved. " + emailResp + " " + syncResp;
                 		}
                 		else
                 		{
                 			/*****************************************************
                                  			 * FINAL APPROVER FINISHED
                                  			 *
                                  			 * Development:
                                  			 * - Development + Engineering Unapproved -> Final
                                  			 * - Development + Engineering Unapproved -> 0
                                  			 *
                                  			 * Construction:
                                  			 * - Construction Unapproved -> Final
                                  			 * - Construction Unapproved -> 0
                                  			 *****************************************************/
                 			finalizedCount = 0;
                 			finalizedTotal = 0;
                 			budgetCategoriesToFinalize = Budget_Category[Budget == vBudgetId.toLong()];
                 			for each  cat in budgetCategoriesToFinalize
                 			{
                 				deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 				shouldFinalize = false;
                 				if(vApprovalType == "Development")
                 				{
                 					if(deptKey.contains("development") || deptKey.contains("engineering"))
                 					{
                 						shouldFinalize = true;
                 					}
                 				}
                 				else if(vApprovalType == "Construction")
                 				{
                 					if(deptKey.contains("construction"))
                 					{
                 						shouldFinalize = true;
                 					}
                 				}
                 				if(shouldFinalize == true)
                 				{
                 					categoryId = cat.ID.toString();
                 					catItemsToFinalize = Budget_Item[Budget_Category == categoryId.toLong()];
                 					for each  itemToFinalize in catItemsToFinalize
                 					{
                 						unapprovedVal = 0;
                 						if(itemToFinalize.Unapproved_Final_Budget_Ttl != null)
                 						{
                 							unapprovedNum = itemToFinalize.Unapproved_Final_Budget_Ttl.toNumber();
                 							if(unapprovedNum != null)
                 							{
                 								unapprovedVal = unapprovedNum;
                 							}
                 						}
                 						// Move Unapproved into Final.
                 						itemToFinalize.Budget_Ttl=unapprovedVal;
                 						// Once the track finishes, Unapproved must be zero.
                 						itemToFinalize.Unapproved_Final_Budget_Ttl=0;
                 						finalizedCount = finalizedCount + 1;
                 						finalizedTotal = finalizedTotal + unapprovedVal;
                 					}
                 					/********* REFRESH THIS CATEGORY'S FINAL TOTAL *********/
                 					catFinalTotal = 0;
                 					catFinalSum = Budget_Item[Budget_Category == categoryId.toLong()].sum(Budget_Ttl);
                 					if(catFinalSum != null)
                 					{
                 						catFinalNum = catFinalSum.toNumber();
                 						if(catFinalNum != null)
                 						{
                 							catFinalTotal = catFinalNum;
                 						}
                 					}
                 					cat.Budget_Total=catFinalTotal;
                 				}
                 			}
                 			/********* REFRESH PARENT BUDGET FINAL GRAND TOTAL *********/
                 			newGrandTotal = 0;
                 			allBudgetCategories = Budget_Category[Budget == vBudgetId.toLong()];
                 			for each  catTotalRec in allBudgetCategories
                 			{
                 				if(catTotalRec.Budget_Total != null)
                 				{
                 					catTotalNum = catTotalRec.Budget_Total.toNumber();
                 					if(catTotalNum != null)
                 					{
                 						newGrandTotal = newGrandTotal + catTotalNum;
                 					}
                 				}
                 			}
                 			budgetRec.Budget_Grand_Total=newGrandTotal;
                 			finalizeResp = "Finalized " + finalizedCount + " " + vApprovalType + " items totaling " + finalizedTotal + " into Final and cleared Unapproved.";
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			/*****************************************************
                                  			 * CHECK WHETHER BOTH APPROVAL TRACKS ARE COMPLETE
                                  			 *****************************************************/
                 			hasDevelopmentTrack = false;
                 			hasConstructionTrack = false;
                 			allDevelopmentApproved = true;
                 			allConstructionApproved = true;
                 			allApprovalRows = Budget_Approvals[Budget == vBudgetId.toLong()];
                 			for each  finalCheckRow in allApprovalRows
                 			{
                 				finalCheckType = ifnull(finalCheckRow.Type1,"").trim();
                 				finalCheckStatus = ifnull(finalCheckRow.Status,"").trim();
                 				if(finalCheckType == "Development")
                 				{
                 					hasDevelopmentTrack = true;
                 					if(finalCheckStatus != "Approved")
                 					{
                 						allDevelopmentApproved = false;
                 					}
                 				}
                 				else if(finalCheckType == "Construction")
                 				{
                 					hasConstructionTrack = true;
                 					if(finalCheckStatus != "Approved")
                 					{
                 						allConstructionApproved = false;
                 					}
                 				}
                 			}
                 			pdfResp = "";
                 			if(hasDevelopmentTrack == true && hasConstructionTrack == true && allDevelopmentApproved == true && allConstructionApproved == true)
                 			{
                 				// generateApprovedBudgetPDF expects a STRING.
                 				pdfResp = thisapp.generateApprovedBudgetPDF(vBudgetId);
                 			}
                 			else
                 			{
                 				pdfResp = "Approved budget PDF will be generated after both approval tracks are fully approved.";
                 			}
                 			return vApprovalType + " approval chain fully approved. " + finalizeResp + " " + syncResp + " " + pdfResp;
                 		}
                 	}
                 	/********* REJECTED — SEND BACK TO PREVIOUS APPROVER *********/
                 	if(vAction == "Rejected")
                 	{
                 		// VP cannot reject because there is no previous approval row.
                 		if(vCurrentSort <= 1 || vCurrentRole == "VP")
                 		{
                 			currentApproval.Approval_Notes=vNote;
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " VP cannot reject because there is no previous approver. Note saved and approval remains Pending. " + syncResp;
                 		}
                 		currentApproval.Status="Rejected";
                 		currentApproval.Approval_Notes=vNote;
                 		currentApproval.Responded_Date=zoho.currentdate;
                 		previousApprovalId = "";
                 		previousSort = 0;
                 		/********* FIND PREVIOUS APPROVER IN THE SAME TRACK *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprSort = 0;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort < vCurrentSort && apprSort > previousSort)
                 				{
                 					previousSort = apprSort;
                 					previousApprovalId = appr.ID.toString();
                 				}
                 			}
                 		}
                 		if(previousApprovalId == "")
                 		{
                 			currentApproval.Status="Pending";
                 			currentApproval.Responded_Date=null;
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " " + vCurrentRole + " could not be rejected because no previous approver was found. Approval remains Pending. " + syncResp;
                 		}
                 		/********* PUSH THE CHAIN BACK ONE STEP *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprIdText = appr.ID.toString();
                 				apprSort = 0;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				apprRows = Budget_Approvals[ID == apprIdText.toLong()];
                 				for each  ar in apprRows
                 				{
                 					if(apprIdText == previousApprovalId)
                 					{
                 						ar.Status="Pending";
                 						ar.Sent_Date=null;
                 						ar.Responded_Date=null;
                 					}
                 					else if(apprSort > vCurrentSort)
                 					{
                 						ar.Status="Not Sent";
                 						ar.Sent_Date=null;
                 						ar.Responded_Date=null;
                 					}
                 				}
                 			}
                 		}
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		emailResp = thisapp.sendApprovalEmail(vBudgetId.toLong(),previousApprovalId.toLong());
                 		return vApprovalType + " " + vCurrentRole + " rejected. Sent back to previous approver. " + emailResp + " " + syncResp;
                 	}
                 	return "Unsupported approval action: " + vAction;
                 }
				 map handlePurchaseOrderApproval(map request)
                 {
                 	result = {"success":false,"contract":"po-v1","writeState":"not-started"};
                 	changed = false;
                 	try 
                 	{
                 		poId = request.get("id").toString();
                 		rowId = request.get("approvalId").toString();
                 		action = request.get("action");
                 		note = ifnull(request.get("note"),"").toString().trim();
                 		if(!poId.matches("[0-9]+") || !rowId.matches("[0-9]+") || note.length() > 10000)
                 		{
                 			result.put("error","PO, approval identity or note is invalid.");
                 			return result;
                 		}
                 		po = Payment_Request[ID == poId.toLong() && Budget == request.get("budgetId").toString().toLong() && Request_Type == "Purchase Order"];
                 		access = User_Access[User == zoho.loginuser];
                 		if(po.ID == null || access.count() != 1 || access.ID.toString() != request.get("userAccessId") || po.PO_Revision != request.get("expectedRevision"))
                 		{
                 			result.put("error","PO revision or authenticated User Access identity changed.");
                 			return result;
                 		}
                 		checked = thisapp.poApprovalBundle(poId);
                 		if(checked.get("success") != true)
                 		{
                 			result.put("error",checked.get("error"));
                 			return result;
                 		}
                 		bundle = checked.get("bundle");
                 		found = Map();
                 		for each  entry in bundle.get("rows")
                 		{
                 			if(entry.get("id") == rowId)
                 			{
                 				found = entry;
                 			}
                 		}
                 		notificationOnly = action == "RetryEmail" || (action == "CheckDecision" && request.get("decision") == "RetryEmail");
                 		authorized = found.get("id") != null;
                 		if(notificationOnly)
                 		{
                 			authorized = authorized && bundle.get("canRetryEmail") == true;
                 		}
                 		else
                 		{
                 			authorized = authorized && found.get("userAccessId") == access.ID.toString() && bundle.get("submitterId") != access.ID.toString();
                 		}
                 		if(authorized != true)
                 		{
                 			result.put("error","Only the assigned approver can decide; the submitter cannot approve.");
                 			return result;
                 		}
                 		wanted = "Approved";
                 		if(action == "Reject" || request.get("decision") == "Reject")
                 		{
                 			wanted = "Rejected";
                 		}
                 		if(action == "CheckDecision")
                 		{
                 			row = Budget_Approvals[ID == rowId.toLong()];
                 			decisionVerified = row.Status == wanted && row.Responded_Date != null && ifnull(row.Approval_Notes,"") == note;
                 			if(notificationOnly)
                 			{
                 				decisionVerified = row.Sent_Date != null;
                 			}
                 			if(decisionVerified != true)
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","The requested approval decision could not be verified. Do not replay it.");
                 				return result;
                 			}
                 		}
                 		else
                 		{
                 			if(action != "Approve" && action != "Reject" && action != "RetryEmail")
                 			{
                 				result.put("error","Unsupported PO approval action.");
                 				return result;
                 			}
                 			if(po.PO_Approval_State != "Pending" || bundle.get("active").get("id") != rowId || found.get("status") != "Pending")
                 			{
                 				result.put("error","This approval step is no longer active.");
                 				return result;
                 			}
                 			if(action == "RetryEmail")
                 			{
                 				mail = thisapp.sendPurchaseOrderEmail(poId);
                 			}
                 			else
                 			{
                 				priorNotes = ifnull(found.get("notes"),"");
                 				if(priorNotes != "" && note != priorNotes && !note.startsWith(priorNotes + "\n\n"))
                 				{
                 					result.put("error","Prior approval notes must be retained.");
                 					return result;
                 				}
                 				changed = true;
                 				row = Budget_Approvals[ID == rowId.toLong()];
                 				row.Status=wanted;
                 				row.Responded_Date=zoho.currentdate;
                 				row.Approval_Notes=note;
                 				if(wanted == "Rejected")
                 				{
                 					for each  modification in bundle.get("modifications")
                 					{
                 						mod = Budget_Modification[ID == modification.get("id").toLong()];
                 						mod.Status="Rejected";
                 					}
                 					po.PO_Approval_State="Rejected";
                 				}
                 				else if(found.get("order") == bundle.get("rows").size())
                 				{
                 					for each  modification in bundle.get("modifications")
                 					{
                 						mod = Budget_Modification[ID == modification.get("id").toLong()];
                 						mod.Status="Approved";
                 					}
                 					for each  modification in bundle.get("modifications")
                 					{
                 						thisapp.recalcItemRevisedFinal(modification.get("budgetItemId").toLong());
                 					}
                 					thisapp.recalcBudgetModifiedTotals(po.Budget.toLong());
                 					po.PO_Approval_State="Approved";
                 				}
                 				else
                 				{
                 					successorStep = bundle.get("rows").get(found.get("order"));
                 					successor = Budget_Approvals[ID == successorStep.get("id").toLong()];
                 					if(successor.Status != "Not Sent")
                 					{
                 						result.put("writeState","unknown");
                 						result.put("error","Successor state changed after the decision. Review this chain.");
                 						return result;
                 					}
                 					successor.Status="Pending";
                 					successor.Sent_Date=null;
                 					mail = thisapp.sendPurchaseOrderEmail(poId);
                 				}
                 			}
                 		}
                 		actual = thisapp.poSnapshot(poId);
                 		if(actual.get("success") != true)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error",actual.get("error"));
                 			return result;
                 		}
                 		saved = actual.get("snapshot");
                 		if(!notificationOnly)
                 		{
                 			row = Budget_Approvals[ID == rowId.toLong()];
                 			if(row.Status != wanted || row.Responded_Date == null || ifnull(row.Approval_Notes,"") != note || saved.get("commitmentState") != "Reserved")
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","PO approval decision was not verified.");
                 				return result;
                 			}
                 		}
                 		if(saved.get("approvalState") == "Approved")
                 		{
                 			financial = thisapp.poBudgetBalances(po.Budget.toString());
                 			if(financial.get("success") != true)
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","Approved PO balances could not be verified.");
                 				return result;
                 			}
                 			savedBundle = saved.get("approvalBundle");
                 			savedModifications = savedBundle.get("modifications");
                 			for each  modification in savedModifications
                 			{
                 				item = Budget_Item[ID == modification.get("budgetItemId").toLong()];
                 				matched = false;
                 				for each  balance in financial.get("balances")
                 				{
                 					if(balance.get("budgetItemId") == modification.get("budgetItemId"))
                 					{
                 						matched = true;
                 						expectedCents = balance.get("finalCents").toLong() + balance.get("modCents").toLong();
                 						actualText = thisapp.poCurrencyString(ifnull(item.Revised_Final,0).toString());
                 						if(actualText == "" || actualText.replaceAll("[.]","").toLong() != expectedCents)
                 						{
                 							result.put("writeState","unknown");
                 							result.put("error","Approved modification totals could not be verified.");
                 							return result;
                 						}
                 					}
                 				}
                 				if(matched != true)
                 				{
                 					result.put("writeState","unknown");
                 					result.put("error","An approved item balance is unavailable.");
                 					return result;
                 				}
                 			}
                 		}
                 		result.put("success",true);
                 		result.put("writeState","verified");
                 		result.put("snapshot",saved);
                 		result.put("decisionRowId",rowId);
                 		result.put("decision",wanted);
                 	}	catch (decisionError)
                 	{
                 		result.put("writeState",if(changed,"unknown","not-started"));
                 		result.put("error","The PO approval could not be verified. Use read-only Check before another decision.");
                 	}
                 	return result;
                 }
				 map Handle_Proforma_Approval_Action(string proformaId, string approvalId, string approvalAction, string approvalNote)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		actionText = ifnull(approvalAction,"").toString().trim();
                 		noteText = ifnull(approvalNote,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		actionLower = actionText.toLowerCase();
                 		if(actionLower == "approve" || actionLower == "approved")
                 		{
                 			actionText = "Approved";
                 		}
                 		else if(actionLower == "deny" || actionLower == "denied" || actionLower == "reject" || actionLower == "rejected")
                 		{
                 			actionText = "Rejected";
                 		}
                 		else if(actionLower == "pending")
                 		{
                 			actionText = "Pending";
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		row = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","The Pro Forma could not be found.");
                 			return response;
                 		}
                 		if(row.ID == null || row.Proforma == null || row.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval row not found for this Pro Forma.");
                 			return response;
                 		}
                 		if(actionText == "CheckReject" || actionText == "RepairReject")
                 		{
                 			chainRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
                 			if(firstRow.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","The first approval step could not be found.");
                 				return response;
                 			}
                 			isFirst = firstRow.ID.toString() == approvalIdText;
                 			noteMatches = noteText != "" && ifnull(row.Approval_Notes,"").toString() == noteText;
                 			if(actionText == "RepairReject" && ifnull(firstRow.Status,"") == "Pending" && firstRow.Sent_Date == null && noteMatches && ifnull(row.Status,"") == "Rejected")
                 			{
                 				emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Rejected",noteText,ifnull(row.Title,"Approver").toString());
                 				if(ifnull(emailResult.get("success"),false) != true)
                 				{
                 					response.put("repairError",ifnull(emailResult.get("message"),"The restart email could not be sent."));
                 				}
                 			}
                 			chainRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
                 			pendingCount = 0;
                 			approvedCount = 0;
                 			rowCount = 0;
                 			for each  chainRow in chainRows
                 			{
                 				rowCount = rowCount + 1;
                 				if(ifnull(chainRow.Status,"") == "Pending")
                 				{
                 					pendingCount = pendingCount + 1;
                 				}
                 				if(ifnull(chainRow.Status,"") == "Approved")
                 				{
                 					approvedCount = approvedCount + 1;
                 				}
                 			}
                 			response.put("success",true);
                 			response.put("proformaId",proformaIdText);
                 			response.put("approvalId",approvalIdText);
                 			response.put("status",ifnull(pf.Status,"").toString());
                 			response.put("currentStatus",ifnull(row.Status,"").toString());
                 			response.put("noteMatches",noteMatches);
                 			response.put("isFirst",isFirst);
                 			response.put("firstId",firstRow.ID.toString());
                 			response.put("firstStatus",ifnull(firstRow.Status,"").toString());
                 			response.put("rowCount",rowCount);
                 			response.put("pendingCount",pendingCount);
                 			response.put("approvedCount",approvedCount);
                 			response.put("role",ifnull(firstRow.Title,"").toString());
                 			response.put("address",ifnull(firstRow.Approver,"").toString());
                 			firstSent = "";
                 			if(firstRow.Sent_Date != null)
                 			{
                 				firstSent = firstRow.Sent_Date.toString();
                 			}
                 			response.put("sentDate",firstSent);
                 			return response;
                 		}
                 		if(actionText == "Pending")
                 		{
                 			if(row.Status != "Pending")
                 			{
                 				response.put("success",false);
                 				response.put("message","Only the currently pending approval can be updated.");
                 				return response;
                 			}
                 			row.Approval_Notes=noteText;
                 			response.put("success",true);
                 			response.put("message","Approval note saved.");
                 			return response;
                 		}
                 		if(row.Status != "Pending")
                 		{
                 			response.put("success",false);
                 			response.put("message","This approval has already been processed or is no longer pending.");
                 			return response;
                 		}
                 		if(actionText == "Approved")
                 		{
                 			originalRowNote = ifnull(row.Approval_Notes,"").toString();
                 			row.Approval_Notes=noteText;
                 			row.Status="Approved";
                 			row.Responded_Date=zoho.currenttime;
                 			nextOrder = row.Sort_Order + 1;
                 			nextRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == nextOrder];
                 			if(nextRow.ID != null)
                 			{
                 				originalNextStatus = ifnull(nextRow.Status,"Not Sent").toString();
                 				originalNextSentDate = nextRow.Sent_Date;
                 				originalNextRespondedDate = nextRow.Responded_Date;
                 				nextRow.Status="Pending";
                 				// The email helper stamps Sent_Date only after sendmail succeeds.
                 				nextRow.Sent_Date=null;
                 				nextRow.Responded_Date=null;
                 				emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,nextRow.ID.toString(),"Approved",noteText,ifnull(row.Title,"Approver").toString());
                 				if(ifnull(emailResult.get("success"),false) != true)
                 				{
                 					row.Status="Pending";
                 					row.Responded_Date=null;
                 					row.Approval_Notes=originalRowNote;
                 					nextRow.Status=originalNextStatus;
                 					nextRow.Sent_Date=originalNextSentDate;
                 					nextRow.Responded_Date=originalNextRespondedDate;
                 					response.put("success",false);
                 					response.put("message",ifnull(emailResult.get("message"),"The next approval email could not be sent."));
                 					return response;
                 				}
                 				pf.Status="Pending Approval";
                 				response.put("success",true);
                 				response.put("message","Approved and routed to " + ifnull(nextRow.Title,"the next approver").toString() + ".");
                 				return response;
                 			}
                 			// Missing sequence numbers must not finalize an incomplete route.
                 			finalRows = Budget_Approvals[Proforma == proformaIdLong];
                 			for each  finalRow in finalRows
                 			{
                 				if(ifnull(finalRow.Status,"") != "Approved")
                 				{
                 					row.Status="Pending";
                 					row.Responded_Date=null;
                 					row.Approval_Notes=originalRowNote;
                 					response.put("success",false);
                 					response.put("message","The approval route is incomplete. All approvers must approve before finalization.");
                 					return response;
                 				}
                 			}
                 			pf.Status="Approved";
                 			// Notification failure never undoes a completed approval or reopens the route.
                 			completionResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,approvalIdText,"Completed",noteText,ifnull(row.Title,"Approver").toString());
                 			completionSent = ifnull(completionResult.get("success"),false) == true;
                 			response.put("success",true);
                 			response.put("completionEmailSent",completionSent);
                 			response.put("message","Final approval completed. The Pro Forma is fully approved and ready to be submitted to the Legal Module. All approvers have been notified.");
                 			if(completionSent == false)
                 			{
                 				response.put("notificationWarning",ifnull(completionResult.get("message"),"The completion email could not be sent."));
                 				response.put("message","Final approval completed. The Pro Forma is fully approved and ready to be submitted to the Legal Module, but the completion email could not be sent to all approvers.");
                 			}
                 			return response;
                 		}
                 		if(actionText == "Rejected")
                 		{
                 			if(noteText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","A note is required when denying a Pro Forma approval.");
                 				return response;
                 			}
                 			// A rejection from ANY step restarts the chain at step 1 - the VP is the person who
                 			// can answer the objection - and every Pro Forma owner is told why. Snapshot every
                 			// row first so a failed email can put the chain back exactly as it was.
                 			chainRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
                 			if(firstRow.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","The first approval step could not be found.");
                 				return response;
                 			}
                 			snapStatus = Map();
                 			snapSent = Map();
                 			snapResponded = Map();
                 			snapNotes = Map();
                 			for each  snapRow in chainRows
                 			{
                 				snapKey = snapRow.ID.toString();
                 				snapStatus.put(snapKey,ifnull(snapRow.Status,"Not Sent").toString());
                 				snapNotes.put(snapKey,ifnull(snapRow.Approval_Notes,"").toString());
                 				if(snapRow.Sent_Date != null)
                 				{
                 					snapSent.put(snapKey,snapRow.Sent_Date);
                 				}
                 				if(snapRow.Responded_Date != null)
                 				{
                 					snapResponded.put(snapKey,snapRow.Responded_Date);
                 				}
                 			}
                 			rejectedById = row.ID.toString();
                 			rejectedRole = ifnull(row.Title,"Approver").toString();
                 			firstRole = ifnull(firstRow.Title,"Step 1").toString();
                 			for each  resetRow in chainRows
                 			{
                 				if(resetRow.ID.toString() != rejectedById)
                 				{
                 					resetRow.Status="Not Sent";
                 					resetRow.Approval_Notes="";
                 					resetRow.Sent_Date=null;
                 					resetRow.Responded_Date=null;
                 				}
                 			}
                 			row.Approval_Notes=noteText;
                 			row.Status="Rejected";
                 			row.Responded_Date=zoho.currenttime;
                 			// Step 1 is pending again. When step 1 itself rejected, it simply re-opens with its
                 			// own note attached.
                 			firstRow.Status="Pending";
                 			firstRow.Sent_Date=null;
                 			firstRow.Responded_Date=null;
                 			emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Rejected",noteText,rejectedRole);
                 			if(ifnull(emailResult.get("success"),false) != true)
                 			{
                 				for each  restoreRow in chainRows
                 				{
                 					restoreKey = restoreRow.ID.toString();
                 					restoreRow.Status=ifnull(snapStatus.get(restoreKey),"Not Sent").toString();
                 					restoreRow.Approval_Notes=ifnull(snapNotes.get(restoreKey),"").toString();
                 					restoreRow.Sent_Date=snapSent.get(restoreKey);
                 					restoreRow.Responded_Date=snapResponded.get(restoreKey);
                 				}
                 				response.put("success",false);
                 				response.put("message",ifnull(emailResult.get("message"),"The restart approval email could not be sent."));
                 				return response;
                 			}
                 			// Tell every Pro Forma owner. A failure here must not undo the restart - the chain is
                 			// already live again - so it only changes the message. Owner names are User_Access.Full_Name,
                 			// falling back to the login trimmed at "@" and "_" the way the widget labels owners.
                 			ownerEmails = List();
                 			ownerNames = List();
                 			if(pf.Owner != null)
                 			{
                 				for each  ownerRow in pf.Owner
                 				{
                 					ownerAccess = User_Access[ID == ownerRow.ID];
                 					if(ownerAccess.ID != null)
                 					{
                 						ownerUser = ifnull(ownerAccess.User,"").toString().trim();
                 						ownerEmail = ifnull(ownerAccess.Approver_Email,"").toString().trim();
                 						if(ownerEmail == "" && ownerUser.contains("@"))
                 						{
                 							ownerEmail = ownerUser;
                 						}
                 						if(ownerEmail != "" && ownerEmails.contains(ownerEmail) == false)
                 						{
                 							ownerEmails.add(ownerEmail);
                 						}
                 						ownerName = ifnull(ownerAccess.Full_Name,"").toString().trim();
                 						if(ownerName == "")
                 						{
                 							ownerName = ownerUser;
                 							if(ownerName == "")
                 							{
                 								ownerName = ownerEmail;
                 							}
                 							if(ownerName.contains("@"))
                 							{
                 								ownerName = ownerName.getPrefix("@");
                 							}
                 							if(ownerName.contains("_"))
                 							{
                 								ownerName = ownerName.getPrefix("_");
                 							}
                 						}
                 						if(ownerName != "" && ownerNames.contains(ownerName) == false)
                 						{
                 							ownerNames.add(ownerName);
                 						}
                 					}
                 				}
                 			}
                 			ownersNotified = false;
                 			if(ownerEmails.size() > 0)
                 			{
                 				try 
                 				{
                 					pfName = ifnull(pf.Name,"Pro Forma #" + proformaIdText).toString();
                 					safePfName = thisapp.PF_Packet_Escape(pfName);
                 					safeNote = thisapp.PF_Packet_Escape(noteText);
                 					safeRole = thisapp.PF_Packet_Escape(rejectedRole);
                 					safeFirstRole = thisapp.PF_Packet_Escape(firstRole);
                 					reviewUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Proforma_Management1?proformaId=" + proformaIdText;
                 					ownerHtml = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='width:100%;background:#eef3fa;margin:0;padding:0;'><tr><td align='center' style='padding:24px 12px;'>";
                 					ownerHtml = ownerHtml + "<table role='presentation' width='640' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:640px;background:#ffffff;border-collapse:separate;border-spacing:0;font-family:Arial,sans-serif;'>";
                 					ownerHtml = ownerHtml + "<tr><td style='background:#7f1d1d;color:#ffffff;padding:22px 26px;border-radius:15px 15px 0 0;border-bottom:4px solid #dc2626;'>";
                 					ownerHtml = ownerHtml + "<div style='font-size:11px;color:#fecaca;text-transform:uppercase;letter-spacing:.11em;font-weight:700;'>Pro Forma Rejected</div>";
                 					ownerHtml = ownerHtml + "<div style='font-size:22px;font-weight:700;line-height:1.2;margin-top:7px;'>" + safePfName + "</div>";
                 					ownerHtml = ownerHtml + "<div style='font-size:13px;color:#fee2e2;margin-top:8px;'>Rejected by <b>" + safeRole + "</b></div>";
                 					ownerHtml = ownerHtml + "</td></tr>";
                 					ownerHtml = ownerHtml + "<tr><td style='padding:22px 24px 24px;border-left:1px solid #dce5f0;border-right:1px solid #dce5f0;border-bottom:1px solid #dce5f0;border-radius:0 0 15px 15px;'>";
                 					ownerHtml = ownerHtml + "<p style='margin:0 0 14px;font-size:15px;color:#172033;'>Approvals restarted from step 1 (<b>" + safeFirstRole + "</b>). You are an owner of this Pro Forma.</p>";
                 					ownerHtml = ownerHtml + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td style='padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;'>";
                 					ownerHtml = ownerHtml + "<div style='font-size:11px;font-weight:800;color:#9a3412;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;'>Rejection note from " + safeRole + "</div>";
                 					ownerHtml = ownerHtml + "<div style='white-space:pre-wrap;color:#431407;line-height:1.5;'>" + safeNote + "</div>";
                 					ownerHtml = ownerHtml + "</td></tr></table>";
                 					ownerHtml = ownerHtml + "<table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:22px 0 6px;'><tr>";
                 					ownerHtml = ownerHtml + "<td align='center' bgcolor='#1e40af' width='160' height='42' style='width:160px;height:42px;background-color:#1e40af;border:1px solid #1e3a8a;border-radius:8px;'>";
                 					ownerHtml = ownerHtml + "<a href='" + reviewUrl + "' style='display:block;width:160px;height:42px;line-height:42px;font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Open Pro Forma</a>";
                 					ownerHtml = ownerHtml + "</td></tr></table>";
                 					ownerHtml = ownerHtml + "</td></tr></table></td></tr></table>";
                 					sendmail
                 					[
                 						from :"Notifications@wbdevelopment.com"
                 						to :ownerEmails
                 						subject :"Pro Forma rejected by " + rejectedRole + ": " + pfName
                 						message :ownerHtml
                 					]
                 					ownersNotified = true;
                 				}				catch (ownerMailError)
                 				{
                 					ownersNotified = false;
                 				}
                 			}
                 			pf.Status="Pending Approval";
                 			resultMessage = "Rejected. Approvals restarted from step 1 (" + firstRole + ")";
                 			if(ownersNotified)
                 			{
                 				resultMessage = resultMessage + " and " + ownerEmails.size().toString() + " Pro Forma owner(s) notified.";
                 			}
                 			else if(ownerEmails.size() == 0)
                 			{
                 				resultMessage = resultMessage + ". No owner email is on file to notify.";
                 			}
                 			else
                 			{
                 				resultMessage = resultMessage + ". The owner notification email could not be sent.";
                 			}
                 			response.put("success",true);
                 			response.put("message",resultMessage);
                 			response.put("ownersNotified",ownersNotified);
                 			response.put("ownerEmails",ownerEmails);
                 			return response;
                 		}
                 		response.put("success",false);
                 		response.put("message","Unsupported approval action: " + actionText);
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string killApprovalChain(string budgetId, string approvalType)
                 {
                 	/********* CANCEL ONE APPROVAL CHAIN *********/
                 	//
                 	// Development:
                 	// - Reset approval chain.
                 	// - Clear Development/Engineering Final and Unapproved through
                 	//   applyBudgetTrackFinalState.
                 	//
                 	// Construction:
                 	// - Reset approval chain.
                 	// - Move Construction Final back into Unapproved.
                 	// - Clear Construction Final.
                 	//
                 	// Construction will later resync from HeavyJob as needed.
                 	vBudgetId = budgetId.toLong();
                 	vType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0 || vType == "")
                 	{
                 		return "{\"ok\":false,\"error\":\"Missing budgetId or approvalType.\"}";
                 	}
                 	if(vType != "Development" && vType != "Construction")
                 	{
                 		return "{\"ok\":false,\"error\":\"approvalType must be Development or Construction.\"}";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
                 	}
                 	/********* RESET PARENT TRACK STATUS *********/
                 	if(vType == "Construction")
                 	{
                 		budgetRec.Const_Budget_Approval_Status="Not Sent";
                 	}
                 	else
                 	{
                 		budgetRec.Development_Budget_Approval_Status="Not Sent";
                 	}
                 	/********* RESET APPROVAL ROWS *********/
                 	rowsReset = 0;
                 	approvalRows = Budget_Approvals[Budget == vBudgetId && Type1 == vType];
                 	for each  ar in approvalRows
                 	{
                 		ar.Status="Not Sent";
                 		ar.Sent_Date=null;
                 		ar.Responded_Date=null;
                 		rowsReset = rowsReset + 1;
                 	}
                 	/********* MOVE CONSTRUCTION FINAL BACK TO UNAPPROVED *********/
                 	movedCount = 0;
                 	movedTotal = 0;
                 	if(vType == "Construction")
                 	{
                 		budgetCategories = Budget_Category[Budget == vBudgetId];
                 		for each  cat in budgetCategories
                 		{
                 			deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 			if(deptKey.contains("construction"))
                 			{
                 				constructionItems = Budget_Item[Budget_Category == cat.ID];
                 				for each  itemToMove in constructionItems
                 				{
                 					finalValue = ifnull(itemToMove.Budget_Ttl,0);
                 					// Move Final back into Unapproved.
                 					itemToMove.Unapproved_Final_Budget_Ttl=finalValue;
                 					// Clear Final.
                 					itemToMove.Budget_Ttl=0;
                 					movedCount = movedCount + 1;
                 					movedTotal = movedTotal + finalValue;
                 				}
                 			}
                 		}
                 	}
                 	/********* CLEAR TRACK TOTALS AND RECALCULATE BUDGET *********/
                 	// The Construction CLEAR behavior must preserve
                 	// Unapproved_Final_Budget_Ttl.
                 	financialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "",vType,"CLEAR");
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("approvalType",vType);
                 	resultMap.put("rowsReset",rowsReset);
                 	resultMap.put("constructionItemsMoved",movedCount);
                 	resultMap.put("constructionTotalMoved",movedTotal);
                 	resultMap.put("financialResult",financialResp);
                 	return resultMap.toString();
                 }
				 string killApprovalFlow(string budgetId)
                 {
                 	/********* CANCEL BOTH APPROVAL CHAINS *********/
                 	//
                 	// Development:
                 	// - Reset approval rows and status.
                 	// - Clear Development/Engineering Final and Unapproved.
                 	//
                 	// Construction:
                 	// - Reset approval rows and status.
                 	// - Move Construction Final back into Unapproved.
                 	// - Clear Construction Final.
                 	vBudgetId = budgetId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "{\"ok\":false,\"error\":\"No Budget ID provided.\"}";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
                 	}
                 	/********* RESET BOTH TRACK STATUSES *********/
                 	budgetRec.Const_Budget_Approval_Status="Not Sent";
                 	budgetRec.Development_Budget_Approval_Status="Not Sent";
                 	/********* RESET ALL APPROVAL ROWS *********/
                 	rowsReset = 0;
                 	approvalRows = Budget_Approvals[Budget == vBudgetId];
                 	for each  ar in approvalRows
                 	{
                 		ar.Status="Not Sent";
                 		ar.Sent_Date=null;
                 		ar.Responded_Date=null;
                 		rowsReset = rowsReset + 1;
                 	}
                 	/********* MOVE CONSTRUCTION FINAL BACK TO UNAPPROVED *********/
                 	constructionItemsMoved = 0;
                 	constructionTotalMoved = 0;
                 	budgetCategories = Budget_Category[Budget == vBudgetId];
                 	for each  cat in budgetCategories
                 	{
                 		deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 		if(deptKey.contains("construction"))
                 		{
                 			constructionItems = Budget_Item[Budget_Category == cat.ID];
                 			for each  itemToMove in constructionItems
                 			{
                 				finalValue = 0;
                 				if(itemToMove.Budget_Ttl != null)
                 				{
                 					finalValue = itemToMove.Budget_Ttl;
                 				}
                 				// Move Construction Final back into Unapproved.
                 				itemToMove.Unapproved_Final_Budget_Ttl=finalValue;
                 				// Clear Construction Final.
                 				itemToMove.Budget_Ttl=0;
                 				constructionItemsMoved = constructionItemsMoved + 1;
                 				constructionTotalMoved = constructionTotalMoved + finalValue;
                 			}
                 		}
                 	}
                 	/********* CLEAR AND RECALCULATE BOTH TRACKS *********/
                 	devFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Development","CLEAR");
                 	// Construction CLEAR must preserve Unapproved_Final_Budget_Ttl.
                 	constFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Construction","CLEAR");
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("rowsReset",rowsReset);
                 	resultMap.put("constructionItemsMoved",constructionItemsMoved);
                 	resultMap.put("constructionTotalMoved",constructionTotalMoved);
                 	resultMap.put("developmentFinancialResult",devFinancialResp);
                 	resultMap.put("constructionFinancialResult",constFinancialResp);
                 	return resultMap.toString();
                 }
				 map Kill_Proforma_Approval_Flow(string proformaId)
                 {
                 	response = Map();
                 	proformaIdText = ifnull(proformaId,"").toString();
                 	proformaIdText = proformaIdText.trim();
                 	if(proformaIdText == "")
                 	{
                 		response.put("success",false);
                 		response.put("message","Pro Forma ID is required.");
                 		return response;
                 	}
                 	proformaIdLong = proformaIdText.toLong();
                 	pf = Add_Pro_Forma[ID == proformaIdLong];
                 	rows = Budget_Approvals[Proforma == proformaIdLong];
                 	for each  row in rows
                 	{
                 		row.Status="Not Sent";
                 		row.Approval_Notes="";
                 		row.Sent_Date=null;
                 		row.Responded_Date=null;
                 	}
                 	if(pf.ID != null)
                 	{
                 		pf.Lock_Inputs=false;
                 		pf.Status="Draft";
                 	}
                 	response.put("success",true);
                 	response.put("message","Pro Forma approvals reset and all inputs unlocked.");
                 	return response;
                 }
				 string manageApprovalPolicies(string payload)
                 {
                 	result = {"success":false,"contract":"approval-policy-v1","writeState":"not-started"};
                 	auditId = 0;
                 	lockId = 0;
                 	try 
                 	{
                 		if(payload.length() > 60000)
                 		{
                 			result.put("error","Configuration request is too large.");
                 			return result.toString();
                 		}
                 		p = payload.toMap();
                 		action = ifnull(p.get("action"),"");
                 		typedIdentity = Map();
                 		typedIdentity.put("value",p.get("userAccessId"));
                 		if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 		{
                 			result.put("error","User Access identity must be a string.");
                 			return result.toString();
                 		}
                 		// Register this administration API with OAuth2, ADMIN ONLY scope.
                 		// Wider scopes require a separate authenticated-caller proof and explicit admin grant.
                 		access = User_Access[User == zoho.loginuser];
                 		if(access.count() != 1 || access.ID.toString() != p.get("userAccessId") || zoho.loginuser != zoho.adminuser)
                 		{
                 			result.put("error","Application-owner configuration access is required.");
                 			return result.toString();
                 		}
                 		if(action == "List")
                 		{
                 			return thisapp.approvalConfigurationSnapshot().toString();
                 		}
                 		if(action == "Preview")
                 		{
                 			return thisapp.resolveApprovalRoute(p.get("context")).toString();
                 		}
                 		if(action == "Reassign" || action == "EnableAdapter")
                 		{
                 			result.put("error","Reassignment authority and native workflow migration must be approved and verified first.");
                 			return result.toString();
                 		}
                 		token = ifnull(p.get("token"),"").toString();
                 		if(action == "Check")
                 		{
                 			audit = Approval_Config_Audit[Token == token && Actor == access.ID];
                 			if(audit.count() == 1 && audit.Status == "Complete")
                 			{
                 				result.put("success",true);
                 				result.put("writeState","verified");
                 				result.put("after",audit.After_JSON.toMap());
                 				result.put("token",token);
                 			}
                 			else
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","Configuration write is incomplete or unknown. Review its retained lock and audit receipt.");
                 			}
                 			return result.toString();
                 		}
                 		if(action != "SaveRole" && action != "SaveAssignment" && action != "SavePolicy" && action != "Publish" && action != "Retire")
                 		{
                 			result.put("error","Unsupported configuration action.");
                 			return result.toString();
                 		}
                 		if(!token.matches("[A-Za-z0-9-]{20,80}"))
                 		{
                 			result.put("error","Unique operation token is required.");
                 			return result.toString();
                 		}
                 		if(Approval_Config_Audit[Token == token].count() > 0)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","Operation already exists. Use read-only Check.");
                 			return result.toString();
                 		}
                 		before = thisapp.approvalConfigurationSnapshot();
                 		if(before.get("success") != true)
                 		{
                 			return before.toString();
                 		}
                 		data = p.get("data");
                 		idText = ifnull(data.get("id"),"").toString();
                 		identityFields = {"id"};
                 		if(action == "SaveAssignment")
                 		{
                 			identityFields = {"id","roleId","userAccessId","companyId"};
                 		}
                 		if(action == "SavePolicy")
                 		{
                 			identityFields = {"id","companyId"};
                 		}
                 		for each  identityField in identityFields
                 		{
                 			identityValue = data.get(identityField);
                 			if(identityField == "companyId" && identityValue == "")
                 			{
                 				continue;
                 			}
                 			if(identityField != "id" || (identityValue != null && identityValue != ""))
                 			{
                 				typedIdentity = Map();
                 				typedIdentity.put("value",identityValue);
                 				if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
                 				{
                 					result.put("error","Configuration identities must be exact ID strings.");
                 					return result.toString();
                 				}
                 			}
                 		}
                 		for each  dateField in {"effectiveFrom","effectiveTo"}
                 		{
                 			dateValue = ifnull(data.get(dateField),"");
                 			if(dateValue != "" && !dateValue.toString().matches("[0-9]{4}-[0-9]{2}-[0-9]{2}") || dateValue.toString().toDate("yyyy-MM-dd").toString("yyyy-MM-dd") != dateValue)
                 			{
                 				result.put("error","Configuration dates must be valid ISO dates.");
                 				return result.toString();
                 			}
                 		}
                 		if(action == "SavePolicy")
                 		{
                 			workflows = {"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
                 			typedVersion = Map();
                 			typedVersion.put("value",data.get("version"));
                 			if(!workflows.contains(data.get("workflow")) || !typedVersion.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*[1-9][0-9]{0,5}[ ]*[}][ ]*") || (data.get("enabled") != true && data.get("enabled") != false))
                 			{
                 				result.put("error","Workflow, positive integer version and explicit enabled setting are required.");
                 				return result.toString();
                 			}
                 		}
                 		lockId = insert into Approval_Config_Lock
                 		[
                 			Added_User=zoho.loginuser
                 			Lock_Key="shared-approval-policy"
                 			Operation_Token=token
                 		];
                 		beforeEntity = Map();
                 		beforeCollection = "policies";
                 		if(action == "SaveRole")
                 		{
                 			beforeCollection = "roles";
                 		}
                 		if(action == "SaveAssignment")
                 		{
                 			beforeCollection = "assignments";
                 		}
                 		before = thisapp.approvalConfigurationSnapshot();
                 		if(before.get("success") != true)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","Configuration could not be read under its write lock.");
                 			return result.toString();
                 		}
                 		if(action == "SavePolicy")
                 		{
                 			beforeConfiguration = before.get("configuration");
                 			otherPolicies = beforeConfiguration.get("policies");
                 			for each  otherPolicy in otherPolicies
                 			{
                 				if(otherPolicy.get("id") != idText && otherPolicy.get("companyId") == data.get("companyId") && otherPolicy.get("workflow") == data.get("workflow") && otherPolicy.get("territory") == ifnull(data.get("territory"),"") && otherPolicy.get("department") == ifnull(data.get("department"),"") && otherPolicy.get("version") == data.get("version"))
                 				{
                 					delete from Approval_Config_Lock[ID == lockId];
                 					lockId = 0;
                 					result.put("error","This scope already has that policy version. Choose a new version.");
                 					return result.toString();
                 				}
                 			}
                 		}
                 		previousCollection = before.get("configuration").get(beforeCollection);
                 		for each  previous in previousCollection
                 		{
                 			if(previous.get("id") == idText)
                 			{
                 				beforeEntity = previous;
                 			}
                 		}
                 		auditId = insert into Approval_Config_Audit
                 		[
                 			Added_User=zoho.loginuser
                 			Token=token
                 			Actor=access.ID
                 			Action=action
                 			Status="Started"
                 			Before_JSON=beforeEntity.toString()
                 			Intended_JSON=data.toString()
                 		];
                 		if(action == "SaveRole")
                 		{
                 			name = ifnull(data.get("name"),"").toString().trim();
                 			if(name == "" || name.length() > 80 || (data.get("active") != true && data.get("active") != false))
                 			{
                 				result.put("error","Role name and explicit active setting are required.");
                 			}
                 			else if(idText == "")
                 			{
                 				newId = insert into Approval_Role
                 				[
                 					Added_User=zoho.loginuser
                 					Role_Name=name
                 					Active=data.get("active")
                 				];
                 				idText = newId.toString();
                 			}
                 			else
                 			{
                 				role = Approval_Role[ID == idText.toLong()];
                 				if(role.ID == null)
                 				{
                 					result.put("error","Role was not found.");
                 				}
                 				else
                 				{
                 					role.Role_Name=name;
                 					role.Active=data.get("active");
                 				}
                 			}
                 		}
                 		if(action == "SaveAssignment")
                 		{
                 			companyId = null;
                 			if(data.get("companyId") != "")
                 			{
                 				company = Company[ID == data.get("companyId").toString().toLong()];
                 				companyId = company.ID;
                 			}
                 			role = Approval_Role[ID == data.get("roleId").toString().toLong()];
                 			person = User_Access[ID == data.get("userAccessId").toString().toLong()];
                 			if(role.ID == null || person.ID == null || (data.get("companyId") != "" && companyId == null) || (data.get("active") != true && data.get("active") != false))
                 			{
                 				result.put("error","Role, User Access, valid company scope and explicit active setting are required.");
                 			}
                 			else
                 			{
                 				fromDate = null;
                 				toDate = null;
                 				if(ifnull(data.get("effectiveFrom"),"") != "")
                 				{
                 					fromDate = data.get("effectiveFrom").toDate("yyyy-MM-dd");
                 				}
                 				if(ifnull(data.get("effectiveTo"),"") != "")
                 				{
                 					toDate = data.get("effectiveTo").toDate("yyyy-MM-dd");
                 				}
                 				if(fromDate != null && toDate != null && toDate <= fromDate)
                 				{
                 					result.put("error","Assignment end must follow start.");
                 				}
                 				else
                 				{
                 					if(idText == "")
                 					{
                 						newId = insert into Approval_Role_Assignment
                 						[
                 							Added_User=zoho.loginuser
                 							Role=role.ID
                 							Person=person.ID
                 							Company=companyId
                 						];
                 						idText = newId.toString();
                 					}
                 					assignment = Approval_Role_Assignment[ID == idText.toLong()];
                 					assignment.Role=role.ID;
                 					assignment.Person=person.ID;
                 					assignment.Company=companyId;
                 					assignment.Territory_Key=ifnull(data.get("territory"),"");
                 					assignment.Department_Key=ifnull(data.get("department"),"");
                 					assignment.Active=data.get("active");
                 					assignment.Effective_From=fromDate;
                 					assignment.Effective_To=toDate;
                 				}
                 			}
                 		}
                 		if(action == "SavePolicy")
                 		{
                 			companyId = null;
                 			if(data.get("companyId") != "")
                 			{
                 				company = Company[ID == data.get("companyId").toString().toLong()];
                 				companyId = company.ID;
                 			}
                 			if((data.get("companyId") == "" && data.get("workflow") != "Purchase Order") || (data.get("companyId") != "" && companyId == null) || data.get("steps").size() == 0 || data.get("steps").size() > 30 || data.get("steps").toString().length() > 40000)
                 			{
                 				result.put("error","Choose a company (or All companies for POs) and enter 1–30 ordered steps.");
                 			}
                 			else
                 			{
                 				if(idText == "")
                 				{
                 					newId = insert into Approval_Policy
                 					[
                 						Added_User=zoho.loginuser
                 						Company=companyId
                 						Status="Draft"
                 						Version=data.get("version")
                 						Adapter_Enabled=false
                 					];
                 					idText = newId.toString();
                 				}
                 				policy = Approval_Policy[ID == idText.toLong()];
                 				if(policy.Status != "Draft")
                 				{
                 					result.put("error","Published policies are immutable. Create a new Draft version.");
                 				}
                 				else
                 				{
                 					policy.Company=companyId;
                 					policy.Workflow=data.get("workflow");
                 					policy.Territory_Key=ifnull(data.get("territory"),"");
                 					policy.Department_Key=ifnull(data.get("department"),"");
                 					policy.Version=data.get("version");
                 					policy.Enabled=data.get("enabled");
                 					policy.Self_Approval=data.get("selfApproval");
                 					policy.Duplicate_Person=data.get("duplicatePerson");
                 					policy.Steps_JSON=data.get("steps").toString();
                 					policy.Effective_From=null;
                 					policy.Effective_To=null;
                 					if(ifnull(data.get("effectiveFrom"),"") != "")
                 					{
                 						policy.Effective_From=data.get("effectiveFrom").toDate("yyyy-MM-dd");
                 					}
                 					if(ifnull(data.get("effectiveTo"),"") != "")
                 					{
                 						policy.Effective_To=data.get("effectiveTo").toDate("yyyy-MM-dd");
                 					}
                 				}
                 			}
                 		}
                 		if(action == "Publish")
                 		{
                 			policy = Approval_Policy[ID == idText.toLong()];
                 			if(policy.Workflow == "Purchase Order" && policy.Self_Approval != "Deny" || policy.Duplicate_Person != "Reject")
                 			{
                 				result.put("error","Purchase Orders require distinct approvers and forbid submitter self-approval.");
                 			}
                 			if(policy.ID == null || policy.Status != "Draft" || policy.Version == null || policy.Version < 1 || (policy.Self_Approval != "Allow" && policy.Self_Approval != "Deny") || (policy.Duplicate_Person != "Separate steps" && policy.Duplicate_Person != "Reject"))
                 			{
                 				result.put("error","A valid Draft and explicit self/multiple-role rules are required.");
                 			}
                 			else
                 			{
                 				for each  other in Approval_Policy[Company == policy.Company && Workflow == policy.Workflow && Status == "Published" && ID != policy.ID]
                 				{
                 					overlaps = policy.Effective_From == null || other.Effective_To == null || policy.Effective_From < other.Effective_To && other.Effective_From == null || policy.Effective_To == null || other.Effective_From < policy.Effective_To;
                 					if(ifnull(other.Territory_Key,"") == ifnull(policy.Territory_Key,"") && ifnull(other.Department_Key,"") == ifnull(policy.Department_Key,"") && overlaps)
                 					{
                 						result.put("error","Published effective windows overlap at the same scope. Retire the previous window explicitly.");
                 					}
                 				}
                 				order = 0;
                 				keys = List();
                 				for each  step in policy.Steps_JSON.toJSONList()
                 				{
                 					order = order + 1;
                 					role = Approval_Role[ID == step.get("roleId").toString().toLong()];
                 					typedRole = Map();
                 					typedRole.put("value",step.get("roleId"));
                 					if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*") || !ifnull(step.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || role.ID == null || role.Active != true || step.get("order") != order || keys.contains(step.get("key")) || (step.get("enabled") != true && step.get("enabled") != false))
                 					{
                 						result.put("error","Policy steps have invalid roles, order, keys or enabled flags.");
                 					}
                 					keys.add(step.get("key"));
                 					condition = step.get("condition");
                 					if(policy.Workflow == "Pro Forma" || policy.Workflow == "Contract" && condition != "Always")
                 					{
                 						result.put("error","Pro Forma and Contract use straight approval chains without amount thresholds.");
                 					}
                 					if(condition != "Always" && condition != "Above" && condition != "At or above" && condition != "Budget modification attached" && condition != "Budget line exceeded")
                 					{
                 						result.put("error","Unsupported step condition.");
                 					}
                 					if(condition == "Budget modification attached" && policy.Workflow != "Purchase Order")
                 					{
                 						result.put("error","Linked budget modification conditions belong to Purchase Orders.");
                 					}
                 					if(condition == "Budget line exceeded" && policy.Workflow != "Purchase Order")
                 					{
                 						result.put("error","Budget-line overrun conditions belong to Purchase Orders.");
                 					}
                 					typedThreshold = Map();
                 					typedThreshold.put("value",step.get("threshold"));
                 					if(condition == "Above" || condition == "At or above" && !typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
                 					{
                 						result.put("error","Threshold must be a decimal string.");
                 					}
                 					if(condition == "Above" || condition == "At or above" && thisapp.poCurrencyString(ifnull(step.get("threshold"),"").toString()) == "")
                 					{
                 						result.put("error","Threshold must be exact currency.");
                 					}
                 				}
                 				if(order == 0 || order > 30 || (policy.Effective_From != null && policy.Effective_To != null && policy.Effective_To <= policy.Effective_From))
                 				{
                 					result.put("error","Invalid steps or effective window.");
                 				}
                 				if(result.get("error") == null)
                 				{
                 					policy.Status="Published";
                 				}
                 			}
                 		}
                 		if(action == "Retire")
                 		{
                 			policy = Approval_Policy[ID == idText.toLong()];
                 			end = data.get("effectiveTo").toDate("yyyy-MM-dd");
                 			if(policy.ID == null || policy.Status != "Published" || end < zoho.currentdate || (policy.Effective_From != null && end <= policy.Effective_From))
                 			{
                 				result.put("error","Retirement must be a valid current/future exclusive end date.");
                 			}
                 			else
                 			{
                 				policy.Effective_To=end;
                 			}
                 		}
                 		after = thisapp.approvalConfigurationSnapshot();
                 		audit = Approval_Config_Audit[ID == auditId];
                 		if(result.get("error") != null)
                 		{
                 			audit.Status="Rejected";
                 			audit.Error_Text=result.get("error");
                 			delete from Approval_Config_Lock[ID == lockId];
                 			return result.toString();
                 		}
                 		if(after.get("success") != true)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","Configuration write could not be read back. Lock retained.");
                 			return result.toString();
                 		}
                 		// Compare every intended field in the readback, including ordered steps and exact thresholds.
                 		collection = "policies";
                 		if(action == "SaveRole")
                 		{
                 			collection = "roles";
                 		}
                 		if(action == "SaveAssignment")
                 		{
                 			collection = "assignments";
                 		}
                 		found = Map();
                 		matches = 0;
                 		changedCollection = after.get("configuration").get(collection);
                 		for each  row in changedCollection
                 		{
                 			if(row.get("id") == idText)
                 			{
                 				found = row;
                 				matches = matches + 1;
                 			}
                 		}
                 		if(matches != 1)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","Unique changed configuration record was not verified.");
                 			return result.toString();
                 		}
                 		for each  field in data.keys()
                 		{
                 			if(field != "id" && field != "status" && field != "adapterEnabled" && ifnull(found.get(field),"").toString() != ifnull(data.get(field),"").toString())
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","Configuration readback differs: " + field);
                 				return result.toString();
                 			}
                 		}
                 		if(action == "Publish" && found.get("status") != "Published")
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","Publication state was not verified.");
                 			return result.toString();
                 		}
                 		audit.After_JSON=found.toString();
                 		audit.Status="Complete";
                 		delete from Approval_Config_Lock[ID == lockId];
                 		result.put("success",true);
                 		result.put("writeState","verified");
                 		result.put("token",token);
                 		result.put("after",found);
                 	}	catch (e)
                 	{
                 		result.put("writeState",if(lockId == 0,"not-started","unknown"));
                 		result.put("error","Configuration operation could not be verified. Check its audit receipt before another write.");
                 	}
                 	return result.toString();
                 }
				 string manageBudget(string budgetId, string action, string userAccessId)
                 {
                 	result = Map();
                 	result.put("success",false);
                 	result.put("action",ifnull(action,"").toString().trim().toLowerCase());
                 	budgetIdText = ifnull(budgetId,"").toString().trim();
                 	actionText = ifnull(action,"").toString().trim().toLowerCase();
                 	accessIdText = ifnull(userAccessId,"").toString().trim();
                 	if(budgetIdText == "")
                 	{
                 		result.put("error","Budget id is required.");
                 		return result.toString();
                 	}
                 	if(actionText != "archive" && actionText != "restore" && actionText != "delete")
                 	{
                 		result.put("error","Action must be archive, restore, or delete.");
                 		return result.toString();
                 	}
                 	if(accessIdText == "")
                 	{
                 		result.put("error","Delete & Archive Budgets access is required.");
                 		return result.toString();
                 	}
                 	accessRow = User_Access[User == zoho.loginuser];
                 	if(accessRow == null || accessRow.ID.toString() != accessIdText || accessRow.Delete_Archive_Budgets != true)
                 	{
                 		result.put("error","Delete & Archive Budgets access is required.");
                 		return result.toString();
                 	}
                 	budgetKey = budgetIdText.toLong();
                 	budgetRow = Add_Budget[ID == budgetKey];
                 	if(budgetRow == null)
                 	{
                 		result.put("error","Budget " + budgetIdText + " was not found.");
                 		return result.toString();
                 	}
                 	if(actionText == "archive" || actionText == "restore")
                 	{
                 		archiveValue = actionText == "archive";
                 		budgetRow.Archived=archiveValue;
                 		result.put("success",true);
                 		result.put("id",budgetIdText);
                 		result.put("archived",archiveValue);
                 		return result.toString();
                 	}
                 	if(Payment_Request[Budget == budgetKey && Request_Type == "Purchase Order"].count() > 0 || PO_Operation[Budget == budgetKey].count() > 0 || PO_Phase_Lock[Phase_Key == budgetIdText].count() > 0)
                 	{
                 		result.put("error","This budget has Purchase Orders or PO operation history. Archive it; deletion would destroy financial references.");
                 		return result.toString();
                 	}
                 	deleted = Map();
                 	deleteIds = List();
                 	for each  approvalRow in Budget_Approvals[Budget == budgetKey]
                 	{
                 		deleteIds.add(approvalRow.ID);
                 	}
                 	deleted.put("Budget_Approvals",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Budget_Approvals[ID == childId];
                 	}
                 	deleteIds = List();
                 	for each  modificationRow in Budget_Modification[Budget == budgetKey]
                 	{
                 		deleteIds.add(modificationRow.ID);
                 	}
                 	deleted.put("Budget_Modification",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Budget_Modification[ID == childId];
                 	}
                 	itemIds = List();
                 	for each  itemRow in Budget_Item[Budget == budgetKey]
                 	{
                 		itemIds.add(itemRow.ID);
                 	}
                 	unlinkedImports = 0;
                 	for each  itemId in itemIds
                 	{
                 		for each  importRow in Budget_Import_Item[Budget_Item == itemId]
                 		{
                 			importRow.Budget_Item=null;
                 			unlinkedImports = unlinkedImports + 1;
                 		}
                 	}
                 	deleted.put("Budget_Item",itemIds.size());
                 	deleted.put("Budget_Import_Item_Links_Cleared",unlinkedImports);
                 	for each  childId in itemIds
                 	{
                 		delete from Budget_Item[ID == childId];
                 	}
                 	deleteIds = List();
                 	for each  categoryRow in Budget_Category[Budget == budgetKey]
                 	{
                 		deleteIds.add(categoryRow.ID);
                 	}
                 	deleted.put("Budget_Category",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Budget_Category[ID == childId];
                 	}
                 	deleteIds = List();
                 	for each  monthRow in Budget_Months[Budget == budgetKey]
                 	{
                 		deleteIds.add(monthRow.ID);
                 	}
                 	deleted.put("Budget_Months",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Budget_Months[ID == childId];
                 	}
                 	deleteIds = List();
                 	for each  attachmentRow in Attachment[Budget == budgetKey]
                 	{
                 		deleteIds.add(attachmentRow.ID);
                 	}
                 	deleted.put("Attachment",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Attachment[ID == childId];
                 	}
                 	deleteIds = List();
                 	for each  commentRow in Comment_Log[Budget == budgetKey]
                 	{
                 		deleteIds.add(commentRow.ID);
                 	}
                 	deleted.put("Comment_Log",deleteIds.size());
                 	for each  childId in deleteIds
                 	{
                 		delete from Comment_Log[ID == childId];
                 	}
                 	delete from Add_Budget[ID == budgetKey];
                 	result.put("success",true);
                 	result.put("id",budgetIdText);
                 	result.put("deleted",deleted);
                 	return result.toString();
                 }
				 string managePurchaseOrder(string payload)
                 {
                 	result = {"success":false,"contract":"po-v1","writeState":"not-started"};
                 	operationId = 0;
                 	lockId = 0;
                 	writeStarted = false;
                 	wasReserved = false;
                 	priorBundle = Map();
                 	modificationPlan = List();
                 	budgetExceeded = false;
                 	try 
                 	{
                 		p = payload.toMap();
                 		action = ifnull(p.get("action"),"");
                 		for each  identityField in {"budgetId","userAccessId"}
                 		{
                 			typedIdentity = {"value":p.get(identityField)};
                 			if(!typedIdentity.toString().matches("[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}]"))
                 			{
                 				result.put("error","Creator identities must be exact ID strings.");
                 				return result.toString();
                 			}
                 		}
                 		if(p.get("id") != null && p.get("id") != "")
                 		{
                 			typedIdentity = {"value":p.get("id")};
                 			if(!typedIdentity.toString().matches("[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}]"))
                 			{
                 				result.put("error","PO identity must be a string.");
                 				return result.toString();
                 			}
                 		}
                 		access = User_Access[User == zoho.loginuser];
                 		if(access.count() != 1 || access.ID.toString() != ifnull(p.get("userAccessId"),"").toString())
                 		{
                 			result.put("error","An unambiguous authenticated User Access identity is required.");
                 			return result.toString();
                 		}
                 		budgetId = ifnull(p.get("budgetId"),"").toString();
                 		if(!budgetId.matches("[0-9]+"))
                 		{
                 			result.put("error","Phase budget is required.");
                 			return result.toString();
                 		}
                 		budget = Add_Budget[ID == budgetId.toLong()];
                 		if(budget.ID == null)
                 		{
                 			result.put("error","Phase budget was not found.");
                 			return result.toString();
                 		}
                 		canEdit = access.Edit_All_Budgets == true;
                 		for each  owner in budget.Budget_Owner
                 		{
                 			if(owner.ID == access.ID && access.Edit_Owned_Budgets == true)
                 			{
                 				canEdit = true;
                 			}
                 		}
                 		if(action == "Approve" || action == "Reject" || action == "CheckDecision" || action == "RetryEmail")
                 		{
                 			return thisapp.handlePurchaseOrderApproval(p).toString();
                 		}
                 		if(action == "ApprovalPO")
                 		{
                 			rowId = p.get("approvalId").toString();
                 			matchId = "";
                 			for each  captured in Approval_Route_Snapshot[Workflow == "Purchase Order"]
                 			{
                 				if(ifnull(captured.Execution_JSON,"") != "" && captured.Execution_JSON.toJSONList().contains(rowId) && captured.Context_JSON.toMap().get("budgetId") == budgetId)
                 				{
                 					matchId = captured.Record_ID;
                 				}
                 			}
                 			if(matchId == "")
                 			{
                 				result.put("error","This PO approval could not be resolved.");
                 				return result.toString();
                 			}
                 			result = thisapp.poSnapshot(matchId);
                 			result.put("contract","po-v1");
                 			return result.toString();
                 		}
                 		if(action == "Vendors")
                 		{
                 			rows = List();
                 			for each  vendorChoice in Vendors[ID != null] sort by Vendor_Name
                 			{
                 				rows.add({"ID":vendorChoice.ID.toString(),"Vendor_Name":vendorChoice.Vendor_Name});
                 			}
                 			result.put("vendors",rows);
                 			result.put("success",true);
                 			return result.toString();
                 		}
                 		if(action == "Get")
                 		{
                 			po = Payment_Request[ID == p.get("id").toString().toLong() && Budget == budget.ID];
                 			if(po.ID == null)
                 			{
                 				result.put("error","PO not found in this phase.");
                 				return result.toString();
                 			}
                 			result = thisapp.poSnapshot(po.ID.toString());
                 			result.put("contract","po-v1");
                 			return result.toString();
                 		}
                 		if(action == "List")
                 		{
                 			rows = List();
                 			for each  po in Payment_Request[Budget == budget.ID && Request_Type == "Purchase Order" && PO_Revision != null && PO_Revision != ""]
                 			{
                 				rows.add({"id":po.ID.toString(),"amount":po.PO_Amount_Exact,"status":po.PO_Status,"revision":po.PO_Revision,"vendorId":po.Vendor.toString()});
                 			}
                 			result.put("rows",rows);
                 			result.put("success",true);
                 			return result.toString();
                 		}
                 		if(action == "Check")
                 		{
                 			op = PO_Operation[Token == p.get("token") && Budget == budget.ID && Actor == access.ID];
                 			if(op.ID == null)
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","No operation receipt is visible. Do not replay this write.");
                 				return result.toString();
                 			}
                 			result.put("token",op.Token);
                 			if(op.Status == "Rejected")
                 			{
                 				result.put("writeState","not-started");
                 				result.put("error",op.Error_Text);
                 				return result.toString();
                 			}
                 			if(op.Purchase_Order == null)
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","Operation has not verified a parent. Review the phase lock.");
                 				return result.toString();
                 			}
                 			actual = thisapp.poSnapshot(op.Purchase_Order.toString());
                 			sameSnapshot = false;
                 			if(actual.get("success") == true && op.Status == "Complete")
                 			{
                 				currentSnapshot = actual.get("snapshot");
                 				recordedSnapshot = op.Snapshot_JSON.toMap();
                 				sameSnapshot = true;
                 				if(recordedSnapshot.get("format") == "sha256-v1")
                 				{
                 					sameSnapshot = recordedSnapshot.get("digest") == zoho.encryption.sha256(currentSnapshot.toString());
                 				}
                 				else
                 				{
                 					for each  headerField in {"id","budgetId","vendorId","budgetModificationId","amount","requestDate","dateNeeded","revision","status","commitmentState","approvalState"}
                 					{
                 						if(currentSnapshot.get(headerField) != recordedSnapshot.get(headerField))
                 						{
                 							sameSnapshot = false;
                 						}
                 					}
                 					if(currentSnapshot.get("lines").toString() != recordedSnapshot.get("lines").toString())
                 					{
                 						sameSnapshot = false;
                 					}
                 					if(currentSnapshot.get("approvalBundle") != null)
                 					{
                 						if(currentSnapshot.get("approvalBundle").get("rows").toString() != recordedSnapshot.get("approvalBundle").get("rows").toString() || currentSnapshot.get("approvalBundle").get("modifications").toString() != recordedSnapshot.get("approvalBundle").get("modifications").toString())
                 						{
                 							sameSnapshot = false;
                 						}
                 					}
                 				}
                 			}
                 			if(actual.get("success") == true && actual.get("snapshot").get("revision") == op.Token && sameSnapshot == true)
                 			{
                 				result.put("success",true);
                 				result.put("writeState","verified");
                 				result.put("snapshot",actual.get("snapshot"));
                 			}
                 			else
                 			{
                 				result.put("writeState","unknown");
                 				result.put("error","Operation is incomplete or has a newer revision. Read-only review is required.");
                 			}
                 			return result.toString();
                 		}
                 		if(action == "Balances")
                 		{
                 			if(PO_Phase_Lock[Phase_Key == budgetId].count() > 0)
                 			{
                 				result.put("error","This phase has a write in progress or an unresolved operation.");
                 				return result.toString();
                 			}
                 			result = thisapp.poBudgetBalances(budgetId);
                 			result.put("contract","po-v1");
                 			return result.toString();
                 		}
                 		if(action != "Save" && action != "Submit")
                 		{
                 			result.put("error","Unsupported PO action.");
                 			return result.toString();
                 		}
                 		// Owner approved Creator's Max Digits 16 / Places 2 on 2026-10-08.
                 		// Currency boundary persisted exactly in the native Development test.
                 		if(canEdit != true || budget.Archived == true)
                 		{
                 			result.put("error","Budget edit permission on an active phase is required.");
                 			return result.toString();
                 		}
                 		validated = thisapp.poValidatePayload(payload);
                 		if(validated.get("success") != true)
                 		{
                 			validated.put("contract","po-v1");
                 			return validated.toString();
                 		}
                 		p = validated.get("payload");
                 		token = p.get("token");
                 		result.put("token",token);
                 		if(PO_Operation[Token == token].count() > 0)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","This operation token already exists. Use Check; do not send it again.");
                 			return result.toString();
                 		}
                 		vendor = Vendors[ID == p.get("vendorId").toLong()];
                 		if(vendor.ID == null)
                 		{
                 			result.put("error","Vendor was not found.");
                 			return result.toString();
                 		}
                 		linkedModificationId = null;
                 		if(p.get("budgetModificationId") != null)
                 		{
                 			linkedModification = Budget_Modification[ID == p.get("budgetModificationId").toLong()];
                 			if(linkedModification.ID == null || linkedModification.Budget != budget.ID)
                 			{
                 				result.put("error","Linked budget modification must belong to this PO phase.");
                 				return result.toString();
                 			}
                 			linkedModificationId = linkedModification.ID;
                 		}
                 		idText = ifnull(p.get("id"),"").toString();
                 		expected = ifnull(p.get("expectedRevision"),"").toString();
                 		if(idText != "")
                 		{
                 			po = Payment_Request[ID == idText.toLong() && Budget == budget.ID];
                 			if(po.ID == null || po.Request_Type != "Purchase Order" || (po.PO_Status != "Draft" && !(po.PO_Status == "Submitted" && po.PO_Approval_State == "Rejected")) || ifnull(po.PO_Revision,"") == "" || po.PO_Revision != expected)
                 			{
                 				result.put("error","Only the current Draft or Rejected PO can be edited or submitted.");
                 				return result.toString();
                 			}
                 		}
                 		if(idText != "" && po.PO_Commitment_State == "Reserved")
                 		{
                 			wasReserved = true;
                 			beforePO = thisapp.poSnapshot(idText);
                 			if(beforePO.get("success") != true)
                 			{
                 				result.put("error",beforePO.get("error"));
                 				return result.toString();
                 			}
                 			priorBundle = beforePO.get("snapshot").get("approvalBundle");
                 			if(validated.get("totalCents") != p.get("amount").replaceAll("[.]",""))
                 			{
                 				result.put("error","An edited reserved PO must keep its header and line total balanced.");
                 				return result.toString();
                 			}
                 		}
                 		else if(expected != "" && idText == "")
                 		{
                 			result.put("error","New POs cannot have an expected revision.");
                 			return result.toString();
                 		}
                 		// Unique fields arbitrate competing operations. No expiry or automatic lock takeover.
                 		lockId = insert into PO_Phase_Lock
                 		[
                 			Added_User=zoho.loginuser
                 			Phase_Key=budgetId
                 			Operation_Token=token
                 			Actor=access.ID
                 		];
                 		requestProof = {"action":action,"token":token,"budgetId":budgetId,"lineCount":p.get("lines").size(),"digest":zoho.encryption.sha256(p.toString())};
                 		operationId = insert into PO_Operation
                 		[
                 			Added_User=zoho.loginuser
                 			Token=token
                 			Budget=budget.ID
                 			Actor=access.ID
                 			Request_JSON=requestProof.toString()
                 			Status="Started"
                 		];
                 		// Recheck identity, permission and compare-and-set revision after acquiring the phase lock.
                 		access = User_Access[User == zoho.loginuser];
                 		budget = Add_Budget[ID == budgetId.toLong()];
                 		canEdit = access.count() == 1 && access.ID.toString() == p.get("userAccessId") && access.Edit_All_Budgets == true;
                 		for each  owner in budget.Budget_Owner
                 		{
                 			if(access.count() == 1 && access.ID.toString() == p.get("userAccessId") && owner.ID == access.ID && access.Edit_Owned_Budgets == true)
                 			{
                 				canEdit = true;
                 			}
                 		}
                 		if(canEdit != true || budget.Archived == true)
                 		{
                 			result.put("error","Phase edit permission changed before this write.");
                 		}
                 		if(idText != "")
                 		{
                 			po = Payment_Request[ID == idText.toLong() && Budget == budget.ID];
                 			if((po.PO_Status != "Draft" && !(po.PO_Status == "Submitted" && po.PO_Approval_State == "Rejected")) || po.PO_Revision != expected)
                 			{
                 				result.put("error","The PO changed while this request was waiting.");
                 			}
                 		}
                 		for each  line in p.get("lines")
                 		{
                 			item = Budget_Item[ID == line.get("budgetItemId").toLong() && Budget == budget.ID && Template_Item != true];
                 			category = Budget_Category[ID == item.Budget_Category && Budget == budget.ID];
                 			track = "";
                 			if(category.Deparment == "Construction")
                 			{
                 				track = "Construction";
                 			}
                 			if(category.Deparment == "Development" || category.Deparment == "Engineering")
                 			{
                 				track = "Development";
                 			}
                 			locked = false;
                 			if(track == "Construction")
                 			{
                 				locked = budget.Const_Budget_Approval_Status == "Pending" || budget.Const_Budget_Approval_Status == "Approved";
                 			}
                 			if(track == "Development")
                 			{
                 				locked = budget.Development_Budget_Approval_Status == "Pending" || budget.Development_Budget_Approval_Status == "Approved";
                 			}
                 			for each  approval in Budget_Approvals[Budget == budget.ID && Type1 == track]
                 			{
                 				if(approval.Status == "Pending" || approval.Status == "Approved")
                 				{
                 					locked = true;
                 				}
                 			}
                 			subdivisionCode = ifnull(budget.Subdivision1.Subdivision_Code,"");
                 			minorCode = ifnull(item.Cost_Code,0).toString();
                 			generatedCode = "C_" + subdivisionCode + "-" + minorCode + "-" + line.get("costElement");
                 			if(subdivisionCode == "" || minorCode == "0" || line.get("costCode") != generatedCode)
                 			{
                 				result.put("error","Generated cost code changed or is unavailable. Refresh the item balance.");
                 			}
                 			if(item.ID == null || category.ID == null || track == "" || locked != true)
                 			{
                 				result.put("error","A selected Budget Item is no longer eligible in this phase.");
                 			}
                 		}
                 		if(action == "Submit" && result.get("error") == null)
                 		{
                 			balances = thisapp.poBudgetBalances(budgetId);
                 			if(balances.get("success") != true)
                 			{
                 				result.put("error",balances.get("error"));
                 			}
                 			else
                 			{
                 				available = Map();
                 				pendingCredits = Map();
                 				ownAllocation = Map();
                 				ownCredits = Map();
                 				for each  balance in balances.get("balances")
                 				{
                 					available.put(balance.get("budgetItemId"),balance.get("availableCents").toLong());
                 					pendingCredits.put(balance.get("budgetItemId"),ifnull(balance.get("pendingModificationCents"),"0").toLong());
                 				}
                 				if(wasReserved)
                 				{
                 					priorSnapshot = beforePO.get("snapshot");
                 					priorLines = priorSnapshot.get("lines");
                 					for each  oldLine in priorLines
                 					{
                 						itemKey = oldLine.get("budgetItemId");
                 						ownAllocation.put(itemKey,ifnull(ownAllocation.get(itemKey),0) + oldLine.get("finalAmount").replaceAll("[.]","").toLong());
                 					}
                 					for each  oldMod in priorBundle.get("modifications")
                 					{
                 						ownCredits.put(oldMod.get("budgetItemId"),oldMod.get("amount").replaceAll("[.]","").toLong());
                 					}
                 				}
                 				groupedCents = validated.get("groupedCents");
                 				for each  itemKey in groupedCents.keys()
                 				{
                 					if(available.get(itemKey) == null)
                 					{
                 						result.put("error","A selected item has no verified balance.");
                 					}
                 					else
                 					{
                 						beforeAvailable = available.get(itemKey) + ifnull(ownAllocation.get(itemKey),0);
                 						otherPending = ifnull(pendingCredits.get(itemKey),0) - ifnull(ownCredits.get(itemKey),0);
                 						if(p.get("expectedBalances") == null || p.get("expectedBalances").get(itemKey) != beforeAvailable.toString() || p.get("expectedPendingModifications") == null || p.get("expectedPendingModifications").get(itemKey) != otherPending.toString())
                 						{
                 							result.put("error","Item balances changed. Refresh and review before submitting.");
                 						}
                 						shortfall = groupedCents.get(itemKey) - beforeAvailable - otherPending;
                 						if(groupedCents.get(itemKey) > beforeAvailable)
                 						{
                 							budgetExceeded = true;
                 						}
                 						if(shortfall > 0)
                 						{
                 							if(shortfall > 999999999999999)
                 							{
                 								result.put("error","Automatic modification exceeds supported currency capacity.");
                 							}
                 							centsText = shortfall.toString();
                 							if(centsText.length() == 1)
                 							{
                 								centsText = "00" + centsText;
                 							}
                 							if(centsText.length() == 2)
                 							{
                 								centsText = "0" + centsText;
                 							}
                 							amountText = centsText.subString(0,centsText.length() - 2) + "." + centsText.subString(centsText.length() - 2,centsText.length());
                 							modificationPlan.add({"budgetItemId":itemKey,"amount":amountText});
                 						}
                 					}
                 				}
                 			}
                 			companyText = "";
                 			territory = "";
                 			if(budget.Subdivision1 != null)
                 			{
                 				territory = ifnull(budget.Subdivision1.Territory,"");
                 				if(budget.Subdivision1.Company1 != null)
                 				{
                 					companyText = budget.Subdivision1.Company1.ID.toString();
                 				}
                 			}
                 			context = {"workflow":"Purchase Order","budgetId":budgetId,"companyId":companyText,"territory":territory,"department":"","submitterId":access.ID.toString(),"effectiveDate":zoho.currentdate.toString("yyyy-MM-dd"),"amount":p.get("amount"),"hasBudgetModification":modificationPlan.size() > 0,"hasBudgetOverrun":budgetExceeded};
                 			resolved = thisapp.resolveApprovalRoute(context);
                 			if(resolved.get("success") != true)
                 			{
                 				result.put("error",resolved.get("error"));
                 			}
                 			else
                 			{
                 				cfoFound = false;
                 				cooFound = false;
                 				vpFound = false;
                 				resolvedSnapshot = resolved.get("snapshot");
                 				resolvedSteps = resolvedSnapshot.get("route");
                 				approvalTitles = {"VP","Legal","CFO","COO","CEO"};
                 				for each  step in resolvedSteps
                 				{
                 					if(!approvalTitles.contains(step.get("role")))
                 					{
                 						result.put("error","PO template role must match an existing approval title: VP, Legal, CFO, COO or CEO.");
                 					}
                 					if(step.get("role") == "CFO")
                 					{
                 						cfoFound = true;
                 					}
                 					if(step.get("role") == "COO")
                 					{
                 						cooFound = true;
                 					}
                 					if(step.get("role") == "VP")
                 					{
                 						vpFound = true;
                 					}
                 				}
                 				if(cfoFound != true)
                 				{
                 					result.put("error","Every PO must include CFO approval.");
                 				}
                 				if(budgetExceeded && cooFound != true || vpFound != true)
                 				{
                 					result.put("error","POs exceeding any available item budget require both COO and Territory VP approval.");
                 				}
                 			}
                 		}
                 		operation = PO_Operation[ID == operationId];
                 		if(result.get("error") != null)
                 		{
                 			operation.Status="Rejected";
                 			operation.Error_Text=result.get("error");
                 			delete from PO_Phase_Lock[ID == lockId];
                 			return result.toString();
                 		}
                 		writeStarted = true;
                 		if(idText == "")
                 		{
                 			parentId = insert into Payment_Request
                 			[
                 				Added_User=zoho.loginuser
                 				Request_Type="Purchase Order"
                 				Budget=budget.ID
                 				Vendor=vendor.ID
                 				PO_Budget_Modification=linkedModificationId
                 				Request_Date=p.get("requestDate").toDate("yyyy-MM-dd")
                 				Date_Needed=p.get("dateNeeded").toDate("yyyy-MM-dd")
                 				Request_Amount=p.get("amount").toDecimal()
                 				PO_Amount_Exact=p.get("amount")
                 				PO_Client_Key=token
                 				PO_Status="Draft"
                 				PO_Commitment_State="None"
                 				PO_Approval_State="Not Configured"
                 				Budget_Item=null
                 				Accounting_Project_Code=null
                 				Element=null
                 				Final_Accounting_Code=null
                 			];
                 			idText = parentId.toString();
                 		}
                 		operation.Purchase_Order=idText.toLong();
                 		order = 0;
                 		for each  line in p.get("lines")
                 		{
                 			order = order + 1;
                 			q = null;
                 			price = null;
                 			if(line.get("pricingMode") == "Calculated")
                 			{
                 				q = line.get("quantity").toDecimal();
                 				price = line.get("unitPrice").toDecimal();
                 			}
                 			childId = insert into PO_Item
                 			[
                 				Added_User=zoho.loginuser
                 				Revision_Line_Key=token + "-" + line.get("key")
                 				Purchase_Order=idText.toLong()
                 				Budget_Item=line.get("budgetItemId").toLong()
                 				Line_Key=line.get("key")
                 				Revision=token
                 				Line_Order=order
                 				Description=line.get("description")
                 				Cost_Element=line.get("costElement")
                 				UOM=line.get("uom")
                 				Cost_Code=line.get("costCode")
                 				Pricing_Mode=line.get("pricingMode")
                 				Quantity=q
                 				Unit_Price=price
                 				Final_Amount=line.get("finalAmount").toDecimal()
                 				Quantity_Exact=line.get("quantity")
                 				Unit_Price_Exact=line.get("unitPrice")
                 				Final_Amount_Exact=line.get("finalAmount")
                 			];
                 		}
                 		po = Payment_Request[ID == idText.toLong()];
                 		po.Vendor=vendor.ID;
                 		po.Request_Date=p.get("requestDate").toDate("yyyy-MM-dd");
                 		po.Date_Needed=p.get("dateNeeded").toDate("yyyy-MM-dd");
                 		po.PO_Budget_Modification=linkedModificationId;
                 		po.Request_Amount=p.get("amount").toDecimal();
                 		po.PO_Amount_Exact=p.get("amount");
                 		po.Budget_Item=null;
                 		po.Accounting_Project_Code=null;
                 		po.Element=null;
                 		po.Final_Accounting_Code=null;
                 		po.PO_Line_Count=order;
                 		po.PO_Status="Draft";
                 		po.PO_Commitment_State="None";
                 		po.PO_Approval_State="Not Configured";
                 		if(wasReserved)
                 		{
                 			po.PO_Status="Submitted";
                 			po.PO_Commitment_State="Reserved";
                 			po.PO_Approval_State="Rejected";
                 		}
                 		if(action == "Submit")
                 		{
                 			po.PO_Status="Submitted";
                 			po.PO_Commitment_State="Reserved";
                 		}
                 		// The pointer is last. Old revisions remain immutable evidence; writes are NOT transactional.
                 		po.PO_Revision=token;
                 		if(action == "Submit")
                 		{
                 			linkedModificationId = null;
                 			modifications = List();
                 			for each  plan in modificationPlan
                 			{
                 				item = Budget_Item[ID == plan.get("budgetItemId").toLong()];
                 				category = Budget_Category[ID == item.Budget_Category];
                 				track = "Development";
                 				if(category.Deparment == "Construction")
                 				{
                 					track = "Construction";
                 				}
                 				modId = 0;
                 				if(wasReserved)
                 				{
                 					for each  priorMod in priorBundle.get("modifications")
                 					{
                 						if(priorMod.get("budgetItemId") == plan.get("budgetItemId"))
                 						{
                 							modId = priorMod.get("id").toLong();
                 						}
                 					}
                 				}
                 				reference = "PO:" + idText + ":" + token;
                 				if(modId == 0)
                 				{
                 					modId = insert into Budget_Modification
                 					[
                 						Added_User=zoho.loginuser
                 						Budget=budget.ID
                 						Budget_Item=item.ID
                 						Budget_Category=item.Budget_Category
                 						Modification_Type="Increase"
                 						Amount=plan.get("amount").toDecimal()
                 						Reason="Purchase Order " + idText + " exceeds available item budget."
                 						Reference_Number=reference
                 						Effective_Date=zoho.currentdate
                 						Approval_Track=track
                 						Status="Submitted"
                 					];
                 				}
                 				mod = Budget_Modification[ID == modId];
                 				mod.Amount=plan.get("amount").toDecimal();
                 				mod.Status="Submitted";
                 				mod.Reference_Number=reference;
                 				if(mod.Budget != budget.ID || mod.Budget_Item != item.ID || thisapp.poCurrencyString(mod.Amount.toString()) != plan.get("amount") || mod.Reference_Number != reference)
                 				{
                 					operation.Status="Unknown";
                 					result.put("writeState","unknown");
                 					result.put("error","An automatic budget modification could not be verified. Do not resubmit.");
                 					return result.toString();
                 				}
                 				if(linkedModificationId == null)
                 				{
                 					linkedModificationId = mod.ID;
                 				}
                 				modifications.add({"id":mod.ID.toString(),"budgetItemId":item.ID.toString(),"amount":plan.get("amount"),"reference":reference});
                 			}
                 			po.PO_Budget_Modification=linkedModificationId;
                 			context.put("recordId",idText);
                 			context.put("submissionRevision",token);
                 			context.put("modifications",modifications);
                 			captured = thisapp.snapshotApprovalRoute(context);
                 			if(captured.get("success") != true)
                 			{
                 				operation.Status="Unknown";
                 				result.put("writeState","unknown");
                 				result.put("error",captured.get("error"));
                 				return result.toString();
                 			}
                 			route = captured.get("snapshot").get("route");
                 			executionIds = List();
                 			position = 0;
                 			for each  step in route
                 			{
                 				position = position + 1;
                 				executionId = 0;
                 				if(wasReserved)
                 				{
                 					for each  previousRow in priorBundle.get("rows")
                 					{
                 						if(previousRow.get("userAccessId") == step.get("userAccessId") && previousRow.get("role") == step.get("role"))
                 						{
                 							executionId = previousRow.get("id").toLong();
                 						}
                 					}
                 				}
                 				if(executionId == 0)
                 				{
                 					executionId = insert into Budget_Approvals
                 					[
                 						Added_User=zoho.loginuser
                 						Budget=budget.ID
                 						Type1="Purchase Order"
                 						Sort_Order=position
                 						Title=step.get("role")
                 						Approver=step.get("email")
                 						Status="Not Sent"
                 					];
                 				}
                 				execution = Budget_Approvals[ID == executionId];
                 				execution.Status="Not Sent";
                 				execution.Sent_Date=null;
                 				execution.Responded_Date=null;
                 				execution.Approver=step.get("email");
                 				execution.Title=step.get("role");
                 				execution.Sort_Order=position;
                 				executionIds.add(executionId.toString());
                 			}
                 			storedRoute = Approval_Route_Snapshot[ID == captured.get("snapshotId").toLong()];
                 			storedRoute.Execution_JSON=executionIds.toString();
                 			first = Budget_Approvals[ID == executionIds.get(0).toLong()];
                 			first.Status="Pending";
                 			po.PO_Approval_State="Pending";
                 			mail = thisapp.sendPurchaseOrderEmail(idText);
                 		}
                 		actual = thisapp.poSnapshot(idText);
                 		if(actual.get("success") != true)
                 		{
                 			result.put("error",actual.get("error"));
                 		}
                 		else
                 		{
                 			saved = actual.get("snapshot");
                 			wantedStatus = "Draft";
                 			wantedCommitment = "None";
                 			wantedApproval = "Not Configured";
                 			if(wasReserved)
                 			{
                 				wantedStatus = "Submitted";
                 				wantedCommitment = "Reserved";
                 				wantedApproval = "Rejected";
                 			}
                 			if(action == "Submit")
                 			{
                 				wantedStatus = "Submitted";
                 				wantedCommitment = "Reserved";
                 				wantedApproval = "Pending";
                 			}
                 			if(saved.get("status") != wantedStatus || saved.get("commitmentState") != wantedCommitment || saved.get("approvalState") != wantedApproval)
                 			{
                 				result.put("error","Submission, commitment or approval state differs from the intended write.");
                 			}
                 			if(saved.get("budgetId") != budgetId || saved.get("vendorId") != p.get("vendorId") || saved.get("amount") != p.get("amount") || saved.get("requestDate") != p.get("requestDate") || saved.get("dateNeeded") != p.get("dateNeeded") || saved.get("revision") != token || saved.get("lines").size() != p.get("lines").size())
                 			{
                 				result.put("error","Header readback differs from the intended write.");
                 			}
                 			if(saved.get("budgetModificationId") != if(linkedModificationId == null,null,linkedModificationId.toString()))
                 			{
                 				result.put("error","Linked budget modification readback differs from the intended write.");
                 			}
                 			index = 0;
                 			for each  line in p.get("lines")
                 			{
                 				written = saved.get("lines").get(index);
                 				index = index + 1;
                 				for each  field in {"key","budgetItemId","description","costElement","uom","costCode","pricingMode","quantity","unitPrice","finalAmount"}
                 				{
                 					if(written.get(field) != line.get(field))
                 					{
                 						result.put("error","Line readback differs from the intended write: " + field);
                 					}
                 				}
                 			}
                 			if(result.get("error") == null)
                 			{
                 				proof = {"format":"sha256-v1","digest":zoho.encryption.sha256(saved.toString())};
                 				operation.Snapshot_JSON=proof.toString();
                 				if(operation.Snapshot_JSON != proof.toString())
                 				{
                 					result.put("writeState","unknown");
                 					result.put("error","PO verification receipt could not be persisted.");
                 					return result.toString();
                 				}
                 				operation.Status="Complete";
                 				delete from PO_Phase_Lock[ID == lockId];
                 				result.put("success",true);
                 				result.put("writeState","verified");
                 				result.put("snapshot",saved);
                 				return result.toString();
                 			}
                 		}
                 		operation.Status="Unknown";
                 		operation.Error_Text=result.get("error");
                 		result.put("writeState","unknown");
                 	}	catch (e)
                 	{
                 		if(writeStarted == true || operationId != 0)
                 		{
                 			result.put("writeState","unknown");
                 			result.put("error","The operation could not be verified. Keep the phase lock and use read-only Check.");
                 		}
                 		else
                 		{
                 			result.put("error","This phase is busy, or validation failed. No PO write was started.");
                 		}
                 		// A lock acquired before receipt creation can also be unresolved: never auto-take-over.
                 		if(lockId != 0)
                 		{
                 			result.put("writeState","unknown");
                 		}
                 	}
                 	return result.toString();
                 }
				 map Manage_Proforma_Approval_Config(string proformaId, string configAction, string approvalId, string title, string approverEmail, string orderedIds)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		actionText = ifnull(configAction,"").toString().trim().toLowerCase();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		titleText = ifnull(title,"").toString().trim();
                 		emailText = ifnull(approverEmail,"").toString().trim();
                 		orderedIdsText = ifnull(orderedIds,"").toString().trim();
                 		if(proformaIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID is required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma not found.");
                 			return response;
                 		}
                 		// Approval-route configuration uses the same owner scope as the widget.
                 		configAccess = User_Access[User == zoho.loginuser];
                 		canConfigureRoute = false;
                 		if(configAccess.count() > 0)
                 		{
                 			canConfigureRoute = configAccess.Edit_All_Pro_Forma_Approvals == true;
                 			if(!canConfigureRoute && configAccess.Edit_Owned_Proformas == true && pf.Owner != null)
                 			{
                 				for each  configOwner in pf.Owner
                 				{
                 					if(configOwner.ID.toString() == configAccess.ID.toString())
                 					{
                 						canConfigureRoute = true;
                 					}
                 				}
                 			}
                 		}
                 		if(!canConfigureRoute)
                 		{
                 			response.put("success",false);
                 			response.put("message","Edit All Pro Forma Approvals, or Edit Owned Pro Formas on a Pro Forma you own, is required to configure the route.");
                 			return response;
                 		}
                 		rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		// The route is configuration data only until the chain starts.
                 		// Once any row has moved beyond Not Sent, cancel the flow before editing it.
                 		for each  approvalRow in rows
                 		{
                 			rowStatus = ifnull(approvalRow.Status,"Not Sent").toString().trim();
                 			if(rowStatus != "" && rowStatus != "Not Sent")
                 			{
                 				response.put("success",false);
                 				response.put("message","Cancel the active approval flow before adding, removing, renaming, or reordering approval steps.");
                 				return response;
                 			}
                 		}
                 		if(actionText == "add")
                 		{
                 			// Keep the route readable in the widget, email, public page and PDF packet.
                 			if(rows.count() >= 8)
                 			{
                 				response.put("success",false);
                 				response.put("message","A Pro Forma approval route can contain up to 8 steps.");
                 				return response;
                 			}
                 			nextOrder = rows.count() + 1;
                 			if(titleText == "")
                 			{
                 				titleText = "Approver " + nextOrder.toString();
                 			}
                 			newApprovalId = insert into Budget_Approvals
                 			[
                 				Added_User=zoho.loginuser
                 				Proforma=proformaIdLong
                 				Title=titleText
                 				Approver=emailText
                 				Sort_Order=nextOrder
                 				Status="Not Sent"
                 				Type1="Pro Forma"
                 			];
                 			response.put("success",true);
                 			response.put("message","Approval step added.");
                 			response.put("approvalId",newApprovalId.toString());
                 			response.put("sortOrder",nextOrder);
                 			return response;
                 		}
                 		if(actionText == "update")
                 		{
                 			if(approvalIdText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval ID is required for update.");
                 				return response;
                 			}
                 			if(titleText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Each approval step needs a name.");
                 				return response;
                 			}
                 			row = Budget_Approvals[ID == approvalIdText.toLong() && Proforma == proformaIdLong];
                 			if(row.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval row not found for this Pro Forma.");
                 				return response;
                 			}
                 			row.Title=titleText;
                 			row.Approver=emailText;
                 			response.put("success",true);
                 			response.put("message","Approval step updated.");
                 			return response;
                 		}
                 		if(actionText == "delete")
                 		{
                 			if(approvalIdText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval ID is required for delete.");
                 				return response;
                 			}
                 			if(rows.count() <= 1)
                 			{
                 				response.put("success",false);
                 				response.put("message","An approval route must contain at least one step.");
                 				return response;
                 			}
                 			row = Budget_Approvals[ID == approvalIdText.toLong() && Proforma == proformaIdLong];
                 			if(row.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval row not found for this Pro Forma.");
                 				return response;
                 			}
                 			delete from Budget_Approvals[ID == row.ID];
                 			// Re-number the remaining rows so the routing functions can continue
                 			// using Sort_Order + 1 and Sort_Order - 1 without gaps.
                 			remainingRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			nextOrder = 1;
                 			for each  remainingRow in remainingRows
                 			{
                 				remainingRow.Sort_Order=nextOrder;
                 				nextOrder = nextOrder + 1;
                 			}
                 			response.put("success",true);
                 			response.put("message","Approval step removed.");
                 			return response;
                 		}
                 		if(actionText == "reorder")
                 		{
                 			if(orderedIdsText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","The reordered approval ID list is required.");
                 				return response;
                 			}
                 			orderedIdList = orderedIdsText.toList(",");
                 			if(orderedIdList.size() != rows.count())
                 			{
                 				response.put("success",false);
                 				response.put("message","The reordered list does not contain every approval step.");
                 				return response;
                 			}
                 			seenIds = Map();
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedIdText = orderedIdValue.toString().trim();
                 				if(orderedIdText == "" || seenIds.get(orderedIdText) != null)
                 				{
                 					response.put("success",false);
                 					response.put("message","The reordered list contains an invalid or duplicate approval ID.");
                 					return response;
                 				}
                 				orderedRow = Budget_Approvals[ID == orderedIdText.toLong() && Proforma == proformaIdLong];
                 				if(orderedRow.ID == null)
                 				{
                 					response.put("success",false);
                 					response.put("message","The reordered list contains an approval that is not attached to this Pro Forma.");
                 					return response;
                 				}
                 				seenIds.put(orderedIdText,true);
                 			}
                 			// Temporary values avoid conflicting with any existing Sort_Order validation.
                 			tempOrder = 1001;
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedRow = Budget_Approvals[ID == orderedIdValue.toString().trim().toLong()];
                 				orderedRow.Sort_Order=tempOrder;
                 				tempOrder = tempOrder + 1;
                 			}
                 			finalOrder = 1;
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedRow = Budget_Approvals[ID == orderedIdValue.toString().trim().toLong()];
                 				orderedRow.Sort_Order=finalOrder;
                 				finalOrder = finalOrder + 1;
                 			}
                 			response.put("success",true);
                 			response.put("message","Approval order saved.");
                 			return response;
                 		}
                 		response.put("success",false);
                 		response.put("message","Unsupported approval configuration action: " + actionText);
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
