                 		if(sellerRec != null && ifnull(sellerRec.Email,"").trim() != "")
                 		{
                 			rSellerEmail = sellerRec.Email.trim();
                 		}
                 		rSellerPhone = "";
                 		if(sellerRec != null && ifnull(sellerRec.Phone_Number,"").trim() != "")
                 		{
                 			rSellerPhone = sellerRec.Phone_Number.trim();
                 		}
                 		rStreet = "";
                 		if(sellerRec != null && ifnull(sellerRec.Street_Address,"").trim() != "")
                 		{
                 			rStreet = sellerRec.Street_Address.trim();
                 		}
                 		else if(sellerRec != null && ifnull(sellerRec.Address,"").trim() != "")
                 		{
                 			rStreet = sellerRec.Address.trim();
                 		}
                 		rSellerCityZip = "";
                 		if(sellerRec != null && ifnull(sellerRec.City_State_ZIP,"").trim() != "")
