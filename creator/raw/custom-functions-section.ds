                 		viewTotalLotRevenue = row.View_Total_Lot_Revenue == true;
                 		// Pro Forma permissions
                 		pfEditAll = row.Edit_All_Proformas == true;
                 		pfEditOwned = row.Edit_Owned_Proformas == true;
                 		pfEditCurve = row.Edit_Construction_Curve == true;
                 		pfVpCompTab = row.VP_Compensation_Tab == true;
                 		pfEditProbability = row.Edit_Probability == true;
                 		pfEditOwner = row.Edit_Proforma_Owner == true;
                 		pfDeleteArchive = row.Delete_Archive_Pro_Formas == true;
                 		pfApprAll = row.Edit_All_Pro_Forma_Approvals == true;
                 		pfApprOwned = row.Edit_Owned_Pro_Forma_Approvals == true;
                 		pfSendApprovals = row.Send_Pro_Formas_for_Approvals == true;
                 		pfSendCostsToBudgets = row.Send_Costs_to_Budgets == true;
                 		pfSubmitLegal = row.Submit_to_Legal_Module == true;
                 		pfAiReview = row.AI_Review == true;
                 		budgetAssignedToMe = row.Budgets_Assigned_to_Me == true;
                 		proformaAssignedToMe = row.Pro_Forma_Assigned_to_Me == true;
                 		legalAssignedToMe = row.Legal_Assigned_to_Me == true;
                 		// Contract permissions
                 		ctEdit = row.Edit_Contracts == true;
                 		ctPropose = row.Propose_Contract_Changes == true;
                 		ctApprove = row.Approve_Contracts == true;
                 		ctTemplates = row.Manage_Action_Templates == true;
                 		ctDeleteArchive = row.Delete_Archive_Contracts == true;
                 		break;
                 	}
                 	// Roster: each user as {id, label, email}.
                 	userList = List();
                 	allRows = User_Access[ID != null];
                 	for each  r in allRows
                 	{
                 		m = Map();
                 		m.put("id",r.ID.toString());
                 		m.put("label",r.User.toString());
                 		m.put("email",r.User.toString());
                 		m.put("userName",r.User.toString());
                 		m.put("approverEmail",ifnull(r.Approver_Email,"").toString().trim());
                 		m.put("fullName",ifnull(r.Full_Name,"").toString().trim());
                 		userList.add(m);
                 	}
                 	// Return authoritative Pro Forma Owner IDs server-side.
                 	proformaOwnerMap = Map();
                 	allProformas = Add_Pro_Forma[ID != null];
                 	for each  pfRec in allProformas
                 	{
                 		ownerIds = List();
                 		if(pfRec.Owner != null)
                 		{
                 			for each  ownerRow in pfRec.Owner
                 			{
                 				ownerIds.add(ownerRow.ID.toString());
                 			}
                 		}
                 		proformaOwnerMap.put(pfRec.ID.toString(),ownerIds);
                 	}
                 	result = Map();
                 	result.put("found",foundRow);
                 	result.put("hasRow",foundRow);
                 	result.put("myId",myId);
                 	// Budget permissions
                 	result.put("editAll",editAll);
                 	result.put("editOwned",editOwned);
                 	result.put("apprAll",apprAll);
                 	result.put("apprOwned",apprOwned);
                 	result.put("send",sendAppr);
                 	result.put("editOwners",editOwners);
                 	result.put("viewImports",viewImports);
                 	result.put("editImports",editImports);
                 	result.put("modAdmin",modAdmin);
                 	result.put("budgetDeleteArchive",budgetDeleteArchive);
                 	// Data Insights permissions
                 	result.put("lotSalesDashboard",lotSalesDashboard);
                 	result.put("viewTotalLotRevenue",viewTotalLotRevenue);
                 	// Pro Forma permissions
                 	result.put("pfEditAll",pfEditAll);
                 	result.put("pfEditOwned",pfEditOwned);
                 	result.put("pfEditCurve",pfEditCurve);
                 	result.put("pfVpCompTab",pfVpCompTab);
                 	result.put("pfEditProbability",pfEditProbability);
                 	result.put("pfEditOwner",pfEditOwner);
                 	result.put("pfDeleteArchive",pfDeleteArchive);
                 	result.put("pfApprAll",pfApprAll);
                 	result.put("pfApprOwned",pfApprOwned);
                 	result.put("pfSendApprovals",pfSendApprovals);
                 	result.put("pfSendCostsToBudgets",pfSendCostsToBudgets);
                 	result.put("pfSubmitLegal",pfSubmitLegal);
                 	result.put("pfAiReview",pfAiReview);
                 	result.put("budgetAssignedToMe",budgetAssignedToMe);
                 	result.put("proformaAssignedToMe",proformaAssignedToMe);
                 	result.put("legalAssignedToMe",legalAssignedToMe);
                 	// Contract permissions
                 	result.put("ctEdit",ctEdit);
                 	result.put("ctPropose",ctPropose);
                 	result.put("ctApprove",ctApprove);
                 	result.put("ctTemplates",ctTemplates);
                 	result.put("ctDeleteArchive",ctDeleteArchive);
                 	result.put("users",userList);
                 	result.put("proformaOwners",proformaOwnerMap);
                 	return result.toString();
                 }
