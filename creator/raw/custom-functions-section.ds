                 		if(header.get("Owner") != null)
                 		{
                 			for each  ownerValue in header.get("Owner")
                 			{
                 				ownerIdText = ifnull(ownerValue,"").toString().trim();
                 				if(ownerIdText != "")
                 				{
                 					ownerIds.add(ownerIdText.toLong());
                 				}
                 			}
                 		}
                 		if(ownerIds.size() > 0)
                 		{
                 			pf.Owner=ownerIds;
                 		}
                 		else if(isNew)
                 		{
                 			creatorRow = User_Access[User == zoho.loginuser];
                 			if(creatorRow != null)
                 			{
                 				creatorOwners = List();
                 				creatorOwners.add(creatorRow.ID);
                 				pf.Owner=creatorOwners;
                 			}
                 		}
                 		if(header.get("Engineering_Start") != null && header.get("Engineering_Start").toString() != "")
                 		{
                 			pf.Engineering_Start=header.get("Engineering_Start").toString().toDate("MM/dd/yyyy");
                 		}
                 		if(header.get("Construction_Start") != null && header.get("Construction_Start").toString() != "")
                 		{
                 			pf.Construction_Start=header.get("Construction_Start").toString().toDate("MM/dd/yyyy");
