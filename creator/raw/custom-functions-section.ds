                 		}
                 		if(header.get("Seller_City_State_ZIP") != null)
                 		{
                 			pf.Seller_City_State_ZIP=header.get("Seller_City_State_ZIP");
                 		}
                 		if(header.get("Seller_Phone") != null)
                 		{
                 			pf.Seller_Phone=header.get("Seller_Phone");
                 		}
                 		if(header.get("Seller_Email") != null)
                 		{
                 			pf.Seller_Email=header.get("Seller_Email");
                 		}
                 		if(ifnull(header.get("Purchasing_Company"),"") != "")
                 		{
                 			pf.Purchasing_Company=header.get("Purchasing_Company").toString().toLong();
                 		}
                 		if(header.get("CAD_ID") != null)
                 		{
                 			pf.CAD_ID=header.get("CAD_ID");
                 		}
                 		if(header.get("Property_County") != null)
                 		{
                 			pf.Property_County=header.get("Property_County");
                 		}
                 		if(header.get("Property_City") != null)
                 		{
                 			pf.Property_City=header.get("Property_City");
                 		}
                 		if(header.get("Earnest_Money") != null && header.get("Earnest_Money").toString() != "")
                 		{
                 			pf.Earnest_Money=header.get("Earnest_Money").toDecimal();
                 		}
                 		if(header.get("Initial_Feasibility_Days") != null && header.get("Initial_Feasibility_Days").toString() != "")
                 		{
                 			pf.Initial_Feasibility_Days=header.get("Initial_Feasibility_Days").toLong();
                 		}
                 		if(header.get("Extensions") != null && header.get("Extensions").toString() != "")
                 		{
                 			pf.Extensions=header.get("Extensions").toLong();
                 		}
                 		if(header.get("Days_per_Extension") != null && header.get("Days_per_Extension").toString() != "")
                 		{
                 			pf.Days_per_Extension=header.get("Days_per_Extension").toLong();
                 		}
                 		if(header.get("Amount_per_Extension") != null && header.get("Amount_per_Extension").toString() != "")
                 		{
                 			pf.Amount_per_Extension=header.get("Amount_per_Extension").toDecimal();
                 		}
                 		if(header.get("Closing_Days_Feas") != null && header.get("Closing_Days_Feas").toString() != "")
                 		{
                 			pf.Closing_Days_Feas=header.get("Closing_Days_Feas").toLong();
                 		}
                 		if(header.get("Broker_Buyer") != null)
                 		{
                 			pf.Broker_Buyer=header.get("Broker_Buyer");
                 		}
                 		if(header.get("Broker_Seller") != null)
                 		{
                 			pf.Broker_Seller=header.get("Broker_Seller");
                 		}
                 		if(header.get("Response_Date") != null && header.get("Response_Date").toString() != "")
                 		{
                 			pf.Response_Date=header.get("Response_Date").toString().toDate("MM/dd/yyyy");
                 		}
                 		if(header.get("Acquisition_Email") != null)
                 		{
                 			pf.Acquisition_Email=header.get("Acquisition_Email");
                 		}
                 		if(header.get("Special_Provisions") != null)
                 		{
                 			pf.Special_Provisions=header.get("Special_Provisions");
                 		}
                 		resp.put("success",true);
                 		resp.put("id",pfKey.toString());
                 		pcCheck = Add_Pro_Forma[ID == pfKey];
                 		resp.put("purchasingCompany",ifnull(pcCheck.Purchasing_Company,"").toString());
                 		if(isNew)
                 		{
                 			resp.put("action","created");
                 		}
                 		else
                 		{
                 			resp.put("action","updated");
                 		}
                 	}	catch (e)
                 	{
                 		resp.put("success",false);
                 		resp.put("error",e.toString());
                 		resp.put("debug_id",ifnull(pfId,"<null>"));
                 		resp.put("debug_isNew",ifnull(isNew,"<null>").toString());
                 		resp.put("debug_hasHeader",(header != null).toString());
                 		resp.put("debug_deleteStage",ifnull(deleteStage,"").toString());
                 	}
                 	return resp.toString();
                 }
				 string reportProformaWidgetError(string payload)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(payload == null || payload.toString().trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("error","No error-report payload was supplied.");
                 			return result.toString();
                 		}
                 		data = payload.toString().toMap();
                 		reportId = ifnull(data.get("reportId"),"").toString().trim();
                 		subjectText = ifnull(data.get("subject"),"[Pro Forma Widget Error]").toString().trim();
                 		bodyText = ifnull(data.get("body"),"").toString();
                 		if(subjectText == "")
                 		{
                 			subjectText = "[Pro Forma Widget Error]";
                 		}
                 		if(bodyText == "")
                 		{
                 			bodyText = "The widget submitted an empty error body.\n\nRaw payload:\n" + payload.toString();
                 		}
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :"rbelliveau@wbdevelopment.com"
                 			subject :subjectText
                 			message :bodyText
                 		]
                 		result.put("success",true);
                 		result.put("reportId",reportId);
                 		result.put("recipient","rbelliveau@wbdevelopment.com");
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("error",e.toString());
                 	}
                 	return result.toString();
                 }
				 string Review_LOI_Request(string proformaId, string tokenId, string decision, string legalNote)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		if(ifnull(pf.LOI_Legal_Status,"") != "Pending Approval")
                 		{
                 			result.put("success",false);
                 			result.put("message","This LOI is no longer pending Legal approval.");
                 			result.put("status",ifnull(pf.LOI_Legal_Status,""));
                 			return result.toString();
                 		}
                 		if(tokenId == null || tokenId.trim() == "" || ifnull(pf.LOI_Approval_Token,"") != tokenId.trim())
                 		{
                 			result.put("success",false);
                 			result.put("message","The LOI approval token is invalid or expired.");
                 			return result.toString();
                 		}
                 		decisionValue = ifnull(decision,"").trim().toUpperCase();
                 		noteValue = ifnull(legalNote,"").trim();
                 		if(decisionValue == "REJECT")
                 		{
                 			if(noteValue == "")
                 			{
                 				result.put("success",false);
                 				result.put("message","Enter a Legal note before rejecting the LOI.");
                 				return result.toString();
                 			}
                 			pf.LOI_Legal_Status="Rejected";
                 			pf.LOI_Legal_Note=noteValue;
                 			pf.LOI_Approval_Token="";
                 			if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 			{
                 				sendmail
                 				[
                 					from :zoho.adminuserid
                 					to :pf.Acquisition_Email
                 					subject :"LOI Rejected by Legal - " + ifnull(pf.Name,"Pro Forma")
                 					message :"Legal rejected the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b>.<br><br><b>Legal note:</b><br>" + noteValue
                 				]
                 			}
                 			result.put("success",true);
                 			result.put("decision","REJECT");
                 			result.put("message","LOI rejected and returned to the Pro Forma.");
                 			result.put("proformaId",pf.ID.toString());
                 			return result.toString();
                 		}
                 		if(decisionValue != "APPROVE")
                 		{
                 			result.put("success",false);
                 			result.put("message","Decision must be APPROVE or REJECT.");
                 			return result.toString();
                 		}
                 		// Call the existing function that generates the Writer document,
                 		// creates/reuses the Acquisition Contract, and attaches Contract_Version.
                 		contractResultText = thisapp.Create_LOI_Contract(proformaId);
                 		contractResult = contractResultText.toMap();
                 		contractSuccess = contractResult.get("success");
                 		if(contractSuccess != true && contractSuccess.toString() != "true")
                 		{
                 			result.put("success",false);
                 			result.put("message",ifnull(contractResult.get("message"),"Create_LOI_Contract did not complete successfully."));
                 			result.put("contractResult",contractResult);
                 			return result.toString();
                 		}
                 		contractIdText = contractResult.get("contractId").toString();
                 		pf.LOI_Legal_Status="Approved";
                 		pf.LOI_Legal_Note=noteValue;
                 		pf.LOI_Approval_Token="";
                 		pf.LOI_Contract=contractIdText.toLong();
                 		if(pf.Acquisition_Email != null && pf.Acquisition_Email.trim() != "")
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :pf.Acquisition_Email
                 				subject :"LOI Approved by Legal - " + ifnull(pf.Name,"Pro Forma")
                 				message :"Legal approved the LOI for <b>" + ifnull(pf.Name,"Pro Forma") + "</b> and Contract <b>" + contractIdText + "</b> was created.<br><br><b>Legal note:</b><br>" + if(noteValue == "","No note entered.",noteValue)
                 			]
                 		}
                 		result.put("success",true);
                 		result.put("decision","APPROVE");
                 		result.put("message","LOI approved and Contract created.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("contractId",contractIdText);
                 		result.put("contractVersionId",contractResult.get("contractVersionId"));
                 		result.put("contractUrl",contractResult.get("contractUrl"));
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI review failed at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		return result.toString();
                 	}
                 	return "nice";
                 }
				 string sendApprovalEmail(int budgetId, int approvalId)
                 {
                 	/********* SEND ONE APPROVAL EMAIL *********/
                 	// Return Type: string
                 	// Sends the approval email for one specific Budget_Approvals row.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalId = approvalId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalId == 0)
                 	{
                 		return "No Approval ID provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	approvalRows = Budget_Approvals[ID == vApprovalId];
                 	if(approvalRows.count() == 0)
                 	{
                 		return "Approval row not found.";
                 	}
                 	approvalRec = null;
                 	for each  ar in approvalRows
                 	{
                 		approvalRec = ar;
                 	}
                 	approverEmail = ifnull(approvalRec.Approver,"").trim();
                 	approvalRole = ifnull(approvalRec.Title,"").trim();
                 	approvalType = ifnull(approvalRec.Type1,"").trim();
                 	approvalSortOrder = ifnull(approvalRec.Sort_Order,0).toLong();
                 	if(approverEmail == "")
                 	{
                 		return "No approver email found for " + approvalType + " " + approvalRole + ".";
                 	}
                 	if(approvalRole == "")
                 	{
                 		return "No approval role found.";
                 	}
                 	if(approvalType == "")
                 	{
                 		return "No approval type found.";
                 	}
                 	// ============================================================
                 	// FIND THE APPROVAL NOTES THAT SHOULD APPEAR IN THIS EMAIL
                 	//
                 	// Forward approval:
                 	//     Pull notes from the immediately previous approved row.
                 	//
                 	// Rejection:
                 	//     Pull notes from the immediately next rejected row.
                 	// ============================================================
                 	previousApprovalRec = null;
                 	nextApprovalRec = null;
                 	previousSortOrder = -1;
                 	nextSortOrder = 999999;
                 	trackApprovalRows = Budget_Approvals[Budget == vBudgetId && Type1 == approvalType];
                 	for each  trackRow in trackApprovalRows
                 	{
                 		trackSortOrder = ifnull(trackRow.Sort_Order,0).toLong();
                 		if(trackSortOrder < approvalSortOrder && trackSortOrder > previousSortOrder)
                 		{
                 			previousApprovalRec = trackRow;
                 			previousSortOrder = trackSortOrder;
                 		}
                 		if(trackSortOrder > approvalSortOrder && trackSortOrder < nextSortOrder)
                 		{
                 			nextApprovalRec = trackRow;
                 			nextSortOrder = trackSortOrder;
                 		}
                 	}
                 	approvalNotes = "";
                 	notesSourceRole = "";
                 	notesHeading = "Approval Notes";
                 	notesContext = "";
                 	// Check rejection first because the email is being routed backward.
                 	if(nextApprovalRec != null && ifnull(nextApprovalRec.Status,"").trim() == "Rejected")
                 	{
                 		approvalNotes = ifnull(nextApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(nextApprovalRec.Title,"").trim();
                 		notesHeading = "Rejection Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the rejecting approver";
                 		}
                 	}
                 	else if(previousApprovalRec != null && ifnull(previousApprovalRec.Status,"").trim() == "Approved")
                 	{
                 		approvalNotes = ifnull(previousApprovalRec.Approval_Notes,"").trim();
                 		notesSourceRole = ifnull(previousApprovalRec.Title,"").trim();
                 		notesHeading = "Approval Notes";
                 		if(notesSourceRole != "")
                 		{
                 			notesContext = "From " + notesSourceRole;
                 		}
                 		else
                 		{
                 			notesContext = "From the previous approver";
                 		}
                 	}
                 	else
                 	{
                 		notesContext = "No previous approval response";
                 	}
                 	if(approvalNotes == "")
                 	{
                 		approvalNotes = "No notes were provided.";
                 	}
                 	// Basic HTML escaping for approval notes.
                 	approvalNotesSafe = approvalNotes;
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("&","&amp;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("<","&lt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll(">","&gt;");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\r\n","<br>");
                 	approvalNotesSafe = approvalNotesSafe.replaceAll("\n","<br>");
                 	notesHeadingSafe = notesHeading;
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("&","&amp;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll("<","&lt;");
                 	notesHeadingSafe = notesHeadingSafe.replaceAll(">","&gt;");
                 	notesContextSafe = notesContext;
                 	notesContextSafe = notesContextSafe.replaceAll("&","&amp;");
                 	notesContextSafe = notesContextSafe.replaceAll("<","&lt;");
                 	notesContextSafe = notesContextSafe.replaceAll(">","&gt;");
                 	// Internal app URL for the Budget Management page hosting the widget.
                 	widgetPageUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Budget_Management1";
                 	// Verified sender for all approval emails.
                 	fromAddress = "jking@wbdevelopment.com";
                 	// Build budget display info.
                 	budgetName = ifnull(budgetRec.Budget_Name,"Budget Review");
                 	projectName = ifnull(budgetRec.Project,"");
                 	phaseName = ifnull(budgetRec.Phase,"");
                 	subdivisionCode = ifnull(budgetRec.Subdivision_Code,"");
                 	subdivisionName = "";
                 	territoryText = "";
                 	if(budgetRec.Subdivision1 != null)
                 	{
                 		subdivisionName = ifnull(budgetRec.Subdivision1.Subdivision_Name,"");
                 		territoryText = ifnull(budgetRec.Subdivision1.Territory,"");
                 	}
                 	budgetLabel = budgetName;
                 	if(projectName != "" && phaseName != "")
                 	{
                 		budgetLabel = projectName + " - " + phaseName + " - " + budgetName;
                 	}
                 	else if(projectName != "")
                 	{
                 		budgetLabel = projectName + " - " + budgetName;
                 	}
                 	if(subdivisionName != "")
                 	{
                 		budgetLabel = subdivisionName + " - " + budgetName;
                 	}
                 	// Basic HTML escaping.
                 	budgetLabelSafe = budgetLabel;
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("&","&amp;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll("<","&lt;");
                 	budgetLabelSafe = budgetLabelSafe.replaceAll(">","&gt;");
                 	subdivisionCodeSafe = subdivisionCode;
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("&","&amp;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("<","&lt;");
                 	subdivisionCodeSafe = subdivisionCodeSafe.replaceAll(">","&gt;");
                 	territorySafe = territoryText;
                 	territorySafe = territorySafe.replaceAll("&","&amp;");
                 	territorySafe = territorySafe.replaceAll("<","&lt;");
                 	territorySafe = territorySafe.replaceAll(">","&gt;");
                 	// Deep link to the widget page, opening directly to this budget.
                 	approvalUrl = widgetPageUrl + "?budgetId=" + vBudgetId;
                 	emailSubject = approvalType + " Budget Approval Needed - " + budgetLabel;
                 	emailBody = "";
                 	emailBody = emailBody + "<div style='font-family:Arial,sans-serif;color:#0f172a;line-height:1.5;'>";
                 	emailBody = emailBody + "<h2 style='margin:0 0 8px 0;color:#0f2744;'>Budget Approval Needed</h2>";
                 	emailBody = emailBody + "<p style='margin:0 0 16px 0;'>A <b>" + approvalType + "</b> budget approval is ready for your review as <b>" + approvalRole + "</b>.</p>";
                 	// Budget information card.
                 	emailBody = emailBody + "<div style='background:#f8fafc;border:1px solid #dbe4f0;border-radius:10px;padding:14px 16px;margin:0 0 14px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;color:#64748b;margin-bottom:4px;'>Budget</div>";
                 	emailBody = emailBody + "<div style='font-size:16px;font-weight:700;color:#0f2744;'>" + budgetLabelSafe + "</div>";
                 	if(subdivisionCodeSafe != "" || territorySafe != "")
                 	{
                 		emailBody = emailBody + "<div style='margin-top:10px;font-size:13px;color:#475569;'>";
                 		if(subdivisionCodeSafe != "")
                 		{
                 			emailBody = emailBody + "<b>Subdivision Code:</b> " + subdivisionCodeSafe;
                 		}
                 		if(subdivisionCodeSafe != "" && territorySafe != "")
                 		{
                 			emailBody = emailBody + " &nbsp; | &nbsp; ";
                 		}
                 		if(territorySafe != "")
                 		{
                 			emailBody = emailBody + "<b>Territory:</b> " + territorySafe;
                 		}
                 		emailBody = emailBody + "</div>";
                 	}
                 	emailBody = emailBody + "</div>";
                 	// Approval or rejection notes card.
                 	emailBody = emailBody + "<div style='background:#fffdf5;border:1px solid #e7d9a8;border-left:4px solid #c79a22;border-radius:10px;padding:14px 16px;margin:0 0 18px 0;'>";
                 	emailBody = emailBody + "<div style='font-size:13px;font-weight:700;color:#785b12;margin-bottom:2px;'>" + notesHeadingSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:12px;color:#8a6d22;margin-bottom:8px;'>" + notesContextSafe + "</div>";
                 	emailBody = emailBody + "<div style='font-size:14px;color:#334155;white-space:normal;'>" + approvalNotesSafe + "</div>";
                 	emailBody = emailBody + "</div>";
                 	emailBody = emailBody + "<a href='" + approvalUrl + "' style='display:inline-block;background:#1e40af;color:#ffffff;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;'>Open Approval Page</a>";
                 	emailBody = emailBody + "<p style='margin:18px 0 0 0;font-size:12px;color:#64748b;'>If the button does not work, copy and paste this link into your browser:<br>";
                 	emailBody = emailBody + "<span style='word-break:break-all;color:#1e40af;'>" + approvalUrl + "</span></p>";
                 	emailBody = emailBody + "</div>";
                 	sendmail
                 	[
                 		from :fromAddress
                 		to :approverEmail
                 		subject :emailSubject
                 		message :emailBody
                 	]
                 	// Mark sent date after successful send.
                 	approvalRec.Sent_Date=zoho.currentdate;
                 	return "Email sent to " + approverEmail + " for " + approvalType + " " + approvalRole + ".";
                 }
				 map Send_Proforma_Approval_Email(string proformaId, string approvalId)
                 {
                 	return thisapp.Send_Proforma_Approval_Email_With_Context(proformaId,approvalId,"Resent","","System");
                 }
				 map Send_Proforma_Approval_Email_With_Context(string proformaId, string approvalId, string routingAction, string routingNote, string routingRole)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		approvalRow = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null || approvalRow.ID == null || approvalRow.Proforma == null || approvalRow.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma or approval row not found.");
                 			return response;
                 		}
                 		toAddress = ifnull(approvalRow.Approver,"").toString().trim();
                 		if(toAddress == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","No email address is assigned to the " + ifnull(approvalRow.Title,"current").toString() + " approval.");
                 			return response;
                 		}
                 		// Build the complete Deluge-generated PDF packet.
                 		packet = thisapp.PF_Build_Proforma_Approval_PDF(proformaIdText,approvalIdText);
                 		if(ifnull(packet.get("success"),false) != true)
                 		{
                 			response.put("success",false);
                 			response.put("message",ifnull(packet.get("message"),"The approval PDF packet could not be generated.").toString());
                 			return response;
                 		}
                 		pdfText = ifnull(packet.get("pdfText"),"").toString();
                 		packetFileName = ifnull(packet.get("fileName"),"Proforma_Approval_Packet.pdf").toString();
                 		if(pdfText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","The approval PDF packet was generated without file content.");
                 			return response;
                 		}
                 		pdfFile = pdfText.toFile(packetFileName);
                 		publicApprovalPageUrl = "https://creatorapp.zohopublic.com/wbdevelopment/land-master/page-perma/Proforma_Approval_Response/SKynkNA9rksmmQtUQYmxGddr0T8zzRkPET48ymuwzpZjjzGeygeb6pQTxqKZT4HwjrSWq1pFZCry2qsyeFZbpZ9v1RA1AUFrQYAE";
                 		approveUrl = publicApprovalPageUrl + "?approvalId=" + approvalRow.ID.toString() + "&action1=Approve";
                 		denyUrl = publicApprovalPageUrl + "?approvalId=" + approvalRow.ID.toString() + "&action1=Deny";
                 		reviewUrl = "https://creatorapp.zoho.com/wbdevelopment/land-master/#Page:Proforma_Manager?proformaId=" + proformaIdText;
                 		pfName = ifnull(pf.Name,"Pro Forma #" + proformaIdText).toString();
                 		territoryText = ifnull(pf.Territory,"—").toString();
                 		stageText = ifnull(pf.Probability,"—").toString();
                 		statusText = ifnull(pf.Status,"Draft").toString();
                 		currentStepText = ifnull(approvalRow.Title,"Approver").toString();
                 		purchaseDateText = "—";
                 		completionDateText = "—";
                 		if(pf.Estimated_Purchase_Date != null)
                 		{
                 			purchaseDateText = pf.Estimated_Purchase_Date.toString("MMM, yyyy");
                 		}
                 		if(pf.Estimated_Completion != null)
                 		{
                 			completionDateText = pf.Estimated_Completion.toString("MMM, yyyy");
                 		}
                 		roiText = "—";
                 		if(pf.ROI1 != null && pf.ROI1.toString().trim() != "")
                 		{
                 			roiText = thisapp.PF_Packet_Number(pf.ROI1.toString(),2) + "%";
                 		}
                 		netProfitText = thisapp.PF_Packet_Money(ifnull(pf.Net_Profit,0).toString());
                 		// Read LOI terms from the saved LOI_Worksheet, Builder and Property records.
                 		loiContext = thisapp.PF_Get_Proforma_LOI_Snapshot(proformaIdText);
                 		if(ifnull(loiContext.get("success"),false) != true)
                 		{
                 			response.put("success",false);
                 			response.put("message",ifnull(loiContext.get("message"),"The saved LOI information could not be loaded.").toString());
                 			return response;
                 		}
                 		sellerText = ifnull(loiContext.get("seller"),"—").toString();
                 		buyingEntityText = ifnull(loiContext.get("buyingEntity"),"—").toString();
                 		propertyText = ifnull(loiContext.get("property"),"—").toString();
                 		acresText = ifnull(loiContext.get("totalAcres"),"—").toString();
                 		pricePerAcreText = ifnull(loiContext.get("amountPerAcre"),"—").toString();
                 		estimatedPurchasePriceText = ifnull(loiContext.get("estimatedPrice"),"—").toString();
                 		earnestMoneyText = ifnull(loiContext.get("earnestMoney"),"—").toString();
                 		feasibilityText = ifnull(loiContext.get("feasibility"),"—").toString();
                 		closingText = ifnull(loiContext.get("closing"),"—").toString();
                 		extensionsText = ifnull(loiContext.get("extensions"),"—").toString();
                 		responseDateText = ifnull(loiContext.get("responseDate"),"—").toString();
                 		effectiveDateText = ifnull(loiContext.get("effectiveDate"),"—").toString();
                 		specialProvisionsText = ifnull(loiContext.get("specialProvisions"),"").toString();
                 		routingActionText = ifnull(routingAction,"").toString();
                 		routingNoteText = ifnull(routingNote,"").toString();
                 		routingRoleText = ifnull(routingRole,"").toString();
                 		subjectPrefix = "Approval required";
                 		if(approvalRow.Title == "Legal")
                 		{
                 			subjectPrefix = "Legal LOI review required";
                 		}
                 		if(routingActionText == "Rejected")
                 		{
                 			subjectPrefix = "Pro Forma returned by " + routingRoleText;
                 		}
                 		subjectText = subjectPrefix + ": " + pfName;
                 		// Escape all user-entered or record text before inserting it into HTML.
                 		safePfName = pfName.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeTerritoryText = territoryText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeStageText = stageText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeStatusText = statusText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeCurrentStepText = currentStepText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSellerText = sellerText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeBuyingEntityText = buyingEntityText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safePropertyText = propertyText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeExtensionsText = extensionsText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeRoutingNote = routingNoteText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeRoutingRole = routingRoleText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		safeSpecialProvisions = specialProvisionsText.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
                 		routingBlock = "";
                 		if(routingNoteText != "")
                 		{
                 			noteLabel = "Previous approver note";
                 			if(routingActionText == "Rejected")
                 			{
                 				noteLabel = "Return note from " + safeRoutingRole;
                 			}
                 			routingBlock = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'>" + "<tr><td style='padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#9a3412;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;'>" + noteLabel + "</div>" + "<div style='white-space:pre-wrap;color:#431407;line-height:1.5;'>" + safeRoutingNote + "</div>" + "</td></tr></table>";
                 		}
                 		overviewRows = "";
                 		overviewRows = overviewRows + "<tr><td width='44%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Territory</td><td width='56%' style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeTerritoryText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Stage</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeStageText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Status</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeStatusText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Current Step</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + safeCurrentStepText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Purchase</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + purchaseDateText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Completion</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + completionDateText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>ROI</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#2563eb;border-bottom:1px solid #e5ebf3;'>" + roiText + "</td></tr>";
                 		overviewRows = overviewRows + "<tr><td style='padding:8px 0;color:#64748b;'>Net Profit</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;'>" + netProfitText + "</td></tr>";
                 		loiRows = "";
                 		loiRows = loiRows + "<tr><td width='42%' style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Seller</td><td width='58%' style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeSellerText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Buying Entity</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeBuyingEntityText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Property</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safePropertyText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Total Acres</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + acresText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Price / Acre</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + pricePerAcreText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Estimated Purchase</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:800;color:#047857;border-bottom:1px solid #e5ebf3;'>" + estimatedPurchasePriceText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Earnest Money</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + earnestMoneyText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Feasibility / Closing</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;'>" + feasibilityText + " / " + closingText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;border-bottom:1px solid #e5ebf3;'>Extensions</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;border-bottom:1px solid #e5ebf3;word-break:break-word;'>" + safeExtensionsText + "</td></tr>";
                 		loiRows = loiRows + "<tr><td style='padding:8px 0;color:#64748b;'>Response / Effective</td><td style='padding:8px 0 8px 12px;text-align:right;font-weight:700;color:#172033;'>" + responseDateText + " / " + effectiveDateText + "</td></tr>";
                 		summaryPanels = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;table-layout:fixed;'>" + "<tr>" + "<td width='50%' valign='top' style='padding-right:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>Pro Forma Overview</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + overviewRows + "</table></td></tr>" + "</table></td>" + "<td width='50%' valign='top' style='padding-left:7px;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;background:#f8fafc;border:1px solid #dce5f0;border-radius:12px;'>" + "<tr><td style='padding:14px 16px 8px;'><div style='font-size:11px;font-weight:800;color:#173b68;text-transform:uppercase;letter-spacing:.08em;'>LOI Snapshot</div></td></tr>" + "<tr><td style='padding:0 16px 14px;'><table width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'>" + loiRows + "</table></td></tr>" + "</table></td>" + "</tr></table>";
                 		legalInstruction = "Review the attached Pro Forma approval packet and record your decision below.";
                 		if(approvalRow.Title == "Legal")
                 		{
                 			legalInstruction = "Review the attached approval packet, including the complete LOI worksheet, Sellers, Properties, and deal terms, before routing it to the next approval step.";
                 		}
                 		// Use bgcolor and borders on the TABLE CELLS so Outlook cannot reduce these to plain text links.
                 		decisionButtons = "<table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin:22px 0 8px;'>" + "<tr>" + "<td bgcolor='#047857' style='background-color:#047857;border:1px solid #065f46;border-radius:8px;mso-padding-alt:0;'>" + "<a href='" + approveUrl + "' style='display:block;padding:12px 25px;font-family:Arial,sans-serif;font-size:14px;line-height:18px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Approve</a>" + "</td>" + "<td width='12' style='width:12px;font-size:1px;line-height:1px;'>&nbsp;</td>" + "<td bgcolor='#b42318' style='background-color:#b42318;border:1px solid #8f1d15;border-radius:8px;mso-padding-alt:0;'>" + "<a href='" + denyUrl + "' style='display:block;padding:12px 25px;font-family:Arial,sans-serif;font-size:14px;line-height:18px;font-weight:700;color:#ffffff !important;text-decoration:none !important;text-align:center;border-radius:8px;'>Deny</a>" + "</td>" + "</tr></table>";
                 		messageHtml = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='width:100%;background:#eef3fa;margin:0;padding:0;'>" + "<tr><td align='center' style='padding:24px 12px;'>" + "<table role='presentation' width='760' cellpadding='0' cellspacing='0' border='0' style='width:100%;max-width:760px;background:#ffffff;border-collapse:separate;border-spacing:0;'>" + "<tr><td style='background:#102f55;color:#ffffff;padding:24px 26px;border-radius:15px 15px 0 0;border-bottom:4px solid #2563eb;'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='table-layout:fixed;'><tr>" + "<td valign='bottom' style='padding-right:20px;'>" + "<div style='font-size:11px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.11em;font-weight:700;'>Pro Forma Approval</div>" + "<div style='font-size:24px;font-weight:700;line-height:1.2;margin-top:7px;'>" + safePfName + "</div>" + "<div style='font-size:13px;color:#c9d8eb;margin-top:8px;'>" + safeTerritoryText + " &nbsp;&middot;&nbsp; " + safeStageText + "</div>" + "</td>" + "<td width='150' valign='bottom' align='right'>" + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#173f6f;border:1px solid #315983;border-radius:10px;'>" + "<tr><td align='left' style='padding:10px 12px;'>" + "<div style='font-size:9px;color:#a9bfd8;text-transform:uppercase;letter-spacing:.09em;font-weight:700;'>Current Step</div>" + "<div style='font-size:16px;color:#ffffff;font-weight:700;margin-top:4px;'>" + safeCurrentStepText + "</div>" + "</td></tr></table></td>" + "</tr></table></td></tr>" + "<tr><td style='padding:22px 24px 24px;border-left:1px solid #dce5f0;border-right:1px solid #dce5f0;border-bottom:1px solid #dce5f0;border-radius:0 0 15px 15px;'>" + "<p style='margin:0 0 8px;font-size:15px;color:#172033;'>The <b>" + safeCurrentStepText + "</b> approval is now pending with you.</p>" + "<p style='margin:0;color:#475569;line-height:1.55;'>" + legalInstruction + "</p>" + routingBlock + summaryPanels;
                 		if(specialProvisionsText != "")
                 		{
                 			messageHtml = messageHtml + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:14px 16px;background:#fffaf0;border:1px solid #fde3a7;border-radius:10px;'>" + "<div style='font-size:11px;font-weight:800;color:#8a4b08;text-transform:uppercase;letter-spacing:.07em;'>Special Provisions</div>" + "<div style='margin-top:7px;white-space:pre-wrap;color:#4a3217;line-height:1.5;'>" + safeSpecialProvisions + "</div>" + "</td></tr></table>";
                 		}
                 		messageHtml = messageHtml + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:16px;'>" + "<tr><td style='padding:13px 15px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;'>" + "<div style='font-weight:700;color:#173b68;'>Attached approval packet</div>" + "<div style='margin-top:5px;color:#475569;font-size:13px;'>Includes the executive summary, all non-zero Additional Costs, complete LOI terms, Sellers, and Properties.</div>" + "</td></tr></table>" + decisionButtons + "<div style='font-size:12px;color:#64748b;margin-top:8px;'>Approve records the response when the approval page opens. Deny opens a page where a note is required.</div>" + "<div style='margin-top:18px;padding-top:14px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;'>Already have Land Master access? <a href='" + reviewUrl + "' style='color:#2563eb;text-decoration:none;font-weight:600;'>Open the full Pro Forma</a></div>" + "</td></tr></table></td></tr></table>";
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :toAddress
                 			subject :subjectText
                 			message :messageHtml
                 			Attachments :file:pdfFile
                 		]
                 		approvalRow.Sent_Date=zoho.currenttime;
                 		response.put("success",true);
                 		response.put("message","Approval email and PDF packet sent to " + toAddress + ".");
                 		response.put("packetFileName",packetFileName);
                 		response.put("pageCount",packet.get("pageCount"));
                 		response.put("additionalCostCount",packet.get("additionalCostCount"));
                 		response.put("containsAdditionalCosts",packet.get("containsAdditionalCosts"));
                 		response.put("containsLOITerms",packet.get("containsLOITerms"));
                 		response.put("sellerCount",packet.get("sellerCount"));
                 		response.put("propertyCount",packet.get("propertyCount"));
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string setProjectProforma(string projectId, string proformaId)
                 {
                 	vProjectId = projectId.toLong();
                 	vProformaText = ifnull(proformaId,"").trim();
                 	if(vProjectId == 0)
                 	{
                 		return "{\"ok\":false,\"error\":\"Missing projectId.\"}";
                 	}
                 	projectRec = Project[ID == vProjectId];
                 	if(projectRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Project not found.\"}";
                 	}
                 	if(vProformaText == "")
                 	{
                 		projectRec.Proforma=null;
                 		resultMap = Map();
                 		resultMap.put("ok",true);
                 		resultMap.put("projectId",vProjectId);
                 		resultMap.put("proformaId","");
                 		return resultMap.toString();
                 	}
                 	vProformaId = vProformaText.toLong();
                 	proformaRec = Add_Pro_Forma[ID == vProformaId];
                 	if(proformaRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Pro Forma not found.\"}";
                 	}
                 	projectRec.Proforma=proformaRec.ID;
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("projectId",vProjectId);
                 	resultMap.put("proformaId",vProformaId);
                 	return resultMap.toString();
                 }
				 string startAllApprovalChains(int budgetId)
                 {
                 	/********* START BOTH APPROVAL CHAINS *********/
                 	// Return Type: string
                 	// Starts Construction at VP and Development at VP.
                 	// Each chain advances independently after that.
                 	vBudgetId = budgetId.toLong();
                 	constructionResp = thisapp.startApprovalChain(vBudgetId,"Construction");
                 	developmentResp = thisapp.startApprovalChain(vBudgetId,"Development");
                 	return "Construction: " + constructionResp + " | Development: " + developmentResp;
                 }
				 string startApprovalChain(int budgetId, string approvalType)
                 {
                 	/********* START OR RESTART ONE APPROVAL CHAIN *********/
                 	// Return Type: string
                 	//
                 	// Development start/restart:
                 	// - Clear Development + Engineering Final.
                 	// - Copy Development + Engineering Preliminary into Unapproved.
                 	// - Construction values remain unchanged.
                 	//
                 	// Construction start/restart:
                 	// - Clear Construction Final.
                 	// - Preserve Construction Unapproved because it comes from
                 	//   HeavyJob / the external budget import.
                 	// - Development + Engineering values remain unchanged.
                 	//
                 	// The financial values are not changed until a valid first
                 	// approval row has been found.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "No approval type provided.";
                 	}
                 	if(vApprovalType != "Development" && vApprovalType != "Construction")
                 	{
                 		return "Unsupported approval type: " + vApprovalType;
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	/********* FIRST VALIDATE THE APPROVAL CHAIN *********/
                 	firstApprovalId = 0;
                 	firstSort = 999999;
                 	approvalRowCount = 0;
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 		{
                 			apprRowsCheck = Budget_Approvals[ID == appr.ID];
                 			if(apprRowsCheck.count() > 0)
                 			{
                 				approvalRowCount = approvalRowCount + 1;
                 				apprSort = 999999;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort < firstSort)
                 				{
                 					firstSort = apprSort;
                 					firstApprovalId = appr.ID;
                 				}
                 			}
                 		}
                 	}
                 	if(firstApprovalId == 0)
                 	{
                 		return "No " + vApprovalType + " approval rows found. No budget values were changed.";
                 	}
                 	/*****************************************************
                 	 * CLEAR THIS TRACK'S FINAL VALUES
                 	 *
                 	 * Development:
                 	 * - Final -> 0
                 	 * - Preliminary -> Unapproved
                 	 *
                 	 * Construction:
                 	 * - Final -> 0
                 	 * - Preserve externally populated Unapproved
                 	 *****************************************************/
                 	affectedItemCount = 0;
                 	stagedItemCount = 0;
                 	stagedTotal = 0;
                 	budgetCategoriesToStage = Budget_Category[Budget == vBudgetId];
                 	for each  cat in budgetCategoriesToStage
                 	{
                 		deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 		shouldProcess = false;
                 		if(vApprovalType == "Development")
                 		{
                 			if(deptKey.contains("development") || deptKey.contains("engineering"))
                 			{
                 				shouldProcess = true;
                 			}
                 		}
                 		else if(vApprovalType == "Construction")
                 		{
                 			if(deptKey.contains("construction"))
                 			{
                 				shouldProcess = true;
                 			}
                 		}
                 		if(shouldProcess == true)
                 		{
                 			catItemsToStage = Budget_Item[Budget_Category == cat.ID];
                 			for each  itemToStage in catItemsToStage
                 			{
                 				// Starting or restarting this track invalidates its old Final.
                 				itemToStage.Budget_Ttl=0;
                 				affectedItemCount = affectedItemCount + 1;
                 				if(vApprovalType == "Development")
                 				{
                 					prelimVal = 0;
                 					if(itemToStage.Prelim_Budget_Ttl != null)
                 					{
                 						prelimNum = itemToStage.Prelim_Budget_Ttl.toNumber();
                 						if(prelimNum != null)
                 						{
                 							prelimVal = prelimNum;
                 						}
                 					}
                 					// Dev/Eng stages Preliminary into Unapproved.
                 					itemToStage.Unapproved_Final_Budget_Ttl=prelimVal;
                 					stagedItemCount = stagedItemCount + 1;
                 					stagedTotal = stagedTotal + prelimVal;
                 				}
                 				// Construction Unapproved is intentionally not changed.
                 				// It is owned by HeavyJob / the external import process.
                 			}
                 			/********* REFRESH THIS CATEGORY'S FINAL TOTAL *********/
                 			catFinalTotal = 0;
                 			catFinalSum = Budget_Item[Budget_Category == cat.ID].sum(Budget_Ttl);
                 			if(catFinalSum != null)
                 			{
                 				catFinalNum = catFinalSum.toNumber();
                 				if(catFinalNum != null)
                 				{
                 					catFinalTotal = catFinalNum;
                 				}
                 			}
                 			cat.Budget_Total=catFinalTotal;
                 		}
                 	}
                 	/********* REFRESH PARENT BUDGET FINAL GRAND TOTAL *********/
                 	newGrandTotal = 0;
                 	allBudgetCategories = Budget_Category[Budget == vBudgetId];
                 	for each  catTotalRec in allBudgetCategories
                 	{
                 		if(catTotalRec.Budget_Total != null)
                 		{
                 			catTotalNum = catTotalRec.Budget_Total.toNumber();
                 			if(catTotalNum != null)
                 			{
                 				newGrandTotal = newGrandTotal + catTotalNum;
                 			}
                 		}
                 	}
                 	budgetRec.Budget_Grand_Total=newGrandTotal;
                 	/********* RESET THIS TRACK'S APPROVAL ROWS *********/
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 		{
                 			apprRows = Budget_Approvals[ID == appr.ID];
                 			for each  ar in apprRows
                 			{
                 				ar.Status="Not Sent";
                 				ar.Sent_Date=null;
                 				ar.Responded_Date=null;
                 				// Prior approval notes are intentionally retained.
                 				// Uncomment this if a restart should erase the notes:
                 				// ar.Approval_Notes="";
                 			}
                 		}
                 	}
                 	/********* SET FIRST APPROVER TO PENDING *********/
                 	firstApprovalRows = Budget_Approvals[ID == firstApprovalId];
                 	for each  firstApproval in firstApprovalRows
                 	{
                 		firstApproval.Status="Pending";
                 		firstApproval.Sent_Date=zoho.currentdate;
                 		firstApproval.Responded_Date=null;
                 	}
                 	emailResp = thisapp.sendApprovalEmail(vBudgetId,firstApprovalId);
                 	syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId,vApprovalType);
                 	if(vApprovalType == "Development")
                 	{
                 		stageResp = "Cleared " + affectedItemCount + " Development/Engineering Final items and staged " + stagedItemCount + " Preliminary items totaling " + stagedTotal + " into Unapproved.";
                 	}
                 	else
                 	{
                 		stageResp = "Cleared " + affectedItemCount + " Construction Final items. Construction Unapproved values were preserved.";
                 	}
                 	return vApprovalType + " chain started. " + stageResp + " " + emailResp + " " + syncResp;
                 }
				 map Start_Proforma_Approval_Chain(string proformaId)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		if(proformaIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID is required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma not found.");
                 			return response;
                 		}
                 		rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		if(rows.count() == 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Add at least one approval step before submitting this Pro Forma.");
                 			return response;
                 		}
                 		missingRecipients = List();
                 		missingTitles = List();
                 		expectedOrder = 1;
                 		for each  row in rows
                 		{
                 			rowTitle = ifnull(row.Title,"").toString().trim();
                 			rowEmail = ifnull(row.Approver,"").toString().trim();
                 			if(rowTitle == "")
                 			{
                 				missingTitles.add("Step " + expectedOrder.toString());
                 			}
                 			if(rowEmail == "")
                 			{
                 				missingRecipients.add(if(rowTitle == "","Step " + expectedOrder.toString(),rowTitle));
                 			}
                 			// Normalize the sequence before routing so there can be no gaps.
                 			row.Sort_Order=expectedOrder;
                 			expectedOrder = expectedOrder + 1;
                 		}
                 		if(missingTitles.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Missing approval step name for: " + missingTitles.toString(", "));
                 			return response;
                 		}
                 		if(missingRecipients.size() > 0)
                 		{
                 			response.put("success",false);
                 			response.put("message","Missing approver email for: " + missingRecipients.toString(", "));
                 			return response;
                 		}
                 		for each  row in rows
                 		{
                 			row.Status="Not Sent";
                 			row.Approval_Notes="";
                 			row.Sent_Date=null;
                 			row.Responded_Date=null;
                 		}
                 		firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
                 		if(firstRow.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","The first approval row could not be found.");
                 			return response;
                 		}
                 		firstRow.Status="Pending";
                 		firstRow.Sent_Date=zoho.currenttime;
                 		firstRow.Responded_Date=null;
                 		pf.Lock_Inputs=true;
                 		emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Started","","System");
                 		if(ifnull(emailResult.get("success"),false) != true)
                 		{
                 			firstRow.Status="Not Sent";
                 			firstRow.Sent_Date=null;
                 			pf.Lock_Inputs=false;
                 			response.put("success",false);
                 			response.put("message",emailResult.get("message"));
                 			return response;
                 		}
                 		response.put("success",true);
                 		response.put("message","Approval request sent to " + firstRow.Title + " with the approval PDF packet.");
                 		response.put("pendingApprovalId",firstRow.ID.toString());
                 		response.put("packetFileName",emailResult.get("packetFileName"));
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string Submit_LOI_For_Legal_Approval(string proformaId)
                 {
                 	result = Map();
                 	try 
                 	{
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.ID == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		missing = List();
                 		if(pf.Lock_Inputs != true)
                 		{
                 			missing.add("Lock Inputs");
                 		}
                 		if(pf.Seller == null || pf.Seller.trim() == "")
                 		{
                 			missing.add("Seller");
                 		}
                 		if(pf.Authorized_Signer_for_Seller == null || pf.Authorized_Signer_for_Seller.trim() == "")
                 		{
                 			missing.add("Authorized Signer for Seller");
                 		}
                 		if(pf.Street_Address == null || pf.Street_Address.trim() == "")
                 		{
                 			missing.add("Street Address");
                 		}
                 		if(pf.Seller_City_State_ZIP == null || pf.Seller_City_State_ZIP.trim() == "")
                 		{
                 			missing.add("Seller City State ZIP");
                 		}
                 		if(pf.Seller_Phone == null || pf.Seller_Phone.trim() == "")
                 		{
                 			missing.add("Seller Phone");
                 		}
                 		if(pf.Seller_Email == null || pf.Seller_Email.trim() == "")
                 		{
                 			missing.add("Seller Email");
                 		}
                 		if(pf.Purchasing_Company == null)
                 		{
                 			missing.add("Purchasing Company");
                 		}
                 		if(pf.CAD_ID == null || pf.CAD_ID.trim() == "")
                 		{
                 			missing.add("CAD ID");
                 		}
                 		if(pf.Property_County == null || pf.Property_County.trim() == "")
                 		{
                 			missing.add("Property County");
                 		}
                 		if(pf.Property_City == null || pf.Property_City.trim() == "")
                 		{
                 			missing.add("Property City");
                 		}
                 		if(pf.Total_Acres == null)
                 		{
                 			missing.add("Total Acres");
                 		}
                 		if(pf.Land_Cost_Acre == null)
                 		{
                 			missing.add("Amount per Acre");
                 		}
                 		if(pf.Earnest_Money == null)
                 		{
                 			missing.add("Earnest Money");
                 		}
                 		if(pf.Initial_Feasibility_Days == null)
                 		{
                 			missing.add("Initial Feasibility Days");
                 		}
                 		if(pf.Extensions == null)
                 		{
                 			missing.add("Extensions");
                 		}
                 		if(pf.Days_per_Extension == null)
                 		{
                 			missing.add("Days per Extension");
                 		}
                 		if(pf.Amount_per_Extension == null)
                 		{
                 			missing.add("Amount per Extension");
                 		}
                 		if(pf.Closing_Days_Feas == null)
                 		{
                 			missing.add("Closing Days after Feasibility");
                 		}
                 		if(pf.Response_Date == null)
                 		{
                 			missing.add("Response Date");
                 		}
                 		if(missing.size() > 0)
                 		{
                 			result.put("success",false);
                 			result.put("message","Complete the required LOI fields before sending to Legal: " + missing.toString(", "));
                 			result.put("missing",missing);
                 			return result.toString();
                 		}
                 		legalEmail = "rbelliveau@wbdevelopment.com";
                 		if(legalEmail == "LEGAL_EMAIL_HERE" || legalEmail.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","Replace LEGAL_EMAIL_HERE in Submit_LOI_For_Legal_Approval before using this function.");
                 			return result.toString();
                 		}
                 		buyingEntityName = pf.Purchasing_Company.toString();
                 		companyRec = Company[ID == pf.Purchasing_Company];
                 		if(companyRec.ID != null && companyRec.Company_Name != null && companyRec.Company_Name.trim() != "")
                 		{
                 			buyingEntityName = companyRec.Company_Name.trim();
                 		}
                 		token = pf.ID.toString() + "-" + zoho.currenttime.toLong().toString() + "-" + randomNumber(100000000,999999999).toString();
                 		reviewUrl = zoho.appuri + "page-embed/Contracts?loiReviewId=" + pf.ID.toString() + "&token=" + token;
                 		pf.LOI_Legal_Status="Pending Approval";
                 		pf.LOI_Approval_Token=token;
                 		pf.LOI_Legal_Note="";
                 		specialProvisions = if(pf.Special_Provisions == null || pf.Special_Provisions.trim() == "","None.",pf.Special_Provisions);
                 		buyerBroker = if(pf.Broker_Buyer == null || pf.Broker_Buyer.trim() == "","None",pf.Broker_Buyer);
                 		sellerBroker = if(pf.Broker_Seller == null || pf.Broker_Seller.trim() == "","None",pf.Broker_Seller);
                 		emailBody = "<div style='font-family:Arial,sans-serif;color:#173252;max-width:760px'>";
                 		emailBody = emailBody + "<h2 style='margin:0 0 6px'>LOI Review Request: " + ifnull(pf.Name,"Pro Forma") + "</h2>";
                 		emailBody = emailBody + "<p style='margin:0 0 18px;color:#5c7394'>Please review the terms below. Approval from Contract Management will create the Acquisition Contract and generate the LOI document.</p>";
                 		emailBody = emailBody + "<table cellpadding='7' cellspacing='0' style='border-collapse:collapse;width:100%;font-size:13px'>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Seller</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Seller,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Authorized Signer</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Authorized_Signer_for_Seller,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Property</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Street_Address,"") + ", " + ifnull(pf.Seller_City_State_ZIP,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Purchasing Company</b></td><td style='border:1px solid #dde4ef'>" + buyingEntityName + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>CAD ID</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.CAD_ID,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>County / City</b></td><td style='border:1px solid #dde4ef'>" + ifnull(pf.Property_County,"") + " / " + ifnull(pf.Property_City,"") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Total Acres</b></td><td style='border:1px solid #dde4ef'>" + pf.Total_Acres.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Amount per Acre</b></td><td style='border:1px solid #dde4ef'>$" + pf.Land_Cost_Acre.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Earnest Money</b></td><td style='border:1px solid #dde4ef'>$" + pf.Earnest_Money.toString() + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Feasibility</b></td><td style='border:1px solid #dde4ef'>" + pf.Initial_Feasibility_Days.toString() + " days; " + pf.Extensions.toString() + " extension(s) of " + pf.Days_per_Extension.toString() + " days at $" + pf.Amount_per_Extension.toString() + " each</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Closing</b></td><td style='border:1px solid #dde4ef'>" + pf.Closing_Days_Feas.toString() + " days after feasibility</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Response Date</b></td><td style='border:1px solid #dde4ef'>" + pf.Response_Date.toString("MM/dd/yyyy") + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Buyer Broker</b></td><td style='border:1px solid #dde4ef'>" + buyerBroker + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Seller Broker</b></td><td style='border:1px solid #dde4ef'>" + sellerBroker + "</td></tr>";
                 		emailBody = emailBody + "<tr><td style='border:1px solid #dde4ef;background:#f6f8fc'><b>Special Provisions</b></td><td style='border:1px solid #dde4ef'>" + specialProvisions + "</td></tr>";
                 		emailBody = emailBody + "</table>";
                 		emailBody = emailBody + "<p style='margin:20px 0'><a href='" + reviewUrl + "' style='display:inline-block;background:#2563eb;color:white;text-decoration:none;padding:11px 18px;border-radius:8px;font-weight:bold'>Review LOI in Contract Management</a></p>";
                 		emailBody = emailBody + "</div>";
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :legalEmail
                 			subject :"LOI Review Request - " + ifnull(pf.Name,"Pro Forma")
                 			message :emailBody
                 		]
                 		result.put("success",true);
                 		result.put("message","LOI sent to Legal for approval.");
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("reviewUrl",reviewUrl);
                 		result.put("status","Pending Approval");
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		result.put("success",false);
                 		result.put("message","LOI approval request failed at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		return result.toString();
                 	}
                 	return "nice";
                 }
				 string syncBudgetApprovalStatus(int budgetId, string approvalType)
                 {
                 	/********* SYNC PARENT BUDGET APPROVAL STATUS *********/
                 	// Return Type: string
                 	// Updates Add_Budget.Const_Budget_Approval_Status or Add_Budget.Development_Budget_Approval_Status
                 	// based on the current approval rows for the selected approval type.
                 	// Parent statuses stay simple: Not Sent, Pending, Approved.
                 	// Rejected approval rows are treated as Pending at the parent level because the chain is still active.
                 	vBudgetId = budgetId.toLong();
                 	vApprovalType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0)
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "No approval type provided.";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	totalRows = 0;
                 	approvedRows = 0;
                 	startedRows = 0;
                 	for each  appr in budgetRec.Approvals
                 	{
                 		if(ifnull(appr.Type1,"") == vApprovalType)
                 		{
                 			totalRows = totalRows + 1;
                 			apprStatus = ifnull(appr.Status,"");
                 			if(apprStatus == "")
                 			{
                 				apprStatus = "Not Sent";
                 			}
                 			if(apprStatus == "Approved")
                 			{
                 				approvedRows = approvedRows + 1;
                 				startedRows = startedRows + 1;
                 			}
                 			else if(apprStatus == "Pending" || apprStatus == "Rejected")
                 			{
                 				startedRows = startedRows + 1;
                 			}
                 		}
                 	}
                 	parentStatus = "Not Sent";
                 	if(totalRows > 0 && approvedRows == totalRows)
                 	{
                 		parentStatus = "Approved";
                 	}
                 	else if(startedRows > 0)
                 	{
                 		parentStatus = "Pending";
                 	}
                 	else
                 	{
                 		parentStatus = "Not Sent";
                 	}
                 	if(vApprovalType == "Construction")
                 	{
                 		budgetRec.Const_Budget_Approval_Status=parentStatus;
                 	}
                 	else if(vApprovalType == "Development")
                 	{
                 		budgetRec.Development_Budget_Approval_Status=parentStatus;
                 	}
                 	return vApprovalType + " budget approval status synced to " + parentStatus + ".";
                 }
				 map Update_Proforma_Approval_Recipient(map request)
                 {
                 	response = Map();
                 	try 
                 	{
                 		// Creator widget sends Zoho IDs as strings so JavaScript does not lose
                 		// precision. Convert them to BIGINT before using them in record criteria.
                 		proformaIdText = ifnull(request.get("proformaId"),"").toString().trim();
                 		approvalIdText = ifnull(request.get("approvalId"),"").toString().trim();
                 		approverEmail = ifnull(request.get("approverEmail"),"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		if(approverEmail == "" || !approverEmail.contains("@"))
                 		{
                 			response.put("success",false);
                 			response.put("message","Enter a valid approver email.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		// Fetch by the Creator record ID only. Combining the ID and Proforma
                 		// comparisons in one criteria expression caused Creator's
                 		// BIGINT-versus-STRING mismatch.
                 		approvalRow = Budget_Approvals[ID == approvalIdLong];
                 		if(approvalRow.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval row not found.");
                 			return response;
                 		}
                 		// Validate that this approval belongs to the requested Pro Forma without
                 		// putting the Proforma field into the record criteria expression.
                 		approvalProformaId = ifnull(approvalRow.Proforma,0).toLong();
                 		if(approvalProformaId != proformaIdLong)
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval row does not belong to this Pro Forma.");
                 			return response;
                 		}
                 		approvalRow.Approver=approverEmail;
                 		response.put("success",true);
                 		response.put("message","Approver updated.");
                 		response.put("approvalId",approvalRow.ID.toString());
                 		response.put("approverEmail",approvalRow.Approver);
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string utilitiesconvertIntegerToCurrency(int number)
                 {
                 	separator = ",";
                 	// --- specify your type of separator (i'm using a comma)
                 	divisor = 3;
                 	// specify how many digits in between each separator
                 	// --- convert integer to string & remove hyphen if number is negative
                 	string = number.toString().remove("-");
                 	// --- get length of string
                 	stringLen = string.length();
                 	separators = 0;
                 	// --- calculate how many separators will be needed to construct your currency string
                 	// ------ if equally divisible 3, reduce number of separators by one (basically checks to see if number of digits is exactly divisible by 3 which means there will be one less separator)
                 	if(stringLen / divisor = (stringLen / divisor).floor())
                 	{
                 		separators = stringLen / divisor - 1;
                 	}
                 	// ------ if there is a remainder after dividing by 3, set the # of separators (basically, this means there is 1 or 2 digits at the front of the number, in front of the very first separator)
                 	else
                 	{
                 		separators = (stringLen / divisor).floor();
                 	}
                 	// --- build your List needed for 'for each' loop
                 	// ------ makeRange is a custom function required to build the List
                 	range = thisapp.utilitiesmakeRange(1,separators);
                 	stringBuild = "";
                 	// --- declare stringBuild variable used to continually construct the sting
                 	// --- execute 'for each' loop to parse through the number and add separators
                 	for each  i in range
                 	{
                 		// --- append separator to front of substring and add suffix of stringBuild value from previous loop iteration
                 		stringBuild = separator + string.substring(stringLen - i * divisor,stringLen - (i - 1) * divisor) + stringBuild;
                 	}
                 	// --- get the first set of leading digits before the first separator
                 	stringBuild = string.substring(0,stringLen - separators * divisor) + stringBuild;
                 	// --- now let's bring it all together
                 	// ------ check to see if number is positive or negative and format accordingly (you can change how you want to handle negative numbers, I wrap them in parentheses but you can modify this code to add a hyphen as the prefix, with no parentheses)
                 	if(number < 0)
                 	{
                 		numConverted = "($" + stringBuild + ")";
                 		// --- parentheses formatting for negative #'s
                 	}
                 	else
                 	{
                 		numConverted = "$" + stringBuild;
                 	}
                 	return numConverted;
                 }
				 list utilitiesmakeRange(int start, int end)
                 {
                 	if(start > end)
                 	{
                 		return {};
                 	}
                 	else
                 	{
                 		lst = List:Int();
                 		lst.add(start);
                 		lst.addAll(thisapp.utilitiesmakeRange(start + 1,end));
                 		return lst;
                 	}
                 }
			 }
		 }
