				 string generateApprovedBudgetPDF(string budgetId)
                 {
                 	/********* AUTOMATIC EXPORT AFTER BOTH APPROVAL TRACKS FINISH *********/
                 	return thisapp.exportBudgetSnapshot(budgetId,"APPROVED_PDF");
                 }
				 string getBudgetAttachmentPreview(string budgetId, string attachmentId)
                 {
                 	/********* RETURN AN EXACT BASE64 COPY OF ONE BUDGET ATTACHMENT *********/
                 	// Custom API link name expected by the widget:
                 	// Get_Budget_Attachment_Preview
                 	response = Map();
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vBudgetId == "" || vAttachmentId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Budget ID or attachment ID.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		attachmentRows = Attachment[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 		if(attachmentRows.count() == 0)
                 		{
                 			response.put("ok",false);
                 			response.put("message","Attachment record was not found for this budget.");
                 			return response.toString();
                 		}
                 		for each  attachmentRow in attachmentRows
                 		{
                 			if(attachmentRow.File_field1 == null)
                 			{
                 				response.put("ok",false);
                 				response.put("message","The attachment record does not contain a file.");
                 				return response.toString();
                 			}
                 			encodedFile = zoho.encryption.base64Encode(attachmentRow.File_field1);
                 			if(encodedFile == null || encodedFile == "")
                 			{
                 				response.put("ok",false);
                 				response.put("message","Creator could not encode the attachment for preview.");
                 				return response.toString();
                 			}
                 			fileName = "";
                 			try 
                 			{
                 				fileName = attachmentRow.File_field1.actualname;
                 			}			catch (nameError)
                 			{
                 				fileName = "";
                 			}
                 			response.put("ok",true);
                 			response.put("attachmentId",vAttachmentId);
                 			response.put("budgetId",vBudgetId);
                 			response.put("fileName",fileName);
                 			response.put("base64",encodedFile);
                 			response.put("byteLength",(encodedFile.length() * 3 / 4).toLong());
                 			return response.toString();
                 		}
                 	}	catch (previewError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment preview failed: " + previewError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment preview failed.");
                 	return response.toString();
                 }
				 string getContractAttachmentPreview(string contractId, string attachmentId)
                 {
                 	response = Map();
                 	vContractId = ifnull(contractId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vContractId == "" || vAttachmentId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Contract ID or attachment ID.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		attachmentRows = Attachment[ID == vAttachmentId.toLong() && Contract1 == vContractId.toLong()];
                 		if(attachmentRows.count() == 0)
                 		{
                 			response.put("ok",false);
                 			response.put("message","Attachment record was not found for this Contract.");
                 			return response.toString();
                 		}
                 		for each  attachmentRow in attachmentRows
                 		{
                 			if(attachmentRow.File_field1 == null)
                 			{
                 				response.put("ok",false);
                 				response.put("message","The attachment record does not contain a file.");
                 				return response.toString();
                 			}
                 			encodedFile = zoho.encryption.base64Encode(attachmentRow.File_field1);
                 			if(encodedFile == null || encodedFile == "")
                 			{
                 				response.put("ok",false);
                 				response.put("message","Creator could not encode the attachment for preview or download.");
                 				return response.toString();
                 			}
                 			fileName = "";
                 			try 
                 			{
                 				fileName = attachmentRow.File_field1.actualname;
                 			}			catch (nameError)
                 			{
                 				fileName = "";
                 			}
                 			response.put("ok",true);
                 			response.put("attachmentId",vAttachmentId);
                 			response.put("contractId",vContractId);
                 			response.put("fileName",fileName);
                 			response.put("base64",encodedFile);
                 			response.put("byteLength",(encodedFile.length() * 3 / 4).toLong());
                 			return response.toString();
                 		}
                 	}	catch (previewError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment preview/download failed: " + previewError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment preview/download failed.");
                 	return response.toString();
                 }
				 string getLandMasterChoices()
                 {
                 	choices = Map();
                 	choices.put("City",thisapp.variables.City.toString().toList(","));
                 	choices.put("County",thisapp.variables.County.toString().toList(","));
                 	choices.put("Territory",thisapp.variables.Territory.toString().toList(","));
                 	return choices.toString();
                 }
				 string getProformaAttachmentPreview(string proformaId, string attachmentId)
                 {
                 	/********* RETURN AN EXACT BASE64 COPY OF ONE PRO FORMA ATTACHMENT *********/
                 	response = Map();
                 	vProformaId = ifnull(proformaId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vProformaId == "" || vAttachmentId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Pro Forma ID or attachment ID.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		attachmentRows = Attachment[ID == vAttachmentId.toLong() && Pro_Forma == vProformaId.toLong()];
                 		if(attachmentRows.count() == 0)
                 		{
                 			response.put("ok",false);
                 			response.put("message","Attachment record was not found for this Pro Forma.");
                 			return response.toString();
                 		}
                 		for each  attachmentRow in attachmentRows
                 		{
                 			if(attachmentRow.File_field1 == null)
                 			{
                 				response.put("ok",false);
                 				response.put("message","The attachment record does not contain a file.");
                 				return response.toString();
                 			}
                 			encodedFile = zoho.encryption.base64Encode(attachmentRow.File_field1);
                 			if(encodedFile == null || encodedFile == "")
                 			{
                 				response.put("ok",false);
                 				response.put("message","Creator could not encode the attachment for preview.");
                 				return response.toString();
                 			}
                 			fileName = "";
                 			try 
                 			{
                 				fileName = attachmentRow.File_field1.actualname;
                 			}			catch (nameError)
                 			{
                 				fileName = "";
                 			}
                 			response.put("ok",true);
                 			response.put("attachmentId",vAttachmentId);
                 			response.put("proformaId",vProformaId);
                 			response.put("fileName",fileName);
                 			response.put("base64",encodedFile);
                 			response.put("byteLength",(encodedFile.length() * 3 / 4).toLong());
                 			return response.toString();
                 		}
                 	}	catch (previewError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment preview failed: " + previewError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment preview failed.");
                 	return response.toString();
                 }
				 string getUserAccess(string user)
                 {
                 	requester = if(user != null && user != "",user,zoho.loginuser);
                 	// Budget flags
                 	editAll = false;
                 	editOwned = false;
                 	apprAll = false;
                 	apprOwned = false;
                 	sendAppr = false;
                 	editOwners = false;
                 	viewImports = false;
                 	editImports = false;
                 	modAdmin = false;
                 	budgetDeleteArchive = false;
                 	// Data Insights permissions
                 	lotSalesDashboard = false;
                 	viewTotalLotRevenue = false;
                 	// Pro Forma flags
                 	pfEditAll = false;
                 	pfEditOwned = false;
                 	pfEditCurve = false;
                 	pfVpCompTab = false;
                 	pfEditProbability = false;
                 	pfEditOwner = false;
                 	pfDeleteArchive = false;
                 	pfApprAll = false;
                 	pfApprOwned = false;
                 	pfSendApprovals = false;
                 	pfSendCostsToBudgets = false;
                 	pfSubmitLegal = false;
                 	pfAiReview = false;
                 	budgetAssignedToMe = false;
                 	proformaAssignedToMe = false;
                 	legalAssignedToMe = false;
                 	// Contract flags
                 	ctEdit = false;
                 	ctPropose = false;
                 	ctApprove = false;
                 	ctTemplates = false;
                 	ctDeleteArchive = false;
                 	foundRow = false;
                 	myId = "";
                 	rows = User_Access[User == requester];
                 	for each  row in rows
                 	{
                 		foundRow = true;
                 		myId = row.ID.toString();
                 		// Budget permissions
                 		editAll = row.Edit_All_Budgets == true;
                 		editOwned = row.Edit_Owned_Budgets == true;
                 		apprAll = row.Edit_All_Approvals == true;
                 		apprOwned = row.Edit_Owned_Approvals == true;
                 		sendAppr = row.Send_for_Approvals == true;
                 		editOwners = row.Edit_Budget_Owners == true;
                 		viewImports = row.View_Budget_Import_Items == true;
                 		editImports = row.Edit_Budget_Import_Items == true;
                 		modAdmin = row.Edit_Delete_All_Modifications == true;
                 		budgetDeleteArchive = row.Delete_Archive_Budgets == true;
