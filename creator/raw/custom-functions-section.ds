				 string Create_LOI_Contract(string proformaId)
                 {
                 	result = Map();
                 	trace = List();
                 	stage = "writer_merge";
                 	try 
                 	{
                 		// Submission authority comes only from the dedicated permission for the signed-in user.
                 		legalAccess = User_Access[User == zoho.loginuser];
                 		if(legalAccess.count() == 0 || legalAccess.Submit_to_Legal_Module != true)
                 		{
                 			result.put("success",false);
                 			result.put("message","Submit to Legal Module access is required.");
                 			return result.toString();
                 		}
                 		if(proformaId == null || proformaId.trim() == "")
                 		{
                 			result.put("success",false);
                 			result.put("message","No Pro Forma ID was supplied.");
                 			return result.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		if(pf.count() == 0)
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma record could not be found.");
                 			return result.toString();
                 		}
                 		legalApprovalRows = Budget_Approvals[Proforma == pf.ID];
                 		legalFullyApproved = ifnull(pf.Status,"") == "Approved";
                 		if(legalApprovalRows.count() > 0)
                 		{
                 			legalFullyApproved = true;
                 			for each  legalApproval in legalApprovalRows
                 			{
                 				if(ifnull(legalApproval.Status,"") != "Approved")
                 				{
                 					legalFullyApproved = false;
                 				}
                 			}
                 		}
                 		if(!legalFullyApproved || pf.Lock_Inputs != true || pf.Archive == true || ifnull(pf.Status,"") == "LOI in Progress")
                 		{
                 			result.put("success",false);
                 			result.put("message","The Pro Forma must be fully approved, locked, active, and not already submitted to Legal.");
                 			return result.toString();
                 		}
                 		loiRec = null;
                 		for each  worksheet in LOI_Worksheet[Proforma == pf.ID]
                 		{
                 			if(loiRec == null || worksheet.Is_Current == true)
                 			{
                 				loiRec = worksheet;
                 			}
                 		}
                 		if(loiRec == null || loiRec.Company == null)
                 		{
                 			result.put("success",false);
                 			result.put("message","Select the Purchasing Company in the LOI Worksheet before submitting to Legal.");
                 			return result.toString();
                 		}
                 		document = thisapp.PF_Build_LOI_Document(proformaId);
                 		if(ifnull(document.get("success"),false) != true)
                 		{
                 			return document.toString();
                 		}
                 		pf = Add_Pro_Forma[ID == proformaId.toLong()];
                 		trace = document.get("audit");
                 		missing = document.get("missing");
                 		mergedFile = document.get("file");
                 		fileName = document.get("fileName");
                 		contractTerritory = document.get("contractTerritory");
                 		wbwPointPerson = document.get("wbwPointPerson");
                 		stage = "create_or_reuse_contract";
                 		contractName = "Acquisition - " + ifnull(pf.Name,"Pro Forma");
                 		/* Contracts created before this rename are named "<Pro Forma> - LOI", and reuse is
                 		   matched on the name alone - so without the legacy lookup a resubmit would miss the
                 		   existing record and insert a duplicate. Old contracts keep their old name; only
                 		   newly created ones use the new scheme. */
                 		legacyContractName = ifnull(pf.Name,"Pro Forma") + " - LOI";
                 		contractId = null;
                 		existingContract = Contract[Contract_Name == contractName && Contract_Type == "Acquisition"];
                 		if(existingContract.ID == null)
                 		{
                 			existingContract = Contract[Contract_Name == legacyContractName && Contract_Type == "Acquisition"];
                 		}
                 		if(existingContract.ID != null)
                 		{
                 			contractId = existingContract.ID;
                 			existingContract.Contract_Type="Acquisition";
                 			existingContract.Territory=contractTerritory;
                 			if(existingContract.WBW_Point_Person == null || existingContract.WBW_Point_Person.trim() == "")
                 			{
                 				existingContract.WBW_Point_Person=wbwPointPerson;
                 			}
                 			reuseEntry = Map();
                 			reuseEntry.put("level","info");
                 			reuseEntry.put("stage",stage);
                 			reuseEntry.put("message","Existing Acquisition LOI Contract reused and required values confirmed");
                 			reuseEntry.put("meta",{"contractId":contractId.toString(),"contractName":ifnull(existingContract.Contract_Name,contractName),"matchedLegacyName":ifnull(existingContract.Contract_Name,"") == legacyContractName,"contractType":"Acquisition","territory":contractTerritory,"wbwPointPerson":ifnull(existingContract.WBW_Point_Person,"")});
                 			trace.add(reuseEntry);
                 		}
                 		else
                 		{
                 			contractId = insert into Contract
                 			[
                 				Added_User=zoho.loginuser
                 				Contract_Name=contractName
                 				Contract_Type="Acquisition"
                 				Territory=contractTerritory
                 				WBW_Point_Person=wbwPointPerson
                 				Status="Proposed"
                 			];
                 			createEntry = Map();
                 			createEntry.put("level","success");
                 			createEntry.put("stage",stage);
                 			createEntry.put("message","Acquisition Contract record created");
                 			createEntry.put("meta",{"contractId":contractId.toString(),"contractName":contractName,"contractType":"Acquisition","territory":contractTerritory,"wbwPointPerson":wbwPointPerson,"status":"Proposed"});
                 			trace.add(createEntry);
                 		}
                 		stage = "seed_contract_actions";
                 		/* The Contract form's "Load Contract Action Template" workflow runs ON LOAD, so it
                 		   only fires when a person opens the Add Contract form. This function inserts the
                 		   Contract directly, so that workflow never runs and the checklist arrived empty.
                 		   Seed it here from the Acquisition action template.
                 
                 		   A template row is a Contract_Actions record flagged Template_Action, carrying a
                 		   Type_field, with no Contract. All three matter: an ordinary action row whose
                 		   contract was deleted would still have a type and no contract, and without the
                 		   flag it would be seeded onto every future LOI as a phantom checklist item. */
                 		existingActionCount = Contract_Actions[Contract1 == contractId].count();
                 		if(existingActionCount == 0)
                 		{
                 			templateActions = Contract_Actions[Contract1 == null && Type_field == "Acquisition" && Template_Action == true] sort by Sort_Order;
                 			seededCount = 0;
                 			seededTitles = List();
                 			for each  templateAction in templateActions
                 			{
                 				actionTitle = ifnull(templateAction.Contract_Action,"").trim();
                 				if(actionTitle != "")
                 				{
                 					seededCount = seededCount + 1;
                 					actionSort = ifnull(templateAction.Sort_Order,seededCount);
                 					isFirstAction = false;
                 					if(seededCount == 1)
                 					{
                 						isFirstAction = true;
                 					}
                 					insert into Contract_Actions
                 					[
                 						Contract1=contractId
                 						Contract_Action=actionTitle
                 						Sort_Order=actionSort
                 						Status="Proposed"
                 						Complete=false
                 						Current_Action=isFirstAction
                 						Added_User=zoho.loginuser
                 					]
                 					seededTitles.add(actionTitle);
                 				}
                 			}
                 			if(seededCount > 0)
                 			{
                 				seedEntry = Map();
                 				seedEntry.put("level","success");
                 				seedEntry.put("stage",stage);
                 				seedEntry.put("message","Acquisition action template applied to the Contract");
                 				seedEntry.put("meta",{"contractId":contractId.toString(),"actionsSeeded":seededCount,"actions":seededTitles});
                 				trace.add(seedEntry);
                 			}
                 			else
                 			{
                 				/* Surfaced rather than swallowed: an empty checklist here means the
                 				   Acquisition template has no rows, and Legal would get a contract with
                 				   nothing to work through. */
                 				/* Distinguish "no template exists" from "the rows are there but not
                 				   flagged", which is the one way the flag check can bite. */
                 				untaggedCount = Contract_Actions[Contract1 == null && Type_field == "Acquisition"].count();
                 				noTemplateEntry = Map();
                 				noTemplateEntry.put("level","warn");
                 				noTemplateEntry.put("stage",stage);
                 				noTemplateEntry.put("message","No Acquisition action template rows were found - the Contract has an empty checklist");
                 				noTemplateEntry.put("meta",{"contractId":contractId.toString(),"template":"Acquisition","typedButUnflaggedRows":untaggedCount});
                 				trace.add(noTemplateEntry);
                 			}
                 		}
                 		else
                 		{
                 			keepEntry = Map();
                 			keepEntry.put("level","info");
                 			keepEntry.put("stage",stage);
                 			keepEntry.put("message","Contract already has actions - template not reapplied");
                 			keepEntry.put("meta",{"contractId":contractId.toString(),"existingActions":existingActionCount});
                 			trace.add(keepEntry);
                 		}
                 		stage = "attach_contract_version";
                 		contractVersionId = insert into Attachment
                 		[
                 			Added_User=zoho.loginuser
                 			Contract1=contractId
                 			Date_field1=zoho.currentdate
                 			File_field1=mergedFile
                 		];
                 		versionEntry = Map();
                 		versionEntry.put("level","success");
                 		versionEntry.put("stage",stage);
                 		versionEntry.put("message","Merged DOCX attached through Attachment");
                 		versionEntry.put("meta",{"contractVersionId":contractVersionId.toString(),"contractId":contractId.toString(),"fileField":"File_field1","fileName":fileName});
                 		trace.add(versionEntry);
                 		stage = "complete";
                 		result.put("success",true);
                 		completeMessage = "LOI submitted to Legal and attached to the Contract.";
                 		if(missing.size() > 0)
                 		{
                 			completeMessage = "LOI submitted to Legal with " + missing.size().toString() + " missing field(s) flagged in the document: " + missing.toString(", ") + ".";
                 		}
                 		result.put("message",completeMessage);
                 		result.put("proformaId",pf.ID.toString());
                 		result.put("contractId",contractId.toString());
                 		result.put("contractVersionId",contractVersionId.toString());
                 		result.put("fileName",fileName);
                 		result.put("missing",missing);
                 		result.put("warnings",missing);
                 		result.put("contractUrl",zoho.appuri + "page-embed/Contract_Mgmt?contractId=" + contractId.toString());
                 		result.put("stage",stage);
                 		result.put("audit",trace);
                 		return result.toString();
                 	}	catch (e)
                 	{
                 		errorEntry = Map();
                 		errorEntry.put("level","error");
                 		errorEntry.put("stage",stage);
                 		errorEntry.put("message","Unhandled exception in Create_LOI_Contract");
                 		errorEntry.put("meta",{"error":e.message,"lineNo":e.lineNo,"proformaId":proformaId});
                 		trace.add(errorEntry);
                 		result.put("success",false);
                 		result.put("message","LOI submission failed during " + stage + " at line " + e.lineNo.toString() + ": " + e.message);
                 		result.put("stage",stage);
                 		result.put("error",e.message);
                 		result.put("errorLine",e.lineNo);
                 		result.put("audit",trace);
                 		return result.toString();
                 	}
                 	result.put("success",false);
                 	result.put("message","LOI submission ended without a response.");
                 	return result.toString();
                 }
				 void defaultFunction(Lots lotRecords)
                 {
                 	for each  lot in lotRecords
                 	{
                 		lot.Takedown_Queue=TRUE;
                 	}
                 }
				 string deleteBudgetAttachment(string budgetId, string attachmentId)
                 {
                 	/********* DELETE CHILD ATTACHMENT RECORD *********/
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vBudgetId == "" || vAttachmentId == "")
                 	{
                 		return "Missing Budget ID or attachment ID.";
                 	}
                 	attachmentRows = Attachment[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 	if(attachmentRows.count() == 0)
                 	{
                 		return "Attachment record was not found for this budget.";
                 	}
                 	try 
                 	{
                 		delete from Attachment[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 		return "Attachment deleted.";
                 	}	catch (deleteError)
                 	{
                 		return "Attachment deletion failed: " + deleteError.toString();
                 	}
                 	return "gj";
                 }
				 string deleteContractAttachment(string contractId, string attachmentId)
                 {
                 	response = Map();
                 	vContractId = ifnull(contractId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vContractId == "" || vAttachmentId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Contract ID or attachment ID.");
                 		return response.toString();
                 	}
                 	attachmentRows = Attachment[ID == vAttachmentId.toLong() && Contract1 == vContractId.toLong()];
                 	if(attachmentRows.count() == 0)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment record was not found for this Contract.");
                 		return response.toString();
                 	}
                 	contractRows = Contract[ID == vContractId.toLong()];
                 	if(contractRows.count() == 0 || ifnull(contractRows.Status,"").toString() == "Complete")
                 	{
                 		response.put("ok",false);
                 		response.put("message","This contract is unavailable or complete and read-only.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		delete from Attachment[ID == vAttachmentId.toLong() && Contract1 == vContractId.toLong()];
                 		response.put("ok",true);
                 		response.put("attachmentId",vAttachmentId);
                 		response.put("message","Attachment deleted.");
                 		return response.toString();
                 	}	catch (deleteError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment deletion failed: " + deleteError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment deletion ended without a response.");
                 	return response.toString();
                 }
				 string deleteProformaAttachment(string proformaId, string attachmentId)
                 {
                 	/********* DELETE ONE PRO FORMA ATTACHMENT CHILD RECORD *********/
                 	vProformaId = ifnull(proformaId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vProformaId == "" || vAttachmentId == "")
                 	{
                 		return "Missing Pro Forma ID or attachment ID.";
                 	}
                 	attachmentRows = Attachment[ID == vAttachmentId.toLong() && Pro_Forma == vProformaId.toLong()];
                 	if(attachmentRows.count() == 0)
                 	{
                 		return "Attachment record was not found for this Pro Forma.";
                 	}
                 	try 
                 	{
                 		delete from Attachment[ID == vAttachmentId.toLong() && Pro_Forma == vProformaId.toLong()];
                 		return "Attachment deleted.";
                 	}	catch (deleteError)
                 	{
                 		return "Attachment deletion failed: " + deleteError.toString();
                 	}
                 	return "xd";
                 }
				 string exportBudgetSnapshot(string budgetId, string exportType)
                 {
                 	/********* MANUAL BUDGET EXPORT ENTRY POINT *********/
                 	// Creates either a PDF or Excel-compatible .xls snapshot
                 	// using the budget's current saved values and creates one
                 	// Attachment record per exported attachment.
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vExportType = ifnull(exportType,"").trim().toUpperCase();
                 	if(vBudgetId == "")
                 	{
                 		return "Budget export failed: missing Budget ID.";
                 	}
                 	isApprovedExport = false;
                 	if(vExportType == "APPROVED_PDF")
                 	{
                 		isApprovedExport = true;
                 		vExportType = "PDF";
                 	}
                 	if(vExportType != "PDF" && vExportType != "EXCEL")
                 	{
                 		return "Budget export failed: unsupported export type " + vExportType + ".";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 	if(budgetRec == null)
                 	{
                 		return "Budget export failed: budget not found.";
                 	}
                 	try 
                 	{
                 		/********* COMMON BUDGET HEADER INFORMATION *********/
                 		budgetName = ifnull(budgetRec.Budget_Name,"Budget");
                 		projectName = ifnull(budgetRec.Project,"");
                 		phaseName = ifnull(budgetRec.Phase,"");
                 		subdivisionCode = ifnull(budgetRec.Subdivision_Code,"");
                 		subdivisionName = "";
                 		territoryText = "";
                 		if(budgetRec.Subdivision1 != null)
                 		{
                 			subdivisionName = ifnull(budgetRec.Subdivision1.Subdivision_Name,"");
                 			territoryText = ifnull(budgetRec.Subdivision1.Territory,"");
                 		}
                 		budgetLabel = budgetName;
                 		if(projectName != "" && phaseName != "")
                 		{
                 			budgetLabel = projectName + " - " + phaseName;
                 		}
                 		else if(subdivisionName != "")
                 		{
                 			budgetLabel = subdivisionName;
                 		}
                 		else if(projectName != "")
                 		{
                 			budgetLabel = projectName;
                 		}
                 		if(budgetName != "" && budgetName != budgetLabel)
                 		{
                 			budgetLabel = budgetLabel + " - " + budgetName;
                 		}
                 		grandFinal = 0.00;
                 		if(budgetRec.Budget_Grand_Total != null)
                 		{
                 			grandFinal = budgetRec.Budget_Grand_Total.toDecimal();
                 		}
                 		exportedDate = zoho.currenttime.toString("MM/dd/yyyy hh:mm a");
                 		safeFileName = budgetLabel;
                 		safeFileName = safeFileName.replaceAll("[^A-Za-z0-9_-]","_");
                 		safeFileName = safeFileName.replaceAll("_+","_");
                 		pdfDocumentTitle = "Budget Snapshot";
                 		pdfFilePrefix = "Budget_Export";
                 		if(isApprovedExport == true)
                 		{
                 			pdfDocumentTitle = "Approved Budget";
                 			pdfFilePrefix = "Approved_Budget";
                 		}
                 		/*********************************************************
                 		 * PDF EXPORT
                 		 *********************************************************/
                 		if(vExportType == "PDF")
                 		{
                 			budgetLabelSafe = budgetLabel;
                 			budgetLabelSafe = budgetLabelSafe.replaceAll("&","&amp;");
                 			budgetLabelSafe = budgetLabelSafe.replaceAll("<","&lt;");
                 			budgetLabelSafe = budgetLabelSafe.replaceAll(">","&gt;");
                 			subdivisionCodeSafe = subdivisionCode;
                 			subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("&","&amp;");
                 			subdivisionCodeSafe = subdivisionCodeSafe.replaceAll("<","&lt;");
                 			subdivisionCodeSafe = subdivisionCodeSafe.replaceAll(">","&gt;");
                 			territorySafe = territoryText;
                 			territorySafe = territorySafe.replaceAll("&","&amp;");
                 			territorySafe = territorySafe.replaceAll("<","&lt;");
                 			territorySafe = territorySafe.replaceAll(">","&gt;");
                 			grandFinalDisplay = grandFinal.text("$#,##0.00");
                 			pdfHtml = "";
                 			pdfHtml = pdfHtml + "<html>";
                 			pdfHtml = pdfHtml + "<head>";
                 			pdfHtml = pdfHtml + "<meta charset='UTF-8'>";
                 			pdfHtml = pdfHtml + "<style>";
                 			pdfHtml = pdfHtml + "@page{size:landscape;margin:0.45in;}";
                 			pdfHtml = pdfHtml + "*{box-sizing:border-box;}";
                 			pdfHtml = pdfHtml + "body{font-family:Arial,sans-serif;color:#172033;font-size:10px;margin:0;}";
                 			pdfHtml = pdfHtml + ".header{border-bottom:3px solid #163b6d;padding-bottom:12px;margin-bottom:14px;}";
                 			pdfHtml = pdfHtml + ".title{font-size:24px;font-weight:700;color:#102f55;margin-bottom:4px;}";
                 			pdfHtml = pdfHtml + ".subtitle{font-size:11px;color:#64748b;}";
                 			pdfHtml = pdfHtml + ".summary{width:100%;border-collapse:collapse;margin-bottom:18px;}";
                 			pdfHtml = pdfHtml + ".summary td{border:1px solid #d9e2ef;padding:9px 11px;vertical-align:top;}";
                 			pdfHtml = pdfHtml + ".label{font-size:8px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.08em;}";
                 			pdfHtml = pdfHtml + ".value{font-size:13px;font-weight:700;color:#102f55;margin-top:3px;}";
                 			pdfHtml = pdfHtml + ".grand{font-size:18px;color:#047857;}";
                 			pdfHtml = pdfHtml + ".category{margin:0 0 16px 0;page-break-inside:auto;}";
                 			pdfHtml = pdfHtml + ".category-title{background:#eaf1fb;border-left:5px solid #1e4f91;padding:8px 10px;font-size:13px;font-weight:700;color:#102f55;}";
                 			pdfHtml = pdfHtml + ".category-meta{float:right;font-size:10px;color:#475569;}";
                 			pdfHtml = pdfHtml + "table.lines{width:100%;border-collapse:collapse;table-layout:fixed;}";
                 			pdfHtml = pdfHtml + "table.lines thead{display:table-header-group;}";
                 			pdfHtml = pdfHtml + "table.lines th{background:#f3f6fa;border-bottom:1px solid #b8c6d9;padding:6px;text-align:right;font-size:8px;color:#52657d;text-transform:uppercase;}";
                 			pdfHtml = pdfHtml + "table.lines th:first-child,table.lines th:nth-child(2),table.lines th:last-child{text-align:left;}";
                 			pdfHtml = pdfHtml + "table.lines td{border-bottom:1px solid #e4eaf2;padding:6px;text-align:right;vertical-align:top;}";
                 			pdfHtml = pdfHtml + "table.lines td:first-child,table.lines td:nth-child(2),table.lines td:last-child{text-align:left;}";
                 			pdfHtml = pdfHtml + "table.lines tr{page-break-inside:avoid;}";
                 			pdfHtml = pdfHtml + ".code{color:#64748b;font-family:monospace;}";
                 			pdfHtml = pdfHtml + ".money{font-weight:600;white-space:nowrap;}";
                 			pdfHtml = pdfHtml + ".notes{color:#475569;font-size:9px;}";
                 			pdfHtml = pdfHtml + ".approval-title{margin-top:22px;padding-bottom:6px;border-bottom:2px solid #163b6d;font-size:15px;font-weight:700;color:#102f55;}";
                 			pdfHtml = pdfHtml + ".approval-table{width:100%;border-collapse:collapse;margin-top:8px;}";
                 			pdfHtml = pdfHtml + ".approval-table thead{display:table-header-group;}";
                 			pdfHtml = pdfHtml + ".approval-table th{background:#f3f6fa;text-align:left;padding:7px;border-bottom:1px solid #b8c6d9;font-size:8px;text-transform:uppercase;color:#52657d;}";
                 			pdfHtml = pdfHtml + ".approval-table td{padding:7px;border-bottom:1px solid #e4eaf2;vertical-align:top;}";
                 			pdfHtml = pdfHtml + ".approval-table tr{page-break-inside:avoid;}";
                 			pdfHtml = pdfHtml + ".footer-note{margin-top:18px;color:#64748b;font-size:8px;text-align:center;}";
                 			pdfHtml = pdfHtml + "</style>";
                 			pdfHtml = pdfHtml + "</head>";
                 			pdfHtml = pdfHtml + "<body>";
                 			pdfHtml = pdfHtml + "<div class='header'>";
                 			pdfHtml = pdfHtml + "<div class='title'>" + pdfDocumentTitle + "</div>";
                 			pdfHtml = pdfHtml + "<div class='subtitle'>" + budgetLabelSafe + "</div>";
                 			pdfHtml = pdfHtml + "</div>";
                 			pdfHtml = pdfHtml + "<table class='summary'><tr>";
                 			pdfHtml = pdfHtml + "<td><div class='label'>Budget</div><div class='value'>" + budgetLabelSafe + "</div></td>";
                 			pdfHtml = pdfHtml + "<td><div class='label'>Subdivision Code</div><div class='value'>" + subdivisionCodeSafe + "</div></td>";
                 			pdfHtml = pdfHtml + "<td><div class='label'>Territory</div><div class='value'>" + territorySafe + "</div></td>";
                 			pdfHtml = pdfHtml + "<td><div class='label'>Exported</div><div class='value'>" + exportedDate + "</div></td>";
                 			pdfHtml = pdfHtml + "<td><div class='label'>Current Final Budget</div><div class='value grand'>" + grandFinalDisplay + "</div></td>";
                 			pdfHtml = pdfHtml + "</tr></table>";
                 			budgetCategories = Budget_Category[Budget == vBudgetId.toLong()] sort by Category_Code;
                 			for each  cat in budgetCategories
                 			{
                 				categoryName = ifnull(cat.Budget_Category_Name,"Uncategorized");
                 				categoryCode = ifnull(cat.Category_Code,"");
                 				departmentName = ifnull(cat.Deparment,"");
                 				categoryNameSafe = categoryName;
                 				categoryNameSafe = categoryNameSafe.replaceAll("&","&amp;");
                 				categoryNameSafe = categoryNameSafe.replaceAll("<","&lt;");
                 				categoryNameSafe = categoryNameSafe.replaceAll(">","&gt;");
                 				categoryCodeSafe = categoryCode;
                 				categoryCodeSafe = categoryCodeSafe.replaceAll("&","&amp;");
                 				categoryCodeSafe = categoryCodeSafe.replaceAll("<","&lt;");
                 				categoryCodeSafe = categoryCodeSafe.replaceAll(">","&gt;");
                 				departmentSafe = departmentName;
                 				departmentSafe = departmentSafe.replaceAll("&","&amp;");
                 				departmentSafe = departmentSafe.replaceAll("<","&lt;");
                 				departmentSafe = departmentSafe.replaceAll(">","&gt;");
                 				categoryFinal = 0.00;
                 				if(cat.Budget_Total != null)
                 				{
                 					categoryFinal = cat.Budget_Total.toDecimal();
                 				}
                 				categoryFinalDisplay = categoryFinal.text("$#,##0.00");
                 				pdfHtml = pdfHtml + "<div class='category'>";
                 				pdfHtml = pdfHtml + "<div class='category-title'>";
                 				pdfHtml = pdfHtml + categoryCodeSafe + " &nbsp; " + categoryNameSafe;
                 				pdfHtml = pdfHtml + "<span class='category-meta'>" + departmentSafe + " &nbsp; | &nbsp; Final: " + categoryFinalDisplay + "</span>";
                 				pdfHtml = pdfHtml + "</div>";
                 				pdfHtml = pdfHtml + "<table class='lines'>";
                 				pdfHtml = pdfHtml + "<thead><tr>";
                 				if(isApprovedExport == false)
                 				{
                 					pdfHtml = pdfHtml + "<th style='width:7%;'>Code</th>";
                 					pdfHtml = pdfHtml + "<th style='width:20%;'>Budget Item</th>";
                 					pdfHtml = pdfHtml + "<th style='width:6%;text-align:left;'>Unit</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>Cost per Unit</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>Preliminary</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>Unapproved</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>Final</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>HCSS Actuals</th>";
                 					pdfHtml = pdfHtml + "<th style='width:9%;'>GP Actuals</th>";
                 					pdfHtml = pdfHtml + "<th style='width:13%;'>Notes</th>";
                 				}
                 				else
                 				{
                 					pdfHtml = pdfHtml + "<th style='width:8%;'>Code</th>";
                 					pdfHtml = pdfHtml + "<th style='width:22%;'>Budget Item</th>";
                 					pdfHtml = pdfHtml + "<th style='width:11%;'>Preliminary</th>";
                 					pdfHtml = pdfHtml + "<th style='width:11%;'>Unapproved</th>";
                 					pdfHtml = pdfHtml + "<th style='width:11%;'>Final</th>";
                 					pdfHtml = pdfHtml + "<th style='width:11%;'>HCSS Actuals</th>";
                 					pdfHtml = pdfHtml + "<th style='width:11%;'>GP Actuals</th>";
                 					pdfHtml = pdfHtml + "<th style='width:15%;'>Notes</th>";
                 				}
                 				pdfHtml = pdfHtml + "</tr></thead><tbody>";
                 				categoryItems = Budget_Item[Budget_Category == cat.ID] sort by Cost_Code;
                 				for each  item in categoryItems
                 				{
                 					itemName = ifnull(item.Item_Name,"Budget Item");
                 					itemCode = ifnull(item.Cost_Code,"");
                 					itemNameSafe = itemName;
                 					itemNameSafe = itemNameSafe.replaceAll("&","&amp;");
                 					itemNameSafe = itemNameSafe.replaceAll("<","&lt;");
                 					itemNameSafe = itemNameSafe.replaceAll(">","&gt;");
                 					itemCodeSafe = itemCode;
                 					itemCodeSafe = itemCodeSafe.replaceAll("&","&amp;");
                 					itemCodeSafe = itemCodeSafe.replaceAll("<","&lt;");
                 					itemCodeSafe = itemCodeSafe.replaceAll(">","&gt;");
                 					if(isApprovedExport == false)
                 					{
                 						unitSafe = ifnull(item.Unit,"");
                 						unitSafe = unitSafe.replaceAll("&","&amp;");
                 						unitSafe = unitSafe.replaceAll("<","&lt;");
                 						unitSafe = unitSafe.replaceAll(">","&gt;");
                 						perUnitDisplay = "";
                 						if(item.Per_Unit != null)
                 						{
                 							perUnitDisplay = item.Per_Unit.toDecimal().text("$#,##0.00");
                 						}
                 					}
                 					itemNote = ifnull(item.Description,"");
                 					itemNote = itemNote.replaceAll("<br>","\n");
                 					itemNote = itemNote.replaceAll("<br/>","\n");
                 					itemNote = itemNote.replaceAll("<br />","\n");
                 					itemNote = itemNote.replaceAll("&","&amp;");
                 					itemNote = itemNote.replaceAll("<","&lt;");
                 					itemNote = itemNote.replaceAll(">","&gt;");
                 					itemNote = itemNote.replaceAll("\r\n","\n");
                 					itemNote = itemNote.replaceAll("\r","\n");
                 					itemNote = itemNote.replaceAll("\n","<br>");
                 					prelimValue = 0.00;
                 					unapprovedValue = 0.00;
                 					finalValue = 0.00;
                 					hcssValue = 0.00;
                 					gpValue = 0.00;
                 					if(item.Prelim_Budget_Ttl != null)
                 					{
                 						prelimValue = item.Prelim_Budget_Ttl.toDecimal();
                 					}
                 					if(item.Unapproved_Final_Budget_Ttl != null)
                 					{
                 						unapprovedValue = item.Unapproved_Final_Budget_Ttl.toDecimal();
                 					}
                 					if(item.Budget_Ttl != null)
                 					{
                 						finalValue = item.Budget_Ttl.toDecimal();
                 					}
                 					if(item.HCSS_Actuals != null)
                 					{
                 						hcssValue = item.HCSS_Actuals.toDecimal();
                 					}
                 					if(item.PROJ_Actual != null)
                 					{
                 						gpValue = item.PROJ_Actual.toDecimal();
                 					}
                 					prelimDisplay = prelimValue.text("$#,##0.00");
                 					unapprovedDisplay = unapprovedValue.text("$#,##0.00");
                 					finalDisplay = finalValue.text("$#,##0.00");
                 					hcssDisplay = hcssValue.text("$#,##0.00");
                 					gpDisplay = gpValue.text("$#,##0.00");
                 					pdfHtml = pdfHtml + "<tr>";
                 					pdfHtml = pdfHtml + "<td class='code'>" + itemCodeSafe + "</td>";
                 					pdfHtml = pdfHtml + "<td>" + itemNameSafe + "</td>";
                 					if(isApprovedExport == false)
                 					{
                 						pdfHtml = pdfHtml + "<td style='text-align:left;'>" + unitSafe + "</td>";
                 						pdfHtml = pdfHtml + "<td class='money'>" + perUnitDisplay + "</td>";
                 					}
                 					pdfHtml = pdfHtml + "<td class='money'>" + prelimDisplay + "</td>";
                 					pdfHtml = pdfHtml + "<td class='money'>" + unapprovedDisplay + "</td>";
                 					pdfHtml = pdfHtml + "<td class='money'>" + finalDisplay + "</td>";
                 					pdfHtml = pdfHtml + "<td class='money'>" + hcssDisplay + "</td>";
                 					pdfHtml = pdfHtml + "<td class='money'>" + gpDisplay + "</td>";
                 					pdfHtml = pdfHtml + "<td class='notes'>" + itemNote + "</td>";
                 					pdfHtml = pdfHtml + "</tr>";
                 				}
                 				pdfHtml = pdfHtml + "</tbody></table></div>";
                 			}
                 			pdfHtml = pdfHtml + "<div class='approval-title'>Approval History</div>";
                 			pdfHtml = pdfHtml + "<table class='approval-table'>";
                 			pdfHtml = pdfHtml + "<thead><tr>";
                 			pdfHtml = pdfHtml + "<th>Track</th><th>Role</th><th>Approver</th><th>Status</th><th>Responded</th><th>Approval Notes</th>";
                 			pdfHtml = pdfHtml + "</tr></thead><tbody>";
                 			allApprovalRows = Budget_Approvals[Budget == vBudgetId.toLong()] sort by Sort_Order;
                 			for each  approvalRow in allApprovalRows
                 			{
                 				approvalTrackSafe = ifnull(approvalRow.Type1,"");
                 				approvalTrackSafe = approvalTrackSafe.replaceAll("&","&amp;");
                 				approvalTrackSafe = approvalTrackSafe.replaceAll("<","&lt;");
                 				approvalTrackSafe = approvalTrackSafe.replaceAll(">","&gt;");
                 				approvalRoleSafe = ifnull(approvalRow.Title,"");
                 				approvalRoleSafe = approvalRoleSafe.replaceAll("&","&amp;");
                 				approvalRoleSafe = approvalRoleSafe.replaceAll("<","&lt;");
                 				approvalRoleSafe = approvalRoleSafe.replaceAll(">","&gt;");
                 				approvalEmailSafe = ifnull(approvalRow.Approver,"");
                 				approvalEmailSafe = approvalEmailSafe.replaceAll("&","&amp;");
                 				approvalEmailSafe = approvalEmailSafe.replaceAll("<","&lt;");
                 				approvalEmailSafe = approvalEmailSafe.replaceAll(">","&gt;");
                 				approvalStatusSafe = ifnull(approvalRow.Status,"");
                 				approvalStatusSafe = approvalStatusSafe.replaceAll("&","&amp;");
                 				approvalStatusSafe = approvalStatusSafe.replaceAll("<","&lt;");
                 				approvalStatusSafe = approvalStatusSafe.replaceAll(">","&gt;");
                 				approvalNotes = ifnull(approvalRow.Approval_Notes,"");
                 				approvalNotes = approvalNotes.replaceAll("<br>","\n");
                 				approvalNotes = approvalNotes.replaceAll("<br/>","\n");
                 				approvalNotes = approvalNotes.replaceAll("<br />","\n");
                 				approvalNotes = approvalNotes.replaceAll("&","&amp;");
                 				approvalNotes = approvalNotes.replaceAll("<","&lt;");
                 				approvalNotes = approvalNotes.replaceAll(">","&gt;");
                 				approvalNotes = approvalNotes.replaceAll("\r\n","\n");
                 				approvalNotes = approvalNotes.replaceAll("\r","\n");
                 				approvalNotes = approvalNotes.replaceAll("\n","<br>");
                 				respondedText = "";
                 				if(approvalRow.Responded_Date != null)
                 				{
                 					respondedText = approvalRow.Responded_Date.toString("MM/dd/yyyy");
                 				}
                 				pdfHtml = pdfHtml + "<tr>";
                 				pdfHtml = pdfHtml + "<td>" + approvalTrackSafe + "</td>";
                 				pdfHtml = pdfHtml + "<td>" + approvalRoleSafe + "</td>";
                 				pdfHtml = pdfHtml + "<td>" + approvalEmailSafe + "</td>";
                 				pdfHtml = pdfHtml + "<td>" + approvalStatusSafe + "</td>";
                 				pdfHtml = pdfHtml + "<td>" + respondedText + "</td>";
                 				pdfHtml = pdfHtml + "<td>" + approvalNotes + "</td>";
                 				pdfHtml = pdfHtml + "</tr>";
                 			}
                 			pdfHtml = pdfHtml + "</tbody></table>";
                 			pdfHtml = pdfHtml + "<div class='footer-note'>Generated automatically by Land Master from the current saved budget values.</div>";
                 			pdfHtml = pdfHtml + "</body></html>";
                 			pdfOptions = Collection();
                 			pdfOptions.insert("landscape":true);
                 			pdfOptions.insert("units":"in");
                 			pdfOptions.insert("page-width":11);
                 			pdfOptions.insert("page-height":8.5);
                 			pdfOptions.insert("top-margin":0.35);
                 			pdfOptions.insert("bottom-margin":0.45);
                 			pdfOptions.insert("left-margin":0.35);
                 			pdfOptions.insert("right-margin":0.35);
                 			pdfOptions.insert("print-background":true);
                 			pdfOptions.insert("auto-shrink":true);
                 			pdfOptions.insert("page-number":"footer");
                 			pdfOptions.insert("page-number-location":"right");
                 			pdfOptions.insert("mask-html":true);
                 			pdfFile = zoho.file.convertToPDF(pdfHtml,pdfOptions);
                 			if(pdfFile == null)
                 			{
                 				return "Budget PDF generation failed: convertToPDF returned null.";
                 			}
                 			if(pdfFile.isFile() != true)
                 			{
                 				return "Budget PDF generation failed: convertToPDF did not return a valid file.";
                 			}
                 			fileName = pdfFilePrefix + "_" + safeFileName + "_" + zoho.currenttime.toString("yyyyMMdd_HHmmss") + ".pdf";
                 			pdfFile.setFileName(fileName);
                 			/********* CREATE ONE ATTACHMENT RECORD *********/
                 			attachmentId = insert into Attachment
                 			[
                 				Budget=vBudgetId.toLong()
                 				Date_field1=zoho.currenttime
                 				Email_Attachment=false
                 				File_field1=pdfFile
                 				Added_User=zoho.loginuser
                 			];
                 			if(attachmentId == null || attachmentId == 0)
                 			{
                 				return "Budget PDF was generated, but the Attachment attachment record was not created.";
                 			}
                 			return "Budget PDF added to Attachments as " + fileName + ".";
                 		}
                 		/*********************************************************
                 		 * EXCEL EXPORT
                 		 *********************************************************/
                 		budgetLabelXml = budgetLabel;
                 		budgetLabelXml = budgetLabelXml.replaceAll("&","&amp;");
                 		budgetLabelXml = budgetLabelXml.replaceAll("<","&lt;");
                 		budgetLabelXml = budgetLabelXml.replaceAll(">","&gt;");
                 		budgetLabelXml = budgetLabelXml.replaceAll("\"","&quot;");
                 		budgetLabelXml = budgetLabelXml.replaceAll("'","&apos;");
                 		subdivisionCodeXml = subdivisionCode;
                 		subdivisionCodeXml = subdivisionCodeXml.replaceAll("&","&amp;");
                 		subdivisionCodeXml = subdivisionCodeXml.replaceAll("<","&lt;");
                 		subdivisionCodeXml = subdivisionCodeXml.replaceAll(">","&gt;");
                 		subdivisionCodeXml = subdivisionCodeXml.replaceAll("\"","&quot;");
                 		subdivisionCodeXml = subdivisionCodeXml.replaceAll("'","&apos;");
                 		territoryXml = territoryText;
                 		territoryXml = territoryXml.replaceAll("&","&amp;");
                 		territoryXml = territoryXml.replaceAll("<","&lt;");
                 		territoryXml = territoryXml.replaceAll(">","&gt;");
                 		territoryXml = territoryXml.replaceAll("\"","&quot;");
                 		territoryXml = territoryXml.replaceAll("'","&apos;");
                 		excelXml = "";
                 		excelXml = excelXml + "<?xml version='1.0'?>";
                 		excelXml = excelXml + "<?mso-application progid='Excel.Sheet'?>";
                 		excelXml = excelXml + "<Workbook xmlns='urn:schemas-microsoft-com:office:spreadsheet' xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:x='urn:schemas-microsoft-com:office:excel' xmlns:ss='urn:schemas-microsoft-com:office:spreadsheet'>";
                 		excelXml = excelXml + "<Styles>";
                 		excelXml = excelXml + "<Style ss:ID='Default' ss:Name='Normal'><Alignment ss:Vertical='Bottom'/><Borders/><Font ss:FontName='Calibri' ss:Size='11'/><Interior/><NumberFormat/><Protection/></Style>";
                 		excelXml = excelXml + "<Style ss:ID='Title'><Font ss:FontName='Calibri' ss:Size='18' ss:Bold='1' ss:Color='#17385F'/></Style>";
                 		excelXml = excelXml + "<Style ss:ID='Header'><Font ss:Bold='1' ss:Color='#17385F'/><Interior ss:Color='#EAF1FB' ss:Pattern='Solid'/><Borders><Border ss:Position='Bottom' ss:LineStyle='Continuous' ss:Weight='1' ss:Color='#AAB9CC'/></Borders></Style>";
                 		excelXml = excelXml + "<Style ss:ID='Money'><NumberFormat ss:Format='$#,##0.00;[Red]-$#,##0.00'/></Style>";
                 		excelXml = excelXml + "<Style ss:ID='Wrap'><Alignment ss:Vertical='Top' ss:WrapText='1'/></Style>";
                 		excelXml = excelXml + "</Styles>";
                 		/********* SUMMARY WORKSHEET *********/
                 		excelXml = excelXml + "<Worksheet ss:Name='Summary'><Table>";
                 		excelXml = excelXml + "<Column ss:Width='150'/><Column ss:Width='320'/>";
                 		excelXml = excelXml + "<Row><Cell ss:MergeAcross='1' ss:StyleID='Title'><Data ss:Type='String'>Budget Export</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell ss:StyleID='Header'><Data ss:Type='String'>Field</Data></Cell><Cell ss:StyleID='Header'><Data ss:Type='String'>Value</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell><Data ss:Type='String'>Budget</Data></Cell><Cell><Data ss:Type='String'>" + budgetLabelXml + "</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell><Data ss:Type='String'>Subdivision Code</Data></Cell><Cell><Data ss:Type='String'>" + subdivisionCodeXml + "</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell><Data ss:Type='String'>Territory</Data></Cell><Cell><Data ss:Type='String'>" + territoryXml + "</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell><Data ss:Type='String'>Exported</Data></Cell><Cell><Data ss:Type='String'>" + exportedDate + "</Data></Cell></Row>";
                 		excelXml = excelXml + "<Row><Cell><Data ss:Type='String'>Current Final Budget</Data></Cell><Cell ss:StyleID='Money'><Data ss:Type='Number'>" + grandFinal + "</Data></Cell></Row>";
                 		excelXml = excelXml + "</Table></Worksheet>";
                 		/********* BUDGET DETAIL WORKSHEET *********/
                 		excelXml = excelXml + "<Worksheet ss:Name='Budget Detail'><Table>";
                 		excelXml = excelXml + "<Column ss:Width='110'/><Column ss:Width='80'/><Column ss:Width='180'/><Column ss:Width='80'/><Column ss:Width='220'/><Column ss:Width='65'/><Column ss:Width='100'/><Column ss:Width='95'/><Column ss:Width='95'/><Column ss:Width='95'/><Column ss:Width='95'/><Column ss:Width='95'/><Column ss:Width='260'/>";
                 		excelXml = excelXml + "<Row ss:StyleID='Header'>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Department</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Category Code</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Category</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Cost Code</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Budget Item</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Unit</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Cost per Unit</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Preliminary</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Unapproved</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Final</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>HCSS Actuals</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>GP Actuals</Data></Cell>";
                 		excelXml = excelXml + "<Cell><Data ss:Type='String'>Notes</Data></Cell>";
                 		excelXml = excelXml + "</Row>";
                 		budgetCategories = Budget_Category[Budget == vBudgetId.toLong()] sort by Category_Code;
                 		for each  cat in budgetCategories
                 		{
                 			departmentXml = ifnull(cat.Deparment,"");
                 			departmentXml = departmentXml.replaceAll("&","&amp;");
                 			departmentXml = departmentXml.replaceAll("<","&lt;");
                 			departmentXml = departmentXml.replaceAll(">","&gt;");
                 			departmentXml = departmentXml.replaceAll("\"","&quot;");
                 			departmentXml = departmentXml.replaceAll("'","&apos;");
                 			categoryCodeXml = ifnull(cat.Category_Code,"");
                 			categoryCodeXml = categoryCodeXml.replaceAll("&","&amp;");
                 			categoryCodeXml = categoryCodeXml.replaceAll("<","&lt;");
                 			categoryCodeXml = categoryCodeXml.replaceAll(">","&gt;");
                 			categoryCodeXml = categoryCodeXml.replaceAll("\"","&quot;");
                 			categoryCodeXml = categoryCodeXml.replaceAll("'","&apos;");
                 			categoryNameXml = ifnull(cat.Budget_Category_Name,"Uncategorized");
                 			categoryNameXml = categoryNameXml.replaceAll("&","&amp;");
                 			categoryNameXml = categoryNameXml.replaceAll("<","&lt;");
                 			categoryNameXml = categoryNameXml.replaceAll(">","&gt;");
                 			categoryNameXml = categoryNameXml.replaceAll("\"","&quot;");
                 			categoryNameXml = categoryNameXml.replaceAll("'","&apos;");
                 			categoryItems = Budget_Item[Budget_Category == cat.ID] sort by Cost_Code;
                 			for each  item in categoryItems
                 			{
                 				itemCodeXml = ifnull(item.Cost_Code,"");
                 				itemCodeXml = itemCodeXml.replaceAll("&","&amp;");
                 				itemCodeXml = itemCodeXml.replaceAll("<","&lt;");
                 				itemCodeXml = itemCodeXml.replaceAll(">","&gt;");
                 				itemCodeXml = itemCodeXml.replaceAll("\"","&quot;");
                 				itemCodeXml = itemCodeXml.replaceAll("'","&apos;");
                 				itemNameXml = ifnull(item.Item_Name,"Budget Item");
                 				itemNameXml = itemNameXml.replaceAll("&","&amp;");
                 				itemNameXml = itemNameXml.replaceAll("<","&lt;");
                 				itemNameXml = itemNameXml.replaceAll(">","&gt;");
                 				itemNameXml = itemNameXml.replaceAll("\"","&quot;");
                 				itemNameXml = itemNameXml.replaceAll("'","&apos;");
                 				unitXml = ifnull(item.Unit,"");
                 				unitXml = unitXml.replaceAll("&","&amp;");
                 				unitXml = unitXml.replaceAll("<","&lt;");
                 				unitXml = unitXml.replaceAll(">","&gt;");
                 				unitXml = unitXml.replaceAll("\"","&quot;");
                 				unitXml = unitXml.replaceAll("'","&apos;");
                 				perUnitPriceCellXml = "<Cell/>";
                 				if(item.Per_Unit != null)
                 				{
                 					perUnitPriceCellXml = "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + item.Per_Unit.toDecimal() + "</Data></Cell>";
                 				}
                 				itemNoteXml = ifnull(item.Description,"");
                 				itemNoteXml = itemNoteXml.replaceAll("<br>","\n");
                 				itemNoteXml = itemNoteXml.replaceAll("<br/>","\n");
                 				itemNoteXml = itemNoteXml.replaceAll("<br />","\n");
                 				itemNoteXml = itemNoteXml.replaceAll("&","&amp;");
                 				itemNoteXml = itemNoteXml.replaceAll("<","&lt;");
                 				itemNoteXml = itemNoteXml.replaceAll(">","&gt;");
                 				itemNoteXml = itemNoteXml.replaceAll("\"","&quot;");
                 				itemNoteXml = itemNoteXml.replaceAll("'","&apos;");
                 				prelimValue = 0.00;
                 				unapprovedValue = 0.00;
                 				finalValue = 0.00;
                 				hcssValue = 0.00;
                 				gpValue = 0.00;
                 				if(item.Prelim_Budget_Ttl != null)
                 				{
                 					prelimValue = item.Prelim_Budget_Ttl.toDecimal();
                 				}
                 				if(item.Unapproved_Final_Budget_Ttl != null)
                 				{
                 					unapprovedValue = item.Unapproved_Final_Budget_Ttl.toDecimal();
                 				}
                 				if(item.Budget_Ttl != null)
                 				{
                 					finalValue = item.Budget_Ttl.toDecimal();
                 				}
                 				if(item.HCSS_Actuals != null)
                 				{
                 					hcssValue = item.HCSS_Actuals.toDecimal();
                 				}
                 				if(item.PROJ_Actual != null)
                 				{
                 					gpValue = item.PROJ_Actual.toDecimal();
                 				}
                 				excelXml = excelXml + "<Row>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + departmentXml + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + categoryCodeXml + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + categoryNameXml + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + itemCodeXml + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + itemNameXml + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell><Data ss:Type='String'>" + unitXml + "</Data></Cell>";
                 				excelXml = excelXml + perUnitPriceCellXml;
                 				excelXml = excelXml + "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + prelimValue + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + unapprovedValue + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + finalValue + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + hcssValue + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell ss:StyleID='Money'><Data ss:Type='Number'>" + gpValue + "</Data></Cell>";
                 				excelXml = excelXml + "<Cell ss:StyleID='Wrap'><Data ss:Type='String'>" + itemNoteXml + "</Data></Cell>";
                 				excelXml = excelXml + "</Row>";
                 			}
                 		}
                 		excelXml = excelXml + "</Table><WorksheetOptions xmlns='urn:schemas-microsoft-com:office:excel'><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet>";
                 		/********* APPROVAL HISTORY WORKSHEET *********/
                 		excelXml = excelXml + "<Worksheet ss:Name='Approval History'><Table>";
                 		excelXml = excelXml + "<Column ss:Width='110'/><Column ss:Width='80'/><Column ss:Width='220'/><Column ss:Width='90'/><Column ss:Width='110'/><Column ss:Width='320'/>";
                 		excelXml = excelXml + "<Row ss:StyleID='Header'><Cell><Data ss:Type='String'>Track</Data></Cell><Cell><Data ss:Type='String'>Role</Data></Cell><Cell><Data ss:Type='String'>Approver</Data></Cell><Cell><Data ss:Type='String'>Status</Data></Cell><Cell><Data ss:Type='String'>Responded</Data></Cell><Cell><Data ss:Type='String'>Approval Notes</Data></Cell></Row>";
                 		allApprovalRows = Budget_Approvals[Budget == vBudgetId.toLong()] sort by Sort_Order;
                 		for each  approvalRow in allApprovalRows
                 		{
                 			approvalTrackXml = ifnull(approvalRow.Type1,"");
                 			approvalTrackXml = approvalTrackXml.replaceAll("&","&amp;");
                 			approvalTrackXml = approvalTrackXml.replaceAll("<","&lt;");
                 			approvalTrackXml = approvalTrackXml.replaceAll(">","&gt;");
                 			approvalTrackXml = approvalTrackXml.replaceAll("\"","&quot;");
                 			approvalTrackXml = approvalTrackXml.replaceAll("'","&apos;");
                 			approvalRoleXml = ifnull(approvalRow.Title,"");
                 			approvalRoleXml = approvalRoleXml.replaceAll("&","&amp;");
                 			approvalRoleXml = approvalRoleXml.replaceAll("<","&lt;");
                 			approvalRoleXml = approvalRoleXml.replaceAll(">","&gt;");
                 			approvalRoleXml = approvalRoleXml.replaceAll("\"","&quot;");
                 			approvalRoleXml = approvalRoleXml.replaceAll("'","&apos;");
                 			approvalEmailXml = ifnull(approvalRow.Approver,"");
                 			approvalEmailXml = approvalEmailXml.replaceAll("&","&amp;");
                 			approvalEmailXml = approvalEmailXml.replaceAll("<","&lt;");
                 			approvalEmailXml = approvalEmailXml.replaceAll(">","&gt;");
                 			approvalEmailXml = approvalEmailXml.replaceAll("\"","&quot;");
                 			approvalEmailXml = approvalEmailXml.replaceAll("'","&apos;");
                 			approvalStatusXml = ifnull(approvalRow.Status,"");
                 			approvalStatusXml = approvalStatusXml.replaceAll("&","&amp;");
                 			approvalStatusXml = approvalStatusXml.replaceAll("<","&lt;");
                 			approvalStatusXml = approvalStatusXml.replaceAll(">","&gt;");
                 			approvalStatusXml = approvalStatusXml.replaceAll("\"","&quot;");
                 			approvalStatusXml = approvalStatusXml.replaceAll("'","&apos;");
                 			approvalNotesXml = ifnull(approvalRow.Approval_Notes,"");
                 			approvalNotesXml = approvalNotesXml.replaceAll("<br>","\n");
                 			approvalNotesXml = approvalNotesXml.replaceAll("<br/>","\n");
                 			approvalNotesXml = approvalNotesXml.replaceAll("<br />","\n");
                 			approvalNotesXml = approvalNotesXml.replaceAll("&","&amp;");
                 			approvalNotesXml = approvalNotesXml.replaceAll("<","&lt;");
                 			approvalNotesXml = approvalNotesXml.replaceAll(">","&gt;");
                 			approvalNotesXml = approvalNotesXml.replaceAll("\"","&quot;");
                 			approvalNotesXml = approvalNotesXml.replaceAll("'","&apos;");
                 			respondedText = "";
                 			if(approvalRow.Responded_Date != null)
                 			{
                 				respondedText = approvalRow.Responded_Date.toString("MM/dd/yyyy");
                 			}
                 			excelXml = excelXml + "<Row>";
                 			excelXml = excelXml + "<Cell><Data ss:Type='String'>" + approvalTrackXml + "</Data></Cell>";
                 			excelXml = excelXml + "<Cell><Data ss:Type='String'>" + approvalRoleXml + "</Data></Cell>";
                 			excelXml = excelXml + "<Cell><Data ss:Type='String'>" + approvalEmailXml + "</Data></Cell>";
                 			excelXml = excelXml + "<Cell><Data ss:Type='String'>" + approvalStatusXml + "</Data></Cell>";
                 			excelXml = excelXml + "<Cell><Data ss:Type='String'>" + respondedText + "</Data></Cell>";
                 			excelXml = excelXml + "<Cell ss:StyleID='Wrap'><Data ss:Type='String'>" + approvalNotesXml + "</Data></Cell>";
                 			excelXml = excelXml + "</Row>";
                 		}
                 		excelXml = excelXml + "</Table></Worksheet>";
                 		excelXml = excelXml + "</Workbook>";
                 		fileName = "Budget_Export_" + safeFileName + "_" + zoho.currenttime.toString("yyyyMMdd_HHmmss") + ".xls";
                 		excelFile = excelXml.toFile(fileName);
                 		if(excelFile == null)
                 		{
                 			return "Budget Excel export failed: toFile returned null.";
                 		}
                 		if(excelFile.isFile() != true)
                 		{
                 			return "Budget Excel export failed: toFile did not return a valid file.";
                 		}
                 		/********* CREATE ONE ATTACHMENT RECORD *********/
                 		attachmentId = insert into Attachment
                 		[
                 			Budget=vBudgetId.toLong()
                 			Date_field1=zoho.currenttime
                 			Email_Attachment=false
                 			File_field1=excelFile
                 			Added_User=zoho.loginuser
                 		];
                 		if(attachmentId == null || attachmentId == 0)
                 		{
                 			return "Budget Excel file was generated, but the Attachment attachment record was not created.";
                 		}
                 		return "Budget Excel file added to Attachments as " + fileName + ".";
                 	}	catch (exportError)
                 	{
                 		return "Budget export failed: " + exportError.toString();
                 	}
                 	return "gj";
                 }
				 string forecastManagerWidget(string payload)
                 {
                 	response = Map();
                 	response.put("ok",false);
                 	writeStarted = false;
                 	try 
                 	{
                 		// Configure the Custom API for OAuth2 and the existing Forecast Manager audience.
                 		// Never accept an actor or an environment supplied inside the request payload.
                 		if(zoho.loginuser == null || zoho.loginuser == "" || zoho.loginuser == "public")
                 		{
                 			response.put("message","An authenticated Creator session is required.");
                 			return response.toString();
                 		}
                 		request = payload.toMap();
                 		action = ifnull(request.get("action"),"").toString();
                 		response.put("action",action);
                 		response.put("today",zoho.currentdate.toString("yyyy-MM-dd"));
                 		forecastWindowOpen = false;
                 		settingsList = Settings[ID != 0].Open_Forecasting_Window.getAll();
                 		if(settingsList != null && !settingsList.isEmpty())
                 		{
                 			forecastWindowOpen = settingsList.get(0);
                 		}
                 		response.put("windowOpen",forecastWindowOpen == true);
                 		if(action == "catalog")
                 		{
                 			subdivisionChoices = List();
                 			for each  subChoice in Subdivision[ID != 0] sort by Subdivision_Name
                 			{
                 				choice = Map();
                 				choice.put("id",subChoice.ID.toString());
                 				choice.put("name",ifnull(subChoice.Subdivision_Name,""));
                 				choice.put("code",ifnull(subChoice.Subdivision_Code,""));
                 				subdivisionChoices.add(choice);
                 			}
                 			builderChoices = List();
                 			for each  builderChoice in Builder[ID != 0] sort by Builder_Name
                 			{
                 				choice = Map();
                 				choice.put("id",builderChoice.ID.toString());
                 				choice.put("name",ifnull(builderChoice.Builder_Name,""));
                 				choice.put("type",ifnull(builderChoice.Type1,""));
                 				builderChoices.add(choice);
                 			}
                 			response.put("subdivisions",subdivisionChoices);
                 			response.put("builders",builderChoices);
                 			response.put("ok",true);
                 			return response.toString();
                 		}
                 		if(action != "snapshot" && action != "save" && action != "ensure")
                 		{
                 			response.put("message","Unknown forecast action.");
                 			return response.toString();
                 		}
                 		subdivisionId = ifnull(request.get("subdivisionId"),"").toString().toLong();
                 		subdiv = Subdivision[ID == subdivisionId];
                 		if(subdiv.count() != 1)
                 		{
                 			response.put("message","The subdivision is unavailable.");
                 			return response.toString();
                 		}
                 		monthNames = {"February","March","April","May","June","July","August","September","October","November","December","January"};
                 		if(action == "save")
                 		{
                 			forecastId = ifnull(request.get("forecastId"),"").toString().toLong();
                 			fc = Forecast[ID == forecastId && Subdivision1 == subdivisionId && Delete_me != true];
                 			if(fc.count() != 1 || fc.Forecast_Year2 == null)
                 			{
                 				response.put("message","The forecast month is unavailable. Refresh forecasts.");
                 				return response.toString();
                 			}
                 			parent = Forecast_Year[ID == fc.Forecast_Year2 && Subdivision1 == subdivisionId && Status == "Builder"];
                 			if(parent.count() != 1 || parent.Builder1 != fc.Builder1 || parent.Forecast_Year != fc.Forecast_Year)
                 			{
                 				response.put("message","The forecast relationships need review.");
                 				return response.toString();
                 			}
                 			parentMatches = Forecast_Year[Subdivision1 == subdivisionId && Builder1 == parent.Builder1 && Forecast_Year == parent.Forecast_Year];
                 			if(parentMatches.count() != 1)
                 			{
                 				response.put("message","Duplicate forecast years need review.");
                 				return response.toString();
                 			}
                 			// Exact Forecast_Manager FEB...JAN on-user-input guards, in their original order.
                 			if(forecastWindowOpen != true)
                 			{
                 				response.put("message","Forecasting window closed for the month.");
                 				return response.toString();
                 			}
                 			if(fc.Forecast_Start_Date == null)
                 			{
                 				response.put("message","Forecast dates need review.");
                 				return response.toString();
                 			}
                 			if(fc.Forecast_Start_Date.addDay(28) < zoho.currentdate)
                 			{
                 				response.put("message","Past forecasts cannot be edited.");
                 				return response.toString();
                 			}
                 			monthRecognized = false;
                 			for each index monthIndex in monthNames
                 			{
                 				monthName = monthNames.get(monthIndex);
                 				if(ifnull(fc.Forecast_Month,"").toUpperCase() == monthName.toUpperCase() || ifnull(fc.Forecast_Month,"").toUpperCase() == monthName.subString(0,3).toUpperCase())
                 				{
                 					monthRecognized = true;
                 					expectedDate = ("02/01/" + parent.Forecast_Year).toDate("MM/dd/yyyy").addMonth(monthIndex);
                 					monthDuplicates = 0;
                 					for each  sibling in Forecast[Forecast_Year2 == parent.ID && Delete_me != true]
                 					{
                 						if(ifnull(sibling.Forecast_Month,"").toUpperCase() == monthName.toUpperCase() || ifnull(sibling.Forecast_Month,"").toUpperCase() == monthName.subString(0,3).toUpperCase())
                 						{
                 							monthDuplicates = monthDuplicates + 1;
                 						}
                 					}
                 					if(fc.Forecast_Start_Date != expectedDate || monthDuplicates != 1)
                 					{
                 						response.put("message","Forecast dates or duplicate months need review.");
                 						return response.toString();
                 					}
                 				}
                 			}
                 			if(monthRecognized != true)
                 			{
                 				response.put("message","The forecast month needs review.");
                 				return response.toString();
                 			}
                 			newValue = request.get("value");
                 			if(newValue != null)
                 			{
                 				if(!newValue.toString().matches("[0-9]{1,5}"))
                 				{
                 					response.put("message","Enter a whole lot count from 0 to 99,999, or leave blank.");
                 					return response.toString();
                 				}
                 				newValue = newValue.toString().toLong();
                 			}
                 			// Detect a changed value before writing; an unknown result is never automatically replayed.
                 			if(ifnull(fc.Forecasted_Lots,"__blank__").toString() != ifnull(request.get("expected"),"__blank__").toString())
                 			{
                 				response.put("conflict",true);
                 				response.put("current",fc.Forecasted_Lots);
                 				response.put("message","This forecast changed since it was loaded. Refresh before editing.");
                 				return response.toString();
                 			}
                 			writeStarted = true;
                 			fc.Forecasted_Lots=newValue;
                 			// Preserve the native phase/model/purchased-lot calculation exactly.
                 			futureForecasted = ifnull(Forecast[Subdivision1 == subdiv.ID && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots),0);
                 			lotsPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model == FALSE];
                 			lotTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model == FALSE];
                 			subdiv.Unforecasted_Lots=lotTotal.count(ID) - lotsPurchased.count(ID) - futureForecasted;
                 			savedForecast = Forecast[ID == forecastId];
                 			if(ifnull(savedForecast.Forecasted_Lots,"__blank__").toString() != ifnull(newValue,"__blank__").toString())
                 			{
                 				response.put("unknown",true);
                 				response.put("message","The saved value could not be verified. Check status before editing again.");
                 				return response.toString();
                 			}
                 			response.put("verifiedForecastId",savedForecast.ID.toString());
                 			response.put("verifiedValue",savedForecast.Forecasted_Lots);
                 		}
                 		if(action == "ensure")
                 		{
                 			builderId = ifnull(request.get("builderId"),"").toString().toLong();
                 			builder = Builder[ID == builderId];
                 			year = ifnull(request.get("year"),"").toString();
                 			if(builder.count() != 1 || !year.matches("[0-9]{4}"))
                 			{
                 				response.put("message","Choose a builder and fiscal year.");
                 				return response.toString();
                 			}
                 			// Both required picklists must support creation: parent 2019..2050, child 2018..2046.
                 			if(year.toLong() < 2019 || year.toLong() > 2046)
                 			{
                 				response.put("message","Choose a supported Forecast Year from 2019 to 2046.");
                 				return response.toString();
                 			}
                 			parents = Forecast_Year[Subdivision1 == subdivisionId && Builder1 == builderId && Forecast_Year == year];
                 			if(parents.count() > 1)
                 			{
                 				response.put("message","Duplicate forecast years need review. No records were changed.");
                 				return response.toString();
                 			}
                 			parentId = null;
                 			if(parents.count() == 1)
                 			{
                 				if(parents.Status != "Builder")
                 				{
                 					response.put("message","A non-builder forecast already exists for this combination.");
                 					return response.toString();
                 				}
                 				parentId = parents.ID;
                 			}
                 			// Validate existing children before creating anything. Do not adopt or replace orphan records.
                 			existingMonths = Map();
                 			for each  existing in Forecast[Subdivision1 == subdivisionId && Builder1 == builderId && Forecast_Year == year && Delete_me != true]
                 			{
                 				if(parentId == null || existing.Forecast_Year2 != parentId)
                 				{
                 					response.put("message","Unlinked forecast months need review. No records were changed.");
                 					return response.toString();
                 				}
                 			}
                 			if(parentId != null)
                 			{
                 				for each  existing in Forecast[Forecast_Year2 == parentId && Delete_me != true]
                 				{
                 					if(existing.Subdivision1 != subdivisionId || existing.Builder1 != builderId || existing.Forecast_Year != year)
                 					{
                 						response.put("message","Forecast relationships need review. No records were changed.");
                 						return response.toString();
                 					}
                 					recognized = false;
                 					for each index monthIndex in monthNames
                 					{
                 						monthName = monthNames.get(monthIndex);
                 						if(ifnull(existing.Forecast_Month,"").toUpperCase() == monthName.toUpperCase() || ifnull(existing.Forecast_Month,"").toUpperCase() == monthName.subString(0,3).toUpperCase())
                 						{
                 							recognized = true;
                 							expectedDate = ("02/01/" + year).toDate("MM/dd/yyyy").addMonth(monthIndex);
                 							if(existingMonths.get(monthName) != null || existing.Forecast_Start_Date != expectedDate)
                 							{
                 								response.put("message","Duplicate months or forecast dates need review. No records were changed.");
                 								return response.toString();
                 							}
                 							existingMonths.put(monthName,existing.ID);
                 						}
                 					}
                 					if(recognized != true)
                 					{
                 						response.put("message","An unrecognized forecast month needs review. No records were changed.");
                 						return response.toString();
                 					}
                 				}
                 			}
                 			createdMonths = 0;
                 			createdParent = false;
                 			if(parentId != null && existingMonths.size() != 12)
                 			{
                 				response.put("message","This existing forecast year has missing months and needs review. No records were changed.");
                 				return response.toString();
                 			}
                 			if(parentId == null)
                 			{
                 				// Same collection creation as Create_Forecasts_Mass_Cre; the parent name is unique.
                 				months = Collection();
                 				for each index monthIndex in monthNames
                 				{
                 					monthRow = Forecast_Year.Forecast_Months();
                 					monthRow.Forecast_Month=monthNames.get(monthIndex);
                 					monthRow.Forecast_Year=year;
                 					monthRow.Forecast_Start_Date=("02/01/" + year).toDate("MM/dd/yyyy").addMonth(monthIndex);
                 					monthRow.Builder1=builderId;
                 					monthRow.Subdivision1=subdivisionId;
                 					months.insert(monthRow);
                 				}
                 				fyStart = ("02/01/" + year).toDate("MM/dd/yyyy");
                 				fyEnd = fyStart.addMonth(12);
                 				lotsSold = Lots[Subdivision == subdivisionId && Builder1 == builderId && Status == "Sold" && Close_Date >= fyStart && Close_Date < fyEnd].count();
                 				lotsContracted = Lots[Subdivision == subdivisionId && Builder1 == builderId && Status == "Contracted"].count();
                 				lotsScheduled = Lots[Subdivision == subdivisionId && Builder1 == builderId && Status == "Scheduled"].count();
                 				lotsContracted = lotsContracted + lotsScheduled;
                 				writeStarted = true;
                 				parentId = insert into Forecast_Year
                 				[
                 					Status="Builder"
                 					Subdivision1=subdivisionId
                 					Builder1=builderId
                 					Forecast_Year=year
                 					Forecast_Name=subdiv.Subdivision_Code + " - " + builder.Builder_Name + " - FC" + year
                 					Subdivision_Code=subdiv.Subdivision_Code
                 					Forecast_Months=months
                 					Full_Year_Forecast=0
                 					Total_Sold_Lots=lotsSold
                 					Total_Contracted_Lots=lotsContracted
                 					Added_User=zoho.loginuser
                 				];
                 				createdParent = true;
                 				createdMonths = 12;
                 			}
                 			response.put("ensuredParentId",parentId.toString());
                 			response.put("createdParent",createdParent);
                 			response.put("createdMonths",createdMonths);
                 			// Verification is returned with the complete snapshot; the widget checks all twelve destinations.
                 		}
                 		subdivision = Map();
                 		subdivision.put("id",subdiv.ID.toString());
                 		subdivision.put("name",ifnull(subdiv.Subdivision_Name,""));
                 		subdivision.put("code",ifnull(subdiv.Subdivision_Code,""));
                 		subdivision.put("unforecasted",subdiv.Unforecasted_Lots);
                 		// Read-only reconciliation can distinguish a saved month from unfinished totals.
                 		expectedFuture = ifnull(Forecast[Subdivision1 == subdiv.ID && Forecast_Start_Date >= zoho.currentdate.toStartOfMonth()].sum(Forecasted_Lots),0);
                 		expectedPurchased = Lots[ID != 0 && Phase == subdiv.Phase && Purchase_Date != null && Subdivision == subdiv.ID && Model == FALSE].count(ID);
                 		expectedTotal = Lots[ID != 0 && Phase == subdiv.Phase && Subdivision == subdiv.ID && Model == FALSE].count(ID);
                 		subdivision.put("expectedUnforecasted",expectedTotal - expectedPurchased - expectedFuture);
                 		assignedBuilders = List();
                 		for each  assigned in subdiv.Builders
                 		{
                 			assignedBuilders.add(assigned.toString());
                 		}
                 		subdivision.put("builderIds",assignedBuilders);
                 		response.put("subdivision",subdivision);
                 		// Same all-date lot card as Data Insights: dates take precedence over stored Status.
                 		// This read-only breakdown includes every subdivision lot, independently of matrix filters.
                 		lotCounts = Map();
                 		for each  statusName in {"Total","Sold","Scheduled","Contracted","Open"}
                 		{
                 			lotCounts.put(statusName,0);
                 		}
                 		lotBuilderNames = List();
                 		lotBuilderCounts = Map();
                 		for each  inventoryLot in Lots[Subdivision == subdivisionId]
                 		{
                 			lotStatus = ifnull(inventoryLot.Status,"");
                 			if(inventoryLot.Close_Date != null)
                 			{
                 				lotStatus = "Sold";
                 			}
                 			else if(inventoryLot.Purchase_Date != null)
                 			{
                 				lotStatus = "Scheduled";
                 			}
                 			if(lotStatus != "Sold" && lotStatus != "Scheduled" && lotStatus != "Contracted")
                 			{
                 				lotStatus = "Open";
                 			}
                 			lotCounts.put("Total",lotCounts.get("Total") + 1);
                 			lotCounts.put(lotStatus,lotCounts.get(lotStatus) + 1);
                 			if(lotStatus != "Open")
                 			{
                 				lotBuilderName = "Unassigned";
                 				if(inventoryLot.Builder1 != null)
                 				{
                 					lotBuilderName = ifnull(inventoryLot.Builder1.Builder_Name,"").trim();
                 					if(lotBuilderName == "")
                 					{
                 						lotBuilderName = "Unassigned";
                 					}
                 				}
                 				lotBuilderRow = lotBuilderCounts.get(lotBuilderName);
                 				if(lotBuilderRow == null)
                 				{
                 					lotBuilderRow = Map();
                 					lotBuilderRow.put("builder",lotBuilderName);
                 					lotBuilderRow.put("total",0);
                 					lotBuilderRow.put("Sold",0);
                 					lotBuilderRow.put("Scheduled",0);
                 					lotBuilderRow.put("Contracted",0);
                 					lotBuilderNames.add(lotBuilderName);
                 				}
                 				lotBuilderRow.put("total",lotBuilderRow.get("total") + 1);
                 				lotBuilderRow.put(lotStatus,lotBuilderRow.get(lotStatus) + 1);
                 				lotBuilderCounts.put(lotBuilderName,lotBuilderRow);
                 			}
                 		}
                 		lotBuilders = List();
                 		for each  lotBuilderName in lotBuilderNames
                 		{
                 			lotBuilders.add(lotBuilderCounts.get(lotBuilderName));
                 		}
                 		inventory = Map();
                 		inventory.put("counts",lotCounts);
                 		inventory.put("builders",lotBuilders);
                 		inventory.put("territory",ifnull(subdiv.Territory,"Unassigned"));
                 		response.put("inventory",inventory);
                 		years = List();
                 		monthRecords = List();
                 		for each  fy in Forecast_Year[Subdivision1 == subdivisionId && Status == "Builder"] sort by Forecast_Year
                 		{
                 			yearRecord = Map();
                 			yearRecord.put("id",fy.ID.toString());
                 			yearRecord.put("builderId",ifnull(fy.Builder1,"").toString());
                 			yearRecord.put("year",fy.Forecast_Year);
                 			yearRecord.put("name",fy.Forecast_Name);
                 			years.add(yearRecord);
                 			for each  child in Forecast[Forecast_Year2 == fy.ID && Delete_me != true] sort by Forecast_Start_Date
                 			{
                 				monthRecord = Map();
                 				monthRecord.put("id",child.ID.toString());
                 				monthRecord.put("parentId",fy.ID.toString());
                 				monthRecord.put("builderId",ifnull(child.Builder1,"").toString());
                 				monthRecord.put("subdivisionId",ifnull(child.Subdivision1,"").toString());
                 				monthRecord.put("year",child.Forecast_Year);
                 				monthRecord.put("month",child.Forecast_Month);
                 				monthStart = "";
                 				if(child.Forecast_Start_Date != null)
                 				{
                 					monthStart = child.Forecast_Start_Date.toString("yyyy-MM-dd");
                 				}
                 				monthRecord.put("start",monthStart);
                 				monthRecord.put("forecast",child.Forecasted_Lots);
                 				monthRecord.put("actual",child.Actual_Lots);
                 				monthRecord.put("scheduled",child.Scheduled_Lots);
                 				monthRecords.add(monthRecord);
                 			}
                 		}
                 		response.put("years",years);
                 		response.put("months",monthRecords);
                 		response.put("summaryHtml",thisapp.buildForecastManagerSummary(subdivisionId));
                 		response.put("ok",true);
                 		return response.toString();
                 	}	catch (functionError)
                 	{
                 		response.put("ok",false);
                 		response.put("unknown",writeStarted);
                 		response.put("message",functionError.toString());
                 		return response.toString();
                 	}
                 	response.put("message","The forecast function ended without a response.");
                 	return response.toString();
                 }
				 list forLoop(int startNo, int endNo)
                 {
                 	len = endNo - startNo + 1;
                 	out = List();
                 	if(len <= 0)
                 	{
                 		return out;
                 	}
                 	// Create len non-empty tokens ("x") separated by commas, then split.
                 	s = "".leftPad(len);
                 	// "     " (len spaces)
                 	s = s.replaceAll(" ","x,");
                 	// "x,x,x," ...
                 	s = s.subString(0,s.length() - 1);
                 	// drop trailing comma -> "x,x,x"
                 	return s.toList();
                 	// ["x","x","x"] (length == len)
                 }
				 string formStyle()
                 {
                 	x = "<style>";
                 	// Force Approval_Email header + column to always be 90px
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Approvals1 ul.zc-subform-header-row.clearfix > li[val='Approval_Email']{width:90px!important;min-width:90px!important;max-width:90px!important;box-sizing:border-box!important;}";
                 	// Match the body column width too (rows)
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group{width:90px!important;min-width:90px!important;max-width:90px!important;box-sizing:border-box!important;}";
                 	// ===== Internal Approvals subform (Approvals1) — full-width + padding/spacing =====
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Approvals1{display:block!important;width:100%!important;max-width:100%!important;}";
                 	// Extra breathing room between the first checkbox column and the Approver column
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Approvals1 .zc-Approvals1-Approval_Email-group{padding-right:80px!important;}";
                 	// A touch of right padding on the last column so it doesn’t feel clipped
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Approvals1 .zc-Approvals1-Approval_Date-group{padding-right:10px!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions ul.zc-subform-header-row.clearfix > li[val='Complete']{padding-left:0px!important;box-sizing:border-box!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix .zc-Contract_Actions-Complete-group{padding-left:0px!important;box-sizing:border-box!important;}";
                 	// ===== Subform Decision Box: Approval_Email (Approvals1) — match Complete styling =====
                 	// Hide the row label (subform column header already shows it)
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group > label.form-label{display:none!important;}";
                 	// Center the checkbox in the subform cell
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group .decision-box-field.form-field{display:flex!important;align-items:center!important;justify-content:center!important;float:none!important;margin:0!important;height:32px!important;}";
                 	// Hide the native checkbox but keep it functional
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group input.zc_decisionbox{position:absolute!important;opacity:0!important;width:1px!important;height:1px!important;margin:0!important;padding:0!important;}";
                 	// Box (same as Complete)
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group label.zc_decision_box_label{width:24px!important;height:24px!important;border-radius:8px!important;border:1px solid #cbd5e1!important;background:#ffffff!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;cursor:pointer!important;box-shadow:0 1px 2px rgba(15,23,42,0.10)!important;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease,transform .05s ease;position:relative!important;overflow:hidden!important;margin:0!important;}";
                 	// Kill any Zoho default mark inside label (prevents black speck)
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group label.zc_decision_box_label *{display:none!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group label.zc_decision_box_label::before{content:none!important;display:none!important;border:0!important;background:none!important;}";
                 	// Our check layer (SVG), hidden until checked
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group label.zc_decision_box_label::after{content:''!important;position:absolute!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%)!important;width:16px!important;height:16px!important;background:none!important;background-repeat:no-repeat!important;background-position:center!important;background-size:16px 16px!important;opacity:0!important;}";
                 	// Hover
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group label.zc_decision_box_label:hover{transform:translateY(-1px);box-shadow:0 3px 10px rgba(15,23,42,0.14)!important;border-color:#94a3b8!important;}";
                 	// Checked state (green) + SVG check
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group input.zc_decisionbox:checked + label.zc_decision_box_label{background:linear-gradient(135deg,#22c55e,#16a34a)!important;border-color:#16a34a!important;box-shadow:0 0 0 2px rgba(34,197,94,0.22),0 4px 10px rgba(22,163,74,0.22)!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group input.zc_decisionbox:checked + label.zc_decision_box_label::after{opacity:1!important;background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2020%2020%27%3E%3Cpolyline%20points%3D%274%2C11%208%2C15%2016%2C6%27%20fill%3D%27none%27%20stroke%3D%27%23fff%27%20stroke-width%3D%273.5%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%2F%3E%3C%2Fsvg%3E\")!important;}";
                 	// Keyboard focus ring
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group input.zc_decisionbox:focus + label.zc_decision_box_label{outline:0!important;box-shadow:0 0 0 2px #bbf7d0,0 0 0 4px rgba(34,197,94,0.35)!important;}";
                 	// Disabled
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Approvals1-Approval_Email-group input.zc_decisionbox[disabled] + label.zc_decision_box_label{opacity:.55!important;cursor:not-allowed!important;transform:none!important;box-shadow:0 1px 2px rgba(15,23,42,0.08)!important;}";
                 	// ===== ONLY: move the green checkbox down / center it in the Contract_Actions row =====
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Contract_Actions-Complete-group .decision-box-field.form-field{display:flex!important;align-items:center!important;justify-content:center!important;float:none!important;width:100%!important;min-height:96px!important;box-sizing:border-box!important;position:relative!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Contract_Actions-Complete-group label.zc_decision_box_label{position:absolute!important;top:55%!important;left:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Contract_Actions-Current_Action-group .decision-box-field.form-field{display:flex!important;align-items:center!important;justify-content:center!important;float:none!important;width:100%!important;min-height:96px!important;box-sizing:border-box!important;position:relative!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subformRow.clearfix .zc-Contract_Actions-Current_Action-group label.zc_decision_box_label{position:absolute!important;top:55%!important;left:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;}";
                 	// ===== Textarea fields (zc_textareafield) — match textfield styling =====
                 	x = x + "textarea.zc_textareafield,.form-table textarea.zc_textareafield,.form-table .zc_textareafield textarea{border-radius:8px;border:1px solid #d1d5db;font-size:13px;padding:8px 10px;min-height:96px;line-height:1.35;box-shadow:0 1px 2px rgba(15,23,42,0.06);transition:border-color .15s ease,box-shadow .15s ease,background-color .15s ease,transform .05s ease;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:#ffffff;color:#111827;resize:vertical;}";
                 	x = x + "textarea.zc_textareafield:hover,.form-table textarea.zc_textareafield:hover,.form-table .zc_textareafield textarea:hover{background:#f9fafb;box-shadow:0 2px 6px rgba(15,23,42,0.12);}";
                 	x = x + "textarea.zc_textareafield:focus,.form-table textarea.zc_textareafield:focus,.form-table .zc_textareafield textarea:focus{border-color:#2563eb;box-shadow:0 0 0 1px #bfdbfe,0 2px 6px rgba(37,99,235,0.25);outline:0;background:#ffffff;}";
