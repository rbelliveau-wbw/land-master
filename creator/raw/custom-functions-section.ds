                 		// Builder / Property records linked through their multi-select "Proforma"
                 		// lookup. The Pro Forma's own LOI fields are deprecated and are NOT read
                 		// here except the dedicated authorized-signer field on the Pro Forma.
                 		// ============================================================
                 		stage = "resolve_subform_records";
                 		loiRec = null;
                 		for each  w in LOI_Worksheet[Proforma == pfId]
                 		{
                 			if(loiRec == null)
                 			{
                 				loiRec = w;
                 			}
                 			if(w.Is_Current == true)
                 			{
                 				loiRec = w;
                 			}
                 		}
                 		sellerRec = null;
                 		sellerCount = 0;
                 		for each  sRec in Builder[Proforma.contains(pfId.toString())]
                 		{
                 			sellerCount = sellerCount + 1;
                 			if(sellerRec == null)
                 			{
                 				sellerRec = sRec;
                 			}
                 		}
                 		propRec = null;
                 		propertyCount = 0;
                 		propertyCadIds = List();
                 		propertyCounties = List();
                 		propertyCities = List();
                 		for each  pRec in Property[Proforma.contains(pfId.toString())]
                 		{
                 			propertyCount = propertyCount + 1;
                 			if(propRec == null)
                 			{
                 				propRec = pRec;
                 			}
                 			parcelId = ifnull(pRec.Property_ID,"").trim();
                 			if(parcelId != "" && propertyCadIds.contains(parcelId) == false)
                 			{
                 				propertyCadIds.add(parcelId);
                 			}
                 			parcelCounty = ifnull(pRec.County,"").trim();
                 			if(parcelCounty != "" && propertyCounties.contains(parcelCounty) == false)
                 			{
                 				propertyCounties.add(parcelCounty);
                 			}
                 			parcelCity = ifnull(pRec.City,"").trim();
                 			if(parcelCity != "" && propertyCities.contains(parcelCity) == false)
                 			{
                 				propertyCities.add(parcelCity);
                 			}
                 		}
