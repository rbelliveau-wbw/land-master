                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix{" + "height:118px!important;" + "min-height:118px!important;" + "max-height:118px!important;" + "position:relative!important;" + "}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions ul.zc-subform-header-row.clearfix{padding-left:56px!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix{padding-left:56px!important;}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix .zc-row-delete{" + "position:absolute!important;" + "left:10px!important;" + "top:0!important;" + "height:100px!important;" + "width:40px!important;min-width:40px!important;max-width:40px!important;" + "display:flex!important;" + "align-items:center!important;" + "justify-content:center!important;" + "padding:0!important;margin:0!important;" + "overflow:visible!important;" + "z-index:5!important;" + "}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix .zc-row-delete a.rowDelete{" + "display:flex!important;" + "align-items:center!important;" + "justify-content:center!important;" + "width:28px!important;height:28px!important;" + "border-radius:8px!important;" + "cursor:pointer!important;" + "text-decoration:none!important;" + "pointer-events:auto!important;" + "}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix .zc-row-delete i.imgDelate{" + "font-size:16px!important;" + "line-height:1!important;" + "color:#dc2626!important;" + "}";
                 	x = x + ".form-group.subform-outer-wrapper.zc-subform-field-group .subform-inner-wrapper.zc-Contract_Actions .subformRow.clearfix .zc-row-delete a.rowDelete:hover{" + "background:#fee2e2!important;" + "}";
                 	x = x + "</style>";
                 	return x;
                 }
				 string generateApprovedBudgetPDF(string budgetId)
                 {
                 	/********* AUTOMATIC EXPORT AFTER BOTH APPROVAL TRACKS FINISH *********/
                 	return thisapp.exportBudgetSnapshot(budgetId,"APPROVED_PDF");
                 }
				 string getBudgetAttachmentPreview(string budgetId, string attachmentId)
                 {
                 	/********* RETURN AN EXACT BASE64 COPY OF ONE BUDGET ATTACHMENT *********/
                 	// Custom API link name expected by the widget:
                 	// Get_Budget_Attachment_Preview
                 	response = Map();
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vBudgetId == "" || vAttachmentId == "")
                 	{
                 		response.put("ok",false);
                 		response.put("message","Missing Budget ID or attachment ID.");
                 		return response.toString();
                 	}
                 	try 
                 	{
                 		attachmentRows = Contract_Version[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 		if(attachmentRows.count() == 0)
                 		{
                 			response.put("ok",false);
                 			response.put("message","Attachment record was not found for this budget.");
                 			return response.toString();
                 		}
                 		for each  attachmentRow in attachmentRows
                 		{
                 			if(attachmentRow.File_field1 == null)
                 			{
                 				response.put("ok",false);
                 				response.put("message","The attachment record does not contain a file.");
                 				return response.toString();
                 			}
                 			encodedFile = zoho.encryption.base64Encode(attachmentRow.File_field1);
                 			if(encodedFile == null || encodedFile == "")
                 			{
                 				response.put("ok",false);
                 				response.put("message","Creator could not encode the attachment for preview.");
                 				return response.toString();
                 			}
                 			fileName = "";
                 			try 
                 			{
                 				fileName = attachmentRow.File_field1.actualname;
                 			}			catch (nameError)
                 			{
                 				fileName = "";
                 			}
                 			response.put("ok",true);
                 			response.put("attachmentId",vAttachmentId);
                 			response.put("budgetId",vBudgetId);
                 			response.put("fileName",fileName);
                 			response.put("base64",encodedFile);
                 			response.put("byteLength",(encodedFile.length() * 3 / 4).toLong());
                 			return response.toString();
                 		}
                 	}	catch (previewError)
                 	{
                 		response.put("ok",false);
                 		response.put("message","Attachment preview failed: " + previewError.toString());
                 		return response.toString();
                 	}
                 	response.put("ok",false);
                 	response.put("message","Attachment preview failed.");
                 	return response.toString();
                 }
				 string getUserAccess(string user)
                 {
                 	requester = if(user != null && user != "",user,zoho.loginuser);
                 	// Budget flags
                 	editAll = false;
                 	editOwned = false;
                 	apprAll = false;
                 	apprOwned = false;
                 	sendAppr = false;
                 	editOwners = false;
                 	viewImports = false;
                 	editImports = false;
                 	// Pro Forma flags
                 	pfEditAll = false;
                 	pfEditOwned = false;
                 	pfEditCurve = false;
                 	pfVpCompTab = false;
                 	pfEditProbability = false;
                 	pfEditOwner = false;
                 	pfDeleteArchive = false;
                 	foundRow = false;
                 	myId = "";
                 	rows = User_Access[User == requester];
                 	for each  row in rows
                 	{
                 		foundRow = true;
                 		myId = row.ID.toString();
                 		// Budget permissions
                 		editAll = row.Edit_All_Budgets == true;
                 		editOwned = row.Edit_Owned_Budgets == true;
                 		apprAll = row.Edit_All_Approvals == true;
                 		apprOwned = row.Edit_Owned_Approvals == true;
                 		sendAppr = row.Send_for_Approvals == true;
                 		editOwners = row.Edit_Budget_Owners == true;
                 		viewImports = row.View_Budget_Import_Items == true;
                 		editImports = row.Edit_Budget_Import_Items == true;
                 		// Pro Forma permissions
                 		pfEditAll = row.Edit_All_Proformas == true;
                 		pfEditOwned = row.Edit_Owned_Proformas == true;
                 		pfEditCurve = row.Edit_Construction_Curve == true;
                 		pfVpCompTab = row.VP_Compensation_Tab == true;
                 		pfEditProbability = row.Edit_Probability == true;
                 		pfEditOwner = row.Edit_Proforma_Owner == true;
                 		pfDeleteArchive = row.Delete_Archive_Pro_Formas == true;
                 		break;
                 	}
                 	// Roster: each user as {id, label, email}.
                 	// id is the User_Access record ID stored by Budget_Owner / Owner.
                 	userList = List();
                 	allRows = User_Access[ID != null];
                 	for each  r in allRows
                 	{
                 		m = Map();
                 		m.put("id",r.ID.toString());
                 		m.put("label",r.User.toString());
                 		m.put("email",r.User.toString());
                 		userList.add(m);
                 	}
                 	// The Owner lookup can be hidden or blank in report API responses for users
                 	// without owner-edit access. Return the authoritative Owner IDs server-side so
                 	// the widget can still display ownership and enforce Edit Owned Pro Formas.
                 	proformaOwnerMap = Map();
                 	allProformas = Add_Pro_Forma[ID != null];
                 	for each  pfRec in allProformas
                 	{
                 		ownerIds = List();
                 		if(pfRec.Owner != null)
                 		{
                 			for each  ownerRow in pfRec.Owner
                 			{
                 				ownerIds.add(ownerRow.ID.toString());
                 			}
                 		}
                 		proformaOwnerMap.put(pfRec.ID.toString(),ownerIds);
                 	}
                 	result = Map();
                 	result.put("found",foundRow);
                 	result.put("hasRow",foundRow);
                 	result.put("myId",myId);
                 	// Budget permissions
                 	result.put("editAll",editAll);
                 	result.put("editOwned",editOwned);
                 	result.put("apprAll",apprAll);
                 	result.put("apprOwned",apprOwned);
                 	result.put("send",sendAppr);
                 	result.put("editOwners",editOwners);
                 	result.put("viewImports",viewImports);
                 	result.put("editImports",editImports);
                 	// Pro Forma permissions
                 	result.put("pfEditAll",pfEditAll);
                 	result.put("pfEditOwned",pfEditOwned);
                 	result.put("pfEditCurve",pfEditCurve);
                 	result.put("pfVpCompTab",pfVpCompTab);
                 	result.put("pfEditProbability",pfEditProbability);
                 	result.put("pfEditOwner",pfEditOwner);
                 	result.put("pfDeleteArchive",pfDeleteArchive);
                 	result.put("users",userList);
                 	result.put("proformaOwners",proformaOwnerMap);
                 	return result.toString();
                 }
				 string handleApprovalAction(string budgetId, string approvalId, string approvalAction, string approvalNote)
                 {
                 	/********* HANDLE APPROVAL PAGE BUTTON PRESS *********/
                 	// All record IDs are held internally as strings.
                 	// IDs are converted to long only when required by:
                 	// - Creator record criteria
                 	// - Existing helper functions that accept numeric IDs
                 	//
                 	// Approved:
                 	// - Approves the current row.
                 	// - Sends the next approver.
                 	// - When the last approver finishes:
                 	//     Development: Development + Engineering Unapproved -> Final,
                 	//                  then Unapproved -> 0.
                 	//     Construction: Construction Unapproved -> Final,
                 	//                   then Unapproved -> 0.
                 	// - When both tracks are fully approved:
                 	//     Generates an approved-budget PDF and attaches it to
                 	//     Add_Budget.Attachments.
                 	//
                 	// Rejected:
                 	// - Sends the chain back to the previous approver.
                 	//
                 	// Pending:
                 	// - Saves the note only.
                 	//
                 	// VP cannot reject because there is no previous approver.
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vApprovalId = ifnull(approvalId,"").trim();
                 	vAction = ifnull(approvalAction,"").trim();
                 	vNote = ifnull(approvalNote,"");
                 	if(vBudgetId == "")
                 	{
                 		return "No Budget ID provided.";
                 	}
                 	if(vApprovalId == "")
                 	{
                 		return "No Approval ID provided.";
                 	}
                 	if(vAction == "")
                 	{
                 		return "No approval action provided.";
                 	}
                 	/********* LOAD BUDGET *********/
                 	budgetRec = Add_Budget[ID == vBudgetId.toLong()];
                 	if(budgetRec == null)
                 	{
                 		return "Budget not found.";
                 	}
                 	/********* LOAD CURRENT APPROVAL *********/
                 	currentRows = Budget_Approvals[ID == vApprovalId.toLong()];
                 	if(currentRows.count() == 0)
                 	{
                 		return "Approval row not found.";
                 	}
                 	currentApproval = null;
                 	for each  cr in currentRows
                 	{
                 		currentApproval = cr;
                 	}
                 	vApprovalType = ifnull(currentApproval.Type1,"").trim();
                 	vCurrentRole = ifnull(currentApproval.Title,"").trim();
                 	vCurrentStatus = ifnull(currentApproval.Status,"").trim();
                 	if(vCurrentStatus == "")
                 	{
                 		vCurrentStatus = "Not Sent";
                 	}
                 	vCurrentSort = 0;
                 	if(currentApproval.Sort_Order != null)
                 	{
                 		vCurrentSort = currentApproval.Sort_Order.toLong();
                 	}
                 	if(vApprovalType == "")
                 	{
                 		return "Approval Type is blank.";
                 	}
                 	if(vApprovalType != "Development" && vApprovalType != "Construction")
                 	{
                 		return "Unsupported approval type: " + vApprovalType;
                 	}
                 	if(vCurrentSort == 0)
                 	{
                 		return "Sort Order is blank for " + vCurrentRole + ".";
                 	}
                 	/********* FORMAT NOTE *********/
                 	vNote = vNote.replaceAll("\r\n","\n");
                 	vNote = vNote.replaceAll("\r","\n");
                 	vNote = vNote.replaceAll("\n","<br>");
                 	/********* PREVENT STALE OR OUT-OF-SEQUENCE ACTIONS *********/
                 	if(vCurrentStatus != "Pending")
                 	{
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		return vApprovalType + " " + vCurrentRole + " is currently " + vCurrentStatus + ". No action was taken because this approval is not Pending. " + syncResp;
                 	}
                 	/********* SAVE NOTE ONLY *********/
                 	if(vAction == "Pending")
                 	{
                 		currentApproval.Status="Pending";
                 		currentApproval.Approval_Notes=vNote;
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		return vApprovalType + " " + vCurrentRole + " note saved. " + syncResp;
                 	}
                 	/********* APPROVED *********/
                 	if(vAction == "Approved")
                 	{
                 		currentApproval.Status="Approved";
                 		currentApproval.Approval_Notes=vNote;
                 		currentApproval.Responded_Date=zoho.currentdate;
                 		nextApprovalId = "";
                 		nextSort = 999999;
                 		/********* FIND NEXT APPROVER IN THE SAME TRACK *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprSort = 999999;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort > vCurrentSort && apprSort < nextSort)
                 				{
                 					nextSort = apprSort;
                 					nextApprovalId = appr.ID.toString();
                 				}
                 			}
                 		}
                 		/********* SEND NEXT APPROVER *********/
                 		if(nextApprovalId != "")
                 		{
                 			// Ensure only one row in this track remains Pending.
                 			for each  appr in budgetRec.Approvals
                 			{
                 				apprIdText = appr.ID.toString();
                 				if(ifnull(appr.Type1,"").trim() == vApprovalType && apprIdText != nextApprovalId && apprIdText != vApprovalId)
                 				{
                 					if(ifnull(appr.Status,"").trim() == "Pending")
                 					{
                 						pendingRows = Budget_Approvals[ID == apprIdText.toLong()];
                 						for each  pr in pendingRows
                 						{
                 							pr.Status="Not Sent";
                 							pr.Sent_Date=null;
                 							pr.Responded_Date=null;
                 						}
                 					}
                 				}
                 			}
                 			nextRows = Budget_Approvals[ID == nextApprovalId.toLong()];
                 			for each  nextApproval in nextRows
                 			{
                 				nextApproval.Status="Pending";
                 				nextApproval.Sent_Date=zoho.currentdate;
                 				nextApproval.Responded_Date=null;
                 			}
                 			emailResp = thisapp.sendApprovalEmail(vBudgetId.toLong(),nextApprovalId.toLong());
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " " + vCurrentRole + " approved. " + emailResp + " " + syncResp;
                 		}
                 		else
                 		{
                 			/*****************************************************
                 			 * FINAL APPROVER FINISHED
                 			 *
                 			 * Development:
                 			 * - Development + Engineering Unapproved -> Final
                 			 * - Development + Engineering Unapproved -> 0
                 			 *
                 			 * Construction:
                 			 * - Construction Unapproved -> Final
                 			 * - Construction Unapproved -> 0
                 			 *****************************************************/
                 			finalizedCount = 0;
                 			finalizedTotal = 0;
                 			budgetCategoriesToFinalize = Budget_Category[Budget == vBudgetId.toLong()];
                 			for each  cat in budgetCategoriesToFinalize
                 			{
                 				deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 				shouldFinalize = false;
                 				if(vApprovalType == "Development")
                 				{
                 					if(deptKey.contains("development") || deptKey.contains("engineering"))
                 					{
                 						shouldFinalize = true;
                 					}
                 				}
                 				else if(vApprovalType == "Construction")
                 				{
                 					if(deptKey.contains("construction"))
                 					{
                 						shouldFinalize = true;
                 					}
                 				}
                 				if(shouldFinalize == true)
                 				{
                 					categoryId = cat.ID.toString();
                 					catItemsToFinalize = Budget_Item[Budget_Category == categoryId.toLong()];
                 					for each  itemToFinalize in catItemsToFinalize
                 					{
                 						unapprovedVal = 0;
                 						if(itemToFinalize.Unapproved_Final_Budget_Ttl != null)
                 						{
                 							unapprovedNum = itemToFinalize.Unapproved_Final_Budget_Ttl.toNumber();
                 							if(unapprovedNum != null)
                 							{
                 								unapprovedVal = unapprovedNum;
                 							}
                 						}
                 						// Move Unapproved into Final.
                 						itemToFinalize.Budget_Ttl=unapprovedVal;
                 						// Once the track finishes, Unapproved must be zero.
                 						itemToFinalize.Unapproved_Final_Budget_Ttl=0;
                 						finalizedCount = finalizedCount + 1;
                 						finalizedTotal = finalizedTotal + unapprovedVal;
                 					}
                 					/********* REFRESH THIS CATEGORY'S FINAL TOTAL *********/
                 					catFinalTotal = 0;
                 					catFinalSum = Budget_Item[Budget_Category == categoryId.toLong()].sum(Budget_Ttl);
                 					if(catFinalSum != null)
                 					{
                 						catFinalNum = catFinalSum.toNumber();
                 						if(catFinalNum != null)
                 						{
                 							catFinalTotal = catFinalNum;
                 						}
                 					}
                 					cat.Budget_Total=catFinalTotal;
                 				}
                 			}
                 			/********* REFRESH PARENT BUDGET FINAL GRAND TOTAL *********/
                 			newGrandTotal = 0;
                 			allBudgetCategories = Budget_Category[Budget == vBudgetId.toLong()];
                 			for each  catTotalRec in allBudgetCategories
                 			{
                 				if(catTotalRec.Budget_Total != null)
                 				{
                 					catTotalNum = catTotalRec.Budget_Total.toNumber();
                 					if(catTotalNum != null)
                 					{
                 						newGrandTotal = newGrandTotal + catTotalNum;
                 					}
                 				}
                 			}
                 			budgetRec.Budget_Grand_Total=newGrandTotal;
                 			finalizeResp = "Finalized " + finalizedCount + " " + vApprovalType + " items totaling " + finalizedTotal + " into Final and cleared Unapproved.";
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			/*****************************************************
                 			 * CHECK WHETHER BOTH APPROVAL TRACKS ARE COMPLETE
                 			 *****************************************************/
                 			hasDevelopmentTrack = false;
                 			hasConstructionTrack = false;
                 			allDevelopmentApproved = true;
                 			allConstructionApproved = true;
                 			allApprovalRows = Budget_Approvals[Budget == vBudgetId.toLong()];
                 			for each  finalCheckRow in allApprovalRows
                 			{
                 				finalCheckType = ifnull(finalCheckRow.Type1,"").trim();
                 				finalCheckStatus = ifnull(finalCheckRow.Status,"").trim();
                 				if(finalCheckType == "Development")
                 				{
                 					hasDevelopmentTrack = true;
                 					if(finalCheckStatus != "Approved")
                 					{
                 						allDevelopmentApproved = false;
                 					}
                 				}
                 				else if(finalCheckType == "Construction")
                 				{
                 					hasConstructionTrack = true;
                 					if(finalCheckStatus != "Approved")
                 					{
                 						allConstructionApproved = false;
                 					}
                 				}
                 			}
                 			pdfResp = "";
                 			if(hasDevelopmentTrack == true && hasConstructionTrack == true && allDevelopmentApproved == true && allConstructionApproved == true)
                 			{
                 				// generateApprovedBudgetPDF expects a STRING.
                 				pdfResp = thisapp.generateApprovedBudgetPDF(vBudgetId);
                 			}
                 			else
                 			{
                 				pdfResp = "Approved budget PDF will be generated after both approval tracks are fully approved.";
                 			}
                 			return vApprovalType + " approval chain fully approved. " + finalizeResp + " " + syncResp + " " + pdfResp;
                 		}
                 	}
                 	/********* REJECTED — SEND BACK TO PREVIOUS APPROVER *********/
                 	if(vAction == "Rejected")
                 	{
                 		// VP cannot reject because there is no previous approval row.
                 		if(vCurrentSort <= 1 || vCurrentRole == "VP")
                 		{
                 			currentApproval.Approval_Notes=vNote;
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " VP cannot reject because there is no previous approver. Note saved and approval remains Pending. " + syncResp;
                 		}
                 		currentApproval.Status="Rejected";
                 		currentApproval.Approval_Notes=vNote;
                 		currentApproval.Responded_Date=zoho.currentdate;
                 		previousApprovalId = "";
                 		previousSort = 0;
                 		/********* FIND PREVIOUS APPROVER IN THE SAME TRACK *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprSort = 0;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				if(apprSort < vCurrentSort && apprSort > previousSort)
                 				{
                 					previousSort = apprSort;
                 					previousApprovalId = appr.ID.toString();
                 				}
                 			}
                 		}
                 		if(previousApprovalId == "")
                 		{
                 			currentApproval.Status="Pending";
                 			currentApproval.Responded_Date=null;
                 			syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 			return vApprovalType + " " + vCurrentRole + " could not be rejected because no previous approver was found. Approval remains Pending. " + syncResp;
                 		}
                 		/********* PUSH THE CHAIN BACK ONE STEP *********/
                 		for each  appr in budgetRec.Approvals
                 		{
                 			if(ifnull(appr.Type1,"").trim() == vApprovalType)
                 			{
                 				apprIdText = appr.ID.toString();
                 				apprSort = 0;
                 				if(appr.Sort_Order != null)
                 				{
                 					apprSort = appr.Sort_Order.toLong();
                 				}
                 				apprRows = Budget_Approvals[ID == apprIdText.toLong()];
                 				for each  ar in apprRows
                 				{
                 					if(apprIdText == previousApprovalId)
                 					{
                 						ar.Status="Pending";
                 						ar.Sent_Date=zoho.currentdate;
                 						ar.Responded_Date=null;
                 					}
                 					else if(apprSort > vCurrentSort)
                 					{
                 						ar.Status="Not Sent";
                 						ar.Sent_Date=null;
                 						ar.Responded_Date=null;
                 					}
                 				}
                 			}
                 		}
                 		emailResp = thisapp.sendApprovalEmail(vBudgetId.toLong(),previousApprovalId.toLong());
                 		syncResp = thisapp.syncBudgetApprovalStatus(vBudgetId.toLong(),vApprovalType);
                 		return vApprovalType + " " + vCurrentRole + " rejected. Sent back to previous approver. " + emailResp + " " + syncResp;
                 	}
                 	return "Unsupported approval action: " + vAction;
                 }
				 map Handle_Proforma_Approval_Action(string proformaId, string approvalId, string approvalAction, string approvalNote)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		actionText = ifnull(approvalAction,"").toString().trim();
                 		noteText = ifnull(approvalNote,"").toString().trim();
                 		if(proformaIdText == "" || approvalIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID and approval ID are required.");
                 			return response;
                 		}
                 		actionLower = actionText.toLowerCase();
                 		if(actionLower == "approve" || actionLower == "approved")
                 		{
                 			actionText = "Approved";
                 		}
                 		else if(actionLower == "deny" || actionLower == "denied" || actionLower == "reject" || actionLower == "rejected")
                 		{
                 			actionText = "Rejected";
                 		}
                 		else if(actionLower == "pending")
                 		{
                 			actionText = "Pending";
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		approvalIdLong = approvalIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		row = Budget_Approvals[ID == approvalIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","The Pro Forma could not be found.");
                 			return response;
                 		}
                 		if(row.ID == null || row.Proforma == null || row.Proforma.toString() != proformaIdLong.toString())
                 		{
                 			response.put("success",false);
                 			response.put("message","Approval row not found for this Pro Forma.");
                 			return response;
                 		}
                 		if(actionText == "Pending")
                 		{
                 			if(row.Status != "Pending")
                 			{
                 				response.put("success",false);
                 				response.put("message","Only the currently pending approval can be updated.");
                 				return response;
                 			}
                 			row.Approval_Notes=noteText;
                 			response.put("success",true);
                 			response.put("message","Approval note saved.");
                 			return response;
                 		}
                 		if(row.Status != "Pending")
                 		{
                 			response.put("success",false);
                 			response.put("message","This approval has already been processed or is no longer pending.");
                 			return response;
                 		}
                 		if(actionText == "Approved")
                 		{
                 			originalRowNote = ifnull(row.Approval_Notes,"").toString();
                 			row.Approval_Notes=noteText;
                 			row.Status="Approved";
                 			row.Responded_Date=zoho.currenttime;
                 			nextOrder = row.Sort_Order + 1;
                 			nextRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == nextOrder];
                 			if(nextRow.ID != null)
                 			{
                 				originalNextStatus = ifnull(nextRow.Status,"Not Sent").toString();
                 				originalNextSentDate = nextRow.Sent_Date;
                 				originalNextRespondedDate = nextRow.Responded_Date;
                 				nextRow.Status="Pending";
                 				nextRow.Sent_Date=zoho.currenttime;
                 				nextRow.Responded_Date=null;
                 				emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,nextRow.ID.toString(),"Approved",noteText,ifnull(row.Title,"Approver").toString());
                 				if(ifnull(emailResult.get("success"),false) != true)
                 				{
                 					row.Status="Pending";
                 					row.Responded_Date=null;
                 					row.Approval_Notes=originalRowNote;
                 					nextRow.Status=originalNextStatus;
                 					nextRow.Sent_Date=originalNextSentDate;
                 					nextRow.Responded_Date=originalNextRespondedDate;
                 					response.put("success",false);
                 					response.put("message",ifnull(emailResult.get("message"),"The next approval email could not be sent."));
                 					return response;
                 				}
                 				pf.Status="Pending Approval";
                 				response.put("success",true);
                 				response.put("message","Approved and routed to " + ifnull(nextRow.Title,"the next approver").toString() + ".");
                 				return response;
                 			}
                 			pf.Status="Approved";
                 			response.put("success",true);
                 			response.put("message","Final approval completed. The Pro Forma is now approved.");
                 			return response;
                 		}
                 		if(actionText == "Rejected")
                 		{
                 			if(noteText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","A note is required when denying a Pro Forma approval.");
                 				return response;
                 			}
                 			if(row.Sort_Order == 1)
                 			{
                 				response.put("success",false);
                 				response.put("message","The first approval step cannot be returned to a prior approver.");
                 				return response;
                 			}
                 			previousOrder = row.Sort_Order - 1;
                 			previousRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == previousOrder];
                 			if(previousRow.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","The prior approval row could not be found.");
                 				return response;
                 			}
                 			originalRowNote = ifnull(row.Approval_Notes,"").toString();
                 			originalPreviousStatus = ifnull(previousRow.Status,"Approved").toString();
                 			originalPreviousSentDate = previousRow.Sent_Date;
                 			originalPreviousRespondedDate = previousRow.Responded_Date;
                 			row.Approval_Notes=noteText;
                 			row.Status="Rejected";
                 			row.Responded_Date=zoho.currenttime;
                 			downstreamRows = Budget_Approvals[Proforma == proformaIdLong && Sort_Order > row.Sort_Order];
                 			for each  downstreamRow in downstreamRows
                 			{
                 				downstreamRow.Status="Not Sent";
                 				downstreamRow.Sent_Date=null;
                 				downstreamRow.Responded_Date=null;
                 			}
                 			previousRow.Status="Pending";
                 			previousRow.Sent_Date=zoho.currenttime;
                 			previousRow.Responded_Date=null;
                 			emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,previousRow.ID.toString(),"Rejected",noteText,ifnull(row.Title,"Approver").toString());
                 			if(ifnull(emailResult.get("success"),false) != true)
                 			{
                 				row.Status="Pending";
                 				row.Responded_Date=null;
                 				row.Approval_Notes=originalRowNote;
                 				previousRow.Status=originalPreviousStatus;
                 				previousRow.Sent_Date=originalPreviousSentDate;
                 				previousRow.Responded_Date=originalPreviousRespondedDate;
                 				response.put("success",false);
                 				response.put("message",ifnull(emailResult.get("message"),"The return approval email could not be sent."));
                 				return response;
                 			}
                 			pf.Status="Pending Approval";
                 			response.put("success",true);
                 			response.put("message","Denied and returned to " + ifnull(previousRow.Title,"the prior approver").toString() + ".");
                 			return response;
                 		}
                 		response.put("success",false);
                 		response.put("message","Unsupported approval action: " + actionText);
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
				 string killApprovalChain(string budgetId, string approvalType)
                 {
                 	/********* CANCEL ONE APPROVAL CHAIN *********/
                 	//
                 	// Development:
                 	// - Reset approval chain.
                 	// - Clear Development/Engineering Final and Unapproved through
                 	//   applyBudgetTrackFinalState.
                 	//
                 	// Construction:
                 	// - Reset approval chain.
                 	// - Move Construction Final back into Unapproved.
                 	// - Clear Construction Final.
                 	//
                 	// Construction will later resync from HeavyJob as needed.
                 	vBudgetId = budgetId.toLong();
                 	vType = ifnull(approvalType,"").trim();
                 	if(vBudgetId == 0 || vType == "")
                 	{
                 		return "{\"ok\":false,\"error\":\"Missing budgetId or approvalType.\"}";
                 	}
                 	if(vType != "Development" && vType != "Construction")
                 	{
                 		return "{\"ok\":false,\"error\":\"approvalType must be Development or Construction.\"}";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
                 	}
                 	/********* RESET PARENT TRACK STATUS *********/
                 	if(vType == "Construction")
                 	{
                 		budgetRec.Const_Budget_Approval_Status="Not Sent";
                 	}
                 	else
                 	{
                 		budgetRec.Development_Budget_Approval_Status="Not Sent";
                 	}
                 	/********* RESET APPROVAL ROWS *********/
                 	rowsReset = 0;
                 	approvalRows = Budget_Approvals[Budget == vBudgetId && Type1 == vType];
                 	for each  ar in approvalRows
                 	{
                 		ar.Status="Not Sent";
                 		ar.Sent_Date=null;
                 		ar.Responded_Date=null;
                 		rowsReset = rowsReset + 1;
                 	}
                 	/********* MOVE CONSTRUCTION FINAL BACK TO UNAPPROVED *********/
                 	movedCount = 0;
                 	movedTotal = 0;
                 	if(vType == "Construction")
                 	{
                 		budgetCategories = Budget_Category[Budget == vBudgetId];
                 		for each  cat in budgetCategories
                 		{
                 			deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 			if(deptKey.contains("construction"))
                 			{
                 				constructionItems = Budget_Item[Budget_Category == cat.ID];
                 				for each  itemToMove in constructionItems
                 				{
                 					finalValue = ifnull(itemToMove.Budget_Ttl,0);
                 					// Move Final back into Unapproved.
                 					itemToMove.Unapproved_Final_Budget_Ttl=finalValue;
                 					// Clear Final.
                 					itemToMove.Budget_Ttl=0;
                 					movedCount = movedCount + 1;
                 					movedTotal = movedTotal + finalValue;
                 				}
                 			}
                 		}
                 	}
                 	/********* CLEAR TRACK TOTALS AND RECALCULATE BUDGET *********/
                 	// The Construction CLEAR behavior must preserve
                 	// Unapproved_Final_Budget_Ttl.
                 	financialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "",vType,"CLEAR");
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("approvalType",vType);
                 	resultMap.put("rowsReset",rowsReset);
                 	resultMap.put("constructionItemsMoved",movedCount);
                 	resultMap.put("constructionTotalMoved",movedTotal);
                 	resultMap.put("financialResult",financialResp);
                 	return resultMap.toString();
                 }
				 string killApprovalFlow(string budgetId)
                 {
                 	/********* CANCEL BOTH APPROVAL CHAINS *********/
                 	//
                 	// Development:
                 	// - Reset approval rows and status.
                 	// - Clear Development/Engineering Final and Unapproved.
                 	//
                 	// Construction:
                 	// - Reset approval rows and status.
                 	// - Move Construction Final back into Unapproved.
                 	// - Clear Construction Final.
                 	vBudgetId = budgetId.toLong();
                 	if(vBudgetId == 0)
                 	{
                 		return "{\"ok\":false,\"error\":\"No Budget ID provided.\"}";
                 	}
                 	budgetRec = Add_Budget[ID == vBudgetId];
                 	if(budgetRec == null)
                 	{
                 		return "{\"ok\":false,\"error\":\"Budget not found.\"}";
                 	}
                 	/********* RESET BOTH TRACK STATUSES *********/
                 	budgetRec.Const_Budget_Approval_Status="Not Sent";
                 	budgetRec.Development_Budget_Approval_Status="Not Sent";
                 	/********* RESET ALL APPROVAL ROWS *********/
                 	rowsReset = 0;
                 	approvalRows = Budget_Approvals[Budget == vBudgetId];
                 	for each  ar in approvalRows
                 	{
                 		ar.Status="Not Sent";
                 		ar.Sent_Date=null;
                 		ar.Responded_Date=null;
                 		rowsReset = rowsReset + 1;
                 	}
                 	/********* MOVE CONSTRUCTION FINAL BACK TO UNAPPROVED *********/
                 	constructionItemsMoved = 0;
                 	constructionTotalMoved = 0;
                 	budgetCategories = Budget_Category[Budget == vBudgetId];
                 	for each  cat in budgetCategories
                 	{
                 		deptKey = ifnull(cat.Deparment,"").trim().toLowerCase();
                 		if(deptKey.contains("construction"))
                 		{
                 			constructionItems = Budget_Item[Budget_Category == cat.ID];
                 			for each  itemToMove in constructionItems
                 			{
                 				finalValue = 0;
                 				if(itemToMove.Budget_Ttl != null)
                 				{
                 					finalValue = itemToMove.Budget_Ttl;
                 				}
                 				// Move Construction Final back into Unapproved.
                 				itemToMove.Unapproved_Final_Budget_Ttl=finalValue;
                 				// Clear Construction Final.
                 				itemToMove.Budget_Ttl=0;
                 				constructionItemsMoved = constructionItemsMoved + 1;
                 				constructionTotalMoved = constructionTotalMoved + finalValue;
                 			}
                 		}
                 	}
                 	/********* CLEAR AND RECALCULATE BOTH TRACKS *********/
                 	devFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Development","CLEAR");
                 	// Construction CLEAR must preserve Unapproved_Final_Budget_Ttl.
                 	constFinancialResp = thisapp.applyBudgetTrackFinalState(vBudgetId + "","Construction","CLEAR");
                 	resultMap = Map();
                 	resultMap.put("ok",true);
                 	resultMap.put("rowsReset",rowsReset);
                 	resultMap.put("constructionItemsMoved",constructionItemsMoved);
                 	resultMap.put("constructionTotalMoved",constructionTotalMoved);
                 	resultMap.put("developmentFinancialResult",devFinancialResp);
                 	resultMap.put("constructionFinancialResult",constFinancialResp);
                 	return resultMap.toString();
                 }
				 map Kill_Proforma_Approval_Flow(string proformaId)
                 {
                 	response = Map();
                 	proformaIdText = ifnull(proformaId,"").toString();
                 	proformaIdText = proformaIdText.trim();
                 	if(proformaIdText == "")
                 	{
                 		response.put("success",false);
                 		response.put("message","Pro Forma ID is required.");
                 		return response;
                 	}
                 	proformaIdLong = proformaIdText.toLong();
                 	pf = Add_Pro_Forma[ID == proformaIdLong];
                 	rows = Budget_Approvals[Proforma == proformaIdLong];
                 	for each  row in rows
                 	{
                 		row.Status="Not Sent";
                 		row.Approval_Notes="";
                 		row.Sent_Date=null;
                 		row.Responded_Date=null;
                 	}
                 	if(pf.ID != null)
                 	{
                 		pf.Lock_Inputs=false;
                 	}
                 	response.put("success",true);
                 	response.put("message","Pro Forma approvals reset and all inputs unlocked.");
                 	return response;
                 }
				 map Manage_Proforma_Approval_Config(string proformaId, string configAction, string approvalId, string title, string approverEmail, string orderedIds)
                 {
                 	response = Map();
                 	try 
                 	{
                 		proformaIdText = ifnull(proformaId,"").toString().trim();
                 		actionText = ifnull(configAction,"").toString().trim().toLowerCase();
                 		approvalIdText = ifnull(approvalId,"").toString().trim();
                 		titleText = ifnull(title,"").toString().trim();
                 		emailText = ifnull(approverEmail,"").toString().trim();
                 		orderedIdsText = ifnull(orderedIds,"").toString().trim();
                 		if(proformaIdText == "")
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma ID is required.");
                 			return response;
                 		}
                 		proformaIdLong = proformaIdText.toLong();
                 		pf = Add_Pro_Forma[ID == proformaIdLong];
                 		if(pf.ID == null)
                 		{
                 			response.put("success",false);
                 			response.put("message","Pro Forma not found.");
                 			return response;
                 		}
                 		rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 		// The route is configuration data only until the chain starts.
                 		// Once any row has moved beyond Not Sent, cancel the flow before editing it.
                 		for each  approvalRow in rows
                 		{
                 			rowStatus = ifnull(approvalRow.Status,"Not Sent").toString().trim();
                 			if(rowStatus != "" && rowStatus != "Not Sent")
                 			{
                 				response.put("success",false);
                 				response.put("message","Cancel the active approval flow before adding, removing, renaming, or reordering approval steps.");
                 				return response;
                 			}
                 		}
                 		if(actionText == "add")
                 		{
                 			// Keep the route readable in the widget, email, public page and PDF packet.
                 			if(rows.count() >= 8)
                 			{
                 				response.put("success",false);
                 				response.put("message","A Pro Forma approval route can contain up to 8 steps.");
                 				return response;
                 			}
                 			nextOrder = rows.count() + 1;
                 			if(titleText == "")
                 			{
                 				titleText = "Approver " + nextOrder.toString();
                 			}
                 			newApprovalId = insert into Budget_Approvals
                 			[
                 				Added_User=zoho.loginuser
                 				Proforma=proformaIdLong
                 				Title=titleText
                 				Approver=emailText
                 				Sort_Order=nextOrder
                 				Status="Not Sent"
                 				Type1="Pro Forma"
                 			];
                 			response.put("success",true);
                 			response.put("message","Approval step added.");
                 			response.put("approvalId",newApprovalId.toString());
                 			response.put("sortOrder",nextOrder);
                 			return response;
                 		}
                 		if(actionText == "update")
                 		{
                 			if(approvalIdText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval ID is required for update.");
                 				return response;
                 			}
                 			if(titleText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Each approval step needs a name.");
                 				return response;
                 			}
                 			row = Budget_Approvals[ID == approvalIdText.toLong() && Proforma == proformaIdLong];
                 			if(row.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval row not found for this Pro Forma.");
                 				return response;
                 			}
                 			row.Title=titleText;
                 			row.Approver=emailText;
                 			response.put("success",true);
                 			response.put("message","Approval step updated.");
                 			return response;
                 		}
                 		if(actionText == "delete")
                 		{
                 			if(approvalIdText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval ID is required for delete.");
                 				return response;
                 			}
                 			if(rows.count() <= 1)
                 			{
                 				response.put("success",false);
                 				response.put("message","An approval route must contain at least one step.");
                 				return response;
                 			}
                 			row = Budget_Approvals[ID == approvalIdText.toLong() && Proforma == proformaIdLong];
                 			if(row.ID == null)
                 			{
                 				response.put("success",false);
                 				response.put("message","Approval row not found for this Pro Forma.");
                 				return response;
                 			}
                 			delete from Budget_Approvals[ID == row.ID];
                 			// Re-number the remaining rows so the routing functions can continue
                 			// using Sort_Order + 1 and Sort_Order - 1 without gaps.
                 			remainingRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
                 			nextOrder = 1;
                 			for each  remainingRow in remainingRows
                 			{
                 				remainingRow.Sort_Order=nextOrder;
                 				nextOrder = nextOrder + 1;
                 			}
                 			response.put("success",true);
                 			response.put("message","Approval step removed.");
                 			return response;
                 		}
                 		if(actionText == "reorder")
                 		{
                 			if(orderedIdsText == "")
                 			{
                 				response.put("success",false);
                 				response.put("message","The reordered approval ID list is required.");
                 				return response;
                 			}
                 			orderedIdList = orderedIdsText.toList(",");
                 			if(orderedIdList.size() != rows.count())
                 			{
                 				response.put("success",false);
                 				response.put("message","The reordered list does not contain every approval step.");
                 				return response;
                 			}
                 			seenIds = Map();
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedIdText = orderedIdValue.toString().trim();
                 				if(orderedIdText == "" || seenIds.get(orderedIdText) != null)
                 				{
                 					response.put("success",false);
                 					response.put("message","The reordered list contains an invalid or duplicate approval ID.");
                 					return response;
                 				}
                 				orderedRow = Budget_Approvals[ID == orderedIdText.toLong() && Proforma == proformaIdLong];
                 				if(orderedRow.ID == null)
                 				{
                 					response.put("success",false);
                 					response.put("message","The reordered list contains an approval that is not attached to this Pro Forma.");
                 					return response;
                 				}
                 				seenIds.put(orderedIdText,true);
                 			}
                 			// Temporary values avoid conflicting with any existing Sort_Order validation.
                 			tempOrder = 1001;
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedRow = Budget_Approvals[ID == orderedIdValue.toString().trim().toLong()];
                 				orderedRow.Sort_Order=tempOrder;
                 				tempOrder = tempOrder + 1;
                 			}
                 			finalOrder = 1;
                 			for each  orderedIdValue in orderedIdList
                 			{
                 				orderedRow = Budget_Approvals[ID == orderedIdValue.toString().trim().toLong()];
                 				orderedRow.Sort_Order=finalOrder;
                 				finalOrder = finalOrder + 1;
                 			}
                 			response.put("success",true);
                 			response.put("message","Approval order saved.");
                 			return response;
                 		}
                 		response.put("success",false);
                 		response.put("message","Unsupported approval configuration action: " + actionText);
                 	}	catch (e)
                 	{
                 		response.put("success",false);
                 		response.put("message",e.toString());
                 	}
                 	return response;
                 }
