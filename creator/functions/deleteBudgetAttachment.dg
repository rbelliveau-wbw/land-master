				 string deleteBudgetAttachment(string budgetId, string attachmentId)
                 {
                 	/********* DELETE CHILD ATTACHMENT RECORD *********/
                 	vBudgetId = ifnull(budgetId,"").trim();
                 	vAttachmentId = ifnull(attachmentId,"").trim();
                 	if(vBudgetId == "" || vAttachmentId == "")
                 	{
                 		return "Missing Budget ID or attachment ID.";
                 	}
                 	attachmentRows = Contract_Version[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 	if(attachmentRows.count() == 0)
                 	{
                 		return "Attachment record was not found for this budget.";
                 	}
                 	try 
                 	{
                 		delete from Contract_Version[ID == vAttachmentId.toLong() && Budget == vBudgetId.toLong()];
                 		return "Attachment deleted.";
                 	}	catch (deleteError)
                 	{
                 		return "Attachment deletion failed: " + deleteError.toString();
                 	}
                 	return "gj";
                 }
