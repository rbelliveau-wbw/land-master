string Plat_AI_Ingest(string payload)
{
	// AI transcription of ONE image tile cut from a recorded subdivision plat into lot rows.
	// Called by Custom API Ingest_Plat (Production) / Ingest_Plat_DEV (Development) from the
	// Manage Lots widget ("Import Plat"). The widget tiles the plat client-side, sends one tile
	// per call, merges the rows, and the accounting team verifies them before any Lots insert.
	// Entire JSON: the whole POST body arrives as this single string arg (Save_PF pattern).
	// Payload: {"mode":"ping"|"tile", "subdivisionName":"...", "subdivisionCode":"TRB05",
	//           "tileIndex":3, "tileCount":28, "row":1, "col":3, "rows":4, "cols":7, "page":1,
	//           "mime":"image/jpeg", "image":"<base64 without the data: prefix>",
	//           "overviewMime":"image/jpeg", "overview":"<base64 whole sheet, tile outlined>",
	//           "text":"<labels from the PDF text layer inside this tile, 'str@x,y rR sS | ...'>", "textCount":123,
	//           "requestedBy":"email"}
	// Returns:  {success, mode, provider, model, tileIndex, kind, rows:[{lot, block, area, width}],
	//            totals:{lots, blocks}, usage, raw}
	// Provider + model come from the Settings singleton (AI Review section). The key never
	// appears in code: the call goes through the "openai" Connection.
	resp = Map();
	try
	{
		// ---- 1. Parse the payload ---------------------------------------------
		// Deluge string helpers (trim, startsWith, contains, replaceAll, matches) run a regex
		// that aborts past 50 ms / 100,000 iterations: "The regex match is taking more than
		// 50ms or going beyond 100000 iterations." A tile payload is 200-400 KB of base64, so
		// never call them on the whole payload or on the image - inspect a short prefix instead.
		// left(n) throws "index values were invalid" when n exceeds the string length, so every
		// left() below is guarded by length() first.
		data = Map();
		head = payload;
		if(payload.length() > 20)
		{
			head = payload.left(20);
		}
		if(head.trim().startsWith("{"))
		{
			data = payload.toMap();
			if(data.get("payload") != null)
			{
				data = data.get("payload").toString().toMap();
			}
		}
		mode = ifnull(data.get("mode"),"tile").toString().trim().toLowerCase();
		requestedBy = ifnull(data.get("requestedBy"),zoho.loginuserid).toString().trim();
		// ---- 2. Provider/model from the Settings singleton -----------------------
		provider = "openai";
		model = "gpt-5.6-luna";
		criteria = "";
		for each  s in Settings[ID != 0]
		{
			provider = ifnull(s.PF_Review_Provider,"").toString().trim().toLowerCase();
			model = ifnull(s.PF_Review_Model,"").toString().trim();
			// Plat_Review_Criteria (long text on Settings) replaces the built-in transcription
			// instructions when filled in. Leave it empty to use the default below.
			criteria = ifnull(s.Plat_Review_Criteria,"").toString().trim();
			break;
		}
		if(provider == "")
		{
			provider = "openai";
		}
		if(model == "")
		{
			model = "gpt-5.6-luna";
		}
		resp.put("provider",provider);
		resp.put("model",model);
		resp.put("mode",mode);
		if(provider != "openai")
		{
			// Deluge takes the connection name as a literal, so a second provider needs its own
			// Connection and invokeurl block.
			resp.put("success",false);
			resp.put("error","Provider '" + provider + "' is not wired yet. Set PF Review Provider to openai on the Settings page.");
			return resp.toString();
		}
		if(mode == "ping")
		{
			// The widget pings when the modal opens: proves the API is published here and shows the model.
			resp.put("success",true);
			return resp.toString();
		}
		// No trim() on the image: it is the 200-400 KB base64 body (see the regex note above).
		image = ifnull(data.get("image"),"").toString();
		mime = ifnull(data.get("mime"),"image/jpeg").toString().trim();
		if(image.length() == 0)
		{
			resp.put("success",false);
			resp.put("error","No image tile was sent.");
			return resp.toString();
		}
		if(mime != "image/jpeg" && mime != "image/png" && mime != "image/webp")
		{
			mime = "image/jpeg";
		}
		// Optional second image: the whole sheet, downscaled, with this tile outlined in magenta.
		// Same rule as the tile - no trim() on a base64 body.
		overview = ifnull(data.get("overview"),"").toString();
		overviewMime = ifnull(data.get("overviewMime"),"image/jpeg").toString().trim();
		if(overviewMime != "image/jpeg" && overviewMime != "image/png" && overviewMime != "image/webp")
		{
			overviewMime = "image/jpeg";
		}
		// Optional text-layer labels (CAD plats only). Up to ~40 KB - no trim() or regex on it.
		textLabels = ifnull(data.get("text"),"").toString();
		tileIndex = ifnull(data.get("tileIndex"),0).toString();
		tileCount = ifnull(data.get("tileCount"),0).toString();
		tileRow = ifnull(data.get("row"),0).toString();
		tileCol = ifnull(data.get("col"),0).toString();
		gridRows = ifnull(data.get("rows"),0).toString();
		gridCols = ifnull(data.get("cols"),0).toString();
		pageNo = ifnull(data.get("page"),1).toString();
		subName = ifnull(data.get("subdivisionName"),"").toString().trim();
		subCode = ifnull(data.get("subdivisionCode"),"").toString().trim();
		resp.put("tileIndex",tileIndex);
		// ---- 3. Prompt ---------------------------------------------------------
		// The model transcribes; it never fills gaps. Anything it cannot read is left out so the
		// widget's block-gap check surfaces it for a human instead of a guess landing in Lots.
		systemMsg = "You are a meticulous data-entry clerk transcribing a recorded subdivision plat for a Texas residential land developer. " + "You receive ONE image tile cut from a larger plat sheet; neighbouring tiles overlap it, so partial rows at the edges are covered elsewhere. " + "The tile may show: (a) LOT SIZE TABLES whose columns are, in this order, LOT #, BLOCK #, AREA (SQ FT), WIDTH (FT) - the header row may be cut off, so trust the column order; " + "(b) part of the plat drawing, where each lot polygon carries its lot number and each block is labelled BLOCK n (the block label may sit far from some of its lots); " + "(c) unrelated content such as notes, signatures, certificates, curve tables, legends, street tables, or the location map - these produce no rows. " + "Transcribe EVERY lot that is fully legible in this tile, one row per lot. Copy numbers exactly as printed. " + "Never invent, infer, interpolate, or continue a sequence; if a value is cut off or unreadable, use null for area/width, and omit the row entirely when the lot number itself is unreadable. " + "If the block for a lot is not visible in this tile, set block to null rather than guessing. " + "When a second image is supplied it is the whole sheet with this tile outlined in a magenta box: use it only to see which block label each lot in the tile belongs to and whether the lot lies inside the bold subdivision boundary; read lot numbers, widths and areas from the tile image only. " + "When the message lists TEXT LAYER LABELS, they are the exact strings printed on the sheet inside this tile, each as string@x,y rR sS where x,y are pixels from the tile's top-left corner, R is rotation in degrees (0 = upright) and S is the font size in points. Every lot number, block number and width you output MUST be copied from one of those labels; a number that is not in the list is not on the sheet. Use the image to decide which labels are lot numbers (upright integers centred in lot polygons inside the bold boundary), which are circled block numbers (usually a larger font, one per block), and which frontage dimension belongs to each lot (the dimension label nearest the lot's street side, parallel to it). " + "Reply with ONE JSON object and nothing else, exactly this shape: " + "{\"kind\":\"table|drawing|none\",\"rows\":[{\"lot\":\"1\",\"block\":\"4\",\"area\":7187,\"width\":77}],\"totals\":{\"lots\":148,\"blocks\":4}}. " + "lot is the lot label as printed (a string, usually an integer); block is the block identifier as printed without the word BLOCK; area and width are numbers or null. " + "Include totals ONLY when a printed TOTAL LOTS or TOTAL BLOCKS figure is visible in this tile; otherwise omit the totals key. Use kind none and an empty rows array when the tile holds no lot data.";
		if(criteria != "")
		{
			systemMsg = criteria;
		}
		userText = "Subdivision: " + if(subName == "","(not given)",subName) + if(subCode == "",""," (code " + subCode + ")") + ". " + "Sheet page " + pageNo + ", tile " + tileIndex + " of " + tileCount + " (grid row " + tileRow + " of " + gridRows + ", column " + tileCol + " of " + gridCols + "). " + "Transcribe every legible lot in this tile.";
		if(textLabels.length() > 0)
		{
			userText = userText + " TEXT LAYER LABELS in this tile (string@x,y rR sS, separated by ' | '): " + textLabels;
		}
		textPart = Map();
		textPart.put("type","text");
		textPart.put("text",userText);
		imageUrl = Map();
		imageUrl.put("url","data:" + mime + ";base64," + image);
		imageUrl.put("detail","high");
		imagePart = Map();
		imagePart.put("type","image_url");
		imagePart.put("image_url",imageUrl);
		parts = List();
		parts.add(textPart);
		parts.add(imagePart);
		if(overview.length() > 0)
		{
			ovText = Map();
			ovText.put("type","text");
			ovText.put("text","Second image: the whole sheet, with the tile above outlined in a magenta box. Use it only to find the block label for each lot in the tile and to confirm the lot is inside the bold subdivision boundary.");
			ovUrl = Map();
			ovUrl.put("url","data:" + overviewMime + ";base64," + overview);
			ovUrl.put("detail","high");
			ovPart = Map();
			ovPart.put("type","image_url");
			ovPart.put("image_url",ovUrl);
			parts.add(ovText);
			parts.add(ovPart);
		}
		sysMap = Map();
		sysMap.put("role","system");
		sysMap.put("content",systemMsg);
		usrMap = Map();
		usrMap.put("role","user");
		usrMap.put("content",parts);
		messages = List();
		messages.add(sysMap);
		messages.add(usrMap);
		fmt = Map();
		fmt.put("type","json_object");
		body = Map();
		body.put("model",model);
		body.put("messages",messages);
		body.put("response_format",fmt);
		// max_completion_tokens is accepted by every current chat model; max_tokens is rejected by the gpt-5 family.
		// A dense table tile is ~60 rows (~1,500 tokens); reasoning models spend part of the budget thinking.
		body.put("max_completion_tokens",6000);
		// Transcription is perception-bound: low reasoning effort is faster and just as accurate.
		// Models without reasoning reject the argument, so the call retries without it below.
		body.put("reasoning_effort","low");
		hdrs = Map();
		hdrs.put("Content-Type","application/json");
		// ---- 4. Call the model through the "openai" Connection (key never in code) ----
		apiResp = invokeurl
		[
			url :"https://api.openai.com/v1/chat/completions"
			type :POST
			parameters:body.toString()
			headers:hdrs
			connection:"openai"
		];
		respMap = apiResp.toString().toMap();
		if(respMap.get("error") != null)
		{
			errObj = respMap.get("error").toString();
			errMsg = errObj;
			if(errObj.startsWith("{"))
			{
				errMsg = ifnull(errObj.toMap().get("message"),errObj).toString();
			}
			if(errMsg.containsIgnoreCase("reasoning"))
			{
				// Non-reasoning model: retry once without the reasoning_effort argument.
				body.remove("reasoning_effort");
				apiResp = invokeurl
				[
					url :"https://api.openai.com/v1/chat/completions"
					type :POST
					parameters:body.toString()
					headers:hdrs
					connection:"openai"
				];
				respMap = apiResp.toString().toMap();
				if(respMap.get("error") != null)
				{
					errObj = respMap.get("error").toString();
					errMsg = errObj;
					if(errObj.startsWith("{"))
					{
						errMsg = ifnull(errObj.toMap().get("message"),errObj).toString();
					}
					resp.put("success",false);
					resp.put("error","Model call failed: " + errMsg);
					return resp.toString();
				}
			}
			else
			{
				resp.put("success",false);
				resp.put("error","Model call failed: " + errMsg);
				return resp.toString();
			}
		}
		choices = respMap.get("choices");
		if(choices == null || choices.size() == 0)
		{
			resp.put("success",false);
			resp.put("error","Model returned no choices.");
			return resp.toString();
		}
		content = ifnull(choices.get(0).get("message").get("content"),"").toString().trim();
		content = content.replaceAll("```json","").replaceAll("```","").trim();
		if(!content.startsWith("{"))
		{
			resp.put("success",false);
			snippet = content;
			if(content.length() > 200)
			{
				snippet = content.left(200);
			}
			resp.put("error","Model reply was not JSON: " + snippet);
			return resp.toString();
		}
		// ---- 5. Forward the rows; the widget validates, merges, and flags them ----
		parsed = content.toMap();
		resp.put("success",true);
		resp.put("kind",ifnull(parsed.get("kind"),"").toString());
		resp.put("rows",ifnull(parsed.get("rows"),List()));
		if(parsed.get("totals") != null)
		{
			resp.put("totals",parsed.get("totals"));
		}
		raw = content;
		if(content.length() > 12000)
		{
			raw = content.left(12000);
		}
		resp.put("raw",raw);
		resp.put("usage",ifnull(respMap.get("usage"),Map()));
		resp.put("requestedBy",requestedBy);
	}
	catch (e)
	{
		resp.put("success",false);
		resp.put("error",e.toString());
	}
	return resp.toString();
}
