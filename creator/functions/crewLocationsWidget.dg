string crewLocationsWidget(string payload)
{
	response = {"ok":false,"unknown":false}; phaseId = ""; operationId = ""; acquired = false; writeUncertain = false; confirmed = List(); savedRecords = List();
	try
	{
		config = thisapp.crewLocationsConfig();
		response.put("testingMode",false); response.put("creatorOnly",true); response.put("projectsPushEnabled",false); response.put("environment",config.get("environment"));
		if(zoho.loginuser == null || zoho.loginuser == "" || zoho.loginuser == "public") { response.put("message","An authenticated Creator session is required."); return response.toString(); }
		if(payload == null || payload.length() > 48000) { response.put("message","Schedule request exceeds its supported size."); return response.toString(); }
		request = payload.toMap(); action = ifnull(request.get("action"),"").toString(); response.put("action",action);
		allowedEnvironments = {"development","stage","production"};
		if(config.get("enabled") != true || config.get("creatorOnly") != true || config.get("projectsPushEnabled") != false || !allowedEnvironments.contains(config.get("environment"))) { response.put("message","Creator-only scheduling has not been enabled."); return response.toString(); }
		access = User_Access[User == zoho.loginuser];
		if(access.count() != 1 || access.View_Crew_Locations != true) { response.put("message","Crew Locations access has not been granted."); return response.toString(); }
		if(action == "capabilities")
		{
			response.put("permissions",{"view":true,"milestones":access.Edit_Crew_Milestones == true,"tasks":access.Edit_Crew_Task_Dates == true && config.get("taskWritesVerified") == true,"assignments":access.Manage_Crew_Assignments == true});
			response.put("sources",{"crews":config.get("crewsEnabled") == true,"tasks":config.get("tasksEnabled") == true});
			dependencies = List();
			if(config.get("crewsEnabled") != true) { dependencies.add("Crew source: configure verified assignment dates and explicit external job-to-Subdivision mappings before enabling crew imports."); }
			if(config.get("tasksEnabled") != true) { dependencies.add("Task source: verify the T-row source, stage mapping and date columns before enabling the task mirror."); }
			if(config.get("taskWritesVerified") != true) { dependencies.add("Task editing is unavailable until its local/source write semantics are verified."); }
			dependencies.add("Dates save to Creator only with Push_Update false. Daily inbound Analytics sync may replace them.");
			response.put("dependencies",dependencies); response.put("ok",true); return response.toString();
		}
		phaseId = ifnull(request.get("subdivisionId"),"").toString();
		if(!phaseId.matches("[0-9]+")) { response.put("message","A valid phase ID is required."); return response.toString(); }
		phaseRead = thisapp.crewLocationsRead("All_Subdivisions","ID == " + phaseId);
		if(phaseRead.get("ok") != true || phaseRead.get("records").size() != 1) { response.put("message","This phase is unavailable to the current user."); return response.toString(); }
		if(action == "history")
		{
			operations = List(); readable = List();
			historyMilestones = thisapp.crewLocationsRead("All_Milestones","Subdivision1 == " + phaseId);
			if(historyMilestones.get("ok") == true) { for each historySource in historyMilestones.get("records") { readable.add("M:" + historySource.get("ID").toString()); } }
			if(config.get("tasksEnabled") == true)
			{
				historyTasks = thisapp.crewLocationsRead("All_Task_Schedules","Subdivision1 == " + phaseId);
				if(historyTasks.get("ok") == true) { for each historySource in historyTasks.get("records") { readable.add("T:" + historySource.get("ID").toString()); } }
			}
			for each entry in Schedule_Change_Log[Subdivision1 == phaseId.toLong()] sort by ID desc range from 0 to 49
			{
				canRead = true; historyChanges = entry.Request_JSON.toMap().get("changes");
				for each historyChange in historyChanges { if(!readable.contains(historyChange.get("type") + ":" + historyChange.get("recordId"))) { canRead = false; } }
				if(canRead) { operations.add({"operationId":entry.Operation_ID,"origin":entry.Origin,"state":entry.State,"actor":entry.Actor,"timestamp":entry.Timestamp.toString("MM/dd/yyyy HH:mm:ss"),"changes":historyChanges}); }
			}
			response.put("operations",operations); response.put("ok",true); return response.toString();
		}
		operationId = ifnull(request.get("operationId"),"").toString();
		if(!operationId.matches("[a-fA-F0-9-]{36}")) { response.put("message","A valid operation ID is required."); return response.toString(); }
		if(action == "status")
		{
			response = thisapp.crewLocationsStatus(operationId,phaseId); response.put("action",action); response.put("testingMode",false); response.put("creatorOnly",true); response.put("projectsPushEnabled",false); response.put("environment",config.get("environment")); return response.toString();
		}
		if(action != "apply") { response.put("message","Unknown schedule action."); return response.toString(); }
		existing = Schedule_Change_Log[Operation_ID == operationId];
		if(existing.count() > 0)
		{
			if(existing.Actor != zoho.loginuser || existing.Request_JSON != payload || existing.Subdivision1 != phaseId.toLong()) { response.put("message","Operation ID was already used for a different request."); return response.toString(); }
			response = thisapp.crewLocationsStatus(operationId,phaseId); response.put("action",action); response.put("testingMode",false); response.put("creatorOnly",true); response.put("projectsPushEnabled",false); response.put("environment",config.get("environment")); return response.toString();
		}
		// Unique Phase_Key gives one scheduling operation exclusive use of a phase.
		// Every protected direct edit and the inbound importer must honor this lock.
		lockId = insert into Crew_Schedule_Lock
		[
			Phase_Key=phaseId
			Subdivision1=phaseId.toLong()
			Operation_ID=operationId
			Actor=zoho.loginuser
			Acquired_At=zoho.currenttime
			Added_User=zoho.loginuser
		];
		acquired = true;
		logId = insert into Schedule_Change_Log
		[
			Operation_ID=operationId
			Operation_Type="creator_only_schedule"
			Actor=zoho.loginuser
			Timestamp=zoho.currenttime
			Subdivision1=phaseId.toLong()
			Origin=request.get("origin")
			Request_JSON=payload
			State="validating"
			Execution_Finished=false
			Duration_Operation_ID=ifnull(request.get("durationOperationId"),"")
			Reverses_Operation_ID=ifnull(request.get("reversesOperationId"),"")
			Added_User=zoho.loginuser
		];
		log = Schedule_Change_Log[ID == logId];
		plan = thisapp.crewLocationsValidate(request);
		if(plan.get("ok") != true)
		{
			response.put("message",plan.get("message")); response.put("state","rejected"); response.put("operationId",operationId); response.put("confirmed",confirmed); response.put("records",savedRecords);
			log.Result_JSON=response.toString(); log.Execution_Finished=true; log.State="rejected";
			delete from Crew_Schedule_Lock[(Phase_Key == phaseId) && (Operation_ID == operationId)];
			return response.toString();
		}
		log.State="saving";
		for each target in plan.get("payloads")
		{
			// Recheck all before-values, status and rights before starting writes, then
			// validate each subsequent target against its original before-values.
			currentRequest = request;
			if(confirmed.size() > 0)
			{
				currentRequest = Map(); currentRequest.put("subdivisionId",phaseId); currentRequest.put("origin","table");
				for each originalChange in request.get("changes") { if(originalChange.get("recordId") == target.get("recordId")) { currentRequest.put("changes",{originalChange}); } }
			}
			fresh = thisapp.crewLocationsValidate(currentRequest);
			if(fresh.get("ok") != true) { response.put("message",fresh.get("message")); break; }
			key = target.get("type") + ":" + target.get("recordId");
			if(Crew_Test_Record[Record_Key == key].count() == 0)
			{
				markerId = insert into Crew_Test_Record
				[
					Record_Key=key
					Subdivision1=phaseId.toLong()
					First_Operation_ID=operationId
					Created_At=zoho.currenttime
					Added_User=zoho.loginuser
				];
			}
			log.Inflight_Record_Key=key;
			fields = {"Start_Date","End_Date"};
			body = {"data":target.get("patch"),"result":{"fields":fields}};
			headers = {"environment":config.get("environmentLink"),"Content-Type":"application/json"};
			writeUncertain = true;
			ack = invokeurl
			[
				url :config.get("baseUrl") + target.get("report") + "/" + target.get("recordId")
				type :PATCH
				parameters:body.toString()
				headers:headers
				connection:"zoho_creator_connection"
			];
			if(ack.get("code") != null && ack.get("code").toString() != "3000")
			{
				writeUncertain = false;
				nativeDetails = ifnull(ack.get("message"),ifnull(ack.get("error"),ifnull(ack.get("data"),"Details unavailable."))).toString();
				response.put("nativeCode",ack.get("code"));
				response.put("message","Creator rejected the schedule update (" + ack.get("code") + "): " + nativeDetails);
				break;
			}
			if(ack.get("code") == null || ack.get("data") == null || ack.get("data").get("ID").toString() != target.get("recordId") || ack.get("error") != null || ack.get("success") == false)
			{
				response.put("message","Creator did not return an unambiguous destination acknowledgement."); break;
			}
			confirmed.add({"type":target.get("type"),"recordId":target.get("recordId")});
			writeUncertain = false; log.Inflight_Record_Key="";
			// Native returned field values are used, without post-save equality gating.
			returned = ack.get("data");
			if(returned.keys().contains("Start_Date") && returned.keys().contains("End_Date"))
			{
				try
				{
					savedRecords.add({"type":target.get("type"),"id":target.get("recordId"),"start":thisapp.crewLocationsIso(ifnull(returned.get("Start_Date"),"").toString()),"end":thisapp.crewLocationsIso(ifnull(returned.get("End_Date"),"").toString())});
				}
				catch(displayRefreshError) { response.put("displayRefreshNeeded",true); }
			}
			response.put("confirmed",confirmed); response.put("records",savedRecords); log.Result_JSON=response.toString();
		}
		state = "partial"; success = confirmed.size() == request.get("changes").size();
		if(success) { state = "saved"; }
		if(writeUncertain) { state = "unknown"; }
		response.put("ok",success); response.put("unknown",writeUncertain); response.put("state",state); response.put("operationId",operationId); response.put("confirmed",confirmed); response.put("records",savedRecords);
		// Publish the complete result before the terminal state so read-only status
		// recovery cannot observe a saved state with an older, incomplete ledger.
		log.Result_JSON=response.toString(); log.Execution_Finished=true; log.State=state;
		if(!writeUncertain) { delete from Crew_Schedule_Lock[(Phase_Key == phaseId) && (Operation_ID == operationId)]; }
	}
	catch(scheduleError)
	{
		response.put("message",scheduleError.toString()); response.put("unknown",writeUncertain); response.put("operationId",operationId); response.put("confirmed",confirmed); response.put("records",savedRecords);
		if(acquired)
		{
			entry = Schedule_Change_Log[Operation_ID == operationId];
			if(entry.count() == 1) { failureState = "partial"; if(writeUncertain) { failureState = "unknown"; } response.put("state",failureState); entry.Result_JSON=response.toString(); entry.Execution_Finished=true; entry.Error=scheduleError.toString(); entry.State=failureState; }
			if(!writeUncertain) { delete from Crew_Schedule_Lock[(Phase_Key == phaseId) && (Operation_ID == operationId)]; }
		}
	}
	return response.toString();
}
