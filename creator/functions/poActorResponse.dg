map poActorResponse(map response, string userAccessId)
{
	 environmentType = thisapp.environment.type;
	// All callers authenticate userAccessId before this private projection.
	if(response.get("success") == true && response.get("snapshot") != null && userAccessId != null && userAccessId.matches("[0-9]+"))
	{
		editActor = User_Access[ID == userAccessId.toLong()]; editSnapshot = response.get("snapshot"); editBudget = Add_Budget[ID == ifnull(editSnapshot.get("budgetId"),"0").toString().toLong()];
		editSnapshot.put("canEditInFlight",editActor.count() == 1 && editActor.Edit_All_Budgets == true && editBudget.count() == 1 && editBudget.Archived != true && editSnapshot.get("status") == "Submitted" && editSnapshot.get("approvalState") == "Pending");
		response.put("snapshot",editSnapshot);
	}
	// Permission hints are projected only after the caller has authenticated the actor.
	// This changes the Development preview display, never a Production grant.
	if(environmentType == "Development" && zoho.loginuser == zoho.adminuser && response.get("success") == true && response.get("snapshot") != null && userAccessId != null && userAccessId.matches("[0-9]+"))
	{
		actor = User_Access[ID == userAccessId.toLong()];
		if(actor.count() == 1)
		{
			snapshot = response.get("snapshot"); bundle = snapshot.get("approvalBundle");
			if(bundle != null)
			{
				active = bundle.get("active");
				canApprove = active.get("userAccessId") == userAccessId;
				bundle.put("canApprove",canApprove);
				bundle.put("canRetryEmail",canApprove || bundle.get("submitterId") == userAccessId || actor.User == zoho.adminuser);
				snapshot.put("approvalBundle",bundle); response.put("snapshot",snapshot);
			}
		}
	}
	return response;
}
