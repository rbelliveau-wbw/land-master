map poValidatePayload(string payload)
{
	result = {"success":false,"writeState":"not-started"};
	uoms = {"CY","EA","LB","LF","LOTS","LS","S","SET","SF","SY","TN","VF","WK"};
	costElements = {"1","2","3","4","5"};
	try
	{
		if(payload.length() > 500000)
		{
			result.put("error","PO exceeds the supported request size.");
			return result;
		}
		p = payload.toMap();
		action = ifnull(p.get("action"),"");
		if(action != "Save" && action != "Submit")
		{
			result.put("error","Action must be Save or Submit.");
			return result;
		}
		for each  idField in {"budgetId","vendorId"}
		{
			typedValue = Map();
			typedValue.put("value",p.get(idField));
			if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
			{
				result.put("error","Phase and vendor IDs must be strings.");
				return result;
			}
		}
		typedValue = Map();
		typedValue.put("value",p.get("amount"));
		if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
		{
			result.put("error","Amount must be an exact decimal string.");
			return result;
		}
		if(p.get("description") != null)
		{
			typedValue = Map();
			typedValue.put("value",p.get("description"));
			if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\".*\"[ ]*[}][ ]*") || p.get("description").toString().length() > 1000)
			{
				result.put("error","PO Description must be text, maximum 1000 characters.");
				return result;
			}
		}
		amount = thisapp.poCurrencyString(ifnull(p.get("amount"),"").toString());
		if(p.get("budgetModificationId") != null)
		{
			typedValue = Map();
			typedValue.put("value",p.get("budgetModificationId"));
			if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
			{
				result.put("error","Linked budget modification must be an exact ID string or null.");
				return result;
			}
		}
		p.put("budgetModificationId",p.get("budgetModificationId"));
		if(amount == "" || amount.replaceAll("[.]","").toLong() <= 0)
		{
			result.put("error","Enter a positive PO amount, with at most two decimal places.");
			return result;
		}
		token = ifnull(p.get("token"),"").toString();
		if(!token.matches("[A-Za-z0-9-]{20,80}"))
		{
			result.put("error","A unique operation token is required.");
			return result;
		}
		for each  dateField in {"requestDate","dateNeeded"}
		{
			dateText = ifnull(p.get(dateField),"").toString();
			if(!dateText.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}") || dateText.toDate("yyyy-MM-dd").toString("yyyy-MM-dd") != dateText)
			{
				result.put("error","Both valid request dates are required.");
				return result;
			}
		}
		lines = p.get("lines");
		if(lines == null || lines.size() == 0 || lines.size() > 250)
		{
			result.put("error","Enter 1–250 complete PO lines.");
			return result;
		}
		keys = List();
		grouped = Map();
		groupedComponents = Map();
		totalCents = 0;
		for each  line in lines
		{
			key = ifnull(line.get("key"),"").toString();
			itemId = ifnull(line.get("budgetItemId"),"").toString();
			if(!key.matches("[A-Za-z0-9-]{1,80}") || keys.contains(key))
			{
				result.put("error","Line keys must be unique.");
				return result;
			}
			keys.add(key);
			typedValue = Map();
			typedValue.put("value",line.get("budgetItemId"));
			if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
			{
				result.put("error","Budget Item IDs must be strings.");
				return result;
			}
			description = ifnull(line.get("description"),"").toString();
			if(description.trim() == "" || description.length() > 1000)
			{
				result.put("error","Each line requires a Description (maximum 1000 characters).");
				return result;
			}
			if(!uoms.contains(line.get("uom")))
			{
				result.put("error","Each line requires a valid UOM.");
				return result;
			}
			if(!costElements.contains(line.get("costElement")))
			{
				result.put("error","Cost Element must be 1–5.");
				return result;
			}
			typedValue = Map();
			typedValue.put("value",line.get("finalAmount"));
			if(!typedValue.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
			{
				result.put("error","Final Amount must be an exact decimal string.");
				return result;
			}
			finalAmount = thisapp.poCurrencyString(ifnull(line.get("finalAmount"),"").toString());
			if(finalAmount == "" || finalAmount.replaceAll("[.]","").toLong() < 0)
			{
				result.put("error","Each Final Amount must be valid nonnegative currency.");
				return result;
			}
			if(line.get("pricingMode") == "Manual")
			{
				if(!line.keys().contains("quantity") || !line.keys().contains("unitPrice") || line.get("quantity") != null || line.get("unitPrice") != null)
				{
					result.put("error","Manual lines require explicit null Quantity and Unit Price.");
					return result;
				}
			}
			else if(line.get("pricingMode") == "Calculated")
			{
				quantityType = Map();
				quantityType.put("value",line.get("quantity"));
				priceType = Map();
				priceType.put("value",line.get("unitPrice"));
				if(!quantityType.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,6})?\"[ ]*[}][ ]*") || !priceType.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
				{
					result.put("error","Quantity and Unit Price must be exact decimal strings.");
					return result;
				}
				line.put("unitPrice",thisapp.poCurrencyString(line.get("unitPrice")));
				calculated = thisapp.poMultiplyExact(ifnull(line.get("quantity"),"").toString(),ifnull(line.get("unitPrice"),"").toString());
				if(calculated == "" || calculated != finalAmount)
				{
					result.put("error","Quantity × Unit Price does not match Final Amount.");
					return result;
				}
			}
			else
			{
				result.put("error","Unknown pricing mode.");
				return result;
			}
			cents = finalAmount.replaceAll("[.]","").toLong();
			if(totalCents > 999999999999999 - cents)
			{
				result.put("error","Line total exceeds currency capacity.");
				return result;
			}
			totalCents = totalCents + cents;
			grouped.put(itemId,ifnull(grouped.get(itemId),0) + cents);
			componentKey = itemId + "|" + line.get("costElement");
			groupedComponents.put(componentKey,ifnull(groupedComponents.get(componentKey),0) + cents);
			line.put("finalAmount",finalAmount);
		}
		if(action == "Submit" && totalCents != amount.replaceAll("[.]","").toLong())
		{
			result.put("error","Line totals must equal the full PO amount exactly.");
			return result;
		}
		if(p.get("reallocation") != null)
		{
			reallocation = p.get("reallocation").toString().toMap();
			if(reallocation.get("contract") != "po-reallocation-v1" || reallocation.get("items") == null || reallocation.get("items").size() > 250)
			{
				result.put("error","Unsupported PO budget modification contract."); return result;
			}
			reallocationItems = List(); reallocationIds = List();
			for each rawReallocation in reallocation.get("items")
			{
				reallocationItem = rawReallocation.toString().toMap();
				reallocationId = reallocationItem.get("budgetItemId");
				typedReallocationId = {"value":reallocationId};
				if(!typedReallocationId.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*") || grouped.get(reallocationId) == null || reallocationIds.contains(reallocationId))
				{
					result.put("error","Each budget modification must reference one selected PO Budget Item exactly once."); return result;
				}
				reallocationIds.add(reallocationId);
				if(reallocationItem.get("components") == null || reallocationItem.get("components").keys().size() != 5)
				{
					result.put("error","All five signed budget modification components are required."); return result;
				}
				canonicalComponents = Map(); componentCents = Map(); netCents = 0; grossCents = 0;
				for each reallocationElement in costElements
				{
					rawDelta = reallocationItem.get("components").get(reallocationElement);
					typedDelta = {"value":rawDelta};
					if(!typedDelta.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"-?[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*"))
					{
						result.put("error","Budget modification components must be exact signed currency strings."); return result;
					}
					deltaSign = 1; deltaText = rawDelta;
					if(deltaText.startsWith("-")) { deltaSign = -1; deltaText = deltaText.subString(1,deltaText.length()); }
					deltaText = thisapp.poCurrencyString(deltaText);
					if(deltaText == "") { result.put("error","A budget modification component exceeds supported currency capacity."); return result; }
					deltaAbs = deltaText.replaceAll("[.]","").toLong();
					if(grossCents > 999999999999999 - deltaAbs) { result.put("error","Budget modification gross changes exceed supported currency capacity."); return result; }
					grossCents = grossCents + deltaAbs; deltaCents = deltaSign * deltaAbs; netCents = netCents + deltaCents;
					if(deltaCents < 0) { deltaText = "-" + deltaText; }
					canonicalComponents.put(reallocationElement,deltaText); componentCents.put(reallocationElement,deltaCents);
				}
				reallocationReason = ifnull(reallocationItem.get("reason"),"").toString().trim();
				// Keep this nested: Creator's native formatter can discard grouped
				// parentheses when AND and OR appear in the same condition.
				if(grossCents > 0)
				{
					if(reallocationReason == "") { result.put("error","A reason of 1–1000 characters is required for each budget modification."); return result; }
					if(reallocationReason.length() > 1000) { result.put("error","A reason of 1–1000 characters is required for each budget modification."); return result; }
				}
				reallocationItems.add({"budgetItemId":reallocationId,"components":canonicalComponents,"reason":reallocationReason});
			}
			p.put("reallocation",{"contract":"po-reallocation-v1","items":reallocationItems});
		}
		p.put("amount",amount);
		result.put("payload",p);
		result.put("groupedCents",grouped);
		result.put("groupedComponentCents",groupedComponents);
		result.put("totalCents",totalCents.toString());
		result.put("success",true);
	}	catch (e)
	{
		result.put("error","Invalid PO payload. Check dates, decimal strings and complete lines.");
	}
	return result;
}
