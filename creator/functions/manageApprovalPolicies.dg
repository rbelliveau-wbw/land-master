string manageApprovalPolicies(string payload)
{
	result = {"success":false,"contract":"approval-policy-v1","writeState":"not-started"};
	auditId = 0; lockId = 0; reconciliationOperation = false;
	try
	{
		if(payload.length() > 60000) { result.put("error","Configuration request is too large."); return result.toString(); }
		p = payload.toMap(); action = ifnull(p.get("action"),"");
		typedIdentity = Map(); typedIdentity.put("value",p.get("userAccessId"));
		if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","User Access identity must be a string."); return result.toString(); }
		// Register this administration API with OAuth2, ADMIN ONLY scope.
		// Wider scopes require a separate authenticated-caller proof and explicit admin grant.
		access = User_Access[User == zoho.loginuser];
		if(access.count() != 1 || access.ID.toString() != p.get("userAccessId") || zoho.loginuser != zoho.adminuser) { result.put("error","Application-owner configuration access is required."); return result.toString(); }
		if(action == "List") { listed=thisapp.approvalConfigurationSnapshot(); listed.put("policyModel","scope-v1"); listed.put("currentDate",zoho.currentdate.toString("yyyy-MM-dd")); listed.put("actorId",access.ID.toString()); return listed.toString(); }
		if(action == "Preview") { return thisapp.resolveApprovalRoute(p.get("context")).toString(); }
		if(action == "Reassign" || action == "EnableAdapter") { result.put("error","Reassignment authority and native workflow migration must be approved and verified first."); return result.toString(); }
		token = ifnull(p.get("token"),"").toString();
		if(action == "Check")
		{
			audit = Approval_Config_Audit[Token == token && Actor == access.ID];
			if(audit.count() == 1 && audit.Status == "Complete") { result.put("success",true); result.put("writeState","verified"); result.put("after",audit.After_JSON.toMap()); result.put("token",token); }
			else { result.put("writeState","unknown"); result.put("error","Configuration write is incomplete or unknown. Review its retained lock and audit receipt."); }
			return result.toString();
		}
		if(action != "SaveRole" && action != "SaveAssignment" && action != "SavePolicy" && action != "Publish" && action != "Reconcile") { result.put("error","Unsupported configuration action."); return result.toString(); }
		if(!token.matches("[A-Za-z0-9-]{20,80}")) { result.put("error","Unique operation token is required."); return result.toString(); }
		data = p.get("data"); reconciliationBefore = Map();
		if(action == "Reconcile")
		{
			reconciliationOperation = true;
			result.put("writeState","unknown");
			reconciliationAudit = Approval_Config_Audit[Token == token];
			reconciliationLock = Approval_Config_Lock[Lock_Key == "shared-approval-policy"];
			reconciliationStatusValid = reconciliationAudit.Status == "Started" || reconciliationAudit.Status == "Complete";
			reconciliationLockValid = reconciliationLock.count() == 1 && reconciliationLock.Operation_Token == token;
			if(reconciliationAudit.Status == "Complete" && reconciliationLock.count() == 0) { reconciliationLockValid=true; }
			if(reconciliationAudit.count() != 1 || reconciliationAudit.Actor != access.ID || reconciliationAudit.Action != "SavePolicy" || reconciliationStatusValid != true || reconciliationLockValid != true) { result.put("error","Only your PO draft save with its retained operation lock or completed receipt can be verified."); return result.toString(); }
			data = reconciliationAudit.Intended_JSON.toMap();
			if(ifnull(reconciliationAudit.Before_JSON,"") != "") { reconciliationBefore=reconciliationAudit.Before_JSON.toMap(); }
			if(data.get("workflow") != "Purchase Order") { result.put("error","Draft verification is limited to the scoped PO test configuration."); return result.toString(); }
		}
		else
		{
			if(Approval_Config_Audit[Token == token].count() > 0) { result.put("writeState","unknown"); result.put("error","Operation already exists. Use read-only Check."); return result.toString(); }
		}
		before = thisapp.approvalConfigurationSnapshot();
		if(before.get("success") != true) { return before.toString(); }
		idText = ifnull(data.get("id"),"").toString();
		if(action == "SavePolicy" || action == "Reconcile")
		{
			// Early Settings builds included these preview-only flags in a policy save. They persist no policy data.
			for each contextFlag in {"hasBudgetModification","hasBudgetOverrun"}
			{
				if(data.keys().contains(contextFlag))
				{
					typedContextFlag={"value":data.get(contextFlag)};
					if(!typedContextFlag.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*false[ ]*[}][ ]*")) { result.put("error","Preview-only PO policy flags must be explicitly false."); return result.toString(); }
					data.remove(contextFlag);
				}
			}
			policyFields={"id","companyId","workflow","territory","department","status","enabled","selfApproval","steps","adapterEnabled"};
			if(action == "Reconcile") { for each legacyField in {"version","duplicatePerson","effectiveFrom","effectiveTo"} { policyFields.add(legacyField); } }
			for each field in data.keys() { if(!policyFields.contains(field)) { result.put("error","Unsupported policy field: "+field); return result.toString(); } }
			if(data.get("status") != null && data.get("status") != "Draft" && data.get("status") != "Published") { result.put("error","Policy status is invalid."); return result.toString(); }
			if(data.get("adapterEnabled") != null && data.get("adapterEnabled") != false) { result.put("error","Policy saves cannot enable a native workflow adapter."); return result.toString(); }
		}
		identityFields = {"id"};
		if(action == "SaveAssignment") { identityFields={"id","roleId","userAccessId","companyId"}; }
		if(action == "SavePolicy" || action == "Reconcile") { identityFields={"id","companyId"}; }
		for each identityField in identityFields
		{
			identityValue = data.get(identityField);
			if(identityField == "companyId" && identityValue == "") { continue; }
			validateIdentity = identityField != "id";
			if(identityValue != null && identityValue != "") { validateIdentity = true; }
			if(validateIdentity)
			{
				typedIdentity=Map(); typedIdentity.put("value",identityValue);
				if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Configuration identities must be exact ID strings."); return result.toString(); }
			}
		}
		if(action == "SaveAssignment")
		{
		for each dateField in {"effectiveFrom","effectiveTo"}
		{
			dateValue=ifnull(data.get(dateField),"");
			if(dateValue != "")
			{
				if(!dateValue.toString().matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")) { result.put("error","Configuration dates must be valid ISO dates."); return result.toString(); }
				if(dateValue.toString().toDate("yyyy-MM-dd").toString("yyyy-MM-dd") != dateValue) { result.put("error","Configuration dates must be valid ISO dates."); return result.toString(); }
			}
		}
		}
		// Test CFO data lives only in an owner-managed PO policy, never on shared User Access or assignments.
		isPOTestPolicy = false;
		if(action == "SavePolicy" || action == "Publish" || action == "Reconcile")
		{
			testPolicyData = data;
			if(action == "Publish")
			{
				testPolicy = Approval_Policy[ID == idText.toLong()];
				if(testPolicy.ID == null) { result.put("error","Policy was not found."); return result.toString(); }
				publishedPolicySteps = List();
				for each rawPolicyStep in testPolicy.Steps_JSON.toJSONList() { publishedPolicySteps.add(rawPolicyStep.toString().toMap()); }
				testPolicyData = {"workflow":testPolicy.Workflow,"steps":publishedPolicySteps,"selfApproval":testPolicy.Self_Approval};
			}
			testPolicySteps = testPolicyData.get("steps");
			for each testPolicyStep in testPolicySteps
			{
				if(testPolicyStep.get("poTestCFO") != null)
				{
					// Historical captured routes and interrupted receipts remain readable.
					// New configuration uses the ordinary CFO assignment across budgets.
					if(action != "Reconcile") { result.put("error","Budget-specific PO test CFO overrides are no longer supported. Configure the CFO assignment for all budgets."); return result.toString(); }
					isPOTestPolicy = true;
					testCFO = testPolicyStep.get("poTestCFO");
					if(testPolicyData.get("workflow") != "Purchase Order" || testPolicySteps.size() != 1 || testPolicyStep.get("enabled") != true || testPolicyStep.get("condition") != "Always" || testPolicyData.get("selfApproval") != "Deny" || testCFO.get("allowSelfApproval") != true) { result.put("error","PO test CFO requires one enabled Always CFO step with submitter self-approval denied."); return result.toString(); }
					for each testIdentityField in {"budgetId","userAccessId"}
					{
						typedTestIdentity = {"value":testCFO.get(testIdentityField)};
						if(!typedTestIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","PO test CFO identities must be exact ID strings."); return result.toString(); }
					}
					typedTestEmail = {"value":testCFO.get("email")};
					testEmailIsString = typedTestEmail.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[^\"]+\"[ ]*[}][ ]*");
					testEmailValid = testEmailIsString && ifnull(testCFO.get("email"),"").toString().matches("[^\\s@,;<>\"]+@[^\\s@,;<>\"]+[.][^\\s@,;<>\"]+");
					typedTestAmount = {"value":testCFO.get("maxAmount")}; testMaximum = thisapp.poCurrencyString(ifnull(testCFO.get("maxAmount"),"").toString());
					if(!typedTestAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || testMaximum == "" || testMaximum.replaceAll("[.]","").toLong() <= 0 || testMaximum.replaceAll("[.]","").toLong() > 5500 || testEmailValid != true) { result.put("error","PO test CFO needs a valid email and a positive maximum of at most $55."); return result.toString(); }
					testRole = Approval_Role[ID == testPolicyStep.get("roleId").toString().toLong()]; testPerson = User_Access[ID == testCFO.get("userAccessId").toLong()]; testBudget = Add_Budget[ID == testCFO.get("budgetId").toLong()];
					if(testRole.ID == null || testRole.Active != true || testRole.Role_Name != "CFO" || testPerson.ID == null || ifnull(testPerson.User,"").toString().trim() == "" || testBudget.ID == null) { result.put("error","PO test CFO requires an active CFO role, an existing login identity and an existing budget."); return result.toString(); }
				}
			}
		}
		if(action == "SavePolicy" || action == "Reconcile")
		{
			workflows={"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
			enabledKnown = data.get("enabled") == true || data.get("enabled") == false;
			if(!workflows.contains(data.get("workflow")) || enabledKnown != true) { result.put("error","Workflow and explicit enabled setting are required."); return result.toString(); }
		}
		if(action == "SavePolicy" || action == "Publish" || action == "Reconcile")
		{
			if(testPolicyData.get("selfApproval") != "Allow" && testPolicyData.get("selfApproval") != "Deny") { result.put("error","Choose the self-approval rule."); return result.toString(); }
			if(testPolicyData.get("workflow") == "Purchase Order" && testPolicyData.get("selfApproval") != "Deny") { result.put("error","Purchase Orders forbid submitter self-approval."); return result.toString(); }
			if(testPolicySteps == null || testPolicySteps.size() == 0 || testPolicySteps.size() > 30 || testPolicySteps.toString().length() > 40000) { result.put("error","Enter 1–30 approvers."); return result.toString(); }
			stepOrder=0; configuredKeys=List();
			for each rawConfiguredStep in testPolicySteps
			{
				configuredStep=rawConfiguredStep.toString().toMap(); stepOrder=stepOrder+1;
				typedRole={"value":configuredStep.get("roleId")};
				if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Approver role must be an exact ID string."); return result.toString(); }
				configuredRole=Approval_Role[ID == configuredStep.get("roleId").toLong()];
				stepEnabledKnown=configuredStep.get("enabled") == true || configuredStep.get("enabled") == false;
				if(configuredRole.ID == null || configuredRole.Active != true || configuredStep.get("order") != stepOrder || !ifnull(configuredStep.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || configuredKeys.contains(configuredStep.get("key")) || stepEnabledKnown != true) { result.put("error","Approvers need active roles, unique keys and sequential order."); return result.toString(); }
				configuredKeys.add(configuredStep.get("key")); condition=configuredStep.get("condition"); workflow=testPolicyData.get("workflow");
				if(workflow == "Purchase Order")
				{
					if(stepOrder == 1) { if(configuredRole.Role_Name != "CFO" || condition != "Always" || configuredStep.get("enabled") != true) { result.put("error","CFO must approve every purchase order."); return result.toString(); } }
					else { if(condition != "Budget modification attached" || configuredRole.Role_Name == "CFO") { result.put("error","Additional PO approvers are used only when the PO creates budget modifications."); return result.toString(); } }
				}
				else if(workflow == "Pro Forma" || workflow == "Contract") { if(condition != "Always") { result.put("error","Pro Forma and Contract use straight approval chains."); return result.toString(); } }
				else if(condition != "Always" && condition != "Above" && condition != "At or above") { result.put("error","Unsupported approver condition."); return result.toString(); }
				if(condition == "Above" || condition == "At or above")
				{
					typedThreshold={"value":configuredStep.get("threshold")};
					if(!typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || thisapp.poCurrencyString(ifnull(configuredStep.get("threshold"),"").toString()) == "") { result.put("error","Threshold must be exact currency."); return result.toString(); }
				}
			}
		}
		if(action == "Reconcile")
		{
			// Verify an already written draft. Never replay the policy save or replace its retained lock.
			if(isPOTestPolicy != true) { result.put("error","Draft verification requires the validated scoped PO test step."); return result.toString(); }
			if(idText == "")
			{
				if(reconciliationBefore.keys().size() != 0) { result.put("error","New-draft receipt has an unexpected previous record."); return result.toString(); }
			}
			else
			{
				if(reconciliationBefore.get("id") != idText || reconciliationBefore.get("status") != "Draft") { result.put("error","Edited-draft receipt does not identify the previous Draft."); return result.toString(); }
			}
			if(data.get("status") != null && data.get("status") != "Draft") { result.put("error","Only a Draft save can be verified."); return result.toString(); }
			if(data.get("adapterEnabled") != null && data.get("adapterEnabled") != false) { result.put("error","Native workflow migration cannot be enabled by draft verification."); return result.toString(); }
			found = Map(); matches = 0;
			reconciliationCompletedAfter = Map();
			if(reconciliationAudit.Status == "Complete")
			{
				if(ifnull(reconciliationAudit.After_JSON,"") == "") { result.put("error","Completed draft receipt has no verified record."); return result.toString(); }
				reconciliationCompletedAfter=reconciliationAudit.After_JSON.toMap();
				typedCompletedIdentity={"value":reconciliationCompletedAfter.get("id")};
				if(!typedCompletedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Completed draft receipt identity is invalid."); return result.toString(); }
				if(reconciliationCompletedAfter.get("status") != "Draft" || reconciliationCompletedAfter.get("adapterEnabled") != false || ifnull(reconciliationCompletedAfter.get("id"),"").toString() == "") { result.put("error","Completed draft receipt is invalid."); return result.toString(); }
			}
			reconciliationConfiguration=before.get("configuration"); reconciliationPolicies=reconciliationConfiguration.get("policies");
			for each candidate in reconciliationPolicies
			{
				candidateMatches = candidate.get("status") == "Draft" && candidate.get("adapterEnabled") == false;
				if(idText != "" && candidate.get("id") != idText) { candidateMatches=false; }
				if(reconciliationAudit.Status == "Complete" && candidate.get("id") != reconciliationCompletedAfter.get("id")) { candidateMatches=false; }
				reconciliationIntendedRecords=List(); reconciliationIntendedRecords.add(data);
				if(reconciliationAudit.Status == "Complete") { reconciliationIntendedRecords.add(reconciliationCompletedAfter); }
				candidateProof=candidate.toString().toMap(); legacyPolicy=Approval_Policy[ID == candidate.get("id").toLong()];
				candidateProof.put("version",legacyPolicy.Version); candidateProof.put("duplicatePerson",legacyPolicy.Duplicate_Person);
				legacyFrom=""; legacyTo=""; if(legacyPolicy.Effective_From != null) { legacyFrom=legacyPolicy.Effective_From.toString("yyyy-MM-dd"); } if(legacyPolicy.Effective_To != null) { legacyTo=legacyPolicy.Effective_To.toString("yyyy-MM-dd"); }
				candidateProof.put("effectiveFrom",legacyFrom); candidateProof.put("effectiveTo",legacyTo);
				for each intendedPolicy in reconciliationIntendedRecords
				{
				for each field in {"companyId","workflow","territory","department","enabled","selfApproval"}
				{
					if(ifnull(candidate.get(field),"").toString() != ifnull(intendedPolicy.get(field),"").toString()) { candidateMatches=false; }
				}
				for each field in intendedPolicy.keys()
				{
					if(field != "id" && field != "status" && field != "adapterEnabled" && field != "steps") { if(ifnull(candidateProof.get(field),"").toString() != ifnull(intendedPolicy.get(field),"").toString()) { candidateMatches=false; } }
				}
				// Compare each ordered step and its test evidence by field, independent of JSON key order.
				candidateSteps = candidate.get("steps"); intendedSteps = intendedPolicy.get("steps");
				if(candidateSteps.size() != intendedSteps.size()) { candidateMatches=false; }
				else
				{
					stepIndex=0;
					for each rawIntendedStep in intendedSteps
					{
						intendedStep=rawIntendedStep.toString().toMap(); candidateStep=candidateSteps.get(stepIndex).toString().toMap(); stepIndex=stepIndex+1;
						if(candidateStep.keys().size() != intendedStep.keys().size()) { candidateMatches=false; }
						for each stepField in intendedStep.keys()
						{
							if(!candidateStep.keys().contains(stepField)) { candidateMatches=false; }
							if(stepField == "poTestCFO")
							{
								candidateTest=candidateStep.get(stepField); intendedTest=intendedStep.get(stepField);
								if(candidateTest == null) { candidateMatches=false; }
								else
								{
									if(candidateTest.keys().size() != intendedTest.keys().size()) { candidateMatches=false; }
									for each testField in intendedTest.keys()
									{
										typedCandidateValue={"value":candidateTest.get(testField)}; typedIntendedValue={"value":intendedTest.get(testField)};
										if(!candidateTest.keys().contains(testField) || typedCandidateValue.toString() != typedIntendedValue.toString()) { candidateMatches=false; }
									}
								}
							}
							else
							{
								typedCandidateValue={"value":candidateStep.get(stepField)}; typedIntendedValue={"value":intendedStep.get(stepField)};
								if(typedCandidateValue.toString() != typedIntendedValue.toString()) { candidateMatches=false; }
							}
						}
					}
				}
				}
				if(candidateMatches) { found=candidate; matches=matches+1; }
			}
			if(matches != 1) { result.put("error","Exactly one saved PO test Draft must match every intended field before its receipt can be completed."); return result.toString(); }
			// Recheck ownership immediately before completing only this audit and releasing only this lock.
			currentReconciliationLock = Approval_Config_Lock[Lock_Key == "shared-approval-policy"];
			reconciliationLockStillValid = currentReconciliationLock.count() == 1 && currentReconciliationLock.ID == reconciliationLock.ID && currentReconciliationLock.Operation_Token == token;
			if(reconciliationAudit.Status == "Complete" && reconciliationLock.count() == 0 && currentReconciliationLock.count() == 0) { reconciliationLockStillValid=true; }
			if(reconciliationAudit.Status != "Started" && reconciliationAudit.Status != "Complete") { reconciliationLockStillValid=false; }
			if(reconciliationLockStillValid != true) { result.put("error","Retained operation ownership changed; draft verification stopped."); return result.toString(); }
			if(reconciliationAudit.Status == "Started") { reconciliationAudit.After_JSON=found.toString(); reconciliationAudit.Status="Complete"; }
			if(currentReconciliationLock.count() == 1) { delete from Approval_Config_Lock[ID == reconciliationLock.ID && Operation_Token == token]; }
			result.put("success",true); result.put("writeState","verified"); result.put("token",token); result.put("after",found); return result.toString();
		}
		lockId = insert into Approval_Config_Lock
			[
				Added_User=zoho.loginuser
				Lock_Key="shared-approval-policy"
				Operation_Token=token
			];
		beforeEntity = Map();
		beforeCollection = "policies"; if(action == "SaveRole") { beforeCollection = "roles"; } if(action == "SaveAssignment") { beforeCollection = "assignments"; }
		before = thisapp.approvalConfigurationSnapshot();
		if(before.get("success") != true) { result.put("writeState","unknown"); result.put("error","Configuration could not be read under its write lock."); return result.toString(); }
		if(action == "SavePolicy")
		{
			beforeConfiguration = before.get("configuration");
			otherPolicies = beforeConfiguration.get("policies");
			for each otherPolicy in otherPolicies
			{
				if(otherPolicy.get("id") != idText && otherPolicy.get("companyId") == data.get("companyId") && otherPolicy.get("workflow") == data.get("workflow") && otherPolicy.get("territory") == ifnull(data.get("territory"),"") && otherPolicy.get("department") == ifnull(data.get("department"),"")) { delete from Approval_Config_Lock[ID == lockId]; lockId=0; result.put("error","This scope already has a policy. Edit that policy."); return result.toString(); }
			}
		}
		expectedPolicyStatus="Draft";
		if(action == "SavePolicy" && idText != "")
		{
			existingPolicy=Approval_Policy[ID == idText.toLong()]; expectedPolicyStatus=existingPolicy.Status;
			policyStatusValid=expectedPolicyStatus == "Draft" || expectedPolicyStatus == "Published";
			if(existingPolicy.count() != 1 || policyStatusValid != true || data.get("status") != expectedPolicyStatus) { delete from Approval_Config_Lock[ID == lockId]; lockId=0; result.put("error","Policy changed or is unavailable. Refresh before saving."); return result.toString(); }
		}
		if(action == "SavePolicy" && idText == "" && data.get("status") != null && data.get("status") != "Draft") { delete from Approval_Config_Lock[ID == lockId]; lockId=0; result.put("error","New policies begin as Draft."); return result.toString(); }
		previousCollection = before.get("configuration").get(beforeCollection);
		for each previous in previousCollection { if(previous.get("id") == idText) { beforeEntity = previous; } }
		auditId = insert into Approval_Config_Audit
			[
				Added_User=zoho.loginuser
				Token=token
				Actor=access.ID
				Action=action
				Status="Started"
				Before_JSON=beforeEntity.toString()
				Intended_JSON=data.toString()
			];
		if(action == "SaveRole")
		{
			name = ifnull(data.get("name"),"").toString().trim();
			activeKnown = data.get("active") == true || data.get("active") == false;
			if(name == "" || name.length() > 80 || activeKnown != true) { result.put("error","Role name and explicit active setting are required."); }
			else if(idText == "") { newId = insert into Approval_Role
			[
				Added_User=zoho.loginuser
				Role_Name=name
				Active=data.get("active")
			]; idText = newId.toString(); }
			else { role = Approval_Role[ID == idText.toLong()]; if(role.ID == null) { result.put("error","Role was not found."); } else { role.Role_Name=name; role.Active=data.get("active"); } }
		}
		if(action == "SaveAssignment")
		{
			companyId = null; if(data.get("companyId") != "") { company = Company[ID == data.get("companyId").toString().toLong()]; companyId = company.ID; }
			role = Approval_Role[ID == data.get("roleId").toString().toLong()]; person = User_Access[ID == data.get("userAccessId").toString().toLong()];
			assignmentCompanyValid = true;
			if(data.get("companyId") != "" && companyId == null) { assignmentCompanyValid = false; }
			activeKnown = data.get("active") == true || data.get("active") == false;
			if(role.ID == null || person.ID == null || assignmentCompanyValid != true || activeKnown != true) { result.put("error","Role, User Access, valid company scope and explicit active setting are required."); }
			else
			{
				fromDate = null; toDate = null;
				if(ifnull(data.get("effectiveFrom"),"") != "") { fromDate = data.get("effectiveFrom").toDate("yyyy-MM-dd"); }
				if(ifnull(data.get("effectiveTo"),"") != "") { toDate = data.get("effectiveTo").toDate("yyyy-MM-dd"); }
				if(fromDate != null && toDate != null && toDate <= fromDate) { result.put("error","Assignment end must follow start."); }
				else
				{
					if(idText == "") { newId = insert into Approval_Role_Assignment
			[
				Added_User=zoho.loginuser
				Role=role.ID
				Person=person.ID
				Company=companyId
			]; idText = newId.toString(); }
					assignment = Approval_Role_Assignment[ID == idText.toLong()];
					assignment.Role=role.ID; assignment.Person=person.ID; assignment.Company=companyId; assignment.Territory_Key=ifnull(data.get("territory"),""); assignment.Department_Key=ifnull(data.get("department"),""); assignment.Active=data.get("active"); assignment.Effective_From=fromDate; assignment.Effective_To=toDate;
				}
			}
		}
		if(action == "SavePolicy")
		{
			companyId = null; if(data.get("companyId") != "") { company = Company[ID == data.get("companyId").toString().toLong()]; companyId = company.ID; }
			policyCompanyValid = true;
			if(data.get("companyId") == "" && data.get("workflow") != "Purchase Order") { policyCompanyValid = false; }
			if(data.get("companyId") != "" && companyId == null) { policyCompanyValid = false; }
			if(policyCompanyValid != true || data.get("steps").size() == 0 || data.get("steps").size() > 30 || data.get("steps").toString().length() > 40000) { result.put("error","Choose a company (or All companies for POs) and enter 1–30 ordered steps."); }
			else
			{
				if(idText == "") { newId = insert into Approval_Policy
			[
				Added_User=zoho.loginuser
				Company=companyId
				Status="Draft"
				Adapter_Enabled=false
			]; idText = newId.toString(); }
				policy = Approval_Policy[ID == idText.toLong()];
				if(policy.Status != expectedPolicyStatus) { result.put("error","Policy status changed before saving."); }
				else
				{
					policy.Company=companyId; policy.Workflow=data.get("workflow"); policy.Territory_Key=ifnull(data.get("territory"),""); policy.Department_Key=ifnull(data.get("department"),""); policy.Enabled=data.get("enabled"); policy.Self_Approval=data.get("selfApproval"); policy.Steps_JSON=data.get("steps").toString();
				}
			}
		}
		if(action == "Publish")
		{
			policy=Approval_Policy[ID == idText.toLong()];
			if(policy.count() != 1 || policy.Status != "Draft") { result.put("error","A saved Draft is required."); }
			else
			{
				for each other in Approval_Policy[Company == policy.Company && Workflow == policy.Workflow && Status == "Published" && ID != policy.ID]
				{
					if(ifnull(other.Territory_Key,"") == ifnull(policy.Territory_Key,"") && ifnull(other.Department_Key,"") == ifnull(policy.Department_Key,"")) { result.put("error","A published policy already exists in this scope. Edit that policy."); }
				}
				if(result.get("error") == null) { policy.Status="Published"; }
			}
		}
		after = thisapp.approvalConfigurationSnapshot(); audit = Approval_Config_Audit[ID == auditId];
		if(result.get("error") != null)
		{
			audit.Status="Rejected"; audit.Error_Text=result.get("error"); delete from Approval_Config_Lock[ID == lockId]; return result.toString();
		}
		if(after.get("success") != true) { result.put("writeState","unknown"); result.put("error","Configuration write could not be read back. Lock retained."); return result.toString(); }
		// Native writes succeeded. Confirm the intended destination and lifecycle state.
		collection="policies"; if(action == "SaveRole") { collection="roles"; } if(action == "SaveAssignment") { collection="assignments"; }
		found=Map(); matches=0; changedCollection=after.get("configuration").get(collection);
		for each row in changedCollection { if(row.get("id") == idText) { found=row; matches=matches+1; } }
		if(matches != 1) { result.put("writeState","unknown"); result.put("error","Unique changed configuration record was not verified."); return result.toString(); }
		if(action == "Publish" && found.get("status") != "Published") { result.put("writeState","unknown"); result.put("error","Publication state was not verified."); return result.toString(); }
		if(action == "SavePolicy" && found.get("status") != expectedPolicyStatus) { result.put("writeState","unknown"); result.put("error","Policy lifecycle state was not verified."); return result.toString(); }
		audit.After_JSON=found.toString(); audit.Status="Complete"; delete from Approval_Config_Lock[ID == lockId];
		result.put("success",true); result.put("writeState","verified"); result.put("token",token); result.put("after",found);
	}
	catch(e) { operationUnknown=reconciliationOperation || lockId != 0; result.put("writeState",if(operationUnknown,"unknown","not-started")); result.put("error","Configuration operation could not be verified. Check its audit receipt before another write."); }
	return result.toString();
}
