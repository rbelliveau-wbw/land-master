				 list PF_PDF_Wrap(string value, int maxChars)
                 {
                 	lines = List();
	if(maxChars < 1) { maxChars = 1; }
                 	clean = thisapp.PF_PDF_Clean(value);
                 	if(clean == "")
                 	{
                 		lines.add("Not provided");
                 		return lines;
                 	}
                 	words = clean.toList(" ");
                 	current = "";
                 	for each  word in words
                 	{
                 		if(word.length() > maxChars)
                 		{
			if(current != "") { lines.add(current); current = ""; }
                wordLength = word.length();
                chunkCount = (wordLength / maxChars).ceil().toLong();
                chunkStart = 0;
                for each ignoredChunk in thisapp.forLoop(1,chunkCount)
                {
                    chunkEnd = chunkStart + maxChars;
                    if(chunkEnd > wordLength) { chunkEnd = wordLength; }
                    chunk = word.subString(chunkStart,chunkEnd);
                    if(chunkEnd < wordLength) { lines.add(chunk); }
                    else { current = chunk; }
                    chunkStart = chunkEnd;
                }
                word = "";
                 		}
		if(word != "")
		{
			candidate = word;
                 		if(current != "")
                 		{
                 			candidate = current + " " + word;
                 		}
                 		if(candidate.length() <= maxChars)
                 		{
                 			current = candidate;
                 		}
                 		else
                 		{
                 			if(current != "")
                 			{
                 				lines.add(current);
                 			}
                 			current = word;
                 		}
		}
                 	}
                 	if(current != "")
                 	{
                 		lines.add(current);
                 	}
                 	if(lines.size() == 0)
                 	{
                 		lines.add("Not provided");
                 	}
                 	return lines;
                 }
