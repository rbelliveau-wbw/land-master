string PF_AI_Review(string payload)
{
	// AI check of a Pro Forma against the founder's criteria stored in Settings.
	// Called by Custom API Review_PF (dev) / Review_PF1 (prod) from the proforma-manager widget.
	// Entire JSON: the whole POST body arrives as this single string arg. Also accepts a bare record id.
	// Payload: {"proformaId": "...", "reviewedBy": "email", "dryRun": false}
	// Returns: {success, proformaId, provider, model, criteriaVersion, reviewedOn, reviewId,
	//           result:{verdict, score, summary, meets[], misses[], questions[]}, summarySent:{...}}
	resp = Map();
	try
	{
		// ---- 1. Parse the payload ---------------------------------------------
		pfId = payload.trim();
		reviewedBy = zoho.loginuserid;
		dryRun = false;
		if(pfId.startsWith("{"))
		{
			data = payload.toMap();
			if(data.get("payload") != null)
			{
				data = data.get("payload").toString().toMap();
			}
			pfId = ifnull(data.get("proformaId"),"").toString().trim();
			reviewedBy = ifnull(data.get("reviewedBy"),reviewedBy).toString().trim();
			dryRun = ifnull(data.get("dryRun"),"false").toString() == "true";
		}
		if(pfId == "")
		{
			resp.put("success",false);
			resp.put("error","Pro Forma id is required.");
			return resp.toString();
		}
		pf = Add_Pro_Forma[ID == pfId.toLong()];
		if(pf.count() == 0)
		{
			resp.put("success",false);
			resp.put("error","Pro Forma not found.");
			return resp.toString();
		}
		// ---- 2. Criteria + provider/model from the Settings singleton -----------
		criteria = "";
		provider = "openai";
		model = "gpt-5.6-luna";
		criteriaVersion = "";
		for each  s in Settings[ID != 0]
		{
			criteria = ifnull(s.PF_Review_Criteria,"").toString().trim();
			provider = ifnull(s.PF_Review_Provider,"").toString().trim().toLowerCase();
			model = ifnull(s.PF_Review_Model,"").toString().trim();
			criteriaVersion = ifnull(s.PF_Review_Criteria_Updated,"").toString();
			break;
		}
		if(provider == "")
		{
			provider = "openai";
		}
		if(model == "")
		{
			model = "gpt-5.6-luna";
		}
		if(criteria == "")
		{
			resp.put("success",false);
			resp.put("error","PF Review Criteria is empty on the Settings page.");
			return resp.toString();
		}
		if(provider != "openai")
		{
			// OpenRouter needs its own Connection ("openrouter") and a second invokeurl block —
			// Deluge takes the connection name as a literal, so it cannot be switched at runtime.
			resp.put("success",false);
			resp.put("error","Provider '" + provider + "' is not wired yet. Set PF Review Provider to openai.");
			return resp.toString();
		}
		// ---- 3. Compact deal summary: the numbers only, ratios pre-computed ------
		// The model reads figures; it never computes them.
		lots = ifnull(pf.Lots,0).toDecimal();
		acres = ifnull(pf.Total_Acres,0).toDecimal();
		landCost = ifnull(pf.Land_Cost,0).toDecimal();
		grossSales = ifnull(pf.Gross_Sales,0).toDecimal();
		totalIncome = ifnull(pf.Total_Income,0).toDecimal();
		totalExpenses = ifnull(pf.Total_Expenses,0).toDecimal();
		netProfit = ifnull(pf.Net_Profit,0).toDecimal();
		summary = Map();
		summary.put("name",ifnull(pf.Name,"").toString());
		summary.put("pf_number",ifnull(pf.PF_Number,"").toString());
		summary.put("territory",ifnull(pf.Territory,"").toString());
		summary.put("probability",ifnull(pf.Probability,"").toString());
		summary.put("mud_pid",ifnull(pf.MUD_PID,"").toString());
		summary.put("lots",lots);
		summary.put("total_acres",acres);
		summary.put("lots_per_acre",if(acres > 0,(lots / acres).round(2),0));
		summary.put("phases",ifnull(pf.Phases,0));
		summary.put("lot_size_ft",ifnull(pf.Lot_Size_Ft,0));
		summary.put("land_cost",landCost);
		summary.put("land_cost_per_acre",ifnull(pf.Land_Cost_Acre,0));
		summary.put("land_cost_per_lot",if(lots > 0,(landCost / lots).round(0),0));
		summary.put("sale_price_per_front_foot",ifnull(pf.Sale_Price_FF,0));
		summary.put("engineering_cost_per_lot",ifnull(pf.Engineering_Cost_Lot,0));
		summary.put("construction_cost_base_per_front_foot",ifnull(pf.Const_Cost_FF,0));
		summary.put("gross_sales",grossSales);
		summary.put("total_income",totalIncome);
		summary.put("total_expenses",totalExpenses);
		summary.put("net_profit",netProfit);
		summary.put("net_margin_pct",if(totalIncome > 0,(netProfit / totalIncome * 100).round(1),0));
		summary.put("profit_per_lot",if(lots > 0,(netProfit / lots).round(0),0));
		summary.put("roi_pct",ifnull(pf.ROI1,0));
		summary.put("irr_pct",ifnull(pf.IRR,0));
		summary.put("xirr_pct",ifnull(pf.XIRR,0));
		lotMix = List();
		for each  mix in Lot_Mix_Row[Pro_Forma == pfId.toLong()]
		{
			mixRow = Map();
			mixRow.put("lot_size_ft",ifnull(mix.Lot_Size_Ft,0));
			mixRow.put("lot_count",ifnull(mix.Lot_Count,0));
			mixRow.put("price_per_lf",ifnull(mix.Price_LF,0));
			lotMix.add(mixRow);
		}
		summary.put("lot_mix",lotMix);
		// ---- 4. Prompt ---------------------------------------------------------
		systemMsg = "You are the founder's deal reviewer at a residential land development company. " + "Judge this pro forma STRICTLY against the FOUNDER CRITERIA below. " + "Every number you cite must appear in the DEAL SUMMARY; never invent, estimate, or recompute a figure. " + "If a criterion cannot be judged from the summary, say so under misses and ask for it under questions. " + "Verdict rules: Fail if any deal killer is hit; Watch if a must-have is unproven or marginal; Pass only when every stated threshold is met. " + "Score is 0-100 confidence that the founder would pursue this deal as presented. " + "Reply with ONE JSON object and nothing else, exactly this shape: " + "{\"verdict\":\"Pass|Watch|Fail\",\"score\":0,\"summary\":\"two or three plain sentences\"," + "\"meets\":[\"criterion met, with the number\"],\"misses\":[\"criterion missed or unjudgeable, with the number or 'not provided'\"]," + "\"questions\":[\"what the founder would ask before going further\"]}" + "\n\nFOUNDER CRITERIA:\n" + criteria;
		userMsg = "DEAL SUMMARY (JSON):\n" + summary.toString();
		sysMap = Map();
		sysMap.put("role","system");
		sysMap.put("content",systemMsg);
		usrMap = Map();
		usrMap.put("role","user");
		usrMap.put("content",userMsg);
		messages = List();
		messages.add(sysMap);
		messages.add(usrMap);
		fmt = Map();
		fmt.put("type","json_object");
		body = Map();
		body.put("model",model);
		body.put("messages",messages);
		body.put("response_format",fmt);
		// max_completion_tokens is accepted by every current chat model; max_tokens is rejected by the gpt-5 family.
		// Reasoning models spend part of this on thinking, so leave headroom. No temperature: reasoning models refuse it.
		body.put("max_completion_tokens",2000);
		if(dryRun)
		{
			resp.put("success",true);
			resp.put("dryRun",true);
			resp.put("model",model);
			resp.put("request",body);
			resp.put("summarySent",summary);
			return resp.toString();
		}
		// ---- 5. Call the model through the "openai" Connection (key never in code) ----
		hdrs = Map();
		hdrs.put("Content-Type","application/json");
		apiResp = invokeurl
		[
			url :"https://api.openai.com/v1/chat/completions"
			type :POST
			parameters:body.toString()
			headers:hdrs
			connection:"openai"
		];
		respMap = apiResp.toString().toMap();
		if(respMap.get("error") != null)
		{
			errObj = respMap.get("error").toString();
			errMsg = errObj;
			if(errObj.startsWith("{"))
			{
				errMsg = ifnull(errObj.toMap().get("message"),errObj).toString();
			}
			resp.put("success",false);
			resp.put("error","Model call failed: " + errMsg);
			resp.put("model",model);
			return resp.toString();
		}
		choices = respMap.get("choices");
		if(choices == null || choices.size() == 0)
		{
			resp.put("success",false);
			resp.put("error","Model returned no choices.");
			resp.put("model",model);
			return resp.toString();
		}
		content = ifnull(choices.get(0).get("message").get("content"),"").toString().trim();
		content = content.replaceAll("```json","").replaceAll("```","").trim();
		if(!content.startsWith("{"))
		{
			resp.put("success",false);
			resp.put("error","Model reply was not JSON: " + content.left(200));
			resp.put("model",model);
			return resp.toString();
		}
		// ---- 6. Parse + normalise ---------------------------------------------
		parsed = content.toMap();
		verdict = ifnull(parsed.get("verdict"),"Watch").toString().trim();
		if(verdict != "Pass" && verdict != "Watch" && verdict != "Fail")
		{
			verdict = "Watch";
		}
		scoreStr = ifnull(parsed.get("score"),"0").toString().trim();
		score = 0;
		if(scoreStr.isNumber())
		{
			score = scoreStr.toDecimal().round(0).toLong();
		}
		if(score < 0)
		{
			score = 0;
		}
		if(score > 100)
		{
			score = 100;
		}
		summaryTxt = ifnull(parsed.get("summary"),"").toString().trim();
		meetsList = ifnull(parsed.get("meets"),List());
		missesList = ifnull(parsed.get("misses"),List());
		questionsList = ifnull(parsed.get("questions"),List());
		meetsTxt = "";
		for each  item in meetsList
		{
			meetsTxt = meetsTxt + if(meetsTxt == "","","\n") + item.toString();
		}
		missesTxt = "";
		for each  item in missesList
		{
			missesTxt = missesTxt + if(missesTxt == "","","\n") + item.toString();
		}
		questionsTxt = "";
		for each  item in questionsList
		{
			questionsTxt = questionsTxt + if(questionsTxt == "","","\n") + item.toString();
		}
		result = Map();
		result.put("verdict",verdict);
		result.put("score",score);
		result.put("summary",summaryTxt);
		result.put("meets",meetsList);
		result.put("misses",missesList);
		result.put("questions",questionsList);
		// ---- 7. Keep every run as a Proforma_AI_Review row ---------------------------
		// Insert-with-fields is the one Deluge write path prod does not silently drop.
		// Deal_Snapshot stores the exact numbers the verdict was judged on.
		reviewId = insert into Proforma_AI_Review
		[
			Added_User=zoho.loginuser
			Pro_Forma=pfId.toLong()
			Verdict=verdict
			Score=score
			Summary=summaryTxt
			Meets=meetsTxt
			Misses=missesTxt
			Questions=questionsTxt
			Deal_Snapshot=summary.toString()
			Reviewed_On=zoho.currenttime
			Model=model
			Criteria_Version=criteriaVersion
			Reviewed_By=reviewedBy
		];
		// ---- 8. Stamp the Pro Forma's latest-review fields ------------------------
		// Fetch-assign edits can be silently dropped in prod, so the widget re-writes
		// these same values via the REST update after it gets this response.
		pf.AI_Review_Verdict=verdict;
		pf.AI_Review_Score=score;
		pf.AI_Review_Summary=summaryTxt;
		pf.AI_Reviewed_On=zoho.currenttime;
		pf.AI_Review_Criteria_Version=criteriaVersion;
		// ---- 9. Return ---------------------------------------------------------
		resp.put("success",true);
		resp.put("proformaId",pfId);
		resp.put("provider",provider);
		resp.put("model",model);
		resp.put("criteriaVersion",criteriaVersion);
		resp.put("reviewedOn",zoho.currenttime.toString("MM/dd/yyyy hh:mm:ss a"));
		resp.put("reviewedBy",reviewedBy);
		resp.put("reviewId",reviewId.toString());
		resp.put("result",result);
		resp.put("summarySent",summary);
		resp.put("usage",ifnull(respMap.get("usage"),Map()));
	}	catch (e)
	{
		resp.put("success",false);
		resp.put("error",e.toString());
	}
	return resp.toString();
}
