bool poEmailCanRetry(string purchaseOrderId, string userAccessId)
{
	allowed = false;
	try
	{
		if(!ifnull(purchaseOrderId,"").matches("^[1-9][0-9]*$") || !ifnull(userAccessId,"").matches("^[1-9][0-9]*$")) { return false; }
		person = User_Access[ID == userAccessId.toLong()];
		if(person.count() != 1 || ifnull(person.User,"").toString().trim() == "") { return false; }
		// Development owner preview can select only an actual native user. A
		// notification-only contact has no authenticated identity or powers.
		if(person.User != zoho.loginuser && !(thisapp.environment.type == "Development" && zoho.loginuser == zoho.adminuser)) { return false; }
		checked = thisapp.poApprovalBundle(purchaseOrderId);
		if(checked.get("success") != true) { return false; }
		bundle = checked.get("bundle");
		isSubmitter = bundle.get("submitterId") == userAccessId;
		allowed = person.User == zoho.adminuser || isSubmitter;
		for each entry in bundle.get("rows") { if(entry.get("userAccessId") == userAccessId) { allowed = true; } }
		if(person.User != zoho.adminuser)
		{
			profile = thisapp.permissions.profileForUser(person.User);
			if(profile == "Construction Budgeting") { allowed = isSubmitter && person.Create_Purchase_Orders == true; }
		}
	}
	catch(permissionError) { allowed = false; }
	return allowed;
}
