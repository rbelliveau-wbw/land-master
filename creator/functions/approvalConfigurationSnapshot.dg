map approvalConfigurationSnapshot()
{
	result = {"success":false,"contract":"approval-policy-v1"};
	try
	{
		roles = List(); assignments = List(); policies = List(); users = List(); companies = List(); territories = List();
		for each roleRow in Approval_Role[ID != 0] { roles.add({"id":roleRow.ID.toString(),"name":roleRow.Role_Name,"active":roleRow.Active}); }
		for each assignmentRow in Approval_Role_Assignment[ID != 0]
		{
			fromText = ""; toText = "";
			if(assignmentRow.Effective_From != null) { fromText = assignmentRow.Effective_From.toString("yyyy-MM-dd"); }
			if(assignmentRow.Effective_To != null) { toText = assignmentRow.Effective_To.toString("yyyy-MM-dd"); }
			companyKey = ""; if(assignmentRow.Company != null) { companyKey = assignmentRow.Company.toString(); }
			assignments.add({"id":assignmentRow.ID.toString(),"roleId":assignmentRow.Role.toString(),"companyId":companyKey,"territory":ifnull(assignmentRow.Territory_Key,""),"department":ifnull(assignmentRow.Department_Key,""),"userAccessId":assignmentRow.Person.toString(),"active":assignmentRow.Active,"effectiveFrom":fromText,"effectiveTo":toText});
		}
		for each policyRow in Approval_Policy[ID != 0]
		{
			fromText = ""; toText = "";
			if(policyRow.Effective_From != null) { fromText = policyRow.Effective_From.toString("yyyy-MM-dd"); }
			if(policyRow.Effective_To != null) { toText = policyRow.Effective_To.toString("yyyy-MM-dd"); }
			companyKey = ""; if(policyRow.Company != null) { companyKey = policyRow.Company.toString(); }
			policies.add({"id":policyRow.ID.toString(),"companyId":companyKey,"workflow":policyRow.Workflow,"territory":ifnull(policyRow.Territory_Key,""),"department":ifnull(policyRow.Department_Key,""),"version":policyRow.Version,"status":policyRow.Status,"enabled":policyRow.Enabled,"selfApproval":policyRow.Self_Approval,"duplicatePerson":policyRow.Duplicate_Person,"effectiveFrom":fromText,"effectiveTo":toText,"steps":policyRow.Steps_JSON.toJSONList(),"adapterEnabled":policyRow.Adapter_Enabled});
		}
		for each personRow in User_Access[ID != 0] { users.add({"id":personRow.ID.toString(),"user":ifnull(personRow.User,"").toString(),"name":ifnull(personRow.Full_Name,""),"approverEmail":ifnull(personRow.Approver_Email,""),"routingEnabled":personRow.Approval_Routing_Enabled == true}); }
		for each companyRow in Company[ID != 0] { companies.add({"id":companyRow.ID.toString(),"label":companyRow.Company_Name}); }
		for each territoryRow in Territory[ID != 0]
		{
			vpIds = List(); for each vpPerson in territoryRow.VP { if(!vpIds.contains(vpPerson.ID.toString())) { vpIds.add(vpPerson.ID.toString()); } }
			territories.add({"id":territoryRow.Territory_Name,"label":territoryRow.Territory_Name,"vpUserAccessIds":vpIds});
		}
		auditRows = List();
		for each event in Approval_Config_Audit[ID != 0]
		{
			beforeValue = Map(); afterValue = Map(); intendedValue = Map();
			if(ifnull(event.Before_JSON,"") != "") { beforeValue=event.Before_JSON.toMap(); }
			if(ifnull(event.After_JSON,"") != "") { afterValue=event.After_JSON.toMap(); }
			if(ifnull(event.Intended_JSON,"") != "") { intendedValue=event.Intended_JSON.toMap(); }
			auditRows.add({"id":event.ID.toString(),"action":event.Action,"status":event.Status,"actorId":event.Actor.toString(),"before":beforeValue,"after":afterValue,"intended":intendedValue,"error":ifnull(event.Error_Text,"")});
		}
		result.put("configuration",{"roles":roles,"assignments":assignments,"policies":policies,"users":users,"companies":companies,"territories":territories,"audit":auditRows});
		result.put("canAdmin",zoho.loginuser == zoho.adminuser); result.put("success",true);
	}
	catch(e) { result.put("error","Approval configuration cannot be read completely."); }
	return result;
}
