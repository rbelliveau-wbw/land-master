map approvalConfigurationSnapshot()
{
	result = {"success":false,"contract":"approval-policy-v1"};
	try
	{
		roles = List(); assignments = List(); policies = List(); users = List(); companies = List(); territories = List();
		for each row in Approval_Role[ID != 0] { roles.add({"id":row.ID.toString(),"name":row.Role_Name,"active":row.Active}); }
		for each row in Approval_Role_Assignment[ID != 0]
		{
			fromText = ""; toText = "";
			if(row.Effective_From != null) { fromText = row.Effective_From.toString("yyyy-MM-dd"); }
			if(row.Effective_To != null) { toText = row.Effective_To.toString("yyyy-MM-dd"); }
			assignments.add({"id":row.ID.toString(),"roleId":row.Role.toString(),"companyId":row.Company.toString(),"territory":ifnull(row.Territory_Key,""),"department":ifnull(row.Department_Key,""),"userAccessId":row.Person.toString(),"active":row.Active,"effectiveFrom":fromText,"effectiveTo":toText});
		}
		for each row in Approval_Policy[ID != 0]
		{
			fromText = ""; toText = "";
			if(row.Effective_From != null) { fromText = row.Effective_From.toString("yyyy-MM-dd"); }
			if(row.Effective_To != null) { toText = row.Effective_To.toString("yyyy-MM-dd"); }
			policies.add({"id":row.ID.toString(),"companyId":row.Company.toString(),"workflow":row.Workflow,"territory":ifnull(row.Territory_Key,""),"department":ifnull(row.Department_Key,""),"version":row.Version,"status":row.Status,"enabled":row.Enabled,"selfApproval":row.Self_Approval,"duplicatePerson":row.Duplicate_Person,"effectiveFrom":fromText,"effectiveTo":toText,"steps":row.Steps_JSON.toJSONList(),"adapterEnabled":row.Adapter_Enabled});
		}
		for each row in User_Access[ID != 0] { users.add({"id":row.ID.toString(),"user":ifnull(row.User,"").toString(),"name":ifnull(row.Full_Name,""),"approverEmail":ifnull(row.Approver_Email,""),"routingEnabled":row.Approval_Routing_Enabled == true}); }
		for each row in Company[ID != 0] { companies.add({"id":row.ID.toString(),"label":row.Company_Name}); }
		for each row in Territory[ID != 0] { territories.add({"id":row.Territory_Name,"label":row.Territory_Name}); }
		auditRows = List();
		for each event in Approval_Config_Audit[ID != 0]
		{
			beforeValue = Map(); afterValue = Map(); intendedValue = Map();
			if(ifnull(event.Before_JSON,"") != "") { beforeValue=event.Before_JSON.toMap(); }
			if(ifnull(event.After_JSON,"") != "") { afterValue=event.After_JSON.toMap(); }
			if(ifnull(event.Intended_JSON,"") != "") { intendedValue=event.Intended_JSON.toMap(); }
			auditRows.add({"id":event.ID.toString(),"action":event.Action,"status":event.Status,"actorId":event.Actor.toString(),"before":beforeValue,"after":afterValue,"intended":intendedValue,"error":ifnull(event.Error_Text,"")});
		}
		result.put("configuration",{"roles":roles,"assignments":assignments,"policies":policies,"users":users,"companies":companies,"territories":territories,"audit":auditRows});
		result.put("canAdmin",zoho.loginuser == zoho.adminuser); result.put("success",true);
	}
	catch(e) { result.put("error","Approval configuration cannot be read completely."); }
	return result;
}
