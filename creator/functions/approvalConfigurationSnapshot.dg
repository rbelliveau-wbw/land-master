map approvalConfigurationSnapshot()
{
	result = {"success":false,"contract":"approval-policy-v1"};
	try
	{
		roles = List(); assignments = List(); policies = List(); users = List(); territories = List();
		for each roleRow in Approval_Role[ID != 0] { roles.add({"id":roleRow.ID.toString(),"name":roleRow.Role_Name,"active":roleRow.Active}); }
		for each assignmentRow in Approval_Role_Assignment[ID != 0]
		{
			assignments.add({"id":assignmentRow.ID.toString(),"roleId":assignmentRow.Role.toString(),"territory":ifnull(assignmentRow.Territory_Key,""),"department":ifnull(assignmentRow.Department_Key,""),"userAccessId":assignmentRow.Person.toString(),"active":assignmentRow.Active});
		}
		for each policyRow in Approval_Policy[ID != 0]
		{
			// Native toJSONList elements can be JSON text. Return step objects in the configuration DTO.
			policySteps = List();
			for each rawPolicyStep in policyRow.Steps_JSON.toJSONList() { policySteps.add(rawPolicyStep.toString().toMap()); }
			policies.add({"id":policyRow.ID.toString(),"workflow":policyRow.Workflow,"territory":ifnull(policyRow.Territory_Key,""),"department":ifnull(policyRow.Department_Key,""),"status":policyRow.Status,"enabled":policyRow.Enabled,"selfApproval":policyRow.Self_Approval,"steps":policySteps,"adapterEnabled":policyRow.Adapter_Enabled});
		}
		for each personRow in User_Access[ID != 0] { users.add({"id":personRow.ID.toString(),"user":ifnull(personRow.User,"").toString(),"name":ifnull(personRow.Full_Name,""),"approverEmail":ifnull(personRow.Approver_Email,""),"routingEnabled":personRow.Approval_Routing_Enabled == true}); }
		for each territoryRow in Territory[ID != 0]
		{
			vpIds = List(); for each vpPerson in territoryRow.VP { if(!vpIds.contains(vpPerson.ID.toString())) { vpIds.add(vpPerson.ID.toString()); } }
			devMgrIds = List(); for each devMgrPerson in territoryRow.Dev_Mgr { if(!devMgrIds.contains(devMgrPerson.ID.toString())) { devMgrIds.add(devMgrPerson.ID.toString()); } }
			territories.add({"id":territoryRow.Territory_Name,"label":territoryRow.Territory_Name,"vpUserAccessIds":vpIds,"devMgrUserAccessIds":devMgrIds});
		}
		auditRows = List(); auditActor = User_Access[User == zoho.loginuser];
		for each event in Approval_Config_Audit[ID != 0]
		{
			beforeValue = Map(); afterValue = Map(); intendedValue = Map();
			if(ifnull(event.Before_JSON,"") != "") { beforeValue=event.Before_JSON.toMap(); }
			if(ifnull(event.After_JSON,"") != "") { afterValue=event.After_JSON.toMap(); }
			if(ifnull(event.Intended_JSON,"") != "") { intendedValue=event.Intended_JSON.toMap(); }
			for each auditValue in {beforeValue,afterValue,intendedValue}
			{
				if(auditValue.get("steps") != null)
				{
					auditSteps=List(); for each rawAuditStep in auditValue.get("steps") { auditSteps.add(rawAuditStep.toString().toMap()); }
					auditValue.put("steps",auditSteps);
				}
			}
			auditToken = "";
			if(zoho.loginuser == zoho.adminuser && auditActor.count() == 1) { if(event.Actor == auditActor.ID) { auditToken=ifnull(event.Token,""); } }
			auditRows.add({"id":event.ID.toString(),"action":event.Action,"status":event.Status,"actorId":event.Actor.toString(),"token":auditToken,"before":beforeValue,"after":afterValue,"intended":intendedValue,"error":ifnull(event.Error_Text,"")});
		}
		result.put("configuration",{"roles":roles,"assignments":assignments,"policies":policies,"users":users,"territories":territories,"audit":auditRows});
		result.put("canAdmin",zoho.loginuser == zoho.adminuser); result.put("success",true);
	}
	catch(e) { result.put("error","Approval configuration cannot be read completely."); }
	return result;
}
