map resolveApprovalRoute(map context)
{
	result = {"success":false,"contract":"approval-policy-v1"};
	try
	{
		for each identityField in {"companyId","submitterId"}
		{
			typedIdentity = Map(); typedIdentity.put("value",context.get(identityField));
			if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Company and submitter IDs must be strings."); return result; }
		}
		workflows = {"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
		if(!workflows.contains(context.get("workflow"))) { result.put("error","Workflow is invalid."); return result; }
		companyText = ifnull(context.get("companyId"),"").toString();
		submitterText = ifnull(context.get("submitterId"),"").toString();
		amountText = thisapp.poCurrencyString(ifnull(context.get("amount"),"").toString());
		typedAmount = Map(); typedAmount.put("value",context.get("amount"));
		if(amountText == "" || !typedAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*")) { result.put("error","Company, submitter identity and an exact amount are required."); return result; }
		territory = ifnull(context.get("territory"),"").toString();
		department = ifnull(context.get("department"),"").toString();
		day = context.get("effectiveDate").toString().toDate("yyyy-MM-dd");
		if(day.toString("yyyy-MM-dd") != context.get("effectiveDate")) { result.put("error","Effective date is invalid."); return result; }
		amount = amountText.replaceAll("[.]","").toLong();
		policyId = 0; bestRank = -1; matched = 0;
		for each policy in Approval_Policy[Workflow == context.get("workflow") && Company == companyText.toLong() && Status == "Published"]
		{
			valid = (policy.Effective_From == null || policy.Effective_From <= day) && (policy.Effective_To == null || day < policy.Effective_To);
			pTerritory = ifnull(policy.Territory_Key,""); pDepartment = ifnull(policy.Department_Key,"");
			if(valid && (pTerritory == "" || pTerritory == territory) && (pDepartment == "" || pDepartment == department))
			{
				rank = 0; if(pTerritory != "") { rank = rank+4; } if(pDepartment != "") { rank = rank+2; }
				if(rank > bestRank) { bestRank = rank; policyId = policy.ID; matched = 1; }
				else if(rank == bestRank) { matched = matched+1; }
			}
		}
		if(matched != 1) { result.put("error","Published policy is missing or ambiguous at the highest applicable scope."); return result; }
		policy = Approval_Policy[ID == policyId];
		if(policy.Version == null || policy.Version < 1) { result.put("error","Published policy version is invalid."); return result; }
		if(policy.Enabled != true) { result.put("error","The applicable published policy is disabled. No company fallback was used."); return result; }
		if((policy.Self_Approval != "Allow" && policy.Self_Approval != "Deny") || (policy.Duplicate_Person != "Separate steps" && policy.Duplicate_Person != "Reject")) { result.put("error","Self-approval and multiple-role rules must be explicitly configured."); return result; }
		steps = policy.Steps_JSON.toJSONList();
		if(steps.size() == 0 || steps.size() > 30) { result.put("error","Published policy requires 1–30 ordered steps."); return result; }
		route = List(); excluded = List(); people = List(); stepKeys = List(); expectedOrder = 0;
		for each step in steps
		{
			expectedOrder = expectedOrder+1;
			if(!ifnull(step.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || step.get("order") != expectedOrder || stepKeys.contains(step.get("key"))) { result.put("error","Policy steps have duplicate keys or invalid sequential order."); return result; }
			typedRole = Map(); typedRole.put("value",step.get("roleId"));
			if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Step role ID must be a string."); return result; }
			stepKeys.add(step.get("key"));
			condition = step.get("condition");
			applies = step.get("enabled") == true;
			reason = "Required step";
			if(step.get("enabled") != true && step.get("enabled") != false) { result.put("error","Step enabled state is not explicit."); return result; }
			if(condition == "Above" || condition == "At or above")
			{
				thresholdText = thisapp.poCurrencyString(ifnull(step.get("threshold"),"").toString());
				typedThreshold = Map(); typedThreshold.put("value",step.get("threshold"));
				if(thresholdText == "" || !typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*")) { result.put("error","Conditional threshold must be an exact currency string."); return result; }
				threshold = thresholdText.replaceAll("[.]","").toLong();
				if(condition == "Above" && amount <= threshold) { applies = false; }
				if(condition == "At or above" && amount < threshold) { applies = false; }
				reason = amountText+" is "+condition.toLowerCase()+" "+thresholdText;
			}
			else if(condition != "Always") { result.put("error","Unsupported step condition."); return result; }
			if(applies != true)
			{
				excludedReason = condition+" threshold is not met";
				if(step.get("enabled") == false) { excludedReason = "Disabled"; }
				excluded.add({"key":step.get("key"),"reason":excludedReason});
			}
			else
			{
				roleText = step.get("roleId").toString();
				role = Approval_Role[ID == roleText.toLong()];
				if(role.ID == null || role.Active != true) { result.put("error","Role is missing or inactive for step "+expectedOrder); return result; }
				assignmentId = 0; assignmentRank = -1; assignmentCount = 0;
				for each assignment in Approval_Role_Assignment[Role == role.ID && Company == companyText.toLong()]
				{
					aTerritory = ifnull(assignment.Territory_Key,""); aDepartment = ifnull(assignment.Department_Key,"");
					aValid = (assignment.Effective_From == null || assignment.Effective_From <= day) && (assignment.Effective_To == null || day < assignment.Effective_To);
					if(aValid && (aTerritory == "" || aTerritory == territory) && (aDepartment == "" || aDepartment == department))
					{
						rank = 0; if(aTerritory != "") { rank = rank+4; } if(aDepartment != "") { rank = rank+2; }
						if(rank > assignmentRank) { assignmentRank = rank; assignmentId = assignment.ID; assignmentCount = 1; }
						else if(rank == assignmentRank) { assignmentCount = assignmentCount+1; }
					}
				}
				if(assignmentCount != 1) { result.put("error","Assignment for "+role.Role_Name+" is missing or ambiguous at the highest applicable scope."); return result; }
				assignment = Approval_Role_Assignment[ID == assignmentId];
				person = User_Access[ID == assignment.Person];
				email = ifnull(person.Approver_Email,"").trim();
				if(assignment.Active != true || person.ID == null || person.Approval_Routing_Enabled != true || person.User == null || !email.matches("[^ @]+@[^ @]+[.][^ @]+")) { result.put("error","Approver for "+role.Role_Name+" is inactive or has no valid Approver Email."); return result; }
				if(policy.Self_Approval == "Deny" && person.ID.toString() == submitterText) { result.put("error","Policy forbids submitter self-approval."); return result; }
				if(policy.Duplicate_Person == "Reject" && people.contains(person.ID.toString())) { result.put("error","One person fills multiple required roles; this policy rejects the overlap."); return result; }
				people.add(person.ID.toString());
				route.add({"order":route.size()+1,"policyStepOrder":expectedOrder,"key":step.get("key"),"roleId":role.ID.toString(),"role":role.Role_Name,"assignmentId":assignmentId.toString(),"userAccessId":person.ID.toString(),"name":ifnull(person.Full_Name,""),"email":email,"reason":reason});
			}
		}
		if(route.size() == 0) { result.put("error","No enabled applicable approval steps."); return result; }
		result.put("snapshot",{"policyId":policy.ID.toString(),"policyVersion":policy.Version,"context":context,"route":route,"excluded":excluded,"selfApproval":policy.Self_Approval,"duplicatePerson":policy.Duplicate_Person});
		result.put("success",true);
	}
	catch(e) { result.put("error","Approval configuration is invalid. Check scope, versions, ordered steps and exact amounts."); }
	return result;
}
