map resolveApprovalRoute(map context)
{
	result = {"success":false,"contract":"approval-policy-v1"};
	try
	{
		for each identityField in {"submitterId"}
		{
			typedIdentity = Map(); typedIdentity.put("value",context.get(identityField));
			if(!typedIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Submitter ID must be an exact string."); return result; }
		}
		workflows = {"Budget","Budget Modification","Pro Forma","Contract","Purchase Order"};
		if(!workflows.contains(context.get("workflow"))) { result.put("error","Workflow is invalid."); return result; }
		submitterText = ifnull(context.get("submitterId"),"").toString();
		amountText = thisapp.poCurrencyString(ifnull(context.get("amount"),"").toString());
		typedAmount = Map(); typedAmount.put("value",context.get("amount"));
		if(context.get("workflow") == "Pro Forma" || context.get("workflow") == "Contract") { amountText = "0.00"; typedAmount.put("value","0.00"); }
		if(amountText == "" || !typedAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*")) { result.put("error","Submitter identity and an exact amount are required."); return result; }
		territory = ifnull(context.get("territory"),"").toString();
		department = ifnull(context.get("department"),"").toString();
		amount = amountText.replaceAll("[.]","").toLong();
		policyId = 0; bestRank = -1; matched = 0;
		for each policy in Approval_Policy[Workflow == context.get("workflow") && Status == "Published"]
		{
			valid = true;
			pTerritory = ifnull(policy.Territory_Key,""); pDepartment = ifnull(policy.Department_Key,"");
			if(pTerritory != "" && pTerritory != territory) { valid = false; }
			if(pDepartment != "" && pDepartment != department) { valid = false; }
			if(valid)
			{
				rank = 0; if(pTerritory != "") { rank = rank+4; } if(pDepartment != "") { rank = rank+2; }
				if(rank > bestRank) { bestRank = rank; policyId = policy.ID; matched = 1; }
				else if(rank == bestRank) { matched = matched+1; }
			}
		}
		if(matched != 1) { result.put("error","Published policy is missing or ambiguous at the highest applicable scope."); return result; }
		policy = Approval_Policy[ID == policyId];
		if(policy.Enabled != true) { result.put("error","The applicable published policy is disabled. No broader fallback was used."); return result; }
		if(policy.Workflow != "Purchase Order" && policy.Self_Approval != "Allow" && policy.Self_Approval != "Deny") { result.put("error","Self-approval must be explicitly configured."); return result; }
		effectiveSelfApproval = policy.Self_Approval;
		if(policy.Workflow == "Purchase Order") { effectiveSelfApproval = "Allow"; }
		steps = List();
		for each rawPolicyStep in policy.Steps_JSON.toJSONList() { steps.add(rawPolicyStep.toString().toMap()); }
		if(steps.size() == 0 || steps.size() > 30) { result.put("error","Published policy requires 1–30 ordered steps."); return result; }
		// Owner-configured PO testing uses one captured CFO identity without changing shared assignments.
		for each configuredStep in steps
		{
			if(configuredStep.get("poTestCFO") != null)
			{
				testCFO = configuredStep.get("poTestCFO");
				if(policy.Workflow != "Purchase Order" || steps.size() != 1 || configuredStep.get("enabled") != true || configuredStep.get("condition") != "Always" || testCFO.get("allowSelfApproval") != true) { result.put("error","PO test CFO requires one enabled Always CFO step."); return result; }
				for each testIdentityField in {"budgetId","userAccessId"}
				{
					typedTestIdentity = {"value":testCFO.get(testIdentityField)};
					if(!typedTestIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","PO test CFO identities must be exact ID strings."); return result; }
				}
				typedContextBudget = {"value":context.get("budgetId")};
				if(!typedContextBudget.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","PO test budget context must be an exact ID string."); return result; }
				typedTestEmail = {"value":testCFO.get("email")};
				testEmailIsString = typedTestEmail.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[^\"]+\"[ ]*[}][ ]*");
				testEmailValid = testEmailIsString && ifnull(testCFO.get("email"),"").toString().matches("[^\\s@,;<>\"]+@[^\\s@,;<>\"]+[.][^\\s@,;<>\"]+");
				typedTestAmount = {"value":testCFO.get("maxAmount")}; testMaximum = thisapp.poCurrencyString(ifnull(testCFO.get("maxAmount"),"").toString());
				if(!typedTestAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || testMaximum == "" || testMaximum.replaceAll("[.]","").toLong() <= 0 || testMaximum.replaceAll("[.]","").toLong() > 5500 || testEmailValid != true) { result.put("error","PO test CFO needs a valid email and a positive maximum of at most $55."); return result; }
				if(context.get("budgetId") != testCFO.get("budgetId") || amount > testMaximum.replaceAll("[.]","").toLong() || context.get("hasBudgetModification") != false || context.get("hasBudgetOverrun") != false) { result.put("error","This PO is outside the configured test budget, amount or no-overrun scope."); return result; }
			}
		}
		route = List(); excluded = List(); stepKeys = List(); expectedOrder = 0;
		cfoSteps = 0;
		for each step in steps
		{
			expectedOrder = expectedOrder+1;
			if(!ifnull(step.get("key"),"").toString().matches("[A-Za-z0-9-]{1,80}") || step.get("order") != expectedOrder || stepKeys.contains(step.get("key"))) { result.put("error","Policy steps have duplicate keys or invalid sequential order."); return result; }
			typedRole = Map(); typedRole.put("value",step.get("roleId"));
			if(!typedRole.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*")) { result.put("error","Step role ID must be a string."); return result; }
			stepKeys.add(step.get("key"));
			condition = step.get("condition");
			if(policy.Workflow == "Purchase Order")
			{
				poRole = Approval_Role[ID == step.get("roleId").toString().toLong()];
				if(poRole.ID == null) { result.put("error","PO approver role was not found."); return result; }
				if(poRole.Role_Name == "CFO") { cfoSteps=cfoSteps+1; if(condition != "Always" || step.get("enabled") != true) { result.put("error","CFO must approve every purchase order."); return result; } }
				else { if(condition != "Budget modification attached") { result.put("error","Additional PO approvers are used only when the PO creates budget modifications."); return result; } }
			}
			if(policy.Workflow == "Pro Forma" || policy.Workflow == "Contract")
			{
				if(condition != "Always") { result.put("error","Pro Forma and Contract use straight approval chains without amount thresholds."); return result; }
			}
			applies = step.get("enabled") == true;
			reason = "Required step";
			if(step.get("enabled") != true && step.get("enabled") != false) { result.put("error","Step enabled state is not explicit."); return result; }
			if(condition == "Above" || condition == "At or above")
			{
				thresholdText = thisapp.poCurrencyString(ifnull(step.get("threshold"),"").toString());
				typedThreshold = Map(); typedThreshold.put("value",step.get("threshold"));
				if(thresholdText == "" || !typedThreshold.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*")) { result.put("error","Conditional threshold must be an exact currency string."); return result; }
				threshold = thresholdText.replaceAll("[.]","").toLong();
				if(condition == "Above" && amount <= threshold) { applies = false; }
				if(condition == "At or above" && amount < threshold) { applies = false; }
				reason = amountText+" is "+condition.toLowerCase()+" "+thresholdText;
			}
			else if(condition == "Budget modification attached")
			{
				if(policy.Workflow != "Purchase Order") { result.put("error","Linked budget modification conditions belong to Purchase Orders."); return result; }
				if(context.get("hasBudgetModification") != true && context.get("hasBudgetModification") != false) { result.put("error","Linked PO budget modification context is required."); return result; }
				if(context.get("hasBudgetModification") != true) { applies = false; }
				reason = "A budget modification is linked to this PO";
			}
			else if(condition != "Always") { result.put("error","Unsupported step condition."); return result; }
			if(applies != true)
			{
				excludedReason = condition+" threshold is not met";
				if(condition == "Budget modification attached") { excludedReason = "No budget modification is linked to this PO"; }
				if(step.get("enabled") == false) { excludedReason = "Disabled"; }
				excluded.add({"key":step.get("key"),"reason":excludedReason});
			}
			else
			{
				roleText = step.get("roleId").toString();
				role = Approval_Role[ID == roleText.toLong()];
				if(role.ID == null || role.Active != true) { result.put("error","Role is missing or inactive for step "+expectedOrder); return result; }
				assignmentId = 0; assignmentRank = -1; assignmentCount = 0; personId = 0; assignmentActive = false;
				personIds = List(); territoryDevMgr = role.Role_Name == "Dev Mgr";
				territoryVP = role.Role_Name == "VP";
				poTestCFO = step.get("poTestCFO"); testStep = poTestCFO != null;
				if(testStep)
				{
					if(role.Role_Name != "CFO") { result.put("error","PO test override must use the CFO role."); return result; }
					personId = poTestCFO.get("userAccessId").toLong(); assignmentActive = true; reason = "PO test CFO";
				}
				else if(territoryDevMgr)
				{
					territoryRecord = Territory[Territory_Name == territory];
					if(territoryRecord.count() != 1) { result.put("error","The territory must identify one Territory record with Dev Mgr users."); return result; }
					for each devMgrPerson in territoryRecord.Dev_Mgr { if(!personIds.contains(devMgrPerson.ID)) { personIds.add(devMgrPerson.ID); } }
					if(personIds.size() == 0) { result.put("error","Configure at least one Dev Mgr on the Territory record."); return result; }
					assignmentActive = true;
				}
				else if(territoryVP)
				{
					territoryRecord = Territory[Territory_Name == territory];
					if(territoryRecord.count() != 1) { result.put("error","The territory must identify one Territory record with a VP."); return result; }
					vpIds = List();
					for each vpPerson in territoryRecord.VP { if(!vpIds.contains(vpPerson.ID)) { vpIds.add(vpPerson.ID); } }
					if(vpIds.size() != 1) { result.put("error","Configure exactly one VP on the Territory record."); return result; }
					personId = vpIds.get(0); assignmentActive = true;
				}
				else
				{
				for each assignment in Approval_Role_Assignment[Role == role.ID]
				{
					aTerritory = ifnull(assignment.Territory_Key,""); aDepartment = ifnull(assignment.Department_Key,"");
					aValid = true;
					if(aTerritory != "" && aTerritory != territory) { aValid = false; }
					if(aDepartment != "" && aDepartment != department) { aValid = false; }
					if(aValid)
					{
						rank = 0; if(aTerritory != "") { rank = rank+4; } if(aDepartment != "") { rank = rank+2; }
						if(rank > assignmentRank) { assignmentRank = rank; assignmentId = assignment.ID; assignmentCount = 1; }
						else if(rank == assignmentRank) { assignmentCount = assignmentCount+1; }
					}
				}
				if(assignmentCount != 1) { result.put("error","Assignment for "+role.Role_Name+" is missing or ambiguous at the highest applicable scope."); return result; }
				assignment = Approval_Role_Assignment[ID == assignmentId];
				personId = assignment.Person; assignmentActive = assignment.Active == true;
				}
				if(!territoryDevMgr) { personIds.add(personId); }
				for each routePersonId in personIds
				{
				person = User_Access[ID == routePersonId];
				email = ifnull(person.Approver_Email,"").trim();
				if(testStep)
				{
					if(ifnull(person.User,"").toString().trim() == "") { result.put("error","PO test CFO login identity is unavailable."); return result; }
					email = poTestCFO.get("email").toString();
				}
				routingEnabled = person.Approval_Routing_Enabled == true;
				if(testStep) { routingEnabled = true; }
				if(assignmentActive != true || person.ID == null || routingEnabled != true || ifnull(person.User,"").toString().trim() == "" || !email.matches("[^ @]+@[^ @]+[.][^ @]+")) { result.put("error","Approver for "+role.Role_Name+" is inactive or has no valid Approver Email."); return result; }
				if(policy.Workflow != "Purchase Order" && policy.Self_Approval == "Deny" && person.ID.toString() == submitterText && !testStep) { result.put("error","Policy forbids submitter self-approval."); return result; }
				assignmentText = assignmentId.toString(); if(territoryVP || territoryDevMgr || testStep) { assignmentText = ""; }
				resolvedKey = step.get("key"); if(territoryDevMgr && personIds.size() > 1) { resolvedKey = resolvedKey+"-"+person.ID.toString(); }
				resolvedStep = {"order":route.size()+1,"policyStepOrder":expectedOrder,"key":resolvedKey,"roleId":role.ID.toString(),"role":role.Role_Name,"assignmentId":assignmentText,"userAccessId":person.ID.toString(),"name":ifnull(person.Full_Name,""),"email":email,"reason":reason};
				if(testStep) { resolvedStep.put("poTestCFO",poTestCFO); }
				route.add(resolvedStep);
				}
			}
		}
		if(policy.Workflow == "Purchase Order" && cfoSteps != 1) { result.put("error","Exactly one CFO must approve every purchase order."); return result; }
		if(route.size() == 0) { result.put("error","No enabled applicable approval steps."); return result; }
		result.put("snapshot",{"policyId":policy.ID.toString(),"context":context,"route":route,"excluded":excluded,"selfApproval":effectiveSelfApproval});
		result.put("success",true);
	}
	catch(e) { result.put("error","Approval configuration is invalid. Check scope, approvers and exact amounts."); }
	return result;
}
