map poApprovalBundle(string purchaseOrderId)
{
	result = {"success":false};
	try
	{
		po = Payment_Request[ID == purchaseOrderId.toLong() && Request_Type == "Purchase Order"];
		if(po.ID == null)
		{
			result.put("error","Purchase Order not found.");
			return result;
		}
		selectedId = 0;
		for each  candidate in Approval_Route_Snapshot[Workflow == "Purchase Order" && Record_ID == purchaseOrderId]
		{
			if(candidate.ID > selectedId)
			{
				selectedId = candidate.ID;
			}
		}
		if(selectedId == 0)
		{
			result.put("error","No combined approval chain is recorded for this PO.");
			return result;
		}
		captured = Approval_Route_Snapshot[ID == selectedId];
		context = captured.Context_JSON.toMap();
		routeSnapshot = captured.Route_JSON.toMap();
		route = List();
		executionIds = captured.Execution_JSON.toJSONList();
		for each  rawCapturedStep in routeSnapshot.get("route")
		{
			route.add(rawCapturedStep.toString().toMap());
		}
		if(context.get("budgetId") != po.Budget.toString() || context.get("recordId") != purchaseOrderId || context.get("submissionRevision") != captured.Submission_Revision || (po.PO_Approval_State != "Rejected" && captured.Submission_Revision != po.PO_Revision))
		{
			result.put("error","The approval chain does not match this PO submission.");
			return result;
		}
		if(executionIds.size() != route.size() || executionIds.size() == 0)
		{
			result.put("error","The combined approval chain is incomplete.");
			return result;
		}
		modifications = List();
		seenItems = List();
		for each  rawIntended in context.get("modifications")
		{
			intended = rawIntended.toString().toMap();
			modification = Budget_Modification[ID == intended.get("id").toLong() && Budget == po.Budget];
			customComponents = intended.get("componentReallocation") == true;
			intendedType = "Increase";
			if(customComponents) { intendedType = intended.get("modificationType"); }
			if(modification.ID == null || modification.Budget_Item.toString() != intended.get("budgetItemId") || modification.Modification_Type != intendedType || (intendedType != "Increase" && intendedType != "Decrease") || (modification.Component_Reallocation == true) != customComponents || (customComponents && context.get("reallocationContract") != "po-reallocation-v1") || thisapp.poCurrencyString(modification.Amount.toString()) != intended.get("amount") || modification.Reference_Number != intended.get("reference") || seenItems.contains(intended.get("budgetItemId")))
			{
				result.put("error","A linked budget modification differs from this PO approval bundle.");
				return result;
			}
			seenItems.add(intended.get("budgetItemId"));
			modificationEntry = {"id":modification.ID.toString(),"budgetItemId":modification.Budget_Item.toString(),"amount":intended.get("amount"),"reference":modification.Reference_Number,"status":modification.Status};
			if(customComponents && (intended.get("components") == null || intended.get("reason") != ifnull(modification.Reason,""))) { result.put("error","A reallocation reason or component contract differs from its approved request."); return result; }
			// Legacy approval snapshots have no split and remain unallocated.
			if(intended.get("components") != null)
			{
				intendedComponents = intended.get("components").toString().toMap();
				nativeComponents = {"1":modification.Labor_Budget,"2":modification.Materials_Budget,"3":modification.Equipment_Budget,"4":modification.Subcontractor_Budget,"5":modification.Other_Budget};
				componentAmounts = Map();
				signedComponents = Map(); componentTotal = 0; componentGross = 0;
				for each  componentCode in {"1","2","3","4","5"}
				{
					componentValue = nativeComponents.get(componentCode);
					capturedComponent = intendedComponents.get(componentCode);
					componentSign = 1; componentText = ifnull(componentValue,"").toString();
					if(componentText.startsWith("-") && customComponents) { componentSign = -1; componentText = componentText.subString(1,componentText.length()); }
					componentText = thisapp.poCurrencyString(componentText);
					if(componentText != "" && componentSign == -1 && componentText != "0.00") { componentText = "-" + componentText; }
					if(componentValue == null || capturedComponent == null || componentText == "" || componentText != capturedComponent.toString())
					{
						result.put("error","A linked budget modification's component split differs from its PO approval bundle.");
						return result;
					}
					componentAmounts.put(componentCode,componentText);
					partCents = componentText.replaceAll("[.]","").toLong(); componentTotal = componentTotal + partCents;
					if(partCents < 0) { componentGross = componentGross - partCents; } else { componentGross = componentGross + partCents; }
					if(intendedType == "Decrease") { partCents = 0 - partCents; }
					partSign = ""; if(partCents < 0) { partSign = "-"; partCents = 0 - partCents; }
					partDigits = partCents.toString(); if(partDigits.length() == 1) { partDigits = "00" + partDigits; } if(partDigits.length() == 2) { partDigits = "0" + partDigits; }
					signedComponents.put(componentCode,partSign + partDigits.subString(0,partDigits.length() - 2) + "." + partDigits.subString(partDigits.length() - 2,partDigits.length()));
				}
				modificationEntry.put("components",componentAmounts);
				if(customComponents)
				{
					if(componentTotal != intended.get("amount").replaceAll("[.]","").toLong() || componentGross <= 0 || componentGross > 999999999999999) { result.put("error","A reallocation component total does not match its captured net amount."); return result; }
					modificationEntry.put("componentReallocation",true); modificationEntry.put("modificationType",intendedType); modificationEntry.put("signedComponents",signedComponents); modificationEntry.put("reason",intended.get("reason"));
				}
			}
			modifications.add(modificationEntry);
		}
		if(context.get("reallocationContract") == "po-reallocation-v1")
		{
			reviewedPlan = context.get("reallocation");
			if(reviewedPlan == null || reviewedPlan.get("contract") != "po-reallocation-v1" || reviewedPlan.get("items") == null) { result.put("error","The captured reallocation plan is unavailable."); return result; }
			reviewedIds = List(); reviewedCount = 0;
			for each rawReviewed in reviewedPlan.get("items")
			{
				reviewed = rawReviewed.toString().toMap(); reviewedId = reviewed.get("budgetItemId");
				if(reviewedId == null || reviewedIds.contains(reviewedId) || reviewed.get("components") == null || reviewed.get("components").keys().size() != 5 || PO_Item[Purchase_Order == po.ID && Revision == captured.Submission_Revision && Budget_Item == reviewedId.toString().toLong()].count() == 0) { result.put("error","The captured reallocation item identities differ from this PO revision."); return result; }
				reviewedIds.add(reviewedId); reviewedGross = 0; reviewedEntry = Map();
				for each matchedModification in modifications { if(matchedModification.get("budgetItemId") == reviewedId) { reviewedEntry = matchedModification; } }
				for each reviewedCode in {"1","2","3","4","5"}
				{
					reviewedText = reviewed.get("components").get(reviewedCode);
					typedReviewed = {"value":reviewedText};
					if(!typedReviewed.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"-?[0-9]+[.][0-9]{2}\"[ ]*[}][ ]*")) { result.put("error","A captured signed reallocation component is invalid."); return result; }
					reviewedCents = reviewedText.replaceAll("[.]","").toLong(); if(reviewedCents < 0) { reviewedGross = reviewedGross - reviewedCents; } else { reviewedGross = reviewedGross + reviewedCents; }
					if(reviewedEntry.get("id") != null && (reviewedEntry.get("componentReallocation") != true || reviewedEntry.get("signedComponents").get(reviewedCode) != reviewedText || reviewedEntry.get("reason") != reviewed.get("reason"))) { result.put("error","A reallocation record differs from the reviewed signed plan."); return result; }
				}
				if(reviewedGross > 0) { reviewedCount = reviewedCount + 1; if(reviewedEntry.get("id") == null) { result.put("error","A reviewed reallocation record is missing."); return result; } }
				else if(reviewedEntry.get("id") != null) { result.put("error","A zero-only reallocation created an unexpected modification."); return result; }
			}
			if(reviewedCount != modifications.size()) { result.put("error","The captured reallocation record count differs from its reviewed plan."); return result; }
		}
		rows = List();
		pending = 0;
		approved = 0;
		rejected = 0;
		position = 0;
		active = Map();
		seenRows = List();
		seenPeople = List();
		testCFOEvidence = null;
		for each  executionId in executionIds
		{
			position = position + 1;
			step = route.get(position - 1);
			row = Budget_Approvals[ID == executionId.toLong() && Budget == po.Budget && Type1 == "Purchase Order"];
			testCFO = step.get("poTestCFO");
			testSelfApproval = false;
			if(testCFO != null)
			{
				for each  testIdentityField in {"budgetId","userAccessId"}
				{
					typedTestIdentity = {"value":testCFO.get(testIdentityField)};
					if(!typedTestIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
					{
						result.put("error","Captured PO test CFO identities are invalid.");
						return result;
					}
				}
				for each  testContextIdentityField in {"budgetId","submitterId","recordId"}
				{
					typedContextIdentity = {"value":context.get(testContextIdentityField)};
					if(!typedContextIdentity.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}][ ]*"))
					{
						result.put("error","Captured PO test context identities are invalid.");
						return result;
					}
				}
				typedTestEmail = {"value":testCFO.get("email")};
				testEmailIsString = typedTestEmail.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[^\"]+\"[ ]*[}][ ]*");
				testEmailValid = testEmailIsString && ifnull(testCFO.get("email"),"").toString().matches("[^\\s@,;<>\"]+@[^\\s@,;<>\"]+[.][^\\s@,;<>\"]+");
				typedTestAmount = {"value":testCFO.get("maxAmount")};
				testMaximum = thisapp.poCurrencyString(ifnull(testCFO.get("maxAmount"),"").toString());
				typedContextAmount = {"value":context.get("amount")};
				testAmount = thisapp.poCurrencyString(ifnull(context.get("amount"),"").toString());
				if(!typedTestAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || !typedContextAmount.toString().matches("[ ]*[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+([.][0-9]{1,2})?\"[ ]*[}][ ]*") || testMaximum == "" || testAmount == "" || testMaximum.replaceAll("[.]","").toLong() <= 0 || testMaximum.replaceAll("[.]","").toLong() > 5500 || testAmount.replaceAll("[.]","").toLong() <= 0 || testAmount.replaceAll("[.]","").toLong() > testMaximum.replaceAll("[.]","").toLong())
				{
					result.put("error","Captured PO test CFO amount is outside its maximum.");
					return result;
				}
				testAmountMatches = true;
				if(po.PO_Approval_State != "Rejected")
				{
					testAmountMatches = testAmount == po.PO_Amount_Exact;
				}
				if(context.get("workflow") != "Purchase Order" || route.size() != 1 || position != 1 || step.get("role") != "CFO" || step.get("reason") != "PO test CFO" || step.get("assignmentId") != "" || testCFO.get("allowSelfApproval") != true || context.get("budgetId") != testCFO.get("budgetId") || po.Budget.toString() != testCFO.get("budgetId") || step.get("userAccessId") != testCFO.get("userAccessId") || step.get("email") != testCFO.get("email") || testEmailValid != true || context.get("hasBudgetModification") != false || context.get("hasBudgetOverrun") != false || modifications.size() != 0 || context.get("modifications").size() != 0 || testAmountMatches != true)
				{
					result.put("error","Captured PO test CFO scope could not be verified.");
					return result;
				}
				testPerson = User_Access[ID == testCFO.get("userAccessId").toLong()];
				if(testPerson.ID == null || ifnull(testPerson.User,"").toString().trim() == "")
				{
					result.put("error","Captured PO test CFO login identity is unavailable.");
					return result;
				}
				testSelfApproval = true;
				testCFOEvidence = testCFO;
			}
			if(step.get("reason") == "PO test CFO" && step.get("poTestCFO") == null)
			{
				result.put("error","Captured PO test CFO scope could not be verified.");
				return result;
			}
			if(seenPeople.contains(step.get("userAccessId")))
			{
				result.put("error","PO approval steps must use distinct people.");
				return result;
			}
			seenPeople.add(step.get("userAccessId"));
			if(row.ID == null || seenRows.contains(executionId) || row.Sort_Order != position || row.Title != step.get("role") || row.Approver != step.get("email"))
			{
				result.put("error","A PO approval step differs from its captured route.");
				return result;
			}
			seenRows.add(executionId);
			sent = "";
			responded = "";
			if(row.Sent_Date != null)
			{
				sent = row.Sent_Date.toString("yyyy-MM-dd");
			}
			if(row.Responded_Date != null)
			{
				responded = row.Responded_Date.toString("yyyy-MM-dd");
			}
			entry = {"id":executionId,"order":position,"role":row.Title,"email":row.Approver,"userAccessId":step.get("userAccessId"),"status":row.Status,"sentDate":sent,"respondedDate":responded,"notes":ifnull(row.Approval_Notes,"")};
			if(testSelfApproval)
			{
				entry.put("poTestCFO",testCFO);
			}
			if(row.Status == "Pending")
			{
				pending = pending + 1;
				active = entry;
			}
			else if(row.Status == "Approved")
			{
				approved = approved + 1;
			}
			else if(row.Status == "Rejected")
			{
				rejected = rejected + 1;
			}
			else if(row.Status != "Not Sent")
			{
				result.put("error","Unknown PO approval step state.");
				return result;
			}
			displayPerson = User_Access[ID == step.get("userAccessId").toLong()];
			displayName = "";
			if(displayPerson.count() == 1)
			{
				displayName = ifnull(displayPerson.Full_Name,"").toString().trim();
			}
			entry.put("name",displayName);
			rows.add(entry);
		}
		chainValid = pending <= 1;
		if(po.PO_Approval_State == "Pending")
		{
			chainValid = pending == 1 && rejected == 0;
		}
		if(po.PO_Approval_State == "Approved")
		{
			chainValid = approved == rows.size() && pending == 0;
		}
		if(po.PO_Approval_State == "Rejected")
		{
			chainValid = rejected == 1 && pending == 0;
		}
		if(chainValid != true)
		{
			result.put("error","The PO approval state and combined chain do not reconcile.");
			return result;
		}
		if(po.PO_Approval_State == "Pending")
		{
			for each  entry in rows
			{
				if((entry.get("order") < active.get("order") && entry.get("status") != "Approved") || (entry.get("order") > active.get("order") && entry.get("status") != "Not Sent"))
				{
					result.put("error","PO approval order needs review.");
					return result;
				}
			}
		}
		for each  modification in modifications
		{
			wanted = "Submitted";
			if(po.PO_Approval_State == "Approved")
			{
				wanted = "Approved";
			}
			if(po.PO_Approval_State == "Rejected")
			{
				wanted = "Rejected";
			}
			if(modification.get("status") != wanted)
			{
				result.put("error","PO and linked modification approval states differ.");
				return result;
			}
		}
		canApprove = false;
		access = User_Access[User == zoho.loginuser];
		if(access.count() == 1 && active.get("userAccessId") == access.ID.toString())
		{
			canApprove = true;
		}
		canRetryEmail = canApprove || zoho.loginuser == zoho.adminuser || (access.count() == 1 && context.get("submitterId") == access.ID.toString());
		bundle = {"snapshotId":captured.ID.toString(),"revision":captured.Submission_Revision,"submitterId":context.get("submitterId"),"modifications":modifications,"rows":rows,"active":active,"canApprove":canApprove,"canRetryEmail":canRetryEmail,"emailSent":active.get("sentDate") != null && active.get("sentDate") != ""};
		if(context.get("reallocationContract") == "po-reallocation-v1") { bundle.put("reallocationContract","po-reallocation-v1"); bundle.put("reallocation",context.get("reallocation")); }
		if(testCFOEvidence != null)
		{
			bundle.put("poTestCFO",testCFOEvidence);
		}
		result.put("bundle",bundle);
		result.put("success",true);
	}	catch (bundleError)
	{
		result.put("error","The combined PO and modification approval chain could not be verified.");
	}
	return result;
}
