string deleteProformaAttachment(string proformaId, string attachmentId)
{
	/********* DELETE ONE PRO FORMA ATTACHMENT CHILD RECORD *********/
	vProformaId = ifnull(proformaId,"").trim();
	vAttachmentId = ifnull(attachmentId,"").trim();
	if(vProformaId == "" || vAttachmentId == "")
	{
		return "Missing Pro Forma ID or attachment ID.";
	}
	attachmentRows = Contract_Version[ID == vAttachmentId.toLong() && Pro_Forma == vProformaId.toLong()];
	if(attachmentRows.count() == 0)
	{
		return "Attachment record was not found for this Pro Forma.";
	}
	try
	{
		delete from Contract_Version[ID == vAttachmentId.toLong() && Pro_Forma == vProformaId.toLong()];
		return "Attachment deleted.";
	}
	catch (deleteError)
	{
		return "Attachment deletion failed: " + deleteError.toString();
	}
}
