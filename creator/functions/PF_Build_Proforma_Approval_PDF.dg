		page = page + thisapp.PF_PDF_Text(894,651,7.1,"bold",navy,"DEVELOPMENT ADD'L COSTS");
		page = page + thisapp.PF_PDF_Text(1114,651,7.1,"bold",ink,thisapp.PF_Packet_Money(developmentAdditionalTotal.toString()));
		page = page + thisapp.PF_PDF_Text(894,620,5.6,"bold",lightMuted,"ITEM");
		page = page + thisapp.PF_PDF_Text(1065,620,5.6,"bold",lightMuted,"APPLICATION");
		page = page + thisapp.PF_PDF_Text(1118,620,5.6,"bold",lightMuted,"AMOUNT");
		page = page + thisapp.PF_PDF_Rect(882,44,314,228,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(882,246,314,26,softBlue,"",0);
		page = page + thisapp.PF_PDF_Text(894,255,7.1,"bold",navy,"CONSTRUCTION ADD'L COSTS");
		page = page + thisapp.PF_PDF_Text(1114,255,7.1,"bold",ink,thisapp.PF_Packet_Money(constructionAdditionalTotal.toString()));
		page = page + thisapp.PF_PDF_Text(894,225,5.6,"bold",lightMuted,"ITEM");
		page = page + thisapp.PF_PDF_Text(1065,225,5.6,"bold",lightMuted,"APPLICATION");
		page = page + thisapp.PF_PDF_Text(1118,225,5.6,"bold",lightMuted,"AMOUNT");
		developmentItemCount = 0;
		constructionItemCount = 0;

