		developmentCostBlocks = List();
		constructionCostBlocks = List();
		otherCostBlocks = List();
		impactFeeBlocks = List();
		otherReimbursementBlocks = List();
		costNumber = 0;
		for each costItemId in additionalItemIds
		{
			costItem = Proforma_Item[ID == costItemId.toLong()];
			itemText = ifnull(costItem.Item_Name,"Additional Cost").toString();
			code = ifnull(costItem.Cost_Code,"").toString().trim();
			if(code != "") { itemText = code + " - " + itemText; }
			categoryText = ifnull(costItem.Category,"").toString();
			isReimbursement = categoryText.trim().toLowerCase() == "reimbursements";
			isImpactFee = isReimbursement && ifnull(costItem.Item_Name,"").toString().toLowerCase().contains("impact fee");
			blockTitle = itemText;
			if(!isReimbursement)
			{
				costNumber = costNumber + 1;
				blockTitle = costNumber.toString() + ". " + itemText;
			}
			departmentText = ifnull(costItem.Department,"Unassigned").toString();
			applicationText = ifnull(costItem.Cost_Application,"Not provided").toString();
			if(isImpactFee)
			{
				applicationText = "At lot sale";
			}
			else if(ifnull(costItem.Specific_Months_List,"").toString().trim() != "")
			{
				applicationText = applicationText + " | Months " + costItem.Specific_Months_List;
			}
			else if(costItem.Start_Phase != null || costItem.End_Phase != null)
			{
				applicationText = applicationText + " | Phase " + ifnull(costItem.Start_Phase,"?") + "-" + ifnull(costItem.End_Phase,"?");
			}
			else if(costItem.Start_Month != null || costItem.End_Month != null)
			{
				applicationText = applicationText + " | Months " + ifnull(costItem.Start_Month,"?") + "-" + ifnull(costItem.End_Month,"?");
			}
			block = Map();
			block.put("title",blockTitle);
			block.put("meta",departmentText + " / " + categoryText + " | " + applicationText);
			noteText = ifnull(costItem.Description,"").toString().trim();
			if(noteText != "") { block.put("body","Notes: " + noteText); }
			block.put("amount",thisapp.PF_Packet_Money(ifnull(costItem.Add_l_Cost,0).toString()));
			block.put("credit",isReimbursement);
			if(isImpactFee)
			{
				impactFeeBlocks.add(block);
			}
			else if(isReimbursement)
			{
				otherReimbursementBlocks.add(block);
			}
			else if(departmentText != "Construction")
			{
				developmentCostBlocks.add(block);
			}
			else if(departmentText == "Construction")
			{
				constructionCostBlocks.add(block);
			}
			else
			{
				otherCostBlocks.add(block);
			}
		}
