		 * never renders a contradictory "Not provided" value. */
		loiEffectiveDate = zoho.currentdate.toString("MMM d, yyyy");
		loiHardCloseDate = "Not provided";
		loiEarnestDueDate = "Not provided";
		/*
		* Build the party values from the actual Builder/Seller records
		* created or selected in the LOI tab. Fall back to legacy Pro Forma
		* header fields only when no linked Seller records exist.
		*/
		sellerNamesText = "";
		sellerEmailsText = "";
		sellerPhonesText = "";
		sellerAddressesText = "";
		offerSellerNameById = Map();
		for each  sellerItem in sellers
		{
			sellerNameText = ifnull(sellerItem.Builder_Name,"").toString().trim();
			if(sellerItem.ID != null)
			{
				offerSellerNameById.put(sellerItem.ID.toString(),if(sellerNameText == "","Seller #" + sellerItem.ID.toString(),sellerNameText));
			}
			if(sellerNameText != "")
			{
				if(sellerNamesText != "")
				{
					sellerNamesText = sellerNamesText + ", ";
				}
				sellerNamesText = sellerNamesText + sellerNameText;
			}
			sellerEmailText = ifnull(sellerItem.Email,"").toString().trim();
			if(sellerEmailText != "")
			{
				if(sellerEmailsText != "")
				{
					sellerEmailsText = sellerEmailsText + ", ";
				}
				sellerEmailsText = sellerEmailsText + sellerEmailText;
			}
			sellerPhoneText = ifnull(sellerItem.Phone_Number,"").toString().trim();
			if(sellerPhoneText != "")
			{
				if(sellerPhonesText != "")
				{
					sellerPhonesText = sellerPhonesText + ", ";
				}
				sellerPhonesText = sellerPhonesText + sellerPhoneText;
			}
			sellerAddressText = ifnull(sellerItem.Street_Address,ifnull(sellerItem.Address,"")).toString().trim();
			sellerCityStateText = ifnull(sellerItem.City_State_ZIP,"").toString().trim();
			if(sellerCityStateText != "")
			{
				if(sellerAddressText != "")
				{
					sellerAddressText = sellerAddressText + ", ";
				}
				sellerAddressText = sellerAddressText + sellerCityStateText;
			}
			if(sellerAddressText != "")
			{
				if(sellerAddressesText != "")
				{
					sellerAddressesText = sellerAddressesText + "; ";
				}
				sellerAddressesText = sellerAddressesText + sellerAddressText;
			}
		}
		loiSeller = sellerNamesText;
		if(loiSeller == "")
		{
			loiSeller = ifnull(pf.Seller,"Not provided").toString();
		}
		loiSellerEmail = sellerEmailsText;
		if(loiSellerEmail == "")
		{
			loiSellerEmail = ifnull(pf.Seller_Email,"Not provided").toString();
		}
		loiSellerPhone = sellerPhonesText;
		if(loiSellerPhone == "")
		{
			loiSellerPhone = ifnull(pf.Seller_Phone,"Not provided").toString();
		}
		loiSellerCityStateZip = sellerAddressesText;
		if(loiSellerCityStateZip == "")
		{
			loiSellerCityStateZip = ifnull(pf.Seller_City_State_ZIP,"Not provided").toString();
		}
		loiAuthorizedSigner = ifnull(pf.Authorized_Signer_for_Seller,"Not provided").toString();
		/*
		* Build the property values from the actual Property records linked
		* to this Pro Forma. These are the records created or selected in
		* the LOI tab.
		*/
		propertyNamesText = "";
		propertyLocationsText = "";
		propertyCountiesText = "";
		propertyCitiesText = "";
		propertyCountyList = List();
		propertyCityList = List();
		propertyIdsText = "";
		propertyFacilityIdsText = "";
		propertySellerAssignmentsText = "";
		propertyAcresTotal = 0;
		for each  propertyItem in properties
		{
			propertyNameText = ifnull(propertyItem.Common_Name,"").toString().trim();
			if(propertyNameText == "")
			{
				propertyNameText = ifnull(propertyItem.Property_ID,"").toString().trim();
			}
			if(propertyNameText != "")
			{
				if(propertyNamesText != "")
				{
					propertyNamesText = propertyNamesText + "; ";
				}
				propertyNamesText = propertyNamesText + propertyNameText;
			}
			propertyLocationText = ifnull(propertyItem.Location,"").toString().trim();
			if(propertyLocationText != "")
			{
				if(propertyLocationsText != "")
				{
					propertyLocationsText = propertyLocationsText + "; ";
				}
				propertyLocationsText = propertyLocationsText + propertyLocationText;
			}
			propertyCountyText = ifnull(propertyItem.County,"").toString().trim();
			if(propertyCountyText != "" && propertyCountyList.contains(propertyCountyText) == false)
			{
				propertyCountyList.add(propertyCountyText);
			}
			propertyCityText = ifnull(propertyItem.City,"").toString().trim();
			if(propertyCityText != "" && propertyCityList.contains(propertyCityText) == false)
			{
				propertyCityList.add(propertyCityText);
			}
			propertyIdText = ifnull(propertyItem.Property_ID,"").toString().trim();
			if(propertyIdText != "")
			{
				if(propertyIdsText != "")
				{
					propertyIdsText = propertyIdsText + ", ";
				}
				propertyIdsText = propertyIdsText + propertyIdText;
			}
			propertyFacilityIdText = ifnull(propertyItem.Facility_ID,"").toString().trim();
			if(propertyFacilityIdText != "")
			{
				if(propertyFacilityIdsText != "")
				{
					propertyFacilityIdsText = propertyFacilityIdsText + ", ";
				}
				propertyFacilityIdsText = propertyFacilityIdsText + propertyFacilityIdText;
			}
			if(propertyItem.Seller != null)
			{
				propertySellerName = offerSellerNameById.get(propertyItem.Seller.toString());
				if(propertySellerName == null)
				{
					propertySellerName = "Seller #" + propertyItem.Seller.toString();
				}
				if(propertySellerAssignmentsText != "")
				{
					propertySellerAssignmentsText = propertySellerAssignmentsText + "; ";
				}
				propertySellerAssignmentsText = propertySellerAssignmentsText + propertyNameText + ": " + propertySellerName;
			}
			if(propertyItem.Acres != null && propertyItem.Acres.toString().trim() != "")
			{
				propertyAcresTotal = propertyAcresTotal + propertyItem.Acres.toDecimal();
			}
		}
		propertyCountiesText = propertyCountyList.toString(", ");
		propertyCitiesText = propertyCityList.toString(", ");
		loiStreetAddress = propertyNamesText;
		if(propertyLocationsText != "")
		{
			if(loiStreetAddress != "")
			{
				loiStreetAddress = loiStreetAddress + " — ";
			}
			loiStreetAddress = loiStreetAddress + propertyLocationsText;
		}
		if(loiStreetAddress == "")
		{
			loiStreetAddress = ifnull(pf.Street_Address,"Not provided").toString();
		}
		loiCadId = propertyIdsText;
		if(loiCadId == "")
		{
			loiCadId = ifnull(pf.CAD_ID,"Not provided").toString();
		}
		loiPropertyCounty = propertyCountiesText;
		if(loiPropertyCounty == "")
		{
			loiPropertyCounty = ifnull(pf.Property_County,"Not provided").toString();
		}
		loiPropertyCity = propertyLocationsText;
		if(loiPropertyCity == "")
		{
			loiPropertyCity = ifnull(pf.Property_City,"Not provided").toString();
		}
		/*
		* Worksheet terms take priority. Pro Forma header values remain
		* fallbacks for older records that predate LOI_Worksheet.
		*/
		loiAmountPerAcre = ifnull(pf.Land_Cost_Acre,"").toString();
		loiTotalAcres = ifnull(pf.Total_Acres,"").toString();
		if(loiTotalAcres == "" && propertyAcresTotal > 0)
		{
			loiTotalAcres = propertyAcresTotal.toString();
		}
		loiEstimatedPrice = "";
		loiEarnestMoney = ifnull(pf.Earnest_Money,"").toString();
		loiFeasibilityDays = ifnull(pf.Initial_Feasibility_Days,"").toString();
		loiClosingDays = ifnull(pf.Closing_Days_Feas,"").toString();
		loiExtensions = ifnull(pf.Extensions,"").toString();
		loiDaysPerExtension = ifnull(pf.Days_per_Extension,"").toString();
		loiAmountPerExtension = ifnull(pf.Amount_per_Extension,"").toString();
		loiEarnestDueDays = "";
		loiBuyerBroker = ifnull(pf.Broker_Buyer,"Not provided").toString();
		loiSellerBroker = ifnull(pf.Broker_Seller,"Not provided").toString();
		loiAcquisitionEmail = ifnull(pf.Acquisition_Email,"Not provided").toString();
		loiSpecialProvisions = ifnull(pf.Special_Provisions,"Not provided").toString();
		loiLegalNote = "Not provided";
		if(loi.ID != null)
		{
			loiName = ifnull(loi.LOI_Name,"Not provided").toString();
			loiStatus = ifnull(loi.Legal_Status,"Not provided").toString();
			loiVersion = ifnull(loi.Version_Number,"Not provided").toString();
			if(loi.Response_Date != null)
			{
				loiResponseDate = loi.Response_Date.toString("MMM d, yyyy");
			}
			if(loi.Assumed_Effective_Date != null)
			{
				loiEffectiveDate = loi.Assumed_Effective_Date.toString("MMM d, yyyy");
			}
			if(loi.Projected_Hard_Close_Date != null)
			{
				loiHardCloseDate = loi.Projected_Hard_Close_Date.toString("MMM d, yyyy");
			}
			if(loi.Earnest_Money_Due_Date != null)
			{
				loiEarnestDueDate = loi.Earnest_Money_Due_Date.toString("MMM d, yyyy");
			}
			loiAmountPerAcre = ifnull(loi.Amount_Per_Acre,loiAmountPerAcre).toString();
			loiTotalAcres = ifnull(loi.Total_Acres,loiTotalAcres).toString();
			loiEstimatedPrice = ifnull(loi.Estimated_Price,"").toString();
			loiEarnestMoney = ifnull(loi.Earnest_Money,loiEarnestMoney).toString();
			loiFeasibilityDays = ifnull(loi.Initial_Feasibility_Days,loiFeasibilityDays).toString();
			loiClosingDays = ifnull(loi.Closing_Days_After_Feasibility,loiClosingDays).toString();
			loiExtensions = ifnull(loi.Extensions,loiExtensions).toString();
			loiDaysPerExtension = ifnull(loi.Days_Per_Extension,loiDaysPerExtension).toString();
			loiAmountPerExtension = ifnull(loi.Amount_Per_Extension,loiAmountPerExtension).toString();
			loiEarnestDueDays = ifnull(loi.Earnest_Money_Due_Days,"").toString();
			loiBuyerBroker = ifnull(loi.Buyer_Broker,loiBuyerBroker).toString();
			loiSellerBroker = ifnull(loi.Seller_Broker,loiSellerBroker).toString();
			loiAcquisitionEmail = ifnull(loi.Acquisition_Email,loiAcquisitionEmail).toString();
			loiSpecialProvisions = ifnull(loi.Special_Provisions,loiSpecialProvisions).toString();
			loiLegalNote = ifnull(loi.Legal_Note,"Not provided").toString();
		}
		if(loiEstimatedPrice == "" && loiTotalAcres != "" && loiAmountPerAcre != "")
		{
			loiEstimatedPrice = (loiTotalAcres.toDecimal() * loiAmountPerAcre.toDecimal()).toString();
		}
		else if(loiEstimatedPrice == "" && pf.Land_Cost != null)
		{
			loiEstimatedPrice = pf.Land_Cost.toString();
		}
		/*
		* Friendly LOI display values that do not render missing
		* numbers as "$0" or "- days".
		*/
		loiAcresDisplay = "Not provided";
		if(loiTotalAcres != "")
		{
			loiAcresDisplay = thisapp.PF_Packet_Number(loiTotalAcres,2);
		}
		loiAmountPerAcreDisplay = "Not provided";
		if(loiAmountPerAcre != "")
		{
			loiAmountPerAcreDisplay = thisapp.PF_Packet_Money(loiAmountPerAcre);
		}
		loiEstimatedPriceDisplay = "Not provided";
		if(loiEstimatedPrice != "")
		{
			loiEstimatedPriceDisplay = thisapp.PF_Packet_Money(loiEstimatedPrice);
		}
		loiEarnestMoneyDisplay = "Not provided";
		if(loiEarnestMoney != "")
		{
			loiEarnestMoneyDisplay = thisapp.PF_Packet_Money(loiEarnestMoney);
		}
		loiFeasibilityDisplay = "Not provided";
		if(loiFeasibilityDays != "")
		{
			loiFeasibilityDisplay = thisapp.PF_Packet_Number(loiFeasibilityDays,0) + " days";
		}
		loiClosingDisplay = "Not provided";
		if(loiClosingDays != "")
		{
			loiClosingDisplay = thisapp.PF_Packet_Number(loiClosingDays,0) + " days";
		}
		loiExtensionsDisplay = "Not provided";
		if(loiExtensions != "")
		{
			loiExtensionsDisplay = thisapp.PF_Packet_Number(loiExtensions,0);
		}
		loiDaysPerExtensionDisplay = "Not provided";
		if(loiDaysPerExtension != "")
		{
			loiDaysPerExtensionDisplay = thisapp.PF_Packet_Number(loiDaysPerExtension,0) + " days";
		}
		loiAmountPerExtensionDisplay = "Not provided";
		if(loiAmountPerExtension != "")
		{
			loiAmountPerExtensionDisplay = thisapp.PF_Packet_Money(loiAmountPerExtension);
		}
		loiEarnestDueDaysDisplay = "Not provided";
		if(loiEarnestDueDays != "")
		{
			loiEarnestDueDaysDisplay = thisapp.PF_Packet_Number(loiEarnestDueDays,0) + " days";
		}
		/*
		* =========================================================
		* OFFER SUMMARY - ONE ATTORNEY-READABLE 17 x 11 PAGE
		* =========================================================
		*/
		loiEarnestDueDisplay = loiEarnestDueDate;
		if(loiEarnestDueDays != "")
		{
			loiEarnestDueDisplay = loiEarnestDueDaysDisplay + " after execution";
			if(loiEarnestDueDate != "Not provided") { loiEarnestDueDisplay = loiEarnestDueDate + " (" + loiEarnestDueDisplay + ")"; }
		}
		offerOverflowBlocks = List();
		page = "% OFFER_WIDE_PAGE\n" + thisapp.PF_PDF_Rect(0,0,1224,792,canvas,"",0);
		page = page + thisapp.PF_PDF_Rect(0,716,1224,76,deepNavy,"",0);
		page = page + thisapp.PF_PDF_Rect(0,716,1224,4,purple,"",0);
		page = page + thisapp.PF_PDF_Text(28,758,19,"bold",white,"Offer Summary");
		page = page + thisapp.PF_PDF_Text(28,735,8.5,"regular","0.77 0.85 0.95",pfName + "   |   Attorney review   |   Worksheet: " + loiName + "   |   Status: " + loiStatus + "   |   Version: " + loiVersion);
		economicX = {28,278,528};
		economicLabels = {"TOTAL ACRES","AMOUNT PER ACRE","ESTIMATED PURCHASE PRICE"};
		economicValues = {loiAcresDisplay,loiAmountPerAcreDisplay,loiEstimatedPriceDisplay};
		economicColors = {blue,purple,green};
		economicFills = {softBlue,softPurple,softGreen};
		for each index economicIndex in economicX
		{
			x = economicX.get(economicIndex);
			page = page + thisapp.PF_PDF_Rect(x,620,236,58,economicFills.get(economicIndex),softLine,0.35);
			page = page + thisapp.PF_PDF_Rect(x,672,236,6,economicColors.get(economicIndex),"",0);
			page = page + thisapp.PF_PDF_Text(x + 14,654,6.5,"bold",muted,economicLabels.get(economicIndex));
			page = page + thisapp.PF_PDF_Text(x + 14,630,13.5,"bold",economicColors.get(economicIndex),economicValues.get(economicIndex));
		}
		page = page + thisapp.PF_PDF_Rect(816,620,380,58,white,line,0.35);
		metaLabels = {"RESPONSE DATE","EFFECTIVE DATE","HARD CLOSE","EARNEST DUE"};
		earnestHeader = loiEarnestDueDisplay;
		if(loiEarnestDueDate != "Not provided") { earnestHeader = loiEarnestDueDate; }
		metaValues = {loiResponseDate,loiEffectiveDate,loiHardCloseDate,earnestHeader};
		for each index metaIndex in metaLabels
		{
			metaX = 828 + metaIndex * 92;
			if(metaIndex > 0)
			{
				page = page + thisapp.PF_PDF_Rect(metaX - 8,628,1,42,softLine,"",0);
			}
			page = page + thisapp.PF_PDF_Text(metaX,656,5.5,"bold",lightMuted,metaLabels.get(metaIndex));
			metaValueLines = thisapp.PF_PDF_Wrap(metaValues.get(metaIndex),14);
			metaY = 642;
			for each metaLine in metaValueLines
			{
				page = page + thisapp.PF_PDF_Text(metaX,metaY,6.5,"bold",ink,metaLine);
				metaY = metaY - 8;
			}
		}

		// Sellers and contacts.
		page = page + thisapp.PF_PDF_Rect(28,326,370,270,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(28,570,370,26,softBlue,"",0);
		page = page + thisapp.PF_PDF_Text(40,579,8,"bold",navy,"SELLERS AND CONTACTS");
		partyLabels = {"Seller(s)","Authorized Signer","Seller Email(s)","Seller Phone(s)","Seller Address(es)","Buyer/Seller Brokers"};
		partyValues = {loiSeller,loiAuthorizedSigner,loiSellerEmail,loiSellerPhone,loiSellerCityStateZip,loiBuyerBroker + " / " + loiSellerBroker};
		partyY = 548;
		for each index partyIndex in partyLabels
		{
			if(partyIndex > 0)
			{
				page = page + thisapp.PF_PDF_Rect(40,partyY + 10,346,1,softLine,"",0);
			}
			partyValue = partyValues.get(partyIndex);
			if(partyValue == null || partyValue.toString().trim() == "")
			{
				partyValue = "Not provided";
			}
			page = page + thisapp.PF_PDF_Text(40,partyY,5.8,"bold",lightMuted,partyLabels.get(partyIndex));
			partyLines = thisapp.PF_PDF_Wrap(partyValue.toString(),52);
			if(partyLines.size() <= 2)
			{
				valueY = partyY - 13;
				for each valueLine in partyLines
				{
					page = page + thisapp.PF_PDF_Text(40,valueY,7.6,"bold",ink,valueLine);
					valueY = valueY - 10;
				}
				partyY = partyY - 40;
			}
			else
			{
				overflowBlock = Map();
				overflowBlock.put("title",partyLabels.get(partyIndex));
				overflowBlock.put("body",partyValue.toString());
				offerOverflowBlocks.add(overflowBlock);
				page = page + thisapp.PF_PDF_Text(40,partyY - 13,6.5,"regular",muted,"See Offer details");
				partyY = partyY - 40;
			}
		}

		// Property, buyer, parcel identifiers, and seller assignments.
		page = page + thisapp.PF_PDF_Rect(414,316,386,280,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(414,570,386,26,softGreen,"",0);
		page = page + thisapp.PF_PDF_Text(426,579,8,"bold",navy,"PROPERTY AND BUYER");
		countyCityText = loiPropertyCounty + " / " + if(propertyCitiesText == "",loiPropertyCity,propertyCitiesText);
		propertySummaryLabels = {"Purchasing Company","Acquisition Email","Property/Location","County/City","CAD/Property ID","Facility ID","Parcel Acres","Seller Assignment"};
		propertySummaryValues = {companyName,loiAcquisitionEmail,loiStreetAddress,countyCityText,loiCadId,if(propertyFacilityIdsText == "","Not provided",propertyFacilityIdsText),loiAcresDisplay,if(propertySellerAssignmentsText == "","Not provided",propertySellerAssignmentsText)};
		propertyY = 548;
		for each index propertyPanelIndex in propertySummaryLabels
		{
			if(propertyPanelIndex > 0)
			{
				page = page + thisapp.PF_PDF_Rect(426,propertyY + 7,362,1,softLine,"",0);
			}
			propertyValue = propertySummaryValues.get(propertyPanelIndex);
			if(propertyValue == null || propertyValue.toString().trim() == "")
			{
				propertyValue = "Not provided";
			}
			page = page + thisapp.PF_PDF_Text(426,propertyY,5.4,"bold",lightMuted,propertySummaryLabels.get(propertyPanelIndex));
			propertyValueLines = thisapp.PF_PDF_Wrap(propertyValue.toString(),56);
			if(propertyValueLines.size() <= 2)
			{
				valueY = propertyY - 13;
				for each valueLine in propertyValueLines
				{
					page = page + thisapp.PF_PDF_Text(426,valueY,7.1,"bold",ink,valueLine);
					valueY = valueY - 10;
				}
				propertyY = propertyY - 30;
			}
			else
			{
				overflowBlock = Map();
				overflowBlock.put("title",propertySummaryLabels.get(propertyPanelIndex));
				overflowBlock.put("body",propertyValue.toString());
				offerOverflowBlocks.add(overflowBlock);
				page = page + thisapp.PF_PDF_Text(426,propertyY - 13,6.5,"regular",muted,"See Offer details");
				propertyY = propertyY - 30;
			}
		}

		// Timing, deposits, and extension terms.
		page = page + thisapp.PF_PDF_Rect(816,326,380,270,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(816,570,380,26,softPurple,"",0);
		page = page + thisapp.PF_PDF_Text(828,579,8,"bold",navy,"TIMING, DEPOSITS AND EXTENSIONS");
		termLabels = {"Initial Feasibility","Close After Feasibility","Projected Hard Close","Earnest Money Due","Earnest Money","Extensions","Days Per Extension","Amount Per Extension","Response Date","Assumed Effective Date"};
		termValues = {loiFeasibilityDisplay,loiClosingDisplay,loiHardCloseDate,loiEarnestDueDisplay,loiEarnestMoneyDisplay,loiExtensionsDisplay,loiDaysPerExtensionDisplay,loiAmountPerExtensionDisplay,loiResponseDate,loiEffectiveDate};
		termY = 548;
		for each index termIndex in termLabels
		{
			if(termIndex > 0)
			{
				page = page + thisapp.PF_PDF_Rect(828,termY + 7,356,1,softLine,"",0);
			}
			page = page + thisapp.PF_PDF_Text(828,termY,6,"bold",lightMuted,termLabels.get(termIndex));
			termLines = thisapp.PF_PDF_Wrap(termValues.get(termIndex),29);
			if(termLines.size() <= 2)
			{
				valueY = termY - 0;
				for each valueLine in termLines
				{
					page = page + thisapp.PF_PDF_Text(990,valueY,7.2,"bold",ink,valueLine);
					valueY = valueY - 10;
				}
				termY = termY - 24;
			}
			else
			{
				overflowBlock = Map();
				overflowBlock.put("title",termLabels.get(termIndex));
				overflowBlock.put("body",termValues.get(termIndex));
				offerOverflowBlocks.add(overflowBlock);
				page = page + thisapp.PF_PDF_Text(990,termY - 0,6.5,"regular",muted,"See Offer details");
				termY = termY - 24;
			}
		}

		// Narrative terms stay on this same page for attorney review.
		page = page + thisapp.PF_PDF_Rect(28,52,772,246,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(28,272,772,26,softOrange,"",0);
		page = page + thisapp.PF_PDF_Text(40,281,7.5,"bold",navy,"SPECIAL PROVISIONS");
		specialLines = thisapp.PF_PDF_Wrap(loiSpecialProvisions,116);
		lineY = 252;
		specialShown = 0;
		if(specialLines.size() > 17)
		{
			overflowBlock = Map();
			overflowBlock.put("title","Special provisions");
			overflowBlock.put("body",loiSpecialProvisions);
			offerOverflowBlocks.add(overflowBlock);
			page = page + thisapp.PF_PDF_Text(40,252,8,"regular",ink,"See Offer details for complete text.");
		}

		for each  specialLine in specialLines
		{
			if(specialLines.size() <= 17)
			{
				page = page + thisapp.PF_PDF_Text(40,lineY,7.5,"regular",ink,specialLine);
				lineY = lineY - 11;
			}
			specialShown = specialShown + 1;
		}
		page = page + thisapp.PF_PDF_Rect(816,52,380,246,white,line,0.35);
		page = page + thisapp.PF_PDF_Rect(816,272,380,26,softPurple,"",0);
		page = page + thisapp.PF_PDF_Text(828,281,7.5,"bold",navy,"LEGAL NOTE");
		legalLines = thisapp.PF_PDF_Wrap(loiLegalNote,54);
		lineY = 252;
		legalShown = 0;
		if(legalLines.size() > 17)
		{
			overflowBlock = Map();
			overflowBlock.put("title","Legal note");
			overflowBlock.put("body",loiLegalNote);
			offerOverflowBlocks.add(overflowBlock);
			page = page + thisapp.PF_PDF_Text(828,252,8,"regular",ink,"See Offer details for complete text.");
		}

		for each  legalLine in legalLines
		{
			if(legalLines.size() <= 17)
			{
				page = page + thisapp.PF_PDF_Text(828,lineY,7.5,"regular",ink,legalLine);
				lineY = lineY - 11;
			}
			legalShown = legalShown + 1;
		}
		pageStreams.add(page);
		pageStreams.addAll(thisapp.PF_PDF_Flow_Pages(offerOverflowBlocks,"Offer details",pfName,2));
		pageStreams.addAll(thisapp.PF_PDF_Flow_Pages(ownerOverflowBlocks,"Acquisition owners",pfName,1));
		if(commentBlocks.size() > 0)
		{
			pageStreams.addAll(thisapp.PF_PDF_Flow_Pages(commentBlocks,"Comments",pfName,1));
		}
		/*
		* Expected minimum:
		* 1. Executive dashboard with the first Additional Cost rows
		* 2. One-page Offer summary
		* Overflow Additional Costs are inserted after page 1 only when needed.
		*/
		if(pageStreams.size() < 2)
		{
			result.put("success",false);
			result.put("message","Approval packet was incomplete before compilation. Expected the dashboard and complete Offer summary.");
			return result;
		}
		pdfText = thisapp.PF_PDF_Compile(pageStreams,"Pro Forma Approval Packet - " + pfName);
		if(pdfText == "")
		{
			result.put("success",false);
			result.put("message","The Deluge PDF compiler returned no content.");
			return result;
		}
		result.put("success",true);
		result.put("pdfText",pdfText);
		packetPfName = pfName.replaceAll("['’]","").replaceAll("[^A-Za-z0-9]+","_").replaceAll("_+","_").replaceAll("^_+","").replaceAll("_+$","");
		if(packetPfName == "")
		{
			packetPfName = "Pro_Forma";
		}
		result.put("fileName",packetPfName + "_Proforma_Packet_" + zoho.currentdate.toString("yyyy-MM-dd") + ".pdf");
		result.put("containsAdditionalCosts",additionalItemIds.size() > 0);
		result.put("containsLOITerms",true);
		result.put("commentCount",commentRows.count());
		result.put("pageCount",pageStreams.size());
		result.put("additionalCostCount",additionalItemIds.size());
		result.put("sellerCount",sellers.count());
		result.put("propertyCount",properties.count());
		return result;
	}	catch (e)
	{
		result.put("success",false);
		result.put("message",e.toString());
		return result;
	}
	return result;
}
