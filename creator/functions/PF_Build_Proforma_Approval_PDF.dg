		}
		pageStreams.addAll(thisapp.PF_PDF_Flow_Pages(reimbursementBlocks,"PID / MUD Reimbursements",pfName,2));
		// Comment history has its own pages, only when this Pro Forma has comment records.
		commentRows = Comment_Log[Pro_Forma == proformaIdLong] sort by Added_Time;
		commentBlocks = List();
		for each commentRow in commentRows
		{
			block = Map();
			commentAuthor = ifnull(commentRow.Author_Name,"").toString().trim();
			if(commentAuthor == "") { commentAuthor = ifnull(commentRow.User,ifnull(commentRow.Added_User,"Unknown author")).toString(); }
			commentDate = "";
			if(commentRow.Added_Time != null) { commentDate = commentRow.Added_Time.toString("MMM d, yyyy h:mm a"); }
			if(commentRow.Edited == true && commentRow.Deleted != true) { commentDate = commentDate + " (edited)"; }
			block.put("title",commentAuthor);
			block.put("meta",commentDate);
			commentText = ifnull(commentRow.Comment,"").toString();
			if(commentRow.Deleted == true) { commentText = "Deleted by user"; }
			block.put("body",commentText);
			commentBlocks.add(block);
