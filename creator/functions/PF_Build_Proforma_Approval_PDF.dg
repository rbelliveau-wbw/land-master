		costValues = {thisapp.PF_Packet_Money(ifnull(pf.Land_Cost_Acre,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Engineering_Cost_Lot,0).toString()),thisapp.PF_Packet_Money(ifnull(pf.Const_Cost_FF,0).toString()),thisapp.PF_Packet_Money(baseConstCostPerLot.toString()),thisapp.PF_Packet_Money(constructionAdditionalCostPerLot.toString()),thisapp.PF_Packet_Money(developmentCostPerLot.toString()),thisapp.PF_Packet_Money(totalCostPerLot.toString())};
