						itemText = itemText.left(23) + "...";
					}
					phaseText = ifnull(costItem.Cost_Application,"-").toString();
					if(phaseText.length() > 12)
					{
						phaseText = phaseText.left(9) + "...";
					}
					previewInk = ink;
					previewMuted = muted;
