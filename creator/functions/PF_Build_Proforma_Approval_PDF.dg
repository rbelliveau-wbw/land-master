		{
			block = Map();
			block.put("title","No land sale installments");
			costBlocks.add(block);
		}
		else
		{
			for each saleItem in saleRows
			{
				saleDate = "Date not provided";
				if(saleItem.Date1 != null)
				{
					saleDate = saleItem.Date1.toString("MMM yyyy");
				}
				block = Map();
				block.put("title","Month " + ifnull(saleItem.Month1,"-").toString() + " | " + thisapp.PF_Packet_Number(ifnull(saleItem.Percent1,"").toString(),2) + "%");
				block.put("meta",saleDate);
				block.put("amount",thisapp.PF_Packet_Money(ifnull(saleItem.Cost,0).toString()));
				costBlocks.add(block);
			}
		}
		pageStreams.addAll(thisapp.PF_PDF_Flow_Pages(costBlocks,"Additional Costs, Reimbursements and Notes",pfName,3));
		// PID/MUD installments retain their own schedule page and subtotal.
		reimbursementBlocks = List();
		if(pidMudRows.count() > 0)
		{
			for each installment in pidMudRows
			{
				block = Map();
				installmentDate = "Date not provided";
				if(installment.Date1 != null) { installmentDate = installment.Date1.toString("MMM d, yyyy"); }
				block.put("title","Month " + ifnull(installment.Month1,"-").toString() + " | " + installmentDate);
				block.put("meta",ifnull(installment.Type1,"").toString());
				block.put("amount",thisapp.PF_Packet_Money(ifnull(installment.Cost,0).toString()));
				block.put("credit",true);
