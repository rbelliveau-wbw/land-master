map crewLocationsImportTasks(list sourceRows,string sourceSystem)
{
	result = {"ok":false,"imported":0,"mirrored":0,"unresolved":List()}; owned = false; datesStarted = false; phaseId = ""; token = "";
	try
	{
		config = thisapp.crewLocationsConfig();
		taskSourceEnabled = false;
		if(config.get("tasksEnabled") == true) { taskSourceEnabled = true; }
		if(config.get("taskMirrorEnabled") == true) { taskSourceEnabled = true; }
		if(!taskSourceEnabled || config.get("importActor") == "" || zoho.loginuser != config.get("importActor") || config.get("taskSourceSystem") != sourceSystem) { result.put("message","A verified task adapter and controlled import actor must be configured."); return result; }
		stageOrder = {"Entitlements","Engineering Design","Municipal Review","Pre-Construction","Rough Cut","Sewer","Water","Storm Drain","Road Prep","Dry Utilities","Punch List","Closeout"};
		unresolved = List(); imported = 0; mirrored = 0; result.put("unresolved",unresolved);
		for each row in sourceRows
		{
			sourceId = ifnull(row.get("sourceRecordId"),"").toString(); externalProject = ifnull(row.get("externalProjectId"),"").toString(); stage = ifnull(row.get("stageKey"),"").toString();
			sourceTaskId = ifnull(row.get("sourceTaskId"),"").toString();
			startText = ifnull(row.get("startDate"),"").toString(); endText = ifnull(row.get("dueDate"),ifnull(row.get("endDate"),"")).toString(); completionText = ifnull(row.get("completionDate"),"").toString(); startDate = null; endDate = null; completionDate = null;
			if(startText != "") { startDate = startText.toDate("yyyy-MM-dd"); if(startDate.toString("yyyy-MM-dd") != startText) { throw "Invalid source task start date."; } }
			if(endText != "") { endDate = endText.toDate("yyyy-MM-dd"); if(endDate.toString("yyyy-MM-dd") != endText) { throw "Invalid source task due date."; } }
			if(completionText != "") { completionDate = completionText.toDate("yyyy-MM-dd"); if(completionDate.toString("yyyy-MM-dd") != completionText) { throw "Invalid source task completion date."; } }
			phase = Subdivision[Project_ID == externalProject];
			if(sourceId == "" || externalProject == "" || sourceTaskId == "" || row.get("sourceModifiedAt") == null) { unresolved.add({"sourceRecordId":sourceId,"reason":"Stable task identity, external project ID and source revision are required."}); }
			else if(phase.count() != 1 || !stageOrder.contains(stage))
			{
				// Preserve a real individual task without inventing a phase/stage join.
				// Unmapped rows are excluded from the schedule and have no date editor.
				if(config.get("taskMirrorEnabled") != true) { unresolved.add({"sourceRecordId":sourceId,"reason":"Unresolved external project or explicit stage key."}); }
				else
				{
					key = sourceSystem + ":" + sourceId; rawTask = Task_Schedule[Source_Key == key];
					lineageError = rawTask.count() > 1;
					if(rawTask.count() == 1)
					{
						if(rawTask.Subdivision1 != null || ifnull(rawTask.Stage_Key,"") != "" || rawTask.Source_System != sourceSystem || rawTask.Source_Record_ID != sourceId || rawTask.Source_Project_ID != externalProject || rawTask.Source_Task_ID != sourceTaskId) { lineageError = true; }
					}
					if(lineageError)
					{
						unresolved.add({"sourceRecordId":sourceId,"reason":"Source lineage or mapped stage changed; review is required."});
					}
					else
					{
						if(rawTask.count() == 0)
						{
							rawTaskId = insert into Task_Schedule
							[
								Source_System=sourceSystem
								Source_Record_ID=sourceId
								Source_Key=key
								Source_Task_ID=sourceTaskId
								Source_Milestone_ID=ifnull(row.get("sourceMilestoneId"),"")
								Source_Project_ID=externalProject
								Task_Name=ifnull(row.get("taskName"),"")
								Task_Code=ifnull(row.get("taskCode"),"")
								Task_Status=ifnull(row.get("taskStatus"),"")
								Start_Date=startDate
								End_Date=endDate
								Completion_Date=completionDate
								Milestone_Task=row.get("milestoneTask") == true
								Source_Modified_At=row.get("sourceModifiedAt")
								Synced_At=zoho.currenttime
								Write_Enabled=false
								Added_User=zoho.loginuser
							];
							rawTask = Task_Schedule[ID == rawTaskId];
						}
						freshSource = rawTask.Source_Modified_At == null;
						if(rawTask.Source_Modified_At != null) { if(row.get("sourceModifiedAt") >= rawTask.Source_Modified_At) { freshSource = true; } }
						if(freshSource)
						{
							rawTask.Task_Name=ifnull(row.get("taskName"),""); rawTask.Task_Code=ifnull(row.get("taskCode"),""); rawTask.Task_Status=ifnull(row.get("taskStatus"),""); rawTask.Completion_Date=completionDate; rawTask.Milestone_Task=row.get("milestoneTask") == true;
							rawTask.Start_Date=startDate; rawTask.End_Date=endDate; rawTask.Source_Modified_At=row.get("sourceModifiedAt"); rawTask.Synced_At=zoho.currenttime; rawTask.Write_Enabled=false;
							mirrored = mirrored + 1; result.put("mirrored",mirrored);
						}
						unresolved.add({"sourceRecordId":sourceId,"recordId":rawTask.ID.toString(),"reason":"Task mirrored; phase/stage mapping is unresolved."});
					}
				}
			}
			else
			{
				phaseId = phase.ID.toString(); key = sourceSystem + ":" + sourceId;
				existing = Task_Schedule[Source_Key == key];
				lineageError = existing.count() > 1;
				if(existing.count() == 1)
				{
					if(existing.Subdivision1 != phase.ID || existing.Stage_Key != stage || existing.Source_System != sourceSystem || existing.Source_Record_ID != sourceId) { lineageError = true; }
					if(ifnull(existing.Source_Project_ID,"") != "") { if(existing.Source_Project_ID != externalProject) { lineageError = true; } }
					if(ifnull(existing.Source_Task_ID,"") != "") { if(existing.Source_Task_ID != sourceTaskId) { lineageError = true; } }
				}
				if(lineageError) { unresolved.add({"sourceRecordId":sourceId,"reason":"Source lineage/stage changed; review is required."}); }
				else
				{
					token = "task-import-" + zoho.encryption.sha256(key + "|" + zoho.currenttime.toLong());
					lockId = insert into Crew_Schedule_Lock
					[
						Phase_Key=phaseId
						Subdivision1=phase.ID
						Operation_ID=token
						Actor=zoho.loginuser
						Acquired_At=zoho.currenttime
						Added_User=zoho.loginuser
					];
					owned = true;
					if(existing.count() == 0)
					{
						taskId = insert into Task_Schedule
						[
							Subdivision1=phase.ID
							Stage_Key=stage
							Source_System=sourceSystem
							Source_Record_ID=sourceId
							Source_Key=key
							Source_Task_ID=sourceTaskId
							Source_Milestone_ID=ifnull(row.get("sourceMilestoneId"),"")
							Source_Project_ID=externalProject
							Task_Name=ifnull(row.get("taskName"),"")
							Task_Code=ifnull(row.get("taskCode"),"")
							Task_Status=ifnull(row.get("taskStatus"),"")
							Completion_Date=completionDate
							Milestone_Task=row.get("milestoneTask") == true
							Source_Modified_At=row.get("sourceModifiedAt")
							Synced_At=zoho.currenttime
							Write_Enabled=config.get("taskWritesVerified") == true && config.get("tasksEnabled") == true
							Added_User=zoho.loginuser
						];
						existing = Task_Schedule[ID == taskId];
					}
					freshSource = existing.Source_Modified_At == null;
					if(existing.Source_Modified_At != null) { if(row.get("sourceModifiedAt") >= existing.Source_Modified_At) { freshSource = true; } }
					if(freshSource)
					{
						oldStart = null; oldEnd = null;
						if(existing.Start_Date != null) { oldStart = existing.Start_Date.toString("yyyy-MM-dd"); }
						if(existing.End_Date != null) { oldEnd = existing.End_Date.toString("yyyy-MM-dd"); }
						afterStart = null; afterEnd = null;
						if(startDate != null) { afterStart = startDate.toString("yyyy-MM-dd"); }
						if(endDate != null) { afterEnd = endDate.toString("yyyy-MM-dd"); }
						changes = List(); fields = Map();
						if(oldStart != afterStart) { fields.put("start",{"before":oldStart,"after":afterStart}); }
						if(oldEnd != afterEnd) { fields.put("end",{"before":oldEnd,"after":afterEnd}); }
						if(fields.keys().size() > 0)
						{
							changes.add({"recordId":existing.ID.toString(),"type":"T","stage":stage,"expected":{"start":oldStart,"end":oldEnd},"fields":fields});
							request = {"subdivisionId":phaseId,"origin":"import","changes":changes,"sourceSystem":sourceSystem,"sourceRecordId":sourceId};
							logId = insert into Schedule_Change_Log
							[
								Operation_ID=token
								Operation_Type="controlled_task_import"
								Actor=zoho.loginuser
								Timestamp=zoho.currenttime
								Subdivision1=phase.ID
								Origin="import"
								Request_JSON=request.toString()
								State="importing"
								Execution_Finished=false
								Added_User=zoho.loginuser
							];
						}
						datesStarted = true;
						existing.Start_Date=startDate; existing.End_Date=endDate; existing.Source_Modified_At=row.get("sourceModifiedAt"); existing.Synced_At=zoho.currenttime;
						existing.Source_Task_ID=sourceTaskId; existing.Source_Project_ID=externalProject; existing.Task_Name=ifnull(row.get("taskName"),""); existing.Task_Code=ifnull(row.get("taskCode"),""); existing.Task_Status=ifnull(row.get("taskStatus"),""); existing.Completion_Date=completionDate; existing.Milestone_Task=row.get("milestoneTask") == true; existing.Write_Enabled=config.get("taskWritesVerified") == true && config.get("tasksEnabled") == true;
						if(fields.keys().size() > 0)
						{
							log = Schedule_Change_Log[Operation_ID == token]; log.State="imported"; log.Execution_Finished=true;
							log.Result_JSON={"ok":true,"state":"imported","confirmed":{{"type":"T","recordId":existing.ID.toString()}},"records":{{"type":"T","id":existing.ID.toString(),"start":afterStart,"end":afterEnd}}}.toString();
						}
						datesStarted = false; imported = imported + 1; result.put("imported",imported);
					}
					delete from Crew_Schedule_Lock[(Phase_Key == phaseId) && (Operation_ID == token)]; owned = false;
				}
			}
		}
		result.put("ok",true); result.put("imported",imported); result.put("unresolved",unresolved);
	}
	catch(importError)
	{
		if(owned && !datesStarted) { delete from Crew_Schedule_Lock[(Phase_Key == phaseId) && (Operation_ID == token)]; }
		log = Schedule_Change_Log[Operation_ID == token];
		if(log.count() == 1) { log.State="unknown"; log.Error=importError.toString(); log.Execution_Finished=true; }
		result.put("unknown",datesStarted);
		result.put("message",importError.toString());
	}
	return result;
}
