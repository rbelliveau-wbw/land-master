string managePurchaseOrder(string payload)
{
	result = {"success":false,"contract":"po-v1","writeState":"not-started"};
	operationId = 0;
	lockId = 0;
	writeStarted = false; wasReserved = false; priorBundle = Map(); modificationPlan = List(); budgetExceeded = false;
	try
	{
		p = payload.toMap();
		action = ifnull(p.get("action"),"");
		for each identityField in {"budgetId","userAccessId"}
		{
			typedIdentity = {"value":p.get(identityField)};
			if(!typedIdentity.toString().matches("[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}]")) { result.put("error","Creator identities must be exact ID strings."); return result.toString(); }
		}
		if(p.get("id") != null && p.get("id") != "")
		{
			typedIdentity = {"value":p.get("id")};
			if(!typedIdentity.toString().matches("[{][ ]*\"value\"[ ]*:[ ]*\"[0-9]+\"[ ]*[}]")) { result.put("error","PO identity must be a string."); return result.toString(); }
		}
		access = User_Access[User == zoho.loginuser];
		if(access.count() != 1 || access.ID.toString() != ifnull(p.get("userAccessId"),"").toString()) { result.put("error","An unambiguous authenticated User Access identity is required."); return result.toString(); }
		budgetId = ifnull(p.get("budgetId"),"").toString();
		if(!budgetId.matches("[0-9]+")) { result.put("error","Phase budget is required."); return result.toString(); }
		budget = Add_Budget[ID == budgetId.toLong()];
		if(budget.ID == null) { result.put("error","Phase budget was not found."); return result.toString(); }
		canEdit = access.Edit_All_Budgets == true;
		for each owner in budget.Budget_Owner
		{
			if(owner.ID == access.ID && access.Edit_Owned_Budgets == true) { canEdit = true; }
		}
		if(action == "Approve" || action == "Reject" || action == "CheckDecision" || action == "RetryEmail")
		{
			return thisapp.handlePurchaseOrderApproval(p).toString();
		}
		if(action == "ApprovalPO")
		{
			rowId = p.get("approvalId").toString(); matchId = "";
			for each captured in Approval_Route_Snapshot[Workflow == "Purchase Order"]
			{
				if(ifnull(captured.Execution_JSON,"") != "" && captured.Execution_JSON.toJSONList().contains(rowId) && captured.Context_JSON.toMap().get("budgetId") == budgetId) { matchId = captured.Record_ID; }
			}
			if(matchId == "") { result.put("error","This PO approval could not be resolved."); return result.toString(); }
			result = thisapp.poSnapshot(matchId); result.put("contract","po-v1"); return result.toString();
		}
		if(action == "Vendors")
		{
			rows = List();
			for each vendorChoice in Vendors[ID != null] sort by Vendor_Name
			{
				rows.add({"ID":vendorChoice.ID.toString(),"Vendor_Name":vendorChoice.Vendor_Name});
			}
			result.put("vendors",rows); result.put("success",true); return result.toString();
		}
		if(action == "Get")
		{
			po = Payment_Request[ID == p.get("id").toString().toLong() && Budget == budget.ID];
			if(po.ID == null) { result.put("error","PO not found in this phase."); return result.toString(); }
			result = thisapp.poSnapshot(po.ID.toString()); result.put("contract","po-v1"); return result.toString();
		}
		if(action == "List")
		{
			rows = List();
			for each po in Payment_Request[Budget == budget.ID && Request_Type == "Purchase Order" && PO_Revision != null && PO_Revision != ""]
			{
				rows.add({"id":po.ID.toString(),"amount":po.PO_Amount_Exact,"status":po.PO_Status,"revision":po.PO_Revision,"vendorId":po.Vendor.toString()});
			}
			result.put("rows",rows); result.put("success",true); return result.toString();
		}
		if(action == "Check")
		{
			op = PO_Operation[Token == p.get("token") && Budget == budget.ID && Actor == access.ID];
			if(op.ID == null) { result.put("writeState","unknown"); result.put("error","No operation receipt is visible. Do not replay this write."); return result.toString(); }
			result.put("token",op.Token);
			if(op.Status == "Rejected") { result.put("writeState","not-started"); result.put("error",op.Error_Text); return result.toString(); }
			if(op.Purchase_Order == null) { result.put("writeState","unknown"); result.put("error","Operation has not verified a parent. Review the phase lock."); return result.toString(); }
			actual = thisapp.poSnapshot(op.Purchase_Order.toString());
			sameSnapshot = false;
			if(actual.get("success") == true && op.Status == "Complete")
			{
				currentSnapshot = actual.get("snapshot"); recordedSnapshot = op.Snapshot_JSON.toMap(); sameSnapshot = true;
				if(recordedSnapshot.get("format") == "sha256-v1")
				{
					sameSnapshot = recordedSnapshot.get("digest") == zoho.encryption.sha256(currentSnapshot.toString());
				}
				else
				{
				for each headerField in {"id","budgetId","vendorId","budgetModificationId","amount","requestDate","dateNeeded","revision","status","commitmentState","approvalState"}
				{
					if(currentSnapshot.get(headerField) != recordedSnapshot.get(headerField)) { sameSnapshot = false; }
				}
				if(currentSnapshot.get("lines").toString() != recordedSnapshot.get("lines").toString()) { sameSnapshot = false; }
				if(currentSnapshot.get("approvalBundle") != null)
				{
					if(currentSnapshot.get("approvalBundle").get("rows").toString() != recordedSnapshot.get("approvalBundle").get("rows").toString() || currentSnapshot.get("approvalBundle").get("modifications").toString() != recordedSnapshot.get("approvalBundle").get("modifications").toString()) { sameSnapshot = false; }
				}
				}
			}
			if(actual.get("success") == true && actual.get("snapshot").get("revision") == op.Token && sameSnapshot == true)
			{
				result.put("success",true); result.put("writeState","verified"); result.put("snapshot",actual.get("snapshot"));
			}
			else { result.put("writeState","unknown"); result.put("error","Operation is incomplete or has a newer revision. Read-only review is required."); }
			return result.toString();
		}
		if(action == "Balances")
		{
			if(PO_Phase_Lock[Phase_Key == budgetId].count() > 0) { result.put("error","This phase has a write in progress or an unresolved operation."); return result.toString(); }
			result = thisapp.poBudgetBalances(budgetId); result.put("contract","po-v1"); return result.toString();
		}
		if(action != "Save" && action != "Submit") { result.put("error","Unsupported PO action."); return result.toString(); }
		// Owner approved Creator's Max Digits 16 / Places 2 on 2026-10-08.
		// Currency boundary persisted exactly in the native Development test.
		if(canEdit != true || budget.Archived == true) { result.put("error","Budget edit permission on an active phase is required."); return result.toString(); }
		validated = thisapp.poValidatePayload(payload);
		if(validated.get("success") != true) { validated.put("contract","po-v1"); return validated.toString(); }
		p = validated.get("payload");
		token = p.get("token"); result.put("token",token);
		if(PO_Operation[Token == token].count() > 0) { result.put("writeState","unknown"); result.put("error","This operation token already exists. Use Check; do not send it again."); return result.toString(); }
		vendor = Vendors[ID == p.get("vendorId").toLong()];
		if(vendor.ID == null) { result.put("error","Vendor was not found."); return result.toString(); }
		linkedModificationId = null;
		if(p.get("budgetModificationId") != null)
		{
			linkedModification = Budget_Modification[ID == p.get("budgetModificationId").toLong()];
			if(linkedModification.ID == null || linkedModification.Budget != budget.ID) { result.put("error","Linked budget modification must belong to this PO phase."); return result.toString(); }
			linkedModificationId = linkedModification.ID;
		}
		idText = ifnull(p.get("id"),"").toString();
		expected = ifnull(p.get("expectedRevision"),"").toString();
		if(idText != "")
		{
			po = Payment_Request[ID == idText.toLong() && Budget == budget.ID];
			if(po.ID == null || po.Request_Type != "Purchase Order" || (po.PO_Status != "Draft" && !(po.PO_Status == "Submitted" && po.PO_Approval_State == "Rejected")) || ifnull(po.PO_Revision,"") == "" || po.PO_Revision != expected) { result.put("error","Only the current Draft or Rejected PO can be edited or submitted."); return result.toString(); }
		}
		if(idText != "" && po.PO_Commitment_State == "Reserved")
		{
			wasReserved = true; beforePO = thisapp.poSnapshot(idText);
			if(beforePO.get("success") != true) { result.put("error",beforePO.get("error")); return result.toString(); }
			priorBundle = beforePO.get("snapshot").get("approvalBundle");
			if(validated.get("totalCents") != p.get("amount").replaceAll("[.]","") ) { result.put("error","An edited reserved PO must keep its header and line total balanced."); return result.toString(); }
		}
		else if(expected != "" && idText == "") { result.put("error","New POs cannot have an expected revision."); return result.toString(); }
		// Unique fields arbitrate competing operations. No expiry or automatic lock takeover.
		lockId = insert into PO_Phase_Lock
		[
			Added_User=zoho.loginuser
			Phase_Key=budgetId
			Operation_Token=token
			Actor=access.ID
		];
		requestProof = {"action":action,"token":token,"budgetId":budgetId,"lineCount":p.get("lines").size(),"digest":zoho.encryption.sha256(p.toString())};
		operationId = insert into PO_Operation
		[
			Added_User=zoho.loginuser
			Token=token
			Budget=budget.ID
			Actor=access.ID
			Request_JSON=requestProof.toString()
			Status="Started"
		];
		// Recheck identity, permission and compare-and-set revision after acquiring the phase lock.
		access = User_Access[User == zoho.loginuser];
		budget = Add_Budget[ID == budgetId.toLong()];
		canEdit = access.count() == 1 && access.ID.toString() == p.get("userAccessId") && access.Edit_All_Budgets == true;
		for each owner in budget.Budget_Owner
		{
			if(access.count() == 1 && access.ID.toString() == p.get("userAccessId") && owner.ID == access.ID && access.Edit_Owned_Budgets == true) { canEdit = true; }
		}
		if(canEdit != true || budget.Archived == true) { result.put("error","Phase edit permission changed before this write."); }
		if(idText != "")
		{
			po = Payment_Request[ID == idText.toLong() && Budget == budget.ID];
			if((po.PO_Status != "Draft" && !(po.PO_Status == "Submitted" && po.PO_Approval_State == "Rejected")) || po.PO_Revision != expected) { result.put("error","The PO changed while this request was waiting."); }
		}
		for each line in p.get("lines")
		{
			item = Budget_Item[ID == line.get("budgetItemId").toLong() && Budget == budget.ID && Template_Item != true];
			category = Budget_Category[ID == item.Budget_Category && Budget == budget.ID];
			track = "";
			if(category.Deparment == "Construction") { track = "Construction"; }
			if(category.Deparment == "Development" || category.Deparment == "Engineering") { track = "Development"; }
			locked = false;
			if(track == "Construction") { locked = budget.Const_Budget_Approval_Status == "Pending" || budget.Const_Budget_Approval_Status == "Approved"; }
			if(track == "Development") { locked = budget.Development_Budget_Approval_Status == "Pending" || budget.Development_Budget_Approval_Status == "Approved"; }
			for each approval in Budget_Approvals[Budget == budget.ID && Type1 == track]
			{
				if(approval.Status == "Pending" || approval.Status == "Approved") { locked = true; }
			}
			subdivisionCode = ifnull(budget.Subdivision1.Subdivision_Code,""); minorCode = ifnull(item.Cost_Code,0).toString();
			generatedCode = "C_"+subdivisionCode+"-"+minorCode+"-"+line.get("costElement");
			if(subdivisionCode == "" || minorCode == "0" || line.get("costCode") != generatedCode) { result.put("error","Generated cost code changed or is unavailable. Refresh the item balance."); }
			if(item.ID == null || category.ID == null || track == "" || locked != true) { result.put("error","A selected Budget Item is no longer eligible in this phase."); }
		}
		if(action == "Submit" && result.get("error") == null)
		{
			balances = thisapp.poBudgetBalances(budgetId);
			if(balances.get("success") != true) { result.put("error",balances.get("error")); }
			else
			{
				available = Map(); pendingCredits = Map(); ownAllocation = Map(); ownCredits = Map();
				for each balance in balances.get("balances") { available.put(balance.get("budgetItemId"),balance.get("availableCents").toLong()); pendingCredits.put(balance.get("budgetItemId"),ifnull(balance.get("pendingModificationCents"),"0").toLong()); }
				if(wasReserved)
				{
					priorSnapshot = beforePO.get("snapshot"); priorLines = priorSnapshot.get("lines");
					for each oldLine in priorLines { itemKey = oldLine.get("budgetItemId"); ownAllocation.put(itemKey,ifnull(ownAllocation.get(itemKey),0)+oldLine.get("finalAmount").replaceAll("[.]","").toLong()); }
					for each oldMod in priorBundle.get("modifications") { ownCredits.put(oldMod.get("budgetItemId"),oldMod.get("amount").replaceAll("[.]","").toLong()); }
				}
				groupedCents = validated.get("groupedCents");
				for each itemKey in groupedCents.keys()
				{
					if(available.get(itemKey) == null) { result.put("error","A selected item has no verified balance."); }
					else
					{
						beforeAvailable = available.get(itemKey)+ifnull(ownAllocation.get(itemKey),0); otherPending = ifnull(pendingCredits.get(itemKey),0)-ifnull(ownCredits.get(itemKey),0);
						if(p.get("expectedBalances") == null || p.get("expectedBalances").get(itemKey) != beforeAvailable.toString() || p.get("expectedPendingModifications") == null || p.get("expectedPendingModifications").get(itemKey) != otherPending.toString()) { result.put("error","Item balances changed. Refresh and review before submitting."); }
						shortfall = groupedCents.get(itemKey)-beforeAvailable-otherPending;
						if(groupedCents.get(itemKey) > beforeAvailable) { budgetExceeded = true; }
						if(shortfall > 0)
						{
							if(shortfall > 999999999999999) { result.put("error","Automatic modification exceeds supported currency capacity."); }
							centsText = shortfall.toString(); if(centsText.length() == 1) { centsText = "00"+centsText; } if(centsText.length() == 2) { centsText = "0"+centsText; }
							amountText = centsText.subString(0,centsText.length()-2)+"."+centsText.subString(centsText.length()-2,centsText.length());
							modificationPlan.add({"budgetItemId":itemKey,"amount":amountText});
						}
					}
				}
			}
			companyText = ""; territory = "";
			if(budget.Subdivision1 != null) { territory = ifnull(budget.Subdivision1.Territory,""); if(budget.Subdivision1.Company1 != null) { companyText = budget.Subdivision1.Company1.ID.toString(); } }
			context = {"workflow":"Purchase Order","budgetId":budgetId,"companyId":companyText,"territory":territory,"department":"","submitterId":access.ID.toString(),"effectiveDate":zoho.currentdate.toString("yyyy-MM-dd"),"amount":p.get("amount"),"hasBudgetModification":modificationPlan.size() > 0,"hasBudgetOverrun":budgetExceeded};
			resolved = thisapp.resolveApprovalRoute(context);
			if(resolved.get("success") != true) { result.put("error",resolved.get("error")); }
			else
			{
				cfoFound = false; cooFound = false; vpFound = false;
				resolvedSnapshot = resolved.get("snapshot"); resolvedSteps = resolvedSnapshot.get("route"); approvalTitles = {"VP","Legal","CFO","COO","CEO"};
				for each step in resolvedSteps { if(!approvalTitles.contains(step.get("role"))) { result.put("error","PO template role must match an existing approval title: VP, Legal, CFO, COO or CEO."); } if(step.get("role") == "CFO") { cfoFound = true; } if(step.get("role") == "COO") { cooFound = true; } if(step.get("role") == "VP") { vpFound = true; } }
				if(cfoFound != true) { result.put("error","Every PO must include CFO approval."); }
				if(budgetExceeded && (cooFound != true || vpFound != true)) { result.put("error","POs exceeding any available item budget require both COO and Territory VP approval."); }
			}
		}
		operation = PO_Operation[ID == operationId];
		if(result.get("error") != null)
		{
			operation.Status="Rejected"; operation.Error_Text=result.get("error");
			delete from PO_Phase_Lock[ID == lockId]; return result.toString();
		}
		writeStarted = true;
		if(idText == "")
		{
			parentId = insert into Payment_Request
		[
			Added_User=zoho.loginuser
			Request_Type="Purchase Order"
			Budget=budget.ID
			Vendor=vendor.ID
			PO_Budget_Modification=linkedModificationId
			Request_Date=p.get("requestDate").toDate("yyyy-MM-dd")
			Date_Needed=p.get("dateNeeded").toDate("yyyy-MM-dd")
			Request_Amount=p.get("amount").toDecimal()
			PO_Amount_Exact=p.get("amount")
			PO_Client_Key=token
			PO_Status="Draft"
			PO_Commitment_State="None"
			PO_Approval_State="Not Configured"
			Budget_Item=null
			Accounting_Project_Code=null
			Element=null
			Final_Accounting_Code=null
		];
			idText = parentId.toString();
		}
		operation.Purchase_Order=idText.toLong();
		order = 0;
		for each line in p.get("lines")
		{
			order = order+1;
			q = null; price = null;
			if(line.get("pricingMode") == "Calculated") { q = line.get("quantity").toDecimal(); price = line.get("unitPrice").toDecimal(); }
			childId = insert into PO_Item
		[
			Added_User=zoho.loginuser
			Revision_Line_Key=token+"-"+line.get("key")
			Purchase_Order=idText.toLong()
			Budget_Item=line.get("budgetItemId").toLong()
			Line_Key=line.get("key")
			Revision=token
			Line_Order=order
			Description=line.get("description")
			Cost_Element=line.get("costElement")
			UOM=line.get("uom")
			Cost_Code=line.get("costCode")
			Pricing_Mode=line.get("pricingMode")
			Quantity=q
			Unit_Price=price
			Final_Amount=line.get("finalAmount").toDecimal()
			Quantity_Exact=line.get("quantity")
			Unit_Price_Exact=line.get("unitPrice")
			Final_Amount_Exact=line.get("finalAmount")
		];
		}
		po = Payment_Request[ID == idText.toLong()];
		po.Vendor=vendor.ID; po.Request_Date=p.get("requestDate").toDate("yyyy-MM-dd"); po.Date_Needed=p.get("dateNeeded").toDate("yyyy-MM-dd");
		po.PO_Budget_Modification=linkedModificationId;
		po.Request_Amount=p.get("amount").toDecimal(); po.PO_Amount_Exact=p.get("amount");
		po.Budget_Item=null; po.Accounting_Project_Code=null; po.Element=null; po.Final_Accounting_Code=null;
		po.PO_Line_Count=order; po.PO_Status="Draft"; po.PO_Commitment_State="None"; po.PO_Approval_State="Not Configured";
		if(wasReserved) { po.PO_Status="Submitted"; po.PO_Commitment_State="Reserved"; po.PO_Approval_State="Rejected"; }
		if(action == "Submit") { po.PO_Status="Submitted"; po.PO_Commitment_State="Reserved"; }
		// The pointer is last. Old revisions remain immutable evidence; writes are NOT transactional.
		po.PO_Revision=token;
		if(action == "Submit")
		{
			linkedModificationId = null; modifications = List();
			for each plan in modificationPlan
			{
				item = Budget_Item[ID == plan.get("budgetItemId").toLong()]; category = Budget_Category[ID == item.Budget_Category]; track = "Development"; if(category.Deparment == "Construction") { track = "Construction"; }
				modId = 0;
				if(wasReserved) { for each priorMod in priorBundle.get("modifications") { if(priorMod.get("budgetItemId") == plan.get("budgetItemId")) { modId = priorMod.get("id").toLong(); } } }
				reference = "PO:"+idText+":"+token;
				if(modId == 0) { modId = insert into Budget_Modification
				[
					Added_User=zoho.loginuser
					Budget=budget.ID
					Budget_Item=item.ID
					Budget_Category=item.Budget_Category
					Modification_Type="Increase"
					Amount=plan.get("amount").toDecimal()
					Reason="Purchase Order "+idText+" exceeds available item budget."
					Reference_Number=reference
					Effective_Date=zoho.currentdate
					Approval_Track=track
					Status="Submitted"
				]; }
				mod = Budget_Modification[ID == modId]; mod.Amount=plan.get("amount").toDecimal(); mod.Status="Submitted"; mod.Reference_Number=reference;
				if(mod.Budget != budget.ID || mod.Budget_Item != item.ID || thisapp.poCurrencyString(mod.Amount.toString()) != plan.get("amount") || mod.Reference_Number != reference) { operation.Status="Unknown"; result.put("writeState","unknown"); result.put("error","An automatic budget modification could not be verified. Do not resubmit."); return result.toString(); }
				if(linkedModificationId == null) { linkedModificationId = mod.ID; }
				modifications.add({"id":mod.ID.toString(),"budgetItemId":item.ID.toString(),"amount":plan.get("amount"),"reference":reference});
			}
			po.PO_Budget_Modification=linkedModificationId;
			context.put("recordId",idText); context.put("submissionRevision",token); context.put("modifications",modifications);
			captured = thisapp.snapshotApprovalRoute(context);
			if(captured.get("success") != true) { operation.Status="Unknown"; result.put("writeState","unknown"); result.put("error",captured.get("error")); return result.toString(); }
			route = captured.get("snapshot").get("route"); executionIds = List(); position = 0;
			for each step in route
			{
				position = position+1; executionId = 0;
				if(wasReserved)
				{
					for each previousRow in priorBundle.get("rows") { if(previousRow.get("userAccessId") == step.get("userAccessId") && previousRow.get("role") == step.get("role")) { executionId = previousRow.get("id").toLong(); } }
				}
				if(executionId == 0) { executionId = insert into Budget_Approvals
				[
					Added_User=zoho.loginuser
					Budget=budget.ID
					Type1="Purchase Order"
					Sort_Order=position
					Title=step.get("role")
					Approver=step.get("email")
					Status="Not Sent"
				]; }
				execution = Budget_Approvals[ID == executionId]; execution.Status="Not Sent"; execution.Sent_Date=null; execution.Responded_Date=null; execution.Approver=step.get("email"); execution.Title=step.get("role"); execution.Sort_Order=position;
				executionIds.add(executionId.toString());
			}
			storedRoute = Approval_Route_Snapshot[ID == captured.get("snapshotId").toLong()]; storedRoute.Execution_JSON=executionIds.toString();
			first = Budget_Approvals[ID == executionIds.get(0).toLong()]; first.Status="Pending"; po.PO_Approval_State="Pending";
			mail = thisapp.sendPurchaseOrderEmail(idText);
		}
		actual = thisapp.poSnapshot(idText);
		if(actual.get("success") != true) { result.put("error",actual.get("error")); }
		else
		{
			saved = actual.get("snapshot");
			wantedStatus = "Draft"; wantedCommitment = "None"; wantedApproval = "Not Configured";
			if(wasReserved) { wantedStatus = "Submitted"; wantedCommitment = "Reserved"; wantedApproval = "Rejected"; }
			if(action == "Submit") { wantedStatus = "Submitted"; wantedCommitment = "Reserved"; wantedApproval = "Pending"; }
			if(saved.get("status") != wantedStatus || saved.get("commitmentState") != wantedCommitment || saved.get("approvalState") != wantedApproval) { result.put("error","Submission, commitment or approval state differs from the intended write."); }
			if(saved.get("budgetId") != budgetId || saved.get("vendorId") != p.get("vendorId") || saved.get("amount") != p.get("amount") || saved.get("requestDate") != p.get("requestDate") || saved.get("dateNeeded") != p.get("dateNeeded") || saved.get("revision") != token || saved.get("lines").size() != p.get("lines").size()) { result.put("error","Header readback differs from the intended write."); }
			if(saved.get("budgetModificationId") != if(linkedModificationId == null,null,linkedModificationId.toString())) { result.put("error","Linked budget modification readback differs from the intended write."); }
			index = 0;
			for each line in p.get("lines")
			{
				written = saved.get("lines").get(index); index = index+1;
				for each field in {"key","budgetItemId","description","costElement","uom","costCode","pricingMode","quantity","unitPrice","finalAmount"}
				{
					if(written.get(field) != line.get(field)) { result.put("error","Line readback differs from the intended write: "+field); }
				}
			}
			if(result.get("error") == null)
			{
				proof = {"format":"sha256-v1","digest":zoho.encryption.sha256(saved.toString())};
				operation.Snapshot_JSON=proof.toString();
				if(operation.Snapshot_JSON != proof.toString()) { result.put("writeState","unknown"); result.put("error","PO verification receipt could not be persisted."); return result.toString(); }
				operation.Status="Complete";
				delete from PO_Phase_Lock[ID == lockId];
				result.put("success",true); result.put("writeState","verified"); result.put("snapshot",saved); return result.toString();
			}
		}
		operation.Status="Unknown"; operation.Error_Text=result.get("error"); result.put("writeState","unknown");
	}
	catch(e)
	{
		if(writeStarted == true || operationId != 0) { result.put("writeState","unknown"); result.put("error","The operation could not be verified. Keep the phase lock and use read-only Check."); }
		else { result.put("error","This phase is busy, or validation failed. No PO write was started."); }
		// A lock acquired before receipt creation can also be unresolved: never auto-take-over.
		if(lockId != 0) { result.put("writeState","unknown"); }
	}
	return result.toString();
}
