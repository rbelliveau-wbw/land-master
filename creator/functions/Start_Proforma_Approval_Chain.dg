				 map Start_Proforma_Approval_Chain(string proformaId)
                 {
	response = Map();
	try
	{
		proformaIdText = ifnull(proformaId,"").toString().trim();
		if(proformaIdText == "")
		{
			response.put("success",false);
			response.put("message","Pro Forma ID is required.");
			return response;
		}
		proformaIdLong = proformaIdText.toLong();
		pf = Add_Pro_Forma[ID == proformaIdLong];
					if(pf.ID == null)
					{
						response.put("success",false);
						response.put("message","Pro Forma not found.");
						return response;
					}
					if(pf.Purchasing_Company == null)
					{
						response.put("success",false);
						response.put("message","Select a Purchasing Company before sending this Pro Forma for approvals.");
						return response;
					}
					sellerRows = Builder[Proforma == proformaIdLong];
					if(sellerRows.count() == 0)
					{
						response.put("success",false);
						response.put("message","Add at least one fully completed Seller record before sending this Pro Forma for approvals.");
						return response;
					}
					incompleteSellers = List();
					for each  sellerRow in sellerRows
					{
						missingSellerFields = List();
						if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "")
						{
							missingSellerFields.add("Seller Name");
						}
						if(ifnull(sellerRow.Email,"").toString().trim() == "")
						{
							missingSellerFields.add("Email");
						}
						if(ifnull(sellerRow.Phone_Number,"").toString().trim() == "")
						{
							missingSellerFields.add("Phone");
						}
						if(ifnull(sellerRow.Street_Address,"").toString().trim() == "")
						{
							missingSellerFields.add("Street Address");
						}
						if(ifnull(sellerRow.City_State_ZIP,"").toString().trim() == "")
						{
							missingSellerFields.add("City, State ZIP");
						}
						if(missingSellerFields.size() > 0)
						{
							sellerLabel = if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "","Seller " + sellerRow.ID.toString(),sellerRow.Builder_Name.toString());
							incompleteSellers.add(sellerLabel + " needs " + missingSellerFields.toString(", "));
						}
					}
					if(incompleteSellers.size() > 0)
					{
						response.put("success",false);
						response.put("message","Complete the Seller record(s): " + incompleteSellers.toString("; "));
						return response;
					}
					propertyRows = Property[Proforma == proformaIdLong];
					if(propertyRows.count() == 0)
					{
						response.put("success",false);
						response.put("message","Add at least one fully completed Property record before sending this Pro Forma for approvals.");
						return response;
					}
					incompleteProperties = List();
					for each  propertyRow in propertyRows
					{
						missingPropertyFields = List();
						if(ifnull(propertyRow.Common_Name,"").toString().trim() == "")
						{
							missingPropertyFields.add("Common Name");
						}
						if(ifnull(propertyRow.Property_ID,"").toString().trim() == "")
						{
							missingPropertyFields.add("CAD / Property ID");
						}
						if(ifnull(propertyRow.Facility_ID,"").toString().trim() == "")
						{
							missingPropertyFields.add("Facility ID");
						}
						if(ifnull(propertyRow.County,"").toString().trim() == "")
						{
							missingPropertyFields.add("County");
						}
						if(ifnull(propertyRow.City,"").toString().trim() == "")
						{
							missingPropertyFields.add("City");
						}
						if(propertyRow.Acres == null || propertyRow.Acres <= 0)
						{
							missingPropertyFields.add("Acres");
						}
						if(propertyRow.Seller == null)
						{
							missingPropertyFields.add("Seller");
						}
						if(propertyRow.Company1 == null)
						{
							missingPropertyFields.add("Purchasing Company");
						}
						if(missingPropertyFields.size() > 0)
						{
							propertyLabel = if(ifnull(propertyRow.Common_Name,"").toString().trim() == "","Property " + propertyRow.ID.toString(),propertyRow.Common_Name.toString());
							incompleteProperties.add(propertyLabel + " needs " + missingPropertyFields.toString(", "));
						}
					}
					if(incompleteProperties.size() > 0)
					{
						response.put("success",false);
						response.put("message","Complete the Property record(s): " + incompleteProperties.toString("; "));
						return response;
					}
					rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
		if(rows.count() == 0)
		{
			response.put("success",false);
			response.put("message","Add at least one approval step before submitting this Pro Forma.");
			return response;
		}
		missingRecipients = List();
		missingTitles = List();
		expectedOrder = 1;
		for each  row in rows
		{
			rowTitle = ifnull(row.Title,"").toString().trim();
			rowEmail = ifnull(row.Approver,"").toString().trim();
			if(rowTitle == "")
			{
				missingTitles.add("Step " + expectedOrder.toString());
			}
			if(rowEmail == "")
			{
				missingRecipients.add(if(rowTitle == "","Step " + expectedOrder.toString(),rowTitle));
			}
			// Normalize the sequence before routing so there can be no gaps.
			row.Sort_Order=expectedOrder;
			expectedOrder = expectedOrder + 1;
		}
		if(missingTitles.size() > 0)
		{
			response.put("success",false);
			response.put("message","Missing approval step name for: " + missingTitles.toString(", "));
			return response;
		}
		if(missingRecipients.size() > 0)
		{
			response.put("success",false);
			response.put("message","Missing approver email for: " + missingRecipients.toString(", "));
			return response;
		}
		for each  row in rows
		{
			row.Status="Not Sent";
			row.Approval_Notes="";
			row.Sent_Date=null;
			row.Responded_Date=null;
		}
		firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
		if(firstRow.ID == null)
		{
			response.put("success",false);
			response.put("message","The first approval row could not be found.");
			return response;
		}
		firstRow.Status="Pending";
		firstRow.Sent_Date=zoho.currenttime;
		firstRow.Responded_Date=null;
		pf.Lock_Inputs=true;
		emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Started","","System");
		if(ifnull(emailResult.get("success"),false) != true)
		{
			firstRow.Status="Not Sent";
			firstRow.Sent_Date=null;
			pf.Lock_Inputs=false;
			response.put("success",false);
						response.put("message",emailResult.get("message"));
						return response;
					}
					pf.Status="Pending Approval";
					response.put("success",true);
		response.put("message","Approval request sent to " + firstRow.Title + " with the approval PDF packet.");
		response.put("pendingApprovalId",firstRow.ID.toString());
		response.put("packetFileName",emailResult.get("packetFileName"));
	}	catch (e)
	{
		response.put("success",false);
		response.put("message",e.toString());
	}
	return response;
                 }
