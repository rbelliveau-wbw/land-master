				 map Start_Proforma_Approval_Chain(string proformaId)
                 {
	response = Map();
	try
	{
		proformaIdText = ifnull(proformaId,"").toString().trim();
		progressMode = "Start";
		if(proformaIdText.startsWith("{"))
		{
			progressInput = proformaIdText.toMap();
			proformaIdText = ifnull(progressInput.get("id"),"").toString().trim();
			progressMode = ifnull(progressInput.get("mode"),"Start").toString().trim();
		}
		if(proformaIdText == "")
		{
			response.put("success",false);
			response.put("message","Pro Forma ID is required.");
			return response;
		}
		proformaIdLong = proformaIdText.toLong();
		pf = Add_Pro_Forma[ID == proformaIdLong];
					if(pf.ID == null)
					{
						response.put("success",false);
						response.put("message","Pro Forma not found.");
						return response;
					}
		accessRow = User_Access[User == zoho.loginuser];
		if(accessRow.ID == null)
		{
			response.put("success",false);
			response.put("message","A User Access record is required to send a Pro Forma for approvals.");
			return response;
		}
		if(accessRow.Send_Pro_Formas_for_Approvals != true)
		{
			response.put("success",false);
			response.put("message","You do not have Send Pro Formas for Approvals permission.");
			return response;
		}
		canSendThisProforma = accessRow.Edit_All_Proformas == true;
		if(canSendThisProforma == false && pf.Owner != null)
		{
			for each  ownerRow in pf.Owner
			{
				if(ownerRow.ID.toString() == accessRow.ID.toString())
				{
					canSendThisProforma = true;
					break;
				}
			}
		}
		if(canSendThisProforma == false)
		{
			response.put("success",false);
			response.put("message","You must be an owner of this Pro Forma to send it for approvals, unless you have Edit All Proformas.");
			return response;
		}
		// Targeted reconciliation uses the existing Custom API argument. Check never
		// mutates; Repair makes one bounded attempt to restore the first route/email.
		if(progressMode == "Check" || progressMode == "Repair")
		{
			progressRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
			progressFirst = null;
			progressCount = 0;
			progressPending = 0;
			progressApproved = 0;
			for each  progressRow in progressRows
			{
				progressCount = progressCount + 1;
				if(progressFirst == null)
				{
					progressFirst = progressRow;
				}
				if(ifnull(progressRow.Status,"").trim() == "Pending")
				{
					progressPending = progressPending + 1;
				}
				if(ifnull(progressRow.Status,"").trim() == "Approved")
				{
					progressApproved = progressApproved + 1;
				}
			}
			repairError = "";
			if(progressMode == "Repair" && (ifnull(pf.Status,"").trim() == "Draft" || ifnull(pf.Status,"").trim() == "Pending Approval") && progressFirst != null && progressApproved == 0 && (progressPending == 0 || (progressPending == 1 && ifnull(progressFirst.Status,"").trim() == "Pending")) && (ifnull(progressFirst.Status,"").trim() == "Not Sent" || ifnull(progressFirst.Status,"").trim() == "Pending"))
			{
				progressFirst.Status="Pending";
				pf.Lock_Inputs=true;
				pf.Status="Pending Approval";
				if(progressFirst.Sent_Date == null)
				{
					try
					{
						repairEmail = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,progressFirst.ID.toString(),"Started","","System");
						if(ifnull(repairEmail.get("success"),false) != true)
						{
							repairError = ifnull(repairEmail.get("message"),"Approval email could not be sent.").toString();
						}
					}
					catch (repairException)
					{
						repairError = repairException.toString();
					}
				}
			}
			progressRows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
			progressFirst = null;
			progressCount = 0;
			progressPending = 0;
			progressApproved = 0;
			for each  progressRow in progressRows
			{
				progressCount = progressCount + 1;
				if(progressFirst == null)
				{
					progressFirst = progressRow;
				}
				if(ifnull(progressRow.Status,"").trim() == "Pending")
				{
					progressPending = progressPending + 1;
				}
				if(ifnull(progressRow.Status,"").trim() == "Approved")
				{
					progressApproved = progressApproved + 1;
				}
			}
			firstIdText = "";
			firstStatusText = "";
			firstRoleText = "";
			firstAddressText = "";
			firstSentText = "";
			if(progressFirst != null)
			{
				firstIdText = progressFirst.ID.toString();
				firstStatusText = ifnull(progressFirst.Status,"").trim();
				firstRoleText = ifnull(progressFirst.Title,"").trim();
				firstAddressText = ifnull(progressFirst.Approver,"").trim();
				if(progressFirst.Sent_Date != null)
				{
					firstSentText = progressFirst.Sent_Date.toString();
				}
			}
			response.put("success",true);
			response.put("mode",progressMode);
			response.put("proformaId",proformaIdText);
			response.put("status",ifnull(pf.Status,"").toString().trim());
			response.put("locked",pf.Lock_Inputs == true);
			response.put("rowCount",progressCount);
			response.put("pendingCount",progressPending);
			response.put("approvedCount",progressApproved);
			response.put("firstId",firstIdText);
			response.put("firstStatus",firstStatusText);
			response.put("role",firstRoleText);
			response.put("address",firstAddressText);
			response.put("sentDate",firstSentText);
			response.put("emailSent",firstSentText != "");
			response.put("repairError",repairError);
			return response;
		}
					if(pf.Purchasing_Company == null)
					{
						response.put("success",false);
						response.put("message","Select a Purchasing Company before sending this Pro Forma for approvals.");
						return response;
					}
					sellerRows = Builder[Proforma == proformaIdLong];
					if(sellerRows.count() == 0)
					{
						response.put("success",false);
						response.put("message","Add at least one fully completed Seller record before sending this Pro Forma for approvals.");
						return response;
					}
					incompleteSellers = List();
					for each  sellerRow in sellerRows
					{
						missingSellerFields = List();
						if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "")
						{
							missingSellerFields.add("Seller Name");
						}
						if(ifnull(sellerRow.Email,"").toString().trim() == "")
						{
							missingSellerFields.add("Email");
						}
						if(ifnull(sellerRow.Phone_Number,"").toString().trim() == "")
						{
							missingSellerFields.add("Phone");
						}
						if(ifnull(sellerRow.Street_Address,"").toString().trim() == "")
						{
							missingSellerFields.add("Street Address");
						}
						if(ifnull(sellerRow.City_State_ZIP,"").toString().trim() == "")
						{
							missingSellerFields.add("City, State ZIP");
						}
						if(missingSellerFields.size() > 0)
						{
							sellerLabel = if(ifnull(sellerRow.Builder_Name,"").toString().trim() == "","Seller " + sellerRow.ID.toString(),sellerRow.Builder_Name.toString());
							incompleteSellers.add(sellerLabel + " needs " + missingSellerFields.toString(", "));
						}
					}
					if(incompleteSellers.size() > 0)
					{
						response.put("success",false);
						response.put("message","Complete the Seller record(s): " + incompleteSellers.toString("; "));
						return response;
					}
					propertyRows = Property[Proforma == proformaIdLong];
					if(propertyRows.count() == 0)
					{
						response.put("success",false);
						response.put("message","Add at least one fully completed Property record before sending this Pro Forma for approvals.");
						return response;
					}
					incompleteProperties = List();
					for each  propertyRow in propertyRows
					{
						missingPropertyFields = List();
						if(ifnull(propertyRow.Common_Name,"").toString().trim() == "")
						{
							missingPropertyFields.add("Common Name");
						}
						if(ifnull(propertyRow.Property_ID,"").toString().trim() == "")
						{
							missingPropertyFields.add("CAD / Property ID");
						}
						if(ifnull(propertyRow.County,"").toString().trim() == "")
						{
							missingPropertyFields.add("County");
						}
						if(ifnull(propertyRow.City,"").toString().trim() == "")
						{
							missingPropertyFields.add("City");
						}
						if(propertyRow.Acres == null || propertyRow.Acres <= 0)
						{
							missingPropertyFields.add("Acres");
						}
						if(ifnull(propertyRow.TerraVault_URL,"").toString().trim() == "")
						{
							missingPropertyFields.add("TerraVault URL");
						}
						if(propertyRow.Seller == null)
						{
							missingPropertyFields.add("Seller");
						}
						if(propertyRow.Company1 == null)
						{
							missingPropertyFields.add("Purchasing Company");
						}
						if(missingPropertyFields.size() > 0)
						{
							propertyLabel = if(ifnull(propertyRow.Common_Name,"").toString().trim() == "","Property " + propertyRow.ID.toString(),propertyRow.Common_Name.toString());
							incompleteProperties.add(propertyLabel + " needs " + missingPropertyFields.toString(", "));
						}
					}
					if(incompleteProperties.size() > 0)
					{
						response.put("success",false);
						response.put("message","Complete the Property record(s): " + incompleteProperties.toString("; "));
						return response;
					}
					rows = Budget_Approvals[Proforma == proformaIdLong] sort by Sort_Order;
		if(rows.count() == 0)
		{
			response.put("success",false);
			response.put("message","Add at least one approval step before submitting this Pro Forma.");
			return response;
		}
		// A lost API response must not restart an already delivered chain.
		firstExisting = null;
		existingPending = 0;
		existingApproved = 0;
		for each  existingRow in rows
		{
			if(firstExisting == null)
			{
				firstExisting = existingRow;
			}
			if(ifnull(existingRow.Status,"").trim() == "Pending")
			{
				existingPending = existingPending + 1;
			}
			if(ifnull(existingRow.Status,"").trim() == "Approved")
			{
				existingApproved = existingApproved + 1;
			}
		}
		if(firstExisting != null && ifnull(firstExisting.Status,"").trim() == "Pending" && firstExisting.Sent_Date != null && existingPending == 1 && existingApproved == 0)
		{
			pf.Status="Pending Approval";
			pf.Lock_Inputs=true;
			response.put("success",true);
			response.put("message","Approval request was already sent to " + ifnull(firstExisting.Title,"the first approver") + ".");
			response.put("pendingApprovalId",firstExisting.ID.toString());
			return response;
		}
		missingRecipients = List();
		missingTitles = List();
		expectedOrder = 1;
		for each  row in rows
		{
			rowTitle = ifnull(row.Title,"").toString().trim();
			rowEmail = ifnull(row.Approver,"").toString().trim();
			if(rowTitle == "")
			{
				missingTitles.add("Step " + expectedOrder.toString());
			}
			if(rowEmail == "")
			{
				missingRecipients.add(if(rowTitle == "","Step " + expectedOrder.toString(),rowTitle));
			}
			// Normalize the sequence before routing so there can be no gaps.
			row.Sort_Order=expectedOrder;
			expectedOrder = expectedOrder + 1;
		}
		if(missingTitles.size() > 0)
		{
			response.put("success",false);
			response.put("message","Missing approval step name for: " + missingTitles.toString(", "));
			return response;
		}
		if(missingRecipients.size() > 0)
		{
			response.put("success",false);
			response.put("message","Missing approver email for: " + missingRecipients.toString(", "));
			return response;
		}
		for each  row in rows
		{
			row.Status="Not Sent";
			row.Approval_Notes="";
			row.Sent_Date=null;
			row.Responded_Date=null;
		}
		firstRow = Budget_Approvals[Proforma == proformaIdLong && Sort_Order == 1];
		if(firstRow.ID == null)
		{
			response.put("success",false);
			response.put("message","The first approval row could not be found.");
			return response;
		}
		firstRow.Status="Pending";
		// The email helper stamps Sent_Date only after sendmail succeeds.
		firstRow.Sent_Date=null;
		firstRow.Responded_Date=null;
		pf.Lock_Inputs=true;
		emailResult = thisapp.Send_Proforma_Approval_Email_With_Context(proformaIdText,firstRow.ID.toString(),"Started","","System");
		if(ifnull(emailResult.get("success"),false) != true)
		{
			firstRow.Status="Not Sent";
			firstRow.Sent_Date=null;
			pf.Lock_Inputs=false;
			response.put("success",false);
						response.put("message",emailResult.get("message"));
						return response;
					}
					pf.Status="Pending Approval";
					response.put("success",true);
		response.put("message","Approval request sent to " + firstRow.Title + " with the approval PDF packet.");
		response.put("pendingApprovalId",firstRow.ID.toString());
		response.put("packetFileName",emailResult.get("packetFileName"));
	}	catch (e)
	{
		response.put("success",false);
		response.put("message",e.toString());
	}
	return response;
                 }
