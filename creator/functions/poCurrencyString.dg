string poCurrencyString(string value)
{
	// Max Digits includes the separator. Never round an entered amount.
	valueText = ifnull(value,"").trim();
	if(!valueText.matches("[0-9]+([.][0-9]{1,2})?"))
	{
		return "";
	}
	parts = valueText.toList(".");
	whole = parts.get(0).replaceAll("^0+","");
	if(whole == "") { whole = "0"; }
	if(whole.length() > 13) { return ""; }
	fraction = "00";
	if(parts.size() == 2)
	{
		fraction = parts.get(1);
		if(fraction.length() == 1) { fraction = fraction + "0"; }
	}
	return whole + "." + fraction;
}
