<%{
	%>
<div id="lm-nav">
<style>
#lm-nav{--bg:#ffffff;--card:#ffffff;--border:#e3e6eb;--text:#1f2430;--muted:#6b7280;--brand:#2b6cff;--brand-ink:#fff;--edit:#5b667a;--chip:#eef1f6;--shadow:0 1px 2px rgba(16,24,40,.06),0 1px 3px rgba(16,24,40,.10);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--text);background:var(--bg);box-sizing:border-box;padding:16px;line-height:1.4;-webkit-font-smoothing:antialiased;max-width:1200px;margin:0 auto;}
#lm-nav *,#lm-nav *::before,#lm-nav *::after{box-sizing:border-box;}
@media (prefers-color-scheme:dark){#lm-nav{--bg:#12151c;--card:#1b2029;--border:#2a3140;--text:#e7eaf0;--muted:#98a2b3;--brand:#4d82ff;--edit:#8a93a6;--chip:#222836;--shadow:0 1px 2px rgba(0,0,0,.5);}}
#lm-nav .lm-envradio{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;}
#lm-nav h2.lm-title{font-size:19px;font-weight:700;margin:0;letter-spacing:-.01em;}
#lm-nav .lm-sub{color:var(--muted);font-size:13px;margin:3px 0 0;}
#lm-nav .lm-envlabel{display:inline-block;font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 12px 0 0;vertical-align:middle;}
#lm-nav .lm-seg-btn{display:inline-block;vertical-align:middle;margin-top:14px;padding:7px 16px;font-size:13px;font-weight:600;color:var(--muted);background:var(--chip);border:1px solid var(--border);cursor:pointer;user-select:none;transition:background .12s,color .12s,border-color .12s;}
#lm-nav label.seg-dev{border-radius:8px 0 0 8px;}
#lm-nav label.seg-prod{border-radius:0 8px 8px 0;border-left:0;}
#lm-nav #lm-dev:checked + label.seg-dev,#lm-nav #lm-prod:checked + label.seg-prod{background:var(--brand);color:var(--brand-ink);border-color:var(--brand);}
#lm-nav .lm-note{font-size:12px;color:var(--muted);margin:12px 0 0;padding-bottom:14px;border-bottom:1px solid var(--border);}
#lm-nav .lm-note b{color:var(--text);}
#lm-nav .lm-section{margin:16px 0 6px;}
#lm-nav .lm-sec-head{display:flex;align-items:center;gap:8px;margin:4px 2px 10px;position:sticky;top:0;background:var(--bg);padding:6px 0;z-index:2;}
#lm-nav .lm-sec-head h3{font-size:15px;font-weight:700;margin:0;}
#lm-nav .lm-count{font-size:12px;color:var(--muted);background:var(--chip);border-radius:20px;padding:2px 9px;font-weight:600;}
#lm-nav ul.lm-grid{list-style:none;margin:0;padding:0;display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));}
#lm-nav .lm-row{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:9px 11px;box-shadow:var(--shadow);}
#lm-nav .lm-row-main{min-width:0;display:flex;flex-direction:column;gap:1px;}
#lm-nav .lm-name{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#lm-nav .lm-link{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#lm-nav .lm-actions{display:flex;gap:6px;flex:none;}
#lm-nav .lm-btn{text-decoration:none;font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:7px;border:1px solid transparent;white-space:nowrap;transition:.12s;}
#lm-nav .lm-open{background:var(--brand);color:var(--brand-ink);}
#lm-nav .lm-open:hover{filter:brightness(1.08);}
#lm-nav .lm-edit{background:transparent;color:var(--edit);border-color:var(--border);}
#lm-nav .lm-edit:hover{background:var(--chip);color:var(--text);}
#lm-nav .lm-open.prod{display:none;}
#lm-nav #lm-prod:checked ~ .lm-section .lm-open.dev{display:none;}
#lm-nav #lm-prod:checked ~ .lm-section .lm-open.prod{display:inline-block;}
</style>
<h2 class="lm-title">Land Master &mdash; Forms &amp; Reports</h2>
<p class="lm-sub">57 forms &middot; 70 reports &middot; quick links to open or edit every component</p>
<span class="lm-envlabel">Environment</span><input type="radio" name="lmenv" id="lm-dev" class="lm-envradio" checked><label for="lm-dev" class="lm-seg-btn seg-dev">Development</label><input type="radio" name="lmenv" id="lm-prod" class="lm-envradio"><label for="lm-prod" class="lm-seg-btn seg-prod">Production</label><p class="lm-note"><b>Open</b> uses the selected environment. <b>Edit</b> always opens the builder (Development). Tip: press <b>Ctrl</b>+<b>F</b> (&#8984;F on Mac) to find a specific item.</p>
